/-- Auxiliary: bounded measurable functions times integrable functions are integrable. -/
theorem aux_ann_integrable_mul {f ψ : X → ℂ} (hf : AEStronglyMeasurable f μ)
    (hb : ∀ x, ‖f x‖ ≤ 1) (hψ : Integrable ψ μ) : Integrable (fun x => f x * ψ x) μ :=
  hψ.bdd_mul hf (ae_of_all _ hb)

/-- Auxiliary (`ann:extract`, see `Auto.ann_extract`): from weak-* limits at a dense set of
shifts to a jointly measurable limit, continuous in the shift, with the same modulus `w` as the
sequence, which is also the weak-* limit along every measurable shift function. -/
theorem aux_ann_extend (F : ℕ → Sh → X → ℂ) (hFc : ∀ n x, Continuous fun s => F n s x)
    (hFm : ∀ n s, Measurable (F n s)) (hb : ∀ n s x, ‖F n s x‖ ≤ 1)
    (w : Sh → Sh → ℝ) (hw : Continuous (Function.uncurry w)) (hw0 : ∀ s, w s s = 0)
    (hL : ∀ n s s' x, ‖F n s x - F n s' x‖ ≤ w s s')
    (D : ℕ → Sh) (hD : DenseRange D) (g : ℕ → X → ℂ) (hg : ∀ i, MemLp (g i) ⊤ μ)
    (hconv : ∀ i, annWeakStar μ (fun n => F n (D i)) (g i)) :
    ∃ H : X → Sh → ℂ, Measurable (Function.uncurry H) ∧ (∀ x, Continuous (H x)) ∧
      (∀ x s, ‖H x s‖ ≤ 1) ∧ (∀ x s s', ‖H x s - H x s'‖ ≤ w s s') ∧
      ∀ S : X → Sh, Measurable S →
        annWeakStar μ (fun n x => F n (S x) x) (fun x => H x (S x)) := by
  classical
  have hwc := fun {ι : Type _} {l : Filter ι} {a b : ι → Sh} {s t : Sh} =>
    aux_ann_tendsto_w hw (l := l) (a := a) (b := b) (s := s) (t := t)
  set g' : ℕ → X → ℂ := fun i => (hg i).aestronglyMeasurable.mk (g i) with hg'def
  have hgg' : ∀ i, g i =ᵐ[μ] g' i := fun i => (hg i).aestronglyMeasurable.ae_eq_mk
  have hg'm : ∀ i, StronglyMeasurable (g' i) := fun i =>
    (hg i).aestronglyMeasurable.stronglyMeasurable_mk
  -- a.e. bounds for the limits at the dense shifts
  have hb1 : ∀ i, ∀ᵐ x ∂μ, ‖g' i x‖ ≤ 1 := fun i => by
    filter_upwards [aux_ann_weakStar_norm_le (hg i) (fun n => ae_of_all _ (hb n (D i)))
      (hconv i), hgg' i] with x hx hx'
    rwa [← hx']
  have hb2 : ∀ i j, ∀ᵐ x ∂μ, ‖g' i x - g' j x‖ ≤ w (D i) (D j) := fun i j => by
    have hlim : annWeakStar μ (fun n x => F n (D i) x - F n (D j) x)
        (fun x => g i x - g j x) := by
      intro ψ hψ
      have e1 : ∀ n, ∫ x, (F n (D i) x - F n (D j) x) * ψ x ∂μ =
          ∫ x, F n (D i) x * ψ x ∂μ - ∫ x, F n (D j) x * ψ x ∂μ := fun n => by
        simp_rw [sub_mul]
        exact integral_sub (aux_ann_integrable_mul (hFm n _).aestronglyMeasurable (hb n _) hψ)
          (aux_ann_integrable_mul (hFm n _).aestronglyMeasurable (hb n _) hψ)
      have e2 : ∫ x, (g i x - g j x) * ψ x ∂μ =
          ∫ x, g i x * ψ x ∂μ - ∫ x, g j x * ψ x ∂μ := by
        simp_rw [sub_mul]
        exact integral_sub ((hg i).integrable_mul (memLp_one_iff_integrable.2 hψ))
          ((hg j).integrable_mul (memLp_one_iff_integrable.2 hψ))
      simp_rw [e1, e2]
      exact (hconv i ψ hψ).sub (hconv j ψ hψ)
    filter_upwards [aux_ann_weakStar_norm_le ((hg i).sub (hg j))
      (fun n => ae_of_all _ (hL n (D i) (D j))) hlim, hgg' i, hgg' j] with x hx h1 h2
    rwa [← h1, ← h2]
  -- the good set
  set Good : Set X := {x | (∀ i, ‖g' i x‖ ≤ 1) ∧ ∀ i j, ‖g' i x - g' j x‖ ≤ w (D i) (D j)}
    with hGooddef
  have hGoodm : MeasurableSet Good := by
    have e : Good = (⋂ i, {x | ‖g' i x‖ ≤ 1}) ∩
        ⋂ i, ⋂ j, {x | ‖g' i x - g' j x‖ ≤ w (D i) (D j)} := by
      ext x; simp [hGooddef]
    rw [e]
    refine MeasurableSet.inter (MeasurableSet.iInter fun i => ?_)
      (MeasurableSet.iInter fun i => MeasurableSet.iInter fun j => ?_)
    · exact measurableSet_le (hg'm i).measurable.norm measurable_const
    · exact measurableSet_le ((hg'm i).measurable.sub (hg'm j).measurable).norm measurable_const
  have hGood : ∀ᵐ x ∂μ, x ∈ Good := by
    have h1 := ae_all_iff.2 hb1
    have h2 : ∀ᵐ x ∂μ, ∀ i j, ‖g' i x - g' j x‖ ≤ w (D i) (D j) :=
      ae_all_iff.2 fun i => ae_all_iff.2 fun j => hb2 i j
    filter_upwards [h1, h2] with x hx1 hx2 using ⟨hx1, hx2⟩
  -- the extension
  set idx := aux_ann_idx D hD with hidx
  have hcauchy : ∀ x ∈ Good, ∀ s, ∃ c, Tendsto (fun m => g' (idx m s) x) atTop (𝓝 c) := by
    intro x hx s
    refine cauchySeq_tendsto_of_complete ?_
    rw [cauchySeq_iff_tendsto_dist_atTop_0]
    have ht : Tendsto (fun p : ℕ × ℕ => w (D (idx p.1 s)) (D (idx p.2 s))) atTop
        (𝓝 (w s s)) := by
      have h := aux_ann_idx_tendsto D hD s
      rw [← prod_atTop_atTop_eq] at *
      exact hwc (h.comp tendsto_fst) (h.comp tendsto_snd)
    rw [hw0] at ht
    exact squeeze_zero (fun _ => dist_nonneg) (fun p => by
      rw [dist_eq_norm]; exact hx.2 _ _) ht
  set H : X → Sh → ℂ := fun x s =>
    if x ∈ Good then limUnder atTop (fun m => g' (idx m s) x) else 0 with hHdef
  have hHlim : ∀ x ∈ Good, ∀ s, Tendsto (fun m => g' (idx m s) x) atTop (𝓝 (H x s)) := by
    intro x hx s
    simp only [hHdef, ite_eq_left hx]
    exact tendsto_nhds_limUnder (hcauchy x hx s)
  have hHD : ∀ x ∈ Good, ∀ i, H x (D i) = g' i x := by
    intro x hx i
    refine tendsto_nhds_unique (hHlim x hx (D i)) ?_
    rw [tendsto_iff_norm_sub_tendsto_zero]
    have ht := hwc (aux_ann_idx_tendsto D hD (D i)) (tendsto_const_nhds (x := D i))
    rw [hw0] at ht
    exact squeeze_zero (fun _ => norm_nonneg _) (fun m => hx.2 _ _) ht
  have hHL : ∀ x s s', ‖H x s - H x s'‖ ≤ w s s' := by
    intro x s s'
    by_cases hx : x ∈ Good
    · refine le_of_tendsto_of_tendsto' ((hHlim x hx s).sub (hHlim x hx s')).norm
        (hwc (aux_ann_idx_tendsto D hD s) (aux_ann_idx_tendsto D hD s')) fun m => hx.2 _ _
    · simp only [hHdef, ite_eq_right hx, sub_zero, norm_zero]
      exact (norm_nonneg _).trans (hL 0 s s' x)
  have hHb : ∀ x s, ‖H x s‖ ≤ 1 := by
    intro x s
    by_cases hx : x ∈ Good
    · exact le_of_tendsto' (hHlim x hx s).norm fun m => hx.1 _
    · simp [hHdef, hx]
  have hHc : ∀ x, Continuous (H x) := by
    intro x
    refine continuous_iff_continuousAt.2 fun s => ?_
    rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
    have ht := aux_ann_tendsto_w hw (continuous_id.tendsto s) (tendsto_const_nhds (x := s))
    simp only [id, hw0] at ht
    exact squeeze_zero (fun _ => norm_nonneg _) (fun s' => hHL x s' s) ht
  have hHm : Measurable (Function.uncurry H) := by
    refine measurable_of_tendsto_metrizable (f := fun m (p : X × Sh) =>
      if p.1 ∈ Good then g' (idx m p.2) p.1 else 0) (fun m => ?_) ?_
    · refine Measurable.ite (hGoodm.preimage measurable_fst) ?_ measurable_const
      have h1 : Measurable fun q : X × ℕ => g' q.2 q.1 :=
        measurable_from_prod_countable_left fun i => (hg'm i).measurable
      exact h1.comp (measurable_fst.prodMk ((aux_ann_idx_measurable D hD m).comp measurable_snd))
    · rw [tendsto_pi_nhds]
      rintro ⟨x, s⟩
      by_cases hx : x ∈ Good
      · simp only [ite_eq_left hx, Function.uncurry_apply_pair]
        exact hHlim x hx s
      · simp only [ite_eq_right hx, Function.uncurry_apply_pair, hHdef]
        exact tendsto_const_nhds
  have hHms : ∀ s, Measurable fun x => H x s := fun s =>
    hHm.comp (measurable_id.prodMk measurable_const)
  have hFj : ∀ n, Measurable (Function.uncurry (F n)) := fun n =>
    measurable_uncurry_of_continuous_of_measurable (u := F n) (fun x => hFc n x) (hFm n)
  -- convergence at fixed shifts
  have hfix : ∀ s, annWeakStar μ (fun n => F n s) (fun x => H x s) := by
    intro s ψ hψ
    set i : ℕ → ℕ := fun m => idx m s
    have hint : ∀ n t, Integrable (fun x => F n t x * ψ x) μ := fun n t =>
      aux_ann_integrable_mul (hFm n t).aestronglyMeasurable (hb n t) hψ
    have hintH : ∀ t, Integrable (fun x => H x t * ψ x) μ := fun t =>
      aux_ann_integrable_mul (hHms t).aestronglyMeasurable (hHb · t) hψ
    refine aux_ann_tendsto_of_approx (am := fun m n => ∫ x, F n (D (i m)) x * ψ x ∂μ)
      (bm := fun m => ∫ x, g (i m) x * ψ x ∂μ)
      (δ := fun m => w s (D (i m)) * ∫ x, ‖ψ x‖ ∂μ) ?_ ?_ ?_ fun m => hconv (i m) ψ hψ
    · have ht := (hwc (tendsto_const_nhds (x := s)) (aux_ann_idx_tendsto D hD s)).mul_const
        (∫ x, ‖ψ x‖ ∂μ)
      rwa [hw0, zero_mul] at ht
    · intro m n
      rw [← integral_sub (hint n s) (hint n _), ← integral_const_mul]
      refine norm_integral_le_of_norm_le (hψ.norm.const_mul _) (ae_of_all _ fun x => ?_)
      rw [← sub_mul, norm_mul]
      exact mul_le_mul_of_nonneg_right (hL n _ _ x) (norm_nonneg _)
    · intro m
      have he : ∫ x, g (i m) x * ψ x ∂μ = ∫ x, H x (D (i m)) * ψ x ∂μ := by
        refine integral_congr_ae ?_
        filter_upwards [hgg' (i m), hGood] with x h1 h2
        rw [h1, hHD x h2]
      rw [he, ← integral_sub (hintH s) (hintH _), ← integral_const_mul]
      refine norm_integral_le_of_norm_le (hψ.norm.const_mul _) (ae_of_all _ fun x => ?_)
      rw [← sub_mul, norm_mul]
      exact mul_le_mul_of_nonneg_right (hHL x _ _) (norm_nonneg _)
  refine ⟨H, hHm, hHc, hHb, hHL, fun S hS ψ hψ => ?_⟩
  -- variable shifts: approximation by simple functions
  set Sm : ℕ → SimpleFunc X Sh := hS.stronglyMeasurable.approx with hSmdef
  have hSm : ∀ x, Tendsto (fun m => Sm m x) atTop (𝓝 (S x)) :=
    hS.stronglyMeasurable.tendsto_approx
  have hFS : ∀ n (T : X → Sh), Measurable T → Measurable fun x => F n (T x) x := fun n T hT =>
    (hFj n).comp (hT.prodMk measurable_id)
  have hHS : ∀ (T : X → Sh), Measurable T → Measurable fun x => H x (T x) := fun T hT =>
    hHm.comp (measurable_id.prodMk hT)
  have hintS : ∀ n (T : X → Sh), Measurable T → Integrable (fun x => F n (T x) x * ψ x) μ :=
    fun n T hT => aux_ann_integrable_mul (hFS n T hT).aestronglyMeasurable (fun x => hb _ _ _) hψ
  have hintHS : ∀ (T : X → Sh), Measurable T → Integrable (fun x => H x (T x) * ψ x) μ :=
    fun T hT => aux_ann_integrable_mul (hHS T hT).aestronglyMeasurable (fun x => hHb _ _) hψ
  -- the finite decomposition along a simple function
  have hsimple : ∀ m, Tendsto (fun n => ∫ x, F n (Sm m x) x * ψ x ∂μ) atTop
      (𝓝 (∫ x, H x (Sm m x) * ψ x ∂μ)) := by
    intro m
    set φ := Sm m
    have hdec : ∀ (K : Sh → X → ℂ), (∀ y, Integrable (fun x => K y x *
        (φ ⁻¹' {y}).indicator ψ x) μ) → ∫ x, K (φ x) x * ψ x ∂μ =
        ∑ y ∈ φ.range, ∫ x, K y x * (φ ⁻¹' {y}).indicator ψ x ∂μ := by
      intro K hK
      rw [← integral_finsetSum _ fun y _ => hK y]
      refine integral_congr_ae (ae_of_all _ fun x => ?_)
      simp only
      rw [Finset.sum_eq_single_of_mem (φ x) (φ.mem_range_self x)]
      · rw [indicator_of_mem (by simp)]
      · intro y _ hy
        rw [indicator_of_notMem (by simpa [eq_comm] using hy), mul_zero]
    have hψy : ∀ y, Integrable ((φ ⁻¹' {y}).indicator ψ) μ := fun y =>
      hψ.indicator (φ.measurableSet_fiber y)
    rw [hdec (fun y x => H x y) fun y => aux_ann_integrable_mul
      (hHms y).aestronglyMeasurable (fun x => hHb _ _) (hψy y)]
    have : ∀ n, ∫ x, F n (φ x) x * ψ x ∂μ =
        ∑ y ∈ φ.range, ∫ x, F n y x * (φ ⁻¹' {y}).indicator ψ x ∂μ := fun n =>
      hdec (F n) fun y => aux_ann_integrable_mul (hFm n y).aestronglyMeasurable (hb n y) (hψy y)
    simp_rw [this]
    exact tendsto_finsetSum _ fun y _ => hfix y _ (hψy y)
  have hw_nn : ∀ x s s', 0 ≤ w s s' := fun x s s' => (norm_nonneg _).trans (hL 0 s s' x)
  have hmδ : ∀ m, AEStronglyMeasurable (fun x => min 2 (w (S x) (Sm m x)) * ‖ψ x‖) μ :=
    fun m => (((measurable_const (a := (2 : ℝ))).min
      (hw.measurable.comp (hS.prodMk (Sm m).measurable))).aestronglyMeasurable).mul
      hψ.norm.aestronglyMeasurable
  refine aux_ann_tendsto_of_approx (am := fun m n => ∫ x, F n (Sm m x) x * ψ x ∂μ)
    (bm := fun m => ∫ x, H x (Sm m x) * ψ x ∂μ)
    (δ := fun m => ∫ x, min 2 (w (S x) (Sm m x)) * ‖ψ x‖ ∂μ) ?_ ?_ ?_ hsimple
  · have h0 : (0 : ℝ) = ∫ x, (0 : ℝ) ∂μ := by simp
    rw [h0]
    refine tendsto_integral_of_dominated_convergence (fun x => 2 * ‖ψ x‖) (fun m => ?_)
      (hψ.norm.const_mul 2) (fun m => ae_of_all _ fun x => ?_) (ae_of_all _ fun x => ?_)
    · exact hmδ m
    · rw [norm_mul, norm_norm, Real.norm_eq_abs, abs_of_nonneg (le_min (by norm_num)
        (hw_nn x _ _))]
      exact mul_le_mul_of_nonneg_right (min_le_left _ _) (norm_nonneg _)
    · have ht := ((hwc (tendsto_const_nhds (x := S x)) (hSm x)).min
        (tendsto_const_nhds (x := (2 : ℝ)))).mul_const ‖ψ x‖
      rw [hw0, min_eq_left (by norm_num : (0 : ℝ) ≤ 2), zero_mul] at ht
      simpa [min_comm] using ht
  · intro m n
    rw [← integral_sub (hintS n S hS) (hintS n _ (Sm m).measurable)]
    refine norm_integral_le_of_norm_le ?_ (ae_of_all _ fun x => ?_)
    · exact (hψ.norm.const_mul 2).mono'
        (hmδ m)
        (ae_of_all _ fun x => by
          rw [norm_mul, norm_norm, Real.norm_eq_abs, abs_of_nonneg (le_min (by norm_num)
            (hw_nn x _ _))]
          exact mul_le_mul_of_nonneg_right (min_le_left _ _) (norm_nonneg _))
    · rw [← sub_mul, norm_mul]
      refine mul_le_mul_of_nonneg_right (le_min ?_ (hL n _ _ x)) (norm_nonneg _)
      calc ‖F n (S x) x - F n (Sm m x) x‖ ≤ ‖F n (S x) x‖ + ‖F n (Sm m x) x‖ := norm_sub_le _ _
        _ ≤ 2 := by linarith [hb n (S x) x, hb n (Sm m x) x]
  · intro m
    rw [← integral_sub (hintHS S hS) (hintHS _ (Sm m).measurable)]
    refine norm_integral_le_of_norm_le ?_ (ae_of_all _ fun x => ?_)
    · exact (hψ.norm.const_mul 2).mono'
        (hmδ m)
        (ae_of_all _ fun x => by
          rw [norm_mul, norm_norm, Real.norm_eq_abs, abs_of_nonneg (le_min (by norm_num)
            (hw_nn x _ _))]
          exact mul_le_mul_of_nonneg_right (min_le_left _ _) (norm_nonneg _))
    · rw [← sub_mul, norm_mul]
      refine mul_le_mul_of_nonneg_right (le_min ?_ (hHL x _ _)) (norm_nonneg _)
      calc ‖H x (S x) - H x (Sm m x)‖ ≤ ‖H x (S x)‖ + ‖H x (Sm m x)‖ := norm_sub_le _ _
        _ ≤ 2 := by linarith [hHb x (S x), hHb x (Sm m x)]

end Extend

/-- Auxiliary: functions bounded by one are essentially bounded with `L^∞` norm at most one. -/
theorem aux_ann_memLp_top_le_one {X : Type*} [MeasurableSpace X] {μ : Measure X} {f : X → ℂ}
    (hf : Measurable f) (hb : ∀ x, ‖f x‖ ≤ 1) : MemLp f ⊤ μ ∧ eLpNorm f ⊤ μ ≤ 1 := by
  refine ⟨memLp_top_of_bound hf.aestronglyMeasurable 1 (ae_of_all _ hb), ?_⟩
  rw [eLpNorm_exponent_top hf.aestronglyMeasurable]
  exact (eLpNormEssSup_le_of_ae_bound (ae_of_all _ hb)).trans (by simp)

/-- Auxiliary (`ann:sequence`): the functions of an admissible sequence are continuous. -/
theorem aux_ann_continuous {Q : Set ℝ²} {C : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
    (hadm : IsAdmissibleSeq Q C R f) (j : Fin 3) (n : ℕ) : Continuous (f j n) :=
  (LipschitzWith.of_dist_le' (K := C * R n) fun x y => by
    rw [dist_eq_norm, dist_eq_norm]; exact hadm.lip j n x y).continuous

/-- Auxiliary (`ann:sequence`): the translates are bounded by one. -/
theorem aux_ann_annT_le_one {Q : Set ℝ²} {C : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
    (hadm : IsAdmissibleSeq Q C R f) (j : Fin 3) (n : ℕ) (s z : ℝ²) :
    ‖annT R f j n s z‖ ≤ 1 :=
  (hadm.bound j n _).trans (by unfold indicator; split_ifs <;> norm_num)

/-- Auxiliary (`ann:extract`): the translates are `|C|`-Lipschitz in the shift. -/
theorem aux_ann_annT_lip {Q : Set ℝ²} {C : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
    (hadm : IsAdmissibleSeq Q C R f) (j : Fin 3) (n : ℕ) (s s' z : ℝ²) :
    ‖annT R f j n s z - annT R f j n s' z‖ ≤ |C| * ‖s - s'‖ := by
  unfold annT
  refine (hadm.lip j n _ _).trans ?_
  rw [add_sub_add_left_eq_sub, ← smul_sub, norm_smul, Real.norm_eq_abs, abs_inv, ← mul_assoc,
    mul_assoc C]
  refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
  rcases lt_trichotomy (R n) 0 with h | h | h
  · rw [abs_of_neg h, inv_neg, mul_neg, mul_inv_cancel₀ h.ne, mul_neg_one]
    exact neg_le_abs C
  · simp [h]
  · rw [abs_of_pos h, mul_inv_cancel₀ h.ne', mul_one]; exact le_abs_self C

/-- Auxiliary (`ann:extract`): the elementary product estimate for two factors. -/
theorem aux_ann_mul_conj_sub (a b a' b' : ℂ) (ha' : ‖a'‖ ≤ 1) (hb : ‖b‖ ≤ 1) :
    ‖a * conj b - a' * conj b'‖ ≤ ‖a - a'‖ + ‖b - b'‖ := by
  have e : a * conj b - a' * conj b' = (a - a') * conj b + a' * conj (b - b') := by
    simp only [map_sub]; ring
  rw [e]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · rw [norm_mul, Complex.norm_conj]; exact mul_le_of_le_one_right (norm_nonneg _) hb
  · rw [norm_mul, Complex.norm_conj]; exact mul_le_of_le_one_left (norm_nonneg _) ha'

/-- Auxiliary (`ann:extract`): the elementary product estimate for three factors. -/
theorem aux_ann_prod3_sub (a b : Fin 3 → ℂ) (ha : ∀ j, ‖a j‖ ≤ 1) (hb : ∀ j, ‖b j‖ ≤ 1) :
    ‖∏ j, a j - ∏ j, b j‖ ≤ ∑ j, ‖a j - b j‖ := by
  rw [Fin.prod_univ_three, Fin.prod_univ_three, Fin.sum_univ_three]
  have e : a 0 * a 1 * a 2 - b 0 * b 1 * b 2 =
      (a 0 - b 0) * a 1 * a 2 + b 0 * (a 1 - b 1) * a 2 + b 0 * b 1 * (a 2 - b 2) := by ring
  rw [e]
  refine (norm_add₃_le).trans (add_le_add_three ?_ ?_ ?_) <;> simp only [norm_mul]
  · exact (mul_le_of_le_one_right (by positivity) (ha 2)).trans
      (mul_le_of_le_one_right (norm_nonneg _) (ha 1))
  · exact (mul_le_of_le_one_right (by positivity) (ha 2)).trans
      (mul_le_of_le_one_left (norm_nonneg _) (hb 0))
  · exact mul_le_of_le_one_left (norm_nonneg _)
      ((mul_le_of_le_one_left (norm_nonneg _) (hb 0)).trans (hb 1))

/-- Auxiliary (`ann:extract`): decoding a vertex index from a natural number. -/
@[nolint defsWithUnderscore]
def aux_ann_fin3 (k : ℕ) : Fin 3 := ⟨k % 3, Nat.mod_lt _ (by norm_num)⟩

theorem aux_ann_fin3_val (j : Fin 3) : aux_ann_fin3 j = j :=
  Fin.ext (Nat.mod_eq_of_lt j.isLt)

/-- Auxiliary: `μinc` is sigma-finite. -/
instance aux_ann_sigmaFinite_μinc : SigmaFinite μinc := by
  unfold μinc; infer_instance

/-- Auxiliary: the vertex projections are continuous. -/
theorem aux_ann_proj_continuous (α β : ℝ) (j : Fin 3) : Continuous (proj α β j) :=
  continuous_fst.add ((Lv α β j).continuous.comp (aux_lw_u_continuous.comp continuous_snd))

/-- **Lemma `ann:extract`** (Simultaneous correlation limits).
Every admissible sequence has a subsequence with the following properties.  For all real shifts
$s,t,s_0,s_1,s_2\in\mathbb R^2$, the limits
$$T^s_{j,n}\overline{T^t_{j,n}}\stackrel{*}{\rightharpoonup}k_j(z;s,t),\qquad
\prod_{j=0}^2T^{s_j}_{j,n}(\pi_jp)\stackrel{*}{\rightharpoonup}h(p;s_0,s_1,s_2)$$
exist.  The limits have representatives that are continuous in all shift variables off a fixed
null set in the respective underlying space.  They are bounded by one, and their Lipschitz
constants in the shifts are bounded in terms of $C$.  The three-point convergence also holds
when the shifts $s_j$ are replaced by bounded measurable functions of $p$.

(The Lipschitz bound `L` depends only on `C`.) -/
theorem ann_extract (C : ℝ) :
    ∃ L : ℝ, ∀ (α β : ℝ) (Q : Set ℝ²), Bornology.IsBounded Q →
      ∀ (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ), IsAdmissibleSeq Q C R f →
      ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ)
        (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ),
        aux_IsCorrelationLimits α β L (R ∘ φ) (fun j n => f j (φ n)) k h3 := by
  refine ⟨|C|, fun α β Q _ R f hadm => ?_⟩
  have hT1 := aux_ann_annT_le_one hadm
  have hTL := aux_ann_annT_lip hadm
  have hTc : ∀ j n, Continuous fun q : ℝ² × ℝ² => annT R f j n q.1 q.2 := fun j n => by
    have hc := aux_ann_continuous hadm j n
    unfold annT
    fun_prop
  set F2 : Fin 3 → ℕ → ℝ² × ℝ² → ℝ² → ℂ := fun j n st z =>
    annT R f j n st.1 z * conj (annT R f j n st.2 z) with hF2
  set F3 : ℕ → (Fin 3 → ℝ²) → ℝ² × Ang → ℂ := fun n s p =>
    ∏ j, annT R f j n (s j) (proj α β j p) with hF3
  have hF2c : ∀ j n z, Continuous fun st => F2 j n st z := fun j n z =>
    ((hTc j n).comp (continuous_fst.prodMk continuous_const)).mul
      (Complex.continuous_conj.comp ((hTc j n).comp (continuous_snd.prodMk continuous_const)))
  have hF2m : ∀ j n st, Measurable (F2 j n st) := fun j n st =>
    (((hTc j n).comp (continuous_const.prodMk continuous_id)).mul
      (Complex.continuous_conj.comp ((hTc j n).comp
        (continuous_const.prodMk continuous_id)))).measurable
  have hF2b : ∀ j n st z, ‖F2 j n st z‖ ≤ 1 := fun j n st z => by
    simp only [hF2, norm_mul, Complex.norm_conj]
    exact (mul_le_of_le_one_left (norm_nonneg _) (hT1 _ _ _ _)).trans (hT1 _ _ _ _)
  have hF2L : ∀ j n (st st' : ℝ² × ℝ²) z, ‖F2 j n st z - F2 j n st' z‖ ≤
      |C| * (‖st.1 - st'.1‖ + ‖st.2 - st'.2‖) := fun j n st st' z => by
    refine (aux_ann_mul_conj_sub _ _ _ _ (hT1 _ _ _ _) (hT1 _ _ _ _)).trans ?_
    rw [mul_add]
    exact add_le_add (hTL _ _ _ _ _) (hTL _ _ _ _ _)
  have hF3c : ∀ n p, Continuous fun s => F3 n s p := fun n p =>
    continuous_finsetProd _ fun j _ => by
      have hc := aux_ann_continuous hadm j n
      simp only [annT]
      fun_prop
  have hF3m : ∀ n s, Measurable (F3 n s) := fun n s =>
    (continuous_finsetProd _ fun j _ => by
      have hc := aux_ann_continuous hadm j n
      have hp := aux_ann_proj_continuous α β j
      simp only [annT]
      fun_prop).measurable
  have hF3b : ∀ n s p, ‖F3 n s p‖ ≤ 1 := fun n s p => by
    simp only [hF3]
    rw [norm_prod]
    exact (Finset.prod_le_one₀ (fun _ _ => norm_nonneg _)
      fun j _ => hT1 _ _ _ _)
  have hF3L : ∀ n (s s' : Fin 3 → ℝ²) p, ‖F3 n s p - F3 n s' p‖ ≤
      |C| * ∑ j, ‖s j - s' j‖ := fun n s s' p => by
    refine (aux_ann_prod3_sub _ _ (fun j => hT1 _ _ _ _) (fun j => hT1 _ _ _ _)).trans ?_
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun j _ => hTL _ _ _ _ _
  set D2 := TopologicalSpace.denseSeq (ℝ² × ℝ²) with hD2def
  set D3 := TopologicalSpace.denseSeq (Fin 3 → ℝ²) with hD3def
  have hD2 : DenseRange D2 := TopologicalSpace.denseRange_denseSeq _
  have hD3 : DenseRange D3 := TopologicalSpace.denseRange_denseSeq _
  obtain ⟨φ1, hφ1, g2, hg2⟩ := ext_weakstar_plane_countable
    (fun i n => F2 (aux_ann_fin3 (Nat.unpair i).1) n (D2 (Nat.unpair i).2))
    (fun i n => (aux_ann_memLp_top_le_one (hF2m _ _ _) (hF2b _ _ _)).1)
    (fun i => ⟨1, ENNReal.one_ne_top, fun n =>
      (aux_ann_memLp_top_le_one (hF2m _ _ _) (hF2b _ _ _)).2⟩)
  obtain ⟨φ2, hφ2, g3, hg3⟩ := ext_weakstar_config_countable
    (fun i n => F3 (φ1 n) (D3 i))
    (fun i n => (aux_ann_memLp_top_le_one (hF3m _ _) (hF3b _ _)).1)
    (fun i => ⟨1, ENNReal.one_ne_top, fun n =>
      (aux_ann_memLp_top_le_one (hF3m _ _) (hF3b _ _)).2⟩)
  set φ := φ1 ∘ φ2 with hφdef
  have hconv2 : ∀ (j : Fin 3) k, annWeakStar volume (fun n => F2 j (φ n) (D2 k))
      (g2 (Nat.pair j k)) := by
    intro j k ψ hψ
    have := ((hg2 (Nat.pair j k)).2 ψ hψ).comp hφ2.tendsto_atTop
    simp only [Nat.unpair_pair, aux_ann_fin3_val] at this
    exact this
  have hconv3 : ∀ i, annWeakStar μinc (fun n => F3 (φ n) (D3 i)) (g3 i) :=
    fun i ψ hψ => (hg3 i).2 ψ hψ
  have hw2 : Continuous (Function.uncurry fun (st st' : ℝ² × ℝ²) =>
      |C| * (‖st.1 - st'.1‖ + ‖st.2 - st'.2‖)) := by
    simp only [Function.uncurry_def]; fun_prop
  have hw3 : Continuous (Function.uncurry fun (s s' : Fin 3 → ℝ²) =>
      |C| * ∑ j, ‖s j - s' j‖) := by
    simp only [Function.uncurry_def]; fun_prop
  have hex2 := fun j : Fin 3 => aux_ann_extend (μ := (volume : Measure ℝ²))
    (fun n => F2 j (φ n)) (fun n => hF2c j (φ n)) (fun n => hF2m j (φ n))
    (fun n => hF2b j (φ n)) _ hw2 (fun _ => by simp) (fun n => hF2L j (φ n)) D2 hD2
    (fun k => g2 (Nat.pair j k)) (fun k => (hg2 _).1) (hconv2 j)
  choose H2 hH2m hH2c hH2b hH2L hH2S using hex2
  obtain ⟨H3, hH3m, hH3c, hH3b, hH3L, hH3S⟩ := aux_ann_extend (μ := μinc)
    (fun n => F3 (φ n)) (fun n => hF3c (φ n)) (fun n => hF3m (φ n))
    (fun n => hF3b (φ n)) _ hw3 (fun _ => by simp) (fun n => hF3L (φ n)) D3 hD3
    g3 (fun i => (hg3 i).1) hconv3
  refine ⟨φ, hφ1.comp hφ2, fun j z s t => H2 j z (s, t), fun p s => H3 p s, ?_⟩
  exact
    { two_point := fun j s t => hH2S j (fun _ => (s, t)) measurable_const
      three_point := fun s => hH3S (fun _ => s) measurable_const
      meas_two := fun j s t =>
        ((hH2m j).comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
      meas_three := fun s =>
        (hH3m.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
      cont_two := ae_of_all _ fun z j => (hH2c j z).comp (continuous_fst.prodMk continuous_snd)
      cont_three := ae_of_all _ fun p => hH3c p
      bound_two := fun j z s t => hH2b j z (s, t)
      bound_three := fun p s => hH3b p s
      lip_two := ae_of_all _ fun z j s t s' t' => hH2L j z (s, t) (s', t')
      lip_three := ae_of_all _ fun p s s' => hH3L p s s'
      variable_shifts := fun S hS _ => hH3S (fun p j => S j p) (Measurable.of_eval hS) }

/-! ### Measurable spectral measures (`ann:spectral`) -/

/-- Auxiliary: the conclusion of `\label{ann:spectral}` (see `Auto.ann_spectral`): measurable
kernels `z ↦ ν j z` of finite positive measures of mass at most one with
$k_j(z;s,t)=\int\mathrm e((s-t)\cdot\xi)\,d\nu_{j,z}(\xi)$ for a.e. `z` and all `s,t`. -/
@[nolint defsWithUnderscore]
def aux_IsSpectralKernels (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (ν : Fin 3 → ℝ² → Measure ℝ²) :
    Prop :=
  (∀ j, IsMeasurableKernel (ν j)) ∧ (∀ j z, ν j z univ ≤ 1) ∧
    ∀ᵐ z ∂(volume : Measure ℝ²), ∀ j s t, k j z s t = ∫ ξ, e ⟪s - t, ξ⟫_ℝ ∂(ν j z)

/-- Auxiliary (`ann:spectral`, `ann:factor`): weak-* convergence is preserved by finite linear
combinations of uniformly bounded sequences. -/
theorem aux_ann_weakStar_sum {X : Type*} [MeasurableSpace X] {μ : Measure X} {ι : Type*}
    (s : Finset ι) (c : ι → ℂ) {F : ι → ℕ → X → ℂ} {G : ι → X → ℂ}
    (hFm : ∀ i n, AEStronglyMeasurable (F i n) μ) (hFb : ∀ i n x, ‖F i n x‖ ≤ 1)
    (hG : ∀ i, MemLp (G i) ⊤ μ) (h : ∀ i, annWeakStar μ (F i) (G i)) :
    annWeakStar μ (fun n x => ∑ i ∈ s, c i * F i n x) (fun x => ∑ i ∈ s, c i * G i x) := by
  intro ψ hψ
  have e1 : ∀ n, ∫ x, (∑ i ∈ s, c i * F i n x) * ψ x ∂μ =
      ∑ i ∈ s, c i * ∫ x, F i n x * ψ x ∂μ := by
    intro n
    simp_rw [Finset.sum_mul]
    rw [integral_finsetSum _ fun i _ => ?_]
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [← integral_const_mul]
      congr 1; funext x; ring
    · exact ((hψ.bdd_mul (hFm i n) (ae_of_all _ (hFb i n))).const_mul (c i)).congr
        (ae_of_all _ fun x => by simp only; ring)
  have e2 : ∫ x, (∑ i ∈ s, c i * G i x) * ψ x ∂μ = ∑ i ∈ s, c i * ∫ x, G i x * ψ x ∂μ := by
    simp_rw [Finset.sum_mul]
    rw [integral_finsetSum _ fun i _ => ?_]
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [← integral_const_mul]
      congr 1; funext x; ring
    · exact (((hG i).integrable_mul (memLp_one_iff_integrable.2 hψ)).const_mul (c i)).congr
        (ae_of_all _ fun x => by simp only [Pi.mul_apply]; ring)
  simp_rw [e1, e2]
  exact tendsto_finsetSum _ fun i _ => (h i ψ hψ).const_mul (c i)

section Spectral

variable {α β : ℝ} {Q : Set ℝ²} {C L : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
  {k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ} {h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ}

/-- Auxiliary: the two-point limits are essentially bounded. -/
theorem aux_ann_k_memLp (hlim : aux_IsCorrelationLimits α β L R f k h3) (j : Fin 3)
    (s t : ℝ²) : MemLp (fun z => k j z s t) ⊤ volume :=
  memLp_top_of_bound (hlim.meas_two j s t) 1 (ae_of_all _ fun z => hlim.bound_two j z s t)

/-- Auxiliary (`ann:spectral`, see `Auto.ann_spectral`): translation invariance of the
two-point limits, $k_j(z;s,t)=k_j(z;s-t,0)$ for a.e. `z`. -/
theorem aux_ann_translation (hadm : IsAdmissibleSeq Q C R f)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (j : Fin 3) (s t : ℝ²) :
    (fun z => k j z s t) =ᵐ[volume] fun z => k j z (s - t) 0 := by
  refine aux_ann_weakStar_unique (aux_ann_k_memLp hlim j s t) (aux_ann_k_memLp hlim j (s - t) 0)
    (hlim.two_point j s t) (hlim.two_point j (s - t) 0) fun ψ hψ => ?_
  set h : ℕ → ℝ² := fun n => (R n)⁻¹ • t with hh
  set F' : ℕ → ℝ² → ℂ := fun n z => annT R f j n (s - t) z * conj (annT R f j n 0 z) with hF'
  have hshift : ∀ n z, annT R f j n s z * conj (annT R f j n t z) = F' n (z + h n) := by
    intro n z
    simp only [hF', hh, annT, smul_sub, smul_zero, add_zero]
    rw [show z + (R n)⁻¹ • t + ((R n)⁻¹ • s - (R n)⁻¹ • t) = z + (R n)⁻¹ • s by abel]
  have hF'm : ∀ n, Measurable (F' n) := fun n => by
    have hc := aux_ann_continuous hadm j n
    simp only [hF', annT]
    exact (by fun_prop : Continuous _).measurable
  have hF'b : ∀ n z, ‖F' n z‖ ≤ 1 := fun n z => by
    simp only [hF', norm_mul, Complex.norm_conj]
    exact (mul_le_of_le_one_left (norm_nonneg _) (aux_ann_annT_le_one hadm _ _ _ _)).trans
        (aux_ann_annT_le_one hadm _ _ _ _)
  have e : ∀ n, ∫ z, annT R f j n s z * conj (annT R f j n t z) * ψ z =
      ∫ z, F' n z * ψ (z - h n) := by
    intro n
    simp_rw [hshift]
    have := integral_add_right_eq_self (μ := (volume : Measure ℝ²))
      (fun z => F' n z * ψ (z - h n)) (h n)
    simp only [add_sub_cancel_right] at this
    exact this
  have hbd : ∀ n, ‖(∫ z, F' n z * ψ (z - h n)) - ∫ z, F' n z * ψ z‖ ≤
      (eLpNorm (fun z => ψ (z - h n) - ψ z) 1 volume).toReal := by
    intro n
    have hi1 : Integrable (fun z => F' n z * ψ (z - h n)) :=
      aux_ann_integrable_mul (hF'm n).aestronglyMeasurable (hF'b n) (hψ.comp_sub_right (h n))
    have hi2 : Integrable (fun z => F' n z * ψ z) :=
      aux_ann_integrable_mul (hF'm n).aestronglyMeasurable (hF'b n) hψ
    have hm : AEStronglyMeasurable (fun z => ψ (z - h n) - ψ z) volume :=
      ((hψ.comp_sub_right (h n)).sub hψ).aestronglyMeasurable
    rw [← integral_sub hi1 hi2, eLpNorm_one_eq_lintegral_enorm hm,
      ← integral_norm_eq_lintegral_enorm hm]
    refine norm_integral_le_of_norm_le ((hψ.comp_sub_right (h n)).sub hψ).norm
      (ae_of_all _ fun z => ?_)
    rw [← mul_sub, norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (hF'b n z)
  have hh0 : Tendsto h atTop (𝓝 0) := by
    have := (tendsto_inv_atTop_zero.comp hadm.tendsto_R).smul_const t
    simpa using this
  have htr := (ext_approximation_translation (Or.inl rfl)
    (memLp_one_iff_integrable.2 hψ)).comp hh0
  have htr' : Tendsto (fun n => (eLpNorm (fun z => ψ (z - h n) - ψ z) 1 volume).toReal) atTop
      (𝓝 0) := by
    have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp htr
    simpa [Function.comp_def] using this
  have hF'eq : ∀ n, ∫ z, annT R f j n (s - t) z * conj (annT R f j n 0 z) * ψ z =
      ∫ z, F' n z * ψ z := fun n => rfl
  simp_rw [e, hF'eq]
  exact squeeze_zero_norm hbd htr'

/-- Auxiliary (`ann:spectral`): expanded squares are nonnegative. -/
theorem aux_ann_sum_mul_conj_nonneg {N : ℕ} (c T : Fin N → ℂ) :
    0 ≤ ∑ a, ∑ b, c a * conj (c b) * (T a * conj (T b)) := by
  have : ∑ a, ∑ b, c a * conj (c b) * (T a * conj (T b)) =
      (∑ a, c a * T a) * conj (∑ a, c a * T a) := by
    rw [map_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    rw [map_mul]; ring
  rw [this, Complex.mul_conj]
  exact Complex.zero_le_real.2 (Complex.normSq_nonneg _)

/-- Auxiliary (`ann:spectral`, see `Auto.ann_spectral`): the spectral measures for one vertex. -/
theorem aux_ann_spectral_one (hadm : IsAdmissibleSeq Q C R f)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (j : Fin 3) :
    ∃ ν : ℝ² → Measure ℝ², IsMeasurableKernel ν ∧ (∀ z, ν z univ ≤ 1) ∧
      ∀ᵐ z ∂(volume : Measure ℝ²), ∀ s t, k j z s t = ∫ ξ, e ⟪s - t, ξ⟫_ℝ ∂(ν z) := by
  classical
  set D := TopologicalSpace.denseSeq ℝ² with hDdef
  have hD : DenseRange D := TopologicalSpace.denseRange_denseSeq _
  set E := TopologicalSpace.denseSeq ℂ with hEdef
  have hE : DenseRange E := TopologicalSpace.denseRange_denseSeq _
  set g : ℕ → ℝ² → ℂ := fun i => (hlim.meas_two j (D i) 0).mk _ with hgdef
  have hgk : ∀ i, ∀ᵐ z ∂(volume : Measure ℝ²), k j z (D i) 0 = g i z := fun i =>
    (hlim.meas_two j (D i) 0).ae_eq_mk
  have hgm : ∀ i, StronglyMeasurable (g i) := fun i =>
    (hlim.meas_two j (D i) 0).stronglyMeasurable_mk
  have hPDd : ∀ d : Σ N : ℕ, (Fin N → ℕ) × (Fin N → ℕ), ∀ᵐ z ∂(volume : Measure ℝ²),
      0 ≤ ∑ a, ∑ b, E (d.2.2 a) * conj (E (d.2.2 b)) * k j z (D (d.2.1 a)) (D (d.2.1 b)) := by
    rintro ⟨N, ia, ic⟩
    have hFm : ∀ (ab : Fin N × Fin N) n, AEStronglyMeasurable (fun z =>
        annT R f j n (D (ia ab.1)) z * conj (annT R f j n (D (ia ab.2)) z)) volume :=
      fun ab n => by
        have hc := aux_ann_continuous hadm j n
        simp only [annT]
        exact (by fun_prop : Continuous _).aestronglyMeasurable
    have hFb : ∀ (ab : Fin N × Fin N) n z, ‖annT R f j n (D (ia ab.1)) z *
        conj (annT R f j n (D (ia ab.2)) z)‖ ≤ 1 := fun ab n z => by
      rw [norm_mul, Complex.norm_conj]
      exact (mul_le_of_le_one_left (norm_nonneg _) (aux_ann_annT_le_one hadm _ _ _ _)).trans
          (aux_ann_annT_le_one hadm _ _ _ _)
    have hlimit := aux_ann_weakStar_sum (μ := volume) (Finset.univ : Finset (Fin N × Fin N))
      (fun ab => E (ic ab.1) * conj (E (ic ab.2))) hFm hFb
      (fun ab => aux_ann_k_memLp hlim j _ _) (fun ab => hlim.two_point j _ _)
    have hmem : MemLp (fun z => ∑ ab : Fin N × Fin N, E (ic ab.1) * conj (E (ic ab.2)) *
        k j z (D (ia ab.1)) (D (ia ab.2))) ⊤ volume :=
      memLp_finsetSum _ fun ab _ => (aux_ann_k_memLp hlim j _ _).const_mul _
    have hnn := aux_ann_weakStar_nonneg hmem (fun n => ae_of_all _ fun z => by
      simp only [Fintype.sum_prod_type]
      exact aux_ann_sum_mul_conj_nonneg _ _) hlimit
    filter_upwards [hnn] with z hz
    simp only [Fintype.sum_prod_type] at hz
    exact hz
  have hTd : ∀ a b, ∀ᵐ z ∂(volume : Measure ℝ²), k j z (D a) (D b) = k j z (D a - D b) 0 :=
    fun a b => aux_ann_translation hadm hlim j _ _
  set Good0 : Set ℝ² := {z | Continuous (fun st : ℝ² × ℝ² => k j z st.1 st.2) ∧
    (∀ s t s' t', ‖k j z s t - k j z s' t'‖ ≤ L * (‖s - s'‖ + ‖t - t'‖)) ∧
    (∀ a b, k j z (D a) (D b) = k j z (D a - D b) 0) ∧
    (∀ d : Σ N : ℕ, (Fin N → ℕ) × (Fin N → ℕ),
      0 ≤ ∑ a, ∑ b, E (d.2.2 a) * conj (E (d.2.2 b)) * k j z (D (d.2.1 a)) (D (d.2.1 b))) ∧
    ∀ i, k j z (D i) 0 = g i z} with hGood0
  have hG0 : ∀ᵐ z ∂(volume : Measure ℝ²), z ∈ Good0 := by
    filter_upwards [hlim.cont_two, hlim.lip_two, ae_all_iff.2 fun a => ae_all_iff.2 (hTd a),
      ae_all_iff.2 hPDd, ae_all_iff.2 hgk] with z h1 h2 h3 h4 h5
    exact ⟨h1 j, h2 j, h3, h4, h5⟩
  set Good : Set ℝ² := (toMeasurable volume Good0ᶜ)ᶜ with hGooddef
  have hGm : MeasurableSet Good := (measurableSet_toMeasurable _ _).compl
  have hGsub : Good ⊆ Good0 := fun z hz => by
    by_contra h
    exact hz (subset_toMeasurable _ _ h)
  have hGae : ∀ᵐ z ∂(volume : Measure ℝ²), z ∈ Good := by
    rw [ae_iff]
    simp only [hGooddef, mem_compl_iff, not_not, ofPred_mem_eq, measure_toMeasurable]
    exact ae_iff.1 hG0
  -- consequences on the good set
  have hext : ∀ z ∈ Good0, ∀ s t, k j z s t = k j z (s - t) 0 := by
    intro z hz s t
    have hs := aux_ann_idx_tendsto D hD s
    have ht := aux_ann_idx_tendsto D hD t
    have h1 := (hz.1.tendsto (s, t)).comp (hs.prodMk_nhds ht)
    have h2 := (hz.1.tendsto (s - t, 0)).comp ((hs.sub ht).prodMk_nhds tendsto_const_nhds)
    refine tendsto_nhds_unique h1 ?_
    convert h2 using 1
    funext m
    exact hz.2.2.1 _ _
  have hPD : ∀ z ∈ Good0, IsPositiveDefinite fun s => k j z s 0 := by
    intro z hz N s c
    have hs := fun a => aux_ann_idx_tendsto D hD (s a)
    have hc := fun a => aux_ann_idx_tendsto E hE (c a)
    have hlim' : Tendsto (fun m => ∑ a, ∑ b, E (aux_ann_idx E hE m (c a)) *
        conj (E (aux_ann_idx E hE m (c b))) *
        k j z (D (aux_ann_idx D hD m (s a))) (D (aux_ann_idx D hD m (s b)))) atTop
        (𝓝 (∑ a, ∑ b, c a * conj (c b) * k j z (s a - s b) 0)) := by
      refine tendsto_finsetSum _ fun a _ => tendsto_finsetSum _ fun b _ => ?_
      rw [← hext z hz]
      exact ((hc a).mul ((Complex.continuous_conj.tendsto _).comp (hc b))).mul
        ((hz.1.tendsto (s a, s b)).comp ((hs a).prodMk_nhds (hs b)))
    exact ge_of_tendsto' hlim' fun m =>
      hz.2.2.2.1 ⟨N, fun a => aux_ann_idx D hD m (s a), fun a => aux_ann_idx E hE m (c a)⟩
  have hLip : ∀ z ∈ Good0, LipschitzWith (Real.toNNReal L) fun s => k j z s 0 := by
    intro z hz
    refine LipschitzWith.of_dist_le' fun s s' => ?_
    rw [dist_eq_norm, dist_eq_norm]
    simpa using hz.2.1 s 0 s' 0
  have hc0 : ∀ z ∈ Good0, k j z 0 0 ≤ 1 := by
    intro z hz
    have h := hPD z hz 1 ![0] ![1]
    simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
      Matrix.cons_val_fin_one, sub_self, map_one, mul_one, one_mul] at h
    have hb := hlim.bound_two j z 0 0
    rw [Complex.le_def]
    refine ⟨?_, ?_⟩
    · simp only [Complex.one_re]
      exact (Complex.re_le_norm _).trans hb
    · simp only [Complex.one_im]
      exact (Complex.nonneg_iff.1 h).2.symm
  -- the family `c`
  set c : ℝ² → ℝ² → ℂ := fun z s => if z ∈ Good then k j z s 0 else 0 with hcdef
  have hcPD : ∀ z, IsPositiveDefinite (c z) := by
    intro z
    by_cases hz : z ∈ Good
    · simpa [hcdef, hz] using hPD z (hGsub hz)
    · intro N s w
      simp [hcdef, hz]
  have hcL : ∀ z, ∃ K, LipschitzWith K (c z) := by
    intro z
    by_cases hz : z ∈ Good
    · exact ⟨_, by simpa [hcdef, hz] using hLip z (hGsub hz)⟩
    · exact ⟨0, by simp [hcdef, hz, LipschitzWith.const (0 : ℂ)]⟩
  have hc1 : ∀ z, c z 0 ≤ 1 := by
    intro z
    by_cases hz : z ∈ Good
    · simpa [hcdef, hz] using hc0 z (hGsub hz)
    · simp [hcdef, hz]
  have hcm : ∀ s, Measurable fun z => c z s := by
    intro s
    refine measurable_of_tendsto_metrizable (f := fun m z =>
      if z ∈ Good then g (aux_ann_idx D hD m s) z else 0)
      (fun m => Measurable.ite hGm (hgm _).measurable measurable_const) ?_
    rw [tendsto_pi_nhds]
    intro z
    by_cases hz : z ∈ Good
    · simp only [hcdef, ite_eq_left hz]
      have hz0 := hGsub hz
      have := (hz0.1.tendsto (s, 0)).comp ((aux_ann_idx_tendsto D hD s).prodMk_nhds
        tendsto_const_nhds)
      convert this using 1
      funext m
      exact (hz0.2.2.2.2 _).symm
    · simp only [hcdef, ite_eq_right hz]
      exact tendsto_const_nhds
  -- the measures
  set ν : ℝ² → Measure ℝ² := fun z => (ext_bochner (hcPD z) (hcL z)).exists.choose with hνdef
  have hνspec := fun z => (ext_bochner (hcPD z) (hcL z)).exists.choose_spec
  have hνfin : ∀ z, IsFiniteMeasure (ν z) := fun z => (hνspec z).1
  have hνrep : ∀ z s, c z s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂(ν z) :=
    fun z => (hνspec z).2.1
  refine ⟨ν, ⟨hνfin, fun B hB => ext_measurable_spectral c hcm hcL ν hνrep hB⟩,
    fun z => ?_, ?_⟩
  · rw [(hνspec z).2.2]
    exact ENNReal.ofReal_le_one.2 (Complex.le_def.1 (hc1 z)).1
  · filter_upwards [hGae] with z hz s t
    rw [hext z (hGsub hz) s t, show k j z (s - t) 0 = c z (s - t) by simp [hcdef, hz],
      hνrep z (s - t)]
    congr 1
    funext ξ
    simp only [e]
    push_cast
    ring_nf

end Spectral

/-- **Lemma `ann:spectral`** (Measurable spectral measures).
For a subsequence as in Lemma `ann:extract`, there are measurable kernels of finite positive
Borel measures $z\mapsto\nu_{j,z}$ on $\mathbb R^2$, of mass at most one, such that
$$k_j(z;s,t)=\int_{\mathbb R^2}\mathrm e((s-t)\cdot\xi)\,d\nu_{j,z}(\xi)$$
for almost every $z$ and all $s,t\in\mathbb R^2$. -/
theorem ann_spectral (α β : ℝ) (Q : Set ℝ²) (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ)
    (hadm : IsAdmissibleSeq Q C R f) (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ)
    (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ) (hlim : aux_IsCorrelationLimits α β L R f k h3) :
    ∃ ν : Fin 3 → ℝ² → Measure ℝ², aux_IsSpectralKernels k ν := by
  choose ν hνk hν1 hνrep using fun j => aux_ann_spectral_one hadm hlim j
  exact ⟨ν, hνk, hν1, ae_all_iff.2 hνrep⟩

/-! ### Polynomial translates (`ann:polynomials`) -/

/-- The character $e_s(\xi)=\mathrm e(s\cdot\xi)$ (`\label{ann:polynomials}`). -/
def charE (s ξ : ℝ²) : ℂ := e ⟪s, ξ⟫_ℝ

/-- The trigonometric polynomial $a=\sum_s c_se_s$ with coefficients `c`
(`\label{ann:polynomials}`). -/
def trigPoly (c : ℝ² →₀ ℂ) (ξ : ℝ²) : ℂ := c.sum fun s a => a * charE s ξ

/-- The finite tensor sum $G=\sum_{s,t}c_{s,t}\,e_s\otimes e_t$ with coefficients `c`
(`\label{ann:polynomials}`); every finite sum $\sum_d b_d\otimes c_d$ of elementary tensors of
trigonometric polynomials has this form. -/
def tensorPoly (c : ℝ² × ℝ² →₀ ℂ) (ξ : ℝ² × ℝ²) : ℂ :=
  c.sum fun st a => a * charE st.1 ξ.1 * charE st.2 ξ.2

/-- The polynomial translate $F_{j,n}[a](z)=\sum_s c_sT^s_{j,n}(z)$ for $a=\sum_s c_se_s$
(`\label{ann:polynomials}`). -/
def polyTranslate (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (j : Fin 3) (n : ℕ) (c : ℝ² →₀ ℂ)
    (z : ℝ²) : ℂ :=
  c.sum fun s a => a * annT R f j n s z

/-- The tensor translate (`\label{ann:polynomials}`)
$$G_n(p)=\sum_{d=1}^D F_{1,n}[b_d](\pi_1p)F_{2,n}[c_d](\pi_2p)
=\sum_{s,t}c_{s,t}T^s_{1,n}(\pi_1p)T^t_{2,n}(\pi_2p)$$
for $G=\sum_{s,t}c_{s,t}e_s\otimes e_t$. -/
def tensorTranslate (α β : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (n : ℕ)
    (c : ℝ² × ℝ² →₀ ℂ) (p : ℝ² × Ang) : ℂ :=
  c.sum fun st a => a * annT R f 1 n st.1 (proj α β 1 p) * annT R f 2 n st.2 (proj α β 2 p)

/-! ### Factorization of two-vertex quadratic correlations (`ann:factor`) -/

/-! ### Auxiliary material for `ann:factor` -/

section AnnFactorAux

open Metric

/-- Auxiliary: `e(x) \overline{e(y)} = e(x-y)`. -/
theorem aux_ann_e_mul_conj (x y : ℝ) : e x * conj (e y) = e (x - y) := by
  simp only [e, ← Complex.exp_conj, ← Complex.exp_add, map_mul, Complex.conj_ofReal,
    Complex.conj_I, map_ofNat]
  congr 1
  push_cast
  ring

/-- Auxiliary: `|e(x)| = 1`. -/
theorem aux_ann_norm_e (x : ℝ) : ‖e x‖ = 1 := by
  rw [e, show (2 * (π : ℂ) * (x : ℂ) * Complex.I) = ((2 * π * x : ℝ) : ℂ) * Complex.I by
    push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

/-- Auxiliary: `e` is continuous. -/
theorem aux_ann_continuous_e : Continuous e := by
  unfold e; fun_prop

/-- Auxiliary: `e_s \overline{e_t} = e_{s-t}`. -/
theorem aux_ann_charE_mul_conj (s t ξ : ℝ²) :
    charE s ξ * conj (charE t ξ) = e ⟪s - t, ξ⟫_ℝ := by
  rw [charE, charE, aux_ann_e_mul_conj, inner_sub_left]

/-- Auxiliary: expansion of `|∑ c_s w_s|²`. -/
theorem aux_ann_normSq_sum {ι : Type*} (S : Finset ι) (c w : ι → ℂ) :
    ((‖∑ s ∈ S, c s * w s‖ ^ 2 : ℝ) : ℂ) =
      ∑ st ∈ S ×ˢ S, c st.1 * conj (c st.2) * (w st.1 * conj (w st.2)) := by
  push_cast
  rw [← Complex.mul_conj', map_sum, Finset.sum_mul_sum, Finset.sum_product]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
  rw [map_mul]; ring

/-- Auxiliary: characters are integrable for finite measures. -/
theorem aux_ann_integrable_e (ν : Measure ℝ²) [IsFiniteMeasure ν] (s : ℝ²) (c : ℂ) :
    Integrable (fun ξ => c * e ⟪s, ξ⟫_ℝ) ν := by
  refine Integrable.of_bound (by
    have := aux_ann_continuous_e
    fun_prop : Continuous fun ξ : ℝ² => c * e ⟪s, ξ⟫_ℝ).aestronglyMeasurable ‖c‖
    (ae_of_all _ fun ξ => ?_)
  rw [norm_mul, aux_ann_norm_e, mul_one]

/-- Auxiliary (`ann:factor`): `∫ |a|² dν` expanded in the coefficients of `a`. -/
theorem aux_ann_integral_normSq_trigPoly (ν : Measure ℝ²) [IsFiniteMeasure ν] (a : ℝ² →₀ ℂ) :
    ((∫ ξ, ‖trigPoly a ξ‖ ^ 2 ∂ν : ℝ) : ℂ) = ∑ st ∈ a.support ×ˢ a.support,
      a st.1 * conj (a st.2) * ∫ ξ, e ⟪st.1 - st.2, ξ⟫_ℝ ∂ν := by
  rw [← integral_complex_ofReal]
  simp_rw [trigPoly, Finsupp.sum, aux_ann_normSq_sum, aux_ann_charE_mul_conj]
  rw [integral_finsetSum _ fun st _ => aux_ann_integrable_e ν _ _]
  exact Finset.sum_congr rfl fun st _ => integral_const_mul _ _

section Factor

variable {α β : ℝ} {Q : Set ℝ²} {C L : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
  {k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ} {h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ}

/-- Auxiliary: the two-point products are measurable and bounded by one. -/
theorem aux_ann_two_point_meas (hadm : IsAdmissibleSeq Q C R f) (j : Fin 3) (n : ℕ)
    (s t : ℝ²) : Measurable fun z => annT R f j n s z * conj (annT R f j n t z) := by
  have hc := aux_ann_continuous hadm j n
  simp only [annT]
  exact (by fun_prop : Continuous _).measurable

theorem aux_ann_two_point_le (hadm : IsAdmissibleSeq Q C R f) (j : Fin 3) (n : ℕ)
    (s t z : ℝ²) : ‖annT R f j n s z * conj (annT R f j n t z)‖ ≤ 1 := by
  rw [norm_mul, Complex.norm_conj]
  exact (mul_le_of_le_one_left (norm_nonneg _) (aux_ann_annT_le_one hadm _ _ _ _)).trans
      (aux_ann_annT_le_one hadm _ _ _ _)

/-- Auxiliary (`ann:factor`, see `Auto.ann_factor_one`; also used for `ann:form`): one-vertex
quadratic correlations,
$|F_{j,n}[a]|^2\rightharpoonup^*\int|a|^2\,d\nu_{j,z}$ on the vertex space. -/
theorem aux_ann_factor_vertex (hadm : IsAdmissibleSeq Q C R f)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) {ν : Fin 3 → ℝ² → Measure ℝ²}
    (hν : aux_IsSpectralKernels k ν) (j : Fin 3) (a : ℝ² →₀ ℂ) :
    annWeakStar volume (fun n z => ((‖polyTranslate R f j n a z‖ ^ 2 : ℝ) : ℂ))
      (fun z => ((∫ ξ, ‖trigPoly a ξ‖ ^ 2 ∂(ν j z) : ℝ) : ℂ)) ∧
    MemLp (fun z => ((∫ ξ, ‖trigPoly a ξ‖ ^ 2 ∂(ν j z) : ℝ) : ℂ)) ⊤ volume := by
  have hfin : ∀ z, IsFiniteMeasure (ν j z) := (hν.1 j).1
  set S := a.support ×ˢ a.support
  have h1 := aux_ann_weakStar_sum (μ := volume) S (fun st => a st.1 * conj (a st.2))
    (F := fun st n z => annT R f j n st.1 z * conj (annT R f j n st.2 z))
    (G := fun st z => k j z st.1 st.2)
    (fun st n => (aux_ann_two_point_meas hadm j n _ _).aestronglyMeasurable)
    (fun st n z => aux_ann_two_point_le hadm j n _ _ z)
    (fun st => aux_ann_k_memLp hlim j _ _) (fun st => hlim.two_point j _ _)
  have hmem : MemLp (fun z => ∑ st ∈ S, a st.1 * conj (a st.2) * k j z st.1 st.2) ⊤ volume :=
    memLp_finsetSum _ fun st _ => (aux_ann_k_memLp hlim j _ _).const_mul _
  have hae : (fun z => ∑ st ∈ S, a st.1 * conj (a st.2) * k j z st.1 st.2) =ᵐ[volume]
      fun z => ((∫ ξ, ‖trigPoly a ξ‖ ^ 2 ∂(ν j z) : ℝ) : ℂ) := by
    filter_upwards [hν.2.2] with z hz
    rw [aux_ann_integral_normSq_trigPoly]
    exact Finset.sum_congr rfl fun st _ => by rw [hz j st.1 st.2]
  refine ⟨fun ψ hψ => ?_, hmem.ae_eq hae⟩
  have e1 : ∀ n, ∫ z, ((‖polyTranslate R f j n a z‖ ^ 2 : ℝ) : ℂ) * ψ z =
      ∫ z, (∑ st ∈ S, a st.1 * conj (a st.2) *
        (annT R f j n st.1 z * conj (annT R f j n st.2 z))) * ψ z := fun n => by
    congr 1; funext z
    rw [polyTranslate, Finsupp.sum, aux_ann_normSq_sum]
  have e2 : ∫ z, ((∫ ξ, ‖trigPoly a ξ‖ ^ 2 ∂(ν j z) : ℝ) : ℂ) * ψ z =
      ∫ z, (∑ st ∈ S, a st.1 * conj (a st.2) * k j z st.1 st.2) * ψ z :=
    integral_congr_ae (by filter_upwards [hae] with z hz; rw [hz])
  simp_rw [e1]
  rw [e2]
  exact h1 ψ hψ

/-- Auxiliary (`ann:factor`): pullback of weak-* convergence by `(x, θ) ↦ x`. -/
theorem aux_ann_weakStar_pullback_fst {F : ℕ → ℝ² → ℂ} {G : ℝ² → ℂ} {B : ℝ}
    (hFm : ∀ n, AEStronglyMeasurable (F n) volume) (hFb : ∀ n x, ‖F n x‖ ≤ B)
    (hG : MemLp G ⊤ volume) (h : annWeakStar volume F G) :
    annWeakStar μinc (fun n p => F n p.1) (fun p => G p.1) := by
  intro ψ hψ
  have hψ' : Integrable ψ ((volume : Measure ℝ²).prod σ) := hψ
  have hmp : MeasurePreserving (Prod.fst : ℝ² × Ang → ℝ²) ((volume : Measure ℝ²).prod σ)
      volume := measurePreserving_fst
  have hiF : ∀ n, Integrable (fun p : ℝ² × Ang => F n p.1 * ψ p) ((volume : Measure ℝ²).prod σ) :=
    fun n => hψ'.bdd_mul ((hFm n).comp_measurePreserving hmp) (ae_of_all _ fun p => hFb n p.1)
  have hiG : Integrable (fun p : ℝ² × Ang => G p.1 * ψ p) ((volume : Measure ℝ²).prod σ) :=
    (hG.comp_measurePreserving hmp).integrable_mul (memLp_one_iff_integrable.2 hψ')
  have e1 : ∀ n, ∫ p, F n p.1 * ψ p ∂μinc = ∫ x, F n x * ∫ θ, ψ (x, θ) ∂σ := fun n => by
    rw [μinc, integral_prod _ (hiF n)]
    simp_rw [integral_const_mul]
  have e2 : ∫ p, G p.1 * ψ p ∂μinc = ∫ x, G x * ∫ θ, ψ (x, θ) ∂σ := by
    rw [μinc, integral_prod _ hiG]
    simp_rw [integral_const_mul]
  simp_rw [e1, e2]
  exact h _ hψ'.integral_prod_left

/-- Auxiliary: `π_0(x,θ) = x`. -/
theorem aux_ann_proj_zero (α β : ℝ) (p : ℝ² × Ang) : proj α β 0 p = p.1 := by
  simp [proj, Lv]

end Factor

/-- Auxiliary (`ann:factor`): the shear `(z, θ) ↦ (z + φ(θ), θ)` as a measurable equivalence. -/
@[nolint defsWithUnderscore]
def aux_ann_shearEquiv (φ : Ang → ℝ²) (hφ : Measurable φ) : ℝ² × Ang ≃ᵐ ℝ² × Ang where
  toFun p := (p.1 + φ p.2, p.2)
  invFun q := (q.1 - φ q.2, q.2)
  left_inv p := by simp
  right_inv q := by simp
  measurable_toFun := (measurable_fst.add (hφ.comp measurable_snd)).prodMk measurable_snd
  measurable_invFun := (measurable_fst.sub (hφ.comp measurable_snd)).prodMk measurable_snd

/-- Auxiliary (`ann:factor`): shears preserve `μ`. -/
theorem aux_ann_shear_mp (φ : Ang → ℝ²) (hφ : Measurable φ) :
    MeasurePreserving (aux_ann_shearEquiv φ hφ) μinc μinc := by
  have hsk : MeasurePreserving (fun q : Ang × ℝ² => (q.1, q.2 + φ q.1))
      (σ.prod (volume : Measure ℝ²)) (σ.prod volume) := by
    refine (MeasurePreserving.id σ).skew_product (g := fun θ x => x + φ θ)
      (measurable_snd.add (hφ.comp measurable_fst)) (Eventually.of_forall fun θ => ?_)
    exact (measurePreserving_add_right volume _).map_eq
  exact (Measure.measurePreserving_swap (μ := σ) (ν := (volume : Measure ℝ²))).comp
    (hsk.comp (Measure.measurePreserving_swap (μ := (volume : Measure ℝ²)) (ν := σ)))

/-- Auxiliary: `(z, θ) ↦ z + φ(θ)` pushes `μ` to Lebesgue measure. -/
theorem aux_ann_add_mp (φ : Ang → ℝ²) (hφ : Measurable φ) :
    MeasurePreserving (fun q : ℝ² × Ang => q.1 + φ q.2) μinc volume := by
  have h1 : MeasurePreserving (Prod.fst : ℝ² × Ang → ℝ²) μinc volume := by
    unfold μinc; exact measurePreserving_fst
  exact h1.comp (aux_ann_shear_mp φ hφ)

/-- Auxiliary: `|u_θ| = 1`. -/
theorem aux_ann_norm_u (θ : Ang) : ‖u θ‖ = 1 := by
  induction θ using QuotientAddGroup.induction_on with
  | H t =>
    rw [aux_u_coe, EuclideanSpace.norm_eq, Fin.sum_univ_two]
    simp [aux_uR, Real.cos_sq_add_sin_sq]

/-- Auxiliary (`ann:factor`): the matrix `N = M - I`. -/
@[nolint defsWithUnderscore]
abbrev aux_ann_N (α β : ℝ) : ℝ² →L[ℝ] ℝ² := M α β - ContinuousLinearMap.id ℝ ℝ²

/-- Auxiliary (`ann:factor`): `M - I` is a nonzero similarity when `β ≠ 0`. -/
theorem aux_ann_N_simil (α β : ℝ) (hβ : β ≠ 0) :
    ∃ c > 0, ∀ x, ‖aux_ann_N α β x‖ = c * ‖x‖ := by
  refine ⟨Real.sqrt ((α - 1) ^ 2 + β ^ 2), Real.sqrt_pos.2 (by positivity), fun x => ?_⟩
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq, ← Real.sqrt_mul (by positivity)]
  congr 1
  simp [Fin.sum_univ_two, aux_ann_N, simil]
  ring

/-- Auxiliary: `π_2 p = π_1 p + (M - I) u_θ`. -/
theorem aux_ann_proj_two (α β : ℝ) (p : ℝ² × Ang) :
    proj α β 2 p = proj α β 1 p + aux_ann_N α β (u p.2) := by
  simp [proj, Lv, aux_ann_N]

/-- Auxiliary (`ann:factor`): circle operators respect a.e. equality of the input. -/
theorem aux_ann_circleOp_congr (N : ℝ² →L[ℝ] ℝ²) (W : ℝ² → Ang → ℂ) {f f' : ℝ² → ℂ}
    (h : f =ᵐ[volume] f') : circleOp N W f =ᵐ[volume] circleOp N W f' := by
  have hmp := aux_ann_add_mp (fun θ => N (u θ)) (N.continuous.measurable.comp aux_lw_u_meas)
  have h1 : ∀ᵐ q ∂μinc, f (q.1 + N (u q.2)) = f' (q.1 + N (u q.2)) :=
    hmp.quasiMeasurePreserving.ae_eq_comp h
  have h2 := Measure.ae_ae_of_ae_prod (μ := (volume : Measure ℝ²)) (ν := σ) h1
  filter_upwards [h2] with z hz
  unfold circleOp
  exact integral_congr_ae (hz.mono fun θ hθ => by simp only; rw [hθ])

/-- Auxiliary: Cauchy–Schwarz for integrals of products. -/
theorem aux_ann_norm_integral_mul_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {a b : X → ℂ} (ha : MemLp a 2 μ) (hb : MemLp b 2 μ) :
    ‖∫ x, a x * b x ∂μ‖ ≤ (eLpNorm a 2 μ).toReal * (eLpNorm b 2 μ).toReal := by
  have hH : ENNReal.HolderTriple 2 2 1 := ⟨by norm_num [ENNReal.inv_two_add_inv_two]⟩
  have h1 : eLpNorm (fun x => a x * b x) 1 μ ≤ 1 * eLpNorm a 2 μ * eLpNorm b 2 μ :=
    eLpNorm_le_eLpNorm_mul_eLpNorm (· * ·) 1 continuous_mul ha.aestronglyMeasurable
      hb.aestronglyMeasurable (ae_of_all _ fun x => by simp [nnnorm_mul])
  rw [one_mul] at h1
  have hfin : eLpNorm a 2 μ * eLpNorm b 2 μ ≠ ⊤ :=
    ENNReal.mul_ne_top ha.eLpNorm_lt_top.ne hb.eLpNorm_lt_top.ne
  calc ‖∫ x, a x * b x ∂μ‖ ≤ ∫ x, ‖a x * b x‖ ∂μ := norm_integral_le_integral_norm _
    _ = (eLpNorm (fun x => a x * b x) 1 μ).toReal := by
        rw [integral_norm_eq_lintegral_enorm (f := fun x => a x * b x)
            (ha.aestronglyMeasurable.mul hb.aestronglyMeasurable),
          eLpNorm_one_eq_lintegral_enorm (f := fun x => a x * b x)
            (ha.aestronglyMeasurable.mul hb.aestronglyMeasurable)]
    _ ≤ (eLpNorm a 2 μ * eLpNorm b 2 μ).toReal := ENNReal.toReal_mono hfin h1
    _ = _ := ENNReal.toReal_mul

/-- Auxiliary: bounded functions restricted to a set of finite measure are square integrable. -/
theorem aux_ann_memLp_two_indicator {Y : Set ℝ²} (hY : MeasurableSet Y) (hYf : volume Y < ∞)
    {b : ℝ² → ℂ} (hb : AEStronglyMeasurable b volume) (hb1 : ∀ x, ‖b x‖ ≤ 1) :
    MemLp (Y.indicator b) 2 volume := by
  rw [memLp_indicator_iff_restrict hY.nullMeasurableSet]
  have : IsFiniteMeasure (volume.restrict Y) := ⟨by rw [Measure.restrict_apply_univ]; exact hYf⟩
  exact (memLp_top_of_bound hb.restrict 1 (ae_of_all _ hb1)).mono_exponent le_top

/-- Auxiliary: indicators of bounded sets times `σ` are integrable. -/
theorem aux_ann_ball_integrable (r : ℝ) :
    Integrable ((closedBall (0 : ℝ²) r ×ˢ (univ : Set Ang)).indicator fun _ => (1 : ℝ)) μinc := by
  refine (integrable_indicator_iff (measurableSet_closedBall.prod MeasurableSet.univ)).2
    (integrableOn_const ?_)
  rw [μinc, Measure.prod_prod]
  exact ENNReal.mul_ne_top measure_closedBall_lt_top.ne (measure_ne_top _ _)

/-- Auxiliary: square-integrable functions are integrable on sets of finite measure. -/
theorem aux_ann_integrable_indicator_L2 {X : Set ℝ²} (hX : MeasurableSet X) (hXf : volume X < ∞)
    {g : ℝ² → ℂ} (hg : MemLp g 2 volume) : Integrable (X.indicator g) volume := by
  have : IsFiniteMeasure (volume.restrict X) := ⟨by rw [Measure.restrict_apply_univ]; exact hXf⟩
  exact IntegrableOn.integrable_indicator ((hg.restrict X).integrable one_le_two) hX

/-- Auxiliary (`ann:factor`): the pairing of a vertex product with a localized test function as
a pairing with a circle operator (change of variables `z = x + u_θ`). -/
theorem aux_ann_pair_integral (α β : ℝ) {a b : ℝ² → ℂ} (ha : Measurable a) (hb : Measurable b)
    (ha1 : ∀ x, ‖a x‖ ≤ 1) (hb1 : ∀ x, ‖b x‖ ≤ 1) {φ : ℝ² × Ang → ℂ} (hφm : Measurable φ)
    (hφb : ∀ p, ‖φ p‖ ≤ 1) {ρ : ℝ} (hφs : ∀ p, ρ < ‖p.1‖ → φ p = 0) :
    ∫ p, a (proj α β 1 p) * b (proj α β 2 p) * φ p ∂μinc =
      ∫ z, a z * circleOp (aux_ann_N α β) (fun z θ => φ (z - u θ, θ)) b z := by
  set N := aux_ann_N α β with hN
  have hmp := aux_ann_shear_mp u aux_lw_u_meas
  set g : ℝ² × Ang → ℂ := fun q => a q.1 * (φ (q.1 - u q.2, q.2) * b (q.1 + N (u q.2)))
    with hg
  have hrw : ∀ p, a (proj α β 1 p) * b (proj α β 2 p) * φ p =
      g (aux_ann_shearEquiv u aux_lw_u_meas p) := by
    intro p
    have h1 : proj α β 1 p = p.1 + u p.2 := by simp [proj, Lv]
    change _ = g (p.1 + u p.2, p.2)
    simp only [hg, aux_ann_proj_two, h1, add_sub_cancel_right]
    ring
  simp_rw [hrw]
  rw [hmp.integral_comp' g]
  have hgm : Measurable g :=
    (ha.comp measurable_fst).mul ((hφm.comp ((measurable_fst.sub (aux_lw_u_meas.comp
      measurable_snd)).prodMk measurable_snd)).mul (hb.comp (measurable_fst.add
        (N.continuous.measurable.comp (aux_lw_u_meas.comp measurable_snd)))))
  have hgi : Integrable g μinc := by
    refine (aux_ann_ball_integrable (ρ + 1)).mono' hgm.aestronglyMeasurable
      (ae_of_all _ fun q => ?_)
    by_cases hq : ‖q.1‖ ≤ ρ + 1
    · rw [indicator_of_mem (by simp [hq])]
      simp only [hg, norm_mul]
      calc ‖a q.1‖ * (‖φ (q.1 - u q.2, q.2)‖ * ‖b (q.1 + N (u q.2))‖) ≤ 1 * (1 * 1) := by
            gcongr
            · exact ha1 _
            · exact hφb _
            · exact hb1 _
        _ = 1 := by ring
    · have h0 : φ (q.1 - u q.2, q.2) = 0 := by
        apply hφs
        have := norm_sub_norm_le q.1 (u q.2)
        rw [aux_ann_norm_u] at this
        simp only
        linarith
      simp only [hg, h0, zero_mul, mul_zero, norm_zero]
      exact indicator_nonneg (fun _ _ => zero_le_one) _
  rw [μinc, integral_prod g hgi]
  refine integral_congr_ae (ae_of_all _ fun z => ?_)
  simp only [hg, circleOp]
  rw [integral_const_mul]

/-- Auxiliary (`ann:factor`, see `Auto.ann_factor_two`): the two-vertex product of weak-*
convergent bounded sequences converges against bounded tests with bounded support, by compactness
of the circle operator (`lem:circle-compact`) and `ext:compact-facts`. -/
theorem aux_ann_pair_tendsto_bounded (α β : ℝ) (hβ : β ≠ 0) {A B : ℕ → ℝ² → ℂ}
    {A0 B0 : ℝ² → ℂ} (hAm : ∀ n, Measurable (A n)) (hBm : ∀ n, Measurable (B n))
    (hAb : ∀ n x, ‖A n x‖ ≤ 1) (hBb : ∀ n x, ‖B n x‖ ≤ 1) (hA0m : Measurable A0)
    (hB0m : Measurable B0) (hA0b : ∀ x, ‖A0 x‖ ≤ 1) (hB0b : ∀ x, ‖B0 x‖ ≤ 1)
    (hA : annWeakStar volume A A0) (hB : annWeakStar volume B B0)
    {φ : ℝ² × Ang → ℂ} (hφm : Measurable φ) (hφb : ∀ p, ‖φ p‖ ≤ 1) {ρ : ℝ}
    (hφs : ∀ p, ρ < ‖p.1‖ → φ p = 0) :
    Tendsto (fun n => ∫ p, A n (proj α β 1 p) * B n (proj α β 2 p) * φ p ∂μinc) atTop
      (𝓝 (∫ p, A0 (proj α β 1 p) * B0 (proj α β 2 p) * φ p ∂μinc)) := by
  have e1 : ∀ n, ∫ p, A n (proj α β 1 p) * B n (proj α β 2 p) * φ p ∂μinc =
      ∫ z, A n z * circleOp (aux_ann_N α β) (fun z θ => φ (z - u θ, θ)) (B n) z := fun n =>
    aux_ann_pair_integral α β (hAm n) (hBm n) (hAb n) (hBb n) hφm hφb hφs
  rw [aux_ann_pair_integral α β hA0m hB0m hA0b hB0b hφm hφb hφs]
  simp_rw [e1]
  set N := aux_ann_N α β with hNdef
  set W : ℝ² → Ang → ℂ := fun z θ => φ (z - u θ, θ) with hW
  obtain ⟨c, hc, hNc⟩ := aux_ann_N_simil α β hβ
  set X := closedBall (0 : ℝ²) (ρ + 1) with hXdef
  set Y := closedBall (0 : ℝ²) (ρ + 1 + c) with hYdef
  have hWm : Measurable (Function.uncurry W) :=
    hφm.comp ((measurable_fst.sub (aux_lw_u_meas.comp measurable_snd)).prodMk measurable_snd)
  have hW1 : ∀ z θ, ‖W z θ‖ ≤ 1 := fun z θ => hφb _
  have hWX : ∀ z θ, z ∉ X → W z θ = 0 := by
    intro z θ hz
    apply hφs
    simp only [hXdef, mem_closedBall, dist_zero_right, not_le] at hz
    have := norm_sub_norm_le z (u θ)
    rw [aux_ann_norm_u] at this
    simp only
    linarith
  obtain ⟨T, hT, hTc⟩ := lem_circle_compact N ⟨c, hc, hNc⟩ W hWm hW1 X isBounded_closedBall hWX
  have hXf : volume X < ∞ := measure_closedBall_lt_top
  have hYf : volume Y < ∞ := measure_closedBall_lt_top
  have hCY : ∀ b z, circleOp N W b z = circleOp N W (Y.indicator b) z := by
    intro b z
    unfold circleOp
    congr 1; funext θ
    by_cases hz : z ∈ X
    · rw [indicator_of_mem]
      simp only [hYdef, mem_closedBall, dist_zero_right]
      simp only [hXdef, mem_closedBall, dist_zero_right] at hz
      calc ‖z + N (u θ)‖ ≤ ‖z‖ + ‖N (u θ)‖ := norm_add_le _ _
        _ ≤ ρ + 1 + c := by rw [hNc, aux_ann_norm_u, mul_one]; linarith
    · rw [hWX z θ hz, zero_mul, zero_mul]
  have hCX : ∀ b z, z ∉ X → circleOp N W b z = 0 := by
    intro b z hz; unfold circleOp; simp [hWX z _ hz]
  have hBmem : ∀ n, MemLp (Y.indicator (B n)) 2 volume := fun n =>
    aux_ann_memLp_two_indicator measurableSet_closedBall hYf (hBm n).aestronglyMeasurable (hBb n)
  have hB0mem : MemLp (Y.indicator B0) 2 volume :=
    aux_ann_memLp_two_indicator measurableSet_closedBall hYf hB0m.aestronglyMeasurable hB0b
  have hAmem : ∀ n, MemLp (X.indicator (A n)) 2 volume := fun n =>
    aux_ann_memLp_two_indicator measurableSet_closedBall hXf (hAm n).aestronglyMeasurable (hAb n)
  have h1mem : ∀ {Z : Set ℝ²}, Z = X ∨ Z = Y → MemLp (Z.indicator fun _ => (1 : ℂ)) 2 volume :=
    fun {Z} hZ => by
      rcases hZ with rfl | rfl
      · exact aux_ann_memLp_two_indicator measurableSet_closedBall hXf
          aestronglyMeasurable_const (fun _ => by simp)
      · exact aux_ann_memLp_two_indicator measurableSet_closedBall hYf
          aestronglyMeasurable_const (fun _ => by simp)
  have hle1 : ∀ (Z : Set ℝ²) (b : ℝ² → ℂ), MeasurableSet Z → AEStronglyMeasurable b volume →
      (∀ x, ‖b x‖ ≤ 1) →
      eLpNorm (Z.indicator b) 2 volume ≤ eLpNorm (Z.indicator fun _ => (1 : ℂ)) 2 volume := by
    intro Z b hZ hbm hb
    refine eLpNorm_mono (hbm.indicator hZ) fun x => ?_
    by_cases hx : x ∈ Z <;> simp [hx, hb x]
  set Bl : ℕ → Lp ℂ 2 (volume : Measure ℝ²) := fun n => (hBmem n).toLp _ with hBl
  set B0l : Lp ℂ 2 (volume : Measure ℝ²) := hB0mem.toLp _ with hB0l
  have hbound : ∃ C, ∀ n, ‖Bl n‖ ≤ C := by
    refine ⟨(eLpNorm (Y.indicator fun _ => (1 : ℂ)) 2 volume).toReal, fun n => ?_⟩
    rw [hBl, Lp.norm_toLp]
    exact ENNReal.toReal_mono (h1mem (Or.inr rfl)).eLpNorm_lt_top.ne
      (hle1 Y _ measurableSet_closedBall (hBm n).aestronglyMeasurable (hBb n))
  have hinner : ∀ (h : Lp ℂ 2 (volume : Measure ℝ²)) (b : ℝ² → ℂ)
      (hb : MemLp (Y.indicator b) 2 volume),
      ⟪h, hb.toLp _⟫_ℂ = ∫ x, b x * Y.indicator (fun x => conj (h x)) x := by
    intro h b hb
    rw [L2.inner_def]
    refine integral_congr_ae ?_
    filter_upwards [hb.coeFn_toLp] with x hx
    rw [hx, RCLike.inner_apply']
    by_cases hxY : x ∈ Y <;> simp [hxY, mul_comm]
  have hweak : ∀ h : Lp ℂ 2 (volume : Measure ℝ²),
      Tendsto (fun n => ⟪h, Bl n⟫_ℂ) atTop (𝓝 ⟪h, B0l⟫_ℂ) := by
    intro h
    have hint : Integrable (Y.indicator fun x => conj (h x)) volume :=
      aux_ann_integrable_indicator_L2 measurableSet_closedBall hYf
        ((Lp.memLp h).star.congr_norm (by
          exact (Lp.memLp h).aestronglyMeasurable.star.congr (ae_of_all _ fun x => rfl))
          (ae_of_all _ fun x => by simp))
    simp_rw [hBl, hB0l, hinner]
    exact hB _ hint
  have hTconv := ext_compact_facts_weak T hTc Bl B0l hbound hweak
  have hrw : ∀ (b : ℝ² → ℂ) (hb : MemLp (Y.indicator b) 2 volume) (a : ℝ² → ℂ),
      ∫ z, a z * circleOp N W b z = ∫ z, X.indicator a z * T (hb.toLp _) z := by
    intro b hb a
    refine integral_congr_ae ?_
    have h1 := aux_ann_circleOp_congr N W hb.coeFn_toLp
    filter_upwards [h1, hT (hb.toLp _)] with z hz1 hz2
    rw [hz2, hz1, ← hCY]
    by_cases hz : z ∈ X
    · rw [indicator_of_mem hz]
    · rw [indicator_of_notMem hz, hCX b z hz, mul_zero, zero_mul]
  rw [hrw B0 hB0mem A0]
  have e2 : ∀ n, ∫ z, A n z * circleOp N W (B n) z ∂volume =
      (∫ z, X.indicator (A n) z * (⇑(T (Bl n)) z - ⇑(T B0l) z)) +
        ∫ z, A n z * X.indicator (⇑(T B0l)) z := by
    intro n
    have hi1 : Integrable (fun z => X.indicator (A n) z * (⇑(T (Bl n)) z - ⇑(T B0l) z)) :=
      (hAmem n).integrable_mul ((Lp.memLp _).sub (Lp.memLp _))
    have hi2 : Integrable (fun z => A n z * X.indicator (⇑(T B0l)) z) :=
      (aux_ann_integrable_indicator_L2 measurableSet_closedBall hXf
        (Lp.memLp (T B0l))).bdd_mul (hAm n).aestronglyMeasurable (ae_of_all _ (hAb n))
    rw [← integral_add hi1 hi2, hrw (B n) (hBmem n) (A n)]
    refine integral_congr_ae (ae_of_all _ fun z => ?_)
    by_cases hz : z ∈ X
    · simp only [indicator_of_mem hz, Bl]; ring
    · simp [indicator_of_notMem hz]
  simp_rw [e2]
  have hlim0 : ∫ z, X.indicator A0 z * ⇑(T B0l) z = 0 + ∫ z, A0 z * X.indicator (⇑(T B0l)) z := by
    rw [zero_add]
    refine integral_congr_ae (ae_of_all _ fun z => ?_)
    by_cases hz : z ∈ X <;> simp [hz]
  rw [hlim0]
  refine Tendsto.add ?_ (hA _ (aux_ann_integrable_indicator_L2 measurableSet_closedBall hXf
    (Lp.memLp (T B0l))))
  have hTn : Tendsto (fun n => ‖T (Bl n) - T B0l‖) atTop (𝓝 0) :=
    tendsto_iff_norm_sub_tendsto_zero.1 hTconv
  set CX := (eLpNorm (X.indicator fun _ => (1 : ℂ)) 2 volume).toReal
  refine squeeze_zero_norm (fun n => ?_) (by simpa using hTn.const_mul CX)
  have hsub : (⇑(T (Bl n)) - ⇑(T B0l)) =ᵐ[volume] ⇑(T (Bl n) - T B0l) :=
    (Lp.coeFn_sub _ _).symm
  refine (aux_ann_norm_integral_mul_le (hAmem n) ((Lp.memLp _).sub (Lp.memLp _))).trans ?_
  rw [eLpNorm_congr_ae hsub, ← Lp.norm_def]
  exact mul_le_mul_of_nonneg_right (ENNReal.toReal_mono (h1mem (Or.inl rfl)).eLpNorm_lt_top.ne
    (hle1 X _ measurableSet_closedBall (hAm n).aestronglyMeasurable (hAb n))) (norm_nonneg _)

/-- Auxiliary (`ann:factor`): for uniformly bounded sequences on configuration space, weak-*
convergence follows from convergence against bounded tests with bounded spatial support. -/
theorem aux_ann_weakStar_of_local {F : ℕ → ℝ² × Ang → ℂ} {F0 : ℝ² × Ang → ℂ}
    (hFm : ∀ n, Measurable (F n)) (hFb : ∀ n p, ‖F n p‖ ≤ 1) (hF0m : Measurable F0)
    (hF0b : ∀ p, ‖F0 p‖ ≤ 1)
    (hloc : ∀ φ : ℝ² × Ang → ℂ, Measurable φ → (∀ p, ‖φ p‖ ≤ 1) → ∀ ρ : ℝ,
      (∀ p, ρ < ‖p.1‖ → φ p = 0) →
      Tendsto (fun n => ∫ p, F n p * φ p ∂μinc) atTop (𝓝 (∫ p, F0 p * φ p ∂μinc))) :
    annWeakStar μinc F F0 := by
  intro ψ hψ
  set ψ' := hψ.1.mk ψ with hψ'def
  have hψψ' : ψ =ᵐ[μinc] ψ' := hψ.1.ae_eq_mk
  have hψ'm : Measurable ψ' := hψ.1.stronglyMeasurable_mk.measurable
  have hψ'i : Integrable ψ' μinc := hψ.congr hψψ'
  set ψm : ℕ → ℝ² × Ang → ℂ := fun m p =>
    if ‖ψ' p‖ ≤ (m : ℝ) + 1 ∧ ‖p.1‖ ≤ (m : ℝ) + 1 then ψ' p else 0 with hψmdef
  have hS : ∀ m : ℕ, MeasurableSet {p : ℝ² × Ang | ‖ψ' p‖ ≤ (m : ℝ) + 1 ∧
      ‖p.1‖ ≤ (m : ℝ) + 1} := fun m =>
    (measurableSet_le hψ'm.norm measurable_const).inter
      (measurableSet_le measurable_fst.norm measurable_const)
  have hψmm : ∀ m, Measurable (ψm m) := fun m => Measurable.ite (hS m) hψ'm measurable_const
  have hψmb : ∀ m p, ‖ψm m p‖ ≤ ‖ψ' p‖ := fun m p => by
    simp only [hψmdef]; split_ifs <;> simp
  have hψmi : ∀ m, Integrable (ψm m) μinc := fun m =>
    hψ'i.norm.mono' (hψmm m).aestronglyMeasurable (ae_of_all _ (hψmb m))
  have hloc' : ∀ m : ℕ, Tendsto (fun n => ∫ p, F n p * ψm m p ∂μinc) atTop
      (𝓝 (∫ p, F0 p * ψm m p ∂μinc)) := by
    intro m
    set c : ℂ := (((m : ℝ) + 1 : ℝ) : ℂ) with hcdef
    have hc : c ≠ 0 := by rw [hcdef]; exact_mod_cast (by positivity : (m : ℝ) + 1 ≠ 0)
    have hcn : ‖c‖ = (m : ℝ) + 1 := by
      rw [hcdef, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have h := hloc (fun p => ψm m p / c) ((hψmm m).div_const c) (fun p => by
      rw [norm_div, hcn, div_le_one (by positivity)]
      simp only [hψmdef]; split_ifs with h
      · exact h.1
      · simp only [norm_zero]; positivity) ((m : ℝ) + 1) (fun p hp => by
        simp only [hψmdef]
        rw [ite_eq_right (fun h => absurd h.2 (not_le.2 hp)), zero_div])
    have e : ∀ G : ℝ² × Ang → ℂ, ∫ p, G p * ψm m p ∂μinc = c * ∫ p, G p * (ψm m p / c) ∂μinc :=
      fun G => by
        rw [← integral_const_mul]
        congr 1; funext p; field_simp
    simp_rw [e]
    exact h.const_mul c
  have e1 : ∀ n, ∫ p, F n p * ψ p ∂μinc = ∫ p, F n p * ψ' p ∂μinc := fun n =>
    integral_congr_ae (hψψ'.mono fun p hp => by simp only; rw [hp])
  have e0 : ∫ p, F0 p * ψ p ∂μinc = ∫ p, F0 p * ψ' p ∂μinc :=
    integral_congr_ae (hψψ'.mono fun p hp => by simp only; rw [hp])
  rw [e0]
  simp_rw [e1]
  have hbd : ∀ (G : ℝ² × Ang → ℂ), Measurable G → (∀ p, ‖G p‖ ≤ 1) → ∀ m,
      ‖∫ p, G p * ψ' p ∂μinc - ∫ p, G p * ψm m p ∂μinc‖ ≤ ∫ p, ‖ψ' p - ψm m p‖ ∂μinc := by
    intro G hG hG1 m
    rw [← integral_sub (hψ'i.bdd_mul hG.aestronglyMeasurable (ae_of_all _ hG1))
      ((hψmi m).bdd_mul hG.aestronglyMeasurable (ae_of_all _ hG1))]
    refine norm_integral_le_of_norm_le (hψ'i.sub (hψmi m)).norm (ae_of_all _ fun p => ?_)
    rw [← mul_sub, norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (hG1 p)
  refine aux_ann_tendsto_of_approx (am := fun m n => ∫ p, F n p * ψm m p ∂μinc)
    (bm := fun m => ∫ p, F0 p * ψm m p ∂μinc)
    (δ := fun m => ∫ p, ‖ψ' p - ψm m p‖ ∂μinc) ?_ (fun m n => hbd _ (hFm n) (hFb n) m)
    (fun m => hbd _ hF0m hF0b m) hloc'
  have h0 : (0 : ℝ) = ∫ p, (0 : ℝ) ∂μinc := by simp
  rw [h0]
  refine tendsto_integral_of_dominated_convergence (fun p => ‖ψ' p‖)
    (fun m => (hψ'm.sub (hψmm m)).norm.aestronglyMeasurable) hψ'i.norm
    (fun m => ae_of_all _ fun p => ?_) (ae_of_all _ fun p => ?_)
  · rw [norm_norm]
    simp only [hψmdef]; split_ifs <;> simp
  · obtain ⟨m0, hm0⟩ := exists_nat_ge (max ‖ψ' p‖ ‖p.1‖)
    refine tendsto_const_nhds.congr' (eventually_atTop.2 ⟨m0, fun m hm => ?_⟩)
    have h1 : (m0 : ℝ) ≤ m := by exact_mod_cast hm
    simp only [hψmdef]
    rw [ite_eq_left ⟨by linarith [le_max_left ‖ψ' p‖ ‖p.1‖],
      by linarith [le_max_right ‖ψ' p‖ ‖p.1‖]⟩]
    simp

/-- Auxiliary: weak-* limits may be changed on null sets. -/
theorem aux_ann_weakStar_congr {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F : ℕ → X → ℂ} {G G' : X → ℂ} (h : annWeakStar μ F G) (hG : G =ᵐ[μ] G') :
    annWeakStar μ F G' := fun ψ hψ => by
  have e : ∫ x, G x * ψ x ∂μ = ∫ x, G' x * ψ x ∂μ :=
    integral_congr_ae (by filter_upwards [hG] with x hx; rw [hx])
  rw [← e]
  exact h ψ hψ

/-- Auxiliary: the vertex projections push `μ` to Lebesgue measure. -/
theorem aux_ann_proj_mp (α β : ℝ) (j : Fin 3) : MeasurePreserving (proj α β j) μinc volume :=
  aux_ann_add_mp (fun θ => Lv α β j (u θ)) ((Lv α β j).continuous.measurable.comp aux_lw_u_meas)

/-- Auxiliary: a bounded measurable representative of an essentially bounded weak-* limit. -/
theorem aux_ann_bounded_rep {A : ℕ → ℝ² → ℂ} {A0 : ℝ² → ℂ} (hAb : ∀ n x, ‖A n x‖ ≤ 1)
    (hA0 : MemLp A0 ⊤ volume) (hA : annWeakStar volume A A0) :
    ∃ A1 : ℝ² → ℂ, Measurable A1 ∧ (∀ x, ‖A1 x‖ ≤ 1) ∧ A0 =ᵐ[volume] A1 := by
  have hb := aux_ann_weakStar_norm_le hA0 (fun n => ae_of_all _ (hAb n)) hA
  obtain ⟨g, hgs, hAg⟩ : ∃ g : ℝ² → ℂ, StronglyMeasurable g ∧ A0 =ᵐ[volume] g :=
    ⟨_, hA0.aestronglyMeasurable.stronglyMeasurable_mk, hA0.aestronglyMeasurable.ae_eq_mk⟩
  have hg : Measurable g := hgs.measurable
  refine ⟨fun x => if ‖g x‖ ≤ 1 then g x else 0,
    Measurable.ite (measurableSet_le hg.norm measurable_const) hg measurable_const,
    fun x => by
      dsimp only
      split_ifs with h
      · exact h
      · simp, ?_⟩
  filter_upwards [hb, hAg] with x hx hx'
  have h1 : ‖g x‖ ≤ 1 := by rw [← hx']; exact hx
  simp only [ite_eq_left h1]
  exact hx'

/-- Auxiliary (`ann:factor`, see `Auto.ann_factor_two`): the two-vertex products of weak-*
convergent bounded sequences converge weak-* on configuration space. -/
theorem aux_ann_pair_weakStar (α β : ℝ) (hβ : β ≠ 0) {A B : ℕ → ℝ² → ℂ} {A0 B0 : ℝ² → ℂ}
    (hAm : ∀ n, Measurable (A n)) (hBm : ∀ n, Measurable (B n))
    (hAb : ∀ n x, ‖A n x‖ ≤ 1) (hBb : ∀ n x, ‖B n x‖ ≤ 1)
    (hA0 : MemLp A0 ⊤ volume) (hB0 : MemLp B0 ⊤ volume)
    (hA : annWeakStar volume A A0) (hB : annWeakStar volume B B0) :
    annWeakStar μinc (fun n p => A n (proj α β 1 p) * B n (proj α β 2 p))
      (fun p => A0 (proj α β 1 p) * B0 (proj α β 2 p)) := by
  obtain ⟨A1, hA1m, hA1b, hAA1⟩ := aux_ann_bounded_rep hAb hA0 hA
  obtain ⟨B1, hB1m, hB1b, hBB1⟩ := aux_ann_bounded_rep hBb hB0 hB
  have hA' : annWeakStar volume A A1 := aux_ann_weakStar_congr hA hAA1
  have hB' : annWeakStar volume B B1 := aux_ann_weakStar_congr hB hBB1
  have hae : (fun p => A0 (proj α β 1 p) * B0 (proj α β 2 p)) =ᵐ[μinc]
      fun p => A1 (proj α β 1 p) * B1 (proj α β 2 p) := by
    filter_upwards [(aux_ann_proj_mp α β 1).quasiMeasurePreserving.ae_eq_comp hAA1,
      (aux_ann_proj_mp α β 2).quasiMeasurePreserving.ae_eq_comp hBB1] with p h1 h2
    simp only [Function.comp_apply] at h1 h2
    rw [h1, h2]
  have hp := fun j => (aux_ann_proj_continuous α β j).measurable
  refine aux_ann_weakStar_congr (aux_ann_weakStar_of_local
    (F0 := fun p => A1 (proj α β 1 p) * B1 (proj α β 2 p))
    (fun n => ((hAm n).comp (hp 1)).mul ((hBm n).comp (hp 2)))
    (fun n p => ?_) ((hA1m.comp (hp 1)).mul (hB1m.comp (hp 2))) (fun p => ?_)
    (fun φ hφm hφb ρ hφs => aux_ann_pair_tendsto_bounded α β hβ hAm hBm hAb hBb hA1m hB1m hA1b
      hB1b hA' hB' hφm hφb hφs)) hae.symm
  · rw [norm_mul]; exact (mul_le_of_le_one_left (norm_nonneg _) (hAb _ _)).trans (hBb _ _)
  · rw [norm_mul]; exact (mul_le_of_le_one_left (norm_nonneg _) (hA1b _)).trans (hB1b _)

/-- Auxiliary (`ann:factor`): `∫ |G|² d(μ₁ ⊗ μ₂)` expanded in the coefficients of `G`. -/
theorem aux_ann_integral_normSq_tensorPoly (μ₁ μ₂ : Measure ℝ²) [IsFiniteMeasure μ₁]
    [IsFiniteMeasure μ₂] (G : ℝ² × ℝ² →₀ ℂ) :
    ((∫ ξ, ‖tensorPoly G ξ‖ ^ 2 ∂(μ₁.prod μ₂) : ℝ) : ℂ) =
      ∑ P ∈ G.support ×ˢ G.support, G P.1 * conj (G P.2) *
        ((∫ ξ, e ⟪P.1.1 - P.2.1, ξ⟫_ℝ ∂μ₁) * ∫ ξ, e ⟪P.1.2 - P.2.2, ξ⟫_ℝ ∂μ₂) := by
  rw [← integral_complex_ofReal]
  have e1 : ∀ ξ : ℝ² × ℝ², tensorPoly G ξ =
      ∑ st ∈ G.support, G st * (charE st.1 ξ.1 * charE st.2 ξ.2) := fun ξ => by
    rw [tensorPoly, Finsupp.sum]
    exact Finset.sum_congr rfl fun st _ => by ring
  simp_rw [e1, aux_ann_normSq_sum]
  have e2 : ∀ (P : (ℝ² × ℝ²) × (ℝ² × ℝ²)) (ξ : ℝ² × ℝ²),
      charE P.1.1 ξ.1 * charE P.1.2 ξ.2 * conj (charE P.2.1 ξ.1 * charE P.2.2 ξ.2) =
        e ⟪P.1.1 - P.2.1, ξ.1⟫_ℝ * e ⟪P.1.2 - P.2.2, ξ.2⟫_ℝ := fun P ξ => by
    rw [← aux_ann_charE_mul_conj, ← aux_ann_charE_mul_conj, map_mul]; ring
  simp_rw [e2]
  rw [integral_finsetSum _ fun P _ => ?_]
  · refine Finset.sum_congr rfl fun P _ => ?_
    rw [integral_const_mul, integral_prod_mul (fun ξ => e ⟪P.1.1 - P.2.1, ξ⟫_ℝ)
      (fun ξ => e ⟪P.1.2 - P.2.2, ξ⟫_ℝ)]
  · refine Integrable.of_bound (by
      have := aux_ann_continuous_e
      fun_prop : Continuous fun ξ : ℝ² × ℝ² => G P.1 * conj (G P.2) *
        (e ⟪P.1.1 - P.2.1, ξ.1⟫_ℝ * e ⟪P.1.2 - P.2.2, ξ.2⟫_ℝ)).aestronglyMeasurable
      (‖G P.1 * conj (G P.2)‖) (ae_of_all _ fun ξ => ?_)
    rw [norm_mul, norm_mul (e _), aux_ann_norm_e, aux_ann_norm_e, mul_one, mul_one]

end AnnFactorAux

/-- **Lemma `ann:factor`** (first assertion).  For the notation of Definition `ann:polynomials`,
$$|F_{0,n}[a](\pi_0p)|^2\stackrel{*}{\rightharpoonup}\int|a|^2\,d\nu_0,\qquad
|G_n(p)|^2\stackrel{*}{\rightharpoonup}\int|G|^2\,d(\nu_1\otimes\nu_2).$$
(In Lean the blueprint hypotheses `(hβ : β ≠ 0)`, `(hQ : Bornology.IsBounded Q)` are omitted since
the proof does not need them; see `automation/ErrorReport.md`.) -/
theorem ann_factor_one (α β : ℝ) (Q : Set ℝ²)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (a : ℝ² →₀ ℂ) :
    annWeakStar μinc (fun n p => ((‖polyTranslate R f 0 n a (proj α β 0 p)‖ ^ 2 : ℝ) : ℂ))
      (fun p => ((∫ ξ, ‖trigPoly a ξ‖ ^ 2 ∂(ν 0 (proj α β 0 p)) : ℝ) : ℂ)) := by
  obtain ⟨h1, h2⟩ := aux_ann_factor_vertex hadm hlim hν 0 a
  have hm : ∀ n, Measurable fun z => ((‖polyTranslate R f 0 n a z‖ ^ 2 : ℝ) : ℂ) := fun n => by
    have hc := fun j => aux_ann_continuous hadm j n
    simp only [polyTranslate, Finsupp.sum, annT]
    exact (by fun_prop : Continuous _).measurable
  simp_rw [aux_ann_proj_zero]
  refine aux_ann_weakStar_pullback_fst (B := (∑ s ∈ a.support, ‖a s‖) ^ 2)
    (fun n => (hm n).aestronglyMeasurable) (fun n z => ?_) h2 h1
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  gcongr
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun s _ => ?_)
  rw [norm_mul]
  exact mul_le_of_le_one_right (norm_nonneg _) (aux_ann_annT_le_one hadm _ _ _ _)

/-- **Lemma `ann:factor`** (second assertion).  For the notation of Definition
`ann:polynomials`,
$$|F_{0,n}[a](\pi_0p)|^2\stackrel{*}{\rightharpoonup}\int|a|^2\,d\nu_0,\qquad
|G_n(p)|^2\stackrel{*}{\rightharpoonup}\int|G|^2\,d(\nu_1\otimes\nu_2).$$
(In Lean the blueprint hypothesis `(hQ : Bornology.IsBounded Q)` is omitted since the proof does not
need it; see `automation/ErrorReport.md`.) -/
theorem ann_factor_two (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (G : ℝ² × ℝ² →₀ ℂ) :
    annWeakStar μinc (fun n p => ((‖tensorTranslate α β R f n G p‖ ^ 2 : ℝ) : ℂ))
      (fun p => ((∫ ξ, ‖tensorPoly G ξ‖ ^ 2 ∂((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p)))
        : ℝ) : ℂ)) := by
  have hfin : ∀ j z, IsFiniteMeasure (ν j z) := fun j => (hν.1 j).1
  set S := G.support ×ˢ G.support with hS
  set A : (ℝ² × ℝ²) × (ℝ² × ℝ²) → ℕ → ℝ² → ℂ := fun P n z =>
    annT R f 1 n P.1.1 z * conj (annT R f 1 n P.2.1 z) with hA
  set B : (ℝ² × ℝ²) × (ℝ² × ℝ²) → ℕ → ℝ² → ℂ := fun P n z =>
    annT R f 2 n P.1.2 z * conj (annT R f 2 n P.2.2 z) with hB
  have hpair : ∀ P, annWeakStar μinc (fun n p => A P n (proj α β 1 p) * B P n (proj α β 2 p))
      (fun p => k 1 (proj α β 1 p) P.1.1 P.2.1 * k 2 (proj α β 2 p) P.1.2 P.2.2) := fun P =>
    aux_ann_pair_weakStar α β hβ (fun n => aux_ann_two_point_meas hadm 1 n _ _)
      (fun n => aux_ann_two_point_meas hadm 2 n _ _)
      (fun n z => aux_ann_two_point_le hadm 1 n _ _ z)
      (fun n z => aux_ann_two_point_le hadm 2 n _ _ z) (aux_ann_k_memLp hlim 1 _ _)
      (aux_ann_k_memLp hlim 2 _ _) (hlim.two_point 1 _ _) (hlim.two_point 2 _ _)
  have hp := fun j => (aux_ann_proj_continuous α β j).measurable
  have hsum := aux_ann_weakStar_sum (μ := μinc) S (fun P => G P.1 * conj (G P.2))
    (F := fun P n p => A P n (proj α β 1 p) * B P n (proj α β 2 p))
    (G := fun P p => k 1 (proj α β 1 p) P.1.1 P.2.1 * k 2 (proj α β 2 p) P.1.2 P.2.2)
    (fun P n => (((aux_ann_two_point_meas hadm 1 n _ _).comp (hp 1)).mul
      ((aux_ann_two_point_meas hadm 2 n _ _).comp (hp 2))).aestronglyMeasurable)
    (fun P n p => by
      rw [norm_mul]
      exact (mul_le_of_le_one_left (norm_nonneg _) (aux_ann_two_point_le hadm 1 n _ _ _)).trans
          (aux_ann_two_point_le hadm 2 n _ _ _))
    (fun P => memLp_top_of_bound
      ((((hlim.meas_two 1 _ _).comp_measurePreserving (aux_ann_proj_mp α β 1))).mul
        ((hlim.meas_two 2 _ _).comp_measurePreserving (aux_ann_proj_mp α β 2))) 1
      (ae_of_all _ fun p => by
        simp only [norm_mul]
        exact (mul_le_of_le_one_left (norm_nonneg _) (hlim.bound_two 1 _ _ _)).trans
            (hlim.bound_two 2 _ _ _)))
    hpair
  have hseq : ∀ n p, ((‖tensorTranslate α β R f n G p‖ ^ 2 : ℝ) : ℂ) =
      ∑ P ∈ S, G P.1 * conj (G P.2) * (A P n (proj α β 1 p) * B P n (proj α β 2 p)) := by
    intro n p
    have e1 : tensorTranslate α β R f n G p = ∑ st ∈ G.support, G st *
        (annT R f 1 n st.1 (proj α β 1 p) * annT R f 2 n st.2 (proj α β 2 p)) := by
      rw [tensorTranslate, Finsupp.sum]
      exact Finset.sum_congr rfl fun st _ => by ring
    rw [e1, aux_ann_normSq_sum]
    refine Finset.sum_congr rfl fun P _ => ?_
    simp only [hA, hB, map_mul]
    ring
  have hae : (fun p => ∑ P ∈ S, G P.1 * conj (G P.2) *
      (k 1 (proj α β 1 p) P.1.1 P.2.1 * k 2 (proj α β 2 p) P.1.2 P.2.2)) =ᵐ[μinc]
      fun p => ((∫ ξ, ‖tensorPoly G ξ‖ ^ 2 ∂((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p)))
        : ℝ) : ℂ) := by
    filter_upwards [(aux_ann_proj_mp α β 1).quasiMeasurePreserving.ae hν.2.2,
      (aux_ann_proj_mp α β 2).quasiMeasurePreserving.ae hν.2.2] with p h1 h2
    rw [aux_ann_integral_normSq_tensorPoly]
    refine Finset.sum_congr rfl fun P _ => ?_
    rw [h1 1, h2 2]
  simp_rw [hseq]
  exact aux_ann_weakStar_congr hsum hae

/-! ### The limiting bilinear correlation form (`ann:form`) -/

/-- Auxiliary: `ℓ` is a complex bilinear form on $L^2(\mu_0)\times L^2(\mu_{12})$ satisfying
the Cauchy–Schwarz bound `(ann:cs)` $|\ell(a,G)|\le\|a\|_{L^2(\mu_0)}\|G\|_{L^2(\mu_{12})}$
(used in `\label{ann:form}`, see `Auto.ann_form`).  The bound and bilinearity make `ℓ` depend
only on the almost-everywhere classes of square-integrable arguments. -/
@[nolint defsWithUnderscore]
def aux_IsBoundedBilinear (μ₀ : Measure ℝ²) (μ₁₂ : Measure (ℝ² × ℝ²))
    (ℓ : (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ) : Prop :=
  (∀ a a' G, MemLp a 2 μ₀ → MemLp a' 2 μ₀ → MemLp G 2 μ₁₂ → ℓ (a + a') G = ℓ a G + ℓ a' G) ∧
  (∀ (c : ℂ) a G, MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → ℓ (c • a) G = c * ℓ a G) ∧
  (∀ a G G', MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → MemLp G' 2 μ₁₂ → ℓ a (G + G') = ℓ a G + ℓ a G') ∧
  (∀ (c : ℂ) a G, MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → ℓ a (c • G) = c * ℓ a G) ∧
  (∀ a G, MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → ‖ℓ a G‖ₑ ≤ eLpNorm a 2 μ₀ * eLpNorm G 2 μ₁₂)

/-- Auxiliary: the conclusion of `\label{ann:form}` (see `Auto.ann_form`) for a family of forms
`ℓ p`: for a.e. configuration `p` it is a bounded bilinear form on
$L^2(\nu_0)\times L^2(\nu_1\otimes\nu_2)$ (with $\nu_j=\nu_{j,\pi_jp}$); on polynomial
arguments it is the weak-* limit of $F_{0,n}[a](\pi_0p)G_n(p)$; on characters it equals the
three-point limit `h3`. -/
@[nolint defsWithUnderscore]
def aux_IsLimitForm (α β : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ)
    (ν : Fin 3 → ℝ² → Measure ℝ²) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ) : Prop :=
  (∀ᵐ p ∂μinc, aux_IsBoundedBilinear (ν 0 (proj α β 0 p))
      ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) (ℓ p)) ∧
  (∀ (a : ℝ² →₀ ℂ) (G : ℝ² × ℝ² →₀ ℂ), annWeakStar μinc
      (fun n p => polyTranslate R f 0 n a (proj α β 0 p) * tensorTranslate α β R f n G p)
      (fun p => ℓ p (trigPoly a) (tensorPoly G))) ∧
  ∀ᵐ p ∂μinc, ∀ s : Fin 3 → ℝ²,
    ℓ p (charE (s 0)) (fun ξ => charE (s 1) ξ.1 * charE (s 2) ξ.2) = h3 p s

/-! ### Auxiliary material for `ann:form` -/

section BilinExt

variable {E1 E2 H1 H2 : Type*} [AddCommGroup E1] [Module ℂ E1] [AddCommGroup E2] [Module ℂ E2]
  [NormedAddCommGroup H1] [InnerProductSpace ℂ H1] [CompleteSpace H1]
  [NormedAddCommGroup H2] [InnerProductSpace ℂ H2] [CompleteSpace H2]

omit [CompleteSpace H1] in
/-- Auxiliary: corestriction of a linear map to the closure of its range has dense range. -/
theorem aux_ann_denseRange_codRestrict (e : E1 →ₗ[ℂ] H1) :
    DenseRange (e.codRestrict (LinearMap.range e).topologicalClosure
      (fun x => (LinearMap.range e).le_topologicalClosure (LinearMap.mem_range_self e x))) := by
  set K := (LinearMap.range e).topologicalClosure
  intro k
  rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image, mem_preimage]
  have hk : (k : H1) ∈ closure (LinearMap.range e : Set H1) := by
    rw [← Submodule.topologicalClosure_coe]; exact k.2
  convert hk using 2
  ext y
  simp only [LinearMap.codRestrict, LinearMap.coe_mk, AddHom.coe_mk, SetLike.mem_coe,
    LinearMap.mem_range]
  constructor
  · rintro ⟨_, ⟨c, rfl⟩, rfl⟩; exact ⟨c, rfl⟩
  · rintro ⟨c, rfl⟩; exact ⟨_, ⟨c, rfl⟩, rfl⟩

/-- Auxiliary (`ann:form`, see `Auto.ann_form`): a bilinear form defined on spanning data and
bounded by the norms of the images extends to a bounded bilinear form on the Hilbert spaces with
the same bound. -/
theorem aux_ann_bilinear_extend (e1 : E1 →ₗ[ℂ] H1) (e2 : E2 →ₗ[ℂ] H2)
    (Λ : E1 →ₗ[ℂ] E2 →ₗ[ℂ] ℂ) (hΛ : ∀ x y, ‖Λ x y‖ ≤ ‖e1 x‖ * ‖e2 y‖) :
    ∃ B : H1 →L[ℂ] H2 →L[ℂ] ℂ, (∀ x y, B (e1 x) (e2 y) = Λ x y) ∧
      ∀ u v, ‖B u v‖ ≤ ‖u‖ * ‖v‖ := by
  set K1 := (LinearMap.range e1).topologicalClosure with hK1
  set K2 := (LinearMap.range e2).topologicalClosure with hK2
  have : CompleteSpace K1 := (Submodule.isClosed_topologicalClosure _).completeSpace_coe
  have : CompleteSpace K2 := (Submodule.isClosed_topologicalClosure _).completeSpace_coe
  set e1' : E1 →ₗ[ℂ] K1 := e1.codRestrict K1
    (fun x => (LinearMap.range e1).le_topologicalClosure (LinearMap.mem_range_self e1 x))
  set e2' : E2 →ₗ[ℂ] K2 := e2.codRestrict K2
    (fun x => (LinearMap.range e2).le_topologicalClosure (LinearMap.mem_range_self e2 x))
  have hd1 : DenseRange e1' := aux_ann_denseRange_codRestrict e1
  have hd2 : DenseRange e2' := aux_ann_denseRange_codRestrict e2
  have hn1 : ∀ x, ‖e1' x‖ = ‖e1 x‖ := fun x => rfl
  have hn2 : ∀ y, ‖e2' y‖ = ‖e2 y‖ := fun y => rfl
  have hb : ∀ y x, ‖Λ.flip y x‖ ≤ ‖e2 y‖ * ‖e1' x‖ := fun y x => by
    rw [LinearMap.flip_apply, hn1, mul_comm]; exact hΛ x y
  set Ψf : E2 → K1 →L[ℂ] ℂ := fun y => (Λ.flip y).extendOfNorm e1' with hΨf
  have hΨe : ∀ y x, Ψf y (e1' x) = Λ x y := fun y x => by
    rw [hΨf, LinearMap.extendOfNorm_eq hd1 ⟨_, hb y⟩]; rfl
  have hΨadd : ∀ y y', Ψf (y + y') = Ψf y + Ψf y' := fun y y' => by
    refine LinearMap.extendOfNorm_unique hd1 _ (hb (y + y')) _ ?_
    ext x
    simp [hΨe]
  have hΨsmul : ∀ (c : ℂ) y, Ψf (c • y) = c • Ψf y := fun c y => by
    refine LinearMap.extendOfNorm_unique hd1 _ (hb (c • y)) _ ?_
    ext x
    simp [hΨe]
  set Ψ : E2 →ₗ[ℂ] K1 →L[ℂ] ℂ := ⟨⟨Ψf, hΨadd⟩, hΨsmul⟩ with hΨ
  have hΨn : ∀ y, ‖Ψ y‖ ≤ 1 * ‖e2' y‖ := fun y => by
    rw [one_mul, hn2]
    exact LinearMap.opNorm_extendOfNorm_le hd1 (norm_nonneg _) (hb y)
  set Ψx : K2 →L[ℂ] K1 →L[ℂ] ℂ := LinearMap.extendOfNorm (𝕜 := ℂ) (𝕜₂ := ℂ)
    (σ₁₂ := RingHom.id ℂ) (F := K1 →L[ℂ] ℂ) Ψ e2' with hΨx
  have hΨxe : ∀ y, Ψx (e2' y) = Ψ y := fun y => LinearMap.extendOfNorm_eq hd2 ⟨1, hΨn⟩ y
  have hΨxn : ∀ v, ‖Ψx v‖ ≤ 1 * ‖v‖ := LinearMap.norm_extendOfNorm_apply_le hd2 1 hΨn
  set P1 := K1.orthogonalProjectionOnto
  set P2 := K2.orthogonalProjectionOnto
  set B : H1 →L[ℂ] H2 →L[ℂ] ℂ :=
    (((ContinuousLinearMap.compL ℂ H1 K1 ℂ).flip P1).comp (Ψx.comp P2)).flip with hB
  have hBapp : ∀ u v, B u v = Ψx (P2 v) (P1 u) := fun u v => rfl
  refine ⟨B, fun x y => ?_, fun u v => ?_⟩
  · rw [hBapp]
    have h2 : P2 (e2 y) = e2' y := Submodule.orthogonalProjectionOnto_mem_subspace_eq_self (e2' y)
    have h1 : P1 (e1 x) = e1' x := Submodule.orthogonalProjectionOnto_mem_subspace_eq_self (e1' x)
    rw [h2, h1, hΨxe]
    exact hΨe y x
  · rw [hBapp]
    calc ‖Ψx (P2 v) (P1 u)‖ ≤ ‖Ψx (P2 v)‖ * ‖P1 u‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ (1 * ‖P2 v‖) * ‖P1 u‖ := by gcongr; exact hΨxn _
      _ ≤ ‖v‖ * ‖u‖ := by
          rw [one_mul]
          gcongr
          · exact Submodule.norm_orthogonalProjectionOnto_apply_le _ _
          · exact Submodule.norm_orthogonalProjectionOnto_apply_le _ _
      _ = ‖u‖ * ‖v‖ := mul_comm _ _

end BilinExt

section WeakStarAlg

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

/-- Auxiliary: weak-* limits of sums of bounded sequences. -/
theorem aux_ann_weakStar_add {F F' : ℕ → X → ℂ} {G G' : X → ℂ}
    (hF : ∀ n, AEStronglyMeasurable (F n) μ) (hFb : ∃ C, ∀ n x, ‖F n x‖ ≤ C)
    (hF' : ∀ n, AEStronglyMeasurable (F' n) μ) (hFb' : ∃ C, ∀ n x, ‖F' n x‖ ≤ C)
    (hG : MemLp G ⊤ μ) (hG' : MemLp G' ⊤ μ)
    (h : annWeakStar μ F G) (h' : annWeakStar μ F' G') :
    annWeakStar μ (fun n x => F n x + F' n x) (fun x => G x + G' x) := by
  intro ψ hψ
  obtain ⟨C, hC⟩ := hFb
  obtain ⟨C', hC'⟩ := hFb'
  have e1 : ∀ n, ∫ x, (F n x + F' n x) * ψ x ∂μ =
      ∫ x, F n x * ψ x ∂μ + ∫ x, F' n x * ψ x ∂μ := fun n => by
    simp_rw [add_mul]
    exact integral_add (hψ.bdd_mul (hF n) (ae_of_all _ (hC n)))
      (hψ.bdd_mul (hF' n) (ae_of_all _ (hC' n)))
  have e2 : ∫ x, (G x + G' x) * ψ x ∂μ = ∫ x, G x * ψ x ∂μ + ∫ x, G' x * ψ x ∂μ := by
    simp_rw [add_mul]
    exact integral_add (hG.integrable_mul (memLp_one_iff_integrable.2 hψ))
      (hG'.integrable_mul (memLp_one_iff_integrable.2 hψ))
  simp_rw [e1, e2]
  exact (h ψ hψ).add (h' ψ hψ)

/-- Auxiliary: weak-* limits of scalar multiples. -/
theorem aux_ann_weakStar_const_mul {F : ℕ → X → ℂ} {G : X → ℂ} (c : ℂ)
    (h : annWeakStar μ F G) : annWeakStar μ (fun n x => c * F n x) (fun x => c * G x) := by
  intro ψ hψ
  simp_rw [mul_assoc, integral_const_mul]
  exact (h ψ hψ).const_mul c

/-- Auxiliary: weak-* limits of complex conjugates. -/
theorem aux_ann_weakStar_conj {F : ℕ → X → ℂ} {G : X → ℂ} (h : annWeakStar μ F G) :
    annWeakStar μ (fun n x => conj (F n x)) (fun x => conj (G x)) := by
  intro ψ hψ
  have hψ' : Integrable (fun x => conj (ψ x)) μ :=
    hψ.congr' (Complex.continuous_conj.comp_aestronglyMeasurable hψ.1)
      (ae_of_all _ fun x => by simp)
  have e : ∀ H : X → ℂ, ∫ x, conj (H x) * ψ x ∂μ = conj (∫ x, H x * conj (ψ x) ∂μ) := fun H => by
    rw [← integral_conj]
    congr 1; funext x
    simp
  simp_rw [e]
  exact (Complex.continuous_conj.tendsto _).comp (h _ hψ')

end WeakStarAlg

/-- Auxiliary (`ann:form`): `∫ |∑ c_i e_{s_i}|² dν` expanded. -/
theorem aux_ann_integral_normSq_sum (ν : Measure ℝ²) [IsFiniteMeasure ν] {ι : Type*}
    (S : Finset ι) (c : ι → ℂ) (s : ι → ℝ²) :
    ((∫ ξ, ‖∑ i ∈ S, c i * charE (s i) ξ‖ ^ 2 ∂ν : ℝ) : ℂ) =
      ∑ P ∈ S ×ˢ S, c P.1 * conj (c P.2) * ∫ ξ, e ⟪s P.1 - s P.2, ξ⟫_ℝ ∂ν := by
  rw [← integral_complex_ofReal]
  simp_rw [aux_ann_normSq_sum, aux_ann_charE_mul_conj]
  rw [integral_finsetSum _ fun P _ => aux_ann_integrable_e ν _ _]
  exact Finset.sum_congr rfl fun P _ => integral_const_mul _ _

/-- Auxiliary (`ann:form`): `∫ |∑ d_i e_{s_i} ⊗ e_{t_i}|² d(μ₁ ⊗ μ₂)` expanded. -/
theorem aux_ann_integral_normSq_sum2 (μ₁ μ₂ : Measure ℝ²) [IsFiniteMeasure μ₁]
    [IsFiniteMeasure μ₂] {ι : Type*} (S : Finset ι) (d : ι → ℂ) (s t : ι → ℝ²) :
    ((∫ ξ, ‖∑ i ∈ S, d i * charE (s i) ξ.1 * charE (t i) ξ.2‖ ^ 2 ∂(μ₁.prod μ₂) : ℝ) : ℂ) =
      ∑ P ∈ S ×ˢ S, d P.1 * conj (d P.2) *
        ((∫ ξ, e ⟪s P.1 - s P.2, ξ⟫_ℝ ∂μ₁) * ∫ ξ, e ⟪t P.1 - t P.2, ξ⟫_ℝ ∂μ₂) := by
  rw [← integral_complex_ofReal]
  have e1 : ∀ ξ : ℝ² × ℝ², ∑ i ∈ S, d i * charE (s i) ξ.1 * charE (t i) ξ.2 =
      ∑ i ∈ S, d i * (charE (s i) ξ.1 * charE (t i) ξ.2) := fun ξ =>
    Finset.sum_congr rfl fun i _ => by ring
  simp_rw [e1, aux_ann_normSq_sum]
  have e2 : ∀ (P : ι × ι) (ξ : ℝ² × ℝ²),
      charE (s P.1) ξ.1 * charE (t P.1) ξ.2 * conj (charE (s P.2) ξ.1 * charE (t P.2) ξ.2) =
        e ⟪s P.1 - s P.2, ξ.1⟫_ℝ * e ⟪t P.1 - t P.2, ξ.2⟫_ℝ := fun P ξ => by
    rw [← aux_ann_charE_mul_conj, ← aux_ann_charE_mul_conj, map_mul]; ring
  simp_rw [e2]
  rw [integral_finsetSum _ fun P _ => ?_]
  · refine Finset.sum_congr rfl fun P _ => ?_
    rw [integral_const_mul, integral_prod_mul (fun ξ => e ⟪s P.1 - s P.2, ξ⟫_ℝ)
      (fun ξ => e ⟪t P.1 - t P.2, ξ⟫_ℝ)]
  · refine Integrable.of_bound (by
      have := aux_ann_continuous_e
      fun_prop : Continuous fun ξ : ℝ² × ℝ² => d P.1 * conj (d P.2) *
        (e ⟪s P.1 - s P.2, ξ.1⟫_ℝ * e ⟪t P.1 - t P.2, ξ.2⟫_ℝ)).aestronglyMeasurable
      (‖d P.1 * conj (d P.2)‖) (ae_of_all _ fun ξ => ?_)
    rw [norm_mul, norm_mul (e _), aux_ann_norm_e, aux_ann_norm_e, mul_one, mul_one]

/-- Auxiliary (`ann:form`): the polynomial form
$\Lambda_p(a,G)=\sum_{s,t}a_sG_t\,h(p;s,t_1,t_2)$ on coefficient families. -/
@[nolint defsWithUnderscore]
def aux_ann_Λ (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ) (p : ℝ² × Ang) (a : ℝ² →₀ ℂ)
    (G : ℝ² × ℝ² →₀ ℂ) : ℂ :=
  a.sum fun s c => G.sum fun t d => c * d * h3 p ![s, t.1, t.2]

section FormLimit

variable {α β : ℝ} {Q : Set ℝ²} {C L : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
  {k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ} {h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ}

/-- Auxiliary: the three-point limits are essentially bounded. -/
theorem aux_ann_h3_memLp (hlim : aux_IsCorrelationLimits α β L R f k h3) (s : Fin 3 → ℝ²) :
    MemLp (fun p => h3 p s) ⊤ μinc :=
  memLp_top_of_bound (hlim.meas_three s) 1 (ae_of_all _ fun p => hlim.bound_three p s)

/-- Auxiliary (`ann:form`, see `Auto.ann_form`): $F_{0,n}[a](\pi_0p)G_n(p)$ converges weak-* to
the polynomial form `aux_ann_Λ`. -/
theorem aux_ann_form_limit (hadm : IsAdmissibleSeq Q C R f)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (a : ℝ² →₀ ℂ) (G : ℝ² × ℝ² →₀ ℂ) :
    annWeakStar μinc
      (fun n p => polyTranslate R f 0 n a (proj α β 0 p) * tensorTranslate α β R f n G p)
      (fun p => aux_ann_Λ h3 p a G) := by
  set S := a.support ×ˢ G.support
  set sh : ℝ² × (ℝ² × ℝ²) → Fin 3 → ℝ² := fun P => ![P.1, P.2.1, P.2.2] with hsh
  have hT : ∀ j n, Continuous fun q : ℝ² × ℝ² => annT R f j n q.1 q.2 := fun j n => by
    have hc := aux_ann_continuous hadm j n
    unfold annT
    fun_prop
  have hsum := aux_ann_weakStar_sum (μ := μinc) S (fun P => a P.1 * G P.2)
    (F := fun P n p => ∏ j, annT R f j n (sh P j) (proj α β j p))
    (G := fun P p => h3 p (sh P))
    (fun P n => (continuous_finsetProd _ fun j _ => (hT j n).comp (continuous_const.prodMk
      (aux_ann_proj_continuous α β j))).measurable.aestronglyMeasurable)
    (fun P n p => by
      rw [norm_prod]
      exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun j _ =>
        aux_ann_annT_le_one hadm _ _ _ _)
    (fun P => aux_ann_h3_memLp hlim _) (fun P => hlim.three_point _)
  have e1 : ∀ n p, polyTranslate R f 0 n a (proj α β 0 p) * tensorTranslate α β R f n G p =
      ∑ P ∈ S, a P.1 * G P.2 * ∏ j, annT R f j n (sh P j) (proj α β j p) := by
    intro n p
    rw [polyTranslate, tensorTranslate, Finsupp.sum, Finsupp.sum, Finset.sum_mul_sum,
      Finset.sum_product]
    refine Finset.sum_congr rfl fun s _ => Finset.sum_congr rfl fun t _ => ?_
    simp only [hsh, Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    ring
  have e2 : ∀ p, aux_ann_Λ h3 p a G = ∑ P ∈ S, a P.1 * G P.2 * h3 p (sh P) := by
    intro p
    rw [aux_ann_Λ, Finsupp.sum, Finset.sum_product]
    rfl
  simp_rw [e1, e2]
  exact hsum

end FormLimit

/-- Auxiliary (`ann:form`): the trigonometric polynomial $\sum_{i<N}c_ie_{D_i}$ as a coefficient
family. -/
@[nolint defsWithUnderscore]
def aux_ann_aOf (D : ℕ → ℝ²) (N : ℕ) (c : Fin N → ℂ) : ℝ² →₀ ℂ :=
  ∑ i : Fin N, Finsupp.single (D i) (c i)

/-- Auxiliary (`ann:form`): the tensor sum $\sum_{k,l<N}d_{kl}e_{D_k}\otimes e_{D_l}$ as a
coefficient family. -/
@[nolint defsWithUnderscore]
def aux_ann_GOf (D : ℕ → ℝ²) (N : ℕ) (d : Fin N × Fin N → ℂ) : ℝ² × ℝ² →₀ ℂ :=
  ∑ kl : Fin N × Fin N, Finsupp.single (D kl.1, D kl.2) (d kl)

theorem aux_ann_sum_aOf {M : Type*} [AddCommMonoid M] (D : ℕ → ℝ²) (N : ℕ) (c : Fin N → ℂ)
    (g : ℝ² → ℂ → M) (h0 : ∀ s, g s 0 = 0) (hadd : ∀ s b b', g s (b + b') = g s b + g s b') :
    (aux_ann_aOf D N c).sum g = ∑ i : Fin N, g (D i) (c i) := by
  rw [aux_ann_aOf, ← Finsupp.sum_finsetSum_index h0 hadd]
  exact Finset.sum_congr rfl fun i _ => Finsupp.sum_single_index (h0 _)

theorem aux_ann_sum_GOf {M : Type*} [AddCommMonoid M] (D : ℕ → ℝ²) (N : ℕ)
    (d : Fin N × Fin N → ℂ) (g : ℝ² × ℝ² → ℂ → M) (h0 : ∀ s, g s 0 = 0)
    (hadd : ∀ s b b', g s (b + b') = g s b + g s b') :
    (aux_ann_GOf D N d).sum g = ∑ kl : Fin N × Fin N, g (D kl.1, D kl.2) (d kl) := by
  rw [aux_ann_GOf, ← Finsupp.sum_finsetSum_index h0 hadd]
  exact Finset.sum_congr rfl fun i _ => Finsupp.sum_single_index (h0 _)

theorem aux_ann_trigPoly_aOf (D : ℕ → ℝ²) (N : ℕ) (c : Fin N → ℂ) (ξ : ℝ²) :
    trigPoly (aux_ann_aOf D N c) ξ = ∑ i : Fin N, c i * charE (D i) ξ :=
  aux_ann_sum_aOf D N c _ (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _)

theorem aux_ann_polyTranslate_aOf (D : ℕ → ℝ²) (N : ℕ) (c : Fin N → ℂ) (R : ℕ → ℝ)
    (f : Fin 3 → ℕ → ℝ² → ℂ) (j : Fin 3) (n : ℕ) (z : ℝ²) :
    polyTranslate R f j n (aux_ann_aOf D N c) z = ∑ i : Fin N, c i * annT R f j n (D i) z :=
  aux_ann_sum_aOf D N c _ (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _)

theorem aux_ann_tensorPoly_GOf (D : ℕ → ℝ²) (N : ℕ) (d : Fin N × Fin N → ℂ)
    (ξ : ℝ² × ℝ²) :
    tensorPoly (aux_ann_GOf D N d) ξ =
      ∑ kl : Fin N × Fin N, d kl * charE (D kl.1) ξ.1 * charE (D kl.2) ξ.2 :=
  aux_ann_sum_GOf D N d _ (fun s => by simp) (fun s b b' => by ring)

theorem aux_ann_tensorTranslate_GOf (D : ℕ → ℝ²) (N : ℕ) (d : Fin N × Fin N → ℂ) (α β : ℝ)
    (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (n : ℕ) (p : ℝ² × Ang) :
    tensorTranslate α β R f n (aux_ann_GOf D N d) p = ∑ kl : Fin N × Fin N, d kl *
      annT R f 1 n (D kl.1) (proj α β 1 p) * annT R f 2 n (D kl.2) (proj α β 2 p) :=
  aux_ann_sum_GOf D N d _ (fun s => by simp) (fun s b b' => by ring)

theorem aux_ann_Λ_of (D : ℕ → ℝ²) (N : ℕ) (c : Fin N → ℂ) (d : Fin N × Fin N → ℂ)
    (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ) (p : ℝ² × Ang) :
    aux_ann_Λ h3 p (aux_ann_aOf D N c) (aux_ann_GOf D N d) =
      ∑ i : Fin N, ∑ kl : Fin N × Fin N, c i * d kl * h3 p ![D i, D kl.1, D kl.2] := by
  rw [aux_ann_Λ, aux_ann_sum_aOf D N c _ (fun s => by simp [Finsupp.sum])
    (fun s b b' => by simp only [Finsupp.sum, ← Finset.sum_add_distrib]; congr 1; funext t; ring)]
  refine Finset.sum_congr rfl fun i _ => ?_
  exact aux_ann_sum_GOf D N d _ (fun s => by simp) (fun s b b' => by ring)

/-- Auxiliary (`ann:form`): the quadratic-form argument of `ann:form`: nonnegativity of
$|q|^2A+B-2\operatorname{Re}(ql)$ for all `q` forces $|l|^2\le AB$. -/
theorem aux_ann_quad (A B : ℝ) (l : ℂ) (hA : 0 ≤ A)
    (h : ∀ q : ℂ, 0 ≤ ‖q‖ ^ 2 * A + B - 2 * (q * l).re) : ‖l‖ ^ 2 ≤ A * B := by
  rcases hA.lt_or_eq with hA | hA
  · have h1 := h (conj l / (A : ℂ))
    have e1 : ‖conj l / (A : ℂ)‖ ^ 2 = ‖l‖ ^ 2 / A ^ 2 := by
      rw [norm_div, Complex.norm_conj, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hA,
        div_pow]
    have e2 : (conj l / (A : ℂ) * l).re = ‖l‖ ^ 2 / A := by
      rw [div_mul_eq_mul_div, mul_comm, Complex.mul_conj, ← Complex.ofReal_div,
        Complex.ofReal_re, Complex.normSq_eq_norm_sq]
    rw [e1, e2] at h1
    have : ‖l‖ ^ 2 / A ^ 2 * A = ‖l‖ ^ 2 / A := by field_simp
    rw [this] at h1
    have h2 : ‖l‖ ^ 2 / A ≤ B := by linarith
    rwa [div_le_iff₀ hA, mul_comm] at h2
  · subst hA
    rw [zero_mul]
    by_contra hcon
    push Not at hcon
    have h1 := h (((B + 1) / (2 * ‖l‖ ^ 2) : ℝ) * conj l)
    have e2 : ((((B + 1) / (2 * ‖l‖ ^ 2) : ℝ) : ℂ) * conj l * l).re = (B + 1) / 2 := by
      rw [mul_assoc, mul_comm (conj l), Complex.mul_conj, ← Complex.ofReal_mul,
        Complex.ofReal_re, Complex.normSq_eq_norm_sq]
      have : ‖l‖ ≠ 0 := by
        intro h0; rw [h0] at hcon; norm_num at hcon
      field_simp
    rw [e2] at h1
    linarith

/-- Auxiliary (`ann:form`): $\int|\sum_{i<N}c_ie_{D_i}|^2\,d\nu$ in coefficient form. -/
@[nolint defsWithUnderscore]
def aux_ann_Aq (ν : Measure ℝ²) (D : ℕ → ℝ²) (N : ℕ) (c : Fin N → ℂ) : ℂ :=
  ∑ P ∈ (Finset.univ : Finset (Fin N)) ×ˢ Finset.univ,
    c P.1 * conj (c P.2) * ∫ ξ, e ⟪D P.1 - D P.2, ξ⟫_ℝ ∂ν

/-- Auxiliary (`ann:form`): $\int|\sum_{k,l<N}d_{kl}e_{D_k}\otimes e_{D_l}|^2\,d(\nu_1\otimes\nu_2)$
in coefficient form. -/
@[nolint defsWithUnderscore]
def aux_ann_Bq (ν₁ ν₂ : Measure ℝ²) (D : ℕ → ℝ²) (N : ℕ) (d : Fin N × Fin N → ℂ) : ℂ :=
  ∑ P ∈ (Finset.univ : Finset (Fin N × Fin N)) ×ˢ Finset.univ, d P.1 * conj (d P.2) *
    ((∫ ξ, e ⟪D P.1.1 - D P.2.1, ξ⟫_ℝ ∂ν₁) * ∫ ξ, e ⟪D P.1.2 - D P.2.2, ξ⟫_ℝ ∂ν₂)

/-- Auxiliary (`ann:form`): the polynomial form in coefficient form. -/
@[nolint defsWithUnderscore]
def aux_ann_lq (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ) (p : ℝ² × Ang) (D : ℕ → ℝ²) (N : ℕ)
    (c : Fin N → ℂ) (d : Fin N × Fin N → ℂ) : ℂ :=
  ∑ i : Fin N, ∑ kl : Fin N × Fin N, c i * d kl * h3 p ![D i, D kl.1, D kl.2]

theorem aux_ann_Aq_eq (ν : Measure ℝ²) [IsFiniteMeasure ν] (D : ℕ → ℝ²) (N : ℕ)
    (c : Fin N → ℂ) :
    ((∫ ξ, ‖∑ i : Fin N, c i * charE (D i) ξ‖ ^ 2 ∂ν : ℝ) : ℂ) = aux_ann_Aq ν D N c :=
  aux_ann_integral_normSq_sum ν Finset.univ c (fun i => D i)

theorem aux_ann_Bq_eq (ν₁ ν₂ : Measure ℝ²) [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (D : ℕ → ℝ²) (N : ℕ) (d : Fin N × Fin N → ℂ) :
    ((∫ ξ, ‖∑ kl : Fin N × Fin N, d kl * charE (D kl.1) ξ.1 * charE (D kl.2) ξ.2‖ ^ 2
      ∂(ν₁.prod ν₂) : ℝ) : ℂ) = aux_ann_Bq ν₁ ν₂ D N d :=
  aux_ann_integral_normSq_sum2 ν₁ ν₂ Finset.univ d (fun kl => D kl.1) (fun kl => D kl.2)

/-- Auxiliary: characters integrated against a measurable kernel give essentially bounded
functions of the configuration. -/
theorem aux_ann_I_memLp (α β : ℝ) {ν : ℝ² → Measure ℝ²} (hν : IsMeasurableKernel ν)
    (hν1 : ∀ z, ν z univ ≤ 1) (j : Fin 3) (s : ℝ²) :
    MemLp (fun p => ∫ ξ, e ⟪s, ξ⟫_ℝ ∂(ν (proj α β j p))) ⊤ μinc := by
  have hfin := hν.1
  have hm : StronglyMeasurable fun z => ∫ ξ, e ⟪s, ξ⟫_ℝ ∂(ν z) :=
    ext_kernel_integration_measurable_complex hν (F := fun q : ℝ² × ℝ² => e ⟪s, q.2⟫_ℝ)
      (by have := aux_ann_continuous_e; fun_prop : Continuous fun q : ℝ² × ℝ² =>
        e ⟪s, q.2⟫_ℝ).stronglyMeasurable
  refine memLp_top_of_bound (hm.measurable.comp (aux_ann_proj_continuous α β j).measurable
    |>.aestronglyMeasurable) 1 (ae_of_all _ fun p => ?_)
  refine (norm_integral_le_of_norm_le_const (C := 1) (ae_of_all _ fun ξ =>
    (aux_ann_norm_e _).le)).trans ?_
  rw [one_mul]
  exact ENNReal.toReal_le_of_le_ofReal zero_le_one (by simpa using hν1 _)

section CS

variable {α β : ℝ} {Q : Set ℝ²} {C L : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
  {k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ} {h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ}
  {ν : Fin 3 → ℝ² → Measure ℝ²}

/-- Auxiliary (`ann:form`, see `Auto.ann_form`): for fixed coefficient data, the quadratic
expression $|q|^2a_0+b_0-2\operatorname{Re}(q\,l)$ is a.e. nonnegative, as the weak-* limit of
$|qF_{0,n}[a](\pi_0p)-\overline{G_n(p)}|^2$. -/
theorem aux_ann_ineq_ae (hβ : β ≠ 0)
    (hadm : IsAdmissibleSeq Q C R f) (hlim : aux_IsCorrelationLimits α β L R f k h3)
    (hν : aux_IsSpectralKernels k ν) (D : ℕ → ℝ²) (N : ℕ) (c : Fin N → ℂ)
    (d : Fin N × Fin N → ℂ) (q : ℂ) :
    ∀ᵐ p ∂μinc, 0 ≤ ((‖q‖ ^ 2 : ℝ) : ℂ) * aux_ann_Aq (ν 0 (proj α β 0 p)) D N c +
      aux_ann_Bq (ν 1 (proj α β 1 p)) (ν 2 (proj α β 2 p)) D N d -
      q * aux_ann_lq h3 p D N c d - conj (q * aux_ann_lq h3 p D N c d) := by
  have hfin : ∀ j z, IsFiniteMeasure (ν j z) := fun j => (hν.1 j).1
  have hA := ann_factor_one α β Q C L R f hadm k h3 hlim ν hν (aux_ann_aOf D N c)
  have hB := ann_factor_two α β hβ Q C L R f hadm k h3 hlim ν hν (aux_ann_GOf D N d)
  have hL := aux_ann_form_limit hadm hlim (aux_ann_aOf D N c) (aux_ann_GOf D N d)
  simp_rw [aux_ann_trigPoly_aOf, aux_ann_Aq_eq] at hA
  simp_rw [aux_ann_tensorPoly_GOf, aux_ann_Bq_eq] at hB
  simp_rw [aux_ann_Λ_of] at hL
  set Fn : ℕ → ℝ² × Ang → ℂ := fun n p => polyTranslate R f 0 n (aux_ann_aOf D N c) (proj α β 0 p)
    with hFn
  set Gn : ℕ → ℝ² × Ang → ℂ := fun n p => tensorTranslate α β R f n (aux_ann_GOf D N d) p with hGn
  have hc := fun j n => aux_ann_continuous hadm j n
  have hp := fun j => aux_ann_proj_continuous α β j
  have hFc : ∀ n, Continuous (Fn n) := fun n => by
    simp only [hFn, aux_ann_polyTranslate_aOf, annT]
    have := hc 0 n; have := hp 0
    fun_prop
  have hGc : ∀ n, Continuous (Gn n) := fun n => by
    simp only [hGn, aux_ann_tensorTranslate_GOf, annT]
    have := hc 1 n; have := hc 2 n; have := hp 1; have := hp 2
    fun_prop
  set Cc := ∑ i : Fin N, ‖c i‖
  set Cd := ∑ kl : Fin N × Fin N, ‖d kl‖
  have hFb : ∀ n p, ‖Fn n p‖ ≤ Cc := fun n p => by
    simp only [hFn, aux_ann_polyTranslate_aOf]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (aux_ann_annT_le_one hadm _ _ _ _)
  have hGb : ∀ n p, ‖Gn n p‖ ≤ Cd := fun n p => by
    simp only [hGn, aux_ann_tensorTranslate_GOf]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun kl _ => ?_)
    rw [norm_mul, norm_mul]
    exact (mul_le_of_le_one_right (by positivity) (aux_ann_annT_le_one hadm _ _ _ _)).trans
      (mul_le_of_le_one_right (norm_nonneg _) (aux_ann_annT_le_one hadm _ _ _ _))
  -- memberships of the limits
  have hI := fun j s => aux_ann_I_memLp α β (hν.1 j) (hν.2.1 j) j s
  have hAm : MemLp (fun p => aux_ann_Aq (ν 0 (proj α β 0 p)) D N c) ⊤ μinc := by
    unfold aux_ann_Aq
    exact memLp_finsetSum _ fun P _ => (hI 0 _).const_mul _
  have hBm : MemLp (fun p => aux_ann_Bq (ν 1 (proj α β 1 p)) (ν 2 (proj α β 2 p)) D N d) ⊤
      μinc := by
    unfold aux_ann_Bq
    exact memLp_finsetSum _ fun P _ => ((hI 1 _).fun_mul (r := ⊤) (hI 2 _)).const_mul _
  have hLm : MemLp (fun p => aux_ann_lq h3 p D N c d) ⊤ μinc := by
    unfold aux_ann_lq
    exact memLp_finsetSum _ fun i _ => memLp_finsetSum _ fun kl _ =>
      (aux_ann_h3_memLp hlim _).const_mul _
  have hLc : MemLp (fun p => conj (-q * aux_ann_lq h3 p D N c d)) ⊤ μinc :=
    (hLm.const_mul (-q)).star
  -- the combined sequence
  have h1 := aux_ann_weakStar_const_mul ((‖q‖ ^ 2 : ℝ) : ℂ) hA
  have h3' := aux_ann_weakStar_const_mul (-q) hL
  have h4 := aux_ann_weakStar_conj h3'
  have hm1 : ∀ n, AEStronglyMeasurable (fun p => ((‖q‖ ^ 2 : ℝ) : ℂ) *
      ((‖Fn n p‖ ^ 2 : ℝ) : ℂ)) μinc := fun n =>
    (by have := hFc n; fun_prop : Continuous fun p => ((‖q‖ ^ 2 : ℝ) : ℂ) *
      ((‖Fn n p‖ ^ 2 : ℝ) : ℂ)).aestronglyMeasurable
  have hm2 : ∀ n, AEStronglyMeasurable (fun p => ((‖Gn n p‖ ^ 2 : ℝ) : ℂ)) μinc := fun n =>
    (by have := hGc n; fun_prop : Continuous fun p => ((‖Gn n p‖ ^ 2 : ℝ) : ℂ)).aestronglyMeasurable
  have hm3 : ∀ n, AEStronglyMeasurable (fun p => -q * (Fn n p * Gn n p)) μinc := fun n =>
    (by have := hFc n; have := hGc n; fun_prop :
      Continuous fun p => -q * (Fn n p * Gn n p)).aestronglyMeasurable
  have hm4 : ∀ n, AEStronglyMeasurable (fun p => conj (-q * (Fn n p * Gn n p))) μinc := fun n =>
    (Complex.continuous_conj.comp_aestronglyMeasurable (hm3 n))
  have hb1 : ∃ K, ∀ n p, ‖((‖q‖ ^ 2 : ℝ) : ℂ) * ((‖Fn n p‖ ^ 2 : ℝ) : ℂ)‖ ≤ K :=
    ⟨‖q‖ ^ 2 * Cc ^ 2, fun n p => by
      rw [norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_nonneg (by positivity), abs_of_nonneg (by positivity)]
      gcongr; exact hFb n p⟩
  have hb2 : ∃ K, ∀ n p, ‖((‖Gn n p‖ ^ 2 : ℝ) : ℂ)‖ ≤ K :=
    ⟨Cd ^ 2, fun n p => by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      gcongr; exact hGb n p⟩
  have hb3 : ∃ K, ∀ n p, ‖-q * (Fn n p * Gn n p)‖ ≤ K :=
    ⟨‖q‖ * (Cc * Cd), fun n p => by
      rw [norm_mul, norm_mul, norm_neg]
      gcongr
      · exact hFb n p
      · exact hGb n p⟩
  have hb4 : ∃ K, ∀ n p, ‖conj (-q * (Fn n p * Gn n p))‖ ≤ K := by
    obtain ⟨K, hK⟩ := hb3
    exact ⟨K, fun n p => by rw [Complex.norm_conj]; exact hK n p⟩
  have hsum12 := aux_ann_weakStar_add hm1 hb1 hm2 hb2 (hAm.const_mul _) hBm h1 hB
  have hsum123 := aux_ann_weakStar_add (fun n => (hm1 n).add (hm2 n))
    (by obtain ⟨K1, h1⟩ := hb1; obtain ⟨K2, h2⟩ := hb2
        exact ⟨K1 + K2, fun n p => (norm_add_le _ _).trans (add_le_add (h1 n p) (h2 n p))⟩)
    hm3 hb3 ((hAm.const_mul _).add hBm) (hLm.const_mul _) hsum12 h3'
  have hall := aux_ann_weakStar_add (fun n => ((hm1 n).add (hm2 n)).add (hm3 n))
    (by obtain ⟨K1, h1⟩ := hb1; obtain ⟨K2, h2⟩ := hb2; obtain ⟨K3, h3⟩ := hb3
        exact ⟨K1 + K2 + K3, fun n p => (norm_add_le _ _).trans (add_le_add
          ((norm_add_le _ _).trans (add_le_add (h1 n p) (h2 n p))) (h3 n p))⟩)
    hm4 hb4 (((hAm.const_mul _).add hBm).add (hLm.const_mul _))
    hLc hsum123 h4
  have hnn := aux_ann_weakStar_nonneg (μ := μinc)
    ((((hAm.const_mul _).add hBm).add (hLm.const_mul _)).add
      hLc)
    (fun n => ae_of_all _ fun p => by
      have key : ((‖q * Fn n p - conj (Gn n p)‖ ^ 2 : ℝ) : ℂ) =
          ((‖q‖ ^ 2 : ℝ) : ℂ) * ((‖Fn n p‖ ^ 2 : ℝ) : ℂ) + ((‖Gn n p‖ ^ 2 : ℝ) : ℂ) +
            -q * (Fn n p * Gn n p) + conj (-q * (Fn n p * Gn n p)) := by
        push_cast
        rw [← Complex.mul_conj', ← Complex.mul_conj', ← Complex.mul_conj', ← Complex.mul_conj']
        simp only [map_sub, map_mul, map_neg, Complex.conj_conj]
        ring
      simp only [Pi.add_apply]
      rw [← key]
      exact Complex.zero_le_real.2 (by positivity)) hall
  filter_upwards [hnn] with p hp
  convert hp using 1
  simp only [Pi.add_apply, map_mul, map_neg]
  ring

end CS

section CS2

variable {α β : ℝ} {Q : Set ℝ²} {C L : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
  {k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ} {h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ}
  {ν : Fin 3 → ℝ² → Measure ℝ²}

theorem aux_ann_Aq_continuous {X : Type*} [TopologicalSpace X] (ν₀ : Measure ℝ²) (D : ℕ → ℝ²)
    (N : ℕ) {g : X → Fin N → ℂ} (hg : Continuous g) :
    Continuous fun x => aux_ann_Aq ν₀ D N (g x) := by
  unfold aux_ann_Aq
  exact continuous_finsetSum _ fun P _ => (((continuous_apply P.1).comp hg).mul
    (Complex.continuous_conj.comp ((continuous_apply P.2).comp hg))).mul continuous_const

theorem aux_ann_Bq_continuous {X : Type*} [TopologicalSpace X] (ν₁ ν₂ : Measure ℝ²)
    (D : ℕ → ℝ²) (N : ℕ) {g : X → Fin N × Fin N → ℂ} (hg : Continuous g) :
    Continuous fun x => aux_ann_Bq ν₁ ν₂ D N (g x) := by
  unfold aux_ann_Bq
  exact continuous_finsetSum _ fun P _ => (((continuous_apply P.1).comp hg).mul
    (Complex.continuous_conj.comp ((continuous_apply P.2).comp hg))).mul continuous_const

theorem aux_ann_lq_continuous {X : Type*} [TopologicalSpace X]
    (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ) (p : ℝ² × Ang) (D : ℕ → ℝ²) (N : ℕ)
    {g : X → Fin N → ℂ} {g' : X → Fin N × Fin N → ℂ} (hg : Continuous g) (hg' : Continuous g') :
    Continuous fun x => aux_ann_lq h3 p D N (g x) (g' x) := by
  unfold aux_ann_lq
  exact continuous_finsetSum _ fun i _ => continuous_finsetSum _ fun kl _ =>
    (((continuous_apply i).comp hg).mul ((continuous_apply kl).comp hg')).mul continuous_const

/-- Auxiliary: continuity of the quadratic expression of `ann:form` in the coefficients. -/
theorem aux_ann_ineq_continuous (ν₀ ν₁ ν₂ : Measure ℝ²) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (p : ℝ² × Ang) (D : ℕ → ℝ²) (N : ℕ) :
    Continuous fun x : (Fin N → ℂ) × (Fin N × Fin N → ℂ) × ℂ =>
      ((‖x.2.2‖ ^ 2 : ℝ) : ℂ) * aux_ann_Aq ν₀ D N x.1 + aux_ann_Bq ν₁ ν₂ D N x.2.1 -
        x.2.2 * aux_ann_lq h3 p D N x.1 x.2.1 - conj (x.2.2 * aux_ann_lq h3 p D N x.1 x.2.1) := by
  have h1 : Continuous fun x : (Fin N → ℂ) × (Fin N × Fin N → ℂ) × ℂ => x.1 := continuous_fst
  have h2 : Continuous fun x : (Fin N → ℂ) × (Fin N × Fin N → ℂ) × ℂ => x.2.1 :=
    continuous_fst.comp continuous_snd
  have hq : Continuous fun x : (Fin N → ℂ) × (Fin N × Fin N → ℂ) × ℂ => x.2.2 :=
    continuous_snd.comp continuous_snd
  have hA := aux_ann_Aq_continuous ν₀ D N h1
  have hB := aux_ann_Bq_continuous ν₁ ν₂ D N h2
  have hl := aux_ann_lq_continuous h3 p D N h1 h2
  have hql := hq.mul hl
  exact (((Complex.continuous_ofReal.comp (hq.norm.pow 2)).mul hA).add hB |>.sub hql).sub
    (Complex.continuous_conj.comp hql)

/-- Auxiliary (`ann:form`, see `Auto.ann_form`): the quadratic inequality holds outside one null
set for all coefficient data (countably many rational data and continuity). -/
theorem aux_ann_ineq_all (hβ : β ≠ 0)
    (hadm : IsAdmissibleSeq Q C R f) (hlim : aux_IsCorrelationLimits α β L R f k h3)
    (hν : aux_IsSpectralKernels k ν) (D : ℕ → ℝ²) :
    ∀ᵐ p ∂μinc, ∀ (N : ℕ) (c : Fin N → ℂ) (d : Fin N × Fin N → ℂ) (q : ℂ),
      0 ≤ ((‖q‖ ^ 2 : ℝ) : ℂ) * aux_ann_Aq (ν 0 (proj α β 0 p)) D N c +
      aux_ann_Bq (ν 1 (proj α β 1 p)) (ν 2 (proj α β 2 p)) D N d -
      q * aux_ann_lq h3 p D N c d - conj (q * aux_ann_lq h3 p D N c d) := by
  set E := TopologicalSpace.denseSeq ℂ
  have hE : DenseRange E := TopologicalSpace.denseRange_denseSeq _
  have hrat : ∀ x : Σ N : ℕ, (Fin N → ℕ) × (Fin N × Fin N → ℕ) × ℕ, ∀ᵐ p ∂μinc,
      0 ≤ ((‖E x.2.2.2‖ ^ 2 : ℝ) : ℂ) * aux_ann_Aq (ν 0 (proj α β 0 p)) D x.1 (E ∘ x.2.1) +
      aux_ann_Bq (ν 1 (proj α β 1 p)) (ν 2 (proj α β 2 p)) D x.1 (E ∘ x.2.2.1) -
      E x.2.2.2 * aux_ann_lq h3 p D x.1 (E ∘ x.2.1) (E ∘ x.2.2.1) -
      conj (E x.2.2.2 * aux_ann_lq h3 p D x.1 (E ∘ x.2.1) (E ∘ x.2.2.1)) := fun x =>
    aux_ann_ineq_ae hβ hadm hlim hν D x.1 (E ∘ x.2.1) (E ∘ x.2.2.1) (E x.2.2.2)
  filter_upwards [ae_all_iff.2 hrat] with p hp N c d q
  have hcont := aux_ann_ineq_continuous (ν 0 (proj α β 0 p)) (ν 1 (proj α β 1 p))
    (ν 2 (proj α β 2 p)) h3 p D N
  have ht : Tendsto (fun m => ((fun i => E (aux_ann_idx E hE m (c i))),
      (fun kl => E (aux_ann_idx E hE m (d kl))), E (aux_ann_idx E hE m q))) atTop
      (𝓝 (c, d, q)) :=
    (tendsto_pi_nhds.2 fun i => aux_ann_idx_tendsto E hE (c i)).prodMk_nhds
      ((tendsto_pi_nhds.2 fun kl => aux_ann_idx_tendsto E hE (d kl)).prodMk_nhds
        (aux_ann_idx_tendsto E hE q))
  have hlimit := (hcont.tendsto (c, d, q)).comp ht
  refine ge_of_tendsto' hlimit fun m => ?_
  have hm := hp ⟨N, fun i => aux_ann_idx E hE m (c i), fun kl => aux_ann_idx E hE m (d kl),
      aux_ann_idx E hE m q⟩
  simp only [Function.comp_def] at hm ⊢
  exact hm

/-- Auxiliary (`ann:form`, see `Auto.ann_form`): the Cauchy–Schwarz inequality `(ann:cs)` for
all polynomial data outside one null set. -/
theorem aux_ann_cs_all (hβ : β ≠ 0)
    (hadm : IsAdmissibleSeq Q C R f) (hlim : aux_IsCorrelationLimits α β L R f k h3)
    (hν : aux_IsSpectralKernels k ν) (D : ℕ → ℝ²) :
    ∀ᵐ p ∂μinc, ∀ (N : ℕ) (c : Fin N → ℂ) (d : Fin N × Fin N → ℂ),
      ‖aux_ann_lq h3 p D N c d‖ ^ 2 ≤
        (∫ ξ, ‖∑ i : Fin N, c i * charE (D i) ξ‖ ^ 2 ∂(ν 0 (proj α β 0 p))) *
        ∫ ξ, ‖∑ kl : Fin N × Fin N, d kl * charE (D kl.1) ξ.1 * charE (D kl.2) ξ.2‖ ^ 2
          ∂((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) := by
  have hfin : ∀ j z, IsFiniteMeasure (ν j z) := fun j => (hν.1 j).1
  filter_upwards [aux_ann_ineq_all hβ hadm hlim hν D] with p hp N c d
  refine aux_ann_quad _ _ _ (integral_nonneg fun _ => by positivity) fun q => ?_
  have h := Complex.nonneg_iff.1 (hp N c d q) |>.1
  rw [← aux_ann_Aq_eq, ← aux_ann_Bq_eq] at h
  convert h using 1
  simp only [Complex.sub_re, Complex.add_re, Complex.conj_re, Complex.mul_re,
    Complex.ofReal_re, Complex.ofReal_im]
  ring

end CS2

section L2aux

variable {X : Type*} [MeasurableSpace X] {ν : Measure X}

/-- Auxiliary: the squared `L²` norm as an integral. -/
theorem aux_ann_norm_toLp_sq {g : X → ℂ} (hg : MemLp g 2 ν) :
    ‖hg.toLp g‖ ^ 2 = ∫ x, ‖g x‖ ^ 2 ∂ν := by
  rw [Lp.norm_toLp, hg.eLpNorm_eq_integral_rpow_norm two_ne_zero ENNReal.ofNat_ne_top,
    ENNReal.toReal_ofReal (by positivity)]
  have h2 : (2 : ℝ≥0∞).toReal = ((2 : ℕ) : ℝ) := by norm_num
  rw [h2, Real.rpow_inv_natCast_pow (integral_nonneg fun _ => by positivity) two_ne_zero]
  congr 1; funext x
  exact Real.rpow_natCast _ 2

/-- Auxiliary: bounded functions on a finite measure space are square integrable. -/
theorem aux_ann_memLp_two_of_le [IsFiniteMeasure ν] {g : X → ℂ} (hg : Measurable g)
    (hb : ∀ x, ‖g x‖ ≤ 1) : MemLp g 2 ν :=
  MemLp.of_bound hg.aestronglyMeasurable 1 (ae_of_all _ hb)

/-- Auxiliary: dominated pointwise convergence of functions bounded by one gives `L²`
convergence (finite measure). -/
theorem aux_ann_tendsto_toLp [IsFiniteMeasure ν] {g : ℕ → X → ℂ} {g0 : X → ℂ}
    (hgm : ∀ m, Measurable (g m)) (hg0m : Measurable g0) (hb : ∀ m x, ‖g m x‖ ≤ 1)
    (hb0 : ∀ x, ‖g0 x‖ ≤ 1) (hconv : ∀ x, Tendsto (fun m => g m x) atTop (𝓝 (g0 x))) :
    Tendsto (fun m => (aux_ann_memLp_two_of_le (ν := ν) (hgm m) (hb m)).toLp (g m)) atTop
      (𝓝 ((aux_ann_memLp_two_of_le (ν := ν) hg0m hb0).toLp g0)) := by
  have : Fact ((1 : ℝ≥0∞) ≤ 2) := ⟨by norm_num⟩
  rw [Lp.tendsto_Lp_iff_tendsto_eLpNorm'']
  have hsub : ∀ m, MemLp (g m - g0) 2 ν := fun m =>
    (aux_ann_memLp_two_of_le (hgm m) (hb m)).sub (aux_ann_memLp_two_of_le hg0m hb0)
  have e : ∀ m, eLpNorm (g m - g0) 2 ν =
      ENNReal.ofReal ((∫ x, ‖g m x - g0 x‖ ^ (2 : ℝ) ∂ν) ^ (2 : ℝ)⁻¹) := fun m => by
    rw [(hsub m).eLpNorm_eq_integral_rpow_norm two_ne_zero ENNReal.ofNat_ne_top]
    norm_num
  simp_rw [e]
  have hint : Tendsto (fun m => ∫ x, ‖g m x - g0 x‖ ^ (2 : ℝ) ∂ν) atTop (𝓝 0) := by
    have h0 : (0 : ℝ) = ∫ x, (0 : ℝ) ∂ν := by simp
    rw [h0]
    refine tendsto_integral_of_dominated_convergence (fun _ => (2 : ℝ) ^ (2 : ℝ))
      (fun m => ((hgm m).sub hg0m).norm.pow_const _ |>.aestronglyMeasurable)
      (integrable_const _) (fun m => ae_of_all _ fun x => ?_) (ae_of_all _ fun x => ?_)
    · rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      refine Real.rpow_le_rpow (norm_nonneg _) ((norm_sub_le _ _).trans ?_) (by norm_num)
      linarith [hb m x, hb0 x]
    · have := ((hconv x).sub (tendsto_const_nhds (x := g0 x))).norm
      rw [sub_self, norm_zero] at this
      have h2 := (Real.continuousAt_rpow_const 0 (2 : ℝ) (Or.inr (by norm_num))).tendsto.comp
        this
      simpa [Function.comp_def, Real.zero_rpow (by norm_num : (2 : ℝ) ≠ 0)] using h2
  have h3 := (Real.continuousAt_rpow_const 0 (2 : ℝ)⁻¹ (Or.inr (by norm_num))).tendsto.comp hint
  rw [Real.zero_rpow (by norm_num)] at h3
  simpa using ENNReal.tendsto_ofReal h3

end L2aux

theorem aux_ann_charE_le (s ξ : ℝ²) : ‖charE s ξ‖ ≤ 1 := (aux_ann_norm_e _).le

theorem aux_ann_charE_meas (s : ℝ²) : Measurable (charE s) := by
  have := aux_ann_continuous_e
  unfold charE; exact (by fun_prop : Continuous fun ξ : ℝ² => e ⟪s, ξ⟫_ℝ).measurable

theorem aux_ann_charE2_le (s t : ℝ²) (ξ : ℝ² × ℝ²) : ‖charE s ξ.1 * charE t ξ.2‖ ≤ 1 := by
  rw [norm_mul]; exact (mul_le_of_le_one_left (norm_nonneg _) (aux_ann_charE_le _ _)).trans
      (aux_ann_charE_le _ _)

theorem aux_ann_charE2_meas (s t : ℝ²) : Measurable fun ξ : ℝ² × ℝ² => charE s ξ.1 * charE t ξ.2 :=
  ((aux_ann_charE_meas s).comp measurable_fst).mul ((aux_ann_charE_meas t).comp measurable_snd)

theorem aux_ann_charE_tendsto {s : ℕ → ℝ²} {s0 : ℝ²} (h : Tendsto s atTop (𝓝 s0)) (ξ : ℝ²) :
    Tendsto (fun m => charE (s m) ξ) atTop (𝓝 (charE s0 ξ)) := by
  unfold charE
  exact (aux_ann_continuous_e.tendsto _).comp ((continuous_id.inner continuous_const).tendsto _
    |>.comp h)

/-- Auxiliary: an `L²` class with a given representative has the corresponding norm. -/
theorem aux_ann_norm_sq_of_ae {X : Type*} [MeasurableSpace X] {ν : Measure X}
    (u : Lp ℂ 2 ν) {g : X → ℂ} (hg : MemLp g 2 ν) (h : ⇑u =ᵐ[ν] g) :
    ‖u‖ ^ 2 = ∫ x, ‖g x‖ ^ 2 ∂ν := by
  have : u = hg.toLp g := Lp.ext (h.trans hg.coeFn_toLp.symm)
  rw [this, aux_ann_norm_toLp_sq]

/-- Auxiliary: sums over a finsupp on `ℕ` supported in `range N`. -/
theorem aux_ann_sum_range {M : Type*} [AddCommMonoid M] (x : ℕ →₀ ℂ) {N : ℕ}
    (hx : x.support ⊆ Finset.range N) (g : ℕ → ℂ → M) (h0 : ∀ i, g i 0 = 0) :
    x.sum g = ∑ i : Fin N, g i (x i) := by
  rw [Finsupp.sum_of_support_subset x hx g (fun i _ => h0 i)]
  exact (Fin.sum_univ_eq_sum_range (fun i => g i (x i)) N).symm

theorem aux_ann_sum_range2 {M : Type*} [AddCommMonoid M] (y : ℕ × ℕ →₀ ℂ) {N : ℕ}
    (hy : y.support ⊆ Finset.range N ×ˢ Finset.range N) (g : ℕ × ℕ → ℂ → M)
    (h0 : ∀ i, g i 0 = 0) :
    y.sum g = ∑ kl : Fin N × Fin N, g (kl.1, kl.2) (y (kl.1, kl.2)) := by
  rw [Finsupp.sum_of_support_subset y hy g (fun i _ => h0 i), Finset.sum_product,
    Fintype.sum_prod_type]
  rw [← Fin.sum_univ_eq_sum_range (fun i => ∑ j ∈ Finset.range N, g (i, j) (y (i, j))) N]
  exact Finset.sum_congr rfl fun i _ =>
    (Fin.sum_univ_eq_sum_range (fun j => g (i, j) (y (i, j))) N).symm

/-- Auxiliary: every pair of finsupps is supported in some `range N`. -/
theorem aux_ann_exists_range (x : ℕ →₀ ℂ) (y : ℕ × ℕ →₀ ℂ) :
    ∃ N, x.support ⊆ Finset.range N ∧ y.support ⊆ Finset.range N ×ˢ Finset.range N := by
  refine ⟨x.support.sup id + y.support.sup (fun kl => max kl.1 kl.2) + 1, fun i hi => ?_,
    fun kl hkl => ?_⟩
  · have := Finset.le_sup (f := id) hi
    simp only [Finset.mem_range, id] at this ⊢; omega
  · have := Finset.le_sup (f := fun kl : ℕ × ℕ => max kl.1 kl.2) hkl
    simp only [Finset.mem_product, Finset.mem_range] at this ⊢
    omega

set_option maxHeartbeats 2000000 in
-- The proof of `ann:form` is long and needs a raised heartbeat limit.
/-- **Lemma `ann:form`** (The limiting bilinear correlation form).
For almost every configuration $p$, there is a complex bilinear form
$$\ell_p:L^2(\nu_0)\times L^2(\nu_1\otimes\nu_2)\longrightarrow\mathbb C$$
such that
$$|\ell_p(a,G)|\le\|a\|_{L^2(\nu_0)}\|G\|_{L^2(\nu_1\otimes\nu_2)}.\qquad(\text{ann:cs})$$
For trigonometric polynomials and their finite tensor sums, $\ell_p(a,G)$ is the weak-* limit of
$F_{0,n}[a](\pi_0p)G_n(p)$.  In particular,
$$\ell_p(e_{s_0},e_{s_1}\otimes e_{s_2})=h(p;s_0,s_1,s_2).$$
(In Lean the blueprint hypothesis `(hQ : Bornology.IsBounded Q)` is omitted since the proof does not
need it; see `automation/ErrorReport.md`.) -/
theorem ann_form (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) :
    ∃ ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ, aux_IsLimitForm α β R f ν h3 ℓ := by
  classical
  have hfin : ∀ j z, IsFiniteMeasure (ν j z) := fun j => (hν.1 j).1
  set D := TopologicalSpace.denseSeq ℝ² with hDdef
  have hD : DenseRange D := TopologicalSpace.denseRange_denseSeq _
  -- the linear data at a configuration
  set u1 : ∀ (p : ℝ² × Ang) (i : ℕ), Lp ℂ 2 (ν 0 (proj α β 0 p)) := fun p i =>
    (aux_ann_memLp_two_of_le (aux_ann_charE_meas (D i)) (aux_ann_charE_le (D i))).toLp
      (charE (D i)) with hu1
  set u2 : ∀ (p : ℝ² × Ang) (kl : ℕ × ℕ),
      Lp ℂ 2 ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) := fun p kl =>
    (aux_ann_memLp_two_of_le (aux_ann_charE2_meas (D kl.1) (D kl.2))
      (aux_ann_charE2_le (D kl.1) (D kl.2))).toLp
      (fun ξ : ℝ² × ℝ² => charE (D kl.1) ξ.1 * charE (D kl.2) ξ.2) with hu2
  set e1 : ∀ p : ℝ² × Ang, (ℕ →₀ ℂ) →ₗ[ℂ] Lp ℂ 2 (ν 0 (proj α β 0 p)) := fun p =>
    Finsupp.linearCombination ℂ (u1 p) with he1
  set e2 : ∀ p : ℝ² × Ang, (ℕ × ℕ →₀ ℂ) →ₗ[ℂ]
      Lp ℂ 2 ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) := fun p =>
    Finsupp.linearCombination ℂ (u2 p) with he2
  set Λ : ∀ p : ℝ² × Ang, (ℕ →₀ ℂ) →ₗ[ℂ] (ℕ × ℕ →₀ ℂ) →ₗ[ℂ] ℂ := fun p =>
    Finsupp.linearCombination ℂ fun i =>
      Finsupp.linearCombination ℂ fun kl => h3 p ![D i, D kl.1, D kl.2] with hΛ
  have hΛapp : ∀ p x y, Λ p x y =
      x.sum fun i a => a * y.sum fun kl b => b * h3 p ![D i, D kl.1, D kl.2] := by
    intro p x y
    simp only [hΛ, Finsupp.linearCombination_apply, Finsupp.sum, LinearMap.sum_apply,
      LinearMap.smul_apply, smul_eq_mul]
  have he1ae : ∀ p (x : ℕ →₀ ℂ) N, x.support ⊆ Finset.range N →
      ⇑(e1 p x) =ᵐ[ν 0 (proj α β 0 p)] fun ξ => ∑ i : Fin N, x i * charE (D i) ξ := by
    intro p x N hx
    have h1 : e1 p x = ∑ i : Fin N, x i • u1 p i := by
      rw [he1, Finsupp.linearCombination_apply,
        aux_ann_sum_range x hx (fun i a => a • u1 p i) (fun i => zero_smul _ _)]
    rw [h1]
    filter_upwards [Lp.coeFn_finsetSum Finset.univ (fun i : Fin N => x i • u1 p i),
      eventually_all.2 fun i : Fin N => Lp.coeFn_smul (x i) (u1 p i),
      eventually_all.2 fun i : Fin N => (aux_ann_memLp_two_of_le (ν := ν 0 (proj α β 0 p))
        (aux_ann_charE_meas (D i)) (aux_ann_charE_le (D i))).coeFn_toLp] with ξ h1 h2 h3
    rw [h1, Finset.sum_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [h2 i, Pi.smul_apply, smul_eq_mul]
    exact congrArg _ (h3 i)
  have he2ae : ∀ p (y : ℕ × ℕ →₀ ℂ) N, y.support ⊆ Finset.range N ×ˢ Finset.range N →
      ⇑(e2 p y) =ᵐ[(ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))] fun ξ =>
        ∑ kl : Fin N × Fin N, y (kl.1, kl.2) * charE (D kl.1) ξ.1 * charE (D kl.2) ξ.2 := by
    intro p y N hy
    have h1 : e2 p y = ∑ kl : Fin N × Fin N, y (kl.1, kl.2) • u2 p (kl.1, kl.2) := by
      rw [he2, Finsupp.linearCombination_apply,
        aux_ann_sum_range2 y hy (fun i a => a • u2 p i) (fun i => zero_smul _ _)]
    rw [h1]
    filter_upwards [Lp.coeFn_finsetSum Finset.univ
        (fun kl : Fin N × Fin N => y (kl.1, kl.2) • u2 p (kl.1, kl.2)),
      eventually_all.2 fun kl : Fin N × Fin N => Lp.coeFn_smul (y (kl.1, kl.2)) (u2 p (kl.1, kl.2)),
      eventually_all.2 fun kl : Fin N × Fin N => (aux_ann_memLp_two_of_le
        (ν := (ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p)))
        (aux_ann_charE2_meas (D kl.1) (D kl.2)) (aux_ann_charE2_le (D kl.1) (D kl.2))).coeFn_toLp]
      with ξ h1 h2 h3
    rw [h1, Finset.sum_apply]
    refine Finset.sum_congr rfl fun kl _ => ?_
    rw [h2 kl, Pi.smul_apply, smul_eq_mul, h3 kl, mul_assoc]
  -- the good set
  set Good : Set (ℝ² × Ang) := {p | Continuous (h3 p) ∧ ∀ (N : ℕ) (c : Fin N → ℂ)
      (d : Fin N × Fin N → ℂ), ‖aux_ann_lq h3 p D N c d‖ ^ 2 ≤
        (∫ ξ, ‖∑ i : Fin N, c i * charE (D i) ξ‖ ^ 2 ∂(ν 0 (proj α β 0 p))) *
        ∫ ξ, ‖∑ kl : Fin N × Fin N, d kl * charE (D kl.1) ξ.1 * charE (D kl.2) ξ.2‖ ^ 2
          ∂((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p)))} with hGood
  have hGae : ∀ᵐ p ∂μinc, p ∈ Good := by
    filter_upwards [hlim.cont_three, aux_ann_cs_all hβ hadm hlim hν D] with p h1 h2
    exact ⟨h1, h2⟩
  have hbound : ∀ p ∈ Good, ∀ x y, ‖Λ p x y‖ ≤ ‖e1 p x‖ * ‖e2 p y‖ := by
    intro p hp x y
    obtain ⟨N, hx, hy⟩ := aux_ann_exists_range x y
    have hl : Λ p x y = aux_ann_lq h3 p D N (fun i => x i) (fun kl => y (kl.1, kl.2)) := by
      rw [hΛapp, aux_ann_sum_range x hx
        (fun i a => a * y.sum fun kl b => b * h3 p ![D i, D kl.1, D kl.2]) (fun i => zero_mul _)]
      unfold aux_ann_lq
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [aux_ann_sum_range2 y hy (fun kl b => b * h3 p ![D i, D kl.1, D kl.2])
        (fun i => zero_mul _), Finset.mul_sum]
      exact Finset.sum_congr rfl fun kl _ => by ring
    have hA := aux_ann_norm_sq_of_ae (e1 p x) (memLp_finsetSum (Finset.univ : Finset (Fin N))
      fun i _ =>
      (aux_ann_memLp_two_of_le (ν := ν 0 (proj α β 0 p)) (aux_ann_charE_meas (D i))
        (aux_ann_charE_le (D i))).const_mul (x i)) (he1ae p x N hx)
    have hB := aux_ann_norm_sq_of_ae (e2 p y) (memLp_finsetSum
      (Finset.univ : Finset (Fin N × Fin N)) fun kl _ =>
      ((aux_ann_memLp_two_of_le (ν := (ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p)))
        (aux_ann_charE2_meas (D kl.1) (D kl.2)) (aux_ann_charE2_le (D kl.1) (D kl.2))).const_mul
          (y (kl.1, kl.2))).ae_eq (ae_of_all _ fun ξ => by ring))
      (he2ae p y N hy)
    have hcs := hp.2 N (fun i => x i) (fun kl => y (kl.1, kl.2))
    rw [← hA, ← hB, ← hl, ← mul_pow] at hcs
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 hcs
  choose B hBe hBn using fun p (hp : p ∈ Good) =>
    aux_ann_bilinear_extend (e1 p) (e2 p) (Λ p) (hbound p hp)
  set c1 : ∀ (p : ℝ² × Ang) (s : ℝ²), Lp ℂ 2 (ν 0 (proj α β 0 p)) := fun p s =>
    (aux_ann_memLp_two_of_le (aux_ann_charE_meas s) (aux_ann_charE_le s)).toLp (charE s)
    with hc1
  set c2 : ∀ (p : ℝ² × Ang) (s t : ℝ²),
      Lp ℂ 2 ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) := fun p s t =>
    (aux_ann_memLp_two_of_le (aux_ann_charE2_meas s t) (aux_ann_charE2_le s t)).toLp
      (fun ξ : ℝ² × ℝ² => charE s ξ.1 * charE t ξ.2) with hc2
  have hB3 : ∀ p (hp : p ∈ Good) (s : Fin 3 → ℝ²),
      B p hp (c1 p (s 0)) (c2 p (s 1) (s 2)) = h3 p s := by
    intro p hp s
    have hD3 : ∀ i k l : ℕ, B p hp (c1 p (D i)) (c2 p (D k) (D l)) = h3 p ![D i, D k, D l] := by
      intro i k l
      have h1 : c1 p (D i) = e1 p (Finsupp.single i 1) := by
        rw [he1]; simp only [Finsupp.linearCombination_single, one_smul]; rfl
      have h2 : c2 p (D k) (D l) = e2 p (Finsupp.single (k, l) 1) := by
        rw [he2]; simp only [Finsupp.linearCombination_single, one_smul]; rfl
      rw [h1, h2, hBe, hΛapp]
      simp [Finsupp.sum_single_index]
    set i0 : ℕ → ℕ := fun m => aux_ann_idx D hD m (s 0)
    set i1 : ℕ → ℕ := fun m => aux_ann_idx D hD m (s 1)
    set i2 : ℕ → ℕ := fun m => aux_ann_idx D hD m (s 2)
    have ht0 := aux_ann_idx_tendsto D hD (s 0)
    have ht1 := aux_ann_idx_tendsto D hD (s 1)
    have ht2 := aux_ann_idx_tendsto D hD (s 2)
    have t1 : Tendsto (fun m => c1 p (D (i0 m))) atTop (𝓝 (c1 p (s 0))) :=
      aux_ann_tendsto_toLp (fun m => aux_ann_charE_meas _) (aux_ann_charE_meas _)
        (fun m => aux_ann_charE_le _) (aux_ann_charE_le _) fun ξ => aux_ann_charE_tendsto ht0 ξ
    have t2 : Tendsto (fun m => c2 p (D (i1 m)) (D (i2 m))) atTop
        (𝓝 (c2 p (s 1) (s 2))) :=
      aux_ann_tendsto_toLp (fun m => aux_ann_charE2_meas _ _) (aux_ann_charE2_meas _ _)
        (fun m => aux_ann_charE2_le _ _) (aux_ann_charE2_le _ _) fun ξ =>
          (aux_ann_charE_tendsto ht1 ξ.1).mul (aux_ann_charE_tendsto ht2 ξ.2)
    have hL := ((B p hp).continuous₂.tendsto (c1 p (s 0), c2 p (s 1) (s 2))).comp
      (t1.prodMk_nhds t2)
    have hvec : Tendsto (fun m => (![D (i0 m), D (i1 m), D (i2 m)] : Fin 3 → ℝ²)) atTop
        (𝓝 s) := by
      rw [tendsto_pi_nhds]
      intro j
      fin_cases j
      · exact ht0
      · exact ht1
      · exact ht2
    have hR := (hp.1.tendsto s).comp hvec
    refine tendsto_nhds_unique hL ?_
    convert hR using 1
    funext m
    exact hD3 _ _ _
  have hmem1 : ∀ p s, MemLp (charE s) 2 (ν 0 (proj α β 0 p)) := fun p s =>
    aux_ann_memLp_two_of_le (aux_ann_charE_meas s) (aux_ann_charE_le s)
  have hmem2 : ∀ p s t, MemLp (fun ξ : ℝ² × ℝ² => charE s ξ.1 * charE t ξ.2) 2
      ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) := fun p s t =>
    aux_ann_memLp_two_of_le (aux_ann_charE2_meas s t) (aux_ann_charE2_le s t)
  refine ⟨fun p a G => if hp : p ∈ Good then
    (if h : MemLp a 2 (ν 0 (proj α β 0 p)) ∧
        MemLp G 2 ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) then
      B p hp (h.1.toLp a) (h.2.toLp G) else 0) else 0, ?_, ?_, ?_⟩
  · filter_upwards [hGae] with p hp
    refine ⟨fun a a' G ha ha' hG => ?_, fun c a G ha hG => ?_, fun a G G' ha hG hG' => ?_,
      fun c a G ha hG => ?_, fun a G ha hG => ?_⟩
    · simp only [dite_eq_left hp, dite_eq_left (And.intro (ha.add ha') hG),
        dite_eq_left (And.intro ha hG), dite_eq_left (And.intro ha' hG)]
      rw [MemLp.toLp_add ha ha', (B p hp).map_add]
      rfl
    · simp only [dite_eq_left hp, dite_eq_left (And.intro (ha.const_smul c) hG),
        dite_eq_left (And.intro ha hG)]
      rw [MemLp.toLp_const_smul c ha, (B p hp).map_smul]
      rfl
    · simp only [dite_eq_left hp, dite_eq_left (And.intro ha (hG.add hG')),
        dite_eq_left (And.intro ha hG), dite_eq_left (And.intro ha hG')]
      exact (congrArg (B p hp (ha.toLp a)) (MemLp.toLp_add hG hG')).trans
        ((B p hp (ha.toLp a)).map_add _ _)
    · simp only [dite_eq_left hp, dite_eq_left (And.intro ha (hG.const_smul c)),
        dite_eq_left (And.intro ha hG)]
      exact (congrArg (B p hp (ha.toLp a)) (MemLp.toLp_const_smul c hG)).trans
        ((B p hp (ha.toLp a)).map_smul _ _)
    · simp only [dite_eq_left hp, dite_eq_left (And.intro ha hG)]
      have h := hBn p hp (ha.toLp a) (hG.toLp G)
      rw [Lp.norm_toLp, Lp.norm_toLp] at h
      rw [← ofReal_norm]
      calc ENNReal.ofReal ‖B p hp (ha.toLp a) (hG.toLp G)‖
          ≤ ENNReal.ofReal ((eLpNorm a 2 _).toReal * (eLpNorm G 2 _).toReal) :=
            ENNReal.ofReal_le_ofReal h
        _ = eLpNorm a 2 _ * eLpNorm G 2 _ := by
            rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg,
              ENNReal.ofReal_toReal ha.eLpNorm_lt_top.ne,
              ENNReal.ofReal_toReal hG.eLpNorm_lt_top.ne]
  · intro a G
    refine aux_ann_weakStar_congr (aux_ann_form_limit hadm hlim a G) ?_
    filter_upwards [hGae] with p hp
    have hta : MemLp (trigPoly a) 2 (ν 0 (proj α β 0 p)) :=
      memLp_finsetSum a.support fun s _ => (hmem1 p s).const_mul (a s)
    have htG : MemLp (tensorPoly G) 2 ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) :=
      (memLp_finsetSum G.support fun t _ => (hmem2 p t.1 t.2).const_mul (G t)).ae_eq
        (ae_of_all _ fun ξ => by
          simp only [tensorPoly, Finsupp.sum]
          exact Finset.sum_congr rfl fun t _ => by ring)
    have h1 : hta.toLp (trigPoly a) = ∑ s ∈ a.support, a s • c1 p s := by
      refine Lp.ext (hta.coeFn_toLp.trans ?_)
      filter_upwards [Lp.coeFn_finsetSum a.support (fun s => a s • c1 p s),
        eventually_all_finset a.support |>.2 fun s _ => Lp.coeFn_smul (a s) (c1 p s),
        eventually_all_finset a.support |>.2 fun s _ => (hmem1 p s).coeFn_toLp] with ξ h1 h2 h3
      rw [h1, Finset.sum_apply, trigPoly, Finsupp.sum]
      refine Finset.sum_congr rfl fun s hs => ?_
      rw [h2 s hs, Pi.smul_apply, smul_eq_mul, h3 s hs]
    have h2 : htG.toLp (tensorPoly G) = ∑ t ∈ G.support, G t • c2 p t.1 t.2 := by
      refine Lp.ext (htG.coeFn_toLp.trans ?_)
      have hs2 : ∀ t ∈ G.support,
          ⇑(G t • c2 p t.1 t.2) =ᵐ[(ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))]
            G t • ⇑(c2 p t.1 t.2) :=
        fun t _ => Lp.coeFn_smul _ _
      have hs3 : ∀ t ∈ G.support, ⇑(c2 p t.1 t.2) =ᵐ[(ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))]
          fun ξ : ℝ² × ℝ² => charE t.1 ξ.1 * charE t.2 ξ.2 :=
        fun t _ => (hmem2 p t.1 t.2).coeFn_toLp
      filter_upwards [Lp.coeFn_finsetSum G.support (fun t => G t • c2 p t.1 t.2),
        (eventually_all_finset G.support).2 hs2, (eventually_all_finset G.support).2 hs3]
        with ξ h1 h2 h3
      rw [h1, Finset.sum_apply, tensorPoly, Finsupp.sum]
      refine Finset.sum_congr rfl fun t ht => ?_
      rw [h2 t ht, Pi.smul_apply, smul_eq_mul, h3 t ht, mul_assoc]
    simp only [dite_eq_left hp, dite_eq_left (And.intro hta htG)]
    rw [h1, h2, map_sum, aux_ann_Λ, Finsupp.sum]
    simp only [sum_apply, map_smul, smul_apply,
      map_sum, smul_eq_mul]
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [Finsupp.sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    have := hB3 p hp ![s, t.1, t.2]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at this
    rw [this]
    ring
  · filter_upwards [hGae] with p hp s
    simp only [dite_eq_left hp, dite_eq_left (And.intro (hmem1 p (s 0)) (hmem2 p (s 1) (s 2)))]
    exact hB3 p hp s

/-! ### Infinitesimal translation and rotation invariance (`ann:invariance`) -/

/-! ### Auxiliary material for `ann:invariance` -/

/-- Auxiliary (`ann:invariance`): second-order Taylor bound for `θ ↦ u_θ`. -/
theorem aux_ann_u_taylor (θ : Ang) (δ : ℝ) (hδ : |δ| ≤ 1) :
    ‖u (θ + (δ : Ang)) - u θ - δ • v θ‖ ≤ 4 * δ ^ 2 := by
  induction θ using QuotientAddGroup.induction_on with
  | H t =>
  have hc := Real.cos_bound hδ
  have hs := Real.sin_bound hδ
  have hsq : δ ^ 2 ≤ 1 := by rw [← sq_abs]; nlinarith [abs_nonneg δ]
  have hd4 : |δ| ^ 4 ≤ δ ^ 2 := by
    rw [show |δ| ^ 4 = |δ| ^ 2 * |δ| ^ 2 by ring, sq_abs]
    exact mul_le_of_le_one_right (sq_nonneg _) hsq
  have hd3 : |δ| ^ 3 ≤ δ ^ 2 := by
    rw [show |δ| ^ 3 = |δ| ^ 2 * |δ| by ring, sq_abs]
    exact mul_le_of_le_one_right (sq_nonneg _) hδ
  have hd5 : |δ| ^ 5 ≤ δ ^ 2 := by
    rw [show |δ| ^ 5 = |δ| ^ 3 * |δ| ^ 2 by ring]
    exact (mul_le_of_le_one_right (by positivity) (by rw [sq_abs]; exact hsq)).trans hd3
  have hcb : |Real.cos δ - 1| ≤ δ ^ 2 := by
    have := abs_sub_le (Real.cos δ) (1 - δ ^ 2 / 2) 1
    have h2 : |1 - δ ^ 2 / 2 - 1| = δ ^ 2 / 2 := by
      rw [show 1 - δ ^ 2 / 2 - 1 = -(δ ^ 2 / 2) by ring, abs_neg, abs_of_nonneg (by positivity)]
    linarith [sq_nonneg δ]
  have hsb : |Real.sin δ - δ| ≤ δ ^ 2 := by
    have := abs_sub_le (Real.sin δ) (δ - δ ^ 3 / 6) δ
    have h2 : |δ - δ ^ 3 / 6 - δ| = |δ| ^ 3 / 6 := by
      rw [show δ - δ ^ 3 / 6 - δ = -(δ ^ 3 / 6) by ring, abs_neg, abs_div, abs_pow]; norm_num
    linarith [sq_nonneg δ, abs_nonneg δ]
  have hadd : ((t : Ang) + (δ : Ang)) = ((t + δ : ℝ) : Ang) := rfl
  have hu : u ((t : Ang) + (δ : Ang)) = aux_uR (t + δ) := by rw [hadd]; rfl
  have e1 : (u ((t : Ang) + (δ : Ang)) - u t - δ • v t) 0 =
      Real.cos t * (Real.cos δ - 1) - Real.sin t * (Real.sin δ - δ) := by
    rw [hu]
    simp [v, aux_uR, Real.cos_add]; ring
  have e2 : (u ((t : Ang) + (δ : Ang)) - u t - δ • v t) 1 =
      Real.sin t * (Real.cos δ - 1) + Real.cos t * (Real.sin δ - δ) := by
    rw [hu]
    simp [v, aux_uR, Real.sin_add]; ring
  have b0 : |Real.cos t * (Real.cos δ - 1) - Real.sin t * (Real.sin δ - δ)| ≤ 2 * δ ^ 2 := by
    refine (abs_sub _ _).trans ?_
    rw [abs_mul, abs_mul]
    nlinarith [Real.abs_cos_le_one t, Real.abs_sin_le_one t, abs_nonneg (Real.cos δ - 1),
      abs_nonneg (Real.sin δ - δ), abs_nonneg (Real.cos t), abs_nonneg (Real.sin t)]
  have b1 : |Real.sin t * (Real.cos δ - 1) + Real.cos t * (Real.sin δ - δ)| ≤ 2 * δ ^ 2 := by
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_mul]
    nlinarith [Real.abs_cos_le_one t, Real.abs_sin_le_one t, abs_nonneg (Real.cos δ - 1),
      abs_nonneg (Real.sin δ - δ), abs_nonneg (Real.cos t), abs_nonneg (Real.sin t)]
  set w := u ((t : Ang) + (δ : Ang)) - u t - δ • v t
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs, e1, e2]
  refine Real.sqrt_le_iff.2 ⟨by positivity, ?_⟩
  rw [sq_abs, sq_abs]
  nlinarith [abs_nonneg (Real.cos t * (Real.cos δ - 1) - Real.sin t * (Real.sin δ - δ)),
    sq_abs (Real.cos t * (Real.cos δ - 1) - Real.sin t * (Real.sin δ - δ)),
    sq_abs (Real.sin t * (Real.cos δ - 1) + Real.cos t * (Real.sin δ - δ)),
    abs_nonneg (Real.sin t * (Real.cos δ - 1) + Real.cos t * (Real.sin δ - δ))]

section Inv

variable {α β : ℝ} {Q : Set ℝ²} {C L : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
  {k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ} {h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ}

/-- Auxiliary (`ann:invariance`): the three-point limit evaluated at measurable shifts is
a.e. strongly measurable. -/
theorem aux_ann_h3_aesm (hlim : aux_IsCorrelationLimits α β L R f k h3)
    {S : ℝ² × Ang → Fin 3 → ℝ²} (hS : Measurable S) :
    AEStronglyMeasurable (fun p => h3 p (S p)) μinc := by
  set D3 := TopologicalSpace.denseSeq (Fin 3 → ℝ²)
  have hD3 : DenseRange D3 := TopologicalSpace.denseRange_denseSeq _
  set g : ℕ → ℝ² × Ang → ℂ := fun i => (hlim.meas_three (D3 i)).mk _
  have hg : ∀ᵐ p ∂μinc, ∀ i, h3 p (D3 i) = g i p :=
    ae_all_iff.2 fun i => (hlim.meas_three (D3 i)).ae_eq_mk
  refine aestronglyMeasurable_of_tendsto_ae atTop
    (f := fun m p => h3 p (D3 (aux_ann_idx D3 hD3 m (S p)))) (fun m => ?_) ?_
  · have hm : Measurable fun p => g (aux_ann_idx D3 hD3 m (S p)) p :=
      (measurable_from_prod_countable_left (f := fun q : (ℝ² × Ang) × ℕ => g q.2 q.1)
        fun i => (hlim.meas_three (D3 i)).stronglyMeasurable_mk.measurable).comp
        (measurable_id.prodMk ((aux_ann_idx_measurable D3 hD3 m).comp hS))
    refine hm.aestronglyMeasurable.congr ?_
    filter_upwards [hg] with p hp
    exact (hp _).symm
  · filter_upwards [hlim.cont_three] with p hp
    exact (hp.tendsto _).comp (aux_ann_idx_tendsto D3 hD3 (S p))

/-- Auxiliary (`ann:invariance`): translations of configuration space preserve `μ`. -/
theorem aux_ann_translate_mp (a : ℝ²) (b : Ang) :
    MeasurePreserving (fun q : ℝ² × Ang => (q.1 + a, q.2 + b)) μinc μinc := by
  unfold μinc σ
  exact (measurePreserving_add_right volume a).prod (measurePreserving_add_right _ b)

/-- Auxiliary: `|v_θ| = 1`. -/
theorem aux_ann_norm_v (θ : Ang) : ‖v θ‖ = 1 := by
  rw [← aux_ann_norm_u θ, v, EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
  simp [Fin.sum_univ_two, add_comm]

theorem aux_ann_v_continuous : Continuous v := J.continuous.comp aux_lw_u_continuous

/-- Auxiliary (`ann:invariance`, see `Auto.ann_invariance`): for fixed `s, h` and shifts `t`,
$h(p;t_0+s,t_1+s+hv_\theta,t_2+s+hMv_\theta)=h(p;t)$ for a.e. `p`, by translating the
configuration by $(s/R_n,h/R_n)$. -/
theorem aux_ann_shift_ae (hadm : IsAdmissibleSeq Q C R f)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (s : ℝ²) (h : ℝ) (t : Fin 3 → ℝ²) :
    (fun p => h3 p (fun j => t j + s + h • Lv α β j (v p.2))) =ᵐ[μinc] fun p => h3 p t := by
  set S : ℝ² × Ang → Fin 3 → ℝ² := fun p j => t j + s + h • Lv α β j (v p.2) with hSdef
  have hSc : ∀ j, Continuous fun p : ℝ² × Ang => S p j := fun j => by
    have := aux_ann_v_continuous
    simp only [hSdef]; fun_prop
  have hSm : Measurable S := Measurable.of_eval fun j => (hSc j).measurable
  have hvar := hlim.variable_shifts (fun j p => S p j) (fun j => (hSc j).measurable)
    ⟨∑ j, (‖t j‖ + ‖s‖ + |h| * ‖Lv α β j‖), fun j p => by
      refine le_trans ?_ (Finset.single_le_sum (f := fun j => ‖t j‖ + ‖s‖ + |h| * ‖Lv α β j‖)
        (fun j _ => by positivity) (Finset.mem_univ j))
      simp only [hSdef]
      refine (norm_add_le _ _).trans (add_le_add (norm_add_le _ _) ?_)
      rw [norm_smul, Real.norm_eq_abs]
      gcongr
      exact ((Lv α β j).le_opNorm _).trans (by rw [aux_ann_norm_v, mul_one])⟩
  have hmem1 : MemLp (fun p => h3 p (S p)) ⊤ μinc :=
    memLp_top_of_bound (aux_ann_h3_aesm hlim hSm) 1 (ae_of_all _ fun p => hlim.bound_three _ _)
  refine aux_ann_weakStar_unique hmem1 (aux_ann_h3_memLp hlim t) hvar (hlim.three_point t)
    fun ψ hψ => ?_
  -- notation
  set P : ℕ → ℝ² × Ang → ℂ := fun n p => ∏ j, annT R f j n (t j) (proj α β j p) with hP
  set F : ℕ → ℝ² × Ang → ℂ := fun n p => ∏ j, annT R f j n (S p j) (proj α β j p) with hF
  have hT : ∀ j n, Continuous fun q : ℝ² × ℝ² => annT R f j n q.1 q.2 := fun j n => by
    have hc := aux_ann_continuous hadm j n
    unfold annT; fun_prop
  have hPc : ∀ n, Continuous (P n) := fun n => continuous_finsetProd _ fun j _ =>
    (hT j n).comp (continuous_const.prodMk (aux_ann_proj_continuous α β j))
  have hFc : ∀ n, Continuous (F n) := fun n => continuous_finsetProd _ fun j _ =>
    (hT j n).comp ((hSc j).prodMk (aux_ann_proj_continuous α β j))
  have hPb : ∀ n p, ‖P n p‖ ≤ 1 := fun n p => by
    rw [hP, norm_prod]
    exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun j _ => aux_ann_annT_le_one hadm _ _ _ _
  have hFb : ∀ n p, ‖F n p‖ ≤ 1 := fun n p => by
    rw [hF, norm_prod]
    exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun j _ => aux_ann_annT_le_one hadm _ _ _ _
  set c : ℕ → ℝ² × Ang := fun n => ((R n)⁻¹ • s, ((h * (R n)⁻¹ : ℝ) : Ang)) with hc
  have hc0 : Tendsto c atTop (𝓝 0) := by
    have hR := tendsto_inv_atTop_zero.comp hadm.tendsto_R
    have h1 : Tendsto (fun n => (R n)⁻¹ • s) atTop (𝓝 0) := by simpa using hR.smul_const s
    have h2 : Tendsto (fun n => ((h * (R n)⁻¹ : ℝ) : Ang)) atTop (𝓝 0) := by
      have hcont : Continuous fun x : ℝ => (x : Ang) := continuous_quotient_mk'
      have h0 : Tendsto (fun n => h * (R n)⁻¹) atTop (𝓝 0) := by
        simpa using hR.const_mul h
      have := (hcont.tendsto 0).comp h0
      simpa [Function.comp_def] using this
    simpa [Prod.zero_eq_mk] using h1.prodMk_nhds h2
  -- the translation part
  have htrans : Tendsto (fun n => ∫ p, P n ((p.1 + (c n).1, p.2 + (c n).2)) * ψ p ∂μinc -
      ∫ p, P n p * ψ p ∂μinc) atTop (𝓝 0) := by
    have hψ1 : MemLp ψ 1 μinc := memLp_one_iff_integrable.2 hψ
    let T : C(ℝ² × Ang, C(ℝ² × Ang, ℝ² × Ang)) :=
      (ContinuousMap.mk (fun q : (ℝ² × Ang) × (ℝ² × Ang) => q.2 - q.1) (by fun_prop)).curry
    have hTr := aux_tendsto_eLpNorm_comp_sub
      (μ := (volume : Measure ℝ²).prod AddCircle.haarAddCircle) (a₀ := (0 : ℝ² × Ang)) T
      (by ext x <;> simp [T]) (fun a =>
        (measurePreserving_sub_right volume a.1).prod
          (measurePreserving_sub_right AddCircle.haarAddCircle a.2)) le_rfl ENNReal.one_ne_top hψ1
    have hTr' := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp (hTr.comp hc0)
    rw [ENNReal.toReal_zero] at hTr'
    refine squeeze_zero_norm (fun n => le_of_le_of_eq (b := (eLpNorm (fun x => ψ (x - c n) - ψ x)
      1 μinc).toReal) ?_ rfl) hTr'
    have hmpc : MeasurePreserving (fun q : ℝ² × Ang => q - c n) μinc μinc :=
      (measurePreserving_sub_right volume (c n).1).prod
        (measurePreserving_sub_right AddCircle.haarAddCircle (c n).2)
    have hψc : Integrable (fun q => ψ (q - c n)) μinc := hmpc.integrable_comp hψ.1 |>.2 hψ
    have hmp := aux_ann_translate_mp (c n).1 (c n).2
    have hemb : MeasurableEmbedding fun q : ℝ² × Ang => (q.1 + (c n).1, q.2 + (c n).2) :=
      (MeasurableEquiv.addRight (c n)).measurableEmbedding
    have e1 : ∫ p, P n ((p.1 + (c n).1, p.2 + (c n).2)) * ψ p ∂μinc =
        ∫ q, P n q * ψ (q - c n) ∂μinc := by
      rw [← hmp.integral_comp hemb (fun q => P n q * ψ (q - c n))]
      congr 1; funext p
      congr 2
      ext <;> simp
    rw [e1, ← integral_sub ((hψc).bdd_mul (hPc n).aestronglyMeasurable
        (ae_of_all _ (hPb n))) (hψ.bdd_mul (hPc n).aestronglyMeasurable (ae_of_all _ (hPb n))),
      eLpNorm_one_eq_lintegral_enorm (f := fun x => ψ (x - c n) - ψ x)
        ((hψc).sub hψ).aestronglyMeasurable]
    rw [← integral_norm_eq_lintegral_enorm (f := fun x => ψ (x - c n) - ψ x)
      ((hψc).sub hψ).aestronglyMeasurable]
    refine norm_integral_le_of_norm_le ((hψc).sub hψ).norm
      (ae_of_all _ fun q => ?_)
    rw [← mul_sub, norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (hPb n q)
  -- the Taylor part
  set K := ∑ j, ‖Lv α β j‖ with hK
  have hpt : ∀ᶠ n in atTop, ∀ p, ‖F n p - P n ((p.1 + (c n).1, p.2 + (c n).2))‖ ≤
      4 * |C| * h ^ 2 * K * (R n)⁻¹ := by
    filter_upwards [hadm.tendsto_R.eventually_gt_atTop (max 0 |h|)] with n hn p
    have hRpos : 0 < R n := lt_of_le_of_lt (le_max_left _ _) hn
    have hδ : |h * (R n)⁻¹| ≤ 1 := by
      rw [abs_mul, abs_inv, abs_of_pos hRpos, mul_inv_le_iff₀ hRpos, one_mul]
      exact (le_max_right _ _).trans hn.le
    refine (aux_ann_prod3_sub _ _ (fun j => aux_ann_annT_le_one hadm _ _ _ _)
      (fun j => aux_ann_annT_le_one hadm _ _ _ _)).trans ?_
    rw [hK, Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_le_sum fun j _ => ?_
    simp only [annT, hSdef, proj]
    refine (hadm.lip j n _ _).trans ?_
    have e : p.1 + Lv α β j (u p.2) + (R n)⁻¹ • (t j + s + h • Lv α β j (v p.2)) -
        (p.1 + (R n)⁻¹ • s + Lv α β j (u (p.2 + ((h * (R n)⁻¹ : ℝ) : Ang))) + (R n)⁻¹ • t j) =
        -(Lv α β j (u (p.2 + ((h * (R n)⁻¹ : ℝ) : Ang)) - u p.2 - (h * (R n)⁻¹) • v p.2)) := by
      simp only [map_sub, map_smul, smul_add, smul_smul]
      module
    rw [e, norm_neg]
    calc C * R n * ‖Lv α β j (u (p.2 + ((h * (R n)⁻¹ : ℝ) : Ang)) - u p.2 -
          (h * (R n)⁻¹) • v p.2)‖
        ≤ |C| * R n * (‖Lv α β j‖ * (4 * (h * (R n)⁻¹) ^ 2)) := by
          gcongr
          · exact le_abs_self C
          · exact ((Lv α β j).le_opNorm _).trans (by gcongr; exact aux_ann_u_taylor _ _ hδ)
      _ = 4 * |C| * h ^ 2 * ‖Lv α β j‖ * (R n)⁻¹ := by
          field_simp
  have hεt : Tendsto (fun n => 4 * |C| * h ^ 2 * K * (R n)⁻¹ * ∫ p, ‖ψ p‖ ∂μinc) atTop
      (𝓝 0) := by
    have := ((tendsto_inv_atTop_zero.comp hadm.tendsto_R).const_mul
      (4 * |C| * h ^ 2 * K)).mul_const (∫ p, ‖ψ p‖ ∂μinc)
    simpa using this
  have hdiff1 : Tendsto (fun n => ∫ p, F n p * ψ p ∂μinc -
      ∫ p, P n ((p.1 + (c n).1, p.2 + (c n).2)) * ψ p ∂μinc) atTop (𝓝 0) := by
    refine squeeze_zero_norm' ?_ hεt
    filter_upwards [hpt] with n hn
    have hPτ : Continuous fun p : ℝ² × Ang => P n ((p.1 + (c n).1, p.2 + (c n).2)) :=
      (hPc n).comp (by fun_prop)
    rw [← integral_sub (hψ.bdd_mul (hFc n).aestronglyMeasurable (ae_of_all _ (hFb n)))
      (hψ.bdd_mul hPτ.aestronglyMeasurable (ae_of_all _ fun p => hPb n _)), ← integral_const_mul]
    refine norm_integral_le_of_norm_le (hψ.norm.const_mul _) (ae_of_all _ fun p => ?_)
    rw [← sub_mul, norm_mul]
    exact mul_le_mul_of_nonneg_right (hn p) (norm_nonneg _)
  have := hdiff1.add htrans
  simp only [sub_add_sub_cancel, add_zero] at this
  exact this

end Inv

/-- Auxiliary (`ann:invariance`): `e_{s+t} = e_s e_t`. -/
theorem aux_ann_charE_add (s t ξ : ℝ²) : charE (s + t) ξ = charE s ξ * charE t ξ := by
  simp only [charE, e, inner_add_left, ← Complex.exp_add]
  congr 1; push_cast; ring

/-- Auxiliary (`ann:invariance`): `|e_s(ξ)| = 1`. -/
theorem aux_ann_norm_charE (s ξ : ℝ²) : ‖charE s ξ‖ = 1 := aux_ann_norm_e _

/-- Auxiliary (`ann:invariance`, see `Auto.ann_invariance`): the Fourier coefficients
`t ↦ ∫ g \overline{e_t} dν` of an integrable `g` depend continuously on `t`. -/
theorem aux_ann_char_integral_continuous (ν : Measure ℝ²) {g : ℝ² → ℂ} (hg : Integrable g ν) :
    Continuous fun t : ℝ² => ∫ ξ, g ξ * conj (charE t ξ) ∂ν := by
  have hc : ∀ ξ, Continuous fun t : ℝ² => conj (charE t ξ) := fun ξ =>
    Complex.continuous_conj.comp (aux_ann_continuous_e.comp (continuous_id.inner continuous_const))
  refine continuous_of_dominated (bound := fun ξ => ‖g ξ‖) (fun t => ?_) (fun t => ?_) hg.norm
    (Eventually.of_forall fun ξ => continuous_const.mul (hc ξ))
  · exact hg.1.mul (Complex.continuous_conj.comp (aux_ann_continuous_e.comp
      (continuous_const.inner continuous_id))).aestronglyMeasurable
  · exact Eventually.of_forall fun ξ => by
      rw [norm_mul, RCLike.norm_conj, aux_ann_norm_charE, mul_one]

/-- Auxiliary (`ann:invariance`, see `Auto.ann_invariance`): an integrable function on a finite
measure all of whose Fourier coefficients vanish is zero a.e. (Lemma `ext:fourier-uniqueness`,
`Auto.ext_fourier_uniqueness`). -/
theorem aux_ann_char_orth_zero (ν : Measure ℝ²) [IsFiniteMeasure ν] {g : ℝ² → ℂ}
    (hg : Integrable g ν) (h : ∀ t : ℝ², ∫ ξ, g ξ * conj (charE t ξ) ∂ν = 0) : g =ᵐ[ν] 0 := by
  let η : FCMeasure := FCMeasure.mk (Z := ℝ²) (m := ν) (w := g) (φ := id) measurable_id hg
  let ζ : FCMeasure := FCMeasure.ofMeasure 0
  have hζ : ∀ g : ℝ² → ℂ, ζ.integral g = 0 := fun g => by
    simp only [ζ, FCMeasure.integral, FCMeasure.ofMeasure]
    exact MeasureTheory.integral_zero_measure _
  have hfe : η.fourier = ζ.fourier := funext fun ξ => by
    rw [FCMeasure.fourier, FCMeasure.fourier, hζ, ← h ξ]
    unfold FCMeasure.integral
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only [η, id, charE, e]
    rw [mul_comm, ← Complex.exp_conj]
    congr 2
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat, real_inner_comm x ξ]
    push_cast; ring
  have hset : ∀ A, MeasurableSet A → ν A < ∞ → ∫ x in A, g x ∂ν = 0 := by
    intro A hA _
    have := ext_fourier_uniqueness η ζ hfe hA
    rw [hζ] at this
    rw [← this, ← integral_indicator hA]
    unfold FCMeasure.integral
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    by_cases hx : x ∈ A <;> simp [η, hx]
  exact hg.ae_eq_zero_of_forall_setIntegral_eq_zero hset

/-- Auxiliary (`ann:invariance`, see `Auto.ann_invariance`): the tensor characters
`e_s ⊗ e_t` span a dense subspace of `L²(ν₁ ⊗ ν₂)`, in the form: an integrable `H` orthogonal to
all of them vanishes a.e. (the Fubini argument in the proof of `ann:form`). -/
theorem aux_ann_char2_orth_zero (ν₁ ν₂ : Measure ℝ²) [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    {H : ℝ² × ℝ² → ℂ} (hH : Integrable H (ν₁.prod ν₂))
    (h : ∀ s t : ℝ², ∫ ξ, H ξ * conj (charE s ξ.1 * charE t ξ.2) ∂(ν₁.prod ν₂) = 0) :
    H =ᵐ[ν₁.prod ν₂] 0 := by
  have hHt : ∀ t : ℝ², Integrable (fun ξ : ℝ² × ℝ² => H ξ * conj (charE t ξ.2)) (ν₁.prod ν₂) :=
    fun t => hH.mul_bdd (c := 1) ((Complex.continuous_conj.comp (aux_ann_continuous_e.comp
      (continuous_const.inner continuous_snd))).aestronglyMeasurable)
      (ae_of_all _ fun ξ => by rw [RCLike.norm_conj, aux_ann_norm_charE])
  set g : ℝ² → ℝ² → ℂ := fun t x => ∫ y, H (x, y) * conj (charE t y) ∂ν₂ with hg
  have hgi : ∀ t, Integrable (g t) ν₁ := fun t => (hHt t).integral_prod_left
  have hg0 : ∀ t, g t =ᵐ[ν₁] 0 := by
    intro t
    refine aux_ann_char_orth_zero ν₁ (hgi t) fun s => ?_
    have hfi : Integrable (fun ξ : ℝ² × ℝ² => H ξ * conj (charE t ξ.2) * conj (charE s ξ.1))
        (ν₁.prod ν₂) :=
      (hHt t).mul_bdd (c := 1) ((Complex.continuous_conj.comp
        (aux_ann_continuous_e.comp (continuous_const.inner continuous_fst))).aestronglyMeasurable)
        (ae_of_all _ fun ξ => by
          change ‖conj (charE s ξ.1)‖ ≤ 1
          rw [RCLike.norm_conj, aux_ann_norm_charE])
    have := h s t
    rw [show (fun ξ : ℝ² × ℝ² => H ξ * conj (charE s ξ.1 * charE t ξ.2)) =
      fun ξ => H ξ * conj (charE t ξ.2) * conj (charE s ξ.1) from funext fun ξ => by
        rw [map_mul]; ring, integral_prod _ hfi] at this
    rw [← this]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp only [hg, ← integral_mul_const]
  set D := TopologicalSpace.denseSeq ℝ²
  have hD : DenseRange D := TopologicalSpace.denseRange_denseSeq _
  have hae : ∀ᵐ x ∂ν₁, ∀ i, g (D i) x = 0 := ae_all_iff.2 fun i => hg0 (D i)
  have hsec : ∀ᵐ x ∂ν₁, (fun y => H (x, y)) =ᵐ[ν₂] 0 := by
    filter_upwards [hae, hH.prod_right_ae] with x hx hxi
    refine aux_ann_char_orth_zero ν₂ hxi fun t => ?_
    have hcont := aux_ann_char_integral_continuous ν₂ hxi
    have := hcont.ext_on hD continuous_const (fun y ⟨i, hi⟩ => by
      rw [← hi]; exact hx i)
    exact congrFun this t
  have hl : ∫⁻ ξ, ‖H ξ‖ₑ ∂(ν₁.prod ν₂) = 0 := by
    rw [lintegral_prod _ hH.1.enorm]
    refine (lintegral_congr_ae ?_).trans (lintegral_zero)
    filter_upwards [hsec] with x hx
    refine (lintegral_congr_ae ?_).trans lintegral_zero
    filter_upwards [hx] with y hy
    simp [hy]
  filter_upwards [(lintegral_eq_zero_iff' hH.1.enorm).1 hl] with ξ hξ
  simpa using hξ

/-- Auxiliary (`ann:invariance`, see `Auto.ann_invariance`): a bounded linear functional on
`L²(μ)` (given as a raw map on square-integrable functions) that vanishes on a family `B` of
`L²` functions whose orthogonal complement is trivial vanishes identically (Riesz
representation). -/
theorem aux_ann_linear_unique {Y : Type*} [MeasurableSpace Y] {μ : Measure Y}
    (ψ : (Y → ℂ) → ℂ) (c : ℝ≥0∞) (hc : c ≠ ∞)
    (hadd : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → ψ (G + G') = ψ G + ψ G')
    (hsmul : ∀ (a : ℂ) G, MemLp G 2 μ → ψ (a • G) = a * ψ G)
    (hbd : ∀ G, MemLp G 2 μ → ‖ψ G‖ₑ ≤ c * eLpNorm G 2 μ)
    (B : Set (Y → ℂ)) (hBm : ∀ b ∈ B, MemLp b 2 μ) (hB0 : ∀ b ∈ B, ψ b = 0)
    (hcomp : ∀ H : Y → ℂ, MemLp H 2 μ → (∀ b ∈ B, ∫ y, H y * conj (b y) ∂μ = 0) → H =ᵐ[μ] 0)
    {G : Y → ℂ} (hG : MemLp G 2 μ) : ψ G = 0 := by
  have hae : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → G =ᵐ[μ] G' → ψ G = ψ G' := by
    intro G G' hG hG' hGG
    have e1 : G = G' + (G - G') := by funext y; simp
    have h0 : ψ (G - G') = 0 := by
      have := hbd _ (hG.sub hG')
      rw [eLpNorm_congr_ae (hGG.sub_eq.trans (ae_of_all _ fun y => rfl) :
        G - G' =ᵐ[μ] (0 : Y → ℂ)), eLpNorm_zero, mul_zero, nonpos_iff_eq_zero, enorm_eq_zero]
        at this
      exact this
    rw [e1, hadd _ _ hG' (hG.sub hG'), h0, add_zero]
  let φ : Lp ℂ 2 μ →ₗ[ℂ] ℂ :=
    { toFun := fun x => ψ x
      map_add' := fun x y => by
        rw [hae _ (⇑x + ⇑y) (Lp.memLp _) ((Lp.memLp x).add (Lp.memLp y)) (Lp.coeFn_add x y),
          hadd _ _ (Lp.memLp x) (Lp.memLp y)]
      map_smul' := fun a x => by
        rw [hae _ (a • ⇑x) (Lp.memLp _) ((Lp.memLp x).const_smul a) (Lp.coeFn_smul a x),
          hsmul _ _ (Lp.memLp x)]
        rfl }
  let φc : Lp ℂ 2 μ →L[ℂ] ℂ := φ.mkContinuous c.toReal fun x => by
    change ‖ψ x‖ ≤ c.toReal * ‖x‖
    rw [Lp.norm_def, ← ENNReal.toReal_mul, ← toReal_enorm]
    exact ENNReal.toReal_mono (ENNReal.mul_ne_top hc (Lp.eLpNorm_ne_top x)) (hbd _ (Lp.memLp x))
  have hφc : ∀ x : Lp ℂ 2 μ, φc x = ψ x := fun x => rfl
  set H := (InnerProductSpace.toDual ℂ (Lp ℂ 2 μ)).symm φc
  have hH : ∀ x : Lp ℂ 2 μ, ψ x = ⟪H, x⟫_ℂ := fun x => by
    rw [InnerProductSpace.toDual_symm_apply, hφc]
  have hH0 : H = 0 := by
    refine (Lp.eq_zero_iff_ae_eq_zero).2 (hcomp _ (Lp.memLp H) fun b hb => ?_)
    have h1 : ψ b = ⟪H, (hBm b hb).toLp b⟫_ℂ := by
      rw [← hH]; exact hae _ _ (hBm b hb) (Lp.memLp _) (hBm b hb).coeFn_toLp.symm
    rw [hB0 b hb, MeasureTheory.L2.inner_def] at h1
    have h2 : ∫ y, H y * conj (b y) ∂μ = conj (∫ y, ⟪H y, ((hBm b hb).toLp b) y⟫_ℂ ∂μ) := by
      rw [← integral_conj]
      refine integral_congr_ae ?_
      filter_upwards [(hBm b hb).coeFn_toLp] with y hy
      rw [hy, RCLike.inner_apply, map_mul, Complex.conj_conj, mul_comm]
    rw [h2, ← h1, map_zero]
  rw [hae G _ hG (Lp.memLp _) hG.coeFn_toLp.symm, hH, hH0, inner_zero_left]

/-- Auxiliary (`ann:invariance`, see `Auto.ann_invariance`): a bounded bilinear form on
`L²(μ) × L²(μ')` vanishing on `A × B`, where `A` and `B` have trivial orthogonal complements,
vanishes identically. -/
theorem aux_ann_bilinear_unique {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {μ : Measure X} {μ' : Measure Y} (D : (X → ℂ) → (Y → ℂ) → ℂ) (c : ℝ≥0∞) (hc : c ≠ ∞)
    (h1 : ∀ a a' G, MemLp a 2 μ → MemLp a' 2 μ → MemLp G 2 μ' → D (a + a') G = D a G + D a' G)
    (h2 : ∀ (z : ℂ) a G, MemLp a 2 μ → MemLp G 2 μ' → D (z • a) G = z * D a G)
    (h3 : ∀ a G G', MemLp a 2 μ → MemLp G 2 μ' → MemLp G' 2 μ' → D a (G + G') = D a G + D a G')
    (h4 : ∀ (z : ℂ) a G, MemLp a 2 μ → MemLp G 2 μ' → D a (z • G) = z * D a G)
    (h5 : ∀ a G, MemLp a 2 μ → MemLp G 2 μ' →
      ‖D a G‖ₑ ≤ c * eLpNorm a 2 μ * eLpNorm G 2 μ')
    (A : Set (X → ℂ)) (B : Set (Y → ℂ)) (hAm : ∀ a ∈ A, MemLp a 2 μ)
    (hBm : ∀ b ∈ B, MemLp b 2 μ')
    (hAc : ∀ H : X → ℂ, MemLp H 2 μ → (∀ b ∈ A, ∫ y, H y * conj (b y) ∂μ = 0) → H =ᵐ[μ] 0)
    (hBc : ∀ H : Y → ℂ, MemLp H 2 μ' → (∀ b ∈ B, ∫ y, H y * conj (b y) ∂μ' = 0) → H =ᵐ[μ'] 0)
    (h0 : ∀ a ∈ A, ∀ b ∈ B, D a b = 0) {a : X → ℂ} {G : Y → ℂ} (ha : MemLp a 2 μ)
    (hG : MemLp G 2 μ') : D a G = 0 := by
  have hB : ∀ b ∈ B, ∀ a, MemLp a 2 μ → D a b = 0 := fun b hb a ha =>
    aux_ann_linear_unique (fun a => D a b) (c * eLpNorm b 2 μ')
      (ENNReal.mul_ne_top hc (hBm b hb).eLpNorm_ne_top)
      (fun a a' ha ha' => h1 a a' b ha ha' (hBm b hb)) (fun z a ha => h2 z a b ha (hBm b hb))
      (fun a ha => (h5 a b ha (hBm b hb)).trans_eq (by ring)) A hAm
      (fun a' ha' => h0 a' ha' b hb) hAc ha
  exact aux_ann_linear_unique (D a) (c * eLpNorm a 2 μ)
    (ENNReal.mul_ne_top hc ha.eLpNorm_ne_top) (fun G G' hG hG' => h3 a G G' ha hG hG')
    (fun z G hG => h4 z a G ha hG) (fun G hG => h5 a G ha hG) B hBm
    (fun b hb => hB b hb a ha) hBc hG

section Inv2

variable {α β : ℝ} {Q : Set ℝ²} {C L : ℝ} {R : ℕ → ℝ} {f : Fin 3 → ℕ → ℝ² → ℂ}
  {k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ} {h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ}

/-- Auxiliary (`ann:invariance`, see `Auto.ann_invariance`): outside one null set,
$h(p;t_0+s,t_1+s+hv_\theta,t_2+s+hMv_\theta)=h(p;t)$ for all real `s, h, t` (countable dense
parameters and continuity in the shifts). -/
theorem aux_ann_shift_all (hadm : IsAdmissibleSeq Q C R f)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) :
    ∀ᵐ p ∂μinc, ∀ (s : ℝ²) (h : ℝ) (t : Fin 3 → ℝ²),
      h3 p (fun j => t j + s + h • Lv α β j (v p.2)) = h3 p t := by
  set D := TopologicalSpace.denseSeq (ℝ² × ℝ × (Fin 3 → ℝ²))
  have hD : DenseRange D := TopologicalSpace.denseRange_denseSeq _
  have hae : ∀ᵐ p ∂μinc, ∀ i, h3 p (fun j => (D i).2.2 j + (D i).1 + (D i).2.1 •
      Lv α β j (v p.2)) = h3 p (D i).2.2 :=
    ae_all_iff.2 fun i => aux_ann_shift_ae hadm hlim (D i).1 (D i).2.1 (D i).2.2
  filter_upwards [hae, hlim.cont_three] with p hp hc s h t
  have := hc.comp (continuous_pi fun j => by fun_prop :
      Continuous fun x : ℝ² × ℝ × (Fin 3 → ℝ²) => fun j => x.2.2 j + x.1 + x.2.1 •
        Lv α β j (v p.2))
  have h2 := this.ext_on hD (hc.comp (continuous_snd.comp continuous_snd))
    (fun x ⟨i, hi⟩ => by rw [← hi]; exact hp i)
  exact congrFun h2 (s, h, t)

end Inv2

/-- **Lemma `ann:invariance`** (Infinitesimal translation and rotation invariance).
Outside a fixed null set of configurations, for every $s\in\mathbb R^2$, $h\in\mathbb R$,
$a\in L^2(\nu_0)$, and $G\in L^2(\nu_1\otimes\nu_2)$,
$$\ell_p(a,G)=\ell_p\bigl(e_sa,(e_{s+hv_\theta}\otimes e_{s+hMv_\theta})G\bigr).\qquad
(\text{ann:inv})$$
(In Lean the blueprint hypotheses `(hβ : β ≠ 0)`, `(hQ : Bornology.IsBounded Q)` are omitted since
the proof does not need them; see `automation/ErrorReport.md`.) -/
theorem ann_invariance (α β : ℝ) (Q : Set ℝ²)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ)
    (hℓ : aux_IsLimitForm α β R f ν h3 ℓ) :
    ∀ᵐ p ∂μinc, ∀ (s : ℝ²) (h : ℝ) (a : ℝ² → ℂ) (G : ℝ² × ℝ² → ℂ),
      MemLp a 2 (ν 0 (proj α β 0 p)) →
      MemLp G 2 ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) →
      ℓ p a G = ℓ p (fun ξ => charE s ξ * a ξ)
        (fun ξ => charE (s + h • v p.2) ξ.1 * charE (s + h • M α β (v p.2)) ξ.2 * G ξ) := by
  filter_upwards [hℓ.1, hℓ.2.2, aux_ann_shift_all hadm hlim] with p hB hch hsh s h a G ha hG
  have hfin : ∀ j z, IsFiniteMeasure (ν j z) := fun j => (hν.1 j).1
  set μ₀ := ν 0 (proj α β 0 p)
  set μ₁₂ := (ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))
  set m : ℝ² × ℝ² → ℂ := fun ξ => charE (s + h • v p.2) ξ.1 * charE (s + h • M α β (v p.2)) ξ.2
    with hm
  have hmc : Continuous m := by
    have := aux_ann_continuous_e
    simp only [hm, charE]; fun_prop
  have hm1 : ∀ ξ, ‖m ξ‖ = 1 := fun ξ => by
    simp only [hm, norm_mul, aux_ann_norm_charE, mul_one]
  have hsc : Continuous (charE s) :=
    aux_ann_continuous_e.comp (continuous_const.inner continuous_id)
  -- the multiplier maps
  have hmA : ∀ a : ℝ² → ℂ, MemLp a 2 μ₀ → MemLp (fun ξ => charE s ξ * a ξ) 2 μ₀ ∧
      eLpNorm (fun ξ => charE s ξ * a ξ) 2 μ₀ = eLpNorm a 2 μ₀ := fun a ha =>
    ⟨ha.congr_norm (hsc.aestronglyMeasurable.mul ha.aestronglyMeasurable)
      (ae_of_all _ fun ξ => by rw [norm_mul, aux_ann_norm_charE, one_mul]),
     eLpNorm_congr_norm_ae (hsc.aestronglyMeasurable.mul ha.aestronglyMeasurable)
       ha.aestronglyMeasurable
       (ae_of_all _ fun ξ => by rw [norm_mul, aux_ann_norm_charE, one_mul])⟩
  have hmG : ∀ G : ℝ² × ℝ² → ℂ, MemLp G 2 μ₁₂ → MemLp (fun ξ => m ξ * G ξ) 2 μ₁₂ ∧
      eLpNorm (fun ξ => m ξ * G ξ) 2 μ₁₂ = eLpNorm G 2 μ₁₂ := fun G hG =>
    ⟨hG.congr_norm (hmc.aestronglyMeasurable.mul hG.aestronglyMeasurable)
      (ae_of_all _ fun ξ => by rw [norm_mul, hm1, one_mul]),
     eLpNorm_congr_norm_ae (hmc.aestronglyMeasurable.mul hG.aestronglyMeasurable)
       hG.aestronglyMeasurable (ae_of_all _ fun ξ => by rw [norm_mul, hm1, one_mul])⟩
  set D : (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ := fun a G =>
    ℓ p a G - ℓ p (fun ξ => charE s ξ * a ξ) (fun ξ => m ξ * G ξ) with hD
  suffices hD0 : D a G = 0 by
    rw [hD, sub_eq_zero] at hD0
    exact hD0
  obtain ⟨b1, b2, b3, b4, b5⟩ := hB
  refine aux_ann_bilinear_unique D 2 ENNReal.ofNat_ne_top (fun a a' G ha ha' hG => ?_)
    (fun z a G ha hG => ?_) (fun a G G' ha hG hG' => ?_) (fun z a G ha hG => ?_)
    (fun a G ha hG => ?_) (Set.range charE)
    (Set.range fun st : ℝ² × ℝ² => fun ξ : ℝ² × ℝ² => charE st.1 ξ.1 * charE st.2 ξ.2)
    ?_ ?_ ?_ ?_ ?_ ha hG
  · simp only [hD]
    rw [b1 _ _ _ ha ha' hG, show (fun ξ => charE s ξ * (a + a') ξ) =
      (fun ξ => charE s ξ * a ξ) + (fun ξ => charE s ξ * a' ξ) from funext fun ξ => by
        simp only [Pi.add_apply]; ring,
      b1 _ _ _ (hmA a ha).1 (hmA a' ha').1 (hmG G hG).1]
    ring
  · simp only [hD]
    rw [b2 _ _ _ ha hG, show (fun ξ => charE s ξ * (z • a) ξ) =
      z • (fun ξ => charE s ξ * a ξ) from funext fun ξ => by
        simp only [Pi.smul_apply, smul_eq_mul]; ring,
      b2 _ _ _ (hmA a ha).1 (hmG G hG).1]
    ring
  · simp only [hD]
    rw [b3 _ _ _ ha hG hG', show (fun ξ => m ξ * (G + G') ξ) =
      (fun ξ => m ξ * G ξ) + (fun ξ => m ξ * G' ξ) from funext fun ξ => by
        simp only [Pi.add_apply]; ring,
      b3 _ _ _ (hmA a ha).1 (hmG G hG).1 (hmG G' hG').1]
    ring
  · simp only [hD]
    rw [b4 _ _ _ ha hG, show (fun ξ => m ξ * (z • G) ξ) =
      z • (fun ξ => m ξ * G ξ) from funext fun ξ => by
        simp only [Pi.smul_apply, smul_eq_mul]; ring,
      b4 _ _ _ (hmA a ha).1 (hmG G hG).1]
    ring
  · simp only [hD]
    refine (enorm_sub_le).trans ?_
    have e1 := b5 _ _ ha hG
    have e2 := b5 _ _ (hmA a ha).1 (hmG G hG).1
    rw [(hmA a ha).2, (hmG G hG).2] at e2
    calc _ ≤ eLpNorm a 2 μ₀ * eLpNorm G 2 μ₁₂ + eLpNorm a 2 μ₀ * eLpNorm G 2 μ₁₂ :=
          add_le_add e1 e2
      _ = _ := by rw [two_mul, add_mul]
  · rintro _ ⟨t, rfl⟩
    exact aux_ann_memLp_two_of_le (aux_ann_charE_meas t) (aux_ann_charE_le t)
  · rintro _ ⟨st, rfl⟩
    exact aux_ann_memLp_two_of_le (aux_ann_charE2_meas st.1 st.2) (aux_ann_charE2_le st.1 st.2)
  · intro H hH hH0
    exact aux_ann_char_orth_zero μ₀ (hH.integrable one_le_two) fun t => hH0 _ ⟨t, rfl⟩
  · intro H hH hH0
    exact aux_ann_char2_orth_zero _ _ (hH.integrable one_le_two) fun s t =>
      hH0 _ ⟨(s, t), rfl⟩
  · rintro _ ⟨t0, rfl⟩ _ ⟨st, rfl⟩
    set t : Fin 3 → ℝ² := ![t0, st.1, st.2]
    have hLv1 : ∀ x, Lv α β 1 x = x := fun x => by simp [Lv]
    have hLv2 : ∀ x, Lv α β 2 x = M α β x := fun x => by simp [Lv]
    have hLv0 : ∀ x, Lv α β 0 x = 0 := fun x => by simp [Lv]
    have e1 := hch t
    have e2 := hch fun j => t j + s + h • Lv α β j (v p.2)
    rw [hsh] at e2
    simp only [hD, sub_eq_zero]
    have ht0 : t 0 = t0 := rfl
    have ht1 : t 1 = st.1 := rfl
    have ht2 : t 2 = st.2 := rfl
    simp only [hLv0, hLv1, hLv2, ht0, ht1, ht2, smul_zero, add_zero] at e1 e2
    rw [e1, ← e2]
    congr 1
    · funext ξ; rw [aux_ann_charE_add, mul_comm]
    · funext ξ
      simp only [hm, aux_ann_charE_add]
      ring

/-! ### Atoms of one-dimensional projections (`ann:fibers`) -/

/-- The hyperplane (`ann:hyperplane`, in `\label{ann:fibers}`)
$$H_p=\{(\xi_1,\xi_2):v_\theta\cdot\xi_1+Mv_\theta\cdot\xi_2=0\}.$$ -/
def annH (α β : ℝ) (θ : Ang) : Set (ℝ² × ℝ²) :=
  {ξ | ⟪v θ, ξ.1⟫_ℝ + ⟪M α β (v θ), ξ.2⟫_ℝ = 0}

/-! ### Auxiliary material for `ann:fibers` -/

section AnnFibersAux

open ProbabilityTheory

/-- Auxiliary (`ann:fibers`): `⟪v_θ, w⟫` in coordinates. -/
theorem aux_ann_inner_v (t : ℝ) (w : ℝ²) :
    ⟪v (t : Ang), w⟫_ℝ = -Real.sin t * w 0 + Real.cos t * w 1 := by
  simp [v, aux_uR, PiLp.inner_apply, Fin.sum_univ_two]
  ring

/-- Auxiliary (`ann:fibers`, see `Auto.ann_fibers`): for `w ≠ 0` the angles with
$v_\theta\cdot w=0$ form a `σ`-null set. -/
theorem aux_ann_angle_null (w : ℝ²) (hw : w ≠ 0) : σ {θ | ⟪v θ, w⟫_ℝ = 0} = 0 := by
  by_contra hpos
  set G : ℝ² × AddCircle (2 * π) → ℝ := fun p => ⟪v p.2, w⟫_ℝ
  have hG : AnalyticOnNhd ℝ (fun p : ℝ² × ℝ => G (p.1, (p.2 : AddCircle (2 * π)))) univ := by
    have e : (fun p : ℝ² × ℝ => G (p.1, (p.2 : AddCircle (2 * π)))) =
        fun p => -Real.sin p.2 * w 0 + Real.cos p.2 * w 1 := by
      funext p; exact aux_ann_inner_v p.2 w
    rw [e]
    intro p _
    exact ((Real.analyticAt_sin.comp analyticAt_snd).neg.mul analyticAt_const).add
      ((Real.analyticAt_cos.comp analyticAt_snd).mul analyticAt_const)
  have hset : {p : ℝ² × AddCircle (2 * π) | G p = 0} = univ ×ˢ {θ | ⟪v θ, w⟫_ℝ = 0} := by
    ext p; simp [G]
  have hmeas : 0 < ((volume : Measure ℝ²).prod AddCircle.haarAddCircle)
      {p : ℝ² × AddCircle (2 * π) | G p = 0} := by
    rw [hset, Measure.prod_prod]
    refine ENNReal.mul_pos (by simp) ?_
    exact hpos
  have h0 := ext_analytic_zero_config hG hmeas
  have h1 := h0 (0, ((0 : ℝ) : AddCircle (2 * π)))
  have h2 := h0 (0, ((π / 2 : ℝ) : AddCircle (2 * π)))
  simp only [G, aux_ann_inner_v] at h1 h2
  simp at h1 h2
  apply hw
  ext i; fin_cases i
  · simpa using h2
  · simpa using h1

/-- Auxiliary (`ann:fibers`): a finite measure whose square gives no mass off the diagonal is
concentrated at a point. -/
theorem aux_ann_point_of_offdiag (μ : Measure ℝ²) [IsFiniteMeasure μ] (hμ : μ ≠ 0)
    (h : (μ.prod μ) (Set.diagonal ℝ²)ᶜ = 0) : ∃ ξ₀, μ {ξ₀}ᶜ = 0 := by
  have hm : MeasurableSet (Set.diagonal ℝ²)ᶜ := measurableSet_diagonal.compl
  rw [Measure.prod_apply hm] at h
  have hpre : ∀ ξ : ℝ², Prod.mk ξ ⁻¹' (Set.diagonal ℝ²)ᶜ = {ξ}ᶜ := fun ξ => by
    ext ξ'; simp [Set.diagonal, eq_comm]
  have h0 := (lintegral_eq_zero_iff (measurable_measure_prodMk_left hm)).1 h
  have : (ae μ).NeBot := ae_neBot.2 hμ
  obtain ⟨ξ₀, hξ⟩ := h0.exists
  exact ⟨ξ₀, by simpa [hpre] using hξ⟩

/-- Auxiliary (`ann:fibers`): for invertible `N` and `w ≠ 0`, the angles with
$(Nv_\theta)\cdot w=0$ form a `σ`-null set. -/
theorem aux_ann_angle_null_N (N : ℝ² →L[ℝ] ℝ²) (hN : IsUnit N) (w : ℝ²) (hw : w ≠ 0) :
    σ {θ | ⟪N (v θ), w⟫_ℝ = 0} = 0 := by
  have hadj : ContinuousLinearMap.adjoint N w ≠ 0 := by
    intro h0
    obtain ⟨U, rfl⟩ := hN
    have h1 : ⟪(U : ℝ² →L[ℝ] ℝ²) ((↑U⁻¹ : ℝ² →L[ℝ] ℝ²) w), w⟫_ℝ = 0 := by
      rw [← ContinuousLinearMap.adjoint_inner_right, h0, inner_zero_right]
    have h2 : (U : ℝ² →L[ℝ] ℝ²) ((↑U⁻¹ : ℝ² →L[ℝ] ℝ²) w) = w := by
      change ((U : ℝ² →L[ℝ] ℝ²) * ↑U⁻¹) w = w
      rw [Units.mul_inv]; rfl
    rw [h2, real_inner_self_eq_norm_sq] at h1
    exact hw (norm_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 h1))
  have := aux_ann_angle_null _ hadj
  convert this using 3
  ext θ
  simp [ContinuousLinearMap.adjoint_inner_right]

end AnnFibersAux

/-- **Lemma `ann:fibers`** (first assertion).
Let $z\mapsto\nu_z$ be a measurable kernel of finite positive measures on $\mathbb R^2$, of mass
at most one, and let $N$ be invertible.  For almost every $(z,\theta)$, every positive-mass fiber
of $$\xi\longmapsto (Nv_\theta)\cdot\xi$$ is concentrated at a single point atom of $\nu_z$.
Consequently, for almost every configuration $p$, the restriction of $\nu_1\otimes\nu_2$ to
$$H_p=\{(\xi_1,\xi_2):v_\theta\cdot\xi_1+Mv_\theta\cdot\xi_2=0\}$$
is concentrated on countably many pairs of point atoms.
(In Lean the blueprint hypothesis `(hν1 : ∀ z, ν z univ ≤ 1)` is omitted since the proof does not
need it; see `automation/ErrorReport.md`.) -/
theorem ann_fibers (ν : ℝ² → Measure ℝ²) (hν : IsMeasurableKernel ν)
    (N : ℝ² →L[ℝ] ℝ²) (hN : IsUnit N) :
    ∀ᵐ q ∂μinc, ∀ t : ℝ, 0 < ν q.1 {ξ | ⟪N (v q.2), ξ⟫_ℝ = t} →
      ∃ ξ₀ : ℝ², ν q.1 ({ξ | ⟪N (v q.2), ξ⟫_ℝ = t} \ {ξ₀}) = 0 := by
  have hfin := hν.1
  have hprod := ext_kernel_integration_prod hν hν
  have : ProbabilityTheory.IsSFiniteKernel (aux_toKernel hprod) :=
    aux_toKernel_isSFiniteKernel hprod
  set κ : ProbabilityTheory.Kernel (ℝ² × Ang) (ℝ² × ℝ²) :=
    (aux_toKernel hprod).comap Prod.fst measurable_fst
  have hκ : ∀ q, κ q = (ν q.1).prod (ν q.1) := fun q => rfl
  have hvc : Continuous v := J.continuous.comp aux_lw_u_continuous
  set W : Set ((ℝ² × Ang) × (ℝ² × ℝ²)) :=
    {x | x.2.1 ≠ x.2.2 ∧ ⟪N (v x.1.2), x.2.1 - x.2.2⟫_ℝ = 0} with hW
  have hWm : MeasurableSet W := by
    refine (measurableSet_eq_fun measurable_snd.fst measurable_snd.snd).compl.inter ?_
    exact (isClosed_eq (by fun_prop) continuous_const).measurableSet
  have hmq : Measurable fun q => κ q (Prod.mk q ⁻¹' W) :=
    ProbabilityTheory.Kernel.measurable_kernel_prodMk_left hWm
  set W' : Set (Ang × (ℝ² × ℝ²)) :=
    {x | x.2.1 ≠ x.2.2 ∧ ⟪N (v x.1), x.2.1 - x.2.2⟫_ℝ = 0} with hW'
  have hW'm : MeasurableSet W' := by
    refine (measurableSet_eq_fun measurable_snd.fst measurable_snd.snd).compl.inter ?_
    exact (isClosed_eq (by fun_prop) continuous_const).measurableSet
  have hin : ∀ z, ∫⁻ θ, κ (z, θ) (Prod.mk (z, θ) ⁻¹' W) ∂σ = 0 := by
    intro z
    have e : ∀ θ, κ (z, θ) (Prod.mk (z, θ) ⁻¹' W) = ((ν z).prod (ν z)) (Prod.mk θ ⁻¹' W') :=
      fun θ => by rw [hκ]; rfl
    simp_rw [e]
    rw [← Measure.prod_apply hW'm, Measure.prod_apply_symm hW'm]
    refine (lintegral_congr fun y => ?_).trans lintegral_zero
    by_cases hy : y.1 = y.2
    · have : (fun x => (x, y)) ⁻¹' W' = ∅ := by
        ext θ; simp [hW', hy]
      rw [this, measure_empty]
    · refine measure_mono_null (fun θ hθ => ?_)
        (aux_ann_angle_null_N N hN (y.1 - y.2) (sub_ne_zero.2 hy))
      exact hθ.2
  have hzero : ∫⁻ q, κ q (Prod.mk q ⁻¹' W) ∂μinc = 0 := by
    rw [μinc, lintegral_prod _ hmq.aemeasurable]
    simp [hin]
  have hae := (lintegral_eq_zero_iff hmq).1 hzero
  filter_upwards [hae] with q hq t ht
  set F := {ξ : ℝ² | ⟪N (v q.2), ξ⟫_ℝ = t} with hF
  have hFm : MeasurableSet F := (isClosed_eq (by fun_prop) continuous_const).measurableSet
  have hne : (ν q.1).restrict F ≠ 0 := by
    intro h0
    have := congrArg (fun μ : Measure ℝ² => μ univ) h0
    simp only [Measure.restrict_apply_univ, Measure.coe_zero, Pi.zero_apply] at this
    exact ht.ne' this
  obtain ⟨ξ₀, hξ⟩ := aux_ann_point_of_offdiag ((ν q.1).restrict F) hne (by
    rw [Measure.prod_restrict, Measure.restrict_apply measurableSet_diagonal.compl]
    refine measure_mono_null (fun x hx => ?_) hq
    simp only [mem_inter_iff, mem_compl_iff, Set.mem_diagonal_iff, mem_prod] at hx
    refine ⟨hx.1, ?_⟩
    rw [inner_sub_right, hx.2.1, hx.2.2, sub_self])
  refine ⟨ξ₀, ?_⟩
  rw [Measure.restrict_apply (measurableSet_singleton ξ₀).compl] at hξ
  rwa [sdiff_eq, inter_comm]

/-- Auxiliary: the triangle matrix is invertible when `β ≠ 0`. -/
theorem aux_ann_M_isUnit (α β : ℝ) (hβ : β ≠ 0) : IsUnit (M α β) := by
  have hd : α ^ 2 + β ^ 2 ≠ 0 := by positivity
  set Mi : ℝ² →L[ℝ] ℝ² := (α ^ 2 + β ^ 2)⁻¹ • simil α (-β)
  refine ⟨⟨M α β, Mi, ?_, ?_⟩, rfl⟩ <;>
  · ext x i
    fin_cases i <;> simp [Mi, simil] <;> field_simp <;> ring

/-- Auxiliary: a finite measure has positive mass on at most countably many level sets of a
measurable real function. -/
theorem aux_ann_countable_levels (μ : Measure ℝ²) [IsFiniteMeasure μ] {g : ℝ² → ℝ}
    (hg : Measurable g) : Set.Countable {t : ℝ | 0 < μ {ξ | g ξ = t}} :=
  Measure.countable_meas_pos_of_disjoint_iUnion (As := fun t => {ξ | g ξ = t})
    (fun t => hg (measurableSet_singleton t))
    (fun _ _ htt' => Set.disjoint_left.2 fun _ h1 h2 => htt' (h1.symm.trans h2))

/-- Auxiliary: a finite measure has at most countably many atoms. -/
theorem aux_ann_countable_atoms (μ : Measure ℝ²) [IsFiniteMeasure μ] :
    Set.Countable {x : ℝ² | 0 < μ {x}} :=
  Measure.countable_meas_pos_of_disjoint_iUnion (As := fun x : ℝ² => {x})
    (fun x => measurableSet_singleton x)
    (fun _ _ h => Set.disjoint_singleton.2 h)

/-- **Lemma `ann:fibers`** (consequence for the hyperplane $H_p$; stated for two measurable
kernels $\nu_1,\nu_2$ of mass at most one, with $\nu_j=\nu_{j,\pi_jp}$).
Let $z\mapsto\nu_z$ be a measurable kernel of finite positive measures on $\mathbb R^2$, of mass
at most one, and let $N$ be invertible.  For almost every $(z,\theta)$, every positive-mass fiber
of $$\xi\longmapsto (Nv_\theta)\cdot\xi$$ is concentrated at a single point atom of $\nu_z$.
Consequently, for almost every configuration $p$, the restriction of $\nu_1\otimes\nu_2$ to
$$H_p=\{(\xi_1,\xi_2):v_\theta\cdot\xi_1+Mv_\theta\cdot\xi_2=0\}$$
is concentrated on countably many pairs of point atoms.
(In Lean the blueprint hypotheses `(hν₁1 : ∀ z, ν₁ z univ ≤ 1)`, `(hν₂1 : ∀ z, ν₂ z univ ≤ 1)` are
omitted since the proof does not need them; see `automation/ErrorReport.md`.) -/
theorem ann_fibers_hyperplane (α β : ℝ) (hβ : β ≠ 0) (ν₁ ν₂ : ℝ² → Measure ℝ²)
    (hν₁ : IsMeasurableKernel ν₁) (hν₂ : IsMeasurableKernel ν₂) :
    ∀ᵐ p ∂μinc, ∃ S : Set (ℝ² × ℝ²), S.Countable ∧ S ⊆ annH α β p.2 ∧
      (∀ ξ ∈ S, 0 < ν₁ (proj α β 1 p) {ξ.1} ∧ 0 < ν₂ (proj α β 2 p) {ξ.2}) ∧
      ((ν₁ (proj α β 1 p)).prod (ν₂ (proj α β 2 p))) (annH α β p.2 \ S) = 0 := by
  have hf1 := (lem_geometry_measurePreserving α β 1).quasiMeasurePreserving.ae
    (ann_fibers ν₁ hν₁ (ContinuousLinearMap.id ℝ ℝ²) isUnit_one)
  have hf2 := (lem_geometry_measurePreserving α β 2).quasiMeasurePreserving.ae
    (ann_fibers ν₂ hν₂ (M α β) (aux_ann_M_isUnit α β hβ))
  filter_upwards [hf1, hf2] with p hp1 hp2
  simp only [ContinuousLinearMap.id_apply] at hp1 hp2
  have := hν₁.1 (proj α β 1 p)
  have := hν₂.1 (proj α β 2 p)
  set μ₁ := ν₁ (proj α β 1 p)
  set μ₂ := ν₂ (proj α β 2 p)
  set θ := p.2
  set a : ℝ² → ℝ := fun ξ => ⟪v θ, ξ⟫_ℝ with ha
  set b : ℝ² → ℝ := fun ξ => ⟪M α β (v θ), ξ⟫_ℝ with hb
  have hac : Continuous a := by fun_prop
  have hbc : Continuous b := by fun_prop
  set H := annH α β θ with hH
  have hHe : H = {ξ | a ξ.1 + b ξ.2 = 0} := rfl
  have hHm : MeasurableSet H := by
    rw [hHe]; exact (isClosed_eq (by fun_prop) continuous_const).measurableSet
  set S := {ξ ∈ H | 0 < μ₁ {ξ.1} ∧ 0 < μ₂ {ξ.2}} with hS
  set T₁ := {t : ℝ | 0 < μ₁ {ξ | a ξ = t}}
  set T₂ := {t : ℝ | 0 < μ₂ {ξ | b ξ = t}}
  have hT₁ : T₁.Countable := aux_ann_countable_levels μ₁ hac.measurable
  have hT₂ : T₂.Countable := aux_ann_countable_levels μ₂ hbc.measurable
  have hx1 : ∀ t ∈ T₁, ∃ x, μ₁ ({ξ | a ξ = t} \ {x}) = 0 := fun t ht => hp1 t ht
  have hx2 : ∀ t ∈ T₂, ∃ x, μ₂ ({ξ | b ξ = t} \ {x}) = 0 := fun t ht => hp2 t ht
  choose! x₁ hx₁ using hx1
  choose! x₂ hx₂ using hx2
  have hatom1 : ∀ t ∈ T₁, 0 < μ₁ {x₁ t} := by
    intro t ht
    by_contra h0
    rw [not_lt, nonpos_iff_eq_zero] at h0
    have : μ₁ {ξ | a ξ = t} = 0 := measure_mono_null (fun ξ hξ => by
      by_cases hx : ξ = x₁ t
      · exact Or.inr hx
      · exact Or.inl ⟨hξ, hx⟩) (measure_union_null (hx₁ t ht) h0)
    exact (ne_of_gt ht) this
  have hatom2 : ∀ t ∈ T₂, 0 < μ₂ {x₂ t} := by
    intro t ht
    by_contra h0
    rw [not_lt, nonpos_iff_eq_zero] at h0
    have : μ₂ {ξ | b ξ = t} = 0 := measure_mono_null (fun ξ hξ => by
      by_cases hx : ξ = x₂ t
      · exact Or.inr hx
      · exact Or.inl ⟨hξ, hx⟩) (measure_union_null (hx₂ t ht) h0)
    exact (ne_of_gt ht) this
  refine ⟨S, ?_, fun ξ hξ => hξ.1, fun ξ hξ => hξ.2, ?_⟩
  · refine Set.Countable.mono (fun ξ hξ => ?_)
      ((aux_ann_countable_atoms μ₁).prod (aux_ann_countable_atoms μ₂))
    exact Set.mem_prod.2 ⟨hξ.2.1, hξ.2.2⟩
  -- the null pieces
  set N₁ := {ξ : ℝ² × ℝ² | a ξ.1 + b ξ.2 = 0 ∧ a ξ.1 ∉ T₁}
  set N₂ := {ξ : ℝ² × ℝ² | a ξ.1 + b ξ.2 = 0 ∧ b ξ.2 ∉ T₂}
  have hN₁m : MeasurableSet N₁ :=
    (isClosed_eq (by fun_prop) continuous_const).measurableSet.inter
      ((hac.measurable.comp measurable_fst) hT₁.measurableSet.compl)
  have hN₂m : MeasurableSet N₂ :=
    (isClosed_eq (by fun_prop) continuous_const).measurableSet.inter
      ((hbc.measurable.comp measurable_snd) hT₂.measurableSet.compl)
  have hN₁ : (μ₁.prod μ₂) N₁ = 0 := by
    rw [Measure.prod_apply_symm hN₁m]
    refine (lintegral_congr fun y => ?_).trans lintegral_zero
    by_cases hy : -b y ∈ T₁
    · refine measure_mono_null (fun x hx => ?_) measure_empty
      exact hx.2 (by rw [show a x = -b y by linarith [hx.1]]; exact hy)
    · refine measure_mono_null (fun x hx => ?_) (not_lt.1 hy |> nonpos_iff_eq_zero.1)
      change a x = -b y
      linarith [hx.1]
  have hN₂ : (μ₁.prod μ₂) N₂ = 0 := by
    rw [Measure.prod_apply hN₂m]
    refine (lintegral_congr fun x => ?_).trans lintegral_zero
    by_cases hx : -a x ∈ T₂
    · refine measure_mono_null (fun y hy => ?_) measure_empty
      exact hy.2 (by rw [show b y = -a x by linarith [hy.1]]; exact hx)
    · refine measure_mono_null (fun y hy => ?_) (not_lt.1 hx |> nonpos_iff_eq_zero.1)
      change b y = -a x
      linarith [hy.1]
  have hA : (μ₁.prod μ₂) (⋃ t ∈ T₁, ({ξ | a ξ = t} \ {x₁ t}) ×ˢ (univ : Set ℝ²)) = 0 :=
    (measure_biUnion_null_iff hT₁).2 fun t ht => by
      rw [Measure.prod_prod, hx₁ t ht, zero_mul]
  have hB : (μ₁.prod μ₂) (⋃ t ∈ T₂, (univ : Set ℝ²) ×ˢ ({ξ | b ξ = t} \ {x₂ t})) = 0 :=
    (measure_biUnion_null_iff hT₂).2 fun t ht => by
      rw [Measure.prod_prod, hx₂ t ht, mul_zero]
  refine measure_mono_null (fun ξ hξ => ?_)
    (measure_union_null (measure_union_null (measure_union_null hN₁ hN₂) hA) hB)
  obtain ⟨hξH, hξS⟩ := hξ
  have hsum : a ξ.1 + b ξ.2 = 0 := hξH
  by_cases h1 : a ξ.1 ∈ T₁
  · by_cases h2 : b ξ.2 ∈ T₂
    · by_cases h3 : ξ.1 = x₁ (a ξ.1)
      · by_cases h4 : ξ.2 = x₂ (b ξ.2)
        · exfalso
          refine hξS ⟨hξH, ?_, ?_⟩
          · rw [h3]; exact hatom1 _ h1
          · rw [h4]; exact hatom2 _ h2
        · exact Or.inr (mem_biUnion h2 ⟨trivial, rfl, h4⟩)
      · exact Or.inl (Or.inr (mem_biUnion h1 ⟨⟨rfl, h3⟩, trivial⟩))
    · exact Or.inl (Or.inl (Or.inr ⟨hsum, h2⟩))
  · exact Or.inl (Or.inl (Or.inl ⟨hsum, h1⟩))

/-! ### Countably many measurable selectors (`ann:selectors`) -/

/-! ### Auxiliary material for `ann:selectors` -/

/-- Auxiliary (`ann:selectors`, see `Auto.ann_selectors`): the set of levels `t` at which the
normalized distribution function of the `k`-th coordinate marginal of `ν_z` reaches `r`. -/
@[nolint defsWithUnderscore]
def aux_ann_qset (ν : ℝ² → Measure ℝ²) (k : Fin 2) (r : ℝ) (z : ℝ²) : Set ℝ :=
  {t : ℝ | ENNReal.ofReal r * ν z univ ≤ ν z {ξ | ξ k ≤ t}}

/-- Auxiliary (`ann:selectors`, see `Auto.ann_selectors`): the quantile
$q_{k,r}(z)=\inf\{t:\nu_z(\{\xi_k\le t\})/\nu_z(\mathbb R^2)\ge r\}$ (zero in degenerate cases). -/
@[nolint defsWithUnderscore]
def aux_ann_quantile (ν : ℝ² → Measure ℝ²) (k : Fin 2) (r : ℝ) (z : ℝ²) : ℝ :=
  if ν z univ ≠ 0 ∧ 0 < r ∧ r < 1 then sInf (aux_ann_qset ν k r z) else 0

theorem aux_ann_qset_mono (ν : ℝ² → Measure ℝ²) (k : Fin 2) (r : ℝ) (z : ℝ²) {t t' : ℝ}
    (htt : t ≤ t') (ht : t ∈ aux_ann_qset ν k r z) : t' ∈ aux_ann_qset ν k r z := by
  unfold aux_ann_qset at *
  simp only [mem_ofPred_eq] at *
  refine le_trans ht (measure_mono ?_)
  intro ξ hξ
  exact le_trans hξ htt

/-- Auxiliary: the level set is nonempty and bounded below in the nondegenerate case. -/
theorem aux_ann_qset_bdd (ν : ℝ² → Measure ℝ²) (hfin : ∀ z, IsFiniteMeasure (ν z)) (k : Fin 2)
    (r : ℝ) (z : ℝ²) (h0 : ν z univ ≠ 0) (hr0 : 0 < r) (hr1 : r < 1) :
    (aux_ann_qset ν k r z).Nonempty ∧ BddBelow (aux_ann_qset ν k r z) := by
  have hm : ν z univ ≠ ⊤ := measure_ne_top _ _
  have hc : ENNReal.ofReal r * ν z univ < ν z univ := by
    have hp := ENNReal.toReal_pos h0 hm
    have hm' : ν z univ = ENNReal.ofReal (ν z univ).toReal := (ENNReal.ofReal_toReal hm).symm
    rw [hm', ← ENNReal.ofReal_mul hr0.le, ENNReal.ofReal_lt_ofReal_iff hp]
    nlinarith
  have hcpos : 0 < ENNReal.ofReal r * ν z univ :=
    ENNReal.mul_pos (ENNReal.ofReal_pos.2 hr0).ne' h0
  have hmeas : ∀ t : ℝ, MeasurableSet {ξ : ℝ² | ξ k ≤ t} := fun t =>
    measurableSet_le (by fun_prop) measurable_const
  -- upper tail
  have hup : Tendsto (fun n : ℕ => ν z {ξ : ℝ² | ξ k ≤ n}) atTop (𝓝 (ν z univ)) := by
    have hmono : Monotone fun n : ℕ => {ξ : ℝ² | ξ k ≤ n} := by
      intro n n' h ξ hξ
      have h1 : ξ k ≤ (n : ℝ) := hξ
      have : (n : ℝ) ≤ n' := by exact_mod_cast h
      change ξ k ≤ (n' : ℝ)
      linarith
    have := tendsto_measure_iUnion_atTop (μ := ν z) hmono
    have hU : ⋃ n : ℕ, {ξ : ℝ² | ξ k ≤ n} = univ := by
      ext ξ; simp only [mem_univ, mem_iUnion, mem_ofPred_eq, iff_true]
      exact exists_nat_ge _
    rw [hU] at this
    exact this
  have hdown : Tendsto (fun n : ℕ => ν z {ξ : ℝ² | ξ k ≤ -n}) atTop (𝓝 0) := by
    have hanti : Antitone fun n : ℕ => {ξ : ℝ² | ξ k ≤ -n} := by
      intro n n' h ξ hξ
      have : (n : ℝ) ≤ n' := by exact_mod_cast h
      have h1 : ξ k ≤ -(n' : ℝ) := hξ
      change ξ k ≤ -(n : ℝ)
      linarith
    have := tendsto_measure_iInter_atTop (μ := ν z) (fun n => (hmeas _).nullMeasurableSet)
      hanti ⟨0, measure_ne_top _ _⟩
    have hI : ⋂ n : ℕ, {ξ : ℝ² | ξ k ≤ -n} = ∅ := by
      ext ξ
      simp only [mem_iInter, mem_ofPred_eq, mem_empty_iff_false, iff_false, not_forall, not_le]
      obtain ⟨n, hn⟩ := exists_nat_gt (-ξ k)
      exact ⟨n, by linarith⟩
    rw [hI, measure_empty] at this
    exact this
  obtain ⟨N, hN⟩ := (hup.eventually (lt_mem_nhds hc)).exists
  obtain ⟨N', hN'⟩ := (hdown.eventually (gt_mem_nhds hcpos)).exists
  refine ⟨⟨N, hN.le⟩, ⟨-N', fun t ht => ?_⟩⟩
  by_contra hlt
  push Not at hlt
  have := aux_ann_qset_mono ν k r z hlt.le ht
  exact absurd this (not_le.2 hN')

/-- Auxiliary (`ann:selectors`): measurability of the quantiles. -/
theorem aux_ann_quantile_measurable (ν : ℝ² → Measure ℝ²) (hν : IsMeasurableKernel ν)
    (k : Fin 2) (r : ℝ) : Measurable (aux_ann_quantile ν k r) := by
  have hfin := hν.1
  by_cases hr : 0 < r ∧ r < 1
  swap
  · have : aux_ann_quantile ν k r = fun _ => 0 := by
      funext z; simp only [aux_ann_quantile]; rw [ite_eq_right (fun h => hr ⟨h.2.1, h.2.2⟩)]
    rw [this]; exact measurable_const
  have hmu : Measurable fun z => ν z univ := hν.2 _ MeasurableSet.univ
  have hlev : ∀ t : ℝ, Measurable fun z => ν z {ξ : ℝ² | ξ k ≤ t} := fun t =>
    hν.2 _ (measurableSet_le (by fun_prop) measurable_const)
  refine measurable_of_Iio fun x => ?_
  have e : aux_ann_quantile ν k r ⁻¹' Iio x =
      ({z | ν z univ ≠ 0} ∩ ⋃ (q : ℚ) (_ : (q : ℝ) < x),
        {z | ENNReal.ofReal r * ν z univ ≤ ν z {ξ : ℝ² | ξ k ≤ q}}) ∪
      ({z | ν z univ = 0} ∩ {_z | (0 : ℝ) < x}) := by
    ext z
    simp only [mem_preimage, mem_Iio, mem_union, mem_inter_iff, mem_ofPred_eq, mem_iUnion,
      exists_prop]
    by_cases h0 : ν z univ = 0
    · rw [aux_ann_quantile, ite_eq_right (fun h => h.1 h0)]
      exact ⟨fun h => Or.inr ⟨h0, h⟩, fun h => h.elim (fun h' => absurd h0 h'.1) (fun h' => h'.2)⟩
    · obtain ⟨hne, hbdd⟩ := aux_ann_qset_bdd ν hfin k r z h0 hr.1 hr.2
      rw [aux_ann_quantile, ite_eq_left ⟨h0, hr.1, hr.2⟩, csInf_lt_iff hbdd hne]
      constructor
      · rintro ⟨t, ht, htx⟩
        obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn htx
        exact Or.inl ⟨h0, q, hq2, aux_ann_qset_mono ν k r z hq1.le ht⟩
      · rintro (⟨-, q, hq, hqS⟩ | ⟨h0', -⟩)
        · exact ⟨q, hqS, hq⟩
        · exact absurd h0' h0
  rw [e]
  refine MeasurableSet.union ((hmu (measurableSet_singleton 0)).compl.inter
    (MeasurableSet.iUnion fun q => MeasurableSet.iUnion fun _ =>
      measurableSet_le (hmu.const_mul _) (hlev q))) ((hmu (measurableSet_singleton 0)).inter
      (MeasurableSet.const ((0 : ℝ) < x)))

/-- Auxiliary (`ann:selectors`): rational quantile levels inside the jump of a coordinate
distribution function at an atom return the coordinate of the atom. -/
theorem aux_ann_quantile_atom (ν : ℝ² → Measure ℝ²) (hfin : ∀ z, IsFiniteMeasure (ν z))
    (z : ℝ²) (h0 : ν z univ ≠ 0) (ξ : ℝ²) (hξ : 0 < ν z {ξ}) (k : Fin 2) :
    ∃ r : ℚ, aux_ann_quantile ν k r z = ξ k := by
  have hm : ν z univ ≠ ⊤ := measure_ne_top _ _
  set m := (ν z univ).toReal with hmdef
  have hmpos : 0 < m := ENNReal.toReal_pos h0 hm
  set A := (ν z {η : ℝ² | η k < ξ k}).toReal
  set B := (ν z {η : ℝ² | η k ≤ ξ k}).toReal
  have hmeasl : MeasurableSet {η : ℝ² | η k < ξ k} :=
    measurableSet_lt (by fun_prop) measurable_const
  have hAB : A < B := by
    have h1 : ν z {η : ℝ² | η k < ξ k} + ν z {ξ} ≤ ν z {η : ℝ² | η k ≤ ξ k} := by
      have hu := measure_union (μ := ν z) (s₁ := {η : ℝ² | η k < ξ k}) (s₂ := {ξ})
        (Set.disjoint_singleton_right.2 (fun h : ξ k < ξ k => lt_irrefl _ h))
        (measurableSet_singleton ξ)
      rw [← hu]
      refine measure_mono fun η hη => ?_
      rcases hη with h | h
      · exact le_of_lt (show η k < ξ k from h)
      · rw [mem_singleton_iff.1 h]; exact le_refl (ξ k)
    have h2 := ENNReal.toReal_mono (measure_ne_top _ _) h1
    rw [ENNReal.toReal_add (measure_ne_top _ _) (measure_ne_top _ _)] at h2
    have h3 : 0 < (ν z {ξ}).toReal := ENNReal.toReal_pos hξ.ne' (measure_ne_top _ _)
    linarith
  have hBm : B ≤ m := ENNReal.toReal_mono hm (measure_mono (subset_univ _))
  have hA0 : 0 ≤ A := ENNReal.toReal_nonneg
  obtain ⟨r, hr1, hr2⟩ := exists_rat_btwn (div_lt_div_of_pos_right hAB hmpos)
  have hr0 : 0 < (r : ℝ) := lt_of_le_of_lt (div_nonneg hA0 hmpos.le) hr1
  have hr1' : (r : ℝ) < 1 := lt_of_lt_of_le hr2 ((div_le_one hmpos).2 hBm)
  refine ⟨r, ?_⟩
  have hc : ENNReal.ofReal r * ν z univ = ENNReal.ofReal (r * m) := by
    rw [ENNReal.ofReal_mul hr0.le, hmdef, ENNReal.ofReal_toReal hm]
  have hleast : IsLeast (aux_ann_qset ν k r z) (ξ k) := by
    refine ⟨?_, fun t ht => ?_⟩
    · change ENNReal.ofReal r * ν z univ ≤ ν z {η : ℝ² | η k ≤ ξ k}
      rw [hc, ← ENNReal.ofReal_toReal (measure_ne_top (ν z) {η : ℝ² | η k ≤ ξ k})]
      refine ENNReal.ofReal_le_ofReal ?_
      have := (lt_div_iff₀ hmpos).1 hr2
      linarith
    · by_contra hlt
      push Not at hlt
      have ht' : ENNReal.ofReal r * ν z univ ≤ ν z {η : ℝ² | η k ≤ t} := ht
      have h1 : ν z {η : ℝ² | η k ≤ t} ≤ ν z {η : ℝ² | η k < ξ k} :=
        measure_mono (by intro η hη; exact lt_of_le_of_lt (show η k ≤ t from hη) hlt)
      have h2 := ht'.trans h1
      rw [hc, ← ENNReal.ofReal_toReal (measure_ne_top (ν z) {η : ℝ² | η k < ξ k}),
        ENNReal.ofReal_le_ofReal_iff ENNReal.toReal_nonneg] at h2
      have := (div_lt_iff₀ hmpos).1 hr1
      linarith
  rw [aux_ann_quantile, ite_eq_left (show ν z univ ≠ 0 ∧ 0 < (r : ℝ) ∧ (r : ℝ) < 1 from
    ⟨h0, hr0, hr1'⟩)]
  exact hleast.csInf_eq

/-- **Lemma `ann:selectors`** (Countably many measurable selectors cover all atoms).
For a measurable kernel $z\mapsto\nu_z$ of finite positive Borel measures on $\mathbb R^2$, there
is a countable family of measurable maps $a_m:\mathbb R^2\to\mathbb R^2$ such that every point
atom of every nonzero $\nu_z$ occurs among the values $a_m(z)$. -/
theorem ann_selectors (ν : ℝ² → Measure ℝ²) (hν : IsMeasurableKernel ν) :
    ∃ a : ℕ → ℝ² → ℝ², (∀ m, Measurable (a m)) ∧
      ∀ z, ν z ≠ 0 → ∀ ξ : ℝ², 0 < ν z {ξ} → ∃ m, a m z = ξ := by
  set a : ℕ → ℝ² → ℝ² := fun m z => (EuclideanSpace.equiv (Fin 2) ℝ).symm
    (fun i : Fin 2 => aux_ann_quantile ν i
      ((Denumerable.eqv ℚ).symm (if i = 0 then (Nat.unpair m).1 else (Nat.unpair m).2)) z) with ha
  refine ⟨a, fun m => ?_, fun z hz ξ hξ => ?_⟩
  · exact (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.measurable.comp
      (Measurable.of_eval fun i => aux_ann_quantile_measurable ν hν i _)
  · have h0 : ν z univ ≠ 0 := by rwa [Ne, Measure.measure_univ_eq_zero]
    obtain ⟨r0, hr0⟩ := aux_ann_quantile_atom ν hν.1 z h0 ξ hξ 0
    obtain ⟨r1, hr1⟩ := aux_ann_quantile_atom ν hν.1 z h0 ξ hξ 1
    refine ⟨Nat.pair (Denumerable.eqv ℚ r0) (Denumerable.eqv ℚ r1), ?_⟩
    ext i
    fin_cases i
    · simpa [ha, Nat.unpair_pair] using hr0
    · simpa [ha, Nat.unpair_pair] using hr1

/-! ### Rigidity for all contributing atomic triples (`ann:atomic-rigidity`) -/

/-- Auxiliary (`ann:atomic-rigidity`, see `Auto.ann_atomic_rigidity`): for one triple of
measurable vector fields `a j`, the set of configurations where their vertex values satisfy the
stationarity equations `(ann:stationarity)` but $a_1(\pi_1p)+M^Ta_2(\pi_2p)\ne0$ is null
(Lemma `rig:prune` and Theorem `rig:exact`, `Auto.rig_exact`). -/
theorem aux_ann_rigidity_fields (α β : ℝ) (hβ : β ≠ 0) (a : Fin 3 → ℝ² → ℝ²)
    (ha : ∀ j, Measurable (a j)) :
    μinc {p | ∑ j, a j (proj α β j p) = 0 ∧
      ⟪v p.2, a 1 (proj α β 1 p) + ContinuousLinearMap.adjoint (M α β) (a 2 (proj α β 2 p))⟫_ℝ
        = 0 ∧
      a 1 (proj α β 1 p) + ContinuousLinearMap.adjoint (M α β) (a 2 (proj α β 2 p)) ≠ 0} = 0 := by
  set MT := ContinuousLinearMap.adjoint (M α β)
  have hpm : ∀ j, Measurable fun p => a j (proj α β j p) := fun j =>
    (ha j).comp (aux_ker_measurable_proj α β j)
  have hvm : Measurable fun p : ℝ² × Ang => v p.2 :=
    aux_ann_v_continuous.measurable.comp measurable_snd
  set Vf : ℝ² × Ang → ℝ² := fun p => a 1 (proj α β 1 p) + MT (a 2 (proj α β 2 p)) with hVf
  have hVm : Measurable Vf := (hpm 1).add (MT.continuous.measurable.comp (hpm 2))
  set E := {p : ℝ² × Ang | ∑ j, a j (proj α β j p) = 0 ∧ ⟪v p.2, Vf p⟫_ℝ = 0 ∧ Vf p ≠ 0}
  have hEm : MeasurableSet E := by
    refine ((measurableSet_eq_fun (Finset.measurable_sum _ fun j _ => hpm j) measurable_const).inter
      ((measurableSet_eq_fun (hvm.inner hVm) measurable_const).inter
      (measurableSet_eq_fun hVm measurable_const).compl))
  change μinc E = 0
  by_contra hne
  have hpos : 0 < μinc E := pos_iff_ne_zero.2 hne
  -- countable exhaustion
  set En : ℕ → Set (ℝ² × Ang) := fun n =>
    E ∩ {p | ‖p.1‖ ≤ n ∧ ∀ j, ‖a j (proj α β j p)‖ ≤ n} with hEn
  have hEnm : ∀ n, MeasurableSet (En n) := fun n =>
    hEm.inter (by
      rw [show {p : ℝ² × Ang | ‖p.1‖ ≤ n ∧ ∀ j, ‖a j (proj α β j p)‖ ≤ n} =
        {p | ‖p.1‖ ≤ n} ∩ ⋂ j, {p | ‖a j (proj α β j p)‖ ≤ n} by ext p; simp]
      exact (measurableSet_le measurable_fst.norm measurable_const).inter
        (MeasurableSet.iInter fun j => measurableSet_le (hpm j).norm measurable_const))
  have hU : E = ⋃ n, En n := by
    ext p
    simp only [hEn, mem_iUnion, mem_inter_iff, mem_ofPred_eq]
    constructor
    · intro hp
      obtain ⟨n, hn⟩ := exists_nat_ge (max ‖p.1‖ (∑ j, ‖a j (proj α β j p)‖))
      refine ⟨n, hp, (le_max_left _ _).trans hn, fun j => ?_⟩
      exact (Finset.single_le_sum (f := fun j => ‖a j (proj α β j p)‖)
        (fun j _ => norm_nonneg _) (Finset.mem_univ j)).trans ((le_max_right _ _).trans hn)
    · rintro ⟨n, hp, _⟩; exact hp
  obtain ⟨n, hn⟩ : ∃ n, 0 < μinc (En n) := by
    by_contra h
    push Not at h
    have : μinc E = 0 := by
      rw [hU]; exact measure_iUnion_null fun n => nonpos_iff_eq_zero.1 (h n)
    exact hne this
  -- the vertex sets
  set X : Fin 3 → Set ℝ² := fun j => {z | ‖z‖ ≤ n + ‖Lv α β j‖ ∧ ‖a j z‖ ≤ n} with hX
  have hXm : ∀ j, MeasurableSet (X j) := fun j =>
    (measurableSet_le measurable_norm measurable_const).inter
      (measurableSet_le (ha j).norm measurable_const)
  have hXb : ∀ j, Bornology.IsBounded (X j) := fun j =>
    (Metric.isBounded_closedBall (x := (0 : ℝ²)) (r := n + ‖Lv α β j‖)).subset
      fun z hz => by simpa using hz.1
  have hmem : ∀ p ∈ En n, ∀ j, proj α β j p ∈ X j := by
    rintro p ⟨_, hp1, hp2⟩ j
    refine ⟨?_, hp2 j⟩
    simp only [proj]
    refine (norm_add_le _ _).trans (add_le_add hp1 ?_)
    exact ((Lv α β j).le_opNorm _).trans (by rw [aux_ann_norm_u, mul_one])
  have hcd : IsCoreData α β (En n) X :=
    { measurableSet_X := hXm
      isBounded_X := hXb
      measurableSet_E := hEnm n
      ae_proj_mem := fun j => (ae_restrict_iff' (hEnm n)).2 (ae_of_all _ fun p hp => hmem p hp j) }
  have hXf : ∑ j, volume (X j) ≠ ∞ := by
    refine ENNReal.sum_ne_top.2 fun j _ => (hXb j).measure_lt_top.ne
  have hrat : 0 < μinc (En n) / ∑ j, volume (X j) :=
    ENNReal.div_pos hn.ne' hXf
  obtain ⟨c, hc0, hc1, hc2⟩ := ENNReal.lt_iff_exists_real_btwn.1 hrat
  have hcpos : 0 < c := ENNReal.ofReal_pos.1 hc1
  obtain ⟨F, Y, hY, hFm, hFE, hcore, -⟩ := rig_prune α β (En n) X hcd hn c hcpos hc2
  have hex := rig_exact α β hβ F Y c hcore a (fun j => ?_)
    ((ae_restrict_iff' hFm).2 (ae_of_all _ fun p hp => (hFE hp).1.1))
    ((ae_restrict_iff' hFm).2 (ae_of_all _ fun p hp => (hFE hp).1.2.1))
  · have h0 : μinc.restrict F {p | Vf p ≠ 0} = 0 := ae_iff.1 hex
    rw [Measure.restrict_apply' hFm] at h0
    have : F ⊆ {p | Vf p ≠ 0} ∩ F := fun p hp => ⟨(hFE hp).1.2.2, hp⟩
    exact hcore.measure_pos.ne' (measure_mono_null this h0)
  · have : IsFiniteMeasure (volume.restrict (Y j)) :=
      isFiniteMeasure_restrict.2 ((hXb j).subset (hY j).2).measure_lt_top.ne
    exact MemLp.of_bound (ha j).aestronglyMeasurable n
      ((ae_restrict_iff' (hY j).1).2 (ae_of_all _ fun z hz => ((hY j).2 hz).2))

/-- **Lemma `ann:atomic-rigidity`** (Rigidity for all contributing atomic triples; stated for
arbitrary measurable kernels $\nu_{j,\cdot}$ of mass at most one, in particular for the spectral
kernels of `ann:spectral`).
For almost every configuration $p$, every triple of point atoms $\xi_j$ of $\nu_{j,\pi_jp}$
satisfying
$$\xi_0+\xi_1+\xi_2=0,\qquad v_\theta\cdot(\xi_1+M^T\xi_2)=0\qquad(\text{ann:stationarity})$$
also satisfies $\xi_1+M^T\xi_2=0$.
(In Lean the blueprint hypothesis `(hν1 : ∀ j z, ν j z univ ≤ 1)` is omitted since the proof does
not need it; see `automation/ErrorReport.md`.) -/
theorem ann_atomic_rigidity (α β : ℝ) (hβ : β ≠ 0) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : ∀ j, IsMeasurableKernel (ν j)) :
    ∀ᵐ p ∂μinc, ∀ ξ : Fin 3 → ℝ², (∀ j, 0 < ν j (proj α β j p) {ξ j}) →
      ∑ j, ξ j = 0 →
      ⟪v p.2, ξ 1 + ContinuousLinearMap.adjoint (M α β) (ξ 2)⟫_ℝ = 0 →
      ξ 1 + ContinuousLinearMap.adjoint (M α β) (ξ 2) = 0 := by
  choose a ha hsel using fun j => ann_selectors (ν j) (hν j)
  have hnull : ∀ m : Fin 3 → ℕ, ∀ᵐ p ∂μinc,
      ¬ (∑ j, a j (m j) (proj α β j p) = 0 ∧
        ⟪v p.2, a 1 (m 1) (proj α β 1 p) +
          ContinuousLinearMap.adjoint (M α β) (a 2 (m 2) (proj α β 2 p))⟫_ℝ = 0 ∧
        a 1 (m 1) (proj α β 1 p) +
          ContinuousLinearMap.adjoint (M α β) (a 2 (m 2) (proj α β 2 p)) ≠ 0) := fun m =>
    measure_eq_zero_iff_ae_notMem.1
      (aux_ann_rigidity_fields α β hβ (fun j => a j (m j)) fun j => ha j (m j))
  filter_upwards [ae_all_iff.2 hnull] with p hp ξ hξ h1 h2
  have hm : ∀ j, ∃ m, a j m (proj α β j p) = ξ j := fun j =>
    hsel j _ (fun h0 => by simpa [h0] using hξ j) _ (hξ j)
  choose m hm using hm
  by_contra hne
  refine hp m ⟨?_, ?_, ?_⟩ <;> simp only [hm] <;> assumption

/-! ### Invariance under displacement smoothing (`ann:displacement`) -/

/-- Auxiliary (`ann:displacement`): `e(x+y) = e(x)e(y)`. -/
theorem aux_ann_e_add (x y : ℝ) : e (x + y) = e x * e y := by
  simp only [e, ← Complex.exp_add]
  congr 1; push_cast; ring

/-- Auxiliary (`ann:displacement`, see `Auto.ann_displacement`): Cesàro means of
`k ↦ e(kx)` converge to the indicator of `x ∈ ℤ`. -/
theorem aux_ann_cesaro_e (x : ℝ) :
    Tendsto (fun N : ℕ => (N : ℂ)⁻¹ * ∑ k ∈ Finset.range N, e (k * x)) atTop
      (𝓝 ({t : ℝ | ∃ n : ℤ, t = n}.indicator (fun _ => (1 : ℂ)) x)) := by
  have hek : ∀ k : ℕ, e (k * x) = e x ^ k := fun k => by
    simp only [e, ← Complex.exp_nat_mul]; congr 1; push_cast; ring
  simp_rw [hek]
  by_cases hx : ∃ n : ℤ, x = n
  · rw [indicator_of_mem (show x ∈ {t : ℝ | ∃ n : ℤ, t = n} from hx)]
    obtain ⟨n, rfl⟩ := hx
    have : e n = 1 := by
      rw [e, Complex.exp_eq_one_iff]; exact ⟨n, by push_cast; ring⟩
    simp only [this, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_ge_atTop 1] with N hN
    rw [inv_mul_cancel₀ (by exact_mod_cast (by omega : N ≠ 0))]
  · rw [indicator_of_notMem (show x ∉ {t : ℝ | ∃ n : ℤ, t = n} from hx)]
    have hz : e x ≠ 1 := by
      intro h
      rw [e, Complex.exp_eq_one_iff] at h
      obtain ⟨n, hn⟩ := h
      apply hx
      refine ⟨n, ?_⟩
      have := congrArg Complex.im hn
      simp at this
      have hπ : (0 : ℝ) < π := Real.pi_pos
      nlinarith [this]
    have hz1 : 0 < ‖e x - 1‖ := norm_pos_iff.2 (sub_ne_zero.2 hz)
    refine squeeze_zero_norm (a := fun N : ℕ => (N : ℝ)⁻¹ * (2 / ‖e x - 1‖)) (fun N => ?_) ?_
    · rw [geom_sum_eq hz, norm_mul, norm_div, norm_inv, Complex.norm_natCast]
      gcongr
      refine (norm_sub_le _ _).trans ?_
      rw [norm_pow, aux_ann_norm_e, one_pow, norm_one]; norm_num
    · simpa using (tendsto_inv_atTop_nhds_zero_nat (𝕜 := ℝ)).mul_const (2 / ‖e x - 1‖)

section Psi

variable {Y : Type*} [MeasurableSpace Y] {μ : Measure Y} (ψ : (Y → ℂ) → ℂ) {c : ℝ≥0∞}

/-- Auxiliary (`ann:displacement`): a bounded linear functional on `L²(μ)` given as a raw map
only depends on the a.e. class of its argument. -/
theorem aux_ann_psi_congr_ae
    (hadd : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → ψ (G + G') = ψ G + ψ G')
    (hbd : ∀ G, MemLp G 2 μ → ‖ψ G‖ₑ ≤ c * eLpNorm G 2 μ)
    {G G' : Y → ℂ} (hG : MemLp G 2 μ) (hG' : MemLp G' 2 μ) (hGG : G =ᵐ[μ] G') : ψ G = ψ G' := by
  have e1 : G = G' + (G - G') := by funext y; simp
  have h0 : ψ (G - G') = 0 := by
    have := hbd _ (hG.sub hG')
    rw [eLpNorm_congr_ae (hGG.sub_eq.trans (ae_of_all _ fun y => rfl) :
      G - G' =ᵐ[μ] (0 : Y → ℂ)), eLpNorm_zero, mul_zero, nonpos_iff_eq_zero, enorm_eq_zero]
      at this
    exact this
  rw [e1, hadd _ _ hG' (hG.sub hG'), h0, add_zero]

/-- Auxiliary (`ann:displacement`): a linear raw map vanishes at zero. -/
theorem aux_ann_psi_zero (hsmul : ∀ (a : ℂ) G, MemLp G 2 μ → ψ (a • G) = a * ψ G) :
    ψ 0 = 0 := by
  have := hsmul 0 0 MemLp.zero
  rwa [zero_smul, zero_mul] at this

/-- Auxiliary (`ann:displacement`): finite additivity of a linear raw map. -/
theorem aux_ann_psi_sum
    (hadd : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → ψ (G + G') = ψ G + ψ G')
    (hsmul : ∀ (a : ℂ) G, MemLp G 2 μ → ψ (a • G) = a * ψ G)
    {ι : Type*} (T : Finset ι) (G : ι → Y → ℂ) (hG : ∀ i, MemLp (G i) 2 μ) :
    ψ (∑ i ∈ T, G i) = ∑ i ∈ T, ψ (G i) := by
  classical
  induction T using Finset.induction_on with
  | empty => simpa using aux_ann_psi_zero ψ hsmul
  | insert a T ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, hadd _ _ (hG a)
      (memLp_finsetSum' _ fun i _ => hG i), ih]

/-- Auxiliary (`ann:displacement`): a bounded linear functional on `L²(μ)` (raw map) is
continuous along pointwise convergent sequences bounded by one (finite measure). -/
theorem aux_ann_psi_tendsto [IsFiniteMeasure μ] (hc : c ≠ ∞)
    (hadd : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → ψ (G + G') = ψ G + ψ G')
    (hbd : ∀ G, MemLp G 2 μ → ‖ψ G‖ₑ ≤ c * eLpNorm G 2 μ)
    {g : ℕ → Y → ℂ} {g0 : Y → ℂ} (hgm : ∀ m, Measurable (g m)) (hg0m : Measurable g0)
    (hb : ∀ m x, ‖g m x‖ ≤ 1) (hb0 : ∀ x, ‖g0 x‖ ≤ 1)
    (hconv : ∀ x, Tendsto (fun m => g m x) atTop (𝓝 (g0 x))) :
    Tendsto (fun m => ψ (g m)) atTop (𝓝 (ψ g0)) := by
  have hL := aux_ann_tendsto_toLp (ν := μ) hgm hg0m hb hb0 hconv
  have hmem := fun m => aux_ann_memLp_two_of_le (ν := μ) (hgm m) (hb m)
  have hmem0 := aux_ann_memLp_two_of_le (ν := μ) hg0m hb0
  rw [tendsto_iff_edist_tendsto_0] at hL ⊢
  have hle : ∀ m, edist (ψ (g m)) (ψ g0) ≤
      c * edist ((hmem m).toLp (g m)) (hmem0.toLp g0) := by
    intro m
    rw [edist_eq_enorm_sub, Lp.edist_toLp_toLp]
    have : ψ (g m) = ψ g0 + ψ (g m - g0) := by
      rw [← hadd _ _ hmem0 ((hmem m).sub hmem0)]; congr 1; funext x; simp
    rw [this, add_sub_cancel_left]
    exact hbd _ ((hmem m).sub hmem0)
  have := ENNReal.Tendsto.const_mul hL (Or.inr hc)
  rw [mul_zero] at this
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds this (fun m => bot_le) hle

/-- Auxiliary (`ann:displacement`, see `Auto.ann_displacement`): if a bounded linear functional
is invariant under the multipliers `e(hφ)`, `h ∈ ℝ`, then it only sees the set `φ ∈ ℤ`
(Cesàro averaging over `h ∈ ℕ`). -/
theorem aux_ann_cesaro_int [IsFiniteMeasure μ] (hc : c ≠ ∞)
    (hadd : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → ψ (G + G') = ψ G + ψ G')
    (hsmul : ∀ (a : ℂ) G, MemLp G 2 μ → ψ (a • G) = a * ψ G)
    (hbd : ∀ G, MemLp G 2 μ → ‖ψ G‖ₑ ≤ c * eLpNorm G 2 μ)
    (φ : Y → ℝ) (hφ : Measurable φ)
    (hinv : ∀ (h : ℝ) (g : Y → ℂ), Measurable g → (∀ y, ‖g y‖ ≤ 1) →
      ψ (fun y => e (h * φ y) * g y) = ψ g)
    {g : Y → ℂ} (hg : Measurable g) (hg1 : ∀ y, ‖g y‖ ≤ 1) :
    ψ g = ψ ({y | ∃ n : ℤ, φ y = n}.indicator g) := by
  set S := {y | ∃ n : ℤ, φ y = n}
  have hSm : MeasurableSet S := by
    have : S = φ ⁻¹' range ((↑) : ℤ → ℝ) := by ext y; simp [S, eq_comm]
    rw [this]; exact hφ (Set.countable_range _).measurableSet
  have hem : ∀ k : ℕ, Measurable fun y => e (k * φ y) := fun k =>
    aux_ann_continuous_e.measurable.comp (measurable_const.mul hφ)
  set gN : ℕ → Y → ℂ := fun N y => ((N : ℂ)⁻¹ * ∑ k ∈ Finset.range N, e (k * φ y)) * g y
    with hgN
  have hgNm : ∀ N, Measurable (gN N) := fun N =>
    (measurable_const.mul (Finset.measurable_sum _ fun k _ => hem k)).mul hg
  have havg : ∀ (N : ℕ) y, ‖(N : ℂ)⁻¹ * ∑ k ∈ Finset.range N, e (k * φ y)‖ ≤ 1 := by
    intro N y
    rcases Nat.eq_zero_or_pos N with rfl | hN
    · simp
    rw [norm_mul, norm_inv, Complex.norm_natCast]
    have : ‖∑ k ∈ Finset.range N, e (k * φ y)‖ ≤ N :=
      (norm_sum_le _ _).trans (by simp [aux_ann_norm_e])
    calc (N : ℝ)⁻¹ * ‖∑ k ∈ Finset.range N, e (k * φ y)‖ ≤ (N : ℝ)⁻¹ * N := by gcongr
      _ = 1 := inv_mul_cancel₀ (by exact_mod_cast hN.ne')
  have hgNb : ∀ N y, ‖gN N y‖ ≤ 1 := fun N y => by
    rw [hgN, norm_mul]
    exact (mul_le_of_le_one_left (norm_nonneg _) (havg N y)).trans (hg1 y)
  have hconv : ∀ y, Tendsto (fun N => gN N y) atTop (𝓝 (S.indicator g y)) := by
    intro y
    have := (aux_ann_cesaro_e (φ y)).mul_const (g y)
    by_cases hy : y ∈ S
    · rw [indicator_of_mem hy]
      rw [indicator_of_mem (show φ y ∈ {t : ℝ | ∃ n : ℤ, t = n} from hy), one_mul] at this
      exact this
    · rw [indicator_of_notMem hy]
      rw [indicator_of_notMem (show φ y ∉ {t : ℝ | ∃ n : ℤ, t = n} from hy), zero_mul] at this
      exact this
  have heq : ∀ N, 1 ≤ N → ψ (gN N) = ψ g := by
    intro N hN
    have e1 : gN N = ∑ k ∈ Finset.range N, ((N : ℂ)⁻¹ • fun y => e (k * φ y) * g y) := by
      funext y
      simp only [hgN, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.mul_sum,
        Finset.sum_mul]
      refine Finset.sum_congr rfl fun k _ => by ring
    have hmk : ∀ k : ℕ, MemLp (fun y => e (k * φ y) * g y) 2 μ := fun k =>
      aux_ann_memLp_two_of_le ((hem k).mul hg) fun y => by
        rw [norm_mul, aux_ann_norm_e, one_mul]; exact hg1 y
    rw [e1, aux_ann_psi_sum ψ hadd hsmul _ _ fun k => (hmk k).const_smul _]
    simp_rw [hsmul _ _ (hmk _), hinv _ g hg hg1]
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, ← mul_assoc,
      mul_inv_cancel₀ (by exact_mod_cast (by omega : N ≠ 0)), one_mul]
  have hlim := aux_ann_psi_tendsto ψ hc hadd hbd hgNm (hg.indicator hSm) hgNb
    (fun y => (norm_indicator_le_norm_self g y).trans (hg1 y)) hconv
  refine tendsto_nhds_unique (tendsto_const_nhds.congr' ?_) hlim
  filter_upwards [eventually_ge_atTop 1] with N hN
  exact (heq N hN).symm

/-- Auxiliary (`ann:displacement`, see `Auto.ann_displacement`): if a bounded linear functional
is invariant under the multipliers `e(hφ)`, `h ∈ ℝ`, then it only sees the zero set of `φ`
(Cesàro averaging along `ℕ` and along `√2 ℕ`). -/
theorem aux_ann_cesaro_zero [IsFiniteMeasure μ] (hc : c ≠ ∞)
    (hadd : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → ψ (G + G') = ψ G + ψ G')
    (hsmul : ∀ (a : ℂ) G, MemLp G 2 μ → ψ (a • G) = a * ψ G)
    (hbd : ∀ G, MemLp G 2 μ → ‖ψ G‖ₑ ≤ c * eLpNorm G 2 μ)
    (φ : Y → ℝ) (hφ : Measurable φ)
    (hinv : ∀ (h : ℝ) (g : Y → ℂ), Measurable g → (∀ y, ‖g y‖ ≤ 1) →
      ψ (fun y => e (h * φ y) * g y) = ψ g)
    {g : Y → ℂ} (hg : Measurable g) (hg1 : ∀ y, ‖g y‖ ≤ 1) :
    ψ g = ψ ({y | φ y = 0}.indicator g) := by
  set S := {y | ∃ n : ℤ, φ y = n}
  have hSm : MeasurableSet S := by
    have : S = φ ⁻¹' range ((↑) : ℤ → ℝ) := by ext y; simp [S, eq_comm]
    rw [this]; exact hφ (Set.countable_range _).measurableSet
  have h1 := aux_ann_cesaro_int ψ hc hadd hsmul hbd φ hφ hinv hg hg1
  have h2 := aux_ann_cesaro_int ψ hc hadd hsmul hbd (fun y => √2 * φ y)
    (measurable_const.mul hφ) (fun h g hg hg1 => by
      rw [← hinv (h * √2) g hg hg1]; congr 1; funext y; congr 2; ring)
    (hg.indicator hSm) (fun y => (norm_indicator_le_norm_self g y).trans (hg1 y))
  have hset : {y | ∃ n : ℤ, √2 * φ y = n} ∩ S = {y | φ y = 0} := by
    ext y
    simp only [mem_inter_iff, mem_ofPred_eq, S]
    constructor
    · rintro ⟨⟨m, hm⟩, ⟨n, hn⟩⟩
      by_contra h0
      have hn0 : n ≠ 0 := by rintro rfl; simp only [Int.cast_zero] at hn; exact h0 hn
      rw [hn] at hm
      exact (irrational_sqrt_two.mul_intCast hn0).ne_int m hm
    · intro h0
      exact ⟨⟨0, by simp [h0]⟩, ⟨0, by simp [h0]⟩⟩
  rw [h1, h2, indicator_indicator, hset]

/-- Auxiliary (`ann:displacement`, see `Auto.ann_displacement`): on a countable set `S` (with
measurable singletons), a bounded linear functional applied to `1_S g` is the limit of the
finite atomic sums `∑_{σ ∈ T_N} g(σ) ψ(1_{σ})` for an exhausting sequence of finite subsets. -/
theorem aux_ann_psi_countable [IsFiniteMeasure μ] [MeasurableSingletonClass Y] (hc : c ≠ ∞)
    (hadd : ∀ G G', MemLp G 2 μ → MemLp G' 2 μ → ψ (G + G') = ψ G + ψ G')
    (hsmul : ∀ (a : ℂ) G, MemLp G 2 μ → ψ (a • G) = a * ψ G)
    (hbd : ∀ G, MemLp G 2 μ → ‖ψ G‖ₑ ≤ c * eLpNorm G 2 μ)
    (S : Set Y) (hS : S.Countable) :
    ∃ T : ℕ → Finset Y, (∀ N, (T N : Set Y) ⊆ S) ∧ ∀ g : Y → ℂ, Measurable g →
      (∀ y, ‖g y‖ ≤ 1) → Tendsto (fun N => ∑ σ ∈ T N, g σ * ψ (({σ} : Set Y).indicator 1)) atTop
        (𝓝 (ψ (S.indicator g))) := by
  classical
  rcases S.eq_empty_or_nonempty with rfl | hne
  · refine ⟨fun _ => ∅, fun _ => by simp, fun g _ _ => ?_⟩
    simp only [Finset.sum_empty, indicator_empty]
    rw [show (fun _ : Y => (0 : ℂ)) = 0 from rfl, aux_ann_psi_zero ψ hsmul]
    exact tendsto_const_nhds
  obtain ⟨f, rfl⟩ := hS.exists_eq_range hne
  refine ⟨fun N => (Finset.range N).image f, fun N => by
    intro y hy; simp only [Finset.coe_image, mem_image] at hy
    obtain ⟨k, -, rfl⟩ := hy; exact mem_range_self k, fun g hg hg1 => ?_⟩
  have hsing : ∀ σ : Y, MemLp (({σ} : Set Y).indicator (1 : Y → ℂ)) 2 μ := fun σ =>
    aux_ann_memLp_two_of_le (measurable_const.indicator (measurableSet_singleton σ))
      fun y => (norm_indicator_le_norm_self _ y).trans (by simp)
  have e1 : ∀ N, ψ ((((Finset.range N).image f : Finset Y) : Set Y).indicator g) =
      ∑ σ ∈ (Finset.range N).image f, g σ * ψ (({σ} : Set Y).indicator 1) := by
    intro N
    have : (((Finset.range N).image f : Finset Y) : Set Y).indicator g =
        ∑ σ ∈ (Finset.range N).image f, g σ • ({σ} : Set Y).indicator (1 : Y → ℂ) := by
      funext y
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, indicator_apply, mem_singleton_iff,
        Pi.one_apply, mul_ite, mul_one, mul_zero, Finset.mem_coe]
      rw [Finset.sum_ite_eq]
    rw [this, aux_ann_psi_sum ψ hadd hsmul _ _ fun σ => (hsing σ).const_smul _]
    simp_rw [hsmul _ _ (hsing _)]
  simp_rw [← e1]
  refine aux_ann_psi_tendsto ψ hc hadd hbd (fun N => hg.indicator (Finset.measurableSet _))
    (hg.indicator (Set.countable_range f).measurableSet)
    (fun N y => (norm_indicator_le_norm_self g y).trans (hg1 y))
    (fun y => (norm_indicator_le_norm_self g y).trans (hg1 y)) fun y => ?_
  by_cases hy : y ∈ range f
  · obtain ⟨k, rfl⟩ := hy
    rw [indicator_of_mem (mem_range_self k)]
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_gt_atTop k] with N hN
    rw [indicator_of_mem]
    simp only [Finset.coe_image, Finset.coe_range, mem_image, mem_Iio]
    exact ⟨k, hN, rfl⟩
  · rw [indicator_of_notMem hy]
    refine tendsto_const_nhds.congr' (Eventually.of_forall fun N => ?_)
    dsimp only
    rw [indicator_of_notMem]
    simp only [Finset.coe_image, Finset.coe_range, mem_image, mem_Iio, not_exists, not_and]
    exact fun k _ hk => hy ⟨k, hk⟩

end Psi

/-- **Lemma `ann:displacement`** (Invariance under displacement smoothing).
For almost every configuration $p$ and every $y\in\mathbb R^2$,
$$\ell_p(1,e_y\otimes e_{My})=\ell_p(1,1).$$
(In Lean the blueprint hypothesis `(hQ : Bornology.IsBounded Q)` is omitted since the proof does not
need it; see `automation/ErrorReport.md`.) -/
theorem ann_displacement (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ)
    (hℓ : aux_IsLimitForm α β R f ν h3 ℓ) :
    ∀ᵐ p ∂μinc, ∀ y : ℝ²,
      ℓ p (fun _ => 1) (fun ξ => charE y ξ.1 * charE (M α β y) ξ.2) =
        ℓ p (fun _ => 1) (fun _ => 1) := by
  classical
  have hfin : ∀ j z, IsFiniteMeasure (ν j z) := fun j => (hν.1 j).1
  filter_upwards [hℓ.1, ann_invariance α β Q C L R f hadm k h3 hlim ν hν ℓ hℓ,
    ann_fibers_hyperplane α β hβ (ν 1) (ν 2) (hν.1 1) (hν.1 2),
    ann_atomic_rigidity α β hβ ν hν.1] with p hB hinv hfib hrig y
  obtain ⟨b1, b2, b3, b4, b5⟩ := hB
  obtain ⟨S, hSc, hSH, hSat, hSnull⟩ := hfib
  set μ₀ := ν 0 (proj α β 0 p) with hμ₀
  set μ₁₂ := (ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p)) with hμ₁₂
  have hmem0 : ∀ g : ℝ² → ℂ, Measurable g → (∀ ξ, ‖g ξ‖ ≤ 1) → MemLp g 2 μ₀ :=
    fun g hg hg1 => aux_ann_memLp_two_of_le hg hg1
  have hmem12 : ∀ g : ℝ² × ℝ² → ℂ, Measurable g → (∀ ξ, ‖g ξ‖ ≤ 1) → MemLp g 2 μ₁₂ :=
    fun g hg hg1 => aux_ann_memLp_two_of_le hg hg1
  have h1m : MemLp (fun _ : ℝ² => (1 : ℂ)) 2 μ₀ := hmem0 _ measurable_const fun _ => by simp
  set W : (ℝ² × ℝ² → ℂ) → ℂ := ℓ p (fun _ => (1 : ℂ)) with hW
  have Wadd : ∀ G G', MemLp G 2 μ₁₂ → MemLp G' 2 μ₁₂ → W (G + G') = W G + W G' :=
    fun G G' hG hG' => b3 _ _ _ h1m hG hG'
  have Wsmul : ∀ (a : ℂ) G, MemLp G 2 μ₁₂ → W (a • G) = a * W G :=
    fun a G hG => b4 _ _ _ h1m hG
  have Wbd : ∀ G, MemLp G 2 μ₁₂ →
      ‖W G‖ₑ ≤ eLpNorm (fun _ : ℝ² => (1 : ℂ)) 2 μ₀ * eLpNorm G 2 μ₁₂ :=
    fun G hG => b5 _ _ h1m hG
  have hc : eLpNorm (fun _ : ℝ² => (1 : ℂ)) 2 μ₀ ≠ ∞ := h1m.eLpNorm_ne_top
  set Φ : ℝ² × ℝ² → ℝ := fun ξ => ⟪v p.2, ξ.1⟫_ℝ + ⟪M α β (v p.2), ξ.2⟫_ℝ with hΦdef
  have hΦc : Continuous Φ := (continuous_const.inner continuous_fst).add
    (continuous_const.inner continuous_snd)
  have hcharE_smul : ∀ (h : ℝ) (w ξ : ℝ²), charE (h • w) ξ = e (h * ⟪w, ξ⟫_ℝ) := fun h w ξ => by
    rw [charE, real_inner_smul_left]
  -- invariance of `W` under the rotation multipliers
  have hWinv : ∀ (h : ℝ) (g : ℝ² × ℝ² → ℂ), Measurable g → (∀ ξ, ‖g ξ‖ ≤ 1) →
      W (fun ξ => e (h * Φ ξ) * g ξ) = W g := by
    intro h g hg hg1
    have := hinv 0 h (fun _ => 1) g h1m (hmem12 g hg hg1)
    rw [hW, this]
    congr 1
    · funext ξ; simp [charE, e]
    · funext ξ
      simp only [zero_add, hcharE_smul, hΦdef, ← aux_ann_e_add, mul_add]
  -- reduction to the hyperplane and to the atoms
  have hHm : MeasurableSet (annH α β p.2) := measurableSet_eq_fun hΦc.measurable measurable_const
  have hSm : MeasurableSet S := hSc.measurableSet
  have hred : ∀ g : ℝ² × ℝ² → ℂ, Measurable g → (∀ ξ, ‖g ξ‖ ≤ 1) → W g = W (S.indicator g) := by
    intro g hg hg1
    have hb : ∀ (A : Set (ℝ² × ℝ²)) ξ, ‖A.indicator g ξ‖ ≤ 1 := fun A ξ =>
      (norm_indicator_le_norm_self g ξ).trans (hg1 ξ)
    rw [aux_ann_cesaro_zero W hc Wadd Wsmul Wbd Φ hΦc.measurable hWinv hg hg1,
      show {ξ | Φ ξ = 0} = annH α β p.2 from rfl]
    refine aux_ann_psi_congr_ae W Wadd Wbd (hmem12 _ (hg.indicator hHm) (hb _))
      (hmem12 _ (hg.indicator hSm) (hb _)) ?_
    filter_upwards [measure_eq_zero_iff_ae_notMem.1 hSnull] with ξ hξ
    by_cases hξS : ξ ∈ S
    · rw [indicator_of_mem hξS, indicator_of_mem (hSH hξS)]
    · rw [indicator_of_notMem hξS, indicator_of_notMem]
      exact fun hH => hξ ⟨hH, hξS⟩
  obtain ⟨T, hTS, hTlim⟩ := aux_ann_psi_countable W hc Wadd Wsmul Wbd S hSc
  -- the atomic claim
  have hclaim : ∀ σ ∈ S, charE y σ.1 * charE (M α β y) σ.2 *
      W (({σ} : Set (ℝ² × ℝ²)).indicator 1) = W (({σ} : Set (ℝ² × ℝ²)).indicator 1) := by
    intro σ hσ
    obtain ⟨hσ1, hσ2⟩ := hSat σ hσ
    have hσH : Φ σ = 0 := hSH hσ
    set ξ0 : ℝ² := -(σ.1 + σ.2) with hξ0
    set Gσ : ℝ² × ℝ² → ℂ := ({σ} : Set (ℝ² × ℝ²)).indicator 1 with hGσ
    have hGσm : MemLp Gσ 2 μ₁₂ := hmem12 _ (measurable_const.indicator (measurableSet_singleton σ))
      fun ξ => (norm_indicator_le_norm_self _ ξ).trans (by simp)
    set V : (ℝ² → ℂ) → ℂ := fun a => ℓ p a Gσ with hV
    have Vadd : ∀ a a', MemLp a 2 μ₀ → MemLp a' 2 μ₀ → V (a + a') = V a + V a' :=
      fun a a' ha ha' => b1 _ _ _ ha ha' hGσm
    have Vsmul : ∀ (z : ℂ) a, MemLp a 2 μ₀ → V (z • a) = z * V a :=
      fun z a ha => b2 _ _ _ ha hGσm
    have Vbd : ∀ a, MemLp a 2 μ₀ → ‖V a‖ₑ ≤ eLpNorm Gσ 2 μ₁₂ * eLpNorm a 2 μ₀ :=
      fun a ha => (b5 _ _ ha hGσm).trans_eq (mul_comm _ _)
    have hcσ : eLpNorm Gσ 2 μ₁₂ ≠ ∞ := hGσm.eLpNorm_ne_top
    -- translation invariance in the first slot
    have hVinv : ∀ i : Fin 2, ∀ (h : ℝ) (g : ℝ² → ℂ), Measurable g → (∀ ξ, ‖g ξ‖ ≤ 1) →
        V (fun ξ => e (h * (ξ - ξ0) i) * g ξ) = V g := by
      intro i h g hg hg1
      set s : ℝ² := h • EuclideanSpace.single i 1
      set cs : ℂ := charE s σ.1 * charE s σ.2
      have hgm : MemLp g 2 μ₀ := hmem0 g hg hg1
      have hsg : MemLp (fun ξ => charE s ξ * g ξ) 2 μ₀ := hmem0 _
        ((aux_ann_charE_meas s).mul hg) fun ξ => by
          rw [norm_mul, aux_ann_norm_charE, one_mul]; exact hg1 ξ
      have := hinv s 0 g Gσ hgm hGσm
      have e1 : (fun ξ : ℝ² × ℝ² => charE (s + (0 : ℝ) • v p.2) ξ.1 *
          charE (s + (0 : ℝ) • M α β (v p.2)) ξ.2 * Gσ ξ) = cs • Gσ := by
        funext ξ
        simp only [zero_smul, add_zero, Pi.smul_apply, smul_eq_mul, hGσ, indicator_apply,
          mem_singleton_iff, Pi.one_apply]
        split_ifs with hξ
        · rw [hξ]
        · simp
      have e2 : (fun ξ => e (h * (ξ - ξ0) i) * g ξ) = cs • fun ξ => charE s ξ * g ξ := by
        funext ξ
        simp only [Pi.smul_apply, smul_eq_mul, cs, charE, ← mul_assoc, ← aux_ann_e_add]
        congr 2
        simp only [s, hξ0, real_inner_smul_left, EuclideanSpace.inner_single_left,
          sub_neg_eq_add, map_one, one_mul, PiLp.add_apply]
        ring
      rw [e2, hV]
      simp only
      rw [b2 _ _ _ hsg hGσm, ← b4 _ _ _ hsg hGσm, ← e1, ← this]
    have hφm : ∀ i : Fin 2, Measurable fun ξ : ℝ² => (ξ - ξ0) i := fun i =>
      ((PiLp.continuous_apply 2 _ i).comp (continuous_id.sub continuous_const)).measurable
    have hV1 : V (fun _ => 1) = V (({ξ0} : Set ℝ²).indicator 1) := by
      have hA := aux_ann_cesaro_zero V hcσ Vadd Vsmul Vbd _ (hφm 0) (hVinv 0)
        (g := fun _ => (1 : ℂ)) measurable_const (fun _ => by simp)
      have hB := aux_ann_cesaro_zero V hcσ Vadd Vsmul Vbd _ (hφm 1) (hVinv 1)
        (g := {ξ : ℝ² | (ξ - ξ0) 0 = 0}.indicator fun _ => (1 : ℂ))
        (measurable_const.indicator (measurableSet_eq_fun (hφm 0) measurable_const))
        (fun ξ => (norm_indicator_le_norm_self _ ξ).trans (by simp))
      rw [hA, hB, indicator_indicator]
      congr 2
      ext ξ
      simp only [mem_inter_iff, mem_ofPred_eq, mem_singleton_iff]
      constructor
      · rintro ⟨h1, h0⟩
        have : ξ - ξ0 = 0 := by
          ext i; fin_cases i
          · simpa using h0
          · simpa using h1
        exact sub_eq_zero.1 this
      · rintro rfl; simp
    by_cases hat : μ₀ {ξ0} = 0
    · have h0 : W Gσ = 0 := by
        change V (fun _ => 1) = 0
        have hm1 : MemLp (({ξ0} : Set ℝ²).indicator (1 : ℝ² → ℂ)) 2 μ₀ :=
          hmem0 _ (measurable_one.indicator (measurableSet_singleton ξ0))
            fun ξ => (norm_indicator_le_norm_self _ ξ).trans (by simp)
        rw [hV1, aux_ann_psi_congr_ae V Vadd Vbd hm1 MemLp.zero
          (indicator_meas_zero hat), aux_ann_psi_zero V Vsmul]
      rw [h0, mul_zero]
    · have hr := hrig ![ξ0, σ.1, σ.2] (fun j => by
          fin_cases j
          · exact pos_iff_ne_zero.2 hat
          · exact hσ1
          · exact hσ2)
        (by simp [Fin.sum_univ_three, hξ0])
        (by
          simp only [Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
            Matrix.tail_cons, inner_add_right, ContinuousLinearMap.adjoint_inner_right]
          exact hσH)
      have hr' : σ.1 + ContinuousLinearMap.adjoint (M α β) σ.2 = 0 := by simpa using hr
      have hT : charE y σ.1 * charE (M α β y) σ.2 = 1 := by
        rw [charE, charE, ← aux_ann_e_add, ← ContinuousLinearMap.adjoint_inner_right,
          ← inner_add_right, hr', inner_zero_right]
        simp [e]
      rw [hT, one_mul]
  have hTy := hTlim _ (aux_ann_charE2_meas y (M α β y)) (aux_ann_charE2_le y (M α β y))
  have hone := hTlim (fun _ => 1) measurable_const (fun _ => by simp)
  rw [← hred _ (aux_ann_charE2_meas y (M α β y)) (aux_ann_charE2_le y (M α β y))] at hTy
  rw [← hred _ measurable_const (fun _ => by simp)] at hone
  refine tendsto_nhds_unique hTy (hone.congr fun N => Finset.sum_congr rfl fun σ hσ => ?_)
  rw [one_mul]
  exact (hclaim σ (hTS N hσ)).symm

/-! ### Cancellation for bounded Lipschitz inputs (`ann:local`) -/

/-- Auxiliary (`ann:local`): a function bounded by the indicator of a measurable set of finite
measure lies in every `L^p`. -/
theorem aux_ann_memLp_of_le_indicator {Q' : Set ℝ²} (hQm : MeasurableSet Q')
    (hQf : volume Q' < ∞) {g : ℝ² → ℂ} (hg : AEStronglyMeasurable g volume)
    (hb : ∀ x, ‖g x‖ ≤ Q'.indicator (fun _ => (1 : ℝ)) x) (q : ℝ≥0∞) : MemLp g q volume := by
  have e : g = Q'.indicator g := by
    funext x
    by_cases hx : x ∈ Q'
    · rw [indicator_of_mem hx]
    · rw [indicator_of_notMem hx]
      have := hb x
      rw [indicator_of_notMem hx] at this
      exact norm_le_zero_iff.1 this
  rw [e, memLp_indicator_iff_restrict hQm.nullMeasurableSet]
  have : IsFiniteMeasure (volume.restrict Q') := isFiniteMeasure_restrict.2 hQf.ne
  exact MemLp.of_bound hg.restrict 1
    (ae_of_all _ fun x => (hb x).trans (by unfold indicator; split_ifs <;> norm_num))

/-- Auxiliary (`ann:local`, see `Auto.ann_local`): the convolution identity of
`lem:convolution-translate` and the substitution $w=y/R$ write the counting form as
$$\Lambda_{\sigma*\Psi_R}(f_0,f_1,f_2)=\int\Psi(y)\int\prod_jT^{s_j(y)}_{j,n}(\pi_jp)\,
\mathbf 1_{Q'}(x)\,d\mu(p)\,dy,\qquad s(y)=(0,y,My).$$ -/
theorem aux_ann_local_repr (α β : ℝ) (Ψ : ℝ² → ℂ) (hΨ : Integrable Ψ) {Q' : Set ℝ²}
    (hQm : MeasurableSet Q') (hQf : volume Q' < ∞) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ)
    (n : ℕ) (hR : R n ≠ 0) (hc : ∀ j, Continuous (f j n))
    (hb : ∀ j x, ‖f j n x‖ ≤ Q'.indicator (fun _ => (1 : ℝ)) x) :
    form α β (FCMeasure.sigma.conv (FCMeasure.ofDensity (scaleR (R n) Ψ))) (f 0 n) (f 1 n)
        (f 2 n) =
      ∫ y, Ψ y * ∫ p, (∏ j, annT R f j n (![0, y, M α β y] j) (proj α β j p)) *
        Q'.indicator (fun _ => (1 : ℂ)) p.1 ∂μinc := by
  have hmem : ∀ j (q : ℝ≥0∞), MemLp (f j n) q volume := fun j q =>
    aux_ann_memLp_of_le_indicator hQm hQf (hc j).aestronglyMeasurable (hb j) q
  rw [lem_convolution_translate α β _ _ 2 (fun j => f j n) (fun j => hmem j _)]
  have hint : Integrable (scaleR (R n) Ψ) :=
    (hΨ.comp_smul hR).const_mul _
  have hw : (FCMeasure.ofDensity (scaleR (R n) Ψ)).w = scaleR (R n) Ψ := by
    simp [FCMeasure.ofDensity, hint]
  set F : ℝ² → ℂ := fun w => form α β FCMeasure.sigma (f 0 n) (fun x => f 1 n (x + w))
    (fun x => f 2 n (x + M α β w)) with hF
  set g : ℝ² → ℂ := fun y => Ψ y * F ((R n)⁻¹ • y) with hg
  have h1 : (FCMeasure.ofDensity (scaleR (R n) Ψ)).integral F = ∫ y, g y := by
    unfold FCMeasure.integral
    rw [hw]
    change ∫ w, F w * scaleR (R n) Ψ w = _
    have e1 : (fun w => F w * scaleR (R n) Ψ w) = fun w => ((R n ^ 2 : ℝ) : ℂ) * g (R n • w) := by
      funext w
      simp only [hg, scaleR, smul_smul, inv_mul_cancel₀ hR, one_smul]
      ring
    rw [e1, integral_const_mul, Measure.integral_comp_smul, finrank_euclideanSpace_fin,
      Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul, abs_of_pos (by positivity),
      mul_inv_cancel₀ (by positivity), Complex.ofReal_one, one_mul]
  rw [h1]
  refine integral_congr_ae (ae_of_all _ fun y => ?_)
  simp only [hg]
  congr 1
  -- the inner integral as an integral over configuration space
  set G : ℝ² × Ang → ℂ := fun p => (∏ j, annT R f j n (![0, y, M α β y] j) (proj α β j p)) *
    Q'.indicator (fun _ => (1 : ℂ)) p.1 with hG
  have hGc : Continuous fun p : ℝ² × Ang => ∏ j, annT R f j n (![0, y, M α β y] j)
      (proj α β j p) := continuous_finsetProd _ fun j _ =>
    (hc j).comp ((aux_ann_proj_continuous α β j).add continuous_const)
  have hGi : Integrable G μinc := by
    have hind : Integrable (fun p : ℝ² × Ang => Q'.indicator (fun _ => (1 : ℝ)) p.1) μinc := by
      unfold μinc
      exact ((integrable_indicator_iff hQm).2 (integrableOn_const hQf.ne)).comp_fst σ
    refine hind.mono' (hGc.aestronglyMeasurable.mul
      ((measurable_const.indicator hQm).comp measurable_fst).aestronglyMeasurable)
      (ae_of_all _ fun p => ?_)
    simp only [hG, norm_mul, norm_prod]
    by_cases hp : p.1 ∈ Q'
    · rw [indicator_of_mem hp, indicator_of_mem hp, norm_one, mul_one]
      exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun j _ =>
        (hb j _).trans (by unfold indicator; split_ifs <;> norm_num)
    · rw [indicator_of_notMem hp, indicator_of_notMem hp, norm_zero, mul_zero]
  change _ = ∫ p, G p ∂μinc
  unfold μinc at hGi ⊢
  rw [integral_prod_symm _ hGi]
  simp only [hF, form, FCMeasure.sigma, mul_one]
  refine integral_congr_ae (Eventually.of_forall fun θ => integral_congr_ae
    (Eventually.of_forall fun x => ?_))
  simp only [hG, Fin.prod_univ_three, annT, proj, Lv, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, smul_zero, add_zero,
    zero_apply, ContinuousLinearMap.id_apply, map_smul]
  by_cases hx : x ∈ Q'
  · rw [indicator_of_mem hx, mul_one]
  · have h0 : f 0 n x = 0 := by
      have := hb 0 x
      rw [indicator_of_notMem hx] at this
      exact norm_le_zero_iff.1 this
    rw [h0, indicator_of_notMem hx]; simp

/-- Auxiliary (`ann:local`, see `Auto.ann_local`): every admissible sequence has a subsequence
along which $\Lambda_{\sigma*\Psi_{R_n}}(f_{0,n},f_{1,n},f_{2,n})\to0$ (Lemmas `ann:extract`,
`ann:spectral`, `ann:form`, `ann:displacement`, and dominated convergence in `y`). -/
theorem aux_ann_local_seq (α β : ℝ) (hβ : β ≠ 0) (Ψ : ℝ² → ℂ) (hΨ : Integrable Ψ)
    (hΨ0 : ∫ x, Ψ x = 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q) (C : ℝ) (R : ℕ → ℝ)
    (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ Tendsto (fun n => form α β (FCMeasure.sigma.conv
      (FCMeasure.ofDensity (scaleR (R (φ n)) Ψ))) (f 0 (φ n)) (f 1 (φ n)) (f 2 (φ n))) atTop
      (𝓝 0) := by
  obtain ⟨L, hL⟩ := ann_extract C
  obtain ⟨φ, hφ, k, h3, hlim⟩ := hL α β Q hQ R f hadm
  set R' := R ∘ φ with hR'
  set f' : Fin 3 → ℕ → ℝ² → ℂ := fun j n => f j (φ n) with hf'
  have hadm' : IsAdmissibleSeq Q C R' f' :=
    { tendsto_R := hadm.tendsto_R.comp hφ.tendsto_atTop
      bound := fun j n x => hadm.bound j (φ n) x
      lip := fun j n x y => hadm.lip j (φ n) x y }
  obtain ⟨ν, hν⟩ := ann_spectral α β Q C L R' f' hadm' k h3 hlim
  obtain ⟨ℓ, hℓ⟩ := ann_form α β hβ Q C L R' f' hadm' k h3 hlim ν hν
  have hdisp := ann_displacement α β hβ Q C L R' f' hadm' k h3 hlim ν hν ℓ hℓ
  refine ⟨φ, hφ, ?_⟩
  set Q' := closure Q
  have hQm : MeasurableSet Q' := isClosed_closure.measurableSet
  have hQf : volume Q' < ∞ := hQ.isCompact_closure.measure_lt_top
  have hbQ : ∀ j n x, ‖f' j n x‖ ≤ Q'.indicator (fun _ => (1 : ℝ)) x := fun j n x =>
    (hadm'.bound j n x).trans
      (indicator_le_indicator_of_subset subset_closure (fun _ => zero_le_one) x)
  set s : ℝ² → Fin 3 → ℝ² := fun y => ![0, y, M α β y] with hs
  have hsc : ∀ j, Continuous fun y => s y j := by
    intro j; fin_cases j
    · exact continuous_const
    · exact continuous_id
    · exact (M α β).continuous
  -- the three-point limit does not depend on `y`
  have hc0 : charE 0 = fun _ => (1 : ℂ) := by funext ξ; simp [charE, e]
  have hconst : ∀ᵐ p ∂μinc, ∀ y, h3 p (s y) = h3 p (s 0) := by
    filter_upwards [hdisp, hℓ.2.2] with p hp hch y
    rw [← hch (s y), ← hch (s 0)]
    simp only [hs, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, map_zero, hc0, mul_one]
    exact hp y
  set ψ : ℝ² × Ang → ℂ := fun p => Q'.indicator (fun _ => (1 : ℂ)) p.1 with hψdef
  have hψ : Integrable ψ μinc := by
    unfold μinc
    exact ((integrable_indicator_iff hQm).2 (integrableOn_const hQf.ne)).comp_fst σ
  set J := ∫ p, h3 p (s 0) * ψ p ∂μinc
  set I : ℕ → ℝ² → ℂ := fun n y =>
    ∫ p, (∏ j, annT R' f' j n (s y j) (proj α β j p)) * ψ p ∂μinc with hI
  have hIlim : ∀ y, Tendsto (fun n => I n y) atTop (𝓝 J) := fun y => by
    have := hlim.three_point (s y) ψ hψ
    rwa [integral_congr_ae (g := fun p => h3 p (s 0) * ψ p)
      (by filter_upwards [hconst] with p hp; rw [hp y])] at this
  have hprod_le : ∀ n y p, ‖∏ j, annT R' f' j n (s y j) (proj α β j p)‖ ≤ 1 := fun n y p => by
    rw [norm_prod]
    exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun j _ =>
      aux_ann_annT_le_one hadm' _ _ _ _
  have hint_le : ∀ n y p, ‖(∏ j, annT R' f' j n (s y j) (proj α β j p)) * ψ p‖ ≤ ‖ψ p‖ :=
    fun n y p => by
      rw [norm_mul]; exact mul_le_of_le_one_left (norm_nonneg _) (hprod_le n y p)
  have hIb : ∀ n y, ‖I n y‖ ≤ ∫ p, ‖ψ p‖ ∂μinc := fun n y =>
    norm_integral_le_of_norm_le hψ.norm (ae_of_all _ (hint_le n y))
  have hIc : ∀ n, Continuous (I n) := by
    intro n
    have hTc : ∀ j, Continuous fun q : ℝ² × ℝ² => annT R' f' j n q.1 q.2 := fun j => by
      have hc := aux_ann_continuous hadm' j n
      unfold annT; fun_prop
    refine continuous_of_dominated (bound := fun p => ‖ψ p‖) (fun y => ?_)
      (fun y => ae_of_all _ (hint_le n y)) hψ.norm (ae_of_all _ fun p => ?_)
    · exact (continuous_finsetProd _ fun j _ => (hTc j).comp
        (continuous_const.prodMk (aux_ann_proj_continuous α β j))).aestronglyMeasurable.mul hψ.1
    · exact (continuous_finsetProd _ fun j _ => (hTc j).comp
        ((hsc j).prodMk continuous_const)).mul continuous_const
  -- dominated convergence in `y`
  have hDC : Tendsto (fun n => ∫ y, Ψ y * I n y) atTop (𝓝 (∫ y, Ψ y * J)) := by
    refine tendsto_integral_of_dominated_convergence (fun y => ‖Ψ y‖ * ∫ p, ‖ψ p‖ ∂μinc)
      (fun n => hΨ.1.mul (hIc n).aestronglyMeasurable) (hΨ.norm.mul_const _)
      (fun n => ae_of_all _ fun y => ?_) (ae_of_all _ fun y => (hIlim y).const_mul (Ψ y))
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hIb n y) (norm_nonneg _)
  rw [integral_mul_const, hΨ0, zero_mul] at hDC
  refine hDC.congr' ?_
  filter_upwards [hadm'.tendsto_R.eventually_gt_atTop 0] with n hn
  exact (aux_ann_local_repr α β Ψ hΨ hQm hQf R' f' n hn.ne' (fun j => aux_ann_continuous hadm' j n)
    (fun j => hbQ j n)).symm

/-- **Proposition `ann:local`** (Cancellation for bounded Lipschitz inputs; the box `Q` is
allowed to be any bounded set).
Let $\Psi\in L^1(\mathbb R^2)$ satisfy $\int\Psi=0$, and put $\Psi_R(u)=R^2\Psi(Ru)$.  For every
bounded box $Q$ and every $C<\infty$,
$$\sup_{\substack{|f_j|\le\mathbf 1_Q\\ \operatorname{Lip}(f_j)\le CR}}
|\Lambda_{\sigma*\Psi_R}(f_0,f_1,f_2)|\longrightarrow0\qquad (R\to\infty).$$ -/
theorem ann_local (α β : ℝ) (hβ : β ≠ 0) (Ψ : ℝ² → ℂ) (hΨ : Integrable Ψ)
    (hΨ0 : ∫ x, Ψ x = 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q) (C : ℝ) :
    Tendsto (fun R : ℝ => ⨆ (f : Fin 3 → ℝ² → ℂ)
        (_ : ∀ j x, ‖f j x‖ ≤ Q.indicator (fun _ => (1 : ℝ)) x)
        (_ : ∀ j x y, ‖f j x - f j y‖ ≤ C * R * ‖x - y‖),
        ‖form α β (FCMeasure.sigma.conv (FCMeasure.ofDensity (scaleR R Ψ)))
          (f 0) (f 1) (f 2)‖ₑ) atTop (𝓝 0) := by
  rw [ENNReal.tendsto_nhds_zero]
  intro ε hε
  by_contra hcon
  rw [not_eventually] at hcon
  have hseq : ∀ n : ℕ, ∃ Rn : ℝ, (n : ℝ) ≤ Rn ∧ ∃ F : Fin 3 → ℝ² → ℂ,
      (∀ j x, ‖F j x‖ ≤ Q.indicator (fun _ => (1 : ℝ)) x) ∧
      (∀ j x y, ‖F j x - F j y‖ ≤ C * Rn * ‖x - y‖) ∧
      ε < ‖form α β (FCMeasure.sigma.conv (FCMeasure.ofDensity (scaleR Rn Ψ)))
        (F 0) (F 1) (F 2)‖ₑ := by
    intro n
    obtain ⟨Rn, hRn, hgt⟩ := (frequently_atTop.1 hcon) n
    have h := not_le.1 hgt
    simp only [lt_iSup_iff] at h
    obtain ⟨F, h1, h2, h3⟩ := h
    exact ⟨Rn, hRn, F, h1, h2, h3⟩
  choose Rs hRs F hF1 hF2 hF3 using hseq
  have hadm : IsAdmissibleSeq Q C Rs (fun j n => F n j) :=
    { tendsto_R := tendsto_atTop_mono hRs tendsto_natCast_atTop_atTop
      bound := fun j n x => hF1 n j x
      lip := fun j n x y => hF2 n j x y }
  obtain ⟨φ, -, hlim⟩ := aux_ann_local_seq α β hβ Ψ hΨ hΨ0 Q hQ C Rs _ hadm
  have h2 := (continuous_enorm.tendsto (0 : ℂ)).comp hlim
  rw [enorm_zero] at h2
  obtain ⟨n, hn⟩ := (h2.eventually (gt_mem_nhds hε)).exists
  exact absurd (hF3 (φ n)) (not_lt.2 hn.le)

end Auto
