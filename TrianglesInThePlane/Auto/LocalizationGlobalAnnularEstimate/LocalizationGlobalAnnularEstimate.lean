the product space. -/
lemma aux_loc_abs_prod (α β : ℝ) (ν : FCMeasure) (i : Fin 3) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) :
    ∫⁻ p : ν.Z × ℝ², ‖f 0 p.2 * f 1 (p.2 + ν.φ p.1) * f 2 (p.2 + M α β (ν.φ p.1)) * ν.w p.1‖ₑ
