/-- **Lemma `lem:geometry`** (part 1).
Each difference $L_i-L_j$, $i\ne j$, is an invertible orientation-preserving similarity. -/
theorem lem_geometry_differences (α β : ℝ) (hβ : β ≠ 0) (i j : Fin 3) (hij : i ≠ j) :
    ∃ a b : ℝ, 0 < a ^ 2 + b ^ 2 ∧ Lv α β i - Lv α β j = simil a b := by
  have hb2 : 0 < β ^ 2 := by positivity
  have key : ∀ a b : ℝ, b ≠ 0 → 0 < a ^ 2 + b ^ 2 := fun a b hb => by positivity
  fin_cases i <;> fin_cases j <;> simp at hij
  · refine ⟨-1, 0, by norm_num, ?_⟩
    apply aux_clm_ext; intro x; simp [Lv]
  · refine ⟨-α, -β, key _ _ (neg_ne_zero.mpr hβ), ?_⟩
    apply aux_clm_ext; intro x; simp [Lv]; constructor <;> ring
  · refine ⟨1, 0, by norm_num, ?_⟩
    apply aux_clm_ext; intro x; simp [Lv]
  · refine ⟨1 - α, -β, key _ _ (neg_ne_zero.mpr hβ), ?_⟩
    apply aux_clm_ext; intro x; simp [Lv]; constructor <;> ring
  · refine ⟨α, β, key _ _ hβ, ?_⟩
    apply aux_clm_ext; intro x; simp [Lv]
  · refine ⟨α - 1, β, key _ _ hβ, ?_⟩
    apply aux_clm_ext; intro x; simp [Lv]; constructor <;> ring

/-- **Lemma `lem:geometry`** (part 2). The matrix $M$ commutes with every rotation. -/
theorem lem_geometry_commute (α β t : ℝ) :
    (M α β).comp (rot t) = (rot t).comp (M α β) := by
  simp only [M, rot, aux_simil_comp]; congr 1 <;> ring

/-- **Lemma `lem:geometry`** (part 3). Every ordered noncollinear triangle is a translate of a
rotation of a positive multiple of $\{0,e_1,Me_1\}$ for a matrix $M$ of the form in
Definition `def:geometry`. -/
theorem lem_geometry_normalization (a b c : ℝ²) (h : ¬ Collinear ℝ {a, b, c}) :
    ∃ (z₀ : ℝ²) (s : ℝ) (t α β : ℝ), 0 < s ∧ β ≠ 0 ∧
      ({a, b, c} : Set ℝ²) = (fun x => z₀ + s • rot t x) '' aux_DeltaM α β := by
  set p := b - a with hp
  set q := c - a with hq
  have hdet : p 0 * q 1 - p 1 * q 0 ≠ 0 := fun h0 => h (aux_collinear_of_det a b c h0)
  have hpne : p 0 ^ 2 + p 1 ^ 2 ≠ 0 := by
    intro h0
    have h1 : p 0 = 0 := by nlinarith [sq_nonneg (p 0), sq_nonneg (p 1)]
    have h2 : p 1 = 0 := by nlinarith [sq_nonneg (p 0), sq_nonneg (p 1)]
    apply hdet; simp [h1, h2]
  set z : ℂ := ⟨p 0, p 1⟩ with hz
  have hz0 : z ≠ 0 := by
    intro h0; apply hpne; simp [Complex.ext_iff, hz] at h0; simp [h0.1, h0.2]
  set s := ‖z‖ with hs
  have hs0 : 0 < s := norm_pos_iff.mpr hz0
  set t := Complex.arg z
  have hcos : s * Real.cos t = p 0 := by
    rw [Complex.cos_arg hz0, hs]; field_simp; simp [hz]
  have hsin : s * Real.sin t = p 1 := by
    rw [Complex.sin_arg z, hs]; field_simp; simp [hz]
  set A := (p 0 * q 0 + p 1 * q 1) / (p 0 ^ 2 + p 1 ^ 2)
  set B := (p 0 * q 1 - p 1 * q 0) / (p 0 ^ 2 + p 1 ^ 2)
  refine ⟨a, s, t, A, B, hs0, div_ne_zero hdet hpne, ?_⟩
  simp only [aux_DeltaM, Set.image_insert_eq, Set.image_singleton, map_zero, smul_zero, add_zero]
  have hb : b = a + s • rot t e1 := by
    apply aux_vec_ext
    · simp [hcos]; simp [hp]
    · simp [hsin]; simp [hp]
  have hA : A * p 0 - B * p 1 = q 0 := by
    simp only [A, B]; field_simp; ring
  have hB : A * p 1 + B * p 0 = q 1 := by
    simp only [A, B]; field_simp; ring
  have e0 : s * (Real.cos t * A - Real.sin t * B) = q 0 := by
    rw [← hA, ← hcos, ← hsin]; ring
  have e1' : s * (Real.cos t * B + Real.sin t * A) = q 1 := by
    rw [← hB, ← hcos, ← hsin]; ring
  have hc : c = a + s • rot t (M A B e1) := by
    apply aux_vec_ext
    · have : q 0 = c 0 - a 0 := by simp [hq]
      simp; linarith
    · have : q 1 = c 1 - a 1 := by simp [hq]
      simp; linarith
  rw [← hb, ← hc]

/-! ### Forms, operators and dilations (`def:form`) -/

/-- The character `e_a(x) = e(a·x)` (`\label{def:form}`). -/
@[nolint defsWithUnderscore]
def aux_ea (a : ℝ²) (x : ℝ²) : ℂ := e ⟪a, x⟫_ℝ

/-- The modulation operator `𝓜_a f = e_a f` (`\label{def:form}`). -/
@[nolint defsWithUnderscore]
def aux_modOp (a : ℝ²) (f : ℝ² → ℂ) : ℝ² → ℂ := fun x => aux_ea a x * f x

/-! ### Elementary bounds (`lem:form-basic`) -/

/-- Hölder's inequality in `lintegral` form, `∫ |f||g| ≤ ‖f‖_p ‖g‖_q`
(auxiliary for `\label{lem:form-basic}` and `\label{pre:circleimprove}`). -/
lemma aux_s2a_holder {X : Type*} [MeasurableSpace X] {μ : Measure X} {f g : X → ℂ}
    (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g μ) (p q : ℝ≥0∞)
    [ENNReal.HolderConjugate p q] :
    ∫⁻ x, ‖f x‖ₑ * ‖g x‖ₑ ∂μ ≤ eLpNorm f p μ * eLpNorm g q μ := by
  have h := eLpNorm_smul_le_mul_eLpNorm (p := p) (q := q) (r := 1) hg hf
  rw [eLpNorm_one_eq_lintegral_enorm] at h
  simpa [enorm_mul] using h

/-- `‖f‖₂² = ∫ |f|²` in `ℝ≥0∞` (auxiliary). -/
lemma aux_s2a_eLpNorm_two_sq {X E : Type*} [MeasurableSpace X] [ENorm E] (μ : Measure X)
    (f : X → E) : eLpNorm f 2 μ ^ 2 = ∫⁻ x, ‖f x‖ₑ ^ 2 ∂μ := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top]
  simp only [ENNReal.toReal_ofNat]
  rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
  norm_num

/-- `e(a) e(b) = e(a + b)` (auxiliary). -/
lemma aux_e_add (a b : ℝ) : e a * e b = e (a + b) := by
  simp only [e, ← Complex.exp_add]; congr 1; push_cast; ring

/-- `e_a(x) e_b(x) = e_{a+b}(x)`-type identities reduce to inner products (auxiliary). -/
lemma aux_inner_two (x y : ℝ²) : ⟪x, y⟫_ℝ = x 0 * y 0 + x 1 * y 1 := by
  simp [PiLp.inner_apply, Fin.sum_univ_two]; ring

/-- `|e(t)| = 1` (auxiliary). -/
lemma aux_norm_e (t : ℝ) : ‖e t‖ = 1 := by
  simp only [e]; rw [Complex.norm_exp]; simp

/-- Characters are continuous (auxiliary). -/
lemma aux_continuous_ea (a : ℝ²) : Continuous (aux_ea a) := by
  unfold aux_ea e; fun_prop

/-- Modulation preserves `L^p` norms (auxiliary for `\label{lem:form-basic}`). -/
lemma aux_eLpNorm_modOp (a : ℝ²) (f : ℝ² → ℂ) (p : ℝ≥0∞) :
    eLpNorm (aux_modOp a f) p = eLpNorm f p := by
  apply eLpNorm_congr_norm_ae
  exact Filter.Eventually.of_forall fun x => by simp [aux_modOp, aux_ea, aux_norm_e]

/-- Modulation preserves membership in `L^p` (auxiliary for `\label{lem:form-basic}`). -/
lemma aux_memLp_modOp_iff (a : ℝ²) (f : ℝ² → ℂ) (p : ℝ≥0∞) :
    MemLp (aux_modOp a f) p ↔ MemLp f p := by
  have key : ∀ (b : ℝ²) (h : ℝ² → ℂ), MemLp h p → MemLp (aux_modOp b h) p := by
    intro b h hh
    refine ⟨(aux_continuous_ea b).aestronglyMeasurable.mul hh.1, ?_⟩
    rw [aux_eLpNorm_modOp]; exact hh.2
  refine ⟨fun h => ?_, key a f⟩
  have : aux_modOp (-a) (aux_modOp a f) = f := by
    funext x; simp only [aux_modOp, ← mul_assoc, aux_ea, aux_e_add, inner_neg_left]; simp [e]
  rw [← this]; exact key _ _ h

/-! ### Fourier representation and scaling (`lem:fourier-form`) -/

/-- `e(a) e(b) = e(a+b)` (auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_e_add (a b : ℝ) : e a * e b = e (a + b) := by
  simp only [e, ← Complex.exp_add]; congr 1; push_cast; ring

/-- `|e(t)| = 1` (auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_norm_e (t : ℝ) : ‖e t‖ = 1 := by
  rw [e, show (2 * π * t : ℂ) * Complex.I = ((2 * π * t : ℝ) : ℂ) * Complex.I by push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

/-- `e` is continuous (auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_continuous_e : Continuous e := by
  unfold e; fun_prop

/-- Mathlib's Fourier transform written with the character `e`
(auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_fourier_e (f : ℝ² → ℂ) (ξ : ℝ²) : 𝓕 f ξ = ∫ v, e (-⟪v, ξ⟫_ℝ) * f v := by
  rw [Real.fourier_eq']
  congr 1; funext v
  simp only [e, smul_eq_mul]; congr 2; push_cast; ring

/-- Mathlib's inverse Fourier transform written with the character `e`
(auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_fourierInv_e (f : ℝ² → ℂ) (z : ℝ²) : 𝓕⁻ f z = ∫ v, e ⟪v, z⟫_ℝ * f v := by
  rw [Real.fourierInv_eq']
  congr 1; funext v
  simp only [e, smul_eq_mul]; congr 2; push_cast; ring

/-- Fourier inversion for Schwartz functions, `f(z) = ∫ e(ξ·z) f̂(ξ) dξ`
(auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_inv_schwartz (f : 𝓢(ℝ², ℂ)) (z : ℝ²) :
    f z = ∫ ξ, e ⟪ξ, z⟫_ℝ * 𝓕 (f : ℝ² → ℂ) ξ := by
  rw [← aux_s2a_fourierInv_e]
  have := f.continuous.fourierInv_fourier_eq f.integrable (by
    rw [← SchwartzMap.fourier_coe]; exact (𝓕 f).integrable)
  rw [this]

/-- Transpose identity `Mᵀω · y = ω · My` (auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_inner_MT (α β : ℝ) (ω y : ℝ²) : ⟪aux_MT α β ω, y⟫_ℝ = ⟪ω, M α β y⟫_ℝ := by
  have h0 : ∀ a b (x : ℝ²), simil a b x 0 = a * x 0 - b * x 1 := fun a b x => by
    simp [simil]; ring
  have h1 : ∀ a b (x : ℝ²), simil a b x 1 = a * x 1 + b * x 0 := fun a b x => by
    simp [simil]
  have hi : ∀ x y : ℝ², ⟪x, y⟫_ℝ = x 0 * y 0 + x 1 * y 1 := fun x y => by
    simp [PiLp.inner_apply, Fin.sum_univ_two]; ring
  rw [hi, hi, aux_MT, M, h0, h1, h0, h1]; ring

/-- Scaling of `L^p` norms under `y ↦ λ y` in the plane
(auxiliary for `\label{lem:fourier-form}`). -/
lemma aux_s2a_eLpNorm_comp_smul (f : ℝ² → ℂ) (lam : ℝ) (hlam : lam ≠ 0) (p : ℝ≥0∞) :
    eLpNorm (fun y => f (lam • y)) p =
      ENNReal.ofReal (|lam ^ 2|⁻¹) ^ (1 / p).toReal * eLpNorm f p := by
  have hemb := (MeasurableEquiv.smul₀ lam hlam (α := ℝ²)).measurableEmbedding
  have h1 := hemb.eLpNorm_map_measure (g := f) (p := p) (μ := (volume : Measure ℝ²))
  have h2 : Measure.map (MeasurableEquiv.smul₀ lam hlam (α := ℝ²)) (volume : Measure ℝ²) =
      ENNReal.ofReal (|lam ^ 2|⁻¹) • volume := by
    have := Measure.map_addHaar_smul (μ := (volume : Measure ℝ²)) hlam
    rw [finrank_euclideanSpace_fin] at this
    rw [← abs_inv, ← this]; rfl
  rw [h2, eLpNorm_smul_measure_of_ne_zero] at h1
  · rw [← smul_eq_mul, h1]; rfl
  · simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le, inv_pos, abs_pos]
    exact pow_ne_zero 2 hlam

/-! ### The local Loomis–Whitney bound -/

/-- `m_M = √(α² + β²)` (part of `\label{lem:triple-l2}`). -/
@[nolint defsWithUnderscore]
def aux_mM (α β : ℝ) : ℝ := Real.sqrt (α ^ 2 + β ^ 2)

/-- `A_M = √(1 + m_M²)` (part of `\label{lem:triple-l2}`). -/
@[nolint defsWithUnderscore]
def aux_AM (α β : ℝ) : ℝ := Real.sqrt (1 + aux_mM α β ^ 2)

/-- `h_M = |β| / (4 A_M²)` (part of `\label{lem:triple-l2}`). -/
@[nolint defsWithUnderscore]
def aux_hM (α β : ℝ) : ℝ := |β| / (4 * aux_AM α β ^ 2)

/-- The angular interval `I_{t*} = (t* - h_M, t* + h_M)` (part of `\label{lem:triple-l2}`). -/
@[nolint defsWithUnderscore]
def aux_Iint (α β tstar : ℝ) : Set ℝ := Ioo (tstar - aux_hM α β) (tstar + aux_hM α β)

/-- The pair-displacement map `H_{t*}(t, s) = M u_s - u_t`, where a point `p : ℝ²` encodes
`(t, s) = (p 0, p 1)` (used in `\label{lem:triple-l2}`). -/
@[nolint defsWithUnderscore]
def aux_Hpair (α β : ℝ) (p : ℝ²) : ℝ² := M α β (aux_uR (p 1)) - aux_uR (p 0)

/-- The square `I_{t*}²`, as a subset of `ℝ²` (used in `\label{lem:triple-l2}`). -/
@[nolint defsWithUnderscore]
def aux_Isq (α β tstar : ℝ) : Set ℝ² := {p | p 0 ∈ aux_Iint α β tstar ∧ p 1 ∈ aux_Iint α β tstar}

/-- Squared Euclidean norm in coordinates (auxiliary for `aux_sc_lw_pairmap_injectivity`). -/
lemma aux_lw_norm_sq (x : ℝ²) : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]

/-- First coordinate of `simil a b x` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_simil0 (a b : ℝ) (x : ℝ²) : simil a b x 0 = a * x 0 - b * x 1 := by
  simp [simil]; ring

/-- Second coordinate of `simil a b x` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_simil1 (a b : ℝ) (x : ℝ²) : simil a b x 1 = a * x 1 + b * x 0 := by
  simp [simil]

/-- `m_M² = α² + β²` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_mM_sq (α β : ℝ) : aux_mM α β ^ 2 = α ^ 2 + β ^ 2 := by
  unfold aux_mM; rw [sq_sqrt (by positivity)]

/-- `0 ≤ m_M` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_mM_nonneg (α β : ℝ) : 0 ≤ aux_mM α β := Real.sqrt_nonneg _

/-- `A_M² = 1 + α² + β²` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_AM_sq (α β : ℝ) : aux_AM α β ^ 2 = 1 + α ^ 2 + β ^ 2 := by
  unfold aux_AM; rw [sq_sqrt (by positivity), aux_lw_mM_sq]; ring

/-- `0 < A_M` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_AM_pos (α β : ℝ) : 0 < aux_AM α β := by
  unfold aux_AM; positivity

/-- `‖M x‖ = m_M ‖x‖` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_norm_M (α β : ℝ) (x : ℝ²) : ‖M α β x‖ = aux_mM α β * ‖x‖ := by
  have h : ‖M α β x‖ ^ 2 = (aux_mM α β * ‖x‖) ^ 2 := by
    rw [mul_pow, aux_lw_mM_sq, aux_lw_norm_sq, aux_lw_norm_sq, M, aux_lw_simil0,
      aux_lw_simil1]; ring
  exact (pow_left_inj₀ (norm_nonneg _) (mul_nonneg (aux_lw_mM_nonneg _ _) (norm_nonneg _))
    two_ne_zero).1 h

/-- `0 < h_M` when `β ≠ 0` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_hM_pos (α β : ℝ) (hβ : β ≠ 0) : 0 < aux_hM α β := by
  unfold aux_hM; have := aux_lw_AM_pos α β; positivity

/-- `h_M A_M² = |β|/4` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_hM_mul (α β : ℝ) : aux_hM α β * aux_AM α β ^ 2 = |β| / 4 := by
  unfold aux_hM; have := aux_lw_AM_pos α β; field_simp

/-- `h_M ≤ 1/8` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_hM_le (α β : ℝ) : aux_hM α β ≤ 1 / 8 := by
  unfold aux_hM; rw [aux_lw_AM_sq, div_le_iff₀ (by positivity)]
  nlinarith [sq_abs β, sq_nonneg (|β| - 1), sq_nonneg α]

/-- `m_M h_M ≤ |β|/8` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_mM_hM (α β : ℝ) : aux_mM α β * aux_hM α β ≤ |β| / 8 := by
  have h1 := aux_lw_hM_mul α β
  have h2 : 2 * aux_mM α β ≤ aux_AM α β ^ 2 := by
    rw [aux_lw_AM_sq]; nlinarith [sq_nonneg (aux_mM α β - 1), aux_lw_mM_sq α β]
  have h3 : 0 ≤ aux_hM α β := by unfold aux_hM; have := aux_lw_AM_pos α β; positivity
  nlinarith

/-! ### The derivative of the pair-displacement map -/

/-- `d/dt u_t = v_t = J u_t` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_uR_hasDerivAt (t : ℝ) : HasDerivAt aux_uR (J (aux_uR t)) t := by
  have := ((Real.hasDerivAt_cos t).smul_const aux_lw_e0).add
    ((Real.hasDerivAt_sin t).smul_const aux_lw_e1)
  have e : J (aux_uR t) = -Real.sin t • aux_lw_e0 + Real.cos t • aux_lw_e1 := by
    ext i; fin_cases i <;> simp [aux_lw_e0, aux_lw_e1, aux_uR]
  rw [e, aux_lw_uR_eq]
  exact this

/-- The differential `DH(t,s) w = w₁ M v_s - w₀ v_t` of `aux_Hpair` (auxiliary for
`lem:triple-l2`, see `aux_sc_lw_pairmap_jacobian`). -/
@[nolint defsWithUnderscore]
def aux_lw_DH (α β : ℝ) (p : ℝ²) : ℝ² →L[ℝ] ℝ² :=
  (M α β).comp ((EuclideanSpace.proj (1 : Fin 2)).smulRight (J (aux_uR (p 1)))) -
    (EuclideanSpace.proj (0 : Fin 2)).smulRight (J (aux_uR (p 0)))

/-- Evaluation of `aux_lw_DH` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_DH_apply (α β : ℝ) (p w : ℝ²) :
    aux_lw_DH α β p w = w 1 • M α β (J (aux_uR (p 1))) - w 0 • J (aux_uR (p 0)) := by
  simp [aux_lw_DH]

/-- `aux_Hpair` has derivative `aux_lw_DH` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_hasFDerivAt (α β : ℝ) (p : ℝ²) :
    HasFDerivAt (aux_Hpair α β) (aux_lw_DH α β p) p := by
  have h1 :=
    (aux_lw_uR_hasDerivAt ((EuclideanSpace.proj (1 : Fin 2) : ℝ² →L[ℝ] ℝ) p)).hasFDerivAt.comp
    p (EuclideanSpace.proj (1 : Fin 2) : ℝ² →L[ℝ] ℝ).hasFDerivAt
  have h0 :=
    (aux_lw_uR_hasDerivAt ((EuclideanSpace.proj (0 : Fin 2) : ℝ² →L[ℝ] ℝ) p)).hasFDerivAt.comp
    p (EuclideanSpace.proj (0 : Fin 2) : ℝ² →L[ℝ] ℝ).hasFDerivAt
  have := ((M α β).hasFDerivAt.comp p h1).sub h0
  refine this.congr_fderiv ?_
  ext w : 1
  rw [aux_lw_DH_apply]
  simp

/-- `aux_Hpair` is smooth (in fact analytic) (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_Hpair_contDiff (α β : ℝ) {n : WithTop ℕ∞} : ContDiff ℝ n (aux_Hpair α β) := by
  unfold aux_Hpair
  have h1 : ContDiff ℝ n (fun q : ℝ² => aux_uR (q 1)) :=
    aux_lw_uR_contDiff.comp (EuclideanSpace.proj (1 : Fin 2) : ℝ² →L[ℝ] ℝ).contDiff
  have h0 : ContDiff ℝ n (fun q : ℝ² => aux_uR (q 0)) :=
    aux_lw_uR_contDiff.comp (EuclideanSpace.proj (0 : Fin 2) : ℝ² →L[ℝ] ℝ).contDiff
  exact ((M α β).contDiff.comp h1).sub h0

/-- The determinant of `aux_lw_DH` in coordinates (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_det_DH (α β : ℝ) (p : ℝ²) :
    LinearMap.det (aux_lw_DH α β p : ℝ² →ₗ[ℝ] ℝ²) =
      -(J (aux_uR (p 0)) 0 * M α β (J (aux_uR (p 1))) 1 -
        J (aux_uR (p 0)) 1 * M α β (J (aux_uR (p 1))) 0) := by
  rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis, Matrix.det_fin_two]
  simp only [LinearMap.toMatrix_apply, OrthonormalBasis.coe_toBasis,
    OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_repr,
    EuclideanSpace.basisFun_apply, ContinuousLinearMap.coe_coe, aux_lw_DH_apply]
  simp
  ring

/-! ### Injectivity and Jacobian bounds -/

/-- Coordinates of `v_t = J u_t` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_JuR0 (t : ℝ) : J (aux_uR t) 0 = -Real.sin t := by simp [aux_uR]

/-- Coordinates of `v_t = J u_t` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_JuR1 (t : ℝ) : J (aux_uR t) 1 = Real.cos t := by simp [aux_uR]

/-- `|v_t - v_r| ≤ |t - r|` (`lem:triple-l2`; auxiliary for `lem:triple-l2`). -/
lemma aux_lw_v_lip (a b : ℝ) : ‖J (aux_uR a) - J (aux_uR b)‖ ≤ |a - b| := by
  have h : ‖J (aux_uR a) - J (aux_uR b)‖ ^ 2 ≤ |a - b| ^ 2 := by
    rw [aux_lw_norm_sq, sq_abs]
    simp only [PiLp.sub_apply, aux_lw_JuR0, aux_lw_JuR1]
    have := Real.one_sub_sq_div_two_le_cos (x := a - b)
    rw [Real.cos_sub] at this
    nlinarith [Real.sin_sq_add_cos_sq a, Real.sin_sq_add_cos_sq b]
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (abs_nonneg _) two_ne_zero).1 h

/-- Lower bound `|D_* w| ≥ (|β|/A_M)|w|` for the differential at a diagonal point
(auxiliary for `aux_sc_lw_pairmap_injectivity`). -/
lemma aux_lw_DH_lower (α β : ℝ) (p : ℝ²) (hp : p 0 = p 1) (w : ℝ²) :
    |β| * ‖w‖ ≤ aux_AM α β * ‖aux_lw_DH α β p w‖ := by
  have hA := aux_lw_AM_pos α β
  have h : (|β| * ‖w‖) ^ 2 ≤ (aux_AM α β * ‖aux_lw_DH α β p w‖) ^ 2 := by
    rw [mul_pow, mul_pow, sq_abs, aux_lw_AM_sq, aux_lw_norm_sq, aux_lw_norm_sq,
      aux_lw_DH_apply, ← hp]
    simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, M, aux_lw_simil0, aux_lw_simil1,
      aux_lw_JuR0, aux_lw_JuR1]
    set X := w 1 * α - w 0
    have hX : w 0 = w 1 * α - X := by ring
    have hsc := Real.sin_sq_add_cos_sq (p 0)
    have key : (w 1 * (α * -Real.sin (p 0) - β * Real.cos (p 0)) - w 0 * -Real.sin (p 0)) ^ 2 +
        (w 1 * (α * Real.cos (p 0) + β * -Real.sin (p 0)) - w 0 * Real.cos (p 0)) ^ 2 =
        X ^ 2 + w 1 ^ 2 * β ^ 2 := by
      rw [hX]; linear_combination (X ^ 2 + w 1 ^ 2 * β ^ 2) * hsc
    rw [key, hX]
    nlinarith [sq_nonneg X, sq_nonneg (α * X + β ^ 2 * w 1)]
  exact (pow_le_pow_iff_left₀ (by positivity) (by positivity) two_ne_zero).1 h

/-- Operator-norm bound `‖DH(t,s) - D_*‖ ≤ A_M h_M` on the square
(auxiliary for `aux_sc_lw_pairmap_injectivity`). -/
lemma aux_lw_DH_sub_le (α β : ℝ) (p q : ℝ²) (h : ℝ)
    (h0 : |p 0 - q 0| ≤ h) (h1 : |p 1 - q 1| ≤ h) :
    ‖aux_lw_DH α β p - aux_lw_DH α β q‖ ≤ aux_AM α β * h := by
  have hh : 0 ≤ h := (abs_nonneg _).trans h0
  have hA := aux_lw_AM_pos α β
  refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun w => ?_
  rw [sub_apply, aux_lw_DH_apply, aux_lw_DH_apply]
  have e : w 1 • M α β (J (aux_uR (p 1))) - w 0 • J (aux_uR (p 0)) -
      (w 1 • M α β (J (aux_uR (q 1))) - w 0 • J (aux_uR (q 0))) =
      w 1 • M α β (J (aux_uR (p 1)) - J (aux_uR (q 1))) -
        w 0 • (J (aux_uR (p 0)) - J (aux_uR (q 0))) := by
    rw [map_sub, smul_sub, smul_sub]; abel
  rw [e]
  have hm := aux_lw_mM_nonneg α β
  have b1 : ‖w 1 • M α β (J (aux_uR (p 1)) - J (aux_uR (q 1)))‖ ≤ |w 1| * (aux_mM α β * h) := by
    rw [norm_smul, aux_lw_norm_M, Real.norm_eq_abs]
    gcongr; exact aux_lw_v_lip _ _ |>.trans h1
  have b0 : ‖w 0 • (J (aux_uR (p 0)) - J (aux_uR (q 0)))‖ ≤ |w 0| * h := by
    rw [norm_smul, Real.norm_eq_abs]
    gcongr; exact aux_lw_v_lip _ _ |>.trans h0
  have hcs : |w 1| * aux_mM α β + |w 0| ≤ aux_AM α β * ‖w‖ := by
    have hs : (|w 1| * aux_mM α β + |w 0|) ^ 2 ≤ (aux_AM α β * ‖w‖) ^ 2 := by
      rw [mul_pow, aux_lw_AM_sq, aux_lw_norm_sq]
      nlinarith [sq_nonneg (aux_mM α β * |w 0| - |w 1|), aux_lw_mM_sq α β, sq_abs (w 0),
        sq_abs (w 1)]
    exact (pow_le_pow_iff_left₀ (by positivity) (by positivity) two_ne_zero).1 hs
  calc ‖w 1 • M α β (J (aux_uR (p 1)) - J (aux_uR (q 1))) -
        w 0 • (J (aux_uR (p 0)) - J (aux_uR (q 0)))‖
      ≤ |w 1| * (aux_mM α β * h) + |w 0| * h := (norm_sub_le _ _).trans (add_le_add b1 b0)
    _ = (|w 1| * aux_mM α β + |w 0|) * h := by ring
    _ ≤ aux_AM α β * ‖w‖ * h := by gcongr
    _ = aux_AM α β * h * ‖w‖ := by ring

/-- The square `I_{t*}²` is convex (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_Isq_convex (α β tstar : ℝ) : Convex ℝ (aux_Isq α β tstar) := by
  have := ((convex_Ioo (tstar - aux_hM α β) (tstar + aux_hM α β)).linear_preimage
    (EuclideanSpace.proj (0 : Fin 2) : ℝ² →L[ℝ] ℝ).toLinearMap).inter
    ((convex_Ioo (tstar - aux_hM α β) (tstar + aux_hM α β)).linear_preimage
    (EuclideanSpace.proj (1 : Fin 2) : ℝ² →L[ℝ] ℝ).toLinearMap)
  exact this

/-- The square `I_{t*}²` is open (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_Isq_open (α β tstar : ℝ) : IsOpen (aux_Isq α β tstar) := by
  have c0 : Continuous fun p : ℝ² => p 0 :=
    (EuclideanSpace.proj (0 : Fin 2) : ℝ² →L[ℝ] ℝ).continuous
  have c1 : Continuous fun p : ℝ² => p 1 :=
    (EuclideanSpace.proj (1 : Fin 2) : ℝ² →L[ℝ] ℝ).continuous
  exact (isOpen_Ioo.preimage c0).inter (isOpen_Ioo.preimage c1)

/-- The square `I_{t*}²` is measurable (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_Isq_meas (α β tstar : ℝ) : MeasurableSet (aux_Isq α β tstar) :=
  (aux_lw_Isq_open α β tstar).measurableSet

/-- Auxiliary (adapted from the reference formalization; used for `lem:triple-l2`)
(`lem:triple-l2`). For all $p,q\in I_{t_*}^2$,
$|H_{t_*}(p)-H_{t_*}(q)|\ge\frac{3|\beta|}{4A_M}|p-q|$. -/
theorem aux_sc_lw_pairmap_injectivity (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) (p q : ℝ²)
    (hp : p ∈ aux_Isq α β tstar) (hq : q ∈ aux_Isq α β tstar) :
    3 * |β| / (4 * aux_AM α β) * ‖p - q‖ ≤ ‖aux_Hpair α β p - aux_Hpair α β q‖ := by
  set c : ℝ² := !₂[tstar, tstar] with hc
  have hc0 : c 0 = tstar := by simp [hc]
  have hc1 : c 1 = tstar := by simp [hc]
  have hA := aux_lw_AM_pos α β
  have hbound : ∀ x ∈ aux_Isq α β tstar,
      ‖aux_lw_DH α β x - aux_lw_DH α β c‖ ≤ aux_AM α β * aux_hM α β := by
    intro x hx
    simp only [aux_Isq, aux_Iint, mem_ofPred_eq, mem_Ioo] at hx
    refine aux_lw_DH_sub_le α β x c _ ?_ ?_
    · rw [hc0, abs_le]; constructor <;> linarith
    · rw [hc1, abs_le]; constructor <;> linarith
  have mv := (aux_lw_Isq_convex α β tstar).norm_image_sub_le_of_norm_hasFDerivWithin_le'
    (f := aux_Hpair α β) (f' := aux_lw_DH α β)
    (fun x _ => (aux_lw_hasFDerivAt α β x).hasFDerivWithinAt) hbound hq hp
  have low := aux_lw_DH_lower α β c (by rw [hc0, hc1]) (p - q)
  have hAh : aux_AM α β * aux_hM α β = |β| / (4 * aux_AM α β) := by
    have := aux_lw_hM_mul α β
    field_simp; nlinarith
  have tri : ‖aux_lw_DH α β c (p - q)‖ ≤
      ‖aux_Hpair α β p - aux_Hpair α β q‖ + aux_AM α β * aux_hM α β * ‖p - q‖ := by
    calc _ ≤ ‖aux_Hpair α β p - aux_Hpair α β q‖ +
          ‖aux_Hpair α β p - aux_Hpair α β q - aux_lw_DH α β c (p - q)‖ :=
          norm_le_norm_add_norm_sub _ _
      _ ≤ _ := by gcongr
  rw [hAh] at tri
  have : |β| / aux_AM α β * ‖p - q‖ ≤ ‖aux_lw_DH α β c (p - q)‖ := by
    rw [div_mul_eq_mul_div, div_le_iff₀ hA]; linarith
  have e : 3 * |β| / (4 * aux_AM α β) = |β| / aux_AM α β - |β| / (4 * aux_AM α β) := by
    field_simp; ring
  rw [e, sub_mul]; linarith

/-- Auxiliary (adapted from the reference formalization; used for `lem:triple-l2`)
(`lem:triple-l2`). Throughout the square,
$|\det DH_{t_*}(t,s)|=|\det(v_t,Mv_s)|\ge\frac{|\beta|}{2}$. -/
theorem aux_sc_lw_pairmap_jacobian (α β : ℝ) (_hβ : β ≠ 0) (tstar : ℝ) (p : ℝ²)
    (hp : p ∈ aux_Isq α β tstar) :
    |LinearMap.det (fderiv ℝ (aux_Hpair α β) p : ℝ² →ₗ[ℝ] ℝ²)| =
        |J (aux_uR (p 0)) 0 * M α β (J (aux_uR (p 1))) 1 -
          J (aux_uR (p 0)) 1 * M α β (J (aux_uR (p 1))) 0| ∧
      |β| / 2 ≤ |LinearMap.det (fderiv ℝ (aux_Hpair α β) p : ℝ² →ₗ[ℝ] ℝ²)| := by
  rw [(aux_lw_hasFDerivAt α β p).fderiv, aux_lw_det_DH, abs_neg]
  refine ⟨rfl, ?_⟩
  simp only [M, aux_lw_simil0, aux_lw_simil1, aux_lw_JuR0, aux_lw_JuR1]
  simp only [aux_Isq, aux_Iint, mem_ofPred_eq, mem_Ioo] at hp
  set d := p 1 - p 0 with hd
  have hE : -Real.sin (p 0) * (α * Real.cos (p 1) + β * -Real.sin (p 1)) -
      Real.cos (p 0) * (α * -Real.sin (p 1) - β * Real.cos (p 1)) =
      α * Real.sin d + β * Real.cos d := by
    rw [hd, Real.sin_sub, Real.cos_sub]; ring
  rw [hE]
  have hh8 := aux_lw_hM_le α β
  have hmh := aux_lw_mM_hM α β
  have hdabs : |d| ≤ 2 * aux_hM α β := by rw [abs_le]; constructor <;> linarith
  have hcos := Real.one_sub_sq_div_two_le_cos (x := d)
  have hsin : |Real.sin d| ≤ |d| := Real.abs_sin_le_abs
  have hαm : |α| ≤ aux_mM α β := Real.abs_le_sqrt (by nlinarith [sq_nonneg β])
  have hd2 : d ^ 2 ≤ 1 / 16 := by
    have : |d| ≤ 1 / 4 := by linarith
    nlinarith [sq_abs d, abs_nonneg d]
  have hcpos : 0 ≤ Real.cos d := by nlinarith
  have h1 : |α * Real.sin d| ≤ |β| / 4 := by
    rw [abs_mul]
    calc |α| * |Real.sin d| ≤ aux_mM α β * (2 * aux_hM α β) :=
          mul_le_mul hαm (hsin.trans hdabs) (abs_nonneg _) (aux_lw_mM_nonneg _ _)
      _ ≤ |β| / 4 := by linarith
  have h2 : |β| * (31 / 32) ≤ |β * Real.cos d| := by
    rw [abs_mul, abs_of_nonneg hcpos]
    have : (31 / 32 : ℝ) ≤ Real.cos d := by linarith
    exact mul_le_mul_of_nonneg_left this (abs_nonneg _)
  have h3 := abs_sub_abs_le_abs_sub (β * Real.cos d) (-(α * Real.sin d))
  rw [abs_neg, sub_neg_eq_add, add_comm] at h3
  linarith [abs_nonneg β]

/-- On the square, the differential of `aux_Hpair` is invertible (auxiliary for
`aux_sc_lw_pairmap_diffeo`). -/
lemma aux_lw_DH_equiv (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) (p : ℝ²) (hp : p ∈ aux_Isq α β tstar) :
    ∃ e : ℝ² ≃L[ℝ] ℝ², (e : ℝ² →L[ℝ] ℝ²) = aux_lw_DH α β p := by
  have hdet : LinearMap.det (aux_lw_DH α β p : ℝ² →ₗ[ℝ] ℝ²) ≠ 0 := by
    have h := (aux_sc_lw_pairmap_jacobian α β hβ tstar p hp).2
    rw [(aux_lw_hasFDerivAt α β p).fderiv] at h
    intro h0; rw [h0, abs_zero] at h
    have : 0 < |β| := abs_pos.2 hβ
    linarith
  refine ⟨(LinearMap.equivOfDetNeZero _ hdet).toContinuousLinearEquiv, ?_⟩
  ext w : 1
  rfl

/-- Auxiliary (adapted from the reference formalization; used for `lem:triple-l2`) (diffeomorphism).
The map $H_{t_*}:I_{t_*}^2\to\R^2$ is a smooth
diffeomorphism onto its open image. -/
theorem aux_sc_lw_pairmap_diffeo (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) :
    ContDiff ℝ ⊤ (aux_Hpair α β) ∧ InjOn (aux_Hpair α β) (aux_Isq α β tstar) ∧
      IsOpen (aux_Hpair α β '' aux_Isq α β tstar) ∧
      ∃ G : ℝ² → ℝ², ContDiffOn ℝ ⊤ G (aux_Hpair α β '' aux_Isq α β tstar) ∧
        ∀ p ∈ aux_Isq α β tstar, G (aux_Hpair α β p) = p := by
  have hA := aux_lw_AM_pos α β
  have hinj : InjOn (aux_Hpair α β) (aux_Isq α β tstar) := by
    intro p hp q hq hpq
    have h := aux_sc_lw_pairmap_injectivity α β hβ tstar p q hp hq
    rw [hpq, sub_self, norm_zero] at h
    have hc : 0 < 3 * |β| / (4 * aux_AM α β) := by have := abs_pos.2 hβ; positivity
    have : ‖p - q‖ ≤ 0 := by
      by_contra hcon
      exact absurd h (not_le.2 (mul_pos hc (not_le.1 hcon)))
    exact sub_eq_zero.1 (norm_le_zero_iff.1 this)
  have hstrict : ∀ p ∈ aux_Isq α β tstar, ∃ e : ℝ² ≃L[ℝ] ℝ²,
      HasFDerivAt (aux_Hpair α β) (e : ℝ² →L[ℝ] ℝ²) p := by
    intro p hp
    obtain ⟨e, he⟩ := aux_lw_DH_equiv α β hβ tstar p hp
    exact ⟨e, he ▸ aux_lw_hasFDerivAt α β p⟩
  have hcd : ContDiff ℝ ⊤ (aux_Hpair α β) := aux_lw_Hpair_contDiff α β
  have hn : (⊤ : WithTop ℕ∞) ≠ 0 := by simp
  refine ⟨hcd, hinj, ?_, Function.invFunOn (aux_Hpair α β) (aux_Isq α β tstar), ?_, ?_⟩
  · rw [isOpen_iff_mem_nhds]
    rintro _ ⟨p, hp, rfl⟩
    obtain ⟨e, he⟩ := hstrict p hp
    have hs := (hcd.contDiffAt).hasStrictFDerivAt' he (by simp)
    rw [← hs.map_nhds_eq_of_equiv]
    exact image_mem_map ((aux_lw_Isq_open α β tstar).mem_nhds hp)
  · rintro _ ⟨p, hp, rfl⟩
    obtain ⟨e, he⟩ := hstrict p hp
    have hf : ContDiffAt ℝ ⊤ (aux_Hpair α β) p := hcd.contDiffAt
    have hL := hf.to_localInverse he hn
    refine (hL.congr_of_eventuallyEq ?_).contDiffWithinAt
    have hs := hf.hasStrictFDerivAt' he (by simp)
    have h1 := hs.eventually_right_inverse
    have h2 : ∀ᶠ y in 𝓝 (aux_Hpair α β p),
        hs.localInverse (aux_Hpair α β) e p y ∈ aux_Isq α β tstar := by
      have := hs.localInverse_continuousAt
      apply this.preimage_mem_nhds
      rw [hs.localInverse_apply_image]
      exact (aux_lw_Isq_open α β tstar).mem_nhds hp
    filter_upwards [h1, h2] with y hy1 hy2
    have := hinj.leftInvOn_invFunOn hy2
    rw [hy1] at this
    exact this
  · intro p hp
    exact hinj.leftInvOn_invFunOn hp

/-! ### The four-variable product estimate -/

/-- `u` is measurable (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_uR_meas : Measurable aux_uR := (aux_lw_uR_contDiff (n := 0)).continuous.measurable

/-- `aux_Hpair` is measurable (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_Hpair_meas (α β : ℝ) : Measurable (aux_Hpair α β) :=
  (aux_lw_Hpair_contDiff α β (n := 0)).continuous.measurable

/-- The coordinate map `ℝ² → ℝ × ℝ`, `p ↦ (p 0, p 1)`, as a measurable equivalence
(auxiliary for `lem:triple-l2`). -/
@[nolint defsWithUnderscore]
def aux_lw_coordEquiv : ℝ² ≃ᵐ ℝ × ℝ :=
  (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow

/-- The coordinate map preserves Lebesgue measure (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_coordEquiv_mp : MeasurePreserving aux_lw_coordEquiv volume volume :=
  (volume_preserving_finTwoArrow ℝ).comp
    (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2))

/-- An iterated integral over `I × I` is an integral over the corresponding square in `ℝ²`
(auxiliary for `lem:triple-l2`). -/
lemma aux_lw_iter_eq_square (I : Set ℝ) (φ : ℝ × ℝ → ℝ≥0∞) (hφ : Measurable φ) :
    ∫⁻ t in I, ∫⁻ s in I, φ (t, s) =
      ∫⁻ p in {p : ℝ² | p 0 ∈ I ∧ p 1 ∈ I}, φ (p 0, p 1) := by
  rw [← setLIntegral_prod _ hφ.aemeasurable, ← Measure.volume_eq_prod,
    ← aux_lw_coordEquiv_mp.setLIntegral_comp_preimage_emb
      aux_lw_coordEquiv.measurableEmbedding]
  rfl

/-- Change of variables by `H_{t*}` with the Jacobian lower bound: for every `g ≥ 0`,
`∫_{I²} g(H(p)) dp ≤ (2/|β|) ∫ g` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_cov_bound (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) (g : ℝ² → ℝ≥0∞) :
    ∫⁻ p in aux_Isq α β tstar, g (aux_Hpair α β p) ≤ ENNReal.ofReal (2 / |β|) * ∫⁻ y, g y := by
  have hb : 0 < |β| := abs_pos.2 hβ
  have hinj := (aux_sc_lw_pairmap_diffeo α β hβ tstar).2.1
  have hcov := lintegral_image_eq_lintegral_abs_det_fderiv_mul volume (aux_lw_Isq_meas α β tstar)
    (fun p _ => (aux_lw_hasFDerivAt α β p).hasFDerivWithinAt) hinj g
  have hone : ENNReal.ofReal (2 / |β|) * ENNReal.ofReal (|β| / 2) = 1 := by
    rw [← ENNReal.ofReal_mul (by positivity)]; field_simp; simp
  calc ∫⁻ p in aux_Isq α β tstar, g (aux_Hpair α β p)
      = ENNReal.ofReal (2 / |β|) * ∫⁻ p in aux_Isq α β tstar,
          ENNReal.ofReal (|β| / 2) * g (aux_Hpair α β p) := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← mul_assoc, hone, one_mul]
    _ ≤ ENNReal.ofReal (2 / |β|) * ∫⁻ p in aux_Isq α β tstar,
          ENNReal.ofReal |(aux_lw_DH α β p).det| * g (aux_Hpair α β p) := by
        refine mul_le_mul_right (setLIntegral_mono' (aux_lw_Isq_meas α β tstar) fun p hp => ?_) _
        gcongr
        have h := (aux_sc_lw_pairmap_jacobian α β hβ tstar p hp).2
        rw [(aux_lw_hasFDerivAt α β p).fderiv] at h
        exact h
    _ = ENNReal.ofReal (2 / |β|) * ∫⁻ y in aux_Hpair α β '' aux_Isq α β tstar, g y := by rw [hcov]
    _ ≤ ENNReal.ofReal (2 / |β|) * ∫⁻ y, g y := mul_le_mul_right (setLIntegral_le_lintegral _ _) _

/-- Auxiliary (adapted from the reference formalization; used for `lem:triple-l2`)
(`lem:triple-l2`). For nonnegative $a,b$ and every real $t_*$,
$$\int_{\R^2}\int_{I_{t_*}}\int_{I_{t_*}} a(x+u_t)b(x+Mu_s)\,ds\,dt\,dx
\le\frac{2}{|\beta|}\|a\|_1\|b\|_1.$$ -/
theorem aux_sc_lw_product (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) (a b : ℝ² → ℝ≥0∞)
    (ha : Measurable a) (hb : Measurable b) :
    ∫⁻ x, ∫⁻ t in aux_Iint α β tstar, ∫⁻ s in aux_Iint α β tstar,
        a (x + aux_uR t) * b (x + M α β (aux_uR s)) ≤
      ENNReal.ofReal (2 / |β|) * (∫⁻ y, a y) * (∫⁻ y, b y) := by
  have hu := aux_lw_uR_meas
  have aux_hM : Measurable (M α β) := (M α β).continuous.measurable
  have c0 : Measurable fun p : ℝ² => p 0 :=
    (EuclideanSpace.proj (0 : Fin 2) : ℝ² →L[ℝ] ℝ).continuous.measurable
  have c1 : Measurable fun p : ℝ² => p 1 :=
    (EuclideanSpace.proj (1 : Fin 2) : ℝ² →L[ℝ] ℝ).continuous.measurable
  -- pass to the square in `ℝ²`
  have step1 : ∀ x : ℝ², ∫⁻ t in aux_Iint α β tstar, ∫⁻ s in aux_Iint α β tstar,
      a (x + aux_uR t) * b (x + M α β (aux_uR s)) =
      ∫⁻ p in aux_Isq α β tstar, a (x + aux_uR (p 0)) * b (x + M α β (aux_uR (p 1))) := by
    intro x
    exact aux_lw_iter_eq_square (aux_Iint α β tstar)
      (fun q : ℝ × ℝ => a (x + aux_uR q.1) * b (x + M α β (aux_uR q.2))) (by fun_prop)
  simp_rw [step1]
  -- swap and translate
  rw [lintegral_lintegral_swap (by fun_prop)]
  have step2 : ∀ p : ℝ², ∫⁻ x, a (x + aux_uR (p 0)) * b (x + M α β (aux_uR (p 1))) =
      ∫⁻ y, a y * b (y + aux_Hpair α β p) := by
    intro p
    rw [← lintegral_add_right_eq_self (μ := volume)
      (fun y => a y * b (y + aux_Hpair α β p)) (aux_uR (p 0))]
    congr 1; funext x
    simp only [aux_Hpair]; congr 2; abel
  simp_rw [step2]
  rw [lintegral_lintegral_swap (by
    have := aux_lw_Hpair_meas α β
    fun_prop)]
  have hH := aux_lw_Hpair_meas α β
  calc ∫⁻ y, ∫⁻ p in aux_Isq α β tstar, a y * b (y + aux_Hpair α β p)
      ≤ ∫⁻ y, a y * (ENNReal.ofReal (2 / |β|) * ∫⁻ z, b z) := by
        refine lintegral_mono fun y => ?_
        rw [lintegral_const_mul _ (by fun_prop)]
        refine mul_le_mul_right ?_ _
        have := aux_lw_cov_bound α β hβ tstar (fun z => b (y + z))
        rwa [lintegral_add_left_eq_self] at this
    _ = ENNReal.ofReal (2 / |β|) * (∫⁻ y, a y) * (∫⁻ y, b y) := by
        rw [lintegral_mul_const _ ha]; ring

/-! ### The local Loomis–Whitney bound -/

/-- `‖f‖_2 = (∫ ‖f‖^2)^{1/2}` (auxiliary for `lem:triple-l2`, `lem:triple-l2`). -/
lemma aux_lw_eLpNorm_two {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E]
    (μ : Measure X) (f : X → E) :
    eLpNorm f 2 μ = (∫⁻ x, ‖f x‖ₑ ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top]
  simp

/-- The map `(x, y) ↦ x + L(y)` is quasi-measure-preserving from `dx ⊗ ν` to `dx`; used to see
that changing an input on a planar null set does not affect the Loomis–Whitney integrals
(auxiliary for `lem:triple-l2`, `lem:triple-l2`). -/
lemma aux_lw_qmp {Y : Type*} [MeasurableSpace Y] (ν : Measure Y) [SFinite ν] (L : Y → ℝ²)
    (hL : Measurable L) :
    Measure.QuasiMeasurePreserving (fun p : ℝ² × Y => p.1 + L p.2)
      ((volume : Measure ℝ²).prod ν) volume := by
  have hm : Measurable (fun p : ℝ² × Y => p.1 + L p.2) := by fun_prop
  refine ⟨hm, Measure.AbsolutelyContinuous.mk fun s hs h0 => ?_⟩
  rw [Measure.map_apply hm hs, Measure.prod_apply_symm (hm hs)]
  have : ∀ y : Y, (volume : Measure ℝ²) ((fun x => (x, y)) ⁻¹'
      ((fun p : ℝ² × Y => p.1 + L p.2) ⁻¹' s)) = 0 := by
    intro y
    change volume ((fun x : ℝ² => x + L y) ⁻¹' s) = 0
    rw [measure_preimage_add_right]; exact h0
  simp [this]

/-- Core of `lem:triple-l2` for measurable nonnegative inputs, in `ℝ≥0∞` form
(auxiliary for `aux_pre_standardLW`). -/
lemma aux_lw_standardLW_core (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) (F0 F1 F2 : ℝ² → ℝ≥0∞)
    (h0 : Measurable F0) (h1 : Measurable F1) (h2 : Measurable F2) :
    ∫⁻ x, ∫⁻ t in aux_Iint α β tstar, F0 x * F1 (x + aux_uR t) * F2 (x + M α β (aux_uR t)) ≤
      ENNReal.ofReal (Real.sqrt (2 / |β|)) * (∫⁻ x, F0 x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
        (∫⁻ x, F1 x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) * (∫⁻ x, F2 x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
  set I := aux_Iint α β tstar
  have hu := aux_lw_uR_meas
  have aux_hM : Measurable (M α β) := (M α β).continuous.measurable
  set A1 : ℝ² → ℝ≥0∞ := fun x => ∫⁻ t in I, F1 (x + aux_uR t) ^ (2 : ℝ) with hA1
  set A2 : ℝ² → ℝ≥0∞ := fun x => ∫⁻ t in I, F2 (x + M α β (aux_uR t)) ^ (2 : ℝ) with hA2
  have mA1 : Measurable A1 :=
    (show Measurable fun q : ℝ² × ℝ => F1 (q.1 + aux_uR q.2) ^ (2 : ℝ) by
      fun_prop).lintegral_prod_right'
  have mA2 : Measurable A2 :=
    (show Measurable fun q : ℝ² × ℝ => F2 (q.1 + M α β (aux_uR q.2)) ^ (2 : ℝ) by
      fun_prop).lintegral_prod_right'
  have hhalf : ∀ z : ℝ≥0∞, (z ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = z := fun z => by
    rw [← ENNReal.rpow_mul]; norm_num
  -- Cauchy–Schwarz in the angle
  have step1 : ∀ x, ∫⁻ t in I, F0 x * F1 (x + aux_uR t) * F2 (x + M α β (aux_uR t)) ≤
      F0 x * (A1 x ^ (1 / 2 : ℝ) * A2 x ^ (1 / 2 : ℝ)) := by
    intro x
    simp_rw [mul_assoc]
    rw [lintegral_const_mul _ (by fun_prop)]
    refine mul_le_mul_right ?_ _
    have := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict I) Real.HolderConjugate.two_two
      (f := fun t => F1 (x + aux_uR t)) (g := fun t => F2 (x + M α β (aux_uR t)))
      (by fun_prop) (by fun_prop)
    simpa [hA1, hA2] using this
  -- Cauchy–Schwarz in space
  have step2 : ∫⁻ x, F0 x * (A1 x ^ (1 / 2 : ℝ) * A2 x ^ (1 / 2 : ℝ)) ≤
      (∫⁻ x, F0 x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) * (∫⁻ x, A1 x * A2 x) ^ (1 / 2 : ℝ) := by
    have := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
      (f := F0) (g := fun x => A1 x ^ (1 / 2 : ℝ) * A2 x ^ (1 / 2 : ℝ))
      h0.aemeasurable (by fun_prop)
    refine (le_of_eq (by rfl)).trans (this.trans_eq ?_)
    congr 3; funext x
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), hhalf, hhalf]
  -- Tonelli and the product estimate
  have step3 : ∫⁻ x, A1 x * A2 x ≤ ENNReal.ofReal (2 / |β|) * (∫⁻ y, F1 y ^ (2 : ℝ)) *
      (∫⁻ y, F2 y ^ (2 : ℝ)) := by
    have e : ∀ x, A1 x * A2 x = ∫⁻ t in I, ∫⁻ s in I,
        F1 (x + aux_uR t) ^ (2 : ℝ) * F2 (x + M α β (aux_uR s)) ^ (2 : ℝ) := by
      intro x
      rw [hA1, hA2, ← lintegral_mul_const _ (by fun_prop)]
      congr 1; funext t
      rw [← lintegral_const_mul _ (by fun_prop)]
    simp_rw [e]
    exact aux_sc_lw_product α β hβ tstar _ _ (by fun_prop) (by fun_prop)
  have hC : ENNReal.ofReal (Real.sqrt (2 / |β|)) = ENNReal.ofReal (2 / |β|) ^ (1 / 2 : ℝ) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num), Real.sqrt_eq_rpow]
  calc _ ≤ ∫⁻ x, F0 x * (A1 x ^ (1 / 2 : ℝ) * A2 x ^ (1 / 2 : ℝ)) := lintegral_mono step1
    _ ≤ _ := step2
    _ ≤ (∫⁻ x, F0 x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) * (ENNReal.ofReal (2 / |β|) *
          (∫⁻ y, F1 y ^ (2 : ℝ)) * (∫⁻ y, F2 y ^ (2 : ℝ))) ^ (1 / 2 : ℝ) := by
        gcongr
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
          ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), hC]
        ring

/-- Auxiliary (adapted from the reference formalization; used for `lem:triple-l2`)
(`lem:triple-l2`). For every real $t_*$ and all
$f_0,f_1,f_2\in L^2(\R^2)$, and every measurable subset $S$ of $\R^2\times I_{t_*}$,
$$\int_{\R^2}\int_{I_{t_*}}|f_0(x)f_1(x+u_t)f_2(x+Mu_t)|\,dt\,dx
\le \left(\frac{2}{|\beta|}\right)^{1/2}\prod_{j=0}^2\|f_j\|_2.$$
(The case of the full set is `S = univ`.) -/
theorem aux_pre_standardLW (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume)
    (S : Set (ℝ² × ℝ)) (_hS : MeasurableSet S) :
    ∫⁻ p in S ∩ (univ ×ˢ aux_Iint α β tstar),
        ‖f 0 p.1‖ₑ * ‖f 1 (p.1 + aux_uR p.2)‖ₑ * ‖f 2 (p.1 + M α β (aux_uR p.2))‖ₑ ≤
      ENNReal.ofReal (Real.sqrt (2 / |β|)) * eLpNorm (f 0) 2 * eLpNorm (f 1) 2 *
        eLpNorm (f 2) 2 := by
  set g : Fin 3 → ℝ² → ℂ := fun j => (hf j).mk (f j)
  have hg : ∀ j, StronglyMeasurable (g j) := fun j => (hf j).stronglyMeasurable_mk
  have hfg : ∀ j, f j =ᵐ[volume] g j := fun j => (hf j).ae_eq_mk
  have hu := aux_lw_uR_meas
  have aux_hM : Measurable (M α β) := (M α β).continuous.measurable
  have e0 : (fun p : ℝ² × ℝ => ‖f 0 p.1‖ₑ) =ᵐ[volume] fun p => ‖g 0 p.1‖ₑ :=
    ((Measure.quasiMeasurePreserving_fst (μ := (volume : Measure ℝ²))
      (ν := (volume : Measure ℝ))).ae_eq_comp (hfg 0)).fun_comp _
  have e1 : (fun p : ℝ² × ℝ => ‖f 1 (p.1 + aux_uR p.2)‖ₑ) =ᵐ[volume]
      fun p => ‖g 1 (p.1 + aux_uR p.2)‖ₑ :=
    ((aux_lw_qmp volume aux_uR hu).ae_eq_comp (hfg 1)).fun_comp _
  have e2 : (fun p : ℝ² × ℝ => ‖f 2 (p.1 + M α β (aux_uR p.2))‖ₑ) =ᵐ[volume]
      fun p => ‖g 2 (p.1 + M α β (aux_uR p.2))‖ₑ :=
    ((aux_lw_qmp volume (fun t => M α β (aux_uR t)) (aux_hM.comp hu)).ae_eq_comp (hfg 2)).fun_comp _
  have hg' : ∀ j, Measurable fun x => ‖g j x‖ₑ := fun j => (hg j).measurable.enorm
  calc _ ≤ ∫⁻ p in univ ×ˢ aux_Iint α β tstar,
        ‖f 0 p.1‖ₑ * ‖f 1 (p.1 + aux_uR p.2)‖ₑ * ‖f 2 (p.1 + M α β (aux_uR p.2))‖ₑ :=
        lintegral_mono_set inter_subset_right
    _ = ∫⁻ p in univ ×ˢ aux_Iint α β tstar,
        ‖g 0 p.1‖ₑ * ‖g 1 (p.1 + aux_uR p.2)‖ₑ * ‖g 2 (p.1 + M α β (aux_uR p.2))‖ₑ := by
        refine lintegral_congr_ae (ae_restrict_of_ae ?_)
        filter_upwards [e0, e1, e2] with p h0 h1 h2
        rw [h0, h1, h2]
    _ = ∫⁻ x, ∫⁻ t in aux_Iint α β tstar,
        ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ := by
        rw [Measure.volume_eq_prod, setLIntegral_prod _ (by
          have := hg' 0; have := hg' 1; have := hg' 2
          fun_prop), Measure.restrict_univ]
    _ ≤ _ := aux_lw_standardLW_core α β hβ tstar _ _ _ (hg' 0) (hg' 1) (hg' 2)
    _ = _ := by
        rw [eLpNorm_congr_ae (hfg 0), eLpNorm_congr_ae (hfg 1), eLpNorm_congr_ae (hfg 2)]
        simp only [aux_lw_eLpNorm_two]

/-! ### The global Loomis–Whitney bound -/

/-- The number `N_M = ⌈π / h_M⌉ + 1` (part of `\label{lem:triple-l2}`, see `aux_pre_LW`). -/
@[nolint defsWithUnderscore]
def aux_NM (α β : ℝ) : ℕ := ⌈π / aux_hM α β⌉₊ + 1

/-- The constant `C_M = N_M/(2π) (2/|β|)^{1/2}` of `\label{lem:triple-l2}` (see `aux_pre_LW`). -/
@[nolint defsWithUnderscore]
def aux_C_pre_LW (α β : ℝ) : ℝ := aux_NM α β / (2 * π) * Real.sqrt (2 / |β|)

/-- Probability arclength as normalized length on `(0, 2π]` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_sigma_lintegral (F : Ang → ℝ≥0∞) :
    ∫⁻ θ, F θ ∂σ = (ENNReal.ofReal (2 * π))⁻¹ * ∫⁻ t in Ioc 0 (2 * π), F t := by
  have h := AddCircle.lintegral_preimage (T := 2 * π) 0 F
  rw [zero_add] at h
  rw [h, AddCircle.volume_eq_smul_haarAddCircle, lintegral_smul_measure, smul_eq_mul,
    ← mul_assoc, ENNReal.inv_mul_cancel (by simp [Real.pi_pos]) ENNReal.ofReal_ne_top, one_mul]
  rfl

/-- The vertex projections at a real angle (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_prod_proj (α β : ℝ) (g : Fin 3 → ℝ² → ℂ) (x : ℝ²) (t : ℝ) :
    ∏ j : Fin 3, ‖g j (proj α β j (x, (t : Ang)))‖ₑ =
      ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ := by
  simp [Fin.prod_univ_three, proj, Lv, mul_assoc]

/-- Covering `(0, 2π]` by `N` intervals `I_{c_k}` of half-length `h` centered at
`c_k = (k + 1/2) 2π/N`, provided `2π/N < 2h` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_cover (α β : ℝ) (N : ℕ) (hN : 0 < N) (hδ : 2 * π / N < 2 * aux_hM α β) :
    Ioc 0 (2 * π) ⊆ ⋃ k : Fin N, aux_Iint α β (((k : ℝ) + 1 / 2) * (2 * π / N)) := by
  intro t ht
  simp only [aux_Iint]
  set δ := 2 * π / N with hδdef
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
  have hδpos : 0 < δ := by positivity
  have hNδ : (N : ℝ) * δ = 2 * π := by rw [hδdef]; field_simp
  set m := ⌈t / δ⌉₊ with hm
  have hm1 : 1 ≤ m := Nat.one_le_iff_ne_zero.2 (Nat.pos_iff_ne_zero.1
    (Nat.ceil_pos.2 (div_pos ht.1 hδpos)))
  have hmN : m ≤ N := Nat.ceil_le.2 (by rw [div_le_iff₀ hδpos, hNδ]; exact ht.2)
  have hup : t / δ ≤ m := Nat.le_ceil _
  have hlo : (m : ℝ) < t / δ + 1 := Nat.ceil_lt_add_one (div_pos ht.1 hδpos).le
  refine mem_iUnion.2 ⟨⟨m - 1, by omega⟩, ?_⟩
  rw [Nat.cast_sub hm1, Nat.cast_one]
  rw [div_le_iff₀ hδpos] at hup
  have hlo' : ((m : ℝ) - 1) * δ < t := by
    have := (lt_div_iff₀ hδpos).1 (by linarith : (m : ℝ) - 1 < t / δ); linarith
  constructor <;> nlinarith

/-- `2π/N_M < 2h_M` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_NM_spec (α β : ℝ) (hβ : β ≠ 0) : 2 * π / aux_NM α β < 2 * aux_hM α β := by
  have hh := aux_lw_hM_pos α β hβ
  have h1 : π / aux_hM α β < aux_NM α β := by
    unfold aux_NM; push_cast
    linarith [Nat.le_ceil (π / aux_hM α β)]
  have hN : (0 : ℝ) < aux_NM α β := lt_of_le_of_lt (by positivity) h1
  rw [div_lt_iff₀ hN]
  rw [div_lt_iff₀ hh] at h1
  linarith

/-- The bound of a single angular window: `aux_pre_standardLW` in iterated form for measurable
inputs (auxiliary for `aux_pre_LW`). -/
lemma aux_lw_window (α β : ℝ) (hβ : β ≠ 0) (tstar : ℝ) (g : Fin 3 → ℝ² → ℂ)
    (hg : ∀ j, StronglyMeasurable (g j)) :
    ∫⁻ x, ∫⁻ t in aux_Iint α β tstar,
        ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ ≤
      ENNReal.ofReal (Real.sqrt (2 / |β|)) * ∏ j : Fin 3, eLpNorm (g j) 2 := by
  have hgm : ∀ j, Measurable fun x => ‖g j x‖ₑ := fun j => (hg j).measurable.enorm
  have huR := aux_lw_uR_meas
  have hMm : Measurable (M α β) := (M α β).continuous.measurable
  have := aux_pre_standardLW α β hβ tstar g (fun j => (hg j).aestronglyMeasurable)
    univ MeasurableSet.univ
  rw [univ_inter, Measure.volume_eq_prod, setLIntegral_prod _ (by
      have := hgm 0; have := hgm 1; have := hgm 2
      fun_prop), Measure.restrict_univ] at this
  refine this.trans_eq ?_
  rw [Fin.prod_univ_three, mul_assoc, mul_assoc, mul_assoc]

/-- `lem:triple-l2` for measurable inputs (auxiliary for `aux_pre_LW`). -/
lemma aux_lw_LW_meas (α β : ℝ) (hβ : β ≠ 0) (g : Fin 3 → ℝ² → ℂ)
    (hg : ∀ j, StronglyMeasurable (g j)) :
    ∫⁻ x, ∫⁻ θ, ∏ j : Fin 3, ‖g j (proj α β j (x, θ))‖ₑ ∂σ ≤
      ENNReal.ofReal (aux_C_pre_LW α β) * ∏ j : Fin 3, eLpNorm (g j) 2 := by
  have hN : 0 < aux_NM α β := by unfold aux_NM; omega
  have hcov := aux_lw_cover α β (aux_NM α β) hN (aux_lw_NM_spec α β hβ)
  have hgm : ∀ j, Measurable fun x => ‖g j x‖ₑ := fun j => (hg j).measurable.enorm
  have huR := aux_lw_uR_meas
  have hMm : Measurable (M α β) := (M α β).continuous.measurable
  have hΦ : Measurable (Function.uncurry fun x t =>
      ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ) := by
    have := hgm 0; have := hgm 1; have := hgm 2
    simp only [Function.uncurry_def]; fun_prop
  have hK := fun k : Fin (aux_NM α β) =>
    aux_lw_window α β hβ (((k : ℝ) + 1 / 2) * (2 * π / aux_NM α β)) g hg
  have e1 : ∫⁻ x, ∫⁻ θ, ∏ j : Fin 3, ‖g j (proj α β j (x, θ))‖ₑ ∂σ
      = ∫⁻ x, (ENNReal.ofReal (2 * π))⁻¹ * ∫⁻ t in Ioc 0 (2 * π),
          ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ := by
    refine lintegral_congr fun x => ?_
    rw [aux_lw_sigma_lintegral]
    simp only [aux_lw_prod_proj]
  have e2 : ∫⁻ x, (ENNReal.ofReal (2 * π))⁻¹ * ∫⁻ t in Ioc 0 (2 * π),
          ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ ≤
      ∫⁻ x, (ENNReal.ofReal (2 * π))⁻¹ * ∑ k : Fin (aux_NM α β),
          ∫⁻ t in aux_Iint α β (((k : ℝ) + 1 / 2) * (2 * π / aux_NM α β)),
            ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ := by
    refine lintegral_mono fun x => mul_le_mul_right ?_ _
    refine (lintegral_mono_set hcov).trans ((lintegral_iUnion_le _ _).trans_eq ?_)
    rw [tsum_fintype]
  have e3 : ∫⁻ x, (ENNReal.ofReal (2 * π))⁻¹ * ∑ k : Fin (aux_NM α β),
          ∫⁻ t in aux_Iint α β (((k : ℝ) + 1 / 2) * (2 * π / aux_NM α β)),
            ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ =
      (ENNReal.ofReal (2 * π))⁻¹ * ∑ k : Fin (aux_NM α β), ∫⁻ x,
          ∫⁻ t in aux_Iint α β (((k : ℝ) + 1 / 2) * (2 * π / aux_NM α β)),
            ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ := by
    have hmk : ∀ c : ℝ, Measurable fun x => ∫⁻ t in aux_Iint α β c,
        ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ :=
      fun c => hΦ.lintegral_prod_right'
    rw [lintegral_const_mul _ (Finset.measurable_sum _ fun k _ => hmk _),
      lintegral_finsetSum _ fun k _ => hmk _]
  have e4 : (ENNReal.ofReal (2 * π))⁻¹ * ∑ k : Fin (aux_NM α β), ∫⁻ x,
          ∫⁻ t in aux_Iint α β (((k : ℝ) + 1 / 2) * (2 * π / aux_NM α β)),
            ‖g 0 x‖ₑ * ‖g 1 (x + aux_uR t)‖ₑ * ‖g 2 (x + M α β (aux_uR t))‖ₑ ≤
      (ENNReal.ofReal (2 * π))⁻¹ * ∑ _k : Fin (aux_NM α β),
          ENNReal.ofReal (Real.sqrt (2 / |β|)) * ∏ j : Fin 3, eLpNorm (g j) 2 :=
    mul_le_mul_right (Finset.sum_le_sum fun k _ => hK k) _
  have e5 : (ENNReal.ofReal (2 * π))⁻¹ * ∑ _k : Fin (aux_NM α β),
          ENNReal.ofReal (Real.sqrt (2 / |β|)) * ∏ j : Fin 3, eLpNorm (g j) 2 =
      ENNReal.ofReal (aux_C_pre_LW α β) * ∏ j : Fin 3, eLpNorm (g j) 2 := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    unfold aux_C_pre_LW
    rw [ENNReal.ofReal_mul (p := (aux_NM α β : ℝ) / (2 * π)) (by positivity),
      ENNReal.ofReal_div_of_pos (x := (aux_NM α β : ℝ)) (by positivity),
      ENNReal.ofReal_natCast, ENNReal.div_eq_inv_mul]
    ring
  exact (e1.trans_le e2).trans (e3.trans_le e4) |>.trans_eq e5

/-- Auxiliary (adapted from the reference formalization; used for `lem:triple-l2`)
(`lem:triple-l2eq`). For all $f_j\in L^2(\R^2)$,
$$\int\!\int\prod_{j=0}^2|f_j(\pi_j(x,\theta))|\,d\sigma(\theta)\,dx\le C_M\prod_{j=0}^2\|f_j\|_2,$$
with $C_M=\frac{N_M}{2\pi}(2/|\beta|)^{1/2}$, $N_M=\lceil\pi/h_M\rceil+1$. -/
theorem aux_pre_LW (α β : ℝ) (hβ : β ≠ 0) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) :
    ∫⁻ x, ∫⁻ θ, ∏ j : Fin 3, ‖f j (proj α β j (x, θ))‖ₑ ∂σ ≤
      ENNReal.ofReal (aux_C_pre_LW α β) * ∏ j : Fin 3, eLpNorm (f j) 2 := by
  have hfg : ∀ j, f j =ᵐ[volume] (hf j).mk (f j) := fun j => (hf j).ae_eq_mk
  have hu := aux_lw_u_meas
  have hLv : ∀ j, Measurable fun θ => Lv α β j (u θ) := fun j =>
    (Lv α β j).continuous.measurable.comp hu
  have hrep : ∀ᵐ p ∂(volume : Measure ℝ²).prod σ, ∏ j : Fin 3, ‖f j (proj α β j p)‖ₑ =
      ∏ j : Fin 3, ‖(hf j).mk (f j) (proj α β j p)‖ₑ := by
    have : ∀ j, ∀ᵐ p ∂(volume : Measure ℝ²).prod σ,
        f j (proj α β j p) = (hf j).mk (f j) (proj α β j p) :=
      fun j => (aux_lw_qmp σ _ (hLv j)).ae_eq_comp (hfg j)
    filter_upwards [ae_all_iff.2 this] with p hp
    simp only [hp]
  have hLHS : ∫⁻ x, ∫⁻ θ, ∏ j : Fin 3, ‖f j (proj α β j (x, θ))‖ₑ ∂σ =
      ∫⁻ x, ∫⁻ θ, ∏ j : Fin 3, ‖(hf j).mk (f j) (proj α β j (x, θ))‖ₑ ∂σ := by
    refine lintegral_congr_ae ?_
    filter_upwards [Measure.ae_ae_of_ae_prod hrep] with x hx
    exact lintegral_congr_ae hx
  have hnorm : ∏ j : Fin 3, eLpNorm (f j) 2 = ∏ j : Fin 3, eLpNorm ((hf j).mk (f j)) 2 :=
    Finset.prod_congr rfl fun j _ => eLpNorm_congr_ae (hfg j)
  rw [hLHS, hnorm]
  exact aux_lw_LW_meas α β hβ (fun j => (hf j).mk (f j)) fun j => (hf j).stronglyMeasurable_mk

/-! ### The operator bound -/

/-- `L²` duality in `ℝ≥0∞` form: if `∫ h A ≤ K ‖h‖₂` for every finite measurable `h ≥ 0`,
then `‖A‖₂ ≤ K` (truncation argument of `lem:triple-l2`; auxiliary for `lem_triple_l2`). -/
lemma aux_lw_duality (A : ℝ² → ℝ≥0∞) (hA : Measurable A) (K : ℝ≥0∞)
    (hK : ∀ h : ℝ² → ℝ≥0∞, Measurable h → (∀ x, h x ≠ ⊤) →
      ∫⁻ x, h x * A x ≤ K * (∫⁻ x, h x ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) :
    (∫⁻ x, A x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤ K := by
  set An : ℕ → ℝ² → ℝ≥0∞ := fun n x =>
    (Metric.closedBall (0 : ℝ²) n).indicator (fun x => min (A x) n) x with hAn
  have hAn_meas : ∀ n, Measurable (An n) := fun n =>
    (hA.min measurable_const).indicator measurableSet_closedBall
  have hAn_le_n : ∀ n x, An n x ≤ n := by
    intro n x; simp only [hAn, indicator]; split_ifs
    · exact min_le_right _ _
    · exact zero_le
  have hAn_le : ∀ n x, An n x ≤ A x := by
    intro n x; simp only [hAn, indicator]; split_ifs
    · exact min_le_left _ _
    · exact zero_le
  have hAn_ne_top : ∀ n x, An n x ≠ ⊤ := fun n x =>
    ne_top_of_le_ne_top (ENNReal.natCast_ne_top n) (hAn_le_n n x)
  have hAn_fin : ∀ n, ∫⁻ x, An n x ^ (2 : ℝ) ≠ ⊤ := by
    intro n
    have hle : ∀ x, An n x ^ (2 : ℝ) ≤
        (Metric.closedBall (0 : ℝ²) n).indicator (fun _ => (n : ℝ≥0∞) ^ (2 : ℝ)) x := by
      intro x
      by_cases hx : x ∈ Metric.closedBall (0 : ℝ²) n
      · rw [indicator_of_mem hx]
        exact ENNReal.rpow_le_rpow (hAn_le_n n x) (by norm_num)
      · rw [indicator_of_notMem hx]
        simp [hAn, indicator_of_notMem hx]
    refine ne_top_of_le_ne_top ?_ (lintegral_mono hle)
    rw [lintegral_indicator_const measurableSet_closedBall]
    exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by norm_num)
      (ENNReal.natCast_ne_top n)) measure_closedBall_lt_top.ne
  have key : ∀ n, ∫⁻ x, An n x ^ (2 : ℝ) ≤ K ^ (2 : ℝ) := by
    intro n
    set J := ∫⁻ x, An n x ^ (2 : ℝ) with hJ
    set r := J ^ (1 / 2 : ℝ) with hr
    have hJr : J = r ^ (2 : ℝ) := by rw [hr, ← ENNReal.rpow_mul]; norm_num
    have h1 : J ≤ K * r := by
      refine le_trans ?_ (hK _ (hAn_meas n) (hAn_ne_top n))
      refine lintegral_mono fun x => ?_
      rw [ENNReal.rpow_two, sq]
      exact mul_le_mul_right (hAn_le n x) _
    have hr_top : r ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by norm_num) (hAn_fin n)
    have hrK : r ≤ K := by
      by_cases hr0 : r = 0
      · rw [hr0]; exact zero_le
      rw [hJr, ENNReal.rpow_two, sq] at h1
      exact (ENNReal.mul_le_mul_iff_left hr0 hr_top).1 h1
    rw [hJr]; exact ENNReal.rpow_le_rpow hrK (by norm_num)
  have hmono : Monotone fun n x => An n x ^ (2 : ℝ) := by
    intro n m hnm x
    refine ENNReal.rpow_le_rpow ?_ (by norm_num)
    have hnm' : (n : ℝ) ≤ m := by exact_mod_cast hnm
    by_cases hx : x ∈ Metric.closedBall (0 : ℝ²) n
    · have hx' : x ∈ Metric.closedBall (0 : ℝ²) m := Metric.closedBall_subset_closedBall hnm' hx
      simp only [hAn, indicator_of_mem hx, indicator_of_mem hx']
      exact min_le_min le_rfl (by exact_mod_cast hnm)
    · simp [hAn, indicator_of_notMem hx]
  have hpt : ∀ x, A x ≤ ⨆ n, An n x := by
    intro x
    have : A x = ⨆ n : ℕ, min (A x) n := by
      refine le_antisymm ?_ (iSup_le fun n => min_le_left _ _)
      by_cases hAx : A x = ⊤
      · rw [hAx]; simp [ENNReal.iSup_natCast]
      · obtain ⟨n, hn⟩ := ENNReal.exists_nat_gt hAx
        exact le_iSup_of_le n (le_min le_rfl hn.le)
    rw [this]
    refine iSup_le fun n => le_iSup_of_le (max n ⌈‖x‖⌉₊) ?_
    have hx : x ∈ Metric.closedBall (0 : ℝ²) (max n ⌈‖x‖⌉₊ : ℕ) := by
      rw [Metric.mem_closedBall, dist_zero_right]
      calc ‖x‖ ≤ ⌈‖x‖⌉₊ := Nat.le_ceil _
        _ ≤ _ := by exact_mod_cast le_max_right _ _
    simp only [hAn, indicator_of_mem hx]
    exact min_le_min le_rfl (by exact_mod_cast le_max_left _ _)
  have hsup : ∫⁻ x, A x ^ (2 : ℝ) ≤ K ^ (2 : ℝ) := by
    calc ∫⁻ x, A x ^ (2 : ℝ) ≤ ∫⁻ x, ⨆ n, An n x ^ (2 : ℝ) := by
          refine lintegral_mono fun x => ?_
          simp_rw [ENNReal.rpow_two]
          rw [← ENNReal.iSup_pow]
          exact pow_le_pow_left' (hpt x) 2
      _ = ⨆ n, ∫⁻ x, An n x ^ (2 : ℝ) :=
          lintegral_iSup (fun n => (hAn_meas n).pow_const _) hmono
      _ ≤ K ^ (2 : ℝ) := iSup_le key
  calc (∫⁻ x, A x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤ (K ^ (2 : ℝ)) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow hsup (by norm_num)
    _ = K := by rw [← ENNReal.rpow_mul]; norm_num

/-! ### Measure preservation of the vertex maps (`lem:geometry`, part 4) -/

/-- **Lemma `lem:geometry`** (part 4). For each $j$ the map
$(x,\theta)\mapsto(\pi_j(x,\theta),\theta)$ preserves $\mu$. -/
theorem lem_geometry_measurePreserving (α β : ℝ) (j : Fin 3) :
    MeasurePreserving (fun p : ℝ² × Ang => (proj α β j p, p.2)) μinc μinc := by
  have hc : Measurable fun θ : Ang => Lv α β j (u θ) :=
    (Lv α β j).continuous.measurable.comp aux_lw_u_meas
  have hsk : MeasurePreserving (fun q : Ang × ℝ² => (q.1, q.2 + Lv α β j (u q.1)))
      (σ.prod (volume : Measure ℝ²)) (σ.prod volume) := by
    refine (MeasurePreserving.id σ).skew_product (g := fun θ x => x + Lv α β j (u θ))
      (measurable_snd.add (hc.comp measurable_fst)) (Eventually.of_forall fun θ => ?_)
    exact (measurePreserving_add_right volume _).map_eq
  exact (Measure.measurePreserving_swap (μ := σ) (ν := (volume : Measure ℝ²))).comp
    (hsk.comp (Measure.measurePreserving_swap (μ := (volume : Measure ℝ²)) (ν := σ)))

/-! ### Finite complex measures and the counting form (`def:form`) -/

/-- The norm $\|\Lambda_\nu\|=\|\Lambda_\nu\|_2$, the `L² × L² × L^∞` operator norm
(`\label{def:form}`). -/
def formNorm (α β : ℝ) (ν : FCMeasure) : ℝ≥0∞ := endNorm α β ν 2

/-- The exponent of an endpoint slot: `∞` at the bounded slot `i`, `2` elsewhere
(auxiliary notation for `lem:form-basic`). -/
@[nolint defsWithUnderscore]
def aux_slotExp (i j : Fin 3) : ℝ≥0∞ := if j = i then ⊤ else 2

/-- Auxiliary for `lem:form-basic`: Hölder's inequality for three functions with exponents
`aux_slotExp i`, i.e. `∞` in slot `i` and `2` in the other two slots. -/
lemma aux_fb_slice (i : Fin 3) (g : Fin 3 → ℝ² → ℂ)
    (hg : ∀ j, AEStronglyMeasurable (g j) volume) :
    ∫⁻ x, ‖g 0 x‖ₑ * ‖g 1 x‖ₑ * ‖g 2 x‖ₑ ≤
      ∏ j : Fin 3, eLpNorm (g j) (aux_slotExp i j) volume := by
  have hb : ∀ j, ∀ᵐ x ∂(volume : Measure ℝ²), ‖g j x‖ₑ ≤ eLpNorm (g j) ⊤ volume := by
    intro j; rw [eLpNorm_exponent_top]; exact ae_le_eLpNormEssSup
  rw [Fin.prod_univ_three]
  fin_cases i
  · simp only [aux_slotExp, Fin.zero_eta, Fin.isValue, if_true,
      show ((1 : Fin 3) = 0) = False by decide, show ((2 : Fin 3) = 0) = False by decide, if_false]
    calc ∫⁻ x, ‖g 0 x‖ₑ * ‖g 1 x‖ₑ * ‖g 2 x‖ₑ
        ≤ ∫⁻ x, eLpNorm (g 0) ⊤ volume * (‖g 1 x‖ₑ * ‖g 2 x‖ₑ) := by
          refine lintegral_mono_ae ?_
          filter_upwards [hb 0] with x hx
          rw [mul_assoc]; gcongr
      _ = eLpNorm (g 0) ⊤ volume * ∫⁻ x, ‖g 1 x‖ₑ * ‖g 2 x‖ₑ :=
          lintegral_const_mul'' _ ((hg 1).enorm.mul (hg 2).enorm)
      _ ≤ _ := by rw [mul_assoc]; gcongr; exact aux_s2a_holder (hg 1) (hg 2) 2 2
  · simp only [aux_slotExp, Fin.mk_one, Fin.isValue, if_true,
      show ((0 : Fin 3) = 1) = False by decide, show ((2 : Fin 3) = 1) = False by decide, if_false]
    calc ∫⁻ x, ‖g 0 x‖ₑ * ‖g 1 x‖ₑ * ‖g 2 x‖ₑ
        ≤ ∫⁻ x, eLpNorm (g 1) ⊤ volume * (‖g 0 x‖ₑ * ‖g 2 x‖ₑ) := by
          refine lintegral_mono_ae ?_
          filter_upwards [hb 1] with x hx
          rw [mul_comm (‖g 0 x‖ₑ), mul_assoc]; gcongr
      _ = eLpNorm (g 1) ⊤ volume * ∫⁻ x, ‖g 0 x‖ₑ * ‖g 2 x‖ₑ :=
          lintegral_const_mul'' _ ((hg 0).enorm.mul (hg 2).enorm)
      _ ≤ eLpNorm (g 1) ⊤ volume * (eLpNorm (g 0) 2 volume * eLpNorm (g 2) 2 volume) := by
          gcongr; exact aux_s2a_holder (hg 0) (hg 2) 2 2
      _ = _ := by ring
  · simp only [aux_slotExp, Fin.reduceFinMk, Fin.isValue, if_true,
      show ((0 : Fin 3) = 2) = False by decide, show ((1 : Fin 3) = 2) = False by decide, if_false]
    calc ∫⁻ x, ‖g 0 x‖ₑ * ‖g 1 x‖ₑ * ‖g 2 x‖ₑ
        ≤ ∫⁻ x, eLpNorm (g 2) ⊤ volume * (‖g 0 x‖ₑ * ‖g 1 x‖ₑ) := by
          refine lintegral_mono_ae ?_
          filter_upwards [hb 2] with x hx
          rw [mul_comm]; gcongr
      _ = eLpNorm (g 2) ⊤ volume * ∫⁻ x, ‖g 0 x‖ₑ * ‖g 1 x‖ₑ :=
          lintegral_const_mul'' _ ((hg 0).enorm.mul (hg 1).enorm)
      _ ≤ eLpNorm (g 2) ⊤ volume * (eLpNorm (g 0) 2 volume * eLpNorm (g 1) 2 volume) := by
          gcongr; exact aux_s2a_holder (hg 0) (hg 1) 2 2
      _ = _ := by ring

/-- Auxiliary for `lem:form-basic`: the slice bound
`∫ |f₀(x) f₁(x+a) f₂(x+b)| dx ≤ ∏_j ‖f_j‖_{p_j}` with `p = aux_slotExp i`. -/
lemma aux_fb_inner (i : Fin 3) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) (a b : ℝ²) :
    ∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + a)‖ₑ * ‖f 2 (x + b)‖ₑ ≤
      ∏ j : Fin 3, eLpNorm (f j) (aux_slotExp i j) volume := by
  have hmp := fun c : ℝ² => measurePreserving_add_right (volume : Measure ℝ²) c
  have h := aux_fb_slice i ![f 0, fun x => f 1 (x + a), fun x => f 2 (x + b)] (by
    intro j; fin_cases j
    · exact hf 0
    · exact (hf 1).comp_quasiMeasurePreserving (hmp a).quasiMeasurePreserving
    · exact (hf 2).comp_quasiMeasurePreserving (hmp b).quasiMeasurePreserving)
  simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] at h ⊢
  have e1 : ∀ (j : Fin 3) (c : ℝ²) (p : ℝ≥0∞), eLpNorm (fun x => f j (x + c)) p volume =
      eLpNorm (f j) p volume := fun j c p => eLpNorm_comp_measurePreserving (hf j) (hmp c)
  rwa [e1, e1] at h

/-- Auxiliary for `lem:form-basic`: a shear `(z, x) ↦ x + c z` is quasi-measure-preserving from
`m ⊗ dx` to `dx`. -/
lemma aux_fb_qmp {Z : Type*} [MeasurableSpace Z] (m : Measure Z) (c : Z → ℝ²)
    (hc : Measurable c) :
    Measure.QuasiMeasurePreserving (fun p : Z × ℝ² => p.2 + c p.1) (m.prod volume) volume := by
  have hmeas : Measurable (fun p : Z × ℝ² => p.2 + c p.1) :=
    measurable_snd.add (hc.comp measurable_fst)
  refine ⟨hmeas, ?_⟩
  refine Measure.AbsolutelyContinuous.mk fun s hs h0 => ?_
  rw [Measure.map_apply hmeas hs, Measure.prod_apply (measurableSet_preimage hmeas hs)]
  have : ∀ z : Z, (volume : Measure ℝ²)
      (Prod.mk z ⁻¹' ((fun p : Z × ℝ² => p.2 + c p.1) ⁻¹' s)) = 0 := by
    intro z
    have := measure_preimage_add_right (volume : Measure ℝ²) (c z) s
    simp only [Set.preimage_preimage]
    rw [this, h0]
  simp [this]

/-- Auxiliary for `lem:form-basic`: a.e.-strong measurability of the integrand of the form on
`m ⊗ dx`. -/
lemma aux_fb_aesm (α β : ℝ) (ν : FCMeasure) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) :
    AEStronglyMeasurable (fun p : ν.Z × ℝ² => f 0 p.2 * f 1 (p.2 + ν.φ p.1) *
      f 2 (p.2 + M α β (ν.φ p.1)) * ν.w p.1) (ν.m.prod volume) := by
  have a0 := (hf 0).comp_quasiMeasurePreserving
    (Measure.quasiMeasurePreserving_snd (μ := ν.m) (ν := (volume : Measure ℝ²)))
  have a1 := (hf 1).comp_quasiMeasurePreserving (aux_fb_qmp ν.m ν.φ ν.measurable_φ)
  have a2 := (hf 2).comp_quasiMeasurePreserving (aux_fb_qmp ν.m (fun z => M α β (ν.φ z))
    ((M α β).continuous.measurable.comp ν.measurable_φ))
  have a3 := ν.integrable_w.1.comp_quasiMeasurePreserving
    (Measure.quasiMeasurePreserving_fst (μ := ν.m) (ν := (volume : Measure ℝ²)))
  exact ((a0.mul a1).mul a2).mul a3

/-- Auxiliary for `lem:form-basic`: the absolute bound
`∫∫ |f₀(x) f₁(x+u) f₂(x+Mu)| dx d|ν|(u) ≤ ‖ν‖_TV ∏_j ‖f_j‖_{p_j}`. -/
lemma aux_fb_abs (α β : ℝ) (ν : FCMeasure) (i : Fin 3) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) :
    ∫⁻ z, (∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + ν.φ z)‖ₑ * ‖f 2 (x + M α β (ν.φ z))‖ₑ) * ‖ν.w z‖ₑ ∂ν.m ≤
      ν.tv * ∏ j : Fin 3, eLpNorm (f j) (aux_slotExp i j) volume := by
  calc _ ≤ ∫⁻ z, (∏ j : Fin 3, eLpNorm (f j) (aux_slotExp i j) volume) * ‖ν.w z‖ₑ ∂ν.m :=
        lintegral_mono fun z => mul_le_mul_left (aux_fb_inner i f hf _ _) _
    _ = _ := by
        rw [lintegral_const_mul'' _ ν.integrable_w.1.enorm, FCMeasure.tv, mul_comm]

/-! ### Basic endpoint bounds (`lem:form-basic`) -/

/-- **Lemma `lem:form-basic`** (absolute convergence). For each endpoint permutation the
defining integral is absolutely convergent. -/
theorem lem_form_basic_integrable (α β : ℝ) (ν : FCMeasure) (i : Fin 3) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, MemLp (f j) (aux_slotExp i j) volume) :
    Integrable (fun p : ν.Z × ℝ² => f 0 p.2 * f 1 (p.2 + ν.φ p.1) *
      f 2 (p.2 + M α β (ν.φ p.1)) * ν.w p.1) (ν.m.prod volume) := by
  have hm := aux_fb_aesm α β ν f fun j => (hf j).1
  refine ⟨hm, ?_⟩
  rw [HasFiniteIntegral, lintegral_prod _ hm.enorm]
  refine lt_of_le_of_lt (b := ν.tv * ∏ j : Fin 3, eLpNorm (f j) (aux_slotExp i j) volume) ?_
    (ENNReal.mul_lt_top ν.integrable_w.2 (ENNReal.prod_lt_top fun j _ => (hf j).2))
  refine le_trans (le_of_eq ?_) (aux_fb_abs α β ν i f fun j => (hf j).1)
  refine lintegral_congr fun z => ?_
  simp only [enorm_mul]
  rw [lintegral_mul_const'' _ ?_]
  have hmp := fun c : ℝ² => measurePreserving_add_right (volume : Measure ℝ²) c
  exact (((hf 0).1.enorm.mul ((hf 1).1.comp_quasiMeasurePreserving
    (hmp _).quasiMeasurePreserving).enorm).mul ((hf 2).1.comp_quasiMeasurePreserving
    (hmp _).quasiMeasurePreserving).enorm)

/-- **Lemma `lem:form-basic`** (bound).
$|\Lambda_\nu(f_0,f_1,f_2)|\le\|\nu\|_{\mathrm{TV}}\|f_i\|_\infty\prod_{j\ne i}\|f_j\|_2$. -/
theorem lem_form_basic_bound (α β : ℝ) (ν : FCMeasure) (i : Fin 3) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) :
    ‖form α β ν (f 0) (f 1) (f 2)‖ₑ ≤
      ν.tv * ∏ j : Fin 3, eLpNorm (f j) (aux_slotExp i j) volume := by
  refine le_trans ?_ (aux_fb_abs α β ν i f hf)
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun z => ?_)
  rw [enorm_mul]
  refine mul_le_mul_left ((enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)) _
  simp [enorm_mul]

/-- Auxiliary for `lem:form-basic`: the form is trilinear with respect to scalar factors. -/
lemma aux_fb_form_smul (α β : ℝ) (ν : FCMeasure) (c : Fin 3 → ℂ) (f : Fin 3 → ℝ² → ℂ) :
    form α β ν (fun x => c 0 * f 0 x) (fun x => c 1 * f 1 x) (fun x => c 2 * f 2 x) =
      c 0 * c 1 * c 2 * form α β ν (f 0) (f 1) (f 2) := by
  unfold form
  have h : ∀ z, (∫ x, c 0 * f 0 x * (c 1 * f 1 (x + ν.φ z)) * (c 2 * f 2 (x + M α β (ν.φ z)))) *
      ν.w z = c 0 * c 1 * c 2 *
        ((∫ x, f 0 x * f 1 (x + ν.φ z) * f 2 (x + M α β (ν.φ z))) * ν.w z) := by
    intro z
    rw [← mul_assoc, ← integral_const_mul]
    congr 2; funext x; ring
  simp_rw [h]
  exact integral_const_mul _ _

/-- Auxiliary for `lem:form-basic` (scaling): the substitutions `x = s y`, `u = s v`, i.e.
`Λ_{ν_s}(f₀(·/s), f₁(·/s), f₂(·/s)) = s² Λ_ν(f₀, f₁, f₂)`. -/
lemma aux_fb_form_dil (α β : ℝ) (ν : FCMeasure) (s : ℝ) (hs : 0 < s) (f : Fin 3 → ℝ² → ℂ) :
    form α β (ν.dil s) (fun x => f 0 (s⁻¹ • x)) (fun x => f 1 (s⁻¹ • x))
      (fun x => f 2 (s⁻¹ • x)) = ((s ^ 2 : ℝ) : ℂ) * form α β ν (f 0) (f 1) (f 2) := by
  unfold form
  rw [← integral_const_mul]
  congr 1; funext z
  rw [← mul_assoc]; congr 1
  have h := Measure.integral_comp_inv_smul (μ := (volume : Measure ℝ²))
    (fun y => f 0 y * f 1 (y + ν.φ z) * f 2 (y + M α β (ν.φ z))) s
  rw [finrank_euclideanSpace_fin, abs_of_nonneg (by positivity), Complex.real_smul] at h
  rw [← h]
  congr 1; funext x
  simp only [FCMeasure.dil, map_smul, smul_add, inv_smul_smul₀ hs.ne']

/-- Auxiliary for `lem:form-basic` (scaling): the endpoint norm does not decrease under
dilation, `‖Λ_ν‖_i ≤ ‖Λ_{ν_s}‖_i` (see `Auto.lem_form_basic_scaling`). -/
lemma aux_fb_endNorm_le_dil (α β : ℝ) (ν : FCMeasure) (i : Fin 3) (s : ℝ) (hs : 0 < s) :
    endNorm α β ν i ≤ endNorm α β (ν.dil s) i := by
  unfold endNorm
  refine iSup_le fun f => iSup_le fun hf => iSup_le fun hi => iSup_le fun hj => ?_
  set c : Fin 3 → ℂ := fun j => if j = i then 1 else ((s⁻¹ : ℝ) : ℂ) with hc
  set g : Fin 3 → ℝ² → ℂ := fun j x => c j * f j (s⁻¹ • x) with hg
  have hqmp : Measure.QuasiMeasurePreserving (fun x : ℝ² => s⁻¹ • x) volume volume :=
    Measure.quasiMeasurePreserving_smul volume (inv_ne_zero hs.ne')
  have hgm : ∀ j, AEStronglyMeasurable (g j) volume := fun j =>
    ((hf j).comp_quasiMeasurePreserving hqmp).const_mul _
  have hnorm : ∀ j, eLpNorm (g j) (aux_slotExp i j) volume =
      eLpNorm (f j) (aux_slotExp i j) volume := by
    intro j
    have e1 : eLpNorm (g j) (aux_slotExp i j) volume =
        ‖c j‖ₑ * eLpNorm (fun x => f j (s⁻¹ • x)) (aux_slotExp i j) volume :=
      eLpNorm_const_smul (c j) (fun x => f j (s⁻¹ • x)) _ _
    rw [e1, aux_s2a_eLpNorm_comp_smul (f j) s⁻¹ (inv_ne_zero hs.ne')]
    by_cases hji : j = i
    · simp [hc, hji, aux_slotExp]
    · simp only [hc, hji, aux_slotExp, if_false]
      rw [← mul_assoc]
      convert one_mul (eLpNorm (f j) 2 volume) using 2
      rw [inv_pow, abs_of_nonneg (by positivity), inv_inv, ENNReal.ofReal_pow hs.le]
      simp only [one_div, ENNReal.toReal_inv, ENNReal.toReal_ofNat]
      rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
      norm_num
      have hen : ‖(s : ℂ)⁻¹‖ₑ = ENNReal.ofReal s⁻¹ := by
        rw [← ofReal_norm, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs]
      rw [hen, ← ENNReal.ofReal_mul (by positivity), inv_mul_cancel₀ hs.ne', ENNReal.ofReal_one]
  have hval : form α β (ν.dil s) (g 0) (g 1) (g 2) = form α β ν (f 0) (f 1) (f 2) := by
    rw [hg]
    simp only
    rw [aux_fb_form_smul α β (ν.dil s) c (fun j x => f j (s⁻¹ • x)),
      aux_fb_form_dil α β ν s hs f, ← mul_assoc]
    convert one_mul _
    have hs' : (s : ℂ) ≠ 0 := by exact_mod_cast hs.ne'
    fin_cases i <;> simp [hc] <;> field_simp
  have hni : eLpNorm (g i) ⊤ volume = eLpNorm (f i) ⊤ volume := by
    simpa [aux_slotExp] using hnorm i
  have hnj : ∀ j, j ≠ i → eLpNorm (g j) 2 volume = eLpNorm (f j) 2 volume := fun j hji => by
    simpa [aux_slotExp, hji] using hnorm j
  refine le_iSup_of_le g (le_iSup_of_le hgm (le_iSup_of_le (by rw [hni]; exact hi)
    (le_iSup_of_le (fun j hji => by rw [hnj j hji]; exact hj j hji) ?_)))
  rw [hval]

/-- **Lemma `lem:form-basic`** (scaling). $\|\Lambda_{\nu_s}\|_i=\|\Lambda_\nu\|_i$ for $s>0$. -/
theorem lem_form_basic_scaling (α β : ℝ) (ν : FCMeasure) (i : Fin 3) (s : ℝ) (hs : 0 < s) :
    endNorm α β (ν.dil s) i = endNorm α β ν i := by
  refine le_antisymm ?_ (aux_fb_endNorm_le_dil α β ν i s hs)
  refine (aux_fb_endNorm_le_dil α β (ν.dil s) i s⁻¹ (inv_pos.2 hs)).trans (le_of_eq ?_)
  unfold endNorm form
  simp only [FCMeasure.dil, smul_smul, inv_mul_cancel₀ hs.ne', one_smul]
  rfl

/-- **Lemma `lem:form-basic`** (versions). The form does not depend on the choice of
almost-everywhere versions of its inputs.
(In Lean the blueprint hypothesis `(hβ : β ≠ 0)` is omitted since the proof does not need it; see
`automation/ErrorReport.md`.) -/
theorem lem_form_basic_ae (α β : ℝ) (ν : FCMeasure) (f g : Fin 3 → ℝ² → ℂ)
    (hfg : ∀ j, f j =ᵐ[volume] g j) :
    form α β ν (f 0) (f 1) (f 2) = form α β ν (g 0) (g 1) (g 2) := by
  unfold form
  congr 1; funext z; congr 1
  refine integral_congr_ae ?_
  have hmp := fun c : ℝ² =>
    (measurePreserving_add_right (volume : Measure ℝ²) c).quasiMeasurePreserving
  filter_upwards [hfg 0, (hmp (ν.φ z)).ae_eq (hfg 1), (hmp (M α β (ν.φ z))).ae_eq (hfg 2)]
    with x h0 h1 h2
  simp only [Function.comp] at h1 h2
  rw [h0, h1, h2]

/-- **Lemma `lem:form-basic`** (translation). Simultaneously translating all inputs leaves the
form unchanged. -/
theorem lem_form_basic_translate (α β : ℝ) (ν : FCMeasure) (f : Fin 3 → ℝ² → ℂ) (a : ℝ²) :
    form α β ν (fun x => f 0 (x + a)) (fun x => f 1 (x + a)) (fun x => f 2 (x + a)) =
      form α β ν (f 0) (f 1) (f 2) := by
  unfold form
  congr 1; funext z; congr 1
  have := integral_add_right_eq_self (μ := (volume : Measure ℝ²))
    (fun x => f 0 x * f 1 (x + ν.φ z) * f 2 (x + M α β (ν.φ z))) a
  rw [← this]
  congr 1; funext x
  simp only [add_right_comm _ a]

/-! ### Convolution as translations of the inputs (`lem:convolution-translate`) -/

/-- **Lemma `lem:convolution-translate`** (identity). For finite measures $\nu,\kappa$ and
endpoint inputs,
$$\Lambda_{\nu*\kappa}(f_0,f_1,f_2)=
\int\Lambda_\nu\big(f_0,f_1(\cdot+w),f_2(\cdot+Mw)\big)\,d\kappa(w).$$ -/
theorem lem_convolution_translate (α β : ℝ) (ν κ : FCMeasure) (i : Fin 3) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, MemLp (f j) (aux_slotExp i j) volume) :
    form α β (ν.conv κ) (f 0) (f 1) (f 2) =
      κ.integral (fun w =>
        form α β ν (f 0) (fun x => f 1 (x + w)) (fun x => f 2 (x + M α β w))) := by
  have hI := (lem_form_basic_integrable α β (ν.conv κ) i f hf).integral_prod_left
  have hI' : Integrable (fun z : ν.Z × κ.Z =>
      (∫ x, f 0 x * f 1 (x + (ν.φ z.1 + κ.φ z.2)) * f 2 (x + M α β (ν.φ z.1 + κ.φ z.2))) *
        (ν.w z.1 * κ.w z.2)) (ν.m.prod κ.m) := by
    refine hI.congr (Eventually.of_forall fun z => ?_)
    exact integral_mul_const (ν.w z.1 * κ.w z.2)
      (fun x => f 0 x * f 1 (x + (ν.φ z.1 + κ.φ z.2)) * f 2 (x + M α β (ν.φ z.1 + κ.φ z.2)))
  unfold form FCMeasure.integral
  change ∫ z : ν.Z × κ.Z,
      (∫ x, f 0 x * f 1 (x + (ν.φ z.1 + κ.φ z.2)) * f 2 (x + M α β (ν.φ z.1 + κ.φ z.2))) *
        (ν.w z.1 * κ.w z.2) ∂(ν.m.prod κ.m) = _
  rw [integral_prod_symm _ hI']
  congr 1; funext z₂
  rw [← integral_mul_const]
  congr 1; funext z₁
  simp only [map_add, add_assoc]
  ring

/-- Auxiliary for `lem:convolution-translate`: `|∫ g dκ| ≤ ‖κ‖_TV sup |g|`. -/
lemma aux_ct_integral_bound (κ : FCMeasure) (g : ℝ² → ℂ) (B : ℝ≥0∞)
    (hg : ∀ w, ‖g w‖ₑ ≤ B) : ‖κ.integral g‖ₑ ≤ κ.tv * B := by
  unfold FCMeasure.integral
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  calc ∫⁻ z, ‖g (κ.φ z) * κ.w z‖ₑ ∂κ.m ≤ ∫⁻ z, B * ‖κ.w z‖ₑ ∂κ.m :=
        lintegral_mono fun z => by rw [enorm_mul]; exact mul_le_mul_left (hg _) _
    _ = κ.tv * B := by
        rw [lintegral_const_mul'' _ κ.integrable_w.1.enorm, FCMeasure.tv, mul_comm]

/-- Auxiliary for `lem:convolution-translate`: the general inheritance of translation-invariant
bounds (this is `Auto.lem_convolution_translate_general`, stated before the norm bound
`Auto.lem_convolution_translate_norm`, which uses it). -/
lemma aux_ct_general (α β : ℝ) (ν κ : FCMeasure) (i : Fin 3)
    (P : (Fin 3 → ℝ² → ℂ) → Prop) (hP : ∀ f, P f → ∀ j, MemLp (f j) (aux_slotExp i j) volume)
    (hPinv : ∀ f, P f → ∀ w : ℝ², P ![f 0, fun x => f 1 (x + w), fun x => f 2 (x + M α β w)])
    (B : ℝ≥0∞) (hB : ∀ f, P f → ‖form α β ν (f 0) (f 1) (f 2)‖ₑ ≤ B) (f : Fin 3 → ℝ² → ℂ)
    (hf : P f) :
    ‖form α β (ν.conv κ) (f 0) (f 1) (f 2)‖ₑ ≤ κ.tv * B := by
  rw [lem_convolution_translate α β ν κ i f (hP f hf)]
  refine aux_ct_integral_bound κ _ B fun w => ?_
  simpa using hB _ (hPinv f hf w)

/-- **Lemma `lem:convolution-translate`** (norm bound).
$\|\Lambda_{\nu*\kappa}\|_i\le\|\kappa\|_{\mathrm{TV}}\|\Lambda_\nu\|_i$. -/
theorem lem_convolution_translate_norm (α β : ℝ) (ν κ : FCMeasure) (i : Fin 3) :
    endNorm α β (ν.conv κ) i ≤ κ.tv * endNorm α β ν i := by
  conv_lhs => unfold endNorm
  refine iSup_le fun f => iSup_le fun hf => iSup_le fun hi => iSup_le fun hj => ?_
  let P : (Fin 3 → ℝ² → ℂ) → Prop := fun g => (∀ j, AEStronglyMeasurable (g j) volume) ∧
    eLpNorm (g i) ⊤ volume ≤ 1 ∧ ∀ j, j ≠ i → eLpNorm (g j) 2 volume ≤ 1
  have hmp := fun c : ℝ² => measurePreserving_add_right (volume : Measure ℝ²) c
  refine aux_ct_general α β ν κ i P ?_ ?_ (endNorm α β ν i) ?_ f ⟨hf, hi, hj⟩
  · rintro g ⟨hg, hgi, hgj⟩ j
    refine ⟨hg j, ?_⟩
    by_cases hji : j = i
    · subst hji; simp only [aux_slotExp, if_true]; exact hgi.trans_lt ENNReal.one_lt_top
    · simp only [aux_slotExp, hji, if_false]; exact (hgj j hji).trans_lt ENNReal.one_lt_top
  · rintro g ⟨hg, hgi, hgj⟩ w
    have hm : ∀ j, AEStronglyMeasurable
        (![g 0, fun x => g 1 (x + w), fun x => g 2 (x + M α β w)] j) volume := by
      intro j; fin_cases j
      · exact hg 0
      · exact (hg 1).comp_quasiMeasurePreserving (hmp w).quasiMeasurePreserving
      · exact (hg 2).comp_quasiMeasurePreserving (hmp _).quasiMeasurePreserving
    have hn : ∀ j (p : ℝ≥0∞), eLpNorm
        (![g 0, fun x => g 1 (x + w), fun x => g 2 (x + M α β w)] j) p volume =
        eLpNorm (g j) p volume := by
      intro j p; fin_cases j
      · rfl
      · exact eLpNorm_comp_measurePreserving (hg 1) (hmp w)
      · exact eLpNorm_comp_measurePreserving (hg 2) (hmp _)
    exact ⟨hm, by rw [hn]; exact hgi, fun j hji => by rw [hn]; exact hgj j hji⟩
  · intro g hg
    unfold endNorm
    exact le_iSup_of_le g (le_iSup_of_le hg.1 (le_iSup_of_le hg.2.1 (le_iSup_of_le hg.2.2 le_rfl)))

/-- **Lemma `lem:convolution-translate`** (general translation-invariant bounds). Any
translation-invariant norm bound for the inputs of $\Lambda_\nu$ is inherited by
$\Lambda_{\nu*\kappa}$, with the extra factor $\|\kappa\|_{\mathrm{TV}}$. Here the class of
admissible input triples `P` (endpoint inputs) is invariant under the translations
$(f_0,f_1,f_2)\mapsto(f_0,f_1(\cdot+w),f_2(\cdot+Mw))$. -/
theorem lem_convolution_translate_general (α β : ℝ) (ν κ : FCMeasure) (i : Fin 3)
    (P : (Fin 3 → ℝ² → ℂ) → Prop) (hP : ∀ f, P f → ∀ j, MemLp (f j) (aux_slotExp i j) volume)
    (hPinv : ∀ f, P f → ∀ w : ℝ², P ![f 0, fun x => f 1 (x + w), fun x => f 2 (x + M α β w)])
    (B : ℝ≥0∞) (hB : ∀ f, P f → ‖form α β ν (f 0) (f 1) (f 2)‖ₑ ≤ B) (f : Fin 3 → ℝ² → ℂ)
    (hf : P f) :
    ‖form α β (ν.conv κ) (f 0) (f 1) (f 2)‖ₑ ≤ κ.tv * B := by
  exact aux_ct_general α β ν κ i P hP hPinv B hB f hf

/-! ### Exponential and frequency-scale notation (`def:fourier`) -/

/-- The rescaling $h_R(u)=R^2h(Ru)$ (part of `\label{def:fourier}`; the exponential
$\mathrm e(t)=\exp(2\pi it)$ is `Auto.e`). -/
def scaleR (R : ℝ) (h : ℝ² → ℂ) (u : ℝ²) : ℂ := (R ^ 2 : ℝ) * h (R • u)

/-! ### Fourier representation (`lem:fourier-form`) -/

/-- Auxiliary for `lem:fourier-form`: the adjoint of `M = αI + βJ` is `Mᵀ = αI - βJ`. -/
lemma aux_ff_adjoint (α β : ℝ) : ContinuousLinearMap.adjoint (M α β) = aux_MT α β := by
  ext1 ξ
  refine ext_inner_right ℝ fun y => ?_
  rw [ContinuousLinearMap.adjoint_inner_left, aux_s2a_inner_MT]

/-- Auxiliary for `lem:fourier-form`: the Fourier transform of a presented measure written with
the character `e`. -/
lemma aux_ff_fourier_e (ν : FCMeasure) (b : ℝ²) :
    ν.fourier b = ∫ z, e (-⟪ν.φ z, b⟫_ℝ) * ν.w z ∂ν.m := by
  unfold FCMeasure.fourier FCMeasure.integral e
  congr 1; funext z; congr 2; push_cast; ring_nf

/-- Auxiliary for `lem:fourier-form`: the integrand on `(Z × ℝ²) × (ℝ² × ℝ²)` obtained by
Fourier inversion of the last two inputs. -/
@[nolint defsWithUnderscore]
def aux_ff_Phi (α β : ℝ) (ν : FCMeasure) (f₀ F₁ G : ℝ² → ℂ)
    (P : (ν.Z × ℝ²) × (ℝ² × ℝ²)) : ℂ :=
  (ν.w P.1.1 * f₀ P.1.2) * (F₁ P.2.1 * G P.2.2) *
    (e ⟪P.2.1, P.1.2 + ν.φ P.1.1⟫_ℝ * e ⟪P.2.2, P.1.2 + M α β (ν.φ P.1.1)⟫_ℝ)

/-- Auxiliary for `lem:fourier-form`: integrability of `aux_ff_Phi`. -/
lemma aux_ff_Phi_integrable (α β : ℝ) (ν : FCMeasure) {f₀ F₁ G : ℝ² → ℂ}
    (h₀ : Integrable f₀) (h₁ : Integrable F₁) (hG : Integrable G) :
    Integrable (aux_ff_Phi α β ν f₀ F₁ G)
      ((ν.m.prod volume).prod ((volume : Measure ℝ²).prod volume)) := by
  have hA : Integrable (fun p : ν.Z × ℝ² => ν.w p.1 * f₀ p.2) (ν.m.prod volume) :=
    ν.integrable_w.mul_prod h₀
  have hB : Integrable (fun q : ℝ² × ℝ² => F₁ q.1 * G q.2)
      ((volume : Measure ℝ²).prod volume) := h₁.mul_prod hG
  have hAB := hA.mul_prod hB
  have hφ := ν.measurable_φ
  have he := aux_s2a_continuous_e.measurable
  refine (hAB.mul_bdd (c := 1) ?_ (Eventually.of_forall fun P => ?_))
  · refine Measurable.aestronglyMeasurable ?_
    refine (he.comp ?_).mul (he.comp ?_)
    · exact (measurable_fst.comp measurable_snd).inner
        ((measurable_snd.comp measurable_fst).add (hφ.comp (measurable_fst.comp measurable_fst)))
    · exact (measurable_snd.comp measurable_snd).inner
        ((measurable_snd.comp measurable_fst).add ((M α β).continuous.measurable.comp
          (hφ.comp (measurable_fst.comp measurable_fst))))
  · simp [aux_s2a_norm_e]

/-- Auxiliary for `lem:fourier-form`: `(ν * κ)^ = ν̂ κ̂`. -/
lemma aux_ff_conv_fourier (ν κ : FCMeasure) (ζ : ℝ²) :
    (ν.conv κ).fourier ζ = ν.fourier ζ * κ.fourier ζ := by
  rw [aux_ff_fourier_e, aux_ff_fourier_e, aux_ff_fourier_e]
  rw [← integral_prod_mul (μ := ν.m) (ν := κ.m)]
  change ∫ p : ν.Z × κ.Z, e (-⟪ν.φ p.1 + κ.φ p.2, ζ⟫_ℝ) * (ν.w p.1 * κ.w p.2) ∂(ν.m.prod κ.m) = _
  congr 1; funext p
  rw [inner_add_left, neg_add, ← aux_s2a_e_add]; ring

/-- Auxiliary for `lem:fourier-form`: `u_{θ+π} = -u_θ`. -/
lemma aux_ff_u_add_pi (θ : Ang) : u (θ + (π : Ang)) = -u θ := by
  induction θ using QuotientAddGroup.induction_on with
  | H t =>
    rw [← AddCircle.coe_add, aux_u_coe, aux_u_coe]
    ext i; fin_cases i <;> simp [aux_uR, Real.cos_add_pi, Real.sin_add_pi]

/-- Auxiliary for `lem:fourier-form`: `σ` is symmetric, so `σ̂(-b) = σ̂(b)`. -/
lemma aux_ff_sigma_even (b : ℝ²) : FCMeasure.sigma.fourier (-b) = FCMeasure.sigma.fourier b := by
  rw [aux_ff_fourier_e, aux_ff_fourier_e]
  change ∫ θ, e (-⟪u θ, -b⟫_ℝ) * 1 ∂σ = ∫ θ, e (-⟪u θ, b⟫_ℝ) * 1 ∂σ
  have h := integral_add_left_eq_self (μ := (AddCircle.haarAddCircle : Measure Ang))
    (fun θ => e (-⟪u θ, b⟫_ℝ) * 1) (π : Ang)
  rw [show σ = AddCircle.haarAddCircle from rfl, ← h]
  congr 1; funext θ
  simp only [add_comm (π : Ang), aux_ff_u_add_pi, inner_neg_left, inner_neg_right]

/-- Auxiliary for `lem:fourier-form`: for `ψ` smooth and compactly supported, the measure with
density `(ψ̌)_R` has Fourier transform `ψ(·/R)`. -/
lemma aux_ff_kernel_fourier (ψ : ℝ² → ℂ) (hψ : ContDiff ℝ (⊤ : ℕ∞) ψ)
    (hψc : HasCompactSupport ψ) (R : ℝ) (hR : 0 < R) (ζ : ℝ²) :
    (FCMeasure.ofDensity (scaleR R (𝓕⁻ ψ))).fourier ζ = ψ (R⁻¹ • ζ) := by
  set ψS : 𝓢(ℝ², ℂ) := hψc.toSchwartzMap hψ
  have hψS : (ψS : ℝ² → ℂ) = ψ := rfl
  have hinv : 𝓕⁻ ψ = ((𝓕⁻ ψS : 𝓢(ℝ², ℂ)) : ℝ² → ℂ) := by
    rw [SchwartzMap.fourierInv_coe, hψS]
  have hhi : Integrable (𝓕⁻ ψ) := by rw [hinv]; exact (𝓕⁻ ψS).integrable
  have hk : Integrable (scaleR R (𝓕⁻ ψ)) :=
    (hhi.comp_smul hR.ne').const_mul _
  have hFF : 𝓕 (𝓕⁻ ψ) = ψ := by
    rw [← hψS]
    exact ψS.continuous.fourier_fourierInv_eq ψS.integrable (by
      rw [← SchwartzMap.fourier_coe]; exact (𝓕 ψS).integrable)
  rw [aux_ff_fourier_e]
  have hw : (FCMeasure.ofDensity (scaleR R (𝓕⁻ ψ))).w = scaleR R (𝓕⁻ ψ) := by
    simp [FCMeasure.ofDensity, hk]
  rw [hw]
  change ∫ y, e (-⟪y, ζ⟫_ℝ) * scaleR R (𝓕⁻ ψ) y = ψ (R⁻¹ • ζ)
  set G : ℝ² → ℂ := fun v => e (-⟪v, R⁻¹ • ζ⟫_ℝ) * 𝓕⁻ ψ v
  have hG : ∀ y : ℝ², e (-⟪y, ζ⟫_ℝ) * scaleR R (𝓕⁻ ψ) y = ((R ^ 2 : ℝ) : ℂ) * G (R • y) := by
    intro y
    simp only [G, scaleR, inner_smul_left, inner_smul_right, RCLike.conj_to_real]
    rw [← mul_assoc R⁻¹, inv_mul_cancel₀ hR.ne', one_mul]; ring
  simp_rw [hG]
  rw [integral_const_mul, Measure.integral_comp_smul, finrank_euclideanSpace_fin,
    abs_of_nonneg (by positivity), Complex.real_smul, ← mul_assoc]
  push_cast
  rw [mul_inv_cancel₀ (by exact_mod_cast (pow_pos hR 2).ne'), one_mul]
  rw [← hFF, aux_s2a_fourier_e]

/-- **Lemma `lem:fourier-form`** (representation). For Schwartz inputs and a finite measure
$\nu$,
$$\Lambda_\nu(f_0,f_1,f_2)=\iint\widehat f_0(-\xi_1-\xi_2)\widehat f_1(\xi_1)\widehat f_2(\xi_2)
\,\widehat\nu(-\xi_1-M^T\xi_2)\,d\xi_1\,d\xi_2.$$ -/
theorem lem_fourier_form (α β : ℝ) (ν : FCMeasure) (f₀ f₁ f₂ : 𝓢(ℝ², ℂ)) :
    form α β ν f₀ f₁ f₂ =
      ∫ ξ : ℝ² × ℝ², 𝓕 (f₀ : ℝ² → ℂ) (-ξ.1 - ξ.2) * 𝓕 (f₁ : ℝ² → ℂ) ξ.1 *
        𝓕 (f₂ : ℝ² → ℂ) ξ.2 * ν.fourier (-ξ.1 - ContinuousLinearMap.adjoint (M α β) ξ.2) := by
  have hF₁ : Integrable (𝓕 (f₁ : ℝ² → ℂ)) := by
    rw [← SchwartzMap.fourier_coe]; exact (𝓕 f₁).integrable
  have hF₂ : Integrable (𝓕 (f₂ : ℝ² → ℂ)) := by
    rw [← SchwartzMap.fourier_coe]; exact (𝓕 f₂).integrable
  set Φ := aux_ff_Phi α β ν f₀ (𝓕 (f₁ : ℝ² → ℂ)) (𝓕 (f₂ : ℝ² → ℂ))
  have hΦ : Integrable Φ ((ν.m.prod volume).prod ((volume : Measure ℝ²).prod volume)) :=
    aux_ff_Phi_integrable α β ν f₀.integrable hF₁ hF₂
  have hL : ∀ z x, f₀ x * f₁ (x + ν.φ z) * f₂ (x + M α β (ν.φ z)) * ν.w z =
      ∫ q, Φ ((z, x), q) ∂((volume : Measure ℝ²).prod volume) := by
    intro z x
    have := integral_prod_mul (μ := (volume : Measure ℝ²)) (ν := (volume : Measure ℝ²))
      (fun ξ => e ⟪ξ, x + ν.φ z⟫_ℝ * 𝓕 (f₁ : ℝ² → ℂ) ξ)
      (fun η => e ⟪η, x + M α β (ν.φ z)⟫_ℝ * 𝓕 (f₂ : ℝ² → ℂ) η)
    rw [aux_s2a_inv_schwartz f₁ (x + ν.φ z), aux_s2a_inv_schwartz f₂ (x + M α β (ν.φ z)),
      show ∀ a b c d : ℂ, a * b * c * d = (b * c) * (d * a) from fun a b c d => by ring,
      ← this, ← integral_mul_const]
    congr 1; funext q
    simp only [Φ, aux_ff_Phi]; ring
  have hR : ∀ ξ η, ∫ p, Φ (p, (ξ, η)) ∂(ν.m.prod volume) =
      𝓕 (f₀ : ℝ² → ℂ) (-ξ - η) * 𝓕 (f₁ : ℝ² → ℂ) ξ * 𝓕 (f₂ : ℝ² → ℂ) η *
        ν.fourier (-ξ - ContinuousLinearMap.adjoint (M α β) η) := by
    intro ξ η
    have := integral_prod_mul (μ := ν.m) (ν := (volume : Measure ℝ²))
      (fun z => e (-⟪ν.φ z, -ξ - aux_MT α β η⟫_ℝ) * ν.w z) (fun x => e (-⟪x, -ξ - η⟫_ℝ) * f₀ x)
    rw [aux_s2a_fourier_e, aux_ff_fourier_e, aux_ff_adjoint,
      show ∀ a b c d : ℂ, a * b * c * d = (d * a) * (b * c) from fun a b c d => by ring,
      ← this, ← integral_mul_const]
    congr 1; funext p
    simp only [Φ, aux_ff_Phi]
    have hph : e ⟪ξ, p.2 + ν.φ p.1⟫_ℝ * e ⟪η, p.2 + M α β (ν.φ p.1)⟫_ℝ =
        e (-⟪ν.φ p.1, -ξ - aux_MT α β η⟫_ℝ) * e (-⟪p.2, -ξ - η⟫_ℝ) := by
      rw [aux_s2a_e_add, aux_s2a_e_add]
      congr 1
      simp only [inner_add_right, inner_sub_right, inner_neg_right, real_inner_comm p.2,
        real_inner_comm (ν.φ p.1)]
      rw [real_inner_comm (aux_MT α β η), aux_s2a_inner_MT]
      ring
    rw [hph]; ring
  have step1 : form α β ν f₀ f₁ f₂ =
      ∫ z, ∫ x, ∫ q, Φ ((z, x), q) ∂((volume : Measure ℝ²).prod volume) ∂volume ∂ν.m := by
    unfold form
    congr 1; funext z
    rw [← integral_mul_const]
    simp only [hL]
  have step2 := (integral_prod _ hΦ.integral_prod_left).symm
  have step3 := integral_integral_swap (f := fun p q => Φ (p, q)) hΦ
  rw [step1]
  refine step2.trans (step3.trans ?_)
  simp only [hR]
  rfl

/-- **Lemma `lem:fourier-form`** (multiplier). If $\psi$ is smooth, compactly supported, and
even, the form with kernel $\sigma*(\check\psi)_R$ has multiplier $\widehat\sigma(b)\psi(b/R)$,
where $b=\xi_1+M^T\xi_2$. -/
theorem lem_fourier_form_multiplier (α β : ℝ) (ψ : ℝ² → ℂ) (hψ : ContDiff ℝ (⊤ : ℕ∞) ψ)
    (hψc : HasCompactSupport ψ) (hψe : ∀ b, ψ (-b) = ψ b) (R : ℝ) (hR : 0 < R)
    (f₀ f₁ f₂ : 𝓢(ℝ², ℂ)) :
    form α β (FCMeasure.sigma.conv (FCMeasure.ofDensity (scaleR R (𝓕⁻ ψ)))) f₀ f₁ f₂ =
      ∫ ξ : ℝ² × ℝ², 𝓕 (f₀ : ℝ² → ℂ) (-ξ.1 - ξ.2) * 𝓕 (f₁ : ℝ² → ℂ) ξ.1 *
        𝓕 (f₂ : ℝ² → ℂ) ξ.2 *
        (FCMeasure.sigma.fourier (ξ.1 + ContinuousLinearMap.adjoint (M α β) ξ.2) *
          ψ (R⁻¹ • (ξ.1 + ContinuousLinearMap.adjoint (M α β) ξ.2))) := by
  rw [lem_fourier_form]
  congr 1; funext ξ; congr 1
  rw [show -ξ.1 - ContinuousLinearMap.adjoint (M α β) ξ.2 =
    -(ξ.1 + ContinuousLinearMap.adjoint (M α β) ξ.2) by abel, aux_ff_conv_fourier,
    aux_ff_sigma_even, aux_ff_kernel_fourier ψ hψ hψc R hR, smul_neg, hψe]

/-! ### Density of the circle difference measure (`lem:circle-difference`) -/

/-- Auxiliary: translation invariance of arclength `σ` for lower integrals. -/
theorem aux_cd_lintegral_sigma_add (F : Ang → ℝ≥0∞) (a : Ang) :
    ∫⁻ θ, F (θ + a) ∂σ = ∫⁻ θ, F θ ∂σ := by
  unfold σ; exact lintegral_add_right_eq_self _ _

/-! ### The circle-chord density (`lem:circle-difference`) -/

/-- The circle-chord density
`w_r(h) = 1_{0<|h|<2r} / (π² |h| √(4r² - |h|²))` (notation of `\label{lem:circle-difference}`,
see `aux_cd_chorddensity`). -/
@[nolint defsWithUnderscore]
def aux_chordDensity (r : ℝ) (h : ℝ²) : ℝ :=
  if 0 < ‖h‖ ∧ ‖h‖ < 2 * r then 1 / (π ^ 2 * ‖h‖ * Real.sqrt (4 * r ^ 2 - ‖h‖ ^ 2)) else 0

/-- Auxiliary: the measurable equivalence `ℝ² ≃ ℝ × ℝ` used to transfer Mathlib's polar
coordinates to the plane (`lem:circle-difference`). -/
@[nolint defsWithUnderscore]
def aux_cd_coord : ℝ² ≃ᵐ ℝ × ℝ :=
  (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow

/-- Auxiliary: `aux_cd_coord` is volume preserving. -/
theorem aux_cd_coord_mp : MeasurePreserving aux_cd_coord volume volume :=
  (volume_preserving_finTwoArrow ℝ).comp (PiLp.volume_preserving_ofLp (Fin 2))

/-- Auxiliary: the inverse of `aux_cd_coord` in polar form. -/
theorem aux_cd_coord_symm_polar (t θ : ℝ) :
    aux_cd_coord.symm (t * Real.cos θ, t * Real.sin θ) = t • aux_uR θ := by
  ext i
  fin_cases i <;> rfl

/-- Auxiliary: probability arclength as normalized length on `(-π, π]`
(used for `lem:circle-difference`). -/
theorem aux_cd_sigma_lintegral (F : Ang → ℝ≥0∞) :
    ∫⁻ t in Ioc (-π) π, F t = ENNReal.ofReal (2 * π) * ∫⁻ θ, F θ ∂σ := by
  have h := AddCircle.lintegral_preimage (T := 2 * π) (-π) F
  have e : -π + 2 * π = π := by ring
  rw [e] at h
  rw [h, AddCircle.volume_eq_smul_haarAddCircle, lintegral_smul_measure, smul_eq_mul]
  rfl

/-- Auxiliary: polar coordinates on the plane, with the angular integral written against
probability arclength: `∫ H = 2π ∫_0^∞ t ∫_{S¹} H(t u_θ) dσ(θ) dt`
(used for `lem:circle-difference`). -/
theorem aux_cd_lintegral_polar (H : ℝ² → ℝ≥0∞) (hH : Measurable H) :
    ∫⁻ x, H x = ENNReal.ofReal (2 * π) *
      ∫⁻ t in Ioi (0 : ℝ), ENNReal.ofReal t * ∫⁻ θ, H (t • u θ) ∂σ := by
  have hsm : Measurable fun p : ℝ × ℝ => H (p.1 • aux_uR p.2) :=
    hH.comp (continuous_fst.smul
      ((aux_lw_uR_contDiff (n := 0)).continuous.comp continuous_snd)).measurable
  have hmeas : Measurable fun q : ℝ × ℝ => H (aux_cd_coord.symm q) :=
    hH.comp aux_cd_coord.symm.measurable
  have h1 : ∫⁻ x, H x = ∫⁻ q : ℝ × ℝ, H (aux_cd_coord.symm q) := by
    rw [← aux_cd_coord_mp.lintegral_comp hmeas]
    simp
  rw [h1, ← lintegral_comp_polarCoord_symm (fun q => H (aux_cd_coord.symm q))]
  have h2 : ∀ p : ℝ × ℝ, ENNReal.ofReal p.1 • H (aux_cd_coord.symm (polarCoord.symm p)) =
      ENNReal.ofReal p.1 * H (p.1 • aux_uR p.2) := by
    rintro ⟨t, θ⟩
    rw [smul_eq_mul]
    congr 2
    exact aux_cd_coord_symm_polar t θ
  simp only [h2, polarCoord_target]
  have hfull : Measurable fun p : ℝ × ℝ => ENNReal.ofReal p.1 * H (p.1 • aux_uR p.2) :=
    measurable_fst.ennreal_ofReal.mul hsm
  rw [Measure.volume_eq_prod, ← Measure.prod_restrict,
    lintegral_prod _ hfull.aemeasurable, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine setLIntegral_congr_fun measurableSet_Ioi fun t ht => ?_
  simp only []
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    setLIntegral_congr Ioo_ae_eq_Ioc]
  have hA := aux_cd_sigma_lintegral (fun θ => H (t • u θ))
  simp only [aux_u_coe] at hA
  rw [hA]
  ring

/-- Auxiliary: the chord length `|r u_θ - r u_{θ-δ}| = r√(2 - 2cos δ)` of the circle of radius `r`
at angular separation `δ` (used for `lem:circle-difference`). -/
@[nolint defsWithUnderscore]
def aux_cd_chordRadius (r : ℝ) (δ : Ang) : ℝ := r * Real.sqrt (2 - 2 * u δ 0)

/-- Auxiliary: the difference of two circle points at angular separation `d`,
`r u_θ - r u_{θ-d} = 2r\sin(d/2)\, u_{θ + π/2 - d/2}` (used for `lem:circle-difference`). -/
theorem aux_cd_u_sub (r d : ℝ) (θ : Ang) :
    r • u θ - r • u (θ - (d : Ang)) =
      (2 * r * Real.sin (d / 2)) • u (θ + ((π / 2 - d / 2 : ℝ) : Ang)) := by
  induction θ using QuotientAddGroup.induction_on with
  | H t =>
    have h1 : ((t : Ang) - (d : Ang)) = ((t - d : ℝ) : Ang) := by
      rw [← AddCircle.coe_sub]
    have h2 : ((t : Ang) + ((π / 2 - d / 2 : ℝ) : Ang)) = ((t + (π / 2 - d / 2) : ℝ) : Ang) := by
      rw [← AddCircle.coe_add]
    rw [h1, h2]
    simp only [aux_u_coe]
    have hc : Real.cos d = 1 - 2 * Real.sin (d / 2) ^ 2 := by
      have h := Real.cos_two_mul (d / 2)
      have h2 := Real.sin_sq_add_cos_sq (d / 2)
      rw [show 2 * (d / 2) = d by ring] at h
      linarith
    have hs : Real.sin d = 2 * Real.sin (d / 2) * Real.cos (d / 2) := by
      have h := Real.sin_two_mul (d / 2)
      rw [show 2 * (d / 2) = d by ring] at h
      linarith
    ext i
    fin_cases i
    · change r * Real.cos t - r * Real.cos (t - d) =
        2 * r * Real.sin (d / 2) * Real.cos (t + (π / 2 - d / 2))
      rw [Real.cos_add, Real.cos_sub, Real.cos_pi_div_two_sub, Real.sin_pi_div_two_sub, hc, hs]
      ring
    · change r * Real.sin t - r * Real.sin (t - d) =
        2 * r * Real.sin (d / 2) * Real.sin (t + (π / 2 - d / 2))
      rw [Real.sin_add, Real.sin_sub, Real.cos_pi_div_two_sub, Real.sin_pi_div_two_sub, hc, hs]
      ring

/-- Auxiliary: `a • u_θ = (-a) • u_{θ+π}` (used for `lem:circle-difference`). -/
theorem aux_cd_smul_u_neg (a : ℝ) (θ : Ang) :
    a • u θ = (-a) • u (θ + ((π : ℝ) : Ang)) := by
  rw [aux_ff_u_add_pi, smul_neg, neg_smul, neg_neg]

/-- Auxiliary: for a fixed angular separation `δ`, the differences `r u_θ - r u_{θ-δ}` are
uniformly distributed on the circle of radius `aux_cd_chordRadius r δ`
(used for `lem:circle-difference`). -/
theorem aux_cd_circle_diff (r : ℝ) (hr : 0 ≤ r) (F : ℝ² → ℝ≥0∞) (δ : Ang) :
    ∫⁻ θ, F (r • u θ - r • u (θ - δ)) ∂σ =
      ∫⁻ θ, F (aux_cd_chordRadius r δ • u θ) ∂σ := by
  induction δ using QuotientAddGroup.induction_on with
  | H d =>
    set c := 2 * r * Real.sin (d / 2) with hcdef
    have hc : Real.cos d = 1 - 2 * Real.sin (d / 2) ^ 2 := by
      have h := Real.cos_two_mul (d / 2)
      have h2 := Real.sin_sq_add_cos_sq (d / 2)
      rw [show 2 * (d / 2) = d by ring] at h
      linarith
    have hchord : aux_cd_chordRadius r ((d : ℝ) : Ang) = |c| := by
      unfold aux_cd_chordRadius
      have hu : u ((d : ℝ) : Ang) 0 = Real.cos d := by simp [aux_u_coe, aux_uR]
      rw [hu, show 2 - 2 * Real.cos d = (2 * Real.sin (d / 2)) ^ 2 by rw [hc]; ring,
        Real.sqrt_sq_eq_abs, hcdef, abs_mul, abs_mul,
        abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]
      rw [abs_of_nonneg (by linarith : (0:ℝ) ≤ 2 * r)]
      ring
    have hstep : ∫⁻ θ, F (r • u θ - r • u (θ - ((d : ℝ) : Ang))) ∂σ = ∫⁻ θ, F (c • u θ) ∂σ := by
      have h1 : ∀ θ : Ang, F (r • u θ - r • u (θ - ((d : ℝ) : Ang))) =
          F (c • u (θ + ((π / 2 - d / 2 : ℝ) : Ang))) := by
        intro θ; rw [aux_cd_u_sub r d θ]
      rw [lintegral_congr h1]
      exact aux_cd_lintegral_sigma_add (fun θ => F (c • u θ)) _
    rw [hstep, hchord]
    rcases le_or_gt 0 c with h | h
    · rw [abs_of_nonneg h]
    · rw [abs_of_neg h]
      have h2 : ∀ θ : Ang, F (c • u θ) = F ((-c) • u (θ + ((π : ℝ) : Ang))) := by
        intro θ; rw [← aux_cd_smul_u_neg]
      rw [lintegral_congr h2]
      exact aux_cd_lintegral_sigma_add (fun θ => F ((-c) • u θ)) _

/-- Auxiliary: measurability of `θ ↦ r • u_θ`. -/
theorem aux_cd_measurable_ru (r : ℝ) : Measurable fun θ : Ang => r • u θ :=
  aux_lw_u_meas.const_smul r

/-- Auxiliary: `σ` is invariant under translations. -/
instance aux_cd_sigma_addLeftInvariant : σ.IsAddLeftInvariant := by
  unfold σ; infer_instance

/-- Auxiliary: `σ` is invariant under the reflection `θ ↦ -θ`. -/
instance aux_cd_sigma_negInvariant : σ.IsNegInvariant := by
  unfold σ; infer_instance

/-- Auxiliary: the convolution `σ_r * σ̃_r` as an iterated integral over the angular separation
(first step in the proof of `lem:circle-difference`). -/
theorem aux_cd_conv_lintegral (r : ℝ) (F : ℝ² → ℝ≥0∞) (hF : Measurable F) :
    ∫⁻ h, F h ∂(Measure.conv (aux_sigmaR r) ((aux_sigmaR r).map Neg.neg)) =
      ∫⁻ δ, ∫⁻ θ, F (r • u θ - r • u (θ - δ)) ∂σ ∂σ := by
  have hru := aux_cd_measurable_ru r
  have hrun : Measurable fun θ : Ang => -(r • u θ) := hru.neg
  have hν : (aux_sigmaR r).map Neg.neg = σ.map (fun θ => -(r • u θ)) := by
    rw [aux_sigmaR, Measure.map_map measurable_neg hru]
    rfl
  have hg : Measurable fun a : ℝ² × ℝ² => F (a.1 + a.2) := hF.comp measurable_add
  have hmeas0 : Measurable fun p : Ang × Ang => F (r • u p.1 - r • u p.2) :=
    hF.comp ((hru.comp measurable_fst).sub (hru.comp measurable_snd))
  unfold Measure.conv
  rw [lintegral_map hF measurable_add, hν, aux_sigmaR,
    Measure.map_prod_map _ _ hru hrun, lintegral_map hg (hru.prodMap hrun)]
  simp only [Prod.map_fst, Prod.map_snd, ← sub_eq_add_neg]
  rw [lintegral_prod _ (hmeas0.aemeasurable)]
  have hsub : ∀ θ : Ang, ∫⁻ θ', F (r • u θ - r • u θ') ∂σ =
      ∫⁻ δ, F (r • u θ - r • u (θ - δ)) ∂σ :=
    fun θ => (lintegral_sub_left_eq_self (fun θ' => F (r • u θ - r • u θ')) θ).symm
  simp only [hsub]
  have hmeas : Measurable fun p : Ang × Ang => F (r • u p.1 - r • u (p.1 - p.2)) :=
    hF.comp (((aux_lw_u_meas.comp measurable_fst).const_smul r).sub
      ((aux_lw_u_meas.comp (measurable_fst.sub measurable_snd)).const_smul r))
  exact lintegral_lintegral_swap hmeas.aemeasurable

/-- Auxiliary: the image of `(0, π)` under `x ↦ 2r sin(x/2)` is `(0, 2r)`
(used for `lem:circle-difference`). -/
theorem aux_cd_image_sin (r : ℝ) (hr : 0 < r) :
    (fun x => 2 * r * Real.sin (x / 2)) '' (Ioo 0 π) = Ioo 0 (2 * r) := by
  have hpi := Real.pi_pos
  ext t
  constructor
  · rintro ⟨x, hx, rfl⟩
    have h1 : 0 < x / 2 := by linarith [hx.1]
    have hs : 0 < Real.sin (x / 2) :=
      Real.sin_pos_of_pos_of_lt_pi h1 (by linarith [hx.2])
    have hs1 : Real.sin (x / 2) < 1 := by
      have hlt : x / 2 < π / 2 := by linarith [hx.2]
      have h0 : Real.sin (x / 2) < Real.sin (π / 2) :=
        Real.strictMonoOn_sin ⟨by linarith, by linarith⟩ ⟨by linarith, le_rfl⟩ hlt
      rwa [Real.sin_pi_div_two] at h0
    exact ⟨by positivity, by nlinarith⟩
  · intro ht
    have hr2 : (0:ℝ) < 2 * r := by linarith
    have hq1 : 0 < t / (2 * r) := div_pos ht.1 hr2
    have hq2 : t / (2 * r) < 1 := (div_lt_one hr2).2 ht.2
    refine ⟨2 * Real.arcsin (t / (2 * r)), ⟨?_, ?_⟩, ?_⟩
    · have := Real.arcsin_pos.2 hq1; linarith
    · have := Real.arcsin_lt_pi_div_two (x := t / (2 * r))
      have h2 : Real.arcsin (t / (2 * r)) < π / 2 := by
        rcases lt_or_eq_of_le (Real.arcsin_le_pi_div_two _) with h | h
        · exact h
        · exfalso
          have : t / (2 * r) = 1 := by
            have := Real.sin_arcsin (by linarith : (-1:ℝ) ≤ t / (2*r)) (le_of_lt hq2)
            rw [h] at this; simpa using this.symm
          linarith
      linarith
    · change 2 * r * Real.sin (2 * Real.arcsin (t / (2 * r)) / 2) = t
      rw [show 2 * Real.arcsin (t / (2 * r)) / 2 = Real.arcsin (t / (2 * r)) by ring,
        Real.sin_arcsin (by linarith) (le_of_lt hq2)]
      field_simp

/-- Auxiliary: the change of variables `t = 2r\sin(x/2)` between `(0, π)` and `(0, 2r)`
(used for `lem:circle-difference`). -/
theorem aux_cd_cov_sin (r : ℝ) (hr : 0 < r) (G : ℝ → ℝ≥0∞) :
    ∫⁻ t in Ioo 0 (2 * r), ENNReal.ofReal (2 / Real.sqrt (4 * r ^ 2 - t ^ 2)) * G t =
      ∫⁻ x in Ioo 0 π, G (2 * r * Real.sin (x / 2)) := by
  have hpi := Real.pi_pos
  have hderiv : ∀ x ∈ Ioo 0 π, HasDerivWithinAt (fun x => 2 * r * Real.sin (x / 2))
      (r * Real.cos (x / 2)) (Ioo 0 π) x := by
    intro x _
    have h1 : HasDerivAt (fun x : ℝ => x / 2) (1 / 2) x := (hasDerivAt_id x).div_const 2
    have h2 : HasDerivAt (fun x : ℝ => Real.sin (x / 2)) (Real.cos (x / 2) * (1 / 2)) x := by
      have := HasDerivAt.comp x (Real.hasDerivAt_sin (x / 2)) h1
      exact this
    have h3 := h2.const_mul (2 * r)
    have : 2 * r * (Real.cos (x / 2) * (1 / 2)) = r * Real.cos (x / 2) := by ring
    rw [this] at h3
    exact h3.hasDerivWithinAt
  have hinj : InjOn (fun x => 2 * r * Real.sin (x / 2)) (Ioo 0 π) := by
    intro a ha b hb hab
    simp only at hab
    have h2r : (2 : ℝ) * r ≠ 0 := by positivity
    have hs : Real.sin (a / 2) = Real.sin (b / 2) :=
      mul_left_cancel₀ h2r hab
    have hmem : ∀ y : ℝ, y ∈ Ioo 0 π → y / 2 ∈ Icc (-(π / 2)) (π / 2) := by
      intro y hy; exact ⟨by linarith [hy.1], by linarith [hy.2]⟩
    have := Real.strictMonoOn_sin.injOn (hmem a ha) (hmem b hb) hs
    linarith
  rw [← aux_cd_image_sin r hr, lintegral_image_eq_lintegral_abs_deriv_mul
    measurableSet_Ioo hderiv hinj]
  refine setLIntegral_congr_fun measurableSet_Ioo fun x hx => ?_
  have h1 : 0 < x / 2 := by linarith [hx.1]
  have h2 : x / 2 < π / 2 := by linarith [hx.2]
  have hcos : 0 < Real.cos (x / 2) := Real.cos_pos_of_mem_Ioo ⟨by linarith, h2⟩
  have hsq : 4 * r ^ 2 - (2 * r * Real.sin (x / 2)) ^ 2 = (2 * r * Real.cos (x / 2)) ^ 2 := by
    have := Real.sin_sq_add_cos_sq (x / 2)
    nlinarith
  rw [hsq, Real.sqrt_sq (by positivity), abs_of_pos (by positivity : (0:ℝ) < r * Real.cos (x / 2)),
    ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  rw [show r * Real.cos (x / 2) * (2 / (2 * r * Real.cos (x / 2))) = 1 by field_simp]
  rw [ENNReal.ofReal_one, one_mul]

/-- Auxiliary: the reflection `x ↦ 2π - x` identifies the two halves of `(0, 2π)` for the chord
length (used for `lem:circle-difference`). -/
theorem aux_cd_reflect (r : ℝ) (G : ℝ → ℝ≥0∞) :
    ∫⁻ x in Ioc π (2 * π), G (2 * r * Real.sin (x / 2)) =
      ∫⁻ x in Ioo 0 π, G (2 * r * Real.sin (x / 2)) := by
  have hmp : MeasurePreserving (fun x : ℝ => 2 * π - x) volume volume :=
    Measure.measurePreserving_sub_left volume (2 * π)
  have hemb : MeasurableEmbedding (fun x : ℝ => 2 * π - x) :=
    (MeasurableEquiv.subLeft (2 * π)).measurableEmbedding
  have h := hmp.setLIntegral_comp_preimage_emb hemb
    (fun x => G (2 * r * Real.sin (x / 2))) (Ioc π (2 * π))
  rw [← h]
  have hpre : (fun x : ℝ => 2 * π - x) ⁻¹' (Ioc π (2 * π)) = Ico 0 π := by
    ext x
    simp only [mem_preimage, mem_Ioc, mem_Ico]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
    · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
  rw [hpre]
  have hval : ∀ x : ℝ, Real.sin ((2 * π - x) / 2) = Real.sin (x / 2) := by
    intro x
    rw [show (2 * π - x) / 2 = π - x / 2 by ring, Real.sin_pi_sub]
  simp only [hval]
  exact setLIntegral_congr (Ioo_ae_eq_Ico.symm.trans (by rfl))

/-- Auxiliary: the radial form of the chord distribution: the pushforward of normalized length on
`(0, 2π]` under `x ↦ 2r\sin(x/2)` (used for `lem:circle-difference`). -/
theorem aux_cd_radial (r : ℝ) (hr : 0 < r) (G : ℝ → ℝ≥0∞) :
    ∫⁻ x in Ioc 0 (2 * π), G (2 * r * Real.sin (x / 2)) =
      4 * ∫⁻ t in Ioo 0 (2 * r), ENNReal.ofReal (1 / Real.sqrt (4 * r ^ 2 - t ^ 2)) * G t := by
  have hpi := Real.pi_pos
  have hsplit : Ioc (0:ℝ) (2 * π) = Ioc (0:ℝ) π ∪ Ioc π (2 * π) :=
    (Set.Ioc_union_Ioc_eq_Ioc (by linarith) (by linarith)).symm
  have hdisj : Disjoint (Ioc (0:ℝ) π) (Ioc π (2 * π)) := by
    rw [Set.disjoint_left]
    rintro x ⟨-, hx2⟩ ⟨hx3, -⟩
    linarith
  rw [hsplit, lintegral_union measurableSet_Ioc hdisj, aux_cd_reflect r G,
    setLIntegral_congr Ioo_ae_eq_Ioc.symm, ← two_mul, ← aux_cd_cov_sin r hr G]
  rw [← lintegral_const_mul' _ _ (by norm_num : (2:ℝ≥0∞) ≠ ⊤),
    ← lintegral_const_mul' _ _ (by norm_num : (4:ℝ≥0∞) ≠ ⊤)]
  refine setLIntegral_congr_fun measurableSet_Ioo fun t ht => ?_
  have h2 : ENNReal.ofReal (2 / Real.sqrt (4 * r ^ 2 - t ^ 2)) =
      2 * ENNReal.ofReal (1 / Real.sqrt (4 * r ^ 2 - t ^ 2)) := by
    rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by norm_num)]
    congr 1
    ring
  rw [h2]
  ring

/-- Auxiliary: `|u_θ| = 1`. -/
theorem aux_cd_norm_u (θ : Ang) : ‖u θ‖ = 1 := by
  induction θ using QuotientAddGroup.induction_on with
  | H t =>
    rw [aux_u_coe, EuclideanSpace.norm_eq, Fin.sum_univ_two]
    simp [aux_uR]

/-- Auxiliary: the chord radius at a real angle `x ∈ (0, 2π]` is `2r sin(x/2)`
(used for `lem:circle-difference`). -/
theorem aux_cd_chordRadius_eq (r x : ℝ) (hx : x ∈ Ioc 0 (2 * π)) :
    aux_cd_chordRadius r ((x : ℝ) : Ang) = 2 * r * Real.sin (x / 2) := by
  have hc : Real.cos x = 1 - 2 * Real.sin (x / 2) ^ 2 := by
    have h := Real.cos_two_mul (x / 2)
    have h2 := Real.sin_sq_add_cos_sq (x / 2)
    rw [show 2 * (x / 2) = x by ring] at h
    linarith
  have hs : 0 ≤ Real.sin (x / 2) := by
    refine Real.sin_nonneg_of_nonneg_of_le_pi (by linarith [hx.1]) (by linarith [hx.2])
  unfold aux_cd_chordRadius
  have hu : u ((x : ℝ) : Ang) 0 = Real.cos x := by simp [aux_u_coe, aux_uR]
  rw [hu, show 2 - 2 * Real.cos x = (2 * Real.sin (x / 2)) ^ 2 by rw [hc]; ring,
    Real.sqrt_sq (by positivity)]
  ring

/-- Auxiliary: the chord density is radial: `w_r(t u_θ)` depends only on `t > 0`
(used for `lem:circle-difference`). -/
theorem aux_cd_chordDensity_smul (r t : ℝ) (ht : 0 < t) (θ : Ang) :
    aux_chordDensity r (t • u θ) =
      if t < 2 * r then 1 / (π ^ 2 * t * Real.sqrt (4 * r ^ 2 - t ^ 2)) else 0 := by
  have hn : ‖t • u θ‖ = t := by
    rw [norm_smul, aux_cd_norm_u, mul_one, Real.norm_of_nonneg ht.le]
  unfold aux_chordDensity
  rw [hn]
  by_cases h : t < 2 * r
  · rw [if_pos ⟨ht, h⟩, if_pos h]
  · rw [if_neg (by tauto), if_neg h]

/-- Auxiliary: the left-hand side of `lem:circle-difference` in radial form. -/
theorem aux_cd_chord_lhs (r : ℝ) (hr : 0 < r) (F : ℝ² → ℝ≥0∞) (hF : Measurable F) :
    ∫⁻ h, F h ∂(Measure.conv (aux_sigmaR r) ((aux_sigmaR r).map Neg.neg)) =
      ENNReal.ofReal (2 / π) *
        ∫⁻ t in Ioo 0 (2 * r), ENNReal.ofReal (1 / Real.sqrt (4 * r ^ 2 - t ^ 2)) *
          ∫⁻ θ, F (t • u θ) ∂σ := by
  have hpi := Real.pi_pos
  set G : ℝ → ℝ≥0∞ := fun c => ∫⁻ θ, F (c • u θ) ∂σ with hG
  rw [aux_cd_conv_lintegral r F hF]
  have hcd : ∀ δ : Ang, ∫⁻ θ, F (r • u θ - r • u (θ - δ)) ∂σ = G (aux_cd_chordRadius r δ) :=
    fun δ => aux_cd_circle_diff r hr.le F δ
  simp only [hcd]
  rw [aux_lw_sigma_lintegral (fun δ => G (aux_cd_chordRadius r δ))]
  have hint : ∫⁻ x in Ioc 0 (2 * π), G (aux_cd_chordRadius r ((x : ℝ) : Ang)) =
      ∫⁻ x in Ioc 0 (2 * π), G (2 * r * Real.sin (x / 2)) := by
    refine setLIntegral_congr_fun measurableSet_Ioc fun x hx => ?_
    rw [aux_cd_chordRadius_eq r x hx]
  rw [hint, aux_cd_radial r hr G, ← mul_assoc]
  congr 1
  rw [← ENNReal.ofReal_inv_of_pos (by positivity), ← ENNReal.ofReal_ofNat 4,
    ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  field_simp
  ring

/-- Auxiliary: the right-hand side of `lem:circle-difference` in radial form. -/
theorem aux_cd_chord_rhs (r : ℝ) (hr : 0 < r) (F : ℝ² → ℝ≥0∞) (hF : Measurable F) :
    ∫⁻ h, F h ∂((volume : Measure ℝ²).withDensity
        (fun h => ENNReal.ofReal (aux_chordDensity r h))) =
      ENNReal.ofReal (2 / π) *
        ∫⁻ t in Ioo 0 (2 * r), ENNReal.ofReal (1 / Real.sqrt (4 * r ^ 2 - t ^ 2)) *
          ∫⁻ θ, F (t • u θ) ∂σ := by
  have hpi := Real.pi_pos
  have hcdm : Measurable fun h : ℝ² => ENNReal.ofReal (aux_chordDensity r h) := by
    unfold aux_chordDensity
    refine ENNReal.measurable_ofReal.comp (Measurable.ite ?_ ?_ measurable_const)
    · exact (measurableSet_lt measurable_const measurable_norm).inter
        (measurableSet_lt measurable_norm measurable_const)
    · fun_prop
  rw [lintegral_withDensity_eq_lintegral_mul _ hcdm hF,
    aux_cd_lintegral_polar _ (hcdm.mul hF)]
  simp only [Pi.mul_apply]
  have hIoi : Ioi (0:ℝ) = Ioo 0 (2 * r) ∪ Ici (2 * r) := by
    ext t; simp only [mem_Ioi, mem_union, mem_Ioo, mem_Ici]
    constructor
    · intro h; rcases lt_or_ge t (2 * r) with h' | h'
      · exact Or.inl ⟨h, h'⟩
      · exact Or.inr h'
    · rintro (⟨h, -⟩ | h) <;> linarith
  have hdisj : Disjoint (Ioo (0:ℝ) (2 * r)) (Ici (2 * r)) := by
    rw [Set.disjoint_left]; rintro t ⟨-, h2⟩ h3; exact absurd h3 (not_le.2 h2)
  rw [hIoi, lintegral_union measurableSet_Ici hdisj]
  have hzero : ∫⁻ t in Ici (2 * r), ENNReal.ofReal t *
      ∫⁻ θ, ENNReal.ofReal (aux_chordDensity r (t • u θ)) * F (t • u θ) ∂σ = 0 := by
    refine setLIntegral_eq_zero measurableSet_Ici fun t ht => ?_
    have ht0 : 0 < t := lt_of_lt_of_le (by positivity) ht
    have : ∀ θ : Ang, ENNReal.ofReal (aux_chordDensity r (t • u θ)) * F (t • u θ) = 0 := by
      intro θ
      rw [aux_cd_chordDensity_smul r t ht0 θ, if_neg (not_lt.2 ht)]
      simp
    have hz : ∫⁻ θ, ENNReal.ofReal (aux_chordDensity r (t • u θ)) * F (t • u θ) ∂σ = 0 := by
      simp only [this]; exact lintegral_zero
    simp [hz]
  rw [hzero, add_zero, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine setLIntegral_congr_fun measurableSet_Ioo fun t ht => ?_
  have ht0 : 0 < t := ht.1
  have hsq : 0 < 4 * r ^ 2 - t ^ 2 := by nlinarith [ht.2, ht.1]
  have hsqrt : 0 < Real.sqrt (4 * r ^ 2 - t ^ 2) := Real.sqrt_pos.2 hsq
  have hval : ∀ θ : Ang, ENNReal.ofReal (aux_chordDensity r (t • u θ)) * F (t • u θ) =
      ENNReal.ofReal (1 / (π ^ 2 * t * Real.sqrt (4 * r ^ 2 - t ^ 2))) * F (t • u θ) := by
    intro θ; rw [aux_cd_chordDensity_smul r t ht0 θ, if_pos ht.2]
  have hscal : ENNReal.ofReal (2 * π) * ENNReal.ofReal t *
      ENNReal.ofReal (1 / (π ^ 2 * t * Real.sqrt (4 * r ^ 2 - t ^ 2))) =
      ENNReal.ofReal (2 / π) * ENNReal.ofReal (1 / Real.sqrt (4 * r ^ 2 - t ^ 2)) := by
    rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    field_simp
  simp only [hval]
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    show ENNReal.ofReal (2 * π) * (ENNReal.ofReal t *
      (ENNReal.ofReal (1 / (π ^ 2 * t * Real.sqrt (4 * r ^ 2 - t ^ 2))) *
        ∫⁻ θ, F (t • u θ) ∂σ)) =
      (ENNReal.ofReal (2 * π) * ENNReal.ofReal t *
        ENNReal.ofReal (1 / (π ^ 2 * t * Real.sqrt (4 * r ^ 2 - t ^ 2)))) *
          ∫⁻ θ, F (t • u θ) ∂σ from by ring, hscal, mul_assoc]

/-- Auxiliary (adapted from the reference formalization; used for `lem:circle-difference`,
see `Auto.lem_circle_difference`): the chord density. The measure $\sigma_r*\widetilde\sigma_r$,
where
$\widetilde\sigma_r(E)=\sigma_r(-E)$, has density
$$w_r(h)=\frac{\mathbf 1_{\{0<|h|<2r\}}}{\pi^2|h|\sqrt{4r^2-|h|^2}},\qquad h\in\mathbb R^2.$$ -/
theorem aux_cd_chorddensity (r : ℝ) (hr : 0 < r) :
    Measure.conv (aux_sigmaR r) ((aux_sigmaR r).map Neg.neg) =
      (volume : Measure ℝ²).withDensity (fun h => ENNReal.ofReal (aux_chordDensity r h)) := by
  refine Measure.ext fun s hs => ?_
  have hm : Measurable (s.indicator (1 : ℝ² → ℝ≥0∞)) := measurable_const.indicator hs
  have h := (aux_cd_chord_lhs r hr _ hm).trans (aux_cd_chord_rhs r hr _ hm).symm
  rwa [lintegral_indicator_one hs, lintegral_indicator_one hs] at h

/-- Auxiliary for `lem:circle-difference`: an invertible planar similarity `N` with
`|Nx| = c|x|` acts on the unit circle as `N u_θ = c u_{a ± θ}`. -/
lemma aux_cd_simil_u (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hN : ∀ x, ‖N x‖ = c * ‖x‖) :
    ∃ a : ℝ, (∀ θ : Ang, N (u θ) = c • u ((a : Ang) + θ)) ∨
      (∀ θ : Ang, N (u θ) = c • u ((a : Ang) - θ)) := by
  set v0 := c⁻¹ • N aux_lw_e0
  set v1 := c⁻¹ • N aux_lw_e1
  have hn : ∀ x : ℝ², ‖c⁻¹ • N x‖ = ‖x‖ := fun x => by
    rw [norm_smul, hN, Real.norm_of_nonneg (inv_pos.2 hc).le, ← mul_assoc,
      inv_mul_cancel₀ hc.ne', one_mul]
  have hsq : ∀ x : ℝ², ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := aux_lw_norm_sq
  have hlin : ∀ x : ℝ², c⁻¹ • N x = x 0 • v0 + x 1 • v1 := by
    intro x
    have hx : x = x 0 • aux_lw_e0 + x 1 • aux_lw_e1 := by
      ext i; fin_cases i <;> simp [aux_lw_e0, aux_lw_e1]
    conv_lhs => rw [hx]
    simp only [map_add, map_smul, smul_add, v0, v1, smul_comm c⁻¹]
  have he0 : aux_lw_e0 0 = 1 ∧ aux_lw_e0 1 = 0 := by simp [aux_lw_e0]
  have he1 : aux_lw_e1 0 = 0 ∧ aux_lw_e1 1 = 1 := by simp [aux_lw_e1]
  have h0 : v0 0 ^ 2 + v0 1 ^ 2 = 1 := by
    rw [← hsq, hn, hsq, he0.1, he0.2]; norm_num
  have h1 : v1 0 ^ 2 + v1 1 ^ 2 = 1 := by
    rw [← hsq, hn, hsq, he1.1, he1.2]; norm_num
  have h01 : v0 0 * v1 0 + v0 1 * v1 1 = 0 := by
    have := hn (aux_lw_e0 + aux_lw_e1)
    rw [← sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _), hsq, hsq, hlin] at this
    simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, he0.1, he0.2, he1.1, he1.2] at this
    nlinarith
  -- the angle of `v0`
  set z : ℂ := ⟨v0 0, v0 1⟩
  have hz : ‖z‖ = 1 := by
    rw [Complex.norm_def, Complex.normSq_mk]
    rw [show v0 0 * v0 0 + v0 1 * v0 1 = 1 by nlinarith, Real.sqrt_one]
  have hz0 : z ≠ 0 := by intro h; rw [h, norm_zero] at hz; exact zero_ne_one hz
  set a := Complex.arg z
  have hca : Real.cos a = v0 0 := by rw [Complex.cos_arg hz0, hz, div_one]
  have hsa : Real.sin a = v0 1 := by rw [Complex.sin_arg, hz, div_one]
  set l := -v1 0 * Real.sin a + v1 1 * Real.cos a
  have hv10 : v1 0 = -l * Real.sin a := by
    simp only [l]; rw [hca, hsa]; linear_combination (-v1 0) * h0 + v0 0 * h01
  have hv11 : v1 1 = l * Real.cos a := by
    simp only [l]; rw [hca, hsa]; linear_combination (-v1 1) * h0 + v0 1 * h01
  have hl : l = 1 ∨ l = -1 := by
    have hcs := Real.sin_sq_add_cos_sq a
    have h1' := h1
    rw [hv10, hv11] at h1'
    exact mul_self_eq_one_iff.1 (by linear_combination h1' - l ^ 2 * hcs)
  have hNu : ∀ t : ℝ, N (aux_uR t) = c • (Real.cos t • v0 + Real.sin t • v1) := by
    intro t
    calc N (aux_uR t) = c • (c⁻¹ • N (aux_uR t)) := (smul_inv_smul₀ hc.ne' _).symm
      _ = _ := by rw [hlin]; simp [aux_uR]
  refine ⟨a, ?_⟩
  rcases hl with hl | hl
  · left
    intro θ
    induction θ using QuotientAddGroup.induction_on with
    | H t =>
      rw [← AddCircle.coe_add, aux_u_coe, aux_u_coe, hNu]
      congr 1
      ext i; fin_cases i
      · simp [aux_uR, Real.cos_add, hv10, hl, ← hca]; ring
      · simp [aux_uR, Real.sin_add, hv11, hl, ← hsa]; ring
  · right
    intro θ
    induction θ using QuotientAddGroup.induction_on with
    | H t =>
      rw [← AddCircle.coe_sub, aux_u_coe, aux_u_coe, hNu]
      congr 1
      ext i; fin_cases i
      · simp [aux_uR, Real.cos_sub, hv10, hl, ← hca]; ring
      · simp [aux_uR, Real.sin_sub, hv11, hl, ← hsa]; ring

/-- Auxiliary for `lem:circle-difference` (see `Auto.lem_circle_difference`): measurability of
the chord density. -/
lemma aux_cd_chordDensity_meas (c : ℝ) : Measurable fun h : ℝ² => aux_chordDensity c h := by
  unfold aux_chordDensity
  refine Measurable.ite ?_ ?_ measurable_const
  · exact (measurableSet_lt measurable_const measurable_norm).inter
      (measurableSet_lt measurable_norm measurable_const)
  · fun_prop

/-- Auxiliary for `lem:circle-difference`: the chord density is nonnegative. -/
lemma aux_cd_chordDensity_nonneg' (c : ℝ) (y : ℝ²) : 0 ≤ aux_chordDensity c y := by
  unfold aux_chordDensity
  split_ifs with h
  · have := Real.sqrt_nonneg (4 * c ^ 2 - ‖y‖ ^ 2)
    have := h.1
    positivity
  · exact le_rfl

/-- Auxiliary for `lem:circle-difference` (see `Auto.lem_circle_difference`): for an invertible
similarity `N` with `|Nx| = c|x|`, the pushforward of `σ ⊗ σ` under
`(θ, φ) ↦ N(u_θ - u_φ)` is the chord density of radius `c` times Lebesgue measure. -/
lemma aux_cd_diff_eq (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖) :
    (σ.prod σ).map (fun p : Ang × Ang => N (u p.1 - u p.2)) =
      volume.withDensity (fun y => ENNReal.ofReal (aux_chordDensity c y)) := by
  have hu := aux_lw_u_meas
  have hG : Measurable fun p : Ang × Ang => c • u p.1 - c • u p.2 :=
    ((hu.comp measurable_fst).const_smul c).sub ((hu.comp measurable_snd).const_smul c)
  -- reduce to the standard circle difference of radius `c`
  have hred : (σ.prod σ).map (fun p : Ang × Ang => N (u p.1 - u p.2)) =
      (σ.prod σ).map (fun p : Ang × Ang => c • u p.1 - c • u p.2) := by
    obtain ⟨a, ha | ha⟩ := aux_cd_simil_u N c hc hNc
    · have hT : MeasurePreserving (fun θ : Ang => (a : Ang) + θ) σ σ :=
        measurePreserving_add_left σ _
      have hTT := hT.prod hT
      conv_rhs => rw [← hTT.map_eq]
      rw [Measure.map_map hG hTT.measurable]
      congr 1; funext p
      simp only [Function.comp, Prod.map_fst, Prod.map_snd, map_sub, ha]
    · have hT : MeasurePreserving (fun θ : Ang => (a : Ang) - θ) σ σ :=
        Measure.measurePreserving_sub_left σ _
      have hTT := hT.prod hT
      conv_rhs => rw [← hTT.map_eq]
      rw [Measure.map_map hG hTT.measurable]
      congr 1; funext p
      simp only [Function.comp, Prod.map_fst, Prod.map_snd, map_sub, ha]
  have hconv : (σ.prod σ).map (fun p : Ang × Ang => c • u p.1 - c • u p.2) =
      Measure.conv (aux_sigmaR c) ((aux_sigmaR c).map Neg.neg) := by
    have hru : Measurable fun θ : Ang => c • u θ := hu.const_smul c
    rw [Measure.conv, aux_sigmaR, Measure.map_map measurable_neg hru,
      Measure.map_prod_map _ _ hru (measurable_neg.comp hru),
      Measure.map_map measurable_add (hru.prodMap (measurable_neg.comp hru))]
    rfl
  exact hred.trans (hconv.trans (aux_cd_chorddensity c hc))

/-- Auxiliary for `lem:circle-difference`: the chord density has total mass one. -/
lemma aux_cd_chordDensity_mass (c : ℝ) (hc : 0 < c) :
    ∫⁻ y, ENNReal.ofReal (aux_chordDensity c y) = 1 := by
  have h1 := congrArg (fun μ : Measure ℝ² => μ univ)
    (aux_cd_diff_eq (c • ContinuousLinearMap.id ℝ ℝ²) c hc fun x => by
      rw [smul_apply, ContinuousLinearMap.id_apply, norm_smul,
        Real.norm_of_nonneg hc.le])
  have hu := aux_lw_u_meas
  rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
    Measure.map_apply (by fun_prop) MeasurableSet.univ, preimage_univ, measure_univ] at h1
  exact h1.symm

/-- **Lemma `lem:circle-difference`**. If $N$ is an invertible planar similarity, the
pushforward of $\sigma\otimes\sigma$ under $(\theta,\varphi)\mapsto N(u_\theta-u_\varphi)$ has a
nonnegative density $w_N\in L^1(\R^2)$ with integral one. -/
theorem lem_circle_difference (N : ℝ² →L[ℝ] ℝ²) (hN : ∃ c > 0, ∀ x, ‖N x‖ = c * ‖x‖) :
    ∃ wN : ℝ² → ℝ, (∀ y, 0 ≤ wN y) ∧ Integrable wN ∧ ∫ y, wN y = 1 ∧
      (σ.prod σ).map (fun p : Ang × Ang => N (u p.1 - u p.2)) =
        volume.withDensity (fun y => ENNReal.ofReal (wN y)) := by
  obtain ⟨c, hc, hNc⟩ := hN
  have hcdm := aux_cd_chordDensity_meas c
  have hnn := aux_cd_chordDensity_nonneg' c
  have hmass := aux_cd_chordDensity_mass c hc
  have hint : Integrable (aux_chordDensity c) := by
    refine ⟨hcdm.aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral]
    have : ∀ y, ‖aux_chordDensity c y‖ₑ = ENNReal.ofReal (aux_chordDensity c y) := fun y =>
      Real.enorm_eq_ofReal (hnn y)
    simp only [this, hmass, ENNReal.one_lt_top]
  refine ⟨aux_chordDensity c, hnn, hint, ?_, aux_cd_diff_eq N c hc hNc⟩
  rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall hnn) hcdm.aestronglyMeasurable,
    hmass, ENNReal.toReal_one]

/-! ### Weighted circle compactness (`lem:circle-compact`) -/

/-- The weighted circle operator $Tf(z)=\int W(z,\theta)f(z+Nu_\theta)\,d\sigma(\theta)$
(used in `\label{lem:circle-compact}`, see `Auto.lem_circle_compact_small`). -/
def circleOp (N : ℝ² →L[ℝ] ℝ²) (W : ℝ² → Ang → ℂ) (f : ℝ² → ℂ) (z : ℝ²) : ℂ :=
  ∫ θ, W z θ * f (z + N (u θ)) ∂σ

/-- Auxiliary for `lem:circle-compact`: for measurable `φ`, the map `(z, θ) ↦ z + φ(θ)` pushes
`dz ⊗ σ` forward to Lebesgue measure. -/
lemma aux_cc_add_mp (φ : Ang → ℝ²) (hφ : Measurable φ) :
    MeasurePreserving (fun p : ℝ² × Ang => p.1 + φ p.2) ((volume : Measure ℝ²).prod σ)
      volume := by
  have h2 : MeasurePreserving (fun p : Ang × ℝ² => (p.1, p.2 + φ p.1)) (σ.prod volume)
      (σ.prod volume) := by
    refine (MeasurePreserving.id σ).skew_product (g := fun θ x => x + φ θ) ?_ ?_
    · exact measurable_snd.add (hφ.comp measurable_fst)
    · exact ae_of_all _ fun θ => (measurePreserving_add_right _ _).map_eq
  have h := (measurePreserving_snd (μ := σ) (ν := (volume : Measure ℝ²))).comp
    (h2.comp (Measure.measurePreserving_swap (μ := (volume : Measure ℝ²)) (ν := σ)))
  exact h

/-- Auxiliary for `lem:circle-compact`: almost-everywhere equal functions agree along almost every
circle `θ ↦ z + φ(θ)`, for almost every center `z`. -/
lemma aux_cc_ae_circle (φ : Ang → ℝ²) (hφ : Measurable φ) {g g' : ℝ² → ℂ}
    (h : g =ᵐ[volume] g') : ∀ᵐ z ∂(volume : Measure ℝ²), ∀ᵐ θ ∂σ, g (z + φ θ) = g' (z + φ θ) := by
  have hmp := aux_cc_add_mp φ hφ
  have h1 : (fun p : ℝ² × Ang => g (p.1 + φ p.2)) =ᵐ[(volume : Measure ℝ²).prod σ]
      (fun p => g' (p.1 + φ p.2)) := hmp.quasiMeasurePreserving.ae_eq h
  exact Measure.ae_ae_of_ae_prod h1

/-- Auxiliary for `lem:circle-compact`: the Cauchy–Schwarz inequality
`(∫ f g)² ≤ ∫ f² ∫ g²` for nonnegative functions. -/
lemma aux_cc_cs {X : Type*} [MeasurableSpace X] (μ : Measure X) (f g : X → ℝ≥0∞)
    (hf : AEMeasurable f μ) (hg : AEMeasurable g μ) :
    (∫⁻ x, f x * g x ∂μ) ^ 2 ≤ (∫⁻ x, f x ^ 2 ∂μ) * ∫⁻ x, g x ^ 2 ∂μ := by
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq μ Real.HolderConjugate.two_two hf hg
  have e : ∀ t : ℝ≥0∞, (t ^ (1 / 2 : ℝ)) ^ 2 = t := fun t => by
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; norm_num
  calc (∫⁻ x, f x * g x ∂μ) ^ 2
      ≤ ((∫⁻ x, f x ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) * (∫⁻ x, g x ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ)) ^ 2 := by
        gcongr; simpa using h
    _ = _ := by rw [mul_pow, e, e]; simp only [ENNReal.rpow_two]

/-- Auxiliary for `lem:circle-compact`: Hölder's inequality with squares,
`∫ f g ≤ (∫ f²)^{1/2} (∫ g²)^{1/2}`. -/
lemma aux_cc_holder2 {X : Type*} [MeasurableSpace X] (μ : Measure X) (f g : X → ℝ≥0∞)
    (hf : AEMeasurable f μ) (hg : AEMeasurable g μ) :
    ∫⁻ x, f x * g x ∂μ ≤ (∫⁻ x, f x ^ 2 ∂μ) ^ (1 / 2 : ℝ) * (∫⁻ x, g x ^ 2 ∂μ) ^ (1 / 2 : ℝ) := by
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq μ Real.HolderConjugate.two_two hf hg
  simpa [ENNReal.rpow_two] using h

/-- Auxiliary: `t^{1/2} t^{1/2} = t` in `ℝ≥0∞`. -/
lemma aux_cc_sqrt_mul_self (t : ℝ≥0∞) : t ^ (1 / 2 : ℝ) * t ^ (1 / 2 : ℝ) = t := by
  rw [← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]; norm_num

/-- Auxiliary for `lem:circle-compact`: the square of a circle average expressed through the
circle-difference density `w_N` of `lem:circle-difference`:
`∫ (∫ a(y - N u_θ) dσ)² dy = ∫ a(z) ∫ w_N(v) a(z+v) dv dz`. -/
lemma aux_cc_sq_avg (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖)
    (a : ℝ² → ℝ≥0∞) (ha : Measurable a) :
    ∫⁻ y, (∫⁻ θ, a (y - N (u θ)) ∂σ) ^ 2 =
      ∫⁻ z, a z * ∫⁻ v, ENNReal.ofReal (aux_chordDensity c v) * a (z + v) := by
  have hNu : Measurable fun θ => N (u θ) := N.continuous.measurable.comp aux_lw_u_meas
  have hD : Measurable fun p : Ang × Ang => N (u p.1 - u p.2) :=
    N.continuous.measurable.comp ((aux_lw_u_meas.comp measurable_fst).sub
      (aux_lw_u_meas.comp measurable_snd))
  calc ∫⁻ y, (∫⁻ θ, a (y - N (u θ)) ∂σ) ^ 2
      = ∫⁻ y, ∫⁻ p, a (y - N (u p.1)) * a (y - N (u p.2)) ∂(σ.prod σ) := by
        refine lintegral_congr fun y => ?_
        have hm : Measurable fun θ => a (y - N (u θ)) := ha.comp (measurable_const.sub hNu)
        rw [sq, lintegral_prod_mul hm.aemeasurable hm.aemeasurable]
    _ = ∫⁻ p, (∫⁻ y, a (y - N (u p.1)) * a (y - N (u p.2))) ∂(σ.prod σ) := by
        refine lintegral_lintegral_swap ?_
        exact ((ha.comp (measurable_fst.sub (hNu.comp (measurable_fst.comp measurable_snd)))).mul
          (ha.comp (measurable_fst.sub
            (hNu.comp (measurable_snd.comp measurable_snd))))).aemeasurable
    _ = ∫⁻ p, (∫⁻ z, a z * a (z + N (u p.1 - u p.2))) ∂(σ.prod σ) := by
        refine lintegral_congr fun p => ?_
        rw [← lintegral_add_right_eq_self _ (N (u p.1))]
        refine lintegral_congr fun z => ?_
        simp only [map_sub, add_sub_cancel_right]
        congr 2; abel
    _ = ∫⁻ z, ∫⁻ p, a z * a (z + N (u p.1 - u p.2)) ∂(σ.prod σ) := by
        refine lintegral_lintegral_swap ?_
        exact ((ha.comp measurable_snd).mul (ha.comp (measurable_snd.add
          (hD.comp measurable_fst)))).aemeasurable
    _ = ∫⁻ z, a z * ∫⁻ v, a (z + v) ∂((σ.prod σ).map fun p : Ang × Ang => N (u p.1 - u p.2)) := by
        refine lintegral_congr fun z => ?_
        have hav : Measurable fun v : ℝ² => a (z + v) := ha.comp (measurable_const_add z)
        rw [lintegral_const_mul (a z) (show Measurable fun p : Ang × Ang =>
            a (z + N (u p.1 - u p.2)) from ha.comp (measurable_const.add hD)),
          lintegral_map hav hD]
    _ = _ := by
        rw [aux_cd_diff_eq N c hc hNc]
        refine lintegral_congr fun z => ?_
        have hav : Measurable fun v : ℝ² => a (z + v) := ha.comp (measurable_const_add z)
        rw [lintegral_withDensity_eq_lintegral_mul volume
          (f := fun y => ENNReal.ofReal (aux_chordDensity c y))
          (ENNReal.measurable_ofReal.comp (aux_cd_chordDensity_meas c)) hav]
        rfl

/-- Auxiliary for `lem:circle-compact`: the splitting estimate (`eq:circle-modulus`):
for `0 ≤ s ≤ 1` and `H > 0`,
`∫ (sk)(z) ∫ w_N(v) (sk)(z+v) dv dz ≤ (H ∫ s² + ∫_{w_N > H} w_N) ∫ k²`. -/
lemma aux_cc_split (c H : ℝ) (s k : ℝ² → ℝ≥0∞) (hs : Measurable s) (hk : Measurable k)
    (hs1 : ∀ z, s z ≤ 1) :
    ∫⁻ z, (s z * k z) * ∫⁻ v, ENNReal.ofReal (aux_chordDensity c v) * (s (z + v) * k (z + v)) ≤
      (ENNReal.ofReal H * (∫⁻ z, s z ^ 2) +
        ∫⁻ v in {v | H < aux_chordDensity c v}, ENNReal.ofReal (aux_chordDensity c v)) *
        ∫⁻ z, k z ^ 2 := by
  set w := aux_chordDensity c
  have hw := aux_cd_chordDensity_meas c
  set f : ℝ² → ℝ≥0∞ := fun v => ENNReal.ofReal (w v)
  have hf : Measurable f := ENNReal.measurable_ofReal.comp hw
  set S : Set ℝ² := {v | H < w v}
  have hS : MeasurableSet S := measurableSet_lt measurable_const hw
  set a : ℝ² → ℝ≥0∞ := fun z => s z * k z
  have ha : Measurable a := hs.mul hk
  have hak : ∀ z, a z ≤ k z := fun z => by
    calc a z = s z * k z := rfl
      _ ≤ 1 * k z := by gcongr; exact hs1 z
      _ = k z := one_mul _
  have ha2 : ∫⁻ z, a z ^ 2 ≤ ∫⁻ z, k z ^ 2 := lintegral_mono fun z => by gcongr; exact hak z
  have hsplit : ∀ v, f v = Sᶜ.indicator f v + S.indicator f v := fun v => by
    rw [add_comm]; exact (congrFun (Set.indicator_self_add_compl S f) v).symm
  have hmS : Measurable (S.indicator f) := hf.indicator hS
  have hmSc : Measurable (Sᶜ.indicator f) := hf.indicator hS.compl
  have hshift : ∀ z, Measurable fun v => a (z + v) := fun z => ha.comp (measurable_const_add z)
  -- the two parts
  have hP1 : ∀ z, ∫⁻ v, Sᶜ.indicator f v * a (z + v) ≤ ENNReal.ofReal H * ∫⁻ v, a v := by
    intro z
    calc ∫⁻ v, Sᶜ.indicator f v * a (z + v) ≤ ∫⁻ v, ENNReal.ofReal H * a (z + v) := by
          refine lintegral_mono fun v => mul_le_mul_left ?_ _
          by_cases hv : v ∈ S
          · rw [Set.indicator_of_notMem (by simpa using hv)]; exact bot_le
          · rw [Set.indicator_of_mem (by simpa using hv)]
            exact ENNReal.ofReal_le_ofReal (not_lt.1 hv)
      _ = ENNReal.ofReal H * ∫⁻ v, a v := by
          rw [lintegral_const_mul _ (hshift z), lintegral_add_left_eq_self]
  have hP2 : ∀ v, ∫⁻ z, a z * a (z + v) ≤ ∫⁻ z, a z ^ 2 := by
    intro v
    refine (aux_cc_holder2 volume a (fun z => a (z + v)) ha.aemeasurable
      (ha.comp (measurable_id.add measurable_const)).aemeasurable).trans (le_of_eq ?_)
    rw [lintegral_add_right_eq_self (fun z => a z ^ 2) v, aux_cc_sqrt_mul_self]
  calc ∫⁻ z, a z * ∫⁻ v, f v * a (z + v)
      = ∫⁻ z, (a z * ∫⁻ v, Sᶜ.indicator f v * a (z + v)) +
          a z * ∫⁻ v, S.indicator f v * a (z + v) := by
        refine lintegral_congr fun z => ?_
        rw [← mul_add, ← lintegral_add_left (f := fun v => Sᶜ.indicator f v * a (z + v))
          (hmSc.mul (hshift z))]
        congr 2; funext v; rw [hsplit v, add_mul]
    _ = (∫⁻ z, a z * ∫⁻ v, Sᶜ.indicator f v * a (z + v)) +
          ∫⁻ z, a z * ∫⁻ v, S.indicator f v * a (z + v) := by
        refine lintegral_add_left ?_ _
        exact ha.mul ((hmSc.comp measurable_snd).mul
          (ha.comp (measurable_fst.add measurable_snd))).lintegral_prod_right'
    _ ≤ (∫⁻ z, a z * (ENNReal.ofReal H * ∫⁻ v, a v)) +
          ∫⁻ v, S.indicator f v * ∫⁻ z, a z ^ 2 := by
        refine add_le_add (lintegral_mono fun z => mul_le_mul_right (hP1 z) _) ?_
        calc ∫⁻ z, a z * ∫⁻ v, S.indicator f v * a (z + v)
            = ∫⁻ z, ∫⁻ v, S.indicator f v * (a z * a (z + v)) := by
              refine lintegral_congr fun z => ?_
              rw [← lintegral_const_mul (a z) (f := fun v => S.indicator f v * a (z + v))
                (hmS.mul (hshift z))]
              congr 1; funext v; ring
          _ = ∫⁻ v, ∫⁻ z, S.indicator f v * (a z * a (z + v)) := by
              refine lintegral_lintegral_swap ?_
              exact ((hmS.comp measurable_snd).mul ((ha.comp measurable_fst).mul
                (ha.comp (measurable_fst.add measurable_snd)))).aemeasurable
          _ ≤ ∫⁻ v, S.indicator f v * ∫⁻ z, a z ^ 2 := by
              refine lintegral_mono fun v => ?_
              rw [lintegral_const_mul (S.indicator f v) (f := fun z => a z * a (z + v))
                (ha.mul (ha.comp (measurable_id.add measurable_const)))]
              exact mul_le_mul_right (hP2 v) _
    _ = ENNReal.ofReal H * (∫⁻ v, a v) ^ 2 +
          (∫⁻ v in S, f v) * ∫⁻ z, a z ^ 2 := by
        rw [lintegral_mul_const _ hmS, lintegral_indicator hS]
        congr 1
        rw [lintegral_mul_const _ ha]; ring
    _ ≤ ENNReal.ofReal H * ((∫⁻ z, s z ^ 2) * ∫⁻ z, k z ^ 2) +
          (∫⁻ v in S, f v) * ∫⁻ z, k z ^ 2 := by
        gcongr
        exact aux_cc_cs volume s k hs.aemeasurable hk.aemeasurable
    _ = _ := by ring

/-- Auxiliary for `lem:circle-compact`: the trivial bound `∫ (∫ a(y - φ(θ)) dσ)² dy ≤ ∫ a²`
(Jensen's inequality and translation invariance). -/
lemma aux_cc_sq_avg_le (φ : Ang → ℝ²) (hφ : Measurable φ) (a : ℝ² → ℝ≥0∞) (ha : Measurable a) :
    ∫⁻ y, (∫⁻ θ, a (y - φ θ) ∂σ) ^ 2 ≤ ∫⁻ z, a z ^ 2 := by
  have hm : Measurable fun p : ℝ² × Ang => a (p.1 - φ p.2) :=
    ha.comp (measurable_fst.sub (hφ.comp measurable_snd))
  calc ∫⁻ y, (∫⁻ θ, a (y - φ θ) ∂σ) ^ 2 ≤ ∫⁻ y, ∫⁻ θ, a (y - φ θ) ^ 2 ∂σ := by
        refine lintegral_mono fun y => ?_
        have h := aux_cc_cs σ (fun θ => a (y - φ θ)) (fun _ => 1)
          (ha.comp (measurable_const.sub hφ)).aemeasurable aemeasurable_const
        simpa using h
    _ = ∫⁻ θ, ∫⁻ y, a (y - φ θ) ^ 2 ∂volume ∂σ :=
        lintegral_lintegral_swap (hm.pow_const 2).aemeasurable
    _ = ∫⁻ θ, ∫⁻ z, a z ^ 2 ∂volume ∂σ := by
        refine lintegral_congr fun θ => ?_
        exact lintegral_sub_right_eq_self (fun z => a z ^ 2) (φ θ)
    _ = ∫⁻ z, a z ^ 2 := by simp

/-- Auxiliary for `lem:circle-compact`: the bound
`‖√e T f‖₂ ≤ (min(1, H‖e‖₁ + ∫_{w_N>H} w_N))^{1/2} ‖f‖₂` for every `H`
(see `Auto.lem_circle_compact_small`). -/
lemma aux_cc_small_H (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖)
    (W : ℝ² → Ang → ℂ) (hW1 : ∀ z θ, ‖W z θ‖ ≤ 1)
    (e : ℝ² → ℝ) (he : Measurable e) (he01 : ∀ z, e z ∈ Icc 0 1)
    (f : ℝ² → ℂ) (hf : MemLp f 2) (H : ℝ) :
    eLpNorm (fun z => (Real.sqrt (e z) : ℂ) * circleOp N W f z) 2 volume ≤
      (min 1 (ENNReal.ofReal H * (∫⁻ z, ENNReal.ofReal (e z)) +
        ∫⁻ v in {v | H < aux_chordDensity c v}, ENNReal.ofReal (aux_chordDensity c v))) ^
          (1 / 2 : ℝ) * eLpNorm f 2 volume := by
  set B := min 1 (ENNReal.ofReal H * (∫⁻ z, ENNReal.ofReal (e z)) +
    ∫⁻ v in {v | H < aux_chordDensity c v}, ENNReal.ofReal (aux_chordDensity c v))
  have hNu : Measurable fun θ => N (u θ) := N.continuous.measurable.comp aux_lw_u_meas
  set f' := hf.1.mk f
  have hf'm : Measurable f' := hf.1.stronglyMeasurable_mk.measurable
  set F : ℝ² → ℝ≥0∞ := fun y => ‖f' y‖ₑ
  have hF : Measurable F := hf'm.enorm
  set s : ℝ² → ℝ≥0∞ := fun z => ENNReal.ofReal (Real.sqrt (e z))
  have hs : Measurable s := ENNReal.measurable_ofReal.comp (Real.continuous_sqrt.measurable.comp he)
  have hs1 : ∀ z, s z ≤ 1 := fun z => by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (Real.sqrt_le_one.2 (he01 z).2)
  have hs2 : ∀ z, s z ^ 2 = ENNReal.ofReal (e z) := fun z => by
    rw [← ENNReal.ofReal_pow (Real.sqrt_nonneg _), Real.sq_sqrt (he01 z).1]
  set A : ℝ² → ℝ≥0∞ := fun z => s z * ∫⁻ θ, F (z + N (u θ)) ∂σ
  have hFc : Measurable fun p : ℝ² × Ang => F (p.1 + N (u p.2)) :=
    hF.comp (measurable_fst.add (hNu.comp measurable_snd))
  have hA : Measurable A := hs.mul hFc.lintegral_prod_right'
  -- pointwise domination
  have hpt : ∀ᵐ z ∂(volume : Measure ℝ²),
      ‖(Real.sqrt (e z) : ℂ) * circleOp N W f z‖ₑ ≤ A z := by
    filter_upwards [aux_cc_ae_circle (fun θ => N (u θ)) hNu hf.1.ae_eq_mk] with z hz
    rw [enorm_mul]
    have h1 : ‖((Real.sqrt (e z) : ℝ) : ℂ)‖ₑ = s z := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
    rw [h1]
    refine mul_le_mul_right ?_ _
    unfold circleOp
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono_ae ?_)
    filter_upwards [hz] with θ hθ
    rw [hθ, enorm_mul]
    calc ‖W z θ‖ₑ * ‖f' (z + N (u θ))‖ₑ ≤ 1 * ‖f' (z + N (u θ))‖ₑ := by
          gcongr
          rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hW1 z θ)
      _ = F (z + N (u θ)) := one_mul _
  -- duality
  have hdual : (∫⁻ z, A z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤
      (∫⁻ y, F y ^ 2) ^ (1 / 2 : ℝ) * B ^ (1 / 2 : ℝ) := by
    refine aux_lw_duality A hA _ fun h hh hfin => ?_
    set G : ℝ² → ℝ≥0∞ := fun y => ∫⁻ θ, (s (y - N (u θ)) * h (y - N (u θ))) ∂σ
    have hsh : Measurable fun z => s z * h z := hs.mul hh
    have e1 : ∫⁻ z, h z * A z = ∫⁻ y, F y * G y := by
      calc ∫⁻ z, h z * A z = ∫⁻ z, ∫⁻ θ, s z * h z * F (z + N (u θ)) ∂σ := by
            refine lintegral_congr fun z => ?_
            have hFz : Measurable fun θ : Ang => F (z + N (u θ)) :=
              hF.comp (measurable_const.add hNu)
            change h z * (s z * ∫⁻ θ, F (z + N (u θ)) ∂σ) = _
            rw [← lintegral_const_mul _ hFz, ← lintegral_const_mul _ (hFz.const_mul _)]
            refine lintegral_congr fun θ => ?_
            ring
        _ = ∫⁻ θ, ∫⁻ z, s z * h z * F (z + N (u θ)) ∂volume ∂σ :=
            lintegral_lintegral_swap ((hsh.comp measurable_fst).mul hFc).aemeasurable
        _ = ∫⁻ θ, ∫⁻ y, F y * (s (y - N (u θ)) * h (y - N (u θ))) ∂volume ∂σ := by
            refine lintegral_congr fun θ => ?_
            rw [← lintegral_sub_right_eq_self _ (N (u θ))]
            refine lintegral_congr fun y => ?_
            simp only [sub_add_cancel]; ring
        _ = ∫⁻ y, ∫⁻ θ, F y * (s (y - N (u θ)) * h (y - N (u θ))) ∂σ := by
            refine lintegral_lintegral_swap ?_
            exact ((hF.comp measurable_snd).mul (hsh.comp
              (measurable_snd.sub (hNu.comp measurable_fst)))).aemeasurable
        _ = ∫⁻ y, F y * G y := by
            refine lintegral_congr fun y => ?_
            have hy' : Measurable fun θ : Ang => s (y - N (u θ)) * h (y - N (u θ)) :=
              hsh.comp (measurable_const.sub hNu)
            rw [lintegral_const_mul _ hy']
    have hG2 : ∫⁻ y, G y ^ 2 ≤ B * ∫⁻ z, h z ^ 2 := by
      have hsq := aux_cc_sq_avg N c hc hNc (fun z => s z * h z) hsh
      have hb1 := aux_cc_sq_avg_le (fun θ => N (u θ)) hNu (fun z => s z * h z) hsh
      have hb2 := aux_cc_split c H s h hs hh hs1
      have hsq2 : ∫⁻ z, (s z * h z) ^ 2 ≤ ∫⁻ z, h z ^ 2 := lintegral_mono fun z => by
        gcongr; calc s z * h z ≤ 1 * h z := by gcongr; exact hs1 z
          _ = h z := one_mul _
      rw [show B * ∫⁻ z, h z ^ 2 = min (1 * ∫⁻ z, h z ^ 2)
          ((ENNReal.ofReal H * (∫⁻ z, ENNReal.ofReal (e z)) +
            ∫⁻ v in {v | H < aux_chordDensity c v}, ENNReal.ofReal (aux_chordDensity c v)) *
              ∫⁻ z, h z ^ 2) from min_mul_of_nonneg _ _ bot_le]
      refine le_min (by rw [one_mul]; exact hb1.trans hsq2) ?_
      rw [hsq]
      simp only [hs2] at hb2
      exact hb2
    calc ∫⁻ z, h z * A z = ∫⁻ y, F y * G y := e1
      _ ≤ (∫⁻ y, F y ^ 2) ^ (1 / 2 : ℝ) * (∫⁻ y, G y ^ 2) ^ (1 / 2 : ℝ) :=
          aux_cc_holder2 volume F G hF.aemeasurable
            (hsh.comp (measurable_fst.sub
              (hNu.comp measurable_snd))).lintegral_prod_right'.aemeasurable
      _ ≤ (∫⁻ y, F y ^ 2) ^ (1 / 2 : ℝ) * (B * ∫⁻ z, h z ^ 2) ^ (1 / 2 : ℝ) := by
          gcongr
      _ = (∫⁻ y, F y ^ 2) ^ (1 / 2 : ℝ) * B ^ (1 / 2 : ℝ) *
            (∫⁻ x, h x ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), mul_assoc]
          simp only [ENNReal.rpow_two]
  have hFn : (∫⁻ y, F y ^ 2) ^ (1 / 2 : ℝ) = eLpNorm f 2 volume := by
    rw [eLpNorm_congr_ae hf.1.ae_eq_mk, aux_lw_eLpNorm_two]
    simp only [F, ENNReal.rpow_two]
    rfl
  calc eLpNorm (fun z => (Real.sqrt (e z) : ℂ) * circleOp N W f z) 2 volume
      ≤ (∫⁻ z, A z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
        rw [aux_lw_eLpNorm_two]
        gcongr ?_ ^ _
        exact lintegral_mono_ae (hpt.mono fun z hz => by gcongr)
    _ ≤ _ := hdual
    _ = _ := by rw [hFn, mul_comm]

/-- Auxiliary for `lem:circle-compact`: the tail `∫_{w_N > H} w_N` of the chord density tends to
zero; we only need that it becomes small for some `H > 0`. -/
lemma aux_cc_tail_small (c : ℝ) (hc : 0 < c) (δ : ℝ≥0∞) (hδ : 0 < δ) :
    ∃ H : ℝ, 0 < H ∧
      ∫⁻ v in {v | H < aux_chordDensity c v}, ENNReal.ofReal (aux_chordDensity c v) < δ := by
  set w := aux_chordDensity c
  have hw := aux_cd_chordDensity_meas c
  set μ' : Measure ℝ² := volume.withDensity fun v => ENNReal.ofReal (w v)
  set S : ℕ → Set ℝ² := fun n => {v | (n : ℝ) < w v}
  have hSm : ∀ n, MeasurableSet (S n) := fun n => measurableSet_lt measurable_const hw
  have hanti : Antitone S := fun m n hmn v hv => by
    simp only [S, mem_ofPred_eq] at hv ⊢
    exact lt_of_le_of_lt (by exact_mod_cast hmn) hv
  have hfin : μ' (S 0) ≠ ⊤ := by
    refine ne_top_of_le_ne_top (b := μ' univ) ?_ (measure_mono (subset_univ _))
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
      aux_cd_chordDensity_mass c hc]
    exact ENNReal.one_ne_top
  have hlim := tendsto_measure_iInter_atTop (μ := μ') (fun n => (hSm n).nullMeasurableSet) hanti
    ⟨0, hfin⟩
  have hempty : (⋂ n, S n) = ∅ := by
    ext v
    simp only [mem_iInter, mem_ofPred_eq, S, mem_empty_iff_false, iff_false, not_forall, not_lt]
    obtain ⟨n, hn⟩ := exists_nat_ge (w v)
    exact ⟨n, hn⟩
  rw [hempty, measure_empty] at hlim
  obtain ⟨n, hn, hn1⟩ := ((hlim.eventually (gt_mem_nhds hδ)).and (eventually_ge_atTop 1)).exists
  refine ⟨n, by exact_mod_cast hn1, ?_⟩
  have : μ' (S n) = ∫⁻ v in {v | (n : ℝ) < w v}, ENNReal.ofReal (w v) :=
    withDensity_apply _ (hSm n)
  rw [← this]; exact hn

/-- **Lemma `lem:circle-compact`** (small-set control). Let $N$ be an invertible planar
similarity and $W$ a measurable function with $|W|\le1$. There is a nondecreasing function
$\omega_N:[0,\infty)\to[0,1]$, with $\omega_N(s)\to0$ as $s\downarrow0$, independent of $W$,
such that $\|\sqrt e\,T\|_{L^2\to L^2}\le\omega_N(\|e\|_1)$ if $0\le e\le1$, $e\in L^1$. -/
theorem lem_circle_compact_small (N : ℝ² →L[ℝ] ℝ²) (hN : ∃ c > 0, ∀ x, ‖N x‖ = c * ‖x‖) :
    ∃ ω : ℝ → ℝ, MonotoneOn ω (Ici 0) ∧ (∀ s, 0 ≤ s → ω s ∈ Icc 0 1) ∧
      Tendsto ω (𝓝[>] 0) (𝓝 0) ∧
      ∀ (W : ℝ² → Ang → ℂ), Measurable (Function.uncurry W) → (∀ z θ, ‖W z θ‖ ≤ 1) →
      ∀ (e : ℝ² → ℝ), Measurable e → (∀ z, e z ∈ Icc 0 1) → Integrable e →
      ∀ f : ℝ² → ℂ, MemLp f 2 →
        eLpNorm (fun z => (Real.sqrt (e z) : ℂ) * circleOp N W f z) 2 volume ≤
          ENNReal.ofReal (ω (∫ z, e z)) * eLpNorm f 2 volume := by
  obtain ⟨c, hc, hNc⟩ := hN
  set T : ℝ → ℝ≥0∞ := fun H =>
    ∫⁻ v in {v | H < aux_chordDensity c v}, ENNReal.ofReal (aux_chordDensity c v)
  set Ω : ℝ → ℝ≥0∞ := fun s => ⨅ (H : ℝ) (_ : 0 < H),
    (min 1 (ENNReal.ofReal H * ENNReal.ofReal s + T H)) ^ (1 / 2 : ℝ)
  have hΩ1 : ∀ s, Ω s ≤ 1 := fun s =>
    iInf_le_of_le 1 (iInf_le_of_le one_pos (ENNReal.rpow_le_one (min_le_left _ _) (by norm_num)))
  have hΩt : ∀ s, Ω s ≠ ⊤ := fun s => ne_top_of_le_ne_top ENNReal.one_ne_top (hΩ1 s)
  have hΩmono : Monotone Ω := fun s t hst =>
    iInf₂_mono fun H _ => by gcongr
  refine ⟨fun s => (Ω s).toReal, ?_, ?_, ?_, ?_⟩
  · exact fun s _ t _ hst => ENNReal.toReal_mono (hΩt t) (hΩmono hst)
  · intro s _
    exact ⟨ENNReal.toReal_nonneg, ENNReal.toReal_le_of_le_ofReal zero_le_one
      (by rw [ENNReal.ofReal_one]; exact hΩ1 s)⟩
  · rw [Metric.tendsto_nhdsWithin_nhds]
    intro ε hε
    obtain ⟨H, hH, hT⟩ := aux_cc_tail_small c hc (ENNReal.ofReal (ε ^ 2 / 2)) (by
      rw [ENNReal.ofReal_pos]; positivity)
    refine ⟨ε ^ 2 / 2 / H, by positivity, fun x hx hdx => ?_⟩
    simp only [mem_Ioi] at hx
    rw [Real.dist_eq, sub_zero, abs_of_pos hx] at hdx
    rw [Real.dist_eq, sub_zero, abs_of_nonneg ENNReal.toReal_nonneg]
    refine ENNReal.toReal_lt_of_lt_ofReal ?_
    have h1 : ENNReal.ofReal H * ENNReal.ofReal x < ENNReal.ofReal (ε ^ 2 / 2) := by
      rw [← ENNReal.ofReal_mul hH.le, ENNReal.ofReal_lt_ofReal_iff (by positivity)]
      rw [lt_div_iff₀ hH] at hdx
      linarith
    calc Ω x ≤ (min 1 (ENNReal.ofReal H * ENNReal.ofReal x + T H)) ^ (1 / 2 : ℝ) :=
          iInf_le_of_le H (iInf_le_of_le hH le_rfl)
      _ ≤ (ENNReal.ofReal H * ENNReal.ofReal x + T H) ^ (1 / 2 : ℝ) :=
          ENNReal.rpow_le_rpow (min_le_right _ _) (by norm_num)
      _ < (ENNReal.ofReal (ε ^ 2 / 2) + ENNReal.ofReal (ε ^ 2 / 2)) ^ (1 / 2 : ℝ) :=
          ENNReal.rpow_lt_rpow (ENNReal.add_lt_add h1 hT) (by norm_num)
      _ = ENNReal.ofReal ε := by
          rw [← ENNReal.ofReal_add (by positivity) (by positivity), add_halves,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num), ← Real.sqrt_eq_rpow,
            Real.sqrt_sq hε.le]
  · intro W _ hW1 e he he01 hei f hf
    have hint : ∫⁻ z, ENNReal.ofReal (e z) = ENNReal.ofReal (∫ z, e z) :=
      (ofReal_integral_eq_lintegral_ofReal hei (Eventually.of_forall fun z => (he01 z).1)).symm
    rw [ENNReal.ofReal_toReal (hΩt _)]
    set X := eLpNorm (fun z => (Real.sqrt (e z) : ℂ) * circleOp N W f z) 2 volume
    have hX : ∀ H, X ≤ (min 1 (ENNReal.ofReal H * ENNReal.ofReal (∫ z, e z) + T H)) ^
        (1 / 2 : ℝ) * eLpNorm f 2 volume := fun H => by
      have := aux_cc_small_H N c hc hNc W hW1 e he he01 f hf H
      rwa [hint] at this
    rcases eq_or_ne (eLpNorm f 2 volume) 0 with h0 | h0
    · have := hX 1
      rw [h0, mul_zero] at this
      rw [h0, mul_zero]; exact this
    · rw [← ENNReal.div_le_iff h0 hf.2.ne]
      refine le_iInf₂ fun H _ => ?_
      exact ENNReal.div_le_of_le_mul (hX H)

/-- Auxiliary for `lem:circle-compact`: a generalized weighted average operator
`g ↦ (z ↦ ∫ K(z,p) g(z + D p) dρ(p))` over a probability space `(P, ρ)`.  The circle operator
`Auto.circleOp` is the case `P = 𝕋`, `D θ = N u_θ`; `T T*` is the case `P = 𝕋²`. -/
@[nolint defsWithUnderscore]
def aux_gop {P : Type*} [MeasurableSpace P] (ρ : Measure P) (K : ℝ² → P → ℂ) (D : P → ℝ²)
    (g : ℝ² → ℂ) (z : ℝ²) : ℂ :=
  ∫ p, K z p * g (z + D p) ∂ρ

section Gop

set_option linter.unusedSectionVars false

variable {P : Type*} [MeasurableSpace P] (ρ : Measure P) [IsProbabilityMeasure ρ]

/-- Auxiliary for `lem:circle-compact`: `(z, p) ↦ z + D p` pushes `dz ⊗ ρ` to Lebesgue measure. -/
lemma aux_gop_add_mp (D : P → ℝ²) (hD : Measurable D) :
    MeasurePreserving (fun q : ℝ² × P => q.1 + D q.2) ((volume : Measure ℝ²).prod ρ) volume := by
  have h2 : MeasurePreserving (fun q : P × ℝ² => (q.1, q.2 + D q.1)) (ρ.prod volume)
      (ρ.prod volume) := by
    refine (MeasurePreserving.id ρ).skew_product (g := fun p x => x + D p) ?_ ?_
    · exact measurable_snd.add (hD.comp measurable_fst)
    · exact ae_of_all _ fun p => (measurePreserving_add_right _ _).map_eq
  exact (measurePreserving_snd (μ := ρ) (ν := (volume : Measure ℝ²))).comp
    (h2.comp (Measure.measurePreserving_swap (μ := (volume : Measure ℝ²)) (ν := ρ)))

/-- Auxiliary for `lem:circle-compact`: a.e.-equal functions agree on almost every translate. -/
lemma aux_gop_ae (D : P → ℝ²) (hD : Measurable D) {g g' : ℝ² → ℂ} (h : g =ᵐ[volume] g') :
    ∀ᵐ z ∂(volume : Measure ℝ²), ∀ᵐ p ∂ρ, g (z + D p) = g' (z + D p) := by
  have h1 : (fun q : ℝ² × P => g (q.1 + D q.2)) =ᵐ[(volume : Measure ℝ²).prod ρ]
      (fun q => g' (q.1 + D q.2)) := (aux_gop_add_mp ρ D hD).quasiMeasurePreserving.ae_eq h
  exact Measure.ae_ae_of_ae_prod h1

omit [IsProbabilityMeasure ρ] in
/-- Auxiliary for `lem:circle-compact`: pointwise domination by the unweighted average. -/
lemma aux_gop_enorm_le (K : ℝ² → P → ℂ) (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (g : ℝ² → ℂ)
    (z : ℝ²) : ‖aux_gop ρ K D g z‖ₑ ≤ ∫⁻ p, ‖g (z + D p)‖ₑ ∂ρ := by
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun p => ?_)
  rw [enorm_mul]
  calc ‖K z p‖ₑ * ‖g (z + D p)‖ₑ ≤ 1 * ‖g (z + D p)‖ₑ := by
        gcongr
        rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hK1 z p)
    _ = _ := one_mul _

/-- Auxiliary for `lem:circle-compact`: `∫ (∫ a(z + D p) dρ)² dz ≤ ∫ a²`. -/
lemma aux_gop_sq_le (D : P → ℝ²) (hD : Measurable D) (a : ℝ² → ℝ≥0∞) (ha : Measurable a) :
    ∫⁻ z, (∫⁻ p, a (z + D p) ∂ρ) ^ 2 ≤ ∫⁻ z, a z ^ 2 := by
  have hm : Measurable fun q : ℝ² × P => a (q.1 + D q.2) :=
    ha.comp (measurable_fst.add (hD.comp measurable_snd))
  calc ∫⁻ z, (∫⁻ p, a (z + D p) ∂ρ) ^ 2 ≤ ∫⁻ z, ∫⁻ p, a (z + D p) ^ 2 ∂ρ := by
        refine lintegral_mono fun z => ?_
        have h := aux_cc_cs ρ (fun p => a (z + D p)) (fun _ => 1)
          (ha.comp (measurable_const.add hD)).aemeasurable aemeasurable_const
        simpa using h
    _ = ∫⁻ p, ∫⁻ z, a (z + D p) ^ 2 ∂volume ∂ρ :=
        lintegral_lintegral_swap (hm.pow_const 2).aemeasurable
    _ = ∫⁻ p, ∫⁻ z, a z ^ 2 ∂volume ∂ρ := by
        refine lintegral_congr fun p => ?_
        exact lintegral_add_right_eq_self (fun z => a z ^ 2) (D p)
    _ = ∫⁻ z, a z ^ 2 := by simp

/-- Auxiliary for `lem:circle-compact`: the operator respects a.e. equality. -/
lemma aux_gop_congr (K : ℝ² → P → ℂ) (D : P → ℝ²) (hD : Measurable D) {g g' : ℝ² → ℂ}
    (h : g =ᵐ[volume] g') : aux_gop ρ K D g =ᵐ[volume] aux_gop ρ K D g' := by
  filter_upwards [aux_gop_ae ρ D hD h] with z hz
  exact integral_congr_ae (hz.mono fun p hp => by simp only [hp])

/-- Auxiliary for `lem:circle-compact`: measurability of the output. -/
lemma aux_gop_aesm (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K)) (D : P → ℝ²)
    (hD : Measurable D) (g : ℝ² → ℂ) (hg : AEStronglyMeasurable g volume) :
    AEStronglyMeasurable (aux_gop ρ K D g) volume := by
  have hm : StronglyMeasurable fun q : ℝ² × P => K q.1 q.2 * hg.mk g (q.1 + D q.2) :=
    (hK.mul (hg.stronglyMeasurable_mk.measurable.comp
      (measurable_fst.add (hD.comp measurable_snd)))).stronglyMeasurable
  exact hm.integral_prod_right'.aestronglyMeasurable.congr
    (aux_gop_congr ρ K D hD hg.ae_eq_mk).symm

/-- Auxiliary for `lem:circle-compact`: the `L²` bound `‖Gf‖₂ ≤ ‖f‖₂`. -/
lemma aux_gop_eLpNorm_le (K : ℝ² → P → ℂ) (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²)
    (hD : Measurable D) (g : ℝ² → ℂ) (hg : AEStronglyMeasurable g volume) :
    eLpNorm (aux_gop ρ K D g) 2 volume ≤ eLpNorm g 2 volume := by
  rw [eLpNorm_congr_ae (aux_gop_congr ρ K D hD hg.ae_eq_mk), eLpNorm_congr_ae hg.ae_eq_mk,
    aux_lw_eLpNorm_two, aux_lw_eLpNorm_two]
  have hm := hg.stronglyMeasurable_mk.measurable.enorm
  gcongr ?_ ^ _
  simp only [ENNReal.rpow_two]
  calc ∫⁻ z, ‖aux_gop ρ K D (hg.mk g) z‖ₑ ^ 2
      ≤ ∫⁻ z, (∫⁻ p, ‖hg.mk g (z + D p)‖ₑ ∂ρ) ^ 2 :=
        lintegral_mono fun z => by gcongr; exact aux_gop_enorm_le ρ K hK1 D _ z
    _ ≤ _ := aux_gop_sq_le ρ D hD _ hm

/-- Auxiliary for `lem:circle-compact`: `L²` inputs give `L²` outputs. -/
lemma aux_gop_memLp (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (hD : Measurable D) (g : ℝ² → ℂ) (hg : MemLp g 2) :
    MemLp (aux_gop ρ K D g) 2 :=
  ⟨aux_gop_aesm ρ K hK D hD g hg.1, (aux_gop_eLpNorm_le ρ K hK1 D hD g hg.1).trans_lt hg.2⟩

/-- Auxiliary for `lem:circle-compact`: for `g ∈ L²` and a.e. `z`, the defining integrand is
integrable. -/
lemma aux_gop_integrable (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (hD : Measurable D) (g : ℝ² → ℂ) (hg : MemLp g 2) :
    ∀ᵐ z ∂(volume : Measure ℝ²), Integrable (fun p => K z p * g (z + D p)) ρ := by
  set g' := hg.1.mk g
  have hg'm : Measurable g' := hg.1.stronglyMeasurable_mk.measurable
  have hA : Measurable fun z => ∫⁻ p, ‖g' (z + D p)‖ₑ ∂ρ :=
    (hg'm.enorm.comp (measurable_fst.add (hD.comp measurable_snd))).lintegral_prod_right'
  have hfin : ∫⁻ z, (∫⁻ p, ‖g' (z + D p)‖ₑ ∂ρ) ^ 2 ≠ ⊤ := by
    refine ne_top_of_le_ne_top ?_ (aux_gop_sq_le ρ D hD _ hg'm.enorm)
    have h2 := (hg.ae_eq hg.1.ae_eq_mk).2
    rw [aux_lw_eLpNorm_two] at h2
    simp only [ENNReal.rpow_two] at h2
    intro htop
    rw [htop, ENNReal.top_rpow_of_pos (by norm_num)] at h2
    exact lt_irrefl _ h2
  filter_upwards [ae_lt_top (hA.pow_const 2) hfin, aux_gop_ae ρ D hD hg.1.ae_eq_mk] with z hz hz'
  have hz2 : ∫⁻ p, ‖g' (z + D p)‖ₑ ∂ρ < ⊤ := by
    by_contra h
    rw [not_lt, top_le_iff] at h
    rw [h] at hz; simp at hz
  have hmeas : Measurable fun p => K z p * g' (z + D p) :=
    (hK.comp (measurable_const.prodMk measurable_id)).mul (hg'm.comp (measurable_const.add hD))
  refine Integrable.congr (f := fun p => K z p * g' (z + D p)) ?_
    (hz'.mono fun p hp => by change K z p * g' (z + D p) = K z p * g (z + D p); rw [hp])
  refine ⟨hmeas.aestronglyMeasurable, ?_⟩
  refine lt_of_le_of_lt (lintegral_mono fun p => ?_) hz2
  rw [enorm_mul]
  calc ‖K z p‖ₑ * ‖g' (z + D p)‖ₑ ≤ 1 * ‖g' (z + D p)‖ₑ := by
        gcongr
        rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hK1 z p)
    _ = _ := one_mul _

/-- Auxiliary for `lem:circle-compact`: additivity. -/
lemma aux_gop_add (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (hD : Measurable D) (g₁ g₂ : ℝ² → ℂ)
    (h₁ : MemLp g₁ 2) (h₂ : MemLp g₂ 2) :
    aux_gop ρ K D (g₁ + g₂) =ᵐ[volume] aux_gop ρ K D g₁ + aux_gop ρ K D g₂ := by
  filter_upwards [aux_gop_integrable ρ K hK hK1 D hD g₁ h₁,
    aux_gop_integrable ρ K hK hK1 D hD g₂ h₂] with z hz₁ hz₂
  simp only [aux_gop, Pi.add_apply, mul_add]
  exact integral_add hz₁ hz₂

omit [IsProbabilityMeasure ρ] in
/-- Auxiliary for `lem:circle-compact`: homogeneity. -/
lemma aux_gop_smul (K : ℝ² → P → ℂ) (D : P → ℝ²) (c : ℂ) (g : ℝ² → ℂ) :
    aux_gop ρ K D (c • g) = c • aux_gop ρ K D g := by
  funext z
  simp only [aux_gop, Pi.smul_apply, smul_eq_mul]
  rw [← integral_const_mul]; congr 1; funext p; ring

/-- Auxiliary for `lem:circle-compact`: the operator `aux_gop` as a bounded operator on `L²`. -/
@[nolint defsWithUnderscore]
def aux_gopL (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (hD : Measurable D) :
    Lp ℂ 2 (volume : Measure ℝ²) →L[ℂ] Lp ℂ 2 (volume : Measure ℝ²) :=
  LinearMap.mkContinuous
    { toFun := fun f => (aux_gop_memLp ρ K hK hK1 D hD f (Lp.memLp f)).toLp _
      map_add' := fun f g => by
        apply Lp.ext
        filter_upwards [
          MemLp.coeFn_toLp (aux_gop_memLp ρ K hK hK1 D hD ⇑(f + g) (Lp.memLp (f + g))),
          MemLp.coeFn_toLp (aux_gop_memLp ρ K hK hK1 D hD f (Lp.memLp f)),
          MemLp.coeFn_toLp (aux_gop_memLp ρ K hK hK1 D hD g (Lp.memLp g)),
          Lp.coeFn_add ((aux_gop_memLp ρ K hK hK1 D hD f (Lp.memLp f)).toLp _)
            ((aux_gop_memLp ρ K hK hK1 D hD g (Lp.memLp g)).toLp _),
          aux_gop_congr ρ K D hD (Lp.coeFn_add f g),
          aux_gop_add ρ K hK hK1 D hD f g (Lp.memLp f) (Lp.memLp g)] with x h1 h2 h3 h4 h5 h6
        rw [h4, Pi.add_apply, h1, h5, h6, Pi.add_apply, h2, h3]
      map_smul' := fun c f => by
        apply Lp.ext
        filter_upwards [
          MemLp.coeFn_toLp (aux_gop_memLp ρ K hK hK1 D hD ⇑(c • f) (Lp.memLp (c • f))),
          MemLp.coeFn_toLp (aux_gop_memLp ρ K hK hK1 D hD f (Lp.memLp f)),
          Lp.coeFn_smul c ((aux_gop_memLp ρ K hK hK1 D hD f (Lp.memLp f)).toLp _),
          aux_gop_congr ρ K D hD (Lp.coeFn_smul c f)] with x h1 h2 h3 h4
        rw [RingHom.id_apply, h3, Pi.smul_apply, h1, h4, aux_gop_smul, Pi.smul_apply, h2] }
    1 (fun f => by
      simp only [LinearMap.coe_mk, AddHom.coe_mk, one_mul]
      rw [Lp.norm_toLp, Lp.norm_def]
      exact ENNReal.toReal_mono (Lp.eLpNorm_ne_top f)
        (aux_gop_eLpNorm_le ρ K hK1 D hD f (Lp.aestronglyMeasurable f)))

/-- Auxiliary for `lem:circle-compact`: `aux_gopL` is represented by `aux_gop`. -/
lemma aux_gopL_coe (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (hD : Measurable D)
    (f : Lp ℂ 2 (volume : Measure ℝ²)) :
    (aux_gopL ρ K hK hK1 D hD f : ℝ² → ℂ) =ᵐ[volume] aux_gop ρ K D f :=
  MemLp.coeFn_toLp (aux_gop_memLp ρ K hK hK1 D hD f (Lp.memLp f))

attribute [irreducible] aux_gopL

/-- Auxiliary for `lem:circle-compact`: the adjoint weight `K'(y,p) = conj K(y - D p, p)`. -/
@[nolint defsWithUnderscore]
def aux_gopAdjW (K : ℝ² → P → ℂ) (D : P → ℝ²) (y : ℝ²) (p : P) : ℂ := conj (K (y - D p) p)

lemma aux_gopAdjW_meas (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K)) (D : P → ℝ²)
    (hD : Measurable D) : Measurable (Function.uncurry (aux_gopAdjW K D)) :=
  Complex.continuous_conj.measurable.comp
    (hK.comp ((measurable_fst.sub (hD.comp measurable_snd)).prodMk measurable_snd))

omit [MeasurableSpace P] in
lemma aux_gopAdjW_le (K : ℝ² → P → ℂ) (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) :
    ∀ y p, ‖aux_gopAdjW K D y p‖ ≤ 1 := fun y p => by
  rw [aux_gopAdjW, Complex.norm_conj]; exact hK1 _ _

/-- Auxiliary for `lem:circle-compact`: the adjoint identity
`∫ conj(G* x) y = ∫ conj(x) (G y)` for `L²` functions. -/
lemma aux_gop_inner (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (hD : Measurable D) (x y : ℝ² → ℂ)
    (hx : MemLp x 2) (hy : MemLp y 2) :
    ∫ z, conj (aux_gop ρ (aux_gopAdjW K D) (fun p => -D p) x z) * y z =
      ∫ z, conj (x z) * aux_gop ρ K D y z := by
  have hmp := aux_gop_add_mp ρ D hD
  set F : ℝ² × P → ℂ := fun q => conj (x q.1) * (K q.1 q.2 * y (q.1 + D q.2))
  have hx2 : MemLp (fun q : ℝ² × P => conj (x q.1)) 2 ((volume : Measure ℝ²).prod ρ) :=
    (hx.star).comp_measurePreserving (measurePreserving_fst)
  have hy2 : MemLp (fun q : ℝ² × P => y (q.1 + D q.2)) 2 ((volume : Measure ℝ²).prod ρ) :=
    hy.comp_measurePreserving hmp
  have hprod : Integrable (fun q : ℝ² × P => conj (x q.1) * y (q.1 + D q.2))
      ((volume : Measure ℝ²).prod ρ) :=
    (hy2.integrable_mul hx2).congr (ae_of_all _ fun q => mul_comm _ _)
  have hF : Integrable F ((volume : Measure ℝ²).prod ρ) := by
    refine hprod.norm.mono' ?_ (Eventually.of_forall fun q => ?_)
    · exact hx2.1.mul ((hK.aestronglyMeasurable).mul hy2.1)
    · simp only [F, norm_mul]
      calc ‖conj (x q.1)‖ * (‖K q.1 q.2‖ * ‖y (q.1 + D q.2)‖)
          ≤ ‖conj (x q.1)‖ * (1 * ‖y (q.1 + D q.2)‖) := by gcongr; exact hK1 _ _
        _ = _ := by ring
  -- the sheared integrand
  have hsh : MeasurePreserving (fun q : ℝ² × P => (q.1 - D q.2, q.2))
      ((volume : Measure ℝ²).prod ρ) ((volume : Measure ℝ²).prod ρ) := by
    have h2 : MeasurePreserving (fun q : P × ℝ² => (q.1, q.2 - D q.1)) (ρ.prod volume)
        (ρ.prod volume) := by
      refine (MeasurePreserving.id ρ).skew_product (g := fun p x => x - D p) ?_ ?_
      · exact measurable_snd.sub (hD.comp measurable_fst)
      · exact ae_of_all _ fun p => (measurePreserving_sub_right _ _).map_eq
    exact (Measure.measurePreserving_swap (μ := ρ) (ν := (volume : Measure ℝ²))).comp
      (h2.comp (Measure.measurePreserving_swap (μ := (volume : Measure ℝ²)) (ν := ρ)))
  have hG : Integrable (fun q : ℝ² × P => F (q.1 - D q.2, q.2))
      ((volume : Measure ℝ²).prod ρ) := (hsh.integrable_comp hF.1).2 hF
  calc ∫ z, conj (aux_gop ρ (aux_gopAdjW K D) (fun p => -D p) x z) * y z
      = ∫ z, ∫ p, F (z - D p, p) ∂ρ := by
        refine integral_congr_ae (Eventually.of_forall fun z => ?_)
        simp only [aux_gop, aux_gopAdjW, F]
        rw [← integral_conj, ← integral_mul_const]
        congr 1; funext p
        simp only [map_mul, Complex.conj_conj, sub_add_cancel, ← sub_eq_add_neg]
        ring
    _ = ∫ p, ∫ z, F (z - D p, p) ∂volume ∂ρ := integral_integral_swap hG
    _ = ∫ p, ∫ z, F (z, p) ∂volume ∂ρ := by
        congr 1; funext p
        exact integral_sub_right_eq_self (fun z => F (z, p)) (D p)
    _ = ∫ z, ∫ p, F (z, p) ∂ρ := (integral_integral_swap hF).symm
    _ = _ := by
        congr 1; funext z
        simp only [aux_gop, F]
        exact integral_const_mul _ _

/-- Auxiliary for `lem:circle-compact`: the adjoint of `aux_gopL`. -/
lemma aux_gopL_adjoint (K : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (D : P → ℝ²) (hD : Measurable D) :
    ContinuousLinearMap.adjoint (aux_gopL ρ K hK hK1 D hD) =
      aux_gopL ρ (aux_gopAdjW K D) (aux_gopAdjW_meas K hK D hD) (aux_gopAdjW_le K hK1 D)
        (fun p => -D p) hD.neg := by
  symm
  rw [ContinuousLinearMap.eq_adjoint_iff]
  intro x y
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  have h1 := aux_gopL_coe ρ (aux_gopAdjW K D) (aux_gopAdjW_meas K hK D hD)
    (aux_gopAdjW_le K hK1 D) (fun p => -D p) hD.neg x
  have h2 := aux_gopL_coe ρ K hK hK1 D hD y
  calc ∫ a, ⟪(aux_gopL ρ (aux_gopAdjW K D) (aux_gopAdjW_meas K hK D hD)
        (aux_gopAdjW_le K hK1 D) (fun p => -D p) hD.neg x : ℝ² → ℂ) a, (y : ℝ² → ℂ) a⟫_ℂ
      = ∫ z, conj (aux_gop ρ (aux_gopAdjW K D) (fun p => -D p) x z) * y z := by
        refine integral_congr_ae ?_
        filter_upwards [h1] with z hz
        rw [hz]; simp [RCLike.inner_apply, mul_comm]
    _ = ∫ z, conj (x z) * aux_gop ρ K D y z :=
        aux_gop_inner ρ K hK hK1 D hD x y (Lp.memLp x) (Lp.memLp y)
    _ = _ := by
        refine integral_congr_ae ?_
        filter_upwards [h2] with z hz
        rw [hz]; simp [RCLike.inner_apply, mul_comm]

/-- Auxiliary for `lem:circle-compact`: composition of two averaging operators is the averaging
operator over the product space. -/
lemma aux_gop_comp {Q : Type*} [MeasurableSpace Q] (τ : Measure Q) [IsProbabilityMeasure τ]
    (K₁ : ℝ² → P → ℂ) (hK₁ : Measurable (Function.uncurry K₁)) (hK₁1 : ∀ z p, ‖K₁ z p‖ ≤ 1)
    (D₁ : P → ℝ²) (hD₁ : Measurable D₁)
    (K₂ : ℝ² → Q → ℂ) (hK₂ : Measurable (Function.uncurry K₂)) (hK₂1 : ∀ z q, ‖K₂ z q‖ ≤ 1)
    (D₂ : Q → ℝ²) (hD₂ : Measurable D₂) (g : ℝ² → ℂ) (hg : MemLp g 2) :
    aux_gop ρ K₁ D₁ (aux_gop τ K₂ D₂ g) =ᵐ[volume]
      aux_gop (ρ.prod τ) (fun z pq => K₁ z pq.1 * K₂ (z + D₁ pq.1) pq.2)
        (fun pq => D₁ pq.1 + D₂ pq.2) g := by
  have hK3 :
      Measurable (Function.uncurry fun z (pq : P × Q) => K₁ z pq.1 * K₂ (z + D₁ pq.1) pq.2) :=
    (hK₁.comp (measurable_fst.prodMk (measurable_fst.comp measurable_snd))).mul
      (hK₂.comp ((measurable_fst.add (hD₁.comp (measurable_fst.comp measurable_snd))).prodMk
        (measurable_snd.comp measurable_snd)))
  have hK31 : ∀ z (pq : P × Q), ‖K₁ z pq.1 * K₂ (z + D₁ pq.1) pq.2‖ ≤ 1 := fun z pq => by
    rw [norm_mul]
    calc ‖K₁ z pq.1‖ * ‖K₂ (z + D₁ pq.1) pq.2‖ ≤ 1 * 1 := by
          gcongr
          · exact hK₁1 _ _
          · exact hK₂1 _ _
      _ = 1 := one_mul 1
  filter_upwards [aux_gop_integrable (ρ.prod τ) _ hK3 hK31
    (fun pq : P × Q => D₁ pq.1 + D₂ pq.2)
    ((hD₁.comp measurable_fst).add (hD₂.comp measurable_snd)) g hg] with z hz
  simp only [aux_gop]
  rw [integral_prod _ hz]
  congr 1; funext p
  rw [← integral_const_mul]
  congr 1; funext q
  rw [add_assoc]; ring

/-- Auxiliary for `lem:circle-compact`: `aux_gopL` composes as `aux_gop_comp`. -/
lemma aux_gopL_comp {Q : Type*} [MeasurableSpace Q] (τ : Measure Q) [IsProbabilityMeasure τ]
    (K₁ : ℝ² → P → ℂ) (hK₁ : Measurable (Function.uncurry K₁)) (hK₁1 : ∀ z p, ‖K₁ z p‖ ≤ 1)
    (D₁ : P → ℝ²) (hD₁ : Measurable D₁)
    (K₂ : ℝ² → Q → ℂ) (hK₂ : Measurable (Function.uncurry K₂)) (hK₂1 : ∀ z q, ‖K₂ z q‖ ≤ 1)
    (D₂ : Q → ℝ²) (hD₂ : Measurable D₂)
    (hK3 : Measurable (Function.uncurry
      fun z (pq : P × Q) => K₁ z pq.1 * K₂ (z + D₁ pq.1) pq.2))
    (hK31 : ∀ z (pq : P × Q), ‖K₁ z pq.1 * K₂ (z + D₁ pq.1) pq.2‖ ≤ 1)
    (hD3 : Measurable fun pq : P × Q => D₁ pq.1 + D₂ pq.2) :
    aux_gopL ρ K₁ hK₁ hK₁1 D₁ hD₁ ∘L aux_gopL τ K₂ hK₂ hK₂1 D₂ hD₂ =
      aux_gopL (ρ.prod τ) _ hK3 hK31 _ hD3 := by
  ext1 f
  apply Lp.ext
  rw [ContinuousLinearMap.comp_apply]
  filter_upwards [aux_gopL_coe ρ K₁ hK₁ hK₁1 D₁ hD₁ (aux_gopL τ K₂ hK₂ hK₂1 D₂ hD₂ f),
    aux_gop_congr ρ K₁ D₁ hD₁ (aux_gopL_coe τ K₂ hK₂ hK₂1 D₂ hD₂ f),
    aux_gop_comp ρ τ K₁ hK₁ hK₁1 D₁ hD₁ K₂ hK₂ hK₂1 D₂ hD₂ f (Lp.memLp f),
    aux_gopL_coe (ρ.prod τ) _ hK3 hK31 _ hD3 f] with z h1 h2 h3 h4
  rw [h1, h2, h3, h4]

/-- Auxiliary for `lem:circle-compact`: splitting the weight `K = K_a + K_b` splits the
operator. -/
lemma aux_gopL_split (K Ka Kb : ℝ² → P → ℂ) (hK : Measurable (Function.uncurry K))
    (hKa : Measurable (Function.uncurry Ka)) (hKb : Measurable (Function.uncurry Kb))
    (hK1 : ∀ z p, ‖K z p‖ ≤ 1) (hKa1 : ∀ z p, ‖Ka z p‖ ≤ 1) (hKb1 : ∀ z p, ‖Kb z p‖ ≤ 1)
    (hsum : ∀ z p, K z p = Ka z p + Kb z p) (D : P → ℝ²) (hD : Measurable D) :
    aux_gopL ρ K hK hK1 D hD = aux_gopL ρ Ka hKa hKa1 D hD + aux_gopL ρ Kb hKb hKb1 D hD := by
  ext1 f
  apply Lp.ext
  rw [add_apply]
  filter_upwards [aux_gopL_coe ρ K hK hK1 D hD f, aux_gopL_coe ρ Ka hKa hKa1 D hD f,
    aux_gopL_coe ρ Kb hKb hKb1 D hD f,
    Lp.coeFn_add (aux_gopL ρ Ka hKa hKa1 D hD f) (aux_gopL ρ Kb hKb hKb1 D hD f),
    aux_gop_integrable ρ Ka hKa hKa1 D hD f (Lp.memLp f),
    aux_gop_integrable ρ Kb hKb hKb1 D hD f (Lp.memLp f)] with z h1 h2 h3 h4 h5 h6
  rw [h1, h4, Pi.add_apply, h2, h3]
  simp only [aux_gop, hsum, add_mul]
  exact integral_add h5 h6

end Gop

/-- Auxiliary: extending a finite orthonormal family by a unit vector orthogonal to it
(used for `aux_hs_tail`, `lem:circle-compact`). -/
theorem aux_hs_orthonormal_cons {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E]
    [InnerProductSpace 𝕜 E] {n : ℕ} (e : Fin n → E) (he : Orthonormal 𝕜 e) (g : E)
    (hg : ‖g‖ = 1) (hge : ∀ i, ⟪e i, g⟫_𝕜 = 0) :
    Orthonormal 𝕜 (Fin.cons g e : Fin (n + 1) → E) := by
  rw [orthonormal_iff_ite] at he ⊢
  intro i j
  refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j
  · simp [inner_self_eq_norm_sq_to_K, hg]
  · simp only [Fin.cons_zero, Fin.cons_succ]
    rw [← inner_conj_symm, hge j]; simp [(Fin.succ_ne_zero j).symm]
  · simp only [Fin.cons_zero, Fin.cons_succ, hge i]; simp [Fin.succ_ne_zero i]
  · simp only [Fin.cons_succ, he i j, Fin.succ_inj]

/-- Auxiliary: the `L²` class of a finite sum is almost everywhere the pointwise sum
(used for `lem:circle-compact`). -/
theorem aux_hs_coeFn_sum {α G : Type*} [MeasurableSpace α] {μ : Measure α} {ι : Type*}
    [NormedAddCommGroup G] (s : Finset ι) (F : ι → Lp G 2 μ) :
    ⇑(∑ i ∈ s, F i) =ᵐ[μ] fun x => ∑ i ∈ s, F i x := by
  classical
  induction s using Finset.induction with
  | empty => simp only [Finset.sum_empty]; exact Lp.coeFn_zero G 2 μ
  | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      filter_upwards [Lp.coeFn_add (F a) (∑ i ∈ s, F i), ih] with x h1 h2
      rw [h1, Pi.add_apply, h2, Finset.sum_insert ha]

/-- Auxiliary: the `L²` class of a finite linear combination is almost everywhere the pointwise
linear combination (used for `lem:circle-compact`). -/
theorem aux_hs_coeFn_sum_smul {α : Type*} [MeasurableSpace α] {μ : Measure α} {n : ℕ}
    (c : Fin n → ℂ) (F : Fin n → Lp ℂ 2 μ) :
    ⇑(∑ i, c i • F i) =ᵐ[μ] fun x => ∑ i, c i * F i x := by
  refine (aux_hs_coeFn_sum Finset.univ fun i => c i • F i).trans ?_
  have h : ∀ i : Fin n, ∀ᵐ x ∂μ, (c i • F i) x = c i * F i x := by
    intro i
    filter_upwards [Lp.coeFn_smul (c i) (F i)] with x hx
    rw [hx]; rfl
  filter_upwards [ae_all_iff.2 h] with x hx
  exact Finset.sum_congr rfl fun i _ => hx i

/-- Auxiliary: the norm of a linear combination of an orthonormal family
(used for `lem:circle-compact`). -/
theorem aux_hs_norm_sum_smul {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E]
    [InnerProductSpace 𝕜 E] {n : ℕ} (e : Fin n → E) (he : Orthonormal 𝕜 e) (c : Fin n → 𝕜) :
    ‖∑ i, c i • e i‖ = Real.sqrt (∑ i, ‖c i‖ ^ 2) := by
  have h1 : (inner 𝕜 (∑ i, c i • e i) (∑ i, c i • e i) : 𝕜) = ∑ i, (starRingEnd 𝕜) (c i) * c i :=
    he.inner_sum c c Finset.univ
  rw [inner_self_eq_norm_sq_to_K] at h1
  have h3 : ‖∑ i, c i • e i‖ ^ 2 = ∑ i, ‖c i‖ ^ 2 := by
    have h4 := congrArg RCLike.re h1
    simpa [RCLike.conj_mul] using h4
  rw [← h3, Real.sqrt_sq (norm_nonneg _)]

/-- Auxiliary: Bessel's inequality in pointwise form.  If a bounded operator `U` from an inner
product space into `L²(μ)` satisfies the uniform bound `|U h(x)| ≤ M ‖h‖` almost everywhere, then
for every finite orthonormal family `(eᵢ)` one has `∑ᵢ |U eᵢ(x)|² ≤ M²` almost everywhere
(the Hilbert–Schmidt step of `lem:circle-compact`). -/
theorem aux_hs_bessel {α E : Type*} [MeasurableSpace α] {μ : Measure α}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] (U : E →L[ℂ] Lp ℂ 2 μ) (M : ℝ) (hM : 0 ≤ M)
    (hU : ∀ h : E, ∀ᵐ x ∂μ, ‖(U h : α → ℂ) x‖ ≤ M * ‖h‖)
    {n : ℕ} (e : Fin n → E) (he : Orthonormal ℂ e) :
    ∀ᵐ x ∂μ, ∑ i, ‖(U (e i) : α → ℂ) x‖ ^ 2 ≤ M ^ 2 := by
  classical
  set v : Fin n → α → ℂ := fun i => ⇑(U (e i)) with hv
  obtain ⟨D, hDc, hDd⟩ := TopologicalSpace.exists_countable_dense (Fin n → ℂ)
  have hstep : ∀ c : Fin n → ℂ, ∀ᵐ x ∂μ,
      ‖∑ i, c i * v i x‖ ≤ M * Real.sqrt (∑ i, ‖c i‖ ^ 2) := by
    intro c
    have hsum : U (∑ i, c i • e i) = ∑ i, c i • U (e i) := by
      rw [map_sum]
      exact Finset.sum_congr rfl fun i _ => map_smul U (c i) (e i)
    have hcoe : ⇑(U (∑ i, c i • e i)) =ᵐ[μ] fun x => ∑ i, c i * v i x := by
      rw [hsum]; exact aux_hs_coeFn_sum_smul c fun i => U (e i)
    filter_upwards [hU (∑ i, c i • e i), hcoe] with x h1 h2
    rw [← h2, aux_hs_norm_sum_smul e he c] at *
    exact h1
  have hae : ∀ᵐ x ∂μ, ∀ c ∈ D, ‖∑ i, c i * v i x‖ ≤ M * Real.sqrt (∑ i, ‖c i‖ ^ 2) :=
    (ae_ball_iff hDc).2 fun c _ => hstep c
  filter_upwards [hae] with x hx
  have hall : ∀ c : Fin n → ℂ, ‖∑ i, c i * v i x‖ ≤ M * Real.sqrt (∑ i, ‖c i‖ ^ 2) := by
    have hclosed : IsClosed {c : Fin n → ℂ |
        ‖∑ i, c i * v i x‖ ≤ M * Real.sqrt (∑ i, ‖c i‖ ^ 2)} := by
      refine isClosed_le ?_ ?_
      · exact (continuous_finsetSum _ fun i _ => (continuous_apply i).mul continuous_const).norm
      · exact continuous_const.mul (Real.continuous_sqrt.comp
          (continuous_finsetSum _ fun i _ => ((continuous_apply i).norm.pow 2)))
    have hsub : D ⊆ {c : Fin n → ℂ |
        ‖∑ i, c i * v i x‖ ≤ M * Real.sqrt (∑ i, ‖c i‖ ^ 2)} := fun c hc => hx c hc
    have := hclosed.closure_subset_iff.2 hsub
    rw [hDd.closure_eq] at this
    exact fun c => this (Set.mem_univ c)
  set t : ℝ := ∑ i, ‖v i x‖ ^ 2 with ht
  have ht0 : 0 ≤ t := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hc := hall fun i => (starRingEnd ℂ) (v i x)
  have e1 : ∑ i, (starRingEnd ℂ) (v i x) * v i x = ((t : ℝ) : ℂ) := by
    rw [ht]
    push_cast
    exact Finset.sum_congr rfl fun i _ => RCLike.conj_mul (v i x)
  have e2 : ∑ i, ‖(starRingEnd ℂ) (v i x)‖ ^ 2 = t := by
    rw [ht]
    exact Finset.sum_congr rfl fun i _ => by rw [RCLike.norm_conj]
  rw [e1, e2, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht0] at hc
  set s : ℝ := Real.sqrt t with hs
  have hs0 : 0 ≤ s := Real.sqrt_nonneg t
  have hst : s ^ 2 = t := Real.sq_sqrt ht0
  rcases hs0.eq_or_lt with h | h
  · rw [← h] at hst
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow] at hst
    rw [← hst]
    positivity
  · have hsM : s ≤ M := by nlinarith
    nlinarith

/-- Auxiliary for `lem:circle-compact`: if `∑ ‖T eᵢ‖² ≤ C < ∞` for every finite orthonormal
family, then for every `ε > 0` there is a finite orthonormal family `(eᵢ)` with
`‖T f‖ ≤ ε ‖f‖` whenever `f ⊥ eᵢ` (the greedy argument for Hilbert–Schmidt operators). -/
theorem aux_hs_tail {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [NormedAddCommGroup F] [NormedSpace ℂ F] (T : E →L[ℂ] F) (C : ℝ≥0∞) (hC : C ≠ ⊤)
    (hT : ∀ (n : ℕ) (e : Fin n → E), Orthonormal ℂ e → ∑ i, ‖T (e i)‖ₑ ^ 2 ≤ C)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ (n : ℕ) (e : Fin n → E), Orthonormal ℂ e ∧
      ∀ f : E, (∀ i, ⟪e i, f⟫_ℂ = 0) → ‖T f‖ ≤ ε * ‖f‖ := by
  classical
  set P : ℕ → Prop := fun m => ∃ e : Fin m → E, Orthonormal ℂ e ∧ ∀ i, ε ≤ ‖T (e i)‖
  set B : ℕ := ⌊C.toReal / ε ^ 2⌋₊
  have hPB : ∀ m, P m → m ≤ B := by
    rintro m ⟨e, he, heε⟩
    apply Nat.le_floor
    rw [le_div_iff₀ (by positivity)]
    have h1 : ∑ i, ‖T (e i)‖ₑ ^ 2 ≤ C := hT m e he
    have h2 : (m : ℝ≥0∞) * ENNReal.ofReal (ε ^ 2) ≤ ∑ i, ‖T (e i)‖ₑ ^ 2 := by
      calc (m : ℝ≥0∞) * ENNReal.ofReal (ε ^ 2) = ∑ _i : Fin m, ENNReal.ofReal (ε ^ 2) := by simp
        _ ≤ _ := Finset.sum_le_sum fun i _ => by
            rw [← ofReal_norm, ← ENNReal.ofReal_pow (norm_nonneg _)]
            exact ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ hε.le (heε i) 2)
    have := ENNReal.toReal_mono hC (h2.trans h1)
    rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity), ENNReal.toReal_natCast]
      at this
  have hP0 : P 0 := ⟨Fin.elim0, by simp [Orthonormal, Pairwise], fun i => i.elim0⟩
  set N := Nat.findGreatest P B
  obtain ⟨e, he, heε⟩ : P N := Nat.findGreatest_spec (Nat.zero_le _) hP0
  refine ⟨N, e, he, fun f hf => ?_⟩
  by_contra hlt
  push Not at hlt
  have hf0 : f ≠ 0 := by rintro rfl; simp at hlt
  have hfn : 0 < ‖f‖ := norm_pos_iff.2 hf0
  set g : E := ((‖f‖⁻¹ : ℝ) : ℂ) • f
  have hg : ‖g‖ = 1 := by
    simp only [g, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_inv, abs_norm]; field_simp
  have hge : ∀ i, ⟪e i, g⟫_ℂ = 0 := fun i => by simp [g, hf i]
  have hTg : ε ≤ ‖T g‖ := by
    simp only [g, map_smul, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_inv, abs_norm]
    rw [inv_mul_eq_div, le_div_iff₀ hfn]; linarith
  have hPN : P (N + 1) := by
    refine ⟨Fin.cons g e, aux_hs_orthonormal_cons e he g hg hge, fun i => ?_⟩
    refine Fin.cases ?_ (fun i => ?_) i
    · simpa using hTg
    · simpa using heε i
  have := Nat.le_findGreatest (hPB _ hPN) hPN
  omega

/-- Auxiliary for `lem:circle-compact`: an operator with uniformly bounded Hilbert–Schmidt sums is
compact (operator-norm limit of finite-rank operators). -/
theorem aux_hs_compact {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F] (T : E →L[ℂ] F) (C : ℝ≥0∞)
    (hC : C ≠ ⊤)
    (hT : ∀ (n : ℕ) (e : Fin n → E), Orthonormal ℂ e → ∑ i, ‖T (e i)‖ₑ ^ 2 ≤ C) :
    IsCompactOperator T := by
  have hcl := isClosed_setOfPred_isCompactOperator (𝕜₁ := ℂ) (σ₁₂ := RingHom.id ℂ)
    (M₁ := E) (M₂ := F)
  refine hcl.closure_subset (Metric.mem_closure_iff.2 fun ε hε => ?_)
  obtain ⟨n, e, he, hT'⟩ := aux_hs_tail T C hC hT (ε / 2) (by positivity)
  set V := Submodule.span ℂ (Set.range e)
  have : FiniteDimensional ℂ V := FiniteDimensional.span_of_finite ℂ (Set.finite_range e)
  refine ⟨T ∘L V.starProjection, ?_, ?_⟩
  · have h := (isCompactOperator_of_locallyCompactSpace_dom
      (V.orthogonalProjectionOnto)).clm_comp (T ∘L V.subtypeL)
    exact h
  · rw [dist_eq_norm]
    refine lt_of_le_of_lt (ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun f => ?_)
      (by linarith : ε / 2 < ε)
    have hperp : f - V.starProjection f ∈ Vᗮ := Submodule.sub_starProjection_mem_orthogonal f
    have h1 : ∀ i, ⟪e i, f - V.starProjection f⟫_ℂ = 0 := fun i =>
      Submodule.inner_right_of_mem_orthogonal (Submodule.subset_span (Set.mem_range_self i)) hperp
    have h2 : ‖f - V.starProjection f‖ ≤ ‖f‖ := by
      have e : f - V.starProjection f = Vᗮ.starProjection f := by
        rw [Submodule.starProjection_orthogonal]; rfl
      rw [e]; exact Submodule.norm_starProjection_apply_le _ _
    calc ‖(T - T ∘L V.starProjection) f‖ = ‖T (f - V.starProjection f)‖ := by simp
      _ ≤ ε / 2 * ‖f - V.starProjection f‖ := hT' _ h1
      _ ≤ ε / 2 * ‖f‖ := by gcongr

/-- Auxiliary for `lem:circle-compact`: an operator on `L²(ℝ²)` with a uniform pointwise bound
`|U h(x)| ≤ M ‖h‖` whose outputs vanish outside a bounded set is compact (Hilbert–Schmidt). -/
theorem aux_hs_compact_of_pointwise
    (U : Lp ℂ 2 (volume : Measure ℝ²) →L[ℂ] Lp ℂ 2 (volume : Measure ℝ²))
    (M : ℝ) (hM : 0 ≤ M) (hU : ∀ h, ∀ᵐ x ∂(volume : Measure ℝ²), ‖(U h : ℝ² → ℂ) x‖ ≤ M * ‖h‖)
    (X : Set ℝ²) (hX : Bornology.IsBounded X)
    (hsupp : ∀ h, ∀ᵐ x ∂(volume : Measure ℝ²), x ∉ X → (U h : ℝ² → ℂ) x = 0) :
    IsCompactOperator U := by
  obtain ⟨R, hR⟩ := hX.subset_closedBall (0 : ℝ²)
  have hBm : MeasurableSet (Metric.closedBall (0 : ℝ²) R) := measurableSet_closedBall
  have hBt : volume (Metric.closedBall (0 : ℝ²) R) ≠ ⊤ :=
    (isCompact_closedBall (0 : ℝ²) R).measure_lt_top.ne
  refine aux_hs_compact U (ENNReal.ofReal (M ^ 2) * volume (Metric.closedBall (0 : ℝ²) R))
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hBt) fun n e he => ?_
  have hbess := aux_hs_bessel U M hM hU e he
  have hall : ∀ᵐ x ∂(volume : Measure ℝ²), ∀ i : Fin n, x ∉ X → (U (e i) : ℝ² → ℂ) x = 0 :=
    ae_all_iff.2 fun i => hsupp (e i)
  have hnsq : ∀ f : Lp ℂ 2 (volume : Measure ℝ²), ‖f‖ₑ ^ 2 = ∫⁻ x, ‖f x‖ₑ ^ 2 := by
    intro f
    rw [Lp.enorm_def, aux_s2a_eLpNorm_two_sq]
  have hsum : ∑ i, ‖U (e i)‖ₑ ^ 2 = ∫⁻ x, ∑ i, ‖(U (e i) : ℝ² → ℂ) x‖ₑ ^ 2 := by
    rw [lintegral_finsetSum' _ fun i _ =>
      ((Lp.aestronglyMeasurable (U (e i))).enorm.pow_const 2)]
    exact Finset.sum_congr rfl fun i _ => hnsq (U (e i))
  rw [hsum]
  calc ∫⁻ x, ∑ i, ‖(U (e i) : ℝ² → ℂ) x‖ₑ ^ 2
      ≤ ∫⁻ x, (Metric.closedBall (0 : ℝ²) R).indicator
          (fun _ => ENNReal.ofReal (M ^ 2)) x := by
        refine lintegral_mono_ae ?_
        filter_upwards [hbess, hall] with x hb hz
        by_cases hxB : x ∈ Metric.closedBall (0 : ℝ²) R
        · rw [Set.indicator_of_mem hxB]
          have e1 : ∑ i, ‖(U (e i) : ℝ² → ℂ) x‖ₑ ^ 2 =
              ENNReal.ofReal (∑ i, ‖(U (e i) : ℝ² → ℂ) x‖ ^ 2) := by
            rw [ENNReal.ofReal_sum_of_nonneg fun i _ => sq_nonneg _]
            exact Finset.sum_congr rfl fun i _ => by
              rw [← ofReal_norm, ← ENNReal.ofReal_pow (norm_nonneg _)]
          rw [e1]
          exact ENNReal.ofReal_le_ofReal hb
        · have hxQ : x ∉ X := fun hxQ => hxB (hR hxQ)
          have : ∀ i : Fin n, ‖(U (e i) : ℝ² → ℂ) x‖ₑ ^ 2 = 0 := by
            intro i; rw [hz i hxQ]; simp
          simp [this]
    _ = ENNReal.ofReal (M ^ 2) * volume (Metric.closedBall (0 : ℝ²) R) :=
        lintegral_indicator_const hBm _

/-- Auxiliary for `lem:circle-compact`: integrals over `σ ⊗ σ` of functions of
`N u_θ - N u_φ` are integrals against the circle-difference density (`lem:circle-difference`). -/
lemma aux_cc_push (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖)
    (G : ℝ² → ℝ≥0∞) (hG : Measurable G) :
    ∫⁻ pq, G (N (u pq.1) + -N (u pq.2)) ∂(σ.prod σ) =
      ∫⁻ v, ENNReal.ofReal (aux_chordDensity c v) * G v := by
  have hD : Measurable fun p : Ang × Ang => N (u p.1 - u p.2) :=
    N.continuous.measurable.comp ((aux_lw_u_meas.comp measurable_fst).sub
      (aux_lw_u_meas.comp measurable_snd))
  rw [show (∫⁻ pq, G (N (u pq.1) + -N (u pq.2)) ∂(σ.prod σ)) =
      ∫⁻ pq, G (N (u pq.1 - u pq.2)) ∂(σ.prod σ) by
        refine lintegral_congr fun pq => ?_; rw [map_sub, sub_eq_add_neg],
    ← lintegral_map hG hD, aux_cd_diff_eq N c hc hNc,
    lintegral_withDensity_eq_lintegral_mul volume
      (f := fun y => ENNReal.ofReal (aux_chordDensity c y))
      (ENNReal.measurable_ofReal.comp (aux_cd_chordDensity_meas c)) hG]
  rfl

/-- Auxiliary for `lem:circle-compact`: pointwise bound for an averaging operator over `σ ⊗ σ`
along `N u_θ - N u_φ` whose weight is dominated by `χ(N u_θ - N u_φ)`. -/
lemma aux_cc_gop_push (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖)
    (K : ℝ² → Ang × Ang → ℂ) (χ : ℝ² → ℝ≥0∞) (hχ : Measurable χ)
    (hKχ : ∀ z pq, ‖K z pq‖ₑ ≤ χ (N (u pq.1) + -N (u pq.2)))
    (g : ℝ² → ℂ) (hg : Measurable g) (z : ℝ²) :
    ‖aux_gop (σ.prod σ) K (fun pq => N (u pq.1) + -N (u pq.2)) g z‖ₑ ≤
      ∫⁻ v, ENNReal.ofReal (aux_chordDensity c v) * (χ v * ‖g (z + v)‖ₑ) := by
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  rw [← aux_cc_push N c hc hNc (fun v => χ v * ‖g (z + v)‖ₑ)
    (hχ.mul (hg.comp (measurable_const_add z)).enorm)]
  refine lintegral_mono fun pq => ?_
  rw [enorm_mul]
  gcongr
  exact hKχ z pq

/-- Auxiliary for `lem:circle-compact`: weighted Cauchy–Schwarz `(∫ a b)² ≤ ∫ a ∫ a b²`. -/
lemma aux_cc_cs_weight (a b : ℝ² → ℝ≥0∞) (ha : Measurable a) (hb : Measurable b) :
    (∫⁻ v, a v * b v) ^ 2 ≤ (∫⁻ v, a v) * ∫⁻ v, a v * b v ^ 2 := by
  have e1 : ∀ t : ℝ≥0∞, (t ^ (1 / 2 : ℝ)) ^ 2 = t := fun t => by
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; norm_num
  have h := aux_cc_cs volume (fun v => a v ^ (1 / 2 : ℝ)) (fun v => a v ^ (1 / 2 : ℝ) * b v)
    (ha.pow_const _).aemeasurable ((ha.pow_const _).mul hb).aemeasurable
  have e2 : ∀ v, a v ^ (1 / 2 : ℝ) * (a v ^ (1 / 2 : ℝ) * b v) = a v * b v := fun v => by
    rw [← mul_assoc, aux_cc_sqrt_mul_self]
  have e3 : ∀ v, (a v ^ (1 / 2 : ℝ) * b v) ^ 2 = a v * b v ^ 2 := fun v => by
    rw [mul_pow, e1]
  simp only [e2, e3, e1] at h
  exact h

/-- Auxiliary for `lem:circle-compact`: the part of `T T*` where `w_N > H` has operator norm at
most `∫_{w_N > H} w_N` (Young's inequality). -/
lemma aux_cc_rem (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖) (H : ℝ)
    (K : ℝ² → Ang × Ang → ℂ) (hK1 : ∀ z pq, ‖K z pq‖ ≤ 1) (f : ℝ² → ℂ) (hf : MemLp f 2) :
    eLpNorm (aux_gop (σ.prod σ)
      (fun z pq => if H < aux_chordDensity c (N (u pq.1) + -N (u pq.2)) then K z pq else 0)
      (fun pq => N (u pq.1) + -N (u pq.2)) f) 2 volume ≤
      (∫⁻ v in {v | H < aux_chordDensity c v}, ENNReal.ofReal (aux_chordDensity c v)) *
        eLpNorm f 2 volume := by
  set w := aux_chordDensity c
  have hw := aux_cd_chordDensity_meas c
  set S : Set ℝ² := {v | H < w v}
  have hS : MeasurableSet S := measurableSet_lt measurable_const hw
  set T := ∫⁻ v in S, ENNReal.ofReal (w v)
  have hNu : Measurable fun θ => N (u θ) := N.continuous.measurable.comp aux_lw_u_meas
  have hD3 : Measurable fun pq : Ang × Ang => N (u pq.1) + -N (u pq.2) :=
    (hNu.comp measurable_fst).add (hNu.comp measurable_snd).neg
  set g := hf.1.mk f
  have hg : Measurable g := hf.1.stronglyMeasurable_mk.measurable
  set F : ℝ² → ℝ≥0∞ := fun y => ‖g y‖ₑ
  have hF : Measurable F := hg.enorm
  set a : ℝ² → ℝ≥0∞ := S.indicator fun v => ENNReal.ofReal (w v)
  have ha : Measurable a := (ENNReal.measurable_ofReal.comp hw).indicator hS
  have hpt : ∀ z, ‖aux_gop (σ.prod σ)
      (fun z pq => if H < w (N (u pq.1) + -N (u pq.2)) then K z pq else 0)
      (fun pq => N (u pq.1) + -N (u pq.2)) g z‖ₑ ≤ ∫⁻ v, a v * F (z + v) := by
    intro z
    refine (aux_cc_gop_push N c hc hNc _ (S.indicator 1) (measurable_one.indicator hS)
      (fun z pq => ?_) g hg z).trans (le_of_eq (lintegral_congr fun v => ?_))
    · by_cases h : H < w (N (u pq.1) + -N (u pq.2))
      · rw [if_pos h, Set.indicator_of_mem (show _ ∈ S from h), Pi.one_apply,
          ← ofReal_norm, ← ENNReal.ofReal_one]
        exact ENNReal.ofReal_le_ofReal (hK1 z pq)
      · rw [if_neg h]; simp
    · by_cases h : v ∈ S
      · simp [a, h, F, w]
      · simp [a, h]
  have hT : ∫⁻ v, a v = T := lintegral_indicator hS _
  have hint : ∫⁻ z, (∫⁻ v, a v * F (z + v)) ^ 2 ≤ T * T * ∫⁻ y, F y ^ 2 := by
    calc ∫⁻ z, (∫⁻ v, a v * F (z + v)) ^ 2 ≤ ∫⁻ z, T * ∫⁻ v, a v * F (z + v) ^ 2 := by
          refine lintegral_mono fun z => ?_
          have := aux_cc_cs_weight a (fun v => F (z + v)) ha (hF.comp (measurable_const_add z))
          rwa [hT] at this
      _ = T * ∫⁻ z, ∫⁻ v, a v * F (z + v) ^ 2 := by
          refine lintegral_const_mul _ ?_
          exact ((ha.comp measurable_snd).mul ((hF.comp (measurable_fst.add
            measurable_snd)).pow_const 2)).lintegral_prod_right'
      _ = T * ∫⁻ v, ∫⁻ z, a v * F (z + v) ^ 2 := by
          rw [lintegral_lintegral_swap]
          exact ((ha.comp measurable_snd).mul ((hF.comp (measurable_fst.add
            measurable_snd)).pow_const 2)).aemeasurable
      _ = T * ∫⁻ v, a v * ∫⁻ y, F y ^ 2 := by
          congr 1
          refine lintegral_congr fun v => ?_
          have hm : Measurable fun z : ℝ² => F (z + v) ^ 2 :=
            (hF.comp (measurable_add_const v)).pow_const 2
          rw [lintegral_const_mul _ hm, lintegral_add_right_eq_self (fun y => F y ^ 2) v]
      _ = T * T * ∫⁻ y, F y ^ 2 := by
          rw [lintegral_mul_const _ ha, hT, mul_assoc]
  have hfin : eLpNorm (aux_gop (σ.prod σ)
      (fun z pq => if H < w (N (u pq.1) + -N (u pq.2)) then K z pq else 0)
      (fun pq => N (u pq.1) + -N (u pq.2)) g) 2 volume ≤ T * eLpNorm g 2 volume := by
    rw [aux_lw_eLpNorm_two, aux_lw_eLpNorm_two]
    simp only [ENNReal.rpow_two]
    calc (∫⁻ z, ‖aux_gop (σ.prod σ)
          (fun z pq => if H < w (N (u pq.1) + -N (u pq.2)) then K z pq else 0)
          (fun pq => N (u pq.1) + -N (u pq.2)) g z‖ₑ ^ 2) ^ (1 / 2 : ℝ)
        ≤ (T * T * ∫⁻ y, F y ^ 2) ^ (1 / 2 : ℝ) := by
          gcongr ?_ ^ _
          exact (lintegral_mono fun z => by gcongr; exact hpt z).trans hint
      _ = T * (∫⁻ y, ‖g y‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← sq,
            show (T ^ 2) ^ (1 / 2 : ℝ) = T by
              rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; norm_num]
  rw [eLpNorm_congr_ae (aux_gop_congr _ _ _ hD3 hf.1.ae_eq_mk)]
  exact hfin.trans_eq (congrArg (T * ·) (eLpNorm_congr_ae hf.1.ae_eq_mk).symm)

/-- Auxiliary for `lem:circle-compact`: the part of `T T*` where `w_N ≤ H` satisfies the uniform
pointwise bound `|A g(z)| ≤ H^{1/2} ‖g‖₂`. -/
lemma aux_cc_main (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖) (H : ℝ)
    (K : ℝ² → Ang × Ang → ℂ) (hK1 : ∀ z pq, ‖K z pq‖ ≤ 1) (g : ℝ² → ℂ) (hg : Measurable g)
    (z : ℝ²) :
    ‖aux_gop (σ.prod σ)
      (fun z pq => if H < aux_chordDensity c (N (u pq.1) + -N (u pq.2)) then 0 else K z pq)
      (fun pq => N (u pq.1) + -N (u pq.2)) g z‖ₑ ≤
      ENNReal.ofReal H ^ (1 / 2 : ℝ) * (∫⁻ y, ‖g y‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  set w := aux_chordDensity c
  have hw := aux_cd_chordDensity_meas c
  set S : Set ℝ² := {v | H < w v}
  have hS : MeasurableSet S := measurableSet_lt measurable_const hw
  set b : ℝ² → ℝ≥0∞ := Sᶜ.indicator fun v => ENNReal.ofReal (w v)
  have hb : Measurable b := (ENNReal.measurable_ofReal.comp hw).indicator hS.compl
  have h1 : ‖aux_gop (σ.prod σ)
      (fun z pq => if H < w (N (u pq.1) + -N (u pq.2)) then 0 else K z pq)
      (fun pq => N (u pq.1) + -N (u pq.2)) g z‖ₑ ≤ ∫⁻ v, b v * ‖g (z + v)‖ₑ := by
    refine (aux_cc_gop_push N c hc hNc _ (Sᶜ.indicator 1) (measurable_one.indicator hS.compl)
      (fun z pq => ?_) g hg z).trans (le_of_eq (lintegral_congr fun v => ?_))
    · by_cases h : H < w (N (u pq.1) + -N (u pq.2))
      · rw [if_pos h]; simp
      · rw [if_neg h, Set.indicator_of_mem (show _ ∈ Sᶜ from h), Pi.one_apply,
          ← ofReal_norm, ← ENNReal.ofReal_one]
        exact ENNReal.ofReal_le_ofReal (hK1 z pq)
    · by_cases h : v ∈ S
      · simp [b, h]
      · simp [b, h, w]
  have hb2 : ∫⁻ v, b v ^ 2 ≤ ENNReal.ofReal H := by
    calc ∫⁻ v, b v ^ 2 ≤ ∫⁻ v, ENNReal.ofReal H * ENNReal.ofReal (w v) := by
          refine lintegral_mono fun v => ?_
          by_cases h : v ∈ S
          · simp [b, h]
          · change (Sᶜ.indicator (fun v => ENNReal.ofReal (w v)) v) ^ 2 ≤ _
            rw [Set.indicator_of_mem (show v ∈ Sᶜ from h), sq]
            gcongr
            exact not_lt.1 h
      _ = ENNReal.ofReal H := by
          have hm : Measurable fun v => ENNReal.ofReal (w v) := ENNReal.measurable_ofReal.comp hw
          rw [lintegral_const_mul _ hm, aux_cd_chordDensity_mass c hc, mul_one]
  refine h1.trans ((aux_cc_holder2 volume b (fun v => ‖g (z + v)‖ₑ) hb.aemeasurable
    (hg.comp (measurable_const_add z)).enorm.aemeasurable).trans ?_)
  rw [lintegral_add_left_eq_self (fun y => ‖g y‖ₑ ^ 2) z]
  gcongr

/-- Auxiliary for `lem:circle-compact`: the tails `∫_{w_N > n+1} w_N` tend to zero. -/
lemma aux_cc_tail_tendsto (c : ℝ) (hc : 0 < c) :
    Tendsto (fun n : ℕ => ∫⁻ v in {v | (n : ℝ) + 1 < aux_chordDensity c v},
      ENNReal.ofReal (aux_chordDensity c v)) atTop (𝓝 0) := by
  set w := aux_chordDensity c
  have hw := aux_cd_chordDensity_meas c
  set μ' : Measure ℝ² := volume.withDensity fun v => ENNReal.ofReal (w v)
  set S : ℕ → Set ℝ² := fun n => {v | (n : ℝ) + 1 < w v}
  have hSm : ∀ n, MeasurableSet (S n) := fun n => measurableSet_lt measurable_const hw
  have hanti : Antitone S := fun m n hmn v hv => by
    simp only [S, mem_ofPred_eq] at hv ⊢
    have : (m : ℝ) ≤ n := by exact_mod_cast hmn
    linarith
  have hfin : μ' (S 0) ≠ ⊤ := by
    refine ne_top_of_le_ne_top (b := μ' univ) ?_ (measure_mono (subset_univ _))
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
      aux_cd_chordDensity_mass c hc]
    exact ENNReal.one_ne_top
  have hlim := tendsto_measure_iInter_atTop (μ := μ') (fun n => (hSm n).nullMeasurableSet) hanti
    ⟨0, hfin⟩
  have hempty : (⋂ n, S n) = ∅ := by
    ext v
    simp only [mem_iInter, mem_ofPred_eq, S, mem_empty_iff_false, iff_false, not_forall, not_lt]
    obtain ⟨n, hn⟩ := exists_nat_ge (w v)
    exact ⟨n, by linarith⟩
  rw [hempty, measure_empty] at hlim
  refine hlim.congr fun n => ?_
  exact withDensity_apply _ (hSm n)

/-- Auxiliary for `lem:circle-compact`: the displacement `N u_θ - N u_φ` of `T T*`. -/
@[nolint defsWithUnderscore]
def aux_cc_D3 (N : ℝ² →L[ℝ] ℝ²) (pq : Ang × Ang) : ℝ² := N (u pq.1) + -N (u pq.2)

lemma aux_cc_D3_meas (N : ℝ² →L[ℝ] ℝ²) : Measurable (aux_cc_D3 N) :=
  ((N.continuous.measurable.comp aux_lw_u_meas).comp measurable_fst).add
    ((N.continuous.measurable.comp aux_lw_u_meas).comp measurable_snd).neg

/-- Auxiliary for `lem:circle-compact`: truncation of a weight on `𝕋²` according to whether
`w_N(N u_θ - N u_φ) > H` (`b = true`) or not (`b = false`). -/
@[nolint defsWithUnderscore]
def aux_cc_trunc (N : ℝ² →L[ℝ] ℝ²) (c H : ℝ) (b : Bool) (K : ℝ² → Ang × Ang → ℂ)
    (z : ℝ²) (pq : Ang × Ang) : ℂ :=
  if H < aux_chordDensity c (aux_cc_D3 N pq) then (if b then K z pq else 0)
    else (if b then 0 else K z pq)

lemma aux_cc_trunc_meas (N : ℝ² →L[ℝ] ℝ²) (c H : ℝ) (b : Bool) (K : ℝ² → Ang × Ang → ℂ)
    (hK : Measurable (Function.uncurry K)) :
    Measurable (Function.uncurry (aux_cc_trunc N c H b K)) := by
  have hS : MeasurableSet {q : ℝ² × (Ang × Ang) | H < aux_chordDensity c (aux_cc_D3 N q.2)} :=
    measurableSet_lt measurable_const
      ((aux_cd_chordDensity_meas c).comp ((aux_cc_D3_meas N).comp measurable_snd))
  cases b
  · exact Measurable.ite hS measurable_const hK
  · exact Measurable.ite hS hK measurable_const

lemma aux_cc_trunc_le (N : ℝ² →L[ℝ] ℝ²) (c H : ℝ) (b : Bool) (K : ℝ² → Ang × Ang → ℂ)
    (hK1 : ∀ z pq, ‖K z pq‖ ≤ 1) : ∀ z pq, ‖aux_cc_trunc N c H b K z pq‖ ≤ 1 := by
  intro z pq
  unfold aux_cc_trunc
  cases b <;> split_ifs <;> simp [hK1 z pq]

/-- Auxiliary for `lem:circle-compact`: an averaging operator over `𝕋²` along `N u_θ - N u_φ`
with weight vanishing for `z` outside a bounded set is compact (the `T T*` step of the proof:
bounded-kernel part plus a remainder of small norm). -/
lemma aux_cc_TT_compact (N : ℝ² →L[ℝ] ℝ²) (c : ℝ) (hc : 0 < c) (hNc : ∀ x, ‖N x‖ = c * ‖x‖)
    (K : ℝ² → Ang × Ang → ℂ) (hK : Measurable (Function.uncurry K)) (hK1 : ∀ z pq, ‖K z pq‖ ≤ 1)
    (X : Set ℝ²) (hX : Bornology.IsBounded X) (hKX : ∀ z pq, z ∉ X → K z pq = 0) :
    IsCompactOperator (aux_gopL (σ.prod σ) K hK hK1 (aux_cc_D3 N) (aux_cc_D3_meas N)) := by
  have hD3 := aux_cc_D3_meas N
  have hsplit : ∀ n : ℕ, aux_gopL (σ.prod σ) K hK hK1 (aux_cc_D3 N) hD3 =
      aux_gopL (σ.prod σ) _ (aux_cc_trunc_meas N c ((n : ℝ) + 1) true K hK)
        (aux_cc_trunc_le N c ((n : ℝ) + 1) true K hK1) (aux_cc_D3 N) hD3 +
      aux_gopL (σ.prod σ) _ (aux_cc_trunc_meas N c ((n : ℝ) + 1) false K hK)
        (aux_cc_trunc_le N c ((n : ℝ) + 1) false K hK1) (aux_cc_D3 N) hD3 := fun n =>
    aux_gopL_split (σ.prod σ) K _ _ hK _ _ hK1 _ _
      (fun z pq => by
        by_cases h : ((n : ℝ) + 1) < aux_chordDensity c (aux_cc_D3 N pq) <;>
          simp [aux_cc_trunc, h]) _ hD3
  have hA : ∀ n : ℕ, IsCompactOperator (aux_gopL (σ.prod σ) _
      (aux_cc_trunc_meas N c ((n : ℝ) + 1) false K hK)
      (aux_cc_trunc_le N c ((n : ℝ) + 1) false K hK1) (aux_cc_D3 N) hD3) := by
    intro n
    refine aux_hs_compact_of_pointwise _ (Real.sqrt ((n : ℝ) + 1)) (Real.sqrt_nonneg _)
      (fun h => ?_) X hX (fun h => ?_)
    · have hm := (Lp.aestronglyMeasurable h).stronglyMeasurable_mk.measurable
      filter_upwards [aux_gopL_coe (σ.prod σ) _ (aux_cc_trunc_meas N c ((n : ℝ) + 1) false K hK)
          (aux_cc_trunc_le N c ((n : ℝ) + 1) false K hK1) _ hD3 h,
        aux_gop_congr (σ.prod σ) (aux_cc_trunc N c ((n : ℝ) + 1) false K) _ hD3
          (Lp.aestronglyMeasurable h).ae_eq_mk] with x h1 h2
      have hb := aux_cc_main N c hc hNc ((n : ℝ) + 1) K hK1 _ hm x
      have hE : ‖(aux_gopL (σ.prod σ) _ (aux_cc_trunc_meas N c ((n : ℝ) + 1) false K hK)
          (aux_cc_trunc_le N c ((n : ℝ) + 1) false K hK1) (aux_cc_D3 N) hD3 h : ℝ² → ℂ) x‖ₑ ≤
          ENNReal.ofReal (Real.sqrt ((n : ℝ) + 1)) * ‖h‖ₑ := by
        rw [h1, h2]
        refine hb.trans (le_of_eq ?_)
        rw [Real.sqrt_eq_rpow, ← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num),
          Lp.enorm_def, eLpNorm_congr_ae (Lp.aestronglyMeasurable h).ae_eq_mk,
          aux_lw_eLpNorm_two]
        simp only [ENNReal.rpow_two]
      rw [← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_mul (Real.sqrt_nonneg _)] at hE
      exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 hE
    · filter_upwards [aux_gopL_coe (σ.prod σ) _ (aux_cc_trunc_meas N c ((n : ℝ) + 1) false K hK)
          (aux_cc_trunc_le N c ((n : ℝ) + 1) false K hK1) _ hD3 h] with x h1 hxX
      rw [h1]
      simp [aux_gop, aux_cc_trunc, hKX x _ hxX]
  have hR : ∀ n : ℕ, ‖aux_gopL (σ.prod σ) _ (aux_cc_trunc_meas N c ((n : ℝ) + 1) true K hK)
      (aux_cc_trunc_le N c ((n : ℝ) + 1) true K hK1) (aux_cc_D3 N) hD3‖ ≤
      (∫⁻ v in {v | (n : ℝ) + 1 < aux_chordDensity c v},
        ENNReal.ofReal (aux_chordDensity c v)).toReal := by
    intro n
    have htail : (∫⁻ v in {v | (n : ℝ) + 1 < aux_chordDensity c v},
        ENNReal.ofReal (aux_chordDensity c v)) ≠ ⊤ := by
      refine ne_top_of_le_ne_top (b := ∫⁻ v, ENNReal.ofReal (aux_chordDensity c v)) ?_
        (setLIntegral_le_lintegral _ _)
      rw [aux_cd_chordDensity_mass c hc]; exact ENNReal.one_ne_top
    refine ContinuousLinearMap.opNorm_le_bound _ ENNReal.toReal_nonneg fun f => ?_
    have hb := aux_cc_rem N c hc hNc ((n : ℝ) + 1) K hK1 f (Lp.memLp f)
    rw [Lp.norm_def, Lp.norm_def, eLpNorm_congr_ae
      (aux_gopL_coe (σ.prod σ) _ (aux_cc_trunc_meas N c ((n : ℝ) + 1) true K hK)
        (aux_cc_trunc_le N c ((n : ℝ) + 1) true K hK1) _ hD3 f), ← ENNReal.toReal_mul]
    refine ENNReal.toReal_mono (ENNReal.mul_ne_top htail (Lp.eLpNorm_ne_top f)) ?_
    convert hb using 3
    rotate_left
    · rfl
    funext z pq
    by_cases h : ((n : ℝ) + 1) < aux_chordDensity c (aux_cc_D3 N pq) <;>
      simp [aux_cc_trunc, aux_cc_D3]
  have htend : Tendsto (fun n : ℕ => aux_gopL (σ.prod σ) _
      (aux_cc_trunc_meas N c ((n : ℝ) + 1) false K hK)
      (aux_cc_trunc_le N c ((n : ℝ) + 1) false K hK1) (aux_cc_D3 N) hD3) atTop
      (𝓝 (aux_gopL (σ.prod σ) K hK hK1 (aux_cc_D3 N) hD3)) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    have h0 : Tendsto (fun n : ℕ =>
        (∫⁻ v in {v | (n : ℝ) + 1 < aux_chordDensity c v},
          ENNReal.ofReal (aux_chordDensity c v)).toReal) atTop (𝓝 0) := by
      have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp (aux_cc_tail_tendsto c hc)
      rw [ENNReal.toReal_zero] at this
      exact this
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => ?_) h0
    rw [hsplit n, sub_add_cancel_right, norm_neg]
    exact hR n
  exact ext_compact_facts_limit _ _ htend hA

/-- **Lemma `lem:circle-compact`** (compactness). If $W(z,\theta)=0$ for $z$ outside a bounded
set, then $T$ is compact on $L^2(\R^2)$. -/
theorem lem_circle_compact (N : ℝ² →L[ℝ] ℝ²) (hN : ∃ c > 0, ∀ x, ‖N x‖ = c * ‖x‖)
    (W : ℝ² → Ang → ℂ) (hW : Measurable (Function.uncurry W)) (hW1 : ∀ z θ, ‖W z θ‖ ≤ 1)
    (X : Set ℝ²) (hX : Bornology.IsBounded X) (hWX : ∀ z θ, z ∉ X → W z θ = 0) :
    ∃ T : Lp ℂ 2 (volume : Measure ℝ²) →L[ℂ] Lp ℂ 2 (volume : Measure ℝ²),
      (∀ f : Lp ℂ 2 (volume : Measure ℝ²), (T f : ℝ² → ℂ) =ᵐ[volume] circleOp N W f) ∧
      IsCompactOperator T := by
  obtain ⟨c, hc, hNc⟩ := hN
  have hD : Measurable fun θ : Ang => N (u θ) := N.continuous.measurable.comp aux_lw_u_meas
  refine ⟨aux_gopL σ W hW hW1 _ hD, fun f => aux_gopL_coe σ W hW hW1 _ hD f, ?_⟩
  refine ext_ttstar _ ?_
  have hK₂ := aux_gopAdjW_meas W hW _ hD
  have hK₂1 := aux_gopAdjW_le W hW1 (fun θ : Ang => N (u θ))
  have hK3 : Measurable (Function.uncurry fun z (pq : Ang × Ang) =>
      W z pq.1 * aux_gopAdjW W (fun θ : Ang => N (u θ)) (z + N (u pq.1)) pq.2) :=
    (hW.comp (measurable_fst.prodMk (measurable_fst.comp measurable_snd))).mul
      (hK₂.comp ((measurable_fst.add (hD.comp (measurable_fst.comp measurable_snd))).prodMk
        (measurable_snd.comp measurable_snd)))
  have hK31 : ∀ z (pq : Ang × Ang),
      ‖W z pq.1 * aux_gopAdjW W (fun θ : Ang => N (u θ)) (z + N (u pq.1)) pq.2‖ ≤ 1 :=
    fun z pq => by
      rw [norm_mul]
      calc _ ≤ (1 : ℝ) * 1 := by
            gcongr
            · exact hW1 _ _
            · exact hK₂1 _ _
        _ = 1 := one_mul 1
  rw [aux_gopL_adjoint, aux_gopL_comp σ σ W hW hW1 _ hD _ hK₂ hK₂1 (fun p => -N (u p)) hD.neg
    hK3 hK31 (aux_cc_D3_meas N)]
  exact aux_cc_TT_compact N c hc hNc _ hK3 hK31 X hX (fun z pq hz => by simp [hWX z _ hz])

/-! ### The trilinear `L²` estimate (`lem:triple-l2`) -/

/-- Auxiliary for `lem:triple-l2`: the trilinear estimate of `Auto.aux_pre_LW` with the angular
integral outside, `∫∫ |f₀(x) f₁(x+u_θ) f₂(x+Mu_θ)| dx dσ(θ) ≤ C_M ∏ ‖f_j‖₂`. -/
lemma aux_tl_sig (α β : ℝ) (hβ : β ≠ 0) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) :
    ∫⁻ θ, ∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + u θ)‖ₑ * ‖f 2 (x + M α β (u θ))‖ₑ ∂volume ∂σ ≤
      ENNReal.ofReal (aux_C_pre_LW α β) * ∏ j : Fin 3, eLpNorm (f j) 2 := by
  have hm := (aux_fb_aesm α β FCMeasure.sigma f hf).enorm
  have hm' : AEMeasurable (fun p : Ang × ℝ² =>
      ‖f 0 p.2‖ₑ * ‖f 1 (p.2 + u p.1)‖ₑ * ‖f 2 (p.2 + M α β (u p.1))‖ₑ) (σ.prod volume) := by
    refine hm.congr (Eventually.of_forall fun p => ?_)
    simp [FCMeasure.sigma, enorm_mul]
  rw [lintegral_lintegral_swap hm']
  refine le_trans (le_of_eq (lintegral_congr fun x => lintegral_congr fun θ => ?_))
    (aux_pre_LW α β hβ f hf)
  simp [Fin.prod_univ_three, proj, Lv, mul_assoc]

/-- Auxiliary for `lem:triple-l2`: the absolute bound for `σ * κ`,
`∫∫ |f₀(x) f₁(x+u) f₂(x+Mu)| dx d|σ*κ|(u) ≤ C_M ‖κ‖_TV ∏ ‖f_j‖₂`. -/
lemma aux_tl_abs (α β : ℝ) (hβ : β ≠ 0) (κ : FCMeasure) (f : Fin 3 → ℝ² → ℂ)
    (hf : ∀ j, AEStronglyMeasurable (f j) volume) :
    ∫⁻ p, (∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + (FCMeasure.sigma.conv κ).φ p)‖ₑ *
      ‖f 2 (x + M α β ((FCMeasure.sigma.conv κ).φ p))‖ₑ) * ‖(FCMeasure.sigma.conv κ).w p‖ₑ
        ∂(FCMeasure.sigma.conv κ).m ≤
      ENNReal.ofReal (aux_C_pre_LW α β) * κ.tv * ∏ j : Fin 3, eLpNorm (f j) 2 := by
  set ν := FCMeasure.sigma.conv κ
  have hA : AEMeasurable (fun p => (∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + ν.φ p)‖ₑ *
      ‖f 2 (x + M α β (ν.φ p))‖ₑ) * ‖ν.w p‖ₑ) ν.m := by
    have h := (aux_fb_aesm α β ν f hf).enorm.lintegral_prod_right'
    refine h.congr (Eventually.of_forall fun p => ?_)
    simp only [enorm_mul]
    rw [lintegral_mul_const' _ _ enorm_ne_top]
  have hmp := fun c : ℝ² => measurePreserving_add_right (volume : Measure ℝ²) c
  set C := ENNReal.ofReal (aux_C_pre_LW α β) * ∏ j : Fin 3, eLpNorm (f j) 2
  have hinner : ∀ z : κ.Z, ∫⁻ θ, ∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + (u θ + κ.φ z))‖ₑ *
      ‖f 2 (x + M α β (u θ + κ.φ z))‖ₑ ∂volume ∂σ ≤ C := by
    intro z
    set g : Fin 3 → ℝ² → ℂ := ![f 0, fun y => f 1 (y + κ.φ z), fun y => f 2 (y + M α β (κ.φ z))]
    have hg : ∀ j, AEStronglyMeasurable (g j) volume := by
      intro j; fin_cases j
      · exact hf 0
      · exact (hf 1).comp_quasiMeasurePreserving (hmp _).quasiMeasurePreserving
      · exact (hf 2).comp_quasiMeasurePreserving (hmp _).quasiMeasurePreserving
    have h := aux_tl_sig α β hβ g hg
    have e : ∏ j : Fin 3, eLpNorm (g j) 2 = ∏ j : Fin 3, eLpNorm (f j) 2 := by
      simp only [Fin.prod_univ_three, g, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
      have e1 : eLpNorm (fun y => f 1 (y + κ.φ z)) 2 volume = eLpNorm (f 1) 2 volume :=
        eLpNorm_comp_measurePreserving (hf 1) (hmp _)
      have e2 : eLpNorm (fun y => f 2 (y + M α β (κ.φ z))) 2 volume = eLpNorm (f 2) 2 volume :=
        eLpNorm_comp_measurePreserving (hf 2) (hmp _)
      rw [e1, e2]
    rw [e] at h
    refine le_trans (le_of_eq ?_) h
    refine lintegral_congr fun θ => lintegral_congr fun x => ?_
    simp only [g, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, map_add, add_assoc]
  calc ∫⁻ p, (∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + ν.φ p)‖ₑ * ‖f 2 (x + M α β (ν.φ p))‖ₑ) * ‖ν.w p‖ₑ ∂ν.m
      = ∫⁻ z, ∫⁻ θ, (∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + (u θ + κ.φ z))‖ₑ *
          ‖f 2 (x + M α β (u θ + κ.φ z))‖ₑ) * ‖(1 : ℂ) * κ.w z‖ₑ ∂σ ∂κ.m :=
        lintegral_prod_symm _ hA
    _ = ∫⁻ z, (∫⁻ θ, ∫⁻ x, ‖f 0 x‖ₑ * ‖f 1 (x + (u θ + κ.φ z))‖ₑ *
          ‖f 2 (x + M α β (u θ + κ.φ z))‖ₑ ∂volume ∂σ) * ‖κ.w z‖ₑ ∂κ.m := by
        refine lintegral_congr fun z => ?_
        rw [one_mul, lintegral_mul_const' _ _ enorm_ne_top]
    _ ≤ ∫⁻ z, C * ‖κ.w z‖ₑ ∂κ.m := lintegral_mono fun z => mul_le_mul_left (hinner z) _
    _ = _ := by
        rw [lintegral_const_mul'' _ κ.integrable_w.1.enorm, FCMeasure.tv]; ring

/-- **Lemma `lem:triple-l2`**. There is a constant $C_M$ such that
$|\Lambda_\sigma(f_0,f_1,f_2)|\le C_M\prod_{j=0}^2\|f_j\|_2$; the integral is absolutely
convergent for these inputs. For every finite measure $\kappa$, the same assertions hold for
$\sigma*\kappa$ with the additional factor $\|\kappa\|_{\mathrm{TV}}$. -/
theorem lem_triple_l2 (α β : ℝ) (hβ : β ≠ 0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (κ : FCMeasure) (f : Fin 3 → ℝ² → ℂ), (∀ j, MemLp (f j) 2 volume) →
      Integrable (fun p : (FCMeasure.sigma.conv κ).Z × ℝ² => f 0 p.2 *
        f 1 (p.2 + (FCMeasure.sigma.conv κ).φ p.1) *
        f 2 (p.2 + M α β ((FCMeasure.sigma.conv κ).φ p.1)) * (FCMeasure.sigma.conv κ).w p.1)
        ((FCMeasure.sigma.conv κ).m.prod volume) ∧
      ‖form α β (FCMeasure.sigma.conv κ) (f 0) (f 1) (f 2)‖ₑ ≤
        ENNReal.ofReal C * κ.tv * ∏ j : Fin 3, eLpNorm (f j) 2 volume := by
  refine ⟨aux_C_pre_LW α β, by unfold aux_C_pre_LW; positivity, fun κ f hf => ⟨?_, ?_⟩⟩
  · set ν := FCMeasure.sigma.conv κ
    have hm := aux_fb_aesm α β ν f fun j => (hf j).1
    refine ⟨hm, ?_⟩
    rw [HasFiniteIntegral, lintegral_prod _ hm.enorm]
    refine lt_of_le_of_lt (le_trans (le_of_eq (lintegral_congr fun p => ?_))
      (aux_tl_abs α β hβ κ f fun j => (hf j).1)) ?_
    · simp only [enorm_mul]
      rw [lintegral_mul_const' _ _ enorm_ne_top]
    · exact ENNReal.mul_lt_top (ENNReal.mul_lt_top ENNReal.ofReal_lt_top κ.integrable_w.2)
        (ENNReal.prod_lt_top fun j _ => (hf j).2)
  · refine le_trans ?_ (aux_tl_abs α β hβ κ f fun j => (hf j).1)
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun z => ?_)
    rw [enorm_mul]
    refine mul_le_mul_left ((enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)) _
    simp [enorm_mul]

/-- **Lemma `lem:triple-l2`** (the case $\kappa=\delta_0$). There is a constant $C_M$ such that
$|\Lambda_\sigma(f_0,f_1,f_2)|\le C_M\prod_{j=0}^2\|f_j\|_2$, the integral being absolutely
convergent. -/
theorem lem_triple_l2_sigma (α β : ℝ) (hβ : β ≠ 0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (f : Fin 3 → ℝ² → ℂ), (∀ j, MemLp (f j) 2 volume) →
      Integrable (fun p : Ang × ℝ² => f 0 p.2 * f 1 (p.2 + u p.1) * f 2 (p.2 + M α β (u p.1)))
        (σ.prod volume) ∧
      ‖form α β FCMeasure.sigma (f 0) (f 1) (f 2)‖ₑ ≤
        ENNReal.ofReal C * ∏ j : Fin 3, eLpNorm (f j) 2 volume := by
  refine ⟨aux_C_pre_LW α β, by unfold aux_C_pre_LW; positivity, fun f hf => ⟨?_, ?_⟩⟩
  · have hm := aux_fb_aesm α β FCMeasure.sigma f fun j => (hf j).1
    have hm' : AEStronglyMeasurable (fun p : Ang × ℝ² =>
        f 0 p.2 * f 1 (p.2 + u p.1) * f 2 (p.2 + M α β (u p.1))) (σ.prod volume) :=
      hm.congr (Eventually.of_forall fun p => by simp [FCMeasure.sigma])
    refine ⟨hm', ?_⟩
    rw [HasFiniteIntegral, lintegral_prod _ hm'.enorm]
    refine lt_of_le_of_lt (le_trans (le_of_eq (lintegral_congr fun p => ?_))
      (aux_tl_sig α β hβ f fun j => (hf j).1)) ?_
    · simp only [enorm_mul]
    · exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (ENNReal.prod_lt_top fun j _ => (hf j).2)
  · refine le_trans ?_ (aux_tl_sig α β hβ f fun j => (hf j).1)
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun z => ?_)
    change ‖(∫ x, f 0 x * f 1 (x + u z) * f 2 (x + M α β (u z))) * 1‖ₑ ≤ _
    rw [mul_one]
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    simp [enorm_mul]

/-! ### Small support in an `L²` input (`lem:small-support`) -/

/-- Auxiliary for `lem:small-support`: each edge map `L_k - L_j` (`j ≠ k`) multiplies lengths by
a positive constant (`lem:geometry`). -/
lemma aux_ss_edge (α β : ℝ) (hβ : β ≠ 0) (j k : Fin 3) (hjk : j ≠ k) :
    ∃ c > 0, ∀ x, ‖(Lv α β k - Lv α β j) x‖ = c * ‖x‖ := by
  obtain ⟨a, b, hab, he⟩ := lem_geometry_differences α β hβ k j hjk.symm
  refine ⟨aux_mM a b, Real.sqrt_pos.2 hab, fun x => ?_⟩
  rw [he]; exact aux_lw_norm_M a b x

/-- Auxiliary for `lem:small-support`: a product over `Fin 3` in terms of three distinct
indices. -/
lemma aux_ss_three (i j k : Fin 3) (hij : i ≠ j) (hik : i ≠ k)
    (hjk : j ≠ k) (g : Fin 3 → ℝ≥0∞) : ∏ l, g l = g i * g j * g k := by
  rw [Fin.prod_univ_three]
  fin_cases i <;> fin_cases j <;> fin_cases k <;> simp_all <;> ring

/-- Auxiliary for `lem:small-support`: the estimate for `σ` and measurable inputs, given the
small-set modulus `ω` of the circle operator along the edge `L_k - L_j` (`lem:circle-compact`). -/
lemma aux_ss_sigma (α β : ℝ) (i j k : Fin 3) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    (ω : ℝ → ℝ) (hωm : MonotoneOn ω (Ici 0))
    (hω : ∀ (W : ℝ² → Ang → ℂ), Measurable (Function.uncurry W) → (∀ z θ, ‖W z θ‖ ≤ 1) →
      ∀ (e : ℝ² → ℝ), Measurable e → (∀ z, e z ∈ Icc 0 1) → Integrable e →
      ∀ g : ℝ² → ℂ, MemLp g 2 →
        eLpNorm (fun z => (Real.sqrt (e z) : ℂ) * circleOp (Lv α β k - Lv α β j) W g z) 2
          volume ≤ ENNReal.ofReal (ω (∫ z, e z)) * eLpNorm g 2 volume)
    (f : Fin 3 → ℝ² → ℂ) (hfm : ∀ l, Measurable (f l))
    (hf : ∀ l, MemLp (f l) (aux_slotExp i l) volume) (A : Set ℝ²) (s : ℝ) (hA : MeasurableSet A)
    (hAs : volume A ≤ ENNReal.ofReal s) (hsupp : ∀ x, x ∉ A → f j x = 0) :
    ‖form α β FCMeasure.sigma (f 0) (f 1) (f 2)‖ₑ ≤
      ENNReal.ofReal (ω (max s 0)) * ∏ l : Fin 3, eLpNorm (f l) (aux_slotExp i l) volume := by
  set N := Lv α β k - Lv α β j
  set L := Lv α β
  have hu := aux_lw_u_meas
  have hNu : Measurable fun θ => N (u θ) := N.continuous.measurable.comp hu
  have hLu : ∀ l, Measurable fun θ => L l (u θ) := fun l => (L l).continuous.measurable.comp hu
  have hsi : aux_slotExp i i = ⊤ := by simp [aux_slotExp]
  have hsj : aux_slotExp i j = 2 := by simp [aux_slotExp, hij.symm]
  have hsk : aux_slotExp i k = 2 := by simp [aux_slotExp, hik.symm]
  have hj2 : MemLp (f j) 2 := by have := hf j; rwa [hsj] at this
  have hk2 : MemLp (f k) 2 := by have := hf k; rwa [hsk] at this
  set I := eLpNorm (f i) ⊤ volume
  -- step 1: the absolute integral
  have h1 : ‖form α β FCMeasure.sigma (f 0) (f 1) (f 2)‖ₑ ≤
      ∫⁻ θ, ∫⁻ x, ∏ l : Fin 3, ‖f l (x + L l (u θ))‖ₑ ∂volume ∂σ := by
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun θ => ?_)
    change ‖(∫ x, f 0 x * f 1 (x + u θ) * f 2 (x + M α β (u θ))) * 1‖ₑ ≤ _
    rw [mul_one]
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    refine lintegral_congr fun x => ?_
    simp [Fin.prod_univ_three, L, Lv, enorm_mul]
  -- step 2: bound the `i`-th factor and translate
  have h2 : ∀ θ, ∫⁻ x, ∏ l : Fin 3, ‖f l (x + L l (u θ))‖ₑ ≤
      I * ∫⁻ z, ‖f j z‖ₑ * ‖f k (z + N (u θ))‖ₑ := by
    intro θ
    have hb : ∀ᵐ x ∂(volume : Measure ℝ²), ‖f i (x + L i (u θ))‖ₑ ≤ I := by
      have :=
        (measurePreserving_add_right (volume : Measure ℝ²) (L i (u θ))).quasiMeasurePreserving.ae
        (ae_le_eLpNormEssSup (f := f i) (μ := volume))
      rw [show I = eLpNormEssSup (f i) volume from eLpNorm_exponent_top]
      exact this
    calc ∫⁻ x, ∏ l : Fin 3, ‖f l (x + L l (u θ))‖ₑ
        ≤ ∫⁻ x, I * (‖f j (x + L j (u θ))‖ₑ * ‖f k (x + L k (u θ))‖ₑ) := by
          refine lintegral_mono_ae ?_
          filter_upwards [hb] with x hx
          rw [aux_ss_three i j k hij hik hjk, mul_assoc]
          gcongr
      _ = I * ∫⁻ x, ‖f j (x + L j (u θ))‖ₑ * ‖f k (x + L k (u θ))‖ₑ :=
          lintegral_const_mul _ (((hfm j).comp (measurable_add_const _)).enorm.mul
            ((hfm k).comp (measurable_add_const _)).enorm)
      _ = I * ∫⁻ z, ‖f j z‖ₑ * ‖f k (z + N (u θ))‖ₑ := by
          congr 1
          rw [← lintegral_add_right_eq_self (fun z => ‖f j z‖ₑ * ‖f k (z + N (u θ))‖ₑ)
            (L j (u θ))]
          refine lintegral_congr fun x => ?_
          simp only [N, sub_apply, L]
          congr 3; abel
  -- step 3: the circle operator with weight one applied to `|f_k|`
  set g : ℝ² → ℂ := fun y => ((‖f k y‖ : ℝ) : ℂ)
  have hg2 : MemLp g 2 := hk2.norm.ofReal
  have hgn : eLpNorm g 2 volume = eLpNorm (f k) 2 volume :=
    eLpNorm_congr_norm_ae (Eventually.of_forall fun y => by simp [g])
  set e : ℝ² → ℝ := A.indicator 1
  have hem : Measurable e := measurable_one.indicator hA
  have he01 : ∀ z, e z ∈ Icc 0 1 := fun z => by
    by_cases hz : z ∈ A <;> simp [e, hz]
  have hAfin : volume A < ⊤ := hAs.trans_lt ENNReal.ofReal_lt_top
  have hei : Integrable e := (integrable_indicator_iff hA).2 (integrableOn_const hAfin.ne)
  have heint : ∫ z, e z = (volume A).toReal := by
    simp [e, integral_indicator hA, measureReal_def]
  have hW : Measurable (Function.uncurry fun (_ : ℝ²) (_ : Ang) => (1 : ℂ)) := measurable_const
  have hcirc := hω (fun _ _ => 1) hW (fun _ _ => by simp) e hem he01 hei g hg2
  set h : ℝ² → ℂ := fun z => (Real.sqrt (e z) : ℂ) * circleOp N (fun _ _ => 1) g z
  have hint := aux_gop_integrable σ (fun _ _ => (1 : ℂ)) hW (fun _ _ => by simp) _ hNu g hg2
  have h4 : ∀ᵐ z ∂(volume : Measure ℝ²),
      ‖f j z‖ₑ * ∫⁻ θ, ‖f k (z + N (u θ))‖ₑ ∂σ ≤ ‖f j z‖ₑ * ‖h z‖ₑ := by
    filter_upwards [hint] with z hz
    by_cases hzA : z ∈ A
    · gcongr
      have hez : e z = 1 := by simp [e, hzA]
      simp only [h, hez, Real.sqrt_one, Complex.ofReal_one, one_mul, circleOp]
      have hz' : Integrable (fun θ => ‖f k (z + N (u θ))‖) σ := by
        refine (hz.norm).congr (Eventually.of_forall fun θ => ?_)
        simp [g]
      have : (∫ θ, g (z + N (u θ)) ∂σ) = ((∫ θ, ‖f k (z + N (u θ))‖ ∂σ : ℝ) : ℂ) :=
        integral_ofReal
      rw [this, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (integral_nonneg fun θ => norm_nonneg _),
        ofReal_integral_eq_lintegral_ofReal hz' (Eventually.of_forall fun θ => norm_nonneg _)]
      simp only [ofReal_norm]
      exact le_rfl
    · rw [hsupp z hzA]; simp
  -- step 4: assemble
  have hhm : AEStronglyMeasurable h volume :=
    ((Complex.measurable_ofReal.comp
      (Real.continuous_sqrt.measurable.comp hem)).aestronglyMeasurable).mul
      (aux_gop_aesm σ (fun _ _ => (1 : ℂ)) hW _ hNu g hg2.1)
  have hωle : ω (∫ z, e z) ≤ ω (max s 0) := by
    rw [heint]
    exact hωm (mem_Ici.2 ENNReal.toReal_nonneg) (mem_Ici.2 (le_max_right _ _))
      (ENNReal.toReal_le_of_le_ofReal (le_max_right _ _)
        (hAs.trans (ENNReal.ofReal_le_ofReal (le_max_left _ _))))
  have hFm : Measurable fun q : Ang × ℝ² => ‖f j q.2‖ₑ * ‖f k (q.2 + N (u q.1))‖ₑ :=
    (hfm j).enorm.comp measurable_snd |>.mul
      ((hfm k).enorm.comp (measurable_snd.add (hNu.comp measurable_fst)))
  calc ‖form α β FCMeasure.sigma (f 0) (f 1) (f 2)‖ₑ
      ≤ ∫⁻ θ, ∫⁻ x, ∏ l : Fin 3, ‖f l (x + L l (u θ))‖ₑ ∂volume ∂σ := h1
    _ ≤ ∫⁻ θ, I * (∫⁻ z, ‖f j z‖ₑ * ‖f k (z + N (u θ))‖ₑ) ∂σ := lintegral_mono h2
    _ = I * ∫⁻ θ, ∫⁻ z, ‖f j z‖ₑ * ‖f k (z + N (u θ))‖ₑ ∂volume ∂σ :=
        lintegral_const_mul _ hFm.lintegral_prod_right'
    _ = I * ∫⁻ z, ∫⁻ θ, ‖f j z‖ₑ * ‖f k (z + N (u θ))‖ₑ ∂σ := by
        rw [lintegral_lintegral_swap hFm.aemeasurable]
    _ = I * ∫⁻ z, ‖f j z‖ₑ * ∫⁻ θ, ‖f k (z + N (u θ))‖ₑ ∂σ := by
        congr 1
        refine lintegral_congr fun z => ?_
        exact lintegral_const_mul _ ((hfm k).enorm.comp (measurable_const.add hNu))
    _ ≤ I * ∫⁻ z, ‖f j z‖ₑ * ‖h z‖ₑ := by gcongr 1; exact lintegral_mono_ae h4
    _ ≤ I * (eLpNorm (f j) 2 volume * eLpNorm h 2 volume) := by
        gcongr; exact aux_s2a_holder (hfm j).aestronglyMeasurable hhm 2 2
    _ ≤ I * (eLpNorm (f j) 2 volume * (ENNReal.ofReal (ω (max s 0)) * eLpNorm (f k) 2 volume)) := by
        gcongr
        refine hcirc.trans ?_
        rw [hgn]; gcongr
    _ = _ := by
        rw [aux_ss_three i j k hij hik hjk (fun l => eLpNorm (f l) (aux_slotExp i l) volume)]
        simp only [hsi, hsj, hsk, I]
        ring

/-- Auxiliary for `lem:small-support`: the translated triple as coordinatewise translates. -/
lemma aux_ss_trip (α β : ℝ) (g : Fin 3 → ℝ² → ℂ) (w : ℝ²) (l : Fin 3) (x : ℝ²) :
    (![g 0, fun x => g 1 (x + w), fun x => g 2 (x + M α β w)] : Fin 3 → ℝ² → ℂ) l x =
      g l (x + (![0, w, M α β w] : Fin 3 → ℝ²) l) := by
  fin_cases l <;> simp

/-- **Lemma `lem:small-support`**. There is a nondecreasing modulus $\omega_M(s)\to0$ as
$s\downarrow0$ with the following property. Suppose $i,j,k$ are distinct, $f_i\in L^\infty$,
$f_j,f_k\in L^2$, and $f_j$ is supported on a measurable set of area at most $s$. Then, for
every finite measure $\kappa$,
$|\Lambda_{\sigma*\kappa}(f_0,f_1,f_2)|\le\|\kappa\|_{\mathrm{TV}}\omega_M(s)\|f_i\|_\infty
\|f_j\|_2\|f_k\|_2$. -/
theorem lem_small_support (α β : ℝ) (hβ : β ≠ 0) :
    ∃ ω : ℝ → ℝ, Monotone ω ∧ (∀ s, 0 ≤ ω s) ∧ Tendsto ω (𝓝[>] 0) (𝓝 0) ∧
      ∀ (i j : Fin 3), i ≠ j → ∀ (f : Fin 3 → ℝ² → ℂ),
        (∀ l, MemLp (f l) (aux_slotExp i l) volume) →
        ∀ (A : Set ℝ²) (s : ℝ), MeasurableSet A → volume A ≤ ENNReal.ofReal s →
        (∀ x, x ∉ A → f j x = 0) → ∀ κ : FCMeasure,
        ‖form α β (FCMeasure.sigma.conv κ) (f 0) (f 1) (f 2)‖ₑ ≤
          κ.tv * ENNReal.ofReal (ω s) * ∏ l : Fin 3, eLpNorm (f l) (aux_slotExp i l) volume := by
  have hex : ∀ j k : Fin 3, ∃ ω : ℝ → ℝ, MonotoneOn ω (Ici 0) ∧ (∀ s, 0 ≤ s → ω s ∈ Icc 0 1) ∧
      Tendsto ω (𝓝[>] 0) (𝓝 0) ∧ (j ≠ k →
      ∀ (W : ℝ² → Ang → ℂ), Measurable (Function.uncurry W) → (∀ z θ, ‖W z θ‖ ≤ 1) →
      ∀ (e : ℝ² → ℝ), Measurable e → (∀ z, e z ∈ Icc 0 1) → Integrable e →
      ∀ g : ℝ² → ℂ, MemLp g 2 →
        eLpNorm (fun z => (Real.sqrt (e z) : ℂ) * circleOp (Lv α β k - Lv α β j) W g z) 2
          volume ≤ ENNReal.ofReal (ω (∫ z, e z)) * eLpNorm g 2 volume) := by
    intro j k
    by_cases hjk : j = k
    · exact ⟨0, fun _ _ _ _ _ => le_rfl, fun _ _ => by simp, tendsto_const_nhds,
        fun h => absurd hjk h⟩
    · obtain ⟨ω, h1, h2, h3, h4⟩ := lem_circle_compact_small _ (aux_ss_edge α β hβ j k hjk)
      exact ⟨ω, h1, h2, h3, fun _ => h4⟩
  choose ωs hmono hrange htend hbound using hex
  refine ⟨fun s => ∑ p : Fin 3 × Fin 3, ωs p.1 p.2 (max s 0), ?_, ?_, ?_, ?_⟩
  · intro s t hst
    exact Finset.sum_le_sum fun p _ => hmono p.1 p.2 (mem_Ici.2 (le_max_right _ _))
      (mem_Ici.2 (le_max_right _ _)) (max_le_max hst le_rfl)
  · intro s
    exact Finset.sum_nonneg fun p _ => (hrange p.1 p.2 _ (le_max_right _ _)).1
  · have h : ∀ p : Fin 3 × Fin 3, Tendsto (fun s => ωs p.1 p.2 (max s 0)) (𝓝[>] 0) (𝓝 0) := by
      intro p
      refine (htend p.1 p.2).congr' ?_
      filter_upwards [self_mem_nhdsWithin] with s hs
      rw [max_eq_left (le_of_lt hs)]
    simpa using tendsto_finsetSum Finset.univ fun p _ => h p
  · intro i j hij f hf A s hA hAs hsupp κ
    have hk3 : ∀ i j : Fin 3, i ≠ j → ∃ k : Fin 3, k ≠ i ∧ k ≠ j := by decide
    obtain ⟨k, hki, hkj⟩ := hk3 i j hij
    set B := ENNReal.ofReal (∑ p : Fin 3 × Fin 3, ωs p.1 p.2 (max s 0)) *
      ∏ l : Fin 3, eLpNorm (f l) (aux_slotExp i l) volume
    let P : (Fin 3 → ℝ² → ℂ) → Prop := fun g => (∀ l, MemLp (g l) (aux_slotExp i l) volume) ∧
      (∀ l, eLpNorm (g l) (aux_slotExp i l) volume = eLpNorm (f l) (aux_slotExp i l) volume) ∧
      ∃ A' : Set ℝ², MeasurableSet A' ∧ volume A' ≤ ENNReal.ofReal s ∧ ∀ x, x ∉ A' → g j x = 0
    have hmp := fun c : ℝ² => measurePreserving_add_right (volume : Measure ℝ²) c
    have hinv : ∀ g, P g → ∀ w : ℝ²,
        P ![g 0, fun x => g 1 (x + w), fun x => g 2 (x + M α β w)] := by
      rintro g ⟨hgL, hgn, A', hA', hA's, hgs⟩ w
      set c : Fin 3 → ℝ² := ![0, w, M α β w]
      have he : ∀ l, (![g 0, fun x => g 1 (x + w), fun x => g 2 (x + M α β w)] :
          Fin 3 → ℝ² → ℂ) l = fun x => g l (x + c l) := fun l => funext (aux_ss_trip α β g w l)
      refine ⟨fun l => ?_, fun l => ?_, (fun x => x + c j) ⁻¹' A', hA'.preimage
        (measurable_add_const _), ?_, fun x hx => ?_⟩
      · rw [he l]; exact (hgL l).comp_measurePreserving (hmp _)
      · rw [he l, ← hgn l]; exact eLpNorm_comp_measurePreserving (hgL l).1 (hmp _)
      · rw [measure_preimage_add_right]; exact hA's
      · rw [he j]; exact hgs _ hx
    have hB : ∀ g, P g → ‖form α β FCMeasure.sigma (g 0) (g 1) (g 2)‖ₑ ≤ B := by
      rintro g ⟨hgL, hgn, A', hA', hA's, hgs⟩
      set g' : Fin 3 → ℝ² → ℂ := fun l =>
        if l = j then A'.indicator ((hgL l).1.mk (g l)) else (hgL l).1.mk (g l)
      have hgg' : ∀ l, g l =ᵐ[volume] g' l := by
        intro l
        by_cases hl : l = j
        · subst hl
          filter_upwards [(hgL l).1.ae_eq_mk] with x hx
          by_cases hxA : x ∈ A'
          · simp [g', hxA, hx]
          · simp [g', hxA, hgs x hxA]
        · simpa [g', hl] using (hgL l).1.ae_eq_mk
      have hg'm : ∀ l, Measurable (g' l) := by
        intro l
        by_cases hl : l = j
        · simp only [g', hl, if_true]
          exact (hgL j).1.stronglyMeasurable_mk.measurable.indicator hA'
        · simp only [g', hl, if_false]
          exact (hgL l).1.stronglyMeasurable_mk.measurable
      have hg'L : ∀ l, MemLp (g' l) (aux_slotExp i l) volume := fun l => (hgL l).ae_eq (hgg' l)
      have hg's : ∀ x, x ∉ A' → g' j x = 0 := fun x hx => by simp [g', hx]
      rw [lem_form_basic_ae α β FCMeasure.sigma g g' hgg']
      refine (aux_ss_sigma α β i j k hij hki.symm hkj.symm (ωs j k) (hmono j k)
        (hbound j k hkj.symm) g' hg'm hg'L A' s hA' hA's hg's).trans ?_
      have hn : ∏ l : Fin 3, eLpNorm (g' l) (aux_slotExp i l) volume =
          ∏ l : Fin 3, eLpNorm (f l) (aux_slotExp i l) volume :=
        Finset.prod_congr rfl fun l _ => by rw [← eLpNorm_congr_ae (hgg' l), hgn l]
      rw [hn]
      exact mul_le_mul_left (ENNReal.ofReal_le_ofReal
        (Finset.single_le_sum (f := fun p : Fin 3 × Fin 3 => ωs p.1 p.2 (max s 0))
        (fun p _ => (hrange p.1 p.2 _ (le_max_right _ _)).1) (Finset.mem_univ (j, k)))) _
    have := lem_convolution_translate_general α β FCMeasure.sigma κ i P (fun g hg => hg.1) hinv
      B hB f ⟨hf, fun _ => rfl, A, hA, hAs, hsupp⟩
    rw [mul_assoc]; exact this

end Auto
