/-- Coordinates of `simil a b x` (auxiliary computation rule for `\label{def:geometry}`). -/
@[simp] lemma aux_simil_apply_zero (a b : ℝ) (x : ℝ²) : simil a b x 0 = a * x 0 - b * x 1 := by
  simp [simil]; ring

/-- Coordinates of `simil a b x` (auxiliary computation rule for `\label{def:geometry}`). -/
@[simp] lemma aux_simil_apply_one (a b : ℝ) (x : ℝ²) : simil a b x 1 = a * x 1 + b * x 0 := by
  simp [simil]

/-- Extensionality for continuous linear maps of the plane through coordinates (auxiliary). -/
lemma aux_clm_ext {f g : ℝ² →L[ℝ] ℝ²} (h : ∀ x : ℝ², f x 0 = g x 0 ∧ f x 1 = g x 1) : f = g := by
  ext x i; fin_cases i
  · exact (h x).1
  · exact (h x).2

/-- Composition of similarities `(aI+bJ)(cI+dJ) = (ac-bd)I + (ad+bc)J` (auxiliary). -/
lemma aux_simil_comp (a b c d : ℝ) :
    (simil a b).comp (simil c d) = simil (a * c - b * d) (a * d + b * c) := by
  apply aux_clm_ext; intro x; constructor <;> simp <;> ring

/-- Coordinate extensionality in the plane (auxiliary). -/
lemma aux_vec_ext {x y : ℝ²} (h0 : x 0 = y 0) (h1 : x 1 = y 1) : x = y := by
  ext i; fin_cases i
  · exact h0
  · exact h1

/-- Real-variable identity used for collinearity (auxiliary for `\label{lem:geometry}`). -/
lemma aux_proj_coord (B0 B1 P0 P1 : ℝ) (hn : B0 ^ 2 + B1 ^ 2 ≠ 0)
    (hd : B0 * P1 - B1 * P0 = 0) :
    (B0 * P0 + B1 * P1) / (B0 ^ 2 + B1 ^ 2) * B0 = P0 ∧
      (B0 * P0 + B1 * P1) / (B0 ^ 2 + B1 ^ 2) * B1 = P1 := by
  constructor <;> field_simp
  · linear_combination B1 * hd
  · linear_combination (-B0) * hd

/-- If `det(b-a, c-a) = 0` then `{a,b,c}` is collinear (auxiliary for `\label{lem:geometry}`). -/
lemma aux_collinear_of_det (a b c : ℝ²)
    (h : (b - a) 0 * (c - a) 1 - (b - a) 1 * (c - a) 0 = 0) : Collinear ℝ {a, b, c} := by
  by_cases hp : b - a = 0
  · have : b = a := sub_eq_zero.mp hp
    subst this
    simp [Set.insert_eq_of_mem, collinear_pair]
  · rw [collinear_iff_of_mem (p₀ := a) (by simp)]
    refine ⟨b - a, ?_⟩
    have hn : (b - a) 0 ^ 2 + (b - a) 1 ^ 2 ≠ 0 := by
      intro h0
      apply hp
      have h1 : (b - a) 0 = 0 := by nlinarith [sq_nonneg ((b - a) 0), sq_nonneg ((b - a) 1)]
      have h2 : (b - a) 1 = 0 := by nlinarith [sq_nonneg ((b - a) 0), sq_nonneg ((b - a) 1)]
      exact aux_vec_ext (by simpa using h1) (by simpa using h2)
    intro p hp'
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp'
    rcases hp' with rfl | rfl | rfl
    · exact ⟨0, by simp⟩
    · exact ⟨1, by simp⟩
    · obtain ⟨k0, k1⟩ := aux_proj_coord _ _ _ _ hn h
      refine ⟨((b - a) 0 * (p - a) 0 + (b - a) 1 * (p - a) 1) /
          ((b - a) 0 ^ 2 + (b - a) 1 ^ 2), aux_vec_ext ?_ ?_⟩
      · simp only [vadd_eq_add, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, k0]
        simp
      · simp only [vadd_eq_add, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, k1]
        simp

@[simp] lemma aux_e1_zero : e1 0 = 1 := by simp [e1]
@[simp] lemma aux_e1_one : e1 1 = 0 := by simp [e1]
