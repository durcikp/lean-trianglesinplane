  have e2 : ∫⁻ z, a z ^ (2:ℝ) * b z ∂μ = ∫⁻ z, b z * a z ^ (2:ℝ) ∂μ := by simp_rw [mul_comm]
  rw [e1, e2, mul_comm (∫⁻ z, b z ∂μ)]; exact h2

/-- **Lemma `ext:young`** (case `p = 1`).
If $\kappa$ is a finite complex Borel measure and $p\in\{1,2,\infty\}$, then
$$\|\kappa*f\|_p\le\|\kappa\|_{\mathrm{TV}}\|f\|_p.$$
In particular this holds when $\kappa$ has an $L^1$ density. -/
theorem ext_young_one (κ : FCMeasure) (f : ℝ² → ℂ) (hf : AEStronglyMeasurable f volume) :
    eLpNorm (κ.convFun f) 1 volume ≤ κ.tv * eLpNorm f 1 volume := by
  have hg := hf.stronglyMeasurable_mk.measurable
  rw [eLpNorm_one_eq_lintegral_enorm, eLpNorm_congr_ae hf.ae_eq_mk, eLpNorm_one_eq_lintegral_enorm]
  calc ∫⁻ x, ‖κ.convFun f x‖ₑ ≤ ∫⁻ x, ∫⁻ z, ‖hf.mk f (x - κ.φ z)‖ₑ ^ (1:ℝ) * ‖κ.w z‖ₑ ∂κ.m :=
        lintegral_mono_ae (by filter_upwards [aux_enorm_convFun_le κ hf] with x hx; simpa using hx)
    _ = _ := by rw [aux_young_swap κ hg, mul_comm]; simp

/-- **Lemma `ext:young`** (case `p = 2`).
If $\kappa$ is a finite complex Borel measure and $p\in\{1,2,\infty\}$, then
$$\|\kappa*f\|_p\le\|\kappa\|_{\mathrm{TV}}\|f\|_p.$$
In particular this holds when $\kappa$ has an $L^1$ density. -/
theorem ext_young_two (κ : FCMeasure) (f : ℝ² → ℂ) (hf : AEStronglyMeasurable f volume) :
    eLpNorm (κ.convFun f) 2 volume ≤ κ.tv * eLpNorm f 2 volume := by
  have hg := hf.stronglyMeasurable_mk.measurable
  rw [eLpNorm_congr_ae (p := 2) hf.ae_eq_mk,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num),
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  simp only [ENNReal.toReal_ofNat]
  have hw : AEMeasurable (fun z => ‖κ.w z‖ₑ) κ.m :=
    κ.integrable_w.aestronglyMeasurable.aemeasurable.enorm
  calc (∫⁻ x, ‖κ.convFun f x‖ₑ ^ (2:ℝ)) ^ (1 / (2:ℝ))
      ≤ (∫⁻ x, κ.tv * ∫⁻ z, ‖hf.mk f (x - κ.φ z)‖ₑ ^ (2:ℝ) * ‖κ.w z‖ₑ ∂κ.m) ^ (1 / (2:ℝ)) := by
        gcongr ?_ ^ _
        refine lintegral_mono_ae ?_
        filter_upwards [aux_enorm_convFun_le κ hf] with x hx
        refine (ENNReal.rpow_le_rpow hx (by norm_num)).trans ?_
        exact aux_lintegral_mul_sq_le κ.m (hg.comp (measurable_const.sub κ.measurable_φ)).enorm hw
    _ = κ.tv * (∫⁻ x, ‖hf.mk f x‖ₑ ^ (2:ℝ)) ^ (1 / (2:ℝ)) := by
        rw [lintegral_const_mul' _ _ (by unfold FCMeasure.tv; exact κ.integrable_w.2.ne),
          aux_young_swap κ hg, mul_left_comm, mul_comm,
          ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← sq, ← ENNReal.rpow_natCast,
          ← ENNReal.rpow_mul]
        norm_num

/-- **Lemma `ext:young`** (case `p = ∞`).
If $\kappa$ is a finite complex Borel measure and $p\in\{1,2,\infty\}$, then
$$\|\kappa*f\|_p\le\|\kappa\|_{\mathrm{TV}}\|f\|_p.$$
In particular this holds when $\kappa$ has an $L^1$ density. -/
theorem ext_young_top (κ : FCMeasure) (f : ℝ² → ℂ) (hf : AEStronglyMeasurable f volume) :
    eLpNorm (κ.convFun f) ⊤ volume ≤ κ.tv * eLpNorm f ⊤ volume := by
  simp only [eLpNorm_exponent_top]
  refine essSup_le_of_ae_le _ ?_
  have hb := aux_ae_ae_sub_comp κ (enorm_ae_le_eLpNormEssSup (μ := volume) f)
  filter_upwards [hb, aux_ae_ae_sub_comp κ hf.ae_eq_mk, aux_enorm_convFun_le κ hf] with x hx hx' hle
  refine hle.trans ?_
  calc ∫⁻ z, ‖hf.mk f (x - κ.φ z)‖ₑ * ‖κ.w z‖ₑ ∂κ.m
      ≤ ∫⁻ z, eLpNormEssSup f volume * ‖κ.w z‖ₑ ∂κ.m := by
        refine lintegral_mono_ae ?_
        filter_upwards [hx, hx'] with z hz hz'
        rw [← hz']
        gcongr
    _ = _ := by
        rw [lintegral_const_mul'' _ κ.integrable_w.aestronglyMeasurable.aemeasurable.enorm,
          mul_comm]; rfl

/-! ### Density and continuity under translations and dilations (`ext:approximation`) -/

/-- Auxiliary instance `0 < 2π`, needed for the probability measure `dθ/(2π)` on
`ℝ/(2πℤ) = AddCircle (2π)` (used in `ext_approximation_translation_config`). -/
instance aux_factTwoPiPos : Fact (0 < 2 * π) := ⟨Real.two_pi_pos⟩

/-- **Lemma `ext:approximation`** (density).
Smooth compactly supported functions are dense in $L^p(\mathbb R^2)$ for $p=1,2$.
For these two exponents, translations are continuous:
$$\|f(\cdot-h)-f\|_p\longrightarrow0\qquad(h\to0).$$
For $F\in L^p(\mathbb R^2\times[0,2\pi))$, the same conclusion holds for translation in the
first two variables, with the product measure $dx\,d\theta/(2\pi)$.
The normalized dilations $D_rf(x)=r^{-2}f(x/r)$ satisfy $\|D_rf-f\|_1\to0$ as $r\to1$. -/
theorem ext_approximation_dense {p : ℝ≥0∞} (hp : p = 1 ∨ p = 2) {f : ℝ² → ℂ}
    (hf : MemLp f p volume) {ε : ℝ} (hε : 0 < ε) :
    ∃ g : ℝ² → ℂ, HasCompactSupport g ∧ ContDiff ℝ (⊤ : ℕ∞) g ∧
      eLpNorm (f - g) p volume ≤ ENNReal.ofReal ε := by
  have hp1 : 1 ≤ p := by rcases hp with rfl | rfl <;> norm_num
  have hpt : p ≠ ⊤ := by rcases hp with rfl | rfl <;> simp
  exact hf.exist_eLpNorm_sub_le hpt hp1 hε

/-- Auxiliary (for `ext:approximation`, see `ext_approximation_translation` and
`ext_approximation_translation_config`): if `T a` is a continuous family of continuous measure-
preserving maps with `T a₀ = id`, then `‖F ∘ T a - F‖_p → 0` as `a → a₀` (`1 ≤ p < ∞`). -/
theorem aux_tendsto_eLpNorm_comp_sub {X : Type*} [TopologicalSpace X] [R1Space X]
    [MeasurableSpace X] [BorelSpace X] {μ : Measure X} [IsLocallyFiniteMeasure μ]
    [μ.InnerRegularCompactLTTop] {α : Type*} [TopologicalSpace α] (T : C(α, C(X, X))) {a₀ : α}
    (hT0 : T a₀ = ContinuousMap.id X) (hTm : ∀ a, MeasurePreserving (T a) μ μ) {p : ℝ≥0∞}
    (hp1 : 1 ≤ p) (hpt : p ≠ ∞) {F : X → ℂ} (hF : MemLp F p μ) :
    Tendsto (fun a => eLpNorm (fun x => F (T a x) - F x) p μ) (𝓝 a₀) (𝓝 0) := by
  have : Fact (1 ≤ p) := ⟨hp1⟩
  have h := Filter.Tendsto.compMeasurePreservingLp (μ := μ) (ν := μ)
    (f := fun _ : α => hF.toLp F) tendsto_const_nhds (T.continuous.tendsto a₀) hTm (hTm a₀) hpt
  rw [Lp.tendsto_Lp_iff_tendsto_eLpNorm'] at h
  refine h.congr fun a => eLpNorm_congr_ae ?_
  filter_upwards [Lp.coeFn_compMeasurePreserving (hF.toLp F) (hTm a),
    Lp.coeFn_compMeasurePreserving (hF.toLp F) (hTm a₀),
    (hTm a).quasiMeasurePreserving.ae_eq_comp hF.coeFn_toLp,
    (hTm a₀).quasiMeasurePreserving.ae_eq_comp hF.coeFn_toLp] with x h1 h2 h3 h4
  simp only [Pi.sub_apply, h1, h2, Function.comp_apply] at h3 h4 ⊢
  rw [h3, h4, hT0]; rfl

/-- Auxiliary (for `ext_approximation_dilation`): the normalized dilation `D_r h` of an integrable
