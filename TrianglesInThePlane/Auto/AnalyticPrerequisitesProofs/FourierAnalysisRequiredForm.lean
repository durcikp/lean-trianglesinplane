      have h1 : ‖((((r ^ 2)⁻¹ : ℝ)) : ℂ)‖ ≤ 4 := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
        rw [inv_le_comm₀ (by positivity) (by norm_num)]
        nlinarith [hr.1]
      have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM x)
      nlinarith [hM (r⁻¹ • x), hM x, norm_nonneg (g (r⁻¹ • x))]
    · have hx' : g x = 0 := by
        by_contra hc; exact hx ((hgs x hc).trans (by nlinarith [(norm_nonneg x)]))
      have hx'' : g (r⁻¹ • x) = 0 := by
        by_contra hc
        have := hgs _ hc
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.2 hr0), inv_mul_le_iff₀ hr0] at this
        exact hx (this.trans (by nlinarith [hr.2, (norm_nonneg x)]))
      simp [hx', hx'']
  · rw [lintegral_indicator_const Metric.isClosed_closedBall.measurableSet]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top measure_closedBall_lt_top.ne
  · refine Eventually.of_forall fun x => ?_
    have hc : ContinuousAt (fun r : ℝ => ‖(((r ^ 2)⁻¹ : ℝ) : ℂ) * g (r⁻¹ • x) - g x‖ₑ) 1 := by
      have : ContinuousAt (fun r : ℝ => r⁻¹) 1 := continuousAt_inv₀ one_ne_zero
      have h2 : ContinuousAt (fun r : ℝ => (r ^ 2)⁻¹) 1 :=
        (continuous_pow 2).continuousAt.inv₀ (by norm_num)
      exact (((Complex.continuous_ofReal.continuousAt.comp h2).mul
        (hg.continuousAt.comp (this.smul continuousAt_const))).sub continuousAt_const).enorm
    simpa using hc.tendsto

/-- **Lemma `ext:approximation`** (continuity of translations on `ℝ²`).
Smooth compactly supported functions are dense in $L^p(\mathbb R^2)$ for $p=1,2$.
For these two exponents, translations are continuous:
$$\|f(\cdot-h)-f\|_p\longrightarrow0\qquad(h\to0).$$
For $F\in L^p(\mathbb R^2\times[0,2\pi))$, the same conclusion holds for translation in the
first two variables, with the product measure $dx\,d\theta/(2\pi)$.
The normalized dilations $D_rf(x)=r^{-2}f(x/r)$ satisfy $\|D_rf-f\|_1\to0$ as $r\to1$. -/
theorem ext_approximation_translation {p : ℝ≥0∞} (hp : p = 1 ∨ p = 2) {f : ℝ² → ℂ}
    (hf : MemLp f p volume) :
    Tendsto (fun h : ℝ² => eLpNorm (fun x => f (x - h) - f x) p volume) (𝓝 0) (𝓝 0) := by
  have hp1 : 1 ≤ p := by rcases hp with rfl | rfl <;> norm_num
  have hpt : p ≠ ⊤ := by rcases hp with rfl | rfl <;> simp
  let T : C(ℝ², C(ℝ², ℝ²)) := (ContinuousMap.mk (fun q : ℝ² × ℝ² => q.2 - q.1) (by fun_prop)).curry
  exact aux_tendsto_eLpNorm_comp_sub T (by ext x; simp [T]) 
    (fun h => measurePreserving_sub_right volume h) hp1 hpt hf

/-- **Lemma `ext:approximation`** (continuity of translations on `ℝ² × [0,2π)`; the angular
variable is `θ ∈ AddCircle (2π)` with the probability Haar measure `dθ/(2π)`).
Smooth compactly supported functions are dense in $L^p(\mathbb R^2)$ for $p=1,2$.
For these two exponents, translations are continuous:
$$\|f(\cdot-h)-f\|_p\longrightarrow0\qquad(h\to0).$$
For $F\in L^p(\mathbb R^2\times[0,2\pi))$, the same conclusion holds for translation in the
first two variables, with the product measure $dx\,d\theta/(2\pi)$.
The normalized dilations $D_rf(x)=r^{-2}f(x/r)$ satisfy $\|D_rf-f\|_1\to0$ as $r\to1$. -/
theorem ext_approximation_translation_config {p : ℝ≥0∞} (hp : p = 1 ∨ p = 2)
    {F : ℝ² × AddCircle (2 * π) → ℂ}
    (hF : MemLp F p ((volume : Measure ℝ²).prod AddCircle.haarAddCircle)) :
    Tendsto (fun h : ℝ² => eLpNorm (fun q : ℝ² × AddCircle (2 * π) => F (q.1 - h, q.2) - F q) p
      ((volume : Measure ℝ²).prod AddCircle.haarAddCircle)) (𝓝 0) (𝓝 0) := by
  have hp1 : 1 ≤ p := by rcases hp with rfl | rfl <;> norm_num
  have hpt : p ≠ ⊤ := by rcases hp with rfl | rfl <;> simp
  let T : C(ℝ², C(ℝ² × AddCircle (2 * π), ℝ² × AddCircle (2 * π))) :=
    (ContinuousMap.mk (fun q : ℝ² × (ℝ² × AddCircle (2 * π)) => (q.2.1 - q.1, q.2.2))
      (by fun_prop)).curry
  exact aux_tendsto_eLpNorm_comp_sub T (by ext x <;> simp [T])
    (fun h => (measurePreserving_sub_right volume h).prod (MeasurePreserving.id _)) hp1 hpt hF

/-- **Lemma `ext:approximation`** (continuity of normalized dilations in `L¹`).
Smooth compactly supported functions are dense in $L^p(\mathbb R^2)$ for $p=1,2$.
For these two exponents, translations are continuous:
$$\|f(\cdot-h)-f\|_p\longrightarrow0\qquad(h\to0).$$
For $F\in L^p(\mathbb R^2\times[0,2\pi))$, the same conclusion holds for translation in the
first two variables, with the product measure $dx\,d\theta/(2\pi)$.
The normalized dilations $D_rf(x)=r^{-2}f(x/r)$ satisfy $\|D_rf-f\|_1\to0$ as $r\to1$. -/
theorem ext_approximation_dilation {f : ℝ² → ℂ} (hf : Integrable f volume) :
    Tendsto (fun r : ℝ => eLpNorm (fun x => ((r ^ 2)⁻¹ : ℝ) * f (r⁻¹ • x) - f x) 1 volume)
      (𝓝 1) (𝓝 0) := by
  refine ENNReal.tendsto_nhds_zero.2 fun ε hε => ?_
  have hε3 : ε / 3 ≠ 0 := by simp [hε.ne']
  obtain ⟨g, hgc, hfg, hgcont, hgi⟩ := hf.exists_hasCompactSupport_lintegral_sub_le hε3
  have hg := aux_dil_tendsto_cc hgcont hgc
  have hev := (ENNReal.tendsto_nhds_zero.1 hg) (ε / 3) (by simp [hε.ne'])
  have hpos : Ioi (0 : ℝ) ∈ 𝓝 (1 : ℝ) := Ioi_mem_nhds one_pos
  filter_upwards [hev, hpos] with r hr hr0
  have hr0' : 0 < r := hr0
  have hfgi : Integrable (fun x => f x - g x) volume := hf.sub hgi
  have e : (fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * f (r⁻¹ • x) - f x) =
      (fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * (f (r⁻¹ • x) - g (r⁻¹ • x))) +
      (fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * g (r⁻¹ • x) - g x) + (fun x => -(f x - g x)) := by
    funext x; simp only [Pi.add_apply]; ring
  rw [e, eLpNorm_one_eq_lintegral_enorm]
  calc ∫⁻ x, ‖((fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * (f (r⁻¹ • x) - g (r⁻¹ • x))) +
        (fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * g (r⁻¹ • x) - g x) + (fun x => -(f x - g x))) x‖ₑ
      ≤ ∫⁻ x, (‖(((r ^ 2)⁻¹ : ℝ) : ℂ) * (f (r⁻¹ • x) - g (r⁻¹ • x))‖ₑ +
        ‖(((r ^ 2)⁻¹ : ℝ) : ℂ) * g (r⁻¹ • x) - g x‖ₑ + ‖f x - g x‖ₑ) := by
        refine lintegral_mono fun x => ?_
        simp only [Pi.add_apply]
        refine (enorm_add_le _ _).trans ?_
        rw [enorm_neg]; gcongr; exact enorm_add_le _ _
    _ = (∫⁻ x, ‖(((r ^ 2)⁻¹ : ℝ) : ℂ) * (f (r⁻¹ • x) - g (r⁻¹ • x))‖ₑ) +
        (∫⁻ x, ‖(((r ^ 2)⁻¹ : ℝ) : ℂ) * g (r⁻¹ • x) - g x‖ₑ) + ∫⁻ x, ‖f x - g x‖ₑ := by
        rw [lintegral_add_right' _ hfgi.aestronglyMeasurable.enorm,
          lintegral_add_right' _ ((by fun_prop : Continuous fun x : ℝ² =>
            ‖(((r ^ 2)⁻¹ : ℝ) : ℂ) * g (r⁻¹ • x) - g x‖ₑ).measurable.aemeasurable)]
    _ ≤ ε / 3 + ε / 3 + ε / 3 := by
        have h1 := aux_dil_lintegral hfgi hr0'
        rw [h1]
        gcongr
    _ = ε := ENNReal.add_thirds ε

/-! ### The Gaussian Fourier calculation (`ext:gaussian`) -/

/-- **Lemma `ext:gaussian`** (normalization).
The Gaussian kernels have integral one and satisfy
$$\widehat{\gamma_t}(\xi)=\exp(-\pi t|\xi|^2).$$
If $f$ is bounded and continuous, then $\gamma_t*f(x)\to f(x)$ at every $x$ as $t\downarrow0$.
The convergence is uniform when $f$ is bounded and uniformly continuous. -/
theorem ext_gaussian_integral {t : ℝ} (ht : 0 < t) : ∫ x, gaussKernel t x = 1 := by
  unfold gaussKernel
  rw [integral_const_mul]
  have h := GaussianFourier.integral_rexp_neg_mul_sq_norm (V := ℝ²) (b := π / t) (by positivity)
  simp only [finrank_euclideanSpace_fin] at h
  have e : ∀ x : ℝ², -π * ‖x‖ ^ 2 / t = -(π / t) * ‖x‖ ^ 2 := fun x => by ring
  simp_rw [e, h]
  norm_num
  field_simp

/-- **Lemma `ext:gaussian`** (Fourier transform).
The Gaussian kernels have integral one and satisfy
$$\widehat{\gamma_t}(\xi)=\exp(-\pi t|\xi|^2).$$
If $f$ is bounded and continuous, then $\gamma_t*f(x)\to f(x)$ at every $x$ as $t\downarrow0$.
The convergence is uniform when $f$ is bounded and uniformly continuous. -/
theorem ext_gaussian_fourier {t : ℝ} (ht : 0 < t) (ξ : ℝ²) :
    𝓕 (fun x => (gaussKernel t x : ℂ)) ξ = Complex.exp (-(π * t * ‖ξ‖ ^ 2 : ℝ)) := by
  have hb : 0 < ((π / t : ℝ) : ℂ).re := by rw [Complex.ofReal_re]; positivity
  have h := fourier_gaussian_innerProductSpace (V := ℝ²) hb ξ
  have e : 𝓕 (fun x => (gaussKernel t x : ℂ)) ξ =
      (t⁻¹ : ℂ) * 𝓕 (fun x : ℝ² => Complex.exp (-((π / t : ℝ) : ℂ) * ‖x‖ ^ 2)) ξ := by
    rw [Real.fourier_eq, Real.fourier_eq, ← integral_const_mul]
    congr 1; funext v; unfold gaussKernel
    simp only [Circle.smul_def, smul_eq_mul]
    push_cast
    rw [show -(π : ℂ) * ‖v‖ ^ 2 / t = -(π / t) * ‖v‖ ^ 2 by ring]; ring
  rw [e, h]
  simp only [finrank_euclideanSpace_fin]
  have htc : (t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
  have hpc : (π : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
  push_cast
  rw [show (π : ℂ) / (π / t) = t by field_simp]
  norm_num
  rw [← mul_assoc, inv_mul_cancel₀ htc, one_mul]
  congr 1; field_simp

/-- Auxiliary (for `ext:gaussian`): `γ_1(z) = exp(-π|z|²)`. -/
theorem aux_gauss_one_eq (z : ℝ²) : gaussKernel 1 z = Real.exp (-π * ‖z‖ ^ 2) := by
  simp [gaussKernel]

/-- Auxiliary (for `ext_gaussian_pointwise`, `ext_gaussian_uniform`): `exp(-π|z|²)` is integrable on
`ℝ²`. -/
theorem aux_gauss_integrable : Integrable (fun z : ℝ² => Real.exp (-π * ‖z‖ ^ 2)) volume := by
  have h := ext_gaussian_integral one_pos
  simp_rw [aux_gauss_one_eq] at h
  exact integrable_of_integral_eq_one h

/-- Auxiliary (for `ext_gaussian_pointwise`, `ext_gaussian_uniform`): `∫ exp(-π|z|²) dz = 1`, as a
complex integral. -/
theorem aux_gauss_integral_cplx : ∫ z : ℝ², ((Real.exp (-π * ‖z‖ ^ 2) : ℝ) : ℂ) = 1 := by
  have h := ext_gaussian_integral one_pos
  simp_rw [aux_gauss_one_eq] at h
  rw [integral_complex_ofReal, h]; simp

/-- Auxiliary (for `ext:gaussian`): the substitution `y = √t z`, `(γ_t * f)(x) = ∫ exp(-π|z|²) f(x -
√t z) dz`. -/
theorem aux_gauss_cov {t : ℝ} (ht : 0 < t) (f : ℝ² → ℂ) (x : ℝ²) :
    ∫ y, (gaussKernel t y : ℂ) * f (x - y) =
      ∫ z, ((Real.exp (-π * ‖z‖ ^ 2) : ℝ) : ℂ) * f (x - Real.sqrt t • z) := by
  have hs : 0 < Real.sqrt t := Real.sqrt_pos.2 ht
  have h := Measure.integral_comp_smul (volume : Measure ℝ²)
    (fun y => (gaussKernel t y : ℂ) * f (x - y)) (Real.sqrt t)
  simp only [finrank_euclideanSpace_fin] at h
  have hst : Real.sqrt t ^ 2 = t := Real.sq_sqrt ht.le
  rw [hst, abs_of_pos (inv_pos.2 ht)] at h
  have e : ∀ z : ℝ², (gaussKernel t (Real.sqrt t • z) : ℂ) =
      t⁻¹ * ((Real.exp (-π * ‖z‖ ^ 2) : ℝ) : ℂ) := by
    intro z
    simp only [gaussKernel, norm_smul, Real.norm_eq_abs, abs_of_pos hs, mul_pow, hst]
    push_cast
    congr 3
    have htc : (t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
    field_simp
  simp_rw [e, mul_assoc] at h
  rw [integral_const_mul] at h
  have htc : (t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
  rw [Complex.real_smul] at h
  exact (mul_left_cancel₀ (by simpa using ht.ne') h).symm

/-- Auxiliary (for `ext_gaussian_uniform`): the Gaussian tail `∫_{√t|z| ≥ δ} exp(-π|z|²) dz` tends
to `0` as `t ↓ 0`. -/
theorem aux_gauss_tail {δ : ℝ} (hδ : 0 < δ) :
    Tendsto (fun t : ℝ => ∫ z : ℝ², {z : ℝ² | δ ≤ Real.sqrt t * ‖z‖}.indicator
      (fun z => Real.exp (-π * ‖z‖ ^ 2)) z) (𝓝[>] 0) (𝓝 0) := by
  rw [show (𝓝 (0:ℝ)) = 𝓝 (∫ z : ℝ², (0 : ℝ)) by simp]
  refine tendsto_integral_filter_of_dominated_convergence
    (fun z : ℝ² => Real.exp (-π * ‖z‖ ^ 2)) ?_ ?_ aux_gauss_integrable ?_
  · refine Eventually.of_forall fun t => ?_
    refine (aux_gauss_integrable.indicator ?_).aestronglyMeasurable
    exact measurableSet_le measurable_const (by fun_prop)
  · refine Eventually.of_forall fun t => Eventually.of_forall fun z => ?_
    refine (norm_indicator_le_norm_self _ _).trans ?_
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
  · refine Eventually.of_forall fun z => ?_
    have hs : Tendsto (fun t : ℝ => Real.sqrt t * ‖z‖) (𝓝[>] 0) (𝓝 0) := by
      have := (Real.continuous_sqrt.tendsto 0)
      rw [Real.sqrt_zero] at this
      simpa using (this.mono_left nhdsWithin_le_nhds).mul_const ‖z‖
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [(tendsto_order.1 hs).2 δ hδ] with t ht
    rw [indicator_of_notMem (by simpa using ht)]

/-- **Lemma `ext:gaussian`** (pointwise approximate identity).
The Gaussian kernels have integral one and satisfy
$$\widehat{\gamma_t}(\xi)=\exp(-\pi t|\xi|^2).$$
If $f$ is bounded and continuous, then $\gamma_t*f(x)\to f(x)$ at every $x$ as $t\downarrow0$.
The convergence is uniform when $f$ is bounded and uniformly continuous. -/
theorem ext_gaussian_pointwise {f : ℝ² → ℂ} (hf : Continuous f) (hb : ∃ C, ∀ x, ‖f x‖ ≤ C)
    (x : ℝ²) :
    Tendsto (fun t => ∫ y, (gaussKernel t y : ℂ) * f (x - y)) (𝓝[>] 0) (𝓝 (f x)) := by
  obtain ⟨C, hC⟩ := hb
  have hlim : Tendsto
      (fun t => ∫ z : ℝ², ((Real.exp (-π * ‖z‖ ^ 2) : ℝ) : ℂ) * f (x - Real.sqrt t • z))
      (𝓝[>] 0) (𝓝 (∫ z : ℝ², ((Real.exp (-π * ‖z‖ ^ 2) : ℝ) : ℂ) * f x)) := by
    refine tendsto_integral_filter_of_dominated_convergence
      (fun z : ℝ² => Real.exp (-π * ‖z‖ ^ 2) * C) ?_ ?_ (aux_gauss_integrable.mul_const C) ?_
    · exact Eventually.of_forall fun t => (by fun_prop : Continuous fun z : ℝ² =>
        ((Real.exp (-π * ‖z‖ ^ 2) : ℝ) : ℂ) * f (x - Real.sqrt t • z)).aestronglyMeasurable
    · refine Eventually.of_forall fun t => Eventually.of_forall fun z => ?_
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact mul_le_mul_of_nonneg_left (hC _) (Real.exp_pos _).le
    · refine Eventually.of_forall fun z => ?_
      have hs : Tendsto (fun t : ℝ => Real.sqrt t) (𝓝[>] 0) (𝓝 0) := by
        have := (Real.continuous_sqrt.tendsto 0)
        rw [Real.sqrt_zero] at this
        exact this.mono_left nhdsWithin_le_nhds
      have : Tendsto (fun t : ℝ => f (x - Real.sqrt t • z)) (𝓝[>] 0) (𝓝 (f (x - (0:ℝ) • z))) :=
        (hf.tendsto _).comp (tendsto_const_nhds.sub (hs.smul_const z))
      simp only [zero_smul, sub_zero] at this
      exact this.const_mul _
  rw [integral_mul_const, aux_gauss_integral_cplx, one_mul] at hlim
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with t (ht : 0 < t)
  exact (aux_gauss_cov ht f x).symm

/-- **Lemma `ext:gaussian`** (uniform approximate identity).
The Gaussian kernels have integral one and satisfy
$$\widehat{\gamma_t}(\xi)=\exp(-\pi t|\xi|^2).$$
If $f$ is bounded and continuous, then $\gamma_t*f(x)\to f(x)$ at every $x$ as $t\downarrow0$.
The convergence is uniform when $f$ is bounded and uniformly continuous. -/
theorem ext_gaussian_uniform {f : ℝ² → ℂ} (hf : UniformContinuous f)
    (hb : ∃ C, ∀ x, ‖f x‖ ≤ C) :
    TendstoUniformly (fun t x => ∫ y, (gaussKernel t y : ℂ) * f (x - y)) f (𝓝[>] 0) := by
  obtain ⟨C, hC⟩ := hb
  have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 0)
  rw [Metric.tendstoUniformly_iff]
  intro ε hε
  obtain ⟨δ, hδ, hfδ⟩ := Metric.uniformContinuous_iff.1 hf (ε / 2) (by positivity)
  have htail := (tendsto_order.1 (aux_gauss_tail hδ)).2 (ε / 2 / (2 * C + 1)) (by positivity)
  filter_upwards [htail, self_mem_nhdsWithin] with t ht (htpos : 0 < t) x
  set S := {z : ℝ² | δ ≤ Real.sqrt t * ‖z‖}
  have hS : MeasurableSet S := measurableSet_le measurable_const (by fun_prop)
  set G := fun z : ℝ² => Real.exp (-π * ‖z‖ ^ 2)
  rw [aux_gauss_cov htpos, dist_eq_norm]
  have e : f x - ∫ z, ((G z : ℝ) : ℂ) * f (x - Real.sqrt t • z) =
      ∫ z, ((G z : ℝ) : ℂ) * (f x - f (x - Real.sqrt t • z)) := by
    have hi1 : Integrable (fun z => ((G z : ℝ) : ℂ) * f x) volume :=
      (aux_gauss_integrable.ofReal).mul_const _
    have hi2 : Integrable (fun z => ((G z : ℝ) : ℂ) * f (x - Real.sqrt t • z)) volume := by
      refine Integrable.mono' (aux_gauss_integrable.mul_const C)
        (by fun_prop : Continuous fun z : ℝ² =>
          ((G z : ℝ) : ℂ) * f (x - Real.sqrt t • z)).aestronglyMeasurable ?_
      refine Eventually.of_forall fun z => ?_
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact mul_le_mul_of_nonneg_left (hC _) (Real.exp_pos _).le
    simp_rw [mul_sub]
    rw [integral_sub hi1 hi2, integral_mul_const, aux_gauss_integral_cplx, one_mul]
  rw [e]
  have hbound : ∀ z, ‖((G z : ℝ) : ℂ) * (f x - f (x - Real.sqrt t • z))‖ ≤
      G z * (ε / 2) + 2 * C * S.indicator G z := by
    intro z
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    have hG := Real.exp_pos (-π * ‖z‖ ^ 2)
    by_cases hz : z ∈ S
    · rw [indicator_of_mem hz]
      have : ‖f x - f (x - Real.sqrt t • z)‖ ≤ 2 * C :=
        (norm_sub_le _ _).trans (by linarith [hC x, hC (x - Real.sqrt t • z)])
      nlinarith
    · rw [indicator_of_notMem hz]
      have hz' : Real.sqrt t * ‖z‖ < δ := by simpa [S] using hz
      have hd : dist x (x - Real.sqrt t • z) < δ := by
        rw [dist_eq_norm, sub_sub_cancel, norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (Real.sqrt_nonneg _)]
        exact hz'
      have := hfδ hd
      rw [dist_eq_norm] at this
      nlinarith
  have hint : Integrable (fun z => G z * (ε / 2) + 2 * C * S.indicator G z) volume :=
    (aux_gauss_integrable.mul_const _).add ((aux_gauss_integrable.indicator hS).const_mul _)
  calc ‖∫ z, ((G z : ℝ) : ℂ) * (f x - f (x - Real.sqrt t • z))‖
      ≤ ∫ z, (G z * (ε / 2) + 2 * C * S.indicator G z) :=
        norm_integral_le_of_norm_le hint (Eventually.of_forall hbound)
    _ = ε / 2 + 2 * C * ∫ z, S.indicator G z := by
        rw [integral_add (aux_gauss_integrable.mul_const _)
          ((aux_gauss_integrable.indicator hS).const_mul _), integral_mul_const,
          integral_const_mul]
        have h1 := ext_gaussian_integral one_pos
        simp_rw [aux_gauss_one_eq] at h1
        rw [h1, one_mul]
    _ < ε := by
        have h2 : 2 * C * ∫ z, S.indicator G z ≤ 2 * C * (ε / 2 / (2 * C + 1)) :=
          mul_le_mul_of_nonneg_left ht.le (by positivity)
        have h3 : 2 * C * (ε / 2 / (2 * C + 1)) < ε / 2 := by
          rw [mul_div_assoc']
          rw [div_lt_iff₀ (by positivity)]
          nlinarith
        linarith

/-! ### Fourier inversion and Plancherel (`ext:fourier`) -/

/-- **Lemma `ext:fourier`** (the transform maps `𝒮` into `𝒮`).
The Fourier transform maps $\mathcal S(\mathbb R^2)$ onto itself, and
$$f(x)=\int\widehat f(\xi)\exp(2\pi i x\cdot\xi)\,d\xi\qquad(f\in\mathcal S).$$
For $f,g\in\mathcal S$,
$$\int\widehat f(\xi)\overline{\widehat g(\xi)}\,d\xi=\int f(x)\overline{g(x)}\,dx.$$
Consequently the Fourier transform extends uniquely to a unitary operator on
$L^2(\mathbb R^2)$. -/
theorem ext_fourier_maps (f : 𝓢(ℝ², ℂ)) : ∃ g : 𝓢(ℝ², ℂ), ⇑g = 𝓕 ⇑f :=
  ⟨𝓕 f, SchwartzMap.fourier_coe f⟩

/-- **Lemma `ext:fourier`** (the transform maps `𝒮` onto `𝒮`).
The Fourier transform maps $\mathcal S(\mathbb R^2)$ onto itself, and
$$f(x)=\int\widehat f(\xi)\exp(2\pi i x\cdot\xi)\,d\xi\qquad(f\in\mathcal S).$$
For $f,g\in\mathcal S$,
$$\int\widehat f(\xi)\overline{\widehat g(\xi)}\,d\xi=\int f(x)\overline{g(x)}\,dx.$$
Consequently the Fourier transform extends uniquely to a unitary operator on
$L^2(\mathbb R^2)$. -/
theorem ext_fourier_onto (g : 𝓢(ℝ², ℂ)) : ∃ f : 𝓢(ℝ², ℂ), 𝓕 ⇑f = ⇑g :=
  ⟨𝓕⁻ g, by rw [← SchwartzMap.fourier_coe, FourierInvPair.fourier_fourierInv_eq]⟩

/-- **Lemma `ext:fourier`** (inversion formula).
The Fourier transform maps $\mathcal S(\mathbb R^2)$ onto itself, and
$$f(x)=\int\widehat f(\xi)\exp(2\pi i x\cdot\xi)\,d\xi\qquad(f\in\mathcal S).$$
For $f,g\in\mathcal S$,
$$\int\widehat f(\xi)\overline{\widehat g(\xi)}\,d\xi=\int f(x)\overline{g(x)}\,dx.$$
Consequently the Fourier transform extends uniquely to a unitary operator on
$L^2(\mathbb R^2)$. -/
theorem ext_fourier_inversion (f : 𝓢(ℝ², ℂ)) (x : ℝ²) :
    f x = ∫ ξ, 𝓕 (⇑f) ξ * Complex.exp ((2 * π * ⟪x, ξ⟫_ℝ : ℝ) * Complex.I) := by
  rw [← aux_fourierInv_convention, ← SchwartzMap.fourier_coe, ← SchwartzMap.fourierInv_coe,
    FourierPair.fourierInv_fourier_eq]

/-- **Lemma `ext:fourier`** (Plancherel identity on `𝒮`).
The Fourier transform maps $\mathcal S(\mathbb R^2)$ onto itself, and
$$f(x)=\int\widehat f(\xi)\exp(2\pi i x\cdot\xi)\,d\xi\qquad(f\in\mathcal S).$$
For $f,g\in\mathcal S$,
$$\int\widehat f(\xi)\overline{\widehat g(\xi)}\,d\xi=\int f(x)\overline{g(x)}\,dx.$$
Consequently the Fourier transform extends uniquely to a unitary operator on
$L^2(\mathbb R^2)$. -/
theorem ext_fourier_plancherel (f g : 𝓢(ℝ², ℂ)) :
    ∫ ξ, 𝓕 (⇑f) ξ * conj (𝓕 (⇑g) ξ) = ∫ x, f x * conj (g x) := by
  have h := SchwartzMap.integral_inner_fourier_fourier g f
  simp only [RCLike.inner_apply, ← SchwartzMap.fourier_coe] at h ⊢
  simpa [mul_comm] using h

/-- **Lemma `ext:fourier`** (unitary extension to `L²`; uniqueness among bounded operators).
The Fourier transform maps $\mathcal S(\mathbb R^2)$ onto itself, and
$$f(x)=\int\widehat f(\xi)\exp(2\pi i x\cdot\xi)\,d\xi\qquad(f\in\mathcal S).$$
For $f,g\in\mathcal S$,
$$\int\widehat f(\xi)\overline{\widehat g(\xi)}\,d\xi=\int f(x)\overline{g(x)}\,dx.$$
Consequently the Fourier transform extends uniquely to a unitary operator on
$L^2(\mathbb R^2)$. -/
theorem ext_fourier_unitary :
    ∃ U : Lp ℂ 2 (volume : Measure ℝ²) ≃ₗᵢ[ℂ] Lp ℂ 2 (volume : Measure ℝ²),
      (∀ f : 𝓢(ℝ², ℂ), U (f.toLp 2) = (𝓕 f).toLp 2) ∧
      ∀ T : Lp ℂ 2 (volume : Measure ℝ²) →L[ℂ] Lp ℂ 2 (volume : Measure ℝ²),
        (∀ f : 𝓢(ℝ², ℂ), T (f.toLp 2) = (𝓕 f).toLp 2) → ∀ g, T g = U g := by
  refine ⟨MeasureTheory.Lp.fourierTransformₗᵢ ℝ² ℂ, fun f => SchwartzMap.toLp_fourier_eq f,
    fun T hT g => ?_⟩
  have hd := SchwartzMap.denseRange_toLpCLM (E := ℝ²) (F := ℂ) (p := 2)
    (μ := volume) ENNReal.ofNat_ne_top
  have : (T : Lp ℂ 2 (volume : Measure ℝ²) → Lp ℂ 2 (volume : Measure ℝ²)) =
      MeasureTheory.Lp.fourierTransformₗᵢ ℝ² ℂ := by
    refine hd.equalizer T.continuous (LinearIsometryEquiv.continuous _) (funext fun f => ?_)
    simp only [Function.comp_apply, SchwartzMap.toLpCLM_apply]
    rw [hT f]
    exact (SchwartzMap.toLp_fourier_eq f).symm
  exact congrFun this g

/-! ### Uniqueness for finite measures (`ext:fourier-uniqueness`) -/

/-- Auxiliary (for `ext:fourier-uniqueness`, see `ext_fourier_uniqueness`): for a presentation `ν =
φ_*(w·m)` and `c ∈ {Re, -Re, Im, -Im}`, the finite positive measure `φ_*(c(w)⁺ · m)`; `ν` is the
combination `(P_Re - P_{-Re}) + i (P_Im - P_{-Im})` of these (`aux_integral_decomp`). -/
@[nolint defsWithUnderscore]
def aux_part (ν : FCMeasure) (c : ℂ → ℝ) : Measure ℝ² :=
  (ν.m.withDensity fun z => ((c (ν.w z)).toNNReal : ℝ≥0∞)).map ν.φ

/-- Auxiliary (for `ext_fourier_uniqueness`): `aux_part ν c` is a finite measure when
`|c w| ≤ |w|`. -/
theorem aux_part_finite (ν : FCMeasure) {c : ℂ → ℝ} (hc : ∀ w, |c w| ≤ ‖w‖) :
    IsFiniteMeasure (aux_part ν c) := by
  unfold aux_part
  have : IsFiniteMeasure (ν.m.withDensity fun z => ((c (ν.w z)).toNNReal : ℝ≥0∞)) := by
    refine isFiniteMeasure_withDensity (ne_top_of_le_ne_top ν.integrable_w.2.ne ?_)
    refine lintegral_mono fun z => ?_
    rw [← ofReal_norm]
    simp only [ENNReal.ofNNReal_toNNReal]
    exact ENNReal.ofReal_le_ofReal ((le_abs_self _).trans (hc _))
  infer_instance

/-- Auxiliary (for `ext_fourier_uniqueness`): integration against `aux_part ν c`. -/
theorem aux_part_integral (ν : FCMeasure) {c : ℂ → ℝ} (hcm : Measurable c) {g : ℝ² → ℂ}
    (hg : Measurable g) :
    ∫ x, g x ∂aux_part ν c = ∫ z, g (ν.φ z) * (((c (ν.w z)).toNNReal : ℝ) : ℂ) ∂ν.m := by
  unfold aux_part
  rw [integral_map ν.measurable_φ.aemeasurable hg.aestronglyMeasurable,
    integral_withDensity_eq_integral_smul₀ (f := fun z => (c (ν.w z)).toNNReal)
      (hcm.comp_aemeasurable ν.integrable_w.aestronglyMeasurable.aemeasurable).real_toNNReal]
  congr 1; funext z
  rw [NNReal.smul_def, Complex.real_smul, mul_comm]

/-- Auxiliary (for `ext_fourier_uniqueness`): the Jordan-type decomposition `∫ g dν = (∫ g dP_Re - ∫
g dP_{-Re}) + i (∫ g dP_Im - ∫ g dP_{-Im})` for bounded measurable `g`. -/
theorem aux_integral_decomp (ν : FCMeasure) {g : ℝ² → ℂ} (hg : Measurable g) {M : ℝ}
    (hM : ∀ x, ‖g x‖ ≤ M) :
    ν.integral g = (∫ x, g x ∂aux_part ν (fun w => w.re) - ∫ x, g x ∂aux_part ν (fun w => -w.re))
      + Complex.I * (∫ x, g x ∂aux_part ν (fun w => w.im) -
        ∫ x, g x ∂aux_part ν (fun w => -w.im)) := by
  have hint : ∀ {c : ℂ → ℝ}, Measurable c → (∀ w, |c w| ≤ ‖w‖) →
      Integrable (fun z => g (ν.φ z) * (((c (ν.w z)).toNNReal : ℝ) : ℂ)) ν.m := by
    intro c hcm hc
    refine Integrable.mono' (ν.integrable_w.norm.const_mul M) ?_ ?_
    · have hwm := ν.integrable_w.aestronglyMeasurable.aemeasurable
      have hφ := ν.measurable_φ
      exact (by fun_prop : AEMeasurable (fun z => g (ν.φ z) * (((c (ν.w z)).toNNReal : ℝ) : ℂ))
        ν.m).aestronglyMeasurable
    · refine Eventually.of_forall fun z => ?_
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (NNReal.coe_nonneg _)]
      refine mul_le_mul (hM _) ?_ (NNReal.coe_nonneg _) ((norm_nonneg _).trans (hM (ν.φ z)))
      rw [Real.coe_toNNReal']
      exact max_le ((le_abs_self _).trans (hc _)) (norm_nonneg _)
  have h1 := hint (c := fun w => w.re) Complex.measurable_re (fun w => Complex.abs_re_le_norm w)
  have h2 := hint (c := fun w => -w.re) Complex.measurable_re.neg
    (fun w => by rw [abs_neg]; exact Complex.abs_re_le_norm w)
  have h3 := hint (c := fun w => w.im) Complex.measurable_im (fun w => Complex.abs_im_le_norm w)
  have h4 := hint (c := fun w => -w.im) Complex.measurable_im.neg
    (fun w => by rw [abs_neg]; exact Complex.abs_im_le_norm w)
  rw [aux_part_integral ν (c := fun w => w.re) Complex.measurable_re hg,
    aux_part_integral ν (c := fun w => -w.re) Complex.measurable_re.neg hg,
    aux_part_integral ν (c := fun w => w.im) Complex.measurable_im hg,
    aux_part_integral ν (c := fun w => -w.im) Complex.measurable_im.neg hg,
    ← integral_sub h1 h2, ← integral_sub h3 h4, ← integral_const_mul, ← integral_add]
  rotate_left
  · exact h1.sub h2
  · exact (h3.sub h4).const_mul _
  unfold FCMeasure.integral
  congr 1; funext z
  have key : ∀ x : ℝ, ((x.toNNReal : ℝ) : ℂ) - (((-x).toNNReal : ℝ) : ℂ) = x := by
    intro x
    rw [Real.coe_toNNReal', Real.coe_toNNReal']
    rcases le_total x 0 with h | h
    · rw [max_eq_right h, max_eq_left (by linarith)]; push_cast; ring
    · rw [max_eq_left h, max_eq_right (by linarith)]; push_cast; ring
  have e : ν.w z = (((ν.w z).re.toNNReal : ℝ) : ℂ) - ((((-(ν.w z).re)).toNNReal : ℝ) : ℂ) +
      Complex.I * ((((ν.w z).im.toNNReal : ℝ) : ℂ) - ((((-(ν.w z).im)).toNNReal : ℝ) : ℂ)) := by
    rw [key, key, mul_comm]; exact (Complex.re_add_im _).symm
  conv_lhs => rw [e]
  ring

/-- Auxiliary (for `ext_fourier_uniqueness`): finiteness of `aux_part ν Re`. -/
theorem aux_part_finite_re (ν : FCMeasure) : IsFiniteMeasure (aux_part ν (fun w => w.re)) :=
  aux_part_finite ν fun w => Complex.abs_re_le_norm w

/-- Auxiliary (for `ext_fourier_uniqueness`): finiteness of `aux_part ν (-Re)`. -/
theorem aux_part_finite_neg_re (ν : FCMeasure) : IsFiniteMeasure (aux_part ν (fun w => -w.re)) :=
  aux_part_finite ν fun w => by rw [abs_neg]; exact Complex.abs_re_le_norm w

/-- Auxiliary (for `ext_fourier_uniqueness`): finiteness of `aux_part ν Im`. -/
theorem aux_part_finite_im (ν : FCMeasure) : IsFiniteMeasure (aux_part ν (fun w => w.im)) :=
  aux_part_finite ν fun w => Complex.abs_im_le_norm w

/-- Auxiliary (for `ext_fourier_uniqueness`): finiteness of `aux_part ν (-Im)`. -/
theorem aux_part_finite_neg_im (ν : FCMeasure) : IsFiniteMeasure (aux_part ν (fun w => -w.im)) :=
  aux_part_finite ν fun w => by rw [abs_neg]; exact Complex.abs_im_le_norm w

/-- Auxiliary (for `ext_fourier_uniqueness`): `∫ g dν - ∫ g dκ` written through four finite positive
measures. -/
theorem aux_integral_sub_decomp (ν κ : FCMeasure) {g : ℝ² → ℂ} (hg : Measurable g) {M : ℝ}
    (hM : ∀ x, ‖g x‖ ≤ M) :
    ν.integral g - κ.integral g =
      (∫ x, g x ∂(aux_part ν (fun w => w.re) + aux_part κ (fun w => -w.re)) -
        ∫ x, g x ∂(aux_part ν (fun w => -w.re) + aux_part κ (fun w => w.re))) +
      Complex.I * (∫ x, g x ∂(aux_part ν (fun w => w.im) + aux_part κ (fun w => -w.im)) -
        ∫ x, g x ∂(aux_part ν (fun w => -w.im) + aux_part κ (fun w => w.im))) := by
  have := aux_part_finite_re ν; have := aux_part_finite_neg_re ν
  have := aux_part_finite_im ν; have := aux_part_finite_neg_im ν
  have := aux_part_finite_re κ; have := aux_part_finite_neg_re κ
  have := aux_part_finite_im κ; have := aux_part_finite_neg_im κ
  have hi : ∀ (μ : Measure ℝ²) [IsFiniteMeasure μ], Integrable g μ := fun μ _ =>
    Integrable.of_bound hg.aestronglyMeasurable M (Eventually.of_forall hM)
  rw [aux_integral_decomp ν hg hM, aux_integral_decomp κ hg hM,
    integral_add_measure (hi _) (hi _), integral_add_measure (hi _) (hi _),
    integral_add_measure (hi _) (hi _), integral_add_measure (hi _) (hi _)]
  ring

/-- Auxiliary (for `ext_fourier_uniqueness_dense`): the points of `ℝ²` with rational coordinates are
dense. -/
theorem aux_dense_rat_points :
    Dense {s : ℝ² | ∀ i, s i ∈ Set.range ((↑) : ℚ → ℝ)} := by
  have h : Dense (Set.pi univ fun _ : Fin 2 => Set.range ((↑) : ℚ → ℝ)) :=
    dense_pi _ fun _ _ => Rat.denseRange_cast
  have := h.preimage (EuclideanSpace.equiv (Fin 2) ℝ).toHomeomorph.isOpenMap
  convert this using 1
  ext s
  simp only [Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_pi, Set.mem_univ, true_implies]
  rfl

/-- Auxiliary (for `ext_fourier_uniqueness_dense`): the character `ξ ↦ exp(2πi s·ξ)` lies in `L²(ν)`
for a finite measure `ν`. -/
theorem aux_char_memLp (ν : Measure ℝ²) [IsFiniteMeasure ν] (s : ℝ²) :
    MemLp (fun ξ : ℝ² => Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I)) 2 ν :=
  MemLp.of_bound (by fun_prop : Continuous fun ξ : ℝ² =>
      Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I)).aestronglyMeasurable 1
    (Eventually.of_forall fun ξ => by rw [Complex.norm_exp_ofReal_mul_I])

/-- **Lemma `ext:fourier-uniqueness`** (uniqueness).  Two finite complex measures with the same
Fourier transform give the same mass to every Borel set.
A finite complex Borel measure on $\mathbb R^2$ is determined by its Fourier transform.
In particular, if $\nu$ is a finite positive measure, the characters
$\xi\mapsto\exp(2\pi i s\cdot\xi)$ with $s\in\mathbb Q^2$ span a dense subspace of $L^2(\nu)$. -/
theorem ext_fourier_uniqueness (ν κ : FCMeasure) (h : ν.fourier = κ.fourier) {A : Set ℝ²}
    (hA : MeasurableSet A) : ν.integral (A.indicator 1) = κ.integral (A.indicator 1) := by
  have := aux_part_finite_re ν; have := aux_part_finite_neg_re ν
  have := aux_part_finite_im ν; have := aux_part_finite_neg_im ν
  have := aux_part_finite_re κ; have := aux_part_finite_neg_re κ
  have := aux_part_finite_im κ; have := aux_part_finite_neg_im κ
  set μ₁ := aux_part ν (fun w => w.re) + aux_part κ (fun w => -w.re)
  set μ₂ := aux_part ν (fun w => -w.re) + aux_part κ (fun w => w.re)
  set μ₃ := aux_part ν (fun w => w.im) + aux_part κ (fun w => -w.im)
  set μ₄ := aux_part ν (fun w => -w.im) + aux_part κ (fun w => w.im)
  -- the characteristic-function identity
  have hchar : ∀ t : ℝ², (charFun μ₁ t - charFun μ₂ t) + Complex.I * (charFun μ₃ t - charFun μ₄ t)
      = 0 := by
    intro t
    have hg : Measurable fun x : ℝ² => Complex.exp (⟪x, t⟫_ℝ * Complex.I) := by fun_prop
    have hM : ∀ x : ℝ², ‖Complex.exp (⟪x, t⟫_ℝ * Complex.I)‖ ≤ 1 := fun x => by
      rw [Complex.norm_exp_ofReal_mul_I]
    have e := aux_integral_sub_decomp ν κ hg hM
    simp only [← charFun_apply] at e
    rw [← e, sub_eq_zero]
    have hξ := congrFun h (-(2 * π)⁻¹ • t)
    unfold FCMeasure.fourier at hξ
    convert hξ using 3 <;> (rw [inner_smul_right]; congr 1; push_cast; field_simp)
  have hPQ : μ₁ = μ₂ := by
    refine Measure.ext_of_charFun (funext fun t => ?_)
    have h1 := hchar t
    have h2 := hchar (-t)
    simp only [charFun_neg] at h2
    have h3 := congrArg conj h2
    simp only [map_add, map_mul, map_sub, Complex.conj_conj, Complex.conj_I, map_zero] at h3
    linear_combination (h1 + h3) / 2
  have hRS : μ₃ = μ₄ := by
    refine Measure.ext_of_charFun (funext fun t => ?_)
    have h1 := hchar t
    have h2 := hchar (-t)
    simp only [charFun_neg] at h2
    have h3 := congrArg conj h2
    simp only [map_add, map_mul, map_sub, Complex.conj_conj, Complex.conj_I, map_zero] at h3
    have : Complex.I * (charFun μ₃ t - charFun μ₄ t) = 0 := by linear_combination (h1 - h3) / 2
    simpa [sub_eq_zero, Complex.I_ne_zero] using this
  have hgm : Measurable (A.indicator (1 : ℝ² → ℂ)) := measurable_const.indicator hA
  have hgM : ∀ x, ‖A.indicator (1 : ℝ² → ℂ) x‖ ≤ 1 := fun x => by
    by_cases hx : x ∈ A <;> simp [hx]
  have e := aux_integral_sub_decomp ν κ hgm hgM
  rw [← sub_eq_zero, e]
  change ((∫ x, A.indicator (1 : ℝ² → ℂ) x ∂μ₁) - (∫ x, A.indicator (1 : ℝ² → ℂ) x ∂μ₂)) +
    Complex.I * ((∫ x, A.indicator (1 : ℝ² → ℂ) x ∂μ₃) - (∫ x, A.indicator (1 : ℝ² → ℂ) x ∂μ₄))
      = 0
  rw [hPQ, hRS]; simp

/-- **Lemma `ext:fourier-uniqueness`** (density of rational characters in `L²(ν)`).
A finite complex Borel measure on $\mathbb R^2$ is determined by its Fourier transform.
In particular, if $\nu$ is a finite positive measure, the characters
$\xi\mapsto\exp(2\pi i s\cdot\xi)$ with $s\in\mathbb Q^2$ span a dense subspace of $L^2(\nu)$. -/
theorem ext_fourier_uniqueness_dense (ν : Measure ℝ²) [IsFiniteMeasure ν] {g : ℝ² → ℂ}
    (hg : MemLp g 2 ν) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ (S : Finset ℝ²) (c : ℝ² → ℂ), (∀ s ∈ S, ∀ i, s i ∈ Set.range ((↑) : ℚ → ℝ)) ∧
      eLpNorm (fun ξ => g ξ - ∑ s ∈ S, c s * Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I))
        2 ν < ε := by
  set Q := {s : ℝ² | ∀ i, s i ∈ Set.range ((↑) : ℚ → ℝ)}
  set e : ℝ² → ℝ² → ℂ := fun s ξ => Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I)
  set E : ℝ² → Lp ℂ 2 ν := fun s => (aux_char_memLp ν s).toLp (e s)
  set V : Submodule ℂ (Lp ℂ 2 ν) := Submodule.span ℂ (E '' Q)
  -- the orthogonal complement is trivial
  have hV : Vᗮ = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro h hh
    have hint : Integrable h ν := (Lp.memLp h).integrable one_le_two
    let η : FCMeasure := FCMeasure.mk (Z := ℝ²) (m := ν) (w := h) (φ := id) measurable_id hint
    have hcont : Continuous η.fourier := by
      unfold FCMeasure.fourier FCMeasure.integral
      refine continuous_of_dominated (bound := fun x => ‖h x‖) (fun ξ => ?_) (fun ξ => ?_)
        hint.norm (Eventually.of_forall fun x => by fun_prop)
      · exact ((by fun_prop : Continuous fun x : ℝ² =>
          Complex.exp (-(2 * π * ⟪id x, ξ⟫_ℝ : ℝ) * Complex.I)).aestronglyMeasurable.mul
          hint.aestronglyMeasurable)
      · refine Eventually.of_forall fun x => ?_
        have h1 : ∀ y : ℝ, ‖Complex.exp (-(y : ℂ) * Complex.I)‖ = 1 := fun y => by
          rw [← Complex.ofReal_neg, Complex.norm_exp_ofReal_mul_I]
        rw [norm_mul, h1, one_mul]
    have hzero_on : ∀ s ∈ Q, η.fourier s = 0 := by
      intro s hs
      have h0 := Submodule.inner_right_of_mem_orthogonal
        (Submodule.subset_span (Set.mem_image_of_mem E hs)) hh
      rw [MeasureTheory.L2.inner_def] at h0
      rw [← h0]
      unfold FCMeasure.fourier FCMeasure.integral
      refine integral_congr_ae ?_
      filter_upwards [(aux_char_memLp ν s).coeFn_toLp] with x hx
      simp only [E, RCLike.inner_apply, e]
      simp only at hx
      rw [hx, ← Complex.exp_conj, mul_comm]
      change h x * Complex.exp (-(↑(2 * π * ⟪x, s⟫_ℝ)) * Complex.I) = h x * _
      congr 2
      simp [Complex.conj_ofReal, real_inner_comm, map_ofNat]
    have hzero : ∀ ξ, η.fourier ξ = 0 := by
      intro ξ
      have := hcont.ext_on aux_dense_rat_points continuous_const hzero_on
      exact congrFun this ξ
    let ζ : FCMeasure := FCMeasure.ofMeasure 0
    have hζ : ∀ g : ℝ² → ℂ, ζ.integral g = 0 := fun g => by
      simp only [ζ, FCMeasure.integral, FCMeasure.ofMeasure]
      exact MeasureTheory.integral_zero_measure _
    have hfe : η.fourier = ζ.fourier := funext fun ξ => by
      rw [hzero, FCMeasure.fourier, hζ]
    have hset : ∀ A, MeasurableSet A → ν A < ∞ → ∫ x in A, h x ∂ν = 0 := by
      intro A hA _
      have := ext_fourier_uniqueness η ζ hfe hA
      rw [hζ] at this
      rw [← this, ← integral_indicator hA]
      unfold FCMeasure.integral
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      by_cases hx : x ∈ A <;> simp [η, hx]
    have := hint.ae_eq_zero_of_forall_setIntegral_eq_zero hset
    exact (Lp.eq_zero_iff_ae_eq_zero).2 this
  have hdense : V.topologicalClosure = ⊤ := Submodule.topologicalClosure_eq_top_iff.2 hV
  have hmem : hg.toLp g ∈ closure (V : Set (Lp ℂ 2 ν)) := by
    rw [← Submodule.topologicalClosure_coe, hdense]; trivial
  obtain ⟨v, hvV, hv⟩ := EMetric.mem_closure_iff.1 hmem ε hε
  obtain ⟨l, hl, rfl⟩ := (Finsupp.mem_span_image_iff_linearCombination ℂ).1 hvV
  refine ⟨l.support, l, fun s hs => hl hs, ?_⟩
  rw [Lp.edist_def] at hv
  refine lt_of_eq_of_lt (eLpNorm_congr_ae ?_) hv
  have hsum : ∀ S : Finset ℝ², ⇑(∑ s ∈ S, l s • E s) =ᵐ[ν] fun ξ => ∑ s ∈ S, l s * e s ξ := by
    intro S
    induction S using Finset.induction_on with
    | empty => simp only [Finset.sum_empty]; exact Lp.coeFn_zero ℂ 2 ν
    | insert a S ha ih =>
      simp only [Finset.sum_insert ha]
      filter_upwards [Lp.coeFn_add (l a • E a) (∑ s ∈ S, l s • E s), Lp.coeFn_smul (l a) (E a),
        (aux_char_memLp ν a).coeFn_toLp, ih] with x h1 h2 h3 h4
      rw [h1, Pi.add_apply, h2, Pi.smul_apply, h4]
      simp only at h3
      rw [h3, smul_eq_mul]
  filter_upwards [hg.coeFn_toLp, hsum l.support] with x h1 h2
  rw [Pi.sub_apply, h1, Finsupp.linearCombination_apply, Finsupp.sum, h2]

/-! ### Fourier support (`ext:bounded-support`) -/

/-- Fourier support of a bounded function, test-function version (`\label{ext:bounded-support}`):
for a compact `K`, a bounded measurable `g` has Fourier support in `K` if
`∫ g φ̂ = 0` for every `φ ∈ C_c^∞(ℝ²)` with `supp φ ∩ K = ∅`.

For a compact set $K\subset\mathbb R^2$, a bounded measurable function $g$ has Fourier support
in $K$ if
$$\int_{\mathbb R^2}g(x)\widehat\varphi(x)\,dx=0\quad\text{for every }
\varphi\in C_c^\infty(\mathbb R^2)\text{ with }\operatorname{supp}\varphi\cap K=\varnothing.$$
(The `L²` notion is `HasL2FourierSupportIn`; their agreement on `L² ∩ L^∞` is
`ext_reproduction_agree`.) -/
def HasFourierSupportIn (K : Set ℝ²) (g : ℝ² → ℂ) : Prop :=
  ∀ φ : ℝ² → ℂ, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ → Disjoint (tsupport φ) K →
    ∫ x, g x * 𝓕 φ x = 0

/-- Fourier support of an `L²` function (`\label{ext:bounded-support}`): for an $L^2$ function,
Fourier support in $K$ means that its $L^2$ Fourier transform (Mathlib's `𝓕` on `Lp ℂ 2`)
vanishes almost everywhere outside $K$.  (The test-function notion for bounded functions is
`HasFourierSupportIn`.) -/
def HasL2FourierSupportIn (K : Set ℝ²) (g : Lp ℂ 2 (volume : Measure ℝ²)) : Prop :=
  ∀ᵐ ξ ∂(volume : Measure ℝ²), ξ ∉ K → (𝓕 g : Lp ℂ 2 (volume : Measure ℝ²)) ξ = 0

/-! ### Reproduction of an input with compact Fourier support (`ext:reproduction`) -/

/-- Auxiliary (for `ext:reproduction`): for `g ∈ L²` and Schwartz `φ`, `∫ g φ̂ = ∫ φ ĝ` with the
`L²` Fourier transform `ĝ` (via Mathlib's tempered distributions). -/
theorem aux_parseval_L2 {g : ℝ² → ℂ} (hg : MemLp g 2 volume) (φ : 𝓢(ℝ², ℂ)) :
    ∫ x, g x * 𝓕 (⇑φ) x = ∫ ξ, φ ξ * (𝓕 (hg.toLp g) : Lp ℂ 2 (volume : Measure ℝ²)) ξ := by
  have h := congrArg (fun T : 𝓢'(ℝ², ℂ) => T φ)
    (MeasureTheory.Lp.fourier_toTemperedDistribution_eq (hg.toLp g))
  simp only [TemperedDistribution.fourier_apply, Lp.toTemperedDistribution_apply,
    smul_eq_mul] at h
  rw [← h]
  refine integral_congr_ae ?_
  filter_upwards [hg.coeFn_toLp] with x hx
  rw [hx, SchwartzMap.fourier_coe, mul_comm]

/-- Auxiliary (for `ext_reproduction_agree`): `aux_parseval_L2` for smooth compactly supported
`φ`. -/
theorem aux_parseval_cc {g : ℝ² → ℂ} (hg : MemLp g 2 volume) {φ : ℝ² → ℂ}
    (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) (hφc : HasCompactSupport φ) :
    ∫ x, g x * 𝓕 φ x = ∫ ξ, φ ξ * (𝓕 (hg.toLp g) : Lp ℂ 2 (volume : Measure ℝ²)) ξ :=
  aux_parseval_L2 hg (hφc.toSchwartzMap hφ)

/-- Auxiliary (for `ext:reproduction`): for Schwartz `w, p`, `∫ ŵ(x) p(x - z) dx = (p̂ w)^(z)`. -/
theorem aux_conv_fourier_identity (w p : 𝓢(ℝ², ℂ)) (z : ℝ²) :
    ∫ x, 𝓕 (⇑w) x * p (x - z) = 𝓕 (fun ξ => 𝓕 (⇑p) ξ * w ξ) z := by
  simp only [Real.fourier_eq', smul_eq_mul]
  have hE : ∀ a b : ℝ², Complex.exp (↑(-2 * π * ⟪a, b⟫_ℝ) * Complex.I) =
      Complex.exp (↑(-2 * π * ⟪b, a⟫_ℝ) * Complex.I) := fun a b => by rw [real_inner_comm]
  have hint : Integrable (Function.uncurry fun (x ξ : ℝ²) =>
      Complex.exp (↑(-2 * π * ⟪ξ, x⟫_ℝ) * Complex.I) * w ξ * p (x - z))
      ((volume : Measure ℝ²).prod volume) := by
    have hpz : Integrable (fun x => p (x - z)) volume := p.integrable.comp_sub_right z
    refine Integrable.mono' ((hpz.norm.mul_prod w.integrable.norm)) ?_ ?_
    · exact (by fun_prop : Continuous (Function.uncurry fun (x ξ : ℝ²) =>
        Complex.exp (↑(-2 * π * ⟪ξ, x⟫_ℝ) * Complex.I) * w ξ * p (x - z))).aestronglyMeasurable
    · refine Eventually.of_forall fun ⟨x, ξ⟩ => ?_
      simp only [Function.uncurry_apply_pair, norm_mul]
      rw [Complex.norm_exp_ofReal_mul_I, one_mul, mul_comm]
  calc ∫ x, (∫ ξ, Complex.exp (↑(-2 * π * ⟪ξ, x⟫_ℝ) * Complex.I) * w ξ) * p (x - z)
      = ∫ x, ∫ ξ, Complex.exp (↑(-2 * π * ⟪ξ, x⟫_ℝ) * Complex.I) * w ξ * p (x - z) := by
        congr 1; funext x; rw [← integral_mul_const]
    _ = ∫ ξ, ∫ x, Complex.exp (↑(-2 * π * ⟪ξ, x⟫_ℝ) * Complex.I) * w ξ * p (x - z) :=
        integral_integral_swap hint
    _ = _ := by
        congr 1; funext ξ
        have h1 : ∫ x, Complex.exp (↑(-2 * π * ⟪ξ, x⟫_ℝ) * Complex.I) * w ξ * p (x - z) =
            w ξ * ∫ y, Complex.exp (↑(-2 * π * ⟪ξ, y + z⟫_ℝ) * Complex.I) * p y := by
          rw [← integral_const_mul]
          rw [← integral_sub_right_eq_self (fun y =>
            w ξ * (Complex.exp (↑(-2 * π * ⟪ξ, y + z⟫_ℝ) * Complex.I) * p y)) z]
          congr 1; funext x; simp only [sub_add_cancel]; ring
        rw [h1]
        simp_rw [inner_add_right, mul_add, Complex.ofReal_add, add_mul, Complex.exp_add]
        rw [show (fun y => Complex.exp (↑(-2 * π * ⟪ξ, y⟫_ℝ) * Complex.I) *
            Complex.exp (↑(-2 * π * ⟪ξ, z⟫_ℝ) * Complex.I) * p y) = fun y =>
            Complex.exp (↑(-2 * π * ⟪ξ, z⟫_ℝ) * Complex.I) *
            (Complex.exp (↑(-2 * π * ⟪y, ξ⟫_ℝ) * Complex.I) * p y) by
          funext y; rw [hE ξ y]; ring]
        rw [integral_const_mul]
        ring

/-- Auxiliary (for `ext:reproduction`): integrability of `(x, z) ↦ u(x) p(x - z) g(z)` on `ℝ² × ℝ²`
for bounded integrable `u`, integrable `p`, and `|g| ≤ A + B h` with `h` integrable. -/
theorem aux_conv_prod_integrable {u : ℝ² → ℂ} (hu : Integrable u volume) {U : ℝ}
    (hub : ∀ x, ‖u x‖ ≤ U) {p : ℝ² → ℂ} (hp : Integrable p volume) {g : ℝ² → ℂ}
    (hg : AEStronglyMeasurable g volume) {A B : ℝ} {h : ℝ² → ℝ} (hh : Integrable h volume)
    (hB : 0 ≤ B) (hgb : ∀ᵐ z ∂(volume : Measure ℝ²), ‖g z‖ ≤ A + B * h z) :
    Integrable (fun q : ℝ² × ℝ² => u q.1 * p (q.1 - q.2) * g q.2)
      ((volume : Measure ℝ²).prod volume) := by
  have hU : 0 ≤ U := (norm_nonneg _).trans (hub 0)
  have hsub : MeasurePreserving (fun q : ℝ² × ℝ² => (q.1 - q.2, q.2))
      ((volume : Measure ℝ²).prod volume) ((volume : Measure ℝ²).prod volume) :=
    measurePreserving_sub_prod volume volume
  have hpsub : MeasurePreserving (fun q : ℝ² × ℝ² => (q.1, q.2 - q.1))
      ((volume : Measure ℝ²).prod volume) ((volume : Measure ℝ²).prod volume) :=
    measurePreserving_prod_sub volume volume
  have I1 : Integrable (fun q : ℝ² × ℝ² => ‖u q.1‖ * ‖p (q.1 - q.2)‖)
      ((volume : Measure ℝ²).prod volume) := by
    have hF : Integrable (fun q : ℝ² × ℝ² => ‖u q.1‖ * ‖p (-q.2)‖)
        ((volume : Measure ℝ²).prod volume) := hu.norm.mul_prod hp.comp_neg.norm
    have := (hpsub.integrable_comp hF.aestronglyMeasurable).2 hF
    refine this.congr (Eventually.of_forall fun q => ?_)
    simp [neg_sub]
  have I2 : Integrable (fun q : ℝ² × ℝ² => ‖p (q.1 - q.2)‖ * ‖h q.2‖)
      ((volume : Measure ℝ²).prod volume) := by
    have hF : Integrable (fun q : ℝ² × ℝ² => ‖p q.1‖ * ‖h q.2‖)
        ((volume : Measure ℝ²).prod volume) := hp.norm.mul_prod hh.norm
    exact (hsub.integrable_comp hF.aestronglyMeasurable).2 hF
  have hm : AEStronglyMeasurable (fun q : ℝ² × ℝ² => u q.1 * p (q.1 - q.2) * g q.2)
      ((volume : Measure ℝ²).prod volume) := by
    refine (hu.aestronglyMeasurable.comp_quasiMeasurePreserving
      Measure.quasiMeasurePreserving_fst).mul ?_ |>.mul ?_
    · exact hp.aestronglyMeasurable.comp_quasiMeasurePreserving
        (Measure.quasiMeasurePreserving_fst.comp hsub.quasiMeasurePreserving)
    · exact hg.comp_quasiMeasurePreserving Measure.quasiMeasurePreserving_snd
  refine Integrable.mono' ((I1.const_mul |A|).add (I2.const_mul (B * U))) hm ?_
  filter_upwards [Measure.quasiMeasurePreserving_snd.ae hgb] with q hq
  simp only [norm_mul, Pi.add_apply]
  have h1 : ‖g q.2‖ ≤ |A| + B * ‖h q.2‖ := by
    refine hq.trans (add_le_add (le_abs_self _) ?_)
    exact mul_le_mul_of_nonneg_left (le_abs_self _) hB
  have h2 := hub q.1
  have h3 := norm_nonneg (u q.1)
  have h4 := norm_nonneg (p (q.1 - q.2))
  have h5 := norm_nonneg (h q.2)
  calc ‖u q.1‖ * ‖p (q.1 - q.2)‖ * ‖g q.2‖ ≤ ‖u q.1‖ * ‖p (q.1 - q.2)‖ * (|A| + B * ‖h q.2‖) := by
        gcongr
    _ = |A| * (‖u q.1‖ * ‖p (q.1 - q.2)‖) + B * (‖u q.1‖ * (‖p (q.1 - q.2)‖ * ‖h q.2‖)) := by ring
    _ ≤ |A| * (‖u q.1‖ * ‖p (q.1 - q.2)‖) + B * (U * (‖p (q.1 - q.2)‖ * ‖h q.2‖)) := by
        gcongr
    _ = _ := by ring

/-- Auxiliary (for `ext:reproduction`): `g s` is integrable for Schwartz `s` when `|g| ≤ A + B h`
with `h` integrable. -/
theorem aux_integrable_mul_schwartz {g : ℝ² → ℂ} (hg : AEStronglyMeasurable g volume) {A B : ℝ}
    {h : ℝ² → ℝ} (hh : Integrable h volume) (hB : 0 ≤ B)
    (hgb : ∀ᵐ z ∂(volume : Measure ℝ²), ‖g z‖ ≤ A + B * h z) (s : 𝓢(ℝ², ℂ)) :
    Integrable (fun x => g x * s x) volume := by
  set S := SchwartzMap.seminorm ℂ 0 0 s
  refine Integrable.mono' ((s.integrable.norm.const_mul |A|).add (hh.norm.const_mul (B * S)))
    (hg.mul s.continuous.aestronglyMeasurable) ?_
  filter_upwards [hgb] with x hx
  have h1 : ‖g x‖ ≤ |A| + B * ‖h x‖ :=
    hx.trans (add_le_add (le_abs_self _) (mul_le_mul_of_nonneg_left (le_abs_self _) hB))
  have h2 : ‖s x‖ ≤ S := SchwartzMap.norm_le_seminorm ℂ s x
  rw [norm_mul]
  calc ‖g x‖ * ‖s x‖ ≤ (|A| + B * ‖h x‖) * ‖s x‖ := by gcongr
    _ = |A| * ‖s x‖ + B * ‖h x‖ * ‖s x‖ := by ring
    _ ≤ |A| * ‖s x‖ + B * ‖h x‖ * S := by gcongr
    _ = _ := by simp only [Pi.add_apply]; ring

/-- Auxiliary (for `ext_reproduction_L2`, `ext_reproduction_bounded`): if `p̂ = 1` near `K`, `|g| ≤
A + B h` with `h` integrable, and `∫ g v̂ = 0` for every Schwartz `v` vanishing near `K`, then
`p * g = g` a.e. -/
theorem aux_repro_core {K : Set ℝ²} (p : 𝓢(ℝ², ℂ)) (hp : ∀ᶠ ξ in 𝓝ˢ K, 𝓕 (⇑p) ξ = 1)
    {g : ℝ² → ℂ} (hg : AEStronglyMeasurable g volume) (hgl : LocallyIntegrable g volume)
    {A B : ℝ} {h : ℝ² → ℝ} (hh : Integrable h volume) (hB : 0 ≤ B)
    (hgb : ∀ᵐ z ∂(volume : Measure ℝ²), ‖g z‖ ≤ A + B * h z)
    (hC : ∀ v : 𝓢(ℝ², ℂ), (∀ᶠ ξ in 𝓝ˢ K, v ξ = 0) → ∫ x, g x * 𝓕 (⇑v) x = 0) :
    (fun x => ∫ y, p y * g (x - y)) =ᵐ[volume] g := by
  set g' := hg.mk g
  have hg'm : StronglyMeasurable g' := hg.stronglyMeasurable_mk
  have hgg' : g =ᵐ[volume] g' := hg.ae_eq_mk
  have hgb' : ∀ᵐ z ∂(volume : Measure ℝ²), ‖g' z‖ ≤ A + B * h z := by
    filter_upwards [hgb, hgg'] with z h1 h2; rwa [← h2]
  set F : ℝ² → ℂ := fun x => ∫ z, p (x - z) * g' z
  have hF : ∀ x, ∫ y, p y * g (x - y) = F x := by
    intro x
    have hae : ∀ᵐ y ∂(volume : Measure ℝ²), g (x - y) = g' (x - y) :=
      (quasiMeasurePreserving_sub_left volume x).ae hgg'
    rw [integral_congr_ae (hae.mono fun y hy => by rw [hy])]
    have := integral_sub_left_eq_self (μ := (volume : Measure ℝ²))
      (fun z => p (x - z) * g' z) x
    simp only [sub_sub_cancel] at this
    exact this
  have hFm : AEStronglyMeasurable F volume := by
    have : StronglyMeasurable (Function.uncurry fun x z : ℝ² => p (x - z) * g' z) :=
      (p.continuous.comp (continuous_fst.sub continuous_snd)).stronglyMeasurable.mul
        (hg'm.comp_measurable measurable_snd)
    exact (this.integral_prod_right (ν := (volume : Measure ℝ²))).aestronglyMeasurable
  -- the product integrand
  have hH : ∀ {u : ℝ² → ℂ}, Integrable u volume → ∀ {U : ℝ}, (∀ x, ‖u x‖ ≤ U) →
      Integrable (fun q : ℝ² × ℝ² => u q.1 * p (q.1 - q.2) * g' q.2)
        ((volume : Measure ℝ²).prod volume) := fun hu _ hub =>
    aux_conv_prod_integrable hu hub p.integrable hg'm.aestronglyMeasurable hh hB hgb'
  have huF : ∀ {u : ℝ² → ℂ}, Integrable u volume → ∀ {U : ℝ}, (∀ x, ‖u x‖ ≤ U) →
      AEStronglyMeasurable u volume → Integrable (fun x => u x * F x) volume := by
    intro u hu U hub hum
    refine Integrable.mono' (hH hu hub).integral_norm_prod_left (hum.mul hFm) ?_
    refine Eventually.of_forall fun x => ?_
    simp only [F, norm_mul]
    rw [← norm_mul, ← integral_const_mul]
    refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
    congr 1; funext z; simp [mul_assoc]
  -- the key identity
  have hkey : ∀ u : 𝓢(ℝ², ℂ), ∫ x, u x * F x = ∫ x, u x * g x := by
    intro u
    have hub : ∀ x, ‖u x‖ ≤ SchwartzMap.seminorm ℂ 0 0 u := SchwartzMap.norm_le_seminorm ℂ u
    have h1 : ∫ x, u x * F x = ∫ z, g' z * ∫ x, u x * p (x - z) := by
      calc ∫ x, u x * F x = ∫ x, ∫ z, u x * p (x - z) * g' z := by
            congr 1; funext x; simp only [F]; rw [← integral_const_mul]
            congr 1; funext z; ring
        _ = ∫ z, ∫ x, u x * p (x - z) * g' z := integral_integral_swap (hH u.integrable hub)
        _ = _ := by
            congr 1; funext z; rw [← integral_const_mul]; congr 1; funext x; ring
    have hpt : (⇑(𝓕 p : 𝓢(ℝ², ℂ))).HasTemperateGrowth := (𝓕 p : 𝓢(ℝ², ℂ)).hasTemperateGrowth
    set q : 𝓢(ℝ², ℂ) := SchwartzMap.smulLeftCLM ℂ (⇑(𝓕 p : 𝓢(ℝ², ℂ))) (𝓕⁻ u)
    have hq : ∀ ξ, q ξ = 𝓕 (⇑p) ξ * (𝓕⁻ u) ξ := fun ξ => by
      simp only [q]
      rw [SchwartzMap.smulLeftCLM_apply_apply hpt, smul_eq_mul]; rfl
    have h2 : ∀ z, ∫ x, u x * p (x - z) = 𝓕 (⇑q) z := by
      intro z
      have := aux_conv_fourier_identity (𝓕⁻ u) p z
      rw [← SchwartzMap.fourier_coe, FourierInvPair.fourier_fourierInv_eq] at this
      rw [this]
      have e : (fun ξ => 𝓕 (⇑p) ξ * (𝓕⁻ u) ξ) = ⇑q := funext fun ξ => (hq ξ).symm
      rw [e]
    have hv : ∀ᶠ ξ in 𝓝ˢ K, (q - 𝓕⁻ u) ξ = 0 := by
      filter_upwards [hp] with ξ hξ
      simp [hq, hξ]
    have h3 := hC _ hv
    have e3 : 𝓕 (⇑(q - 𝓕⁻ u)) = fun x => 𝓕 (⇑q) x - u x := by
      rw [← SchwartzMap.fourier_coe, sub_eq_add_neg, FourierAdd.fourier_add,
        FourierTransform.fourier_neg, FourierInvPair.fourier_fourierInv_eq]
      funext x; simp [SchwartzMap.fourier_coe, sub_eq_add_neg]
    rw [e3] at h3
    have hi1 := aux_integrable_mul_schwartz hg hh hB hgb (𝓕 q)
    have hi2 := aux_integrable_mul_schwartz hg hh hB hgb u
    simp only [mul_sub] at h3
    rw [integral_sub (by simpa [SchwartzMap.fourier_coe] using hi1) hi2, sub_eq_zero] at h3
    rw [h1]
    simp_rw [h2]
    rw [← integral_congr_ae (hgg'.mono fun z hz =>
      (by rw [hz] : g z * 𝓕 (⇑q) z = g' z * 𝓕 (⇑q) z)), h3]
    congr 1; funext x; ring
  -- conclude
  have hFl : LocallyIntegrable F volume := by
    rw [locallyIntegrable_iff]
    intro k hk
    have hkm : MeasurableSet k := hk.isClosed.measurableSet
    rw [← integrable_indicator_iff hkm]
    have hu : Integrable (k.indicator (1 : ℝ² → ℂ)) volume :=
      (integrable_indicator_iff hkm).2 (integrableOn_const hk.measure_ne_top)
    have := huF hu (U := 1) (fun x => by by_cases hx : x ∈ k <;> simp [hx])
      (hu.aestronglyMeasurable)
    refine this.congr (Eventually.of_forall fun x => ?_)
    by_cases hx : x ∈ k <;> simp [hx]
  have hz := ae_eq_zero_of_integral_contDiff_smul_eq_zero (hFl.sub hgl) ?_
  · filter_upwards [hz] with x hx
    rw [hF]; exact sub_eq_zero.1 hx
  intro ψ hψ hψc
  have hφ : ContDiff ℝ (⊤ : ℕ∞) (fun x => (ψ x : ℂ)) := Complex.ofRealCLM.contDiff.comp hψ
  have hφc : HasCompactSupport (fun x => (ψ x : ℂ)) := hψc.comp_left Complex.ofReal_zero
  set u := hφc.toSchwartzMap hφ
  have hu : ∀ x, u x = (ψ x : ℂ) := fun x => rfl
  have hi1 : Integrable (fun x => u x * F x) volume :=
    huF u.integrable (SchwartzMap.norm_le_seminorm ℂ u) u.continuous.aestronglyMeasurable
  have hi2 : Integrable (fun x => u x * g x) volume := by
    simpa [mul_comm] using aux_integrable_mul_schwartz hg hh hB hgb u
  have := hkey u
  calc ∫ x, ψ x • (F - g) x = ∫ x, (u x * F x - u x * g x) := by
        congr 1; funext x; simp [hu, Complex.real_smul, mul_sub]
    _ = 0 := by rw [integral_sub hi1 hi2, this, sub_self]

/-- **Lemma `ext:reproduction`** (case `g ∈ L²`).
Suppose $p\in\mathcal S(\mathbb R^2)$ and $\widehat p=1$ on a neighborhood of a compact set $K$.
If $g\in L^2$ or $g\in L^\infty$ has Fourier support in $K$, then $p*g=g$ almost everywhere.
For a function in $L^2\cap L^\infty$, the two support conditions in
Definition `ext:bounded-support` agree.
(In Lean the blueprint hypothesis `(hK : IsCompact K)` is omitted since the proof does not need it;
see `automation/ErrorReport.md`.) -/
theorem ext_reproduction_L2 {K : Set ℝ²} (p : 𝓢(ℝ², ℂ))
    (hp : ∀ᶠ ξ in 𝓝ˢ K, 𝓕 (⇑p) ξ = 1) {g : ℝ² → ℂ} (hg : MemLp g 2 volume)
    (hsupp : HasL2FourierSupportIn K (hg.toLp g)) :
    (fun x => ∫ y, p y * g (x - y)) =ᵐ[volume] g := by
  have hh : Integrable (fun x => ‖g x‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm hg.aestronglyMeasurable).1 hg
  refine aux_repro_core p hp hg.aestronglyMeasurable (hg.locallyIntegrable (by norm_num))
    (A := 1) (B := 1) hh zero_le_one (Eventually.of_forall fun z => ?_) ?_
  · nlinarith [norm_nonneg (g z), sq_nonneg (‖g z‖ - 1)]
  · intro v hv
    rw [aux_parseval_L2 hg v]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [hsupp] with ξ hξ
    by_cases hξK : ξ ∈ K
    · simp [hv.self_of_nhdsSet ξ hξK]
    · simp [hξ hξK]

/-- Auxiliary (for `ext_reproduction_bounded`): uniform bounds, for `R ≥ 1`, on the derivatives up
to order `n` of the rescaled cutoff `x ↦ χ(x/R)`. -/
theorem aux_cutoff_deriv_bound {χ : ℝ² → ℂ} (hχ : ContDiff ℝ (⊤ : ℕ∞) χ)
    (hχc : HasCompactSupport χ) (n : ℕ) :
    ∃ B, 0 ≤ B ∧ ∀ R : ℝ, 1 ≤ R → ∀ i ≤ n, ∀ x : ℝ²,
      ‖iteratedFDeriv ℝ i (fun y => χ (R⁻¹ • y)) x‖ ≤ B := by
  have hb : ∀ i, ∃ B, ∀ y, ‖iteratedFDeriv ℝ i χ y‖ ≤ B := fun i => by
    obtain ⟨C, hC⟩ := (hχ.continuous_iteratedFDeriv
      (by exact_mod_cast le_top)).bounded_above_of_compact_support (hχc.iteratedFDeriv i)
    exact ⟨C, hC⟩
  choose Bf hBf using hb
  refine ⟨∑ i ∈ Finset.range (n + 1), |Bf i|, by positivity, fun R hR i hi x => ?_⟩
  set L : ℝ² →L[ℝ] ℝ² := R⁻¹ • ContinuousLinearMap.id ℝ ℝ²
  have hL : ‖L‖ ≤ 1 := by
    refine (norm_smul_le _ _).trans ?_
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.2 (by linarith))]
    calc R⁻¹ * ‖ContinuousLinearMap.id ℝ ℝ²‖ ≤ 1 * 1 := by
          gcongr
          · exact inv_le_one_of_one_le₀ hR
          · exact ContinuousLinearMap.norm_id_le
      _ = 1 := by norm_num
  have e : (fun y => χ (R⁻¹ • y)) = χ ∘ L := by funext y; simp [L]
  rw [e, L.iteratedFDeriv_comp_right hχ x (by exact_mod_cast le_top)]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
  have hprod : ∏ _j : Fin i, ‖L‖ ≤ 1 :=
    Finset.prod_le_one (fun _ _ => norm_nonneg _) (fun _ _ => hL)
  calc ‖iteratedFDeriv ℝ i χ (L x)‖ * ∏ _j : Fin i, ‖L‖ ≤ |Bf i| * 1 := by
        gcongr
        exact (hBf i _).trans (le_abs_self _)
    _ ≤ ∑ i ∈ Finset.range (n + 1), |Bf i| := by
        rw [mul_one]
        exact Finset.single_le_sum (f := fun i => |Bf i|) (fun _ _ => abs_nonneg _)
          (Finset.mem_range.2 (by omega))

/-- Auxiliary (for `ext_reproduction_bounded`): for a smooth compactly supported cutoff `χ` equal to
one near `0` and a Schwartz `v`, `χ(·/R) v → v` in the Schwartz topology as `R → ∞`. -/
theorem aux_cutoff_tendsto {χ : ℝ² → ℂ} (hχ : ContDiff ℝ (⊤ : ℕ∞) χ) (hχc : HasCompactSupport χ)
    (hχ1 : ∀ x : ℝ², ‖x‖ < 1 → χ x = 1) (v : 𝓢(ℝ², ℂ)) (w : ℝ → 𝓢(ℝ², ℂ))
    (hw : ∀ R : ℝ, 1 ≤ R → ∀ x, w R x = χ (R⁻¹ • x) * v x) :
    Tendsto w atTop (𝓝 v) := by
  rw [(schwartz_withSeminorms ℂ ℝ² ℂ).tendsto_nhds]
  rintro ⟨k, n⟩ ε hε
  obtain ⟨B, hB0, hB⟩ := aux_cutoff_deriv_bound hχ hχc n
  set C : ℝ := B * ∑ i ∈ Finset.range (n + 1),
      (n.choose i : ℝ) * SchwartzMap.seminorm ℂ (k + 1) (n - i) v +
      SchwartzMap.seminorm ℂ (k + 1) n v
  have hC0 : 0 ≤ C := by positivity
  filter_upwards [eventually_ge_atTop (max 1 (C / ε + 1))] with R hR
  have hR1 : 1 ≤ R := (le_max_left _ _).trans hR
  have hR0 : 0 < R := by linarith
  have hRC : C / R < ε := by
    rw [div_lt_iff₀ hR0]
    have := (le_max_right _ _).trans hR
    have h2 : C / ε < R := by linarith
    rw [div_lt_iff₀ hε] at h2
    linarith
  rw [SchwartzMap.schwartzSeminormFamily_apply]
  refine lt_of_le_of_lt (SchwartzMap.seminorm_le_bound ℂ k n _ (by positivity : 0 ≤ C / R)
    fun x => ?_) hRC
  have hχR : ContDiff ℝ (⊤ : ℕ∞) (fun y : ℝ² => χ (R⁻¹ • y)) :=
    hχ.comp (contDiff_const_smul _)
  have hcoe : ⇑(w R - v) = (fun y => χ (R⁻¹ • y) * v y) - ⇑v := by
    funext y; simp [hw R hR1 y]
  rw [hcoe]
  by_cases hx : ‖x‖ < R
  · have hev : ((fun y => χ (R⁻¹ • y) * v y) - ⇑v) =ᶠ[𝓝 x] fun _ => 0 := by
      have : Metric.ball (0 : ℝ²) R ∈ 𝓝 x := Metric.isOpen_ball.mem_nhds (by simpa using hx)
      filter_upwards [this] with y hy
      have hy' : ‖R⁻¹ • y‖ < 1 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.2 hR0), inv_mul_lt_one₀ hR0]
        simpa using hy
      simp [hχ1 _ hy']
    rw [(Filter.EventuallyEq.iteratedFDeriv ℝ hev n).eq_of_nhds]
    simp only [iteratedFDeriv_fun_zero, Pi.zero_apply, norm_zero, mul_zero]
    positivity
  · push Not at hx
    have hn : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by exact_mod_cast le_top
    have hprod : ContDiff ℝ (⊤ : ℕ∞) (fun y => χ (R⁻¹ • y) * v y) := hχR.mul (v.smooth ⊤)
    rw [iteratedFDeriv_sub_apply ((hprod.of_le hn).contDiffAt) (((v.smooth ⊤).of_le hn).contDiffAt)]
    have hxk : ‖x‖ ^ k ≤ ‖x‖ ^ (k + 1) / R := by
      rw [pow_succ, le_div_iff₀ hR0]
      exact mul_le_mul_of_nonneg_left hx (by positivity)
    have hS : ∀ m, ‖x‖ ^ k * ‖iteratedFDeriv ℝ m (⇑v) x‖ ≤
        SchwartzMap.seminorm ℂ (k + 1) m v / R := by
      intro m
      calc ‖x‖ ^ k * ‖iteratedFDeriv ℝ m (⇑v) x‖
          ≤ ‖x‖ ^ (k + 1) / R * ‖iteratedFDeriv ℝ m (⇑v) x‖ := by gcongr
        _ = (‖x‖ ^ (k + 1) * ‖iteratedFDeriv ℝ m (⇑v) x‖) / R := by ring
        _ ≤ _ := by gcongr; exact SchwartzMap.le_seminorm ℂ _ _ v x
    have hmul := norm_iteratedFDeriv_mul_le hχR (v.smooth ⊤) x hn
    have hmul' : ‖iteratedFDeriv ℝ n (fun y => χ (R⁻¹ • y) * v y) x‖ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * B * ‖iteratedFDeriv ℝ (n - i) (⇑v) x‖ := by
      refine hmul.trans (Finset.sum_le_sum fun i hi => ?_)
      have := hB R hR1 i (by simpa [Nat.lt_succ_iff] using hi) x
      gcongr
    calc ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (fun y => χ (R⁻¹ • y) * v y) x -
          iteratedFDeriv ℝ n (⇑v) x‖
        ≤ ‖x‖ ^ k * (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * B *
            ‖iteratedFDeriv ℝ (n - i) (⇑v) x‖ + ‖iteratedFDeriv ℝ n (⇑v) x‖) := by
          gcongr
          exact (norm_sub_le _ _).trans (add_le_add_left hmul' _)
      _ = B * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
            (‖x‖ ^ k * ‖iteratedFDeriv ℝ (n - i) (⇑v) x‖) +
            ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (⇑v) x‖ := by
          rw [mul_add, Finset.mul_sum, Finset.mul_sum]
          congr 1
          refine Finset.sum_congr rfl fun i _ => by ring
      _ ≤ B * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
            (SchwartzMap.seminorm ℂ (k + 1) (n - i) v / R) +
            SchwartzMap.seminorm ℂ (k + 1) n v / R := by
          gcongr with i hi
          · exact hS _
          · exact hS _
      _ = C / R := by
          simp only [C, add_div, Finset.mul_sum, Finset.sum_div]
          congr 1
          refine Finset.sum_congr rfl fun i _ => by ring

/-- Auxiliary (for `ext_reproduction_bounded`): the test-function support condition of `ext:bounded-
support` extends to Schwartz tests vanishing near `K`. -/
theorem aux_bounded_support_ext {K : Set ℝ²} {g : ℝ² → ℂ} (hg : MemLp g ⊤ volume)
    (hsupp : HasFourierSupportIn K g) (v : 𝓢(ℝ², ℂ)) (hv : ∀ᶠ ξ in 𝓝ˢ K, v ξ = 0) :
    ∫ x, g x * 𝓕 (⇑v) x = 0 := by
  let b : ContDiffBump (0 : ℝ²) := ⟨1, 2, one_pos, one_lt_two⟩
  set χ : ℝ² → ℂ := fun x => (b x : ℂ)
  have hχ : ContDiff ℝ (⊤ : ℕ∞) χ := Complex.ofRealCLM.contDiff.comp b.contDiff
  have hχc : HasCompactSupport χ := b.hasCompactSupport.comp_left Complex.ofReal_zero
  have hχ1 : ∀ x : ℝ², ‖x‖ < 1 → χ x = 1 := fun x hx => by
    simp only [χ]
    rw [b.one_of_mem_closedBall (by simpa [Metric.mem_closedBall] using hx.le)]
    simp
  have hcd : ∀ R : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => χ (R⁻¹ • x) * v x) := fun R =>
    (hχ.comp (contDiff_const_smul _)).mul (v.smooth ⊤)
  have hcs : ∀ R : ℝ, R ≠ 0 → HasCompactSupport (fun x => χ (R⁻¹ • x) * v x) := fun R hR =>
    (hχc.comp_smul (inv_ne_zero hR)).mul_right
  let w : ℝ → 𝓢(ℝ², ℂ) := fun R => if h : R = 0 then v else (hcs R h).toSchwartzMap (hcd R)
  have hw : ∀ R : ℝ, 1 ≤ R → ∀ x, w R x = χ (R⁻¹ • x) * v x := by
    intro R hR x
    have hR0 : R ≠ 0 := by linarith
    simp only [w, dif_neg hR0]
    rfl
  have hlim := aux_cutoff_tendsto hχ hχc hχ1 v w hw
  set T : 𝓢'(ℝ², ℂ) := Lp.toTemperedDistribution (hg.toLp g)
  have hT : ∀ φ : 𝓢(ℝ², ℂ), T φ = ∫ x, g x * φ x := by
    intro φ
    simp only [T, Lp.toTemperedDistribution_apply, smul_eq_mul]
    refine integral_congr_ae ?_
    filter_upwards [hg.coeFn_toLp] with x hx
    rw [hx, mul_comm]
  have hcont : Continuous fun φ : 𝓢(ℝ², ℂ) => T (𝓕 φ) :=
    (map_continuous T).comp (FourierTransform.continuous_fourier)
  have h1 := (hcont.tendsto v).comp hlim
  -- the approximants are allowed tests
  obtain ⟨U, hUo, hKU, hUv⟩ := mem_nhdsSet_iff_exists.1 hv
  have h0 : ∀ R : ℝ, 1 ≤ R → T (𝓕 (w R)) = 0 := by
    intro R hR
    rw [hT]
    have hwR : ⇑(w R) = fun x => χ (R⁻¹ • x) * v x := funext (hw R hR)
    rw [SchwartzMap.fourier_coe, hwR]
    refine hsupp _ (hcd R) (hcs R (by linarith)) ?_
    refine Set.disjoint_left.2 fun x hx hxK => ?_
    have hxv : x ∈ tsupport v := tsupport_mul_subset_right hx
    have : v =ᶠ[𝓝 x] 0 := by
      filter_upwards [hUo.mem_nhds (hKU hxK)] with y hy
      exact hUv hy
    exact (notMem_tsupport_iff_eventuallyEq.2 this) hxv
  have h2 : Tendsto (fun R => T (𝓕 (w R))) atTop (𝓝 0) :=
    tendsto_const_nhds.congr' (by
      filter_upwards [eventually_ge_atTop 1] with R hR
      exact (h0 R hR).symm)
  have := tendsto_nhds_unique h1 h2
  rw [hT] at this
  rw [← this, SchwartzMap.fourier_coe]

/-- **Lemma `ext:reproduction`** (case `g ∈ L^∞`).
Suppose $p\in\mathcal S(\mathbb R^2)$ and $\widehat p=1$ on a neighborhood of a compact set $K$.
If $g\in L^2$ or $g\in L^\infty$ has Fourier support in $K$, then $p*g=g$ almost everywhere.
For a function in $L^2\cap L^\infty$, the two support conditions in
Definition `ext:bounded-support` agree.
(In Lean the blueprint hypothesis `(hK : IsCompact K)` is omitted since the proof does not need it;
see `automation/ErrorReport.md`.) -/
theorem ext_reproduction_bounded {K : Set ℝ²} (p : 𝓢(ℝ², ℂ))
    (hp : ∀ᶠ ξ in 𝓝ˢ K, 𝓕 (⇑p) ξ = 1) {g : ℝ² → ℂ} (hg : MemLp g ⊤ volume)
    (hsupp : HasFourierSupportIn K g) :
    (fun x => ∫ y, p y * g (x - y)) =ᵐ[volume] g := by
  have hfin : eLpNormEssSup g volume ≠ ⊤ := by
    have := hg.eLpNorm_lt_top; rw [eLpNorm_exponent_top] at this; exact this.ne
  refine aux_repro_core p hp hg.aestronglyMeasurable (hg.locallyIntegrable le_top)
    (A := (eLpNormEssSup g volume).toReal) (B := 0) (h := 0) (integrable_zero _ _ _) le_rfl ?_
    (fun v hv => aux_bounded_support_ext hg hsupp v hv)
  filter_upwards [enorm_ae_le_eLpNormEssSup (μ := volume) g] with z hz
  simp only [Pi.zero_apply, mul_zero, add_zero]
  have := ENNReal.toReal_mono hfin hz
  rwa [toReal_enorm] at this

/-- **Lemma `ext:reproduction`** (agreement of the two support notions on `L² ∩ L^∞`).
Suppose $p\in\mathcal S(\mathbb R^2)$ and $\widehat p=1$ on a neighborhood of a compact set $K$.
If $g\in L^2$ or $g\in L^\infty$ has Fourier support in $K$, then $p*g=g$ almost everywhere.
For a function in $L^2\cap L^\infty$, the two support conditions in
Definition `ext:bounded-support` agree.
(In Lean the blueprint hypothesis `(hgi : MemLp g ⊤ volume)` is omitted since the proof does not
need it; see `automation/ErrorReport.md`.) -/
theorem ext_reproduction_agree {K : Set ℝ²} (hK : IsCompact K) {g : ℝ² → ℂ}
    (hg2 : MemLp g 2 volume) :
    HasFourierSupportIn K g ↔ HasL2FourierSupportIn K (hg2.toLp g) := by
  set G : Lp ℂ 2 (volume : Measure ℝ²) := 𝓕 (hg2.toLp g)
  constructor
  · intro h
    have hU : IsOpen Kᶜ := hK.isClosed.isOpen_compl
    have hGl : LocallyIntegrableOn (⇑G) Kᶜ volume :=
      ((Lp.memLp G).locallyIntegrable (by norm_num)).locallyIntegrableOn _
    have := hU.ae_eq_zero_of_integral_contDiff_smul_eq_zero hGl ?_
    · filter_upwards [this] with ξ hξ hξK
      exact hξ hξK
    intro ψ hψ hψc hψs
    have hφ : ContDiff ℝ (⊤ : ℕ∞) (fun x => (ψ x : ℂ)) :=
      Complex.ofRealCLM.contDiff.comp hψ
    have hφc : HasCompactSupport (fun x => (ψ x : ℂ)) := hψc.comp_left Complex.ofReal_zero
    have hφs : Disjoint (tsupport fun x => (ψ x : ℂ)) K := by
      refine Set.disjoint_left.2 fun x hx hxK => ?_
      exact hψs (tsupport_comp_subset Complex.ofReal_zero ψ hx) hxK
    have h1 := h _ hφ hφc hφs
    rw [aux_parseval_cc hg2 hφ hφc] at h1
    rw [← h1]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp [Complex.real_smul, G]
  · intro h φ hφ hφc hφs
    rw [aux_parseval_cc hg2 hφ hφc]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [h] with ξ hξ
    by_cases hξK : ξ ∈ K
    · have : φ ξ = 0 := image_eq_zero_of_notMem_tsupport
        (fun hx => Set.disjoint_left.1 hφs hx hξK)
      simp [this]
    · simp [hξ hξK]

end Auto
