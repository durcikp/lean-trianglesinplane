theorem aux_ae_ae_sub_comp (κ : FCMeasure) {P : ℝ² → Prop} (h : ∀ᵐ y ∂(volume : Measure ℝ²), P y) :
    ∀ᵐ x ∂(volume : Measure ℝ²), ∀ᵐ z ∂κ.m, P (x - κ.φ z) := by
  obtain ⟨N, hsub, hNm, hN0⟩ := exists_measurable_superset_of_null (ae_iff.1 h)
  have hS : MeasurableSet {q : ℝ² × κ.Z | q.1 - κ.φ q.2 ∈ N} :=
    hNm.preimage (measurable_fst.sub (κ.measurable_φ.comp measurable_snd))
  have h0 : (volume.prod κ.m) {q : ℝ² × κ.Z | q.1 - κ.φ q.2 ∈ N} = 0 := by
    rw [Measure.prod_apply_symm hS]
    refine lintegral_eq_zero_of_ae_eq_zero (Eventually.of_forall fun z => ?_)
    have : (fun x : ℝ² => (x, z)) ⁻¹' {q : ℝ² × κ.Z | q.1 - κ.φ q.2 ∈ N} =
        (fun x => x - κ.φ z) ⁻¹' N := rfl
    simp only [Pi.zero_apply]
    rw [this]
    simp_rw [sub_eq_add_neg]
    rw [measure_preimage_add_right]
    exact hN0
  have := Measure.ae_ae_of_ae_prod (p := fun q : ℝ² × κ.Z => q.1 - κ.φ q.2 ∉ N)
    (measure_eq_zero_iff_ae_notMem.1 h0)
  filter_upwards [this] with x hx
  filter_upwards [hx] with z hz
  by_contra hc
  exact hz (hsub hc)

