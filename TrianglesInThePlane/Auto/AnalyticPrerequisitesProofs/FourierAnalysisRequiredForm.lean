/-- Integration against `ν`: `∫ g dν = ∫ g(φ z) w(z) dm(z)` (part of `\label{def:form}`). -/
def integral (ν : FCMeasure) (g : ℝ² → ℂ) : ℂ := ∫ z, g (ν.φ z) * ν.w z ∂ν.m

/-- The total variation `‖ν‖_TV = |ν|(ℝ²)` of the presentation, `∫ |w| dm`
(part of `\label{def:form}`).  This equals `‖ν‖_TV` for the polar presentation and is an
upper bound for `‖ν‖_TV` for every presentation. -/
def tv (ν : FCMeasure) : ℝ≥0∞ := ∫⁻ z, ‖ν.w z‖ₑ ∂ν.m

/-- The variation `|ν|(A)` of a Borel set `A` for the presentation, `∫_{φ⁻¹A} |w| dm`
(part of `\label{def:form}`). -/
def varOn (ν : FCMeasure) (A : Set ℝ²) : ℝ≥0∞ := ∫⁻ z in ν.φ ⁻¹' A, ‖ν.w z‖ₑ ∂ν.m

/-- The Fourier transform `ν̂(ξ) = ∫ exp(-2πi x·ξ) dν(x)` of a finite complex measure
(part of `\label{ext:fourier-convention}`). -/
def fourier (ν : FCMeasure) (ξ : ℝ²) : ℂ :=
  ν.integral (fun x => Complex.exp (-(2 * π * ⟪x, ξ⟫_ℝ : ℝ) * Complex.I))

/-- A finite positive Borel measure as a finite complex measure (part of `\label{def:form}`). -/
def ofMeasure (μ : Measure ℝ²) [IsFiniteMeasure μ] : FCMeasure where
  Z := ℝ²
  m := μ
  w := fun _ => 1
  φ := id
  measurable_φ := measurable_id
  integrable_w := integrable_const 1

/-- The Dirac mass `δ_a` (part of `\label{def:form}`). -/
def dirac (a : ℝ²) : FCMeasure where
  Z := Unit
  m := Measure.dirac ()
  w := fun _ => 1
  φ := fun _ => a
  measurable_φ := measurable_const
  integrable_w := integrable_const 1

/-- The convolution `(κ * f)(x) = ∫ f(x - y) dκ(y)` of a finite complex measure with a function
(used in `\label{ext:young}`). -/
def convFun (κ : FCMeasure) (f : ℝ² → ℂ) (x : ℝ²) : ℂ := κ.integral (fun y => f (x - y))

end FCMeasure

