  rw [lintegral_withDensity_eq_lintegral_mul₀' hb ha.aemeasurable,
    lintegral_withDensity_eq_lintegral_mul₀' hb (ha.pow_const _).aemeasurable] at h
  have h2 := ENNReal.rpow_le_rpow h (by norm_num : (0:ℝ) ≤ 2)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul] at h2
  rw [show (1/2:ℝ)*2 = 1 by norm_num, ENNReal.rpow_one, ENNReal.rpow_one, one_mul] at h2
