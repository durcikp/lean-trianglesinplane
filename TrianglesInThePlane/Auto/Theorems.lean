      endNorm α β (((FCMeasure.sigma.conv
        (FCMeasure.ofDensity (fun x => (((ε ^ 2)⁻¹ * ρ (ε⁻¹ • x) : ℝ) : ℂ)))).sub
          FCMeasure.sigma).dil s) i)
      (𝓝[>] 0) (𝓝 0) :=
