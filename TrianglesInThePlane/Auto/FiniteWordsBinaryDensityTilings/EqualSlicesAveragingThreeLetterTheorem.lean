/-! ### Equal-slices probability and total variation (`cj:equal-slices`) -/

/-- The letter-count vector of a word: `countVec x j` is the number of occurrences of the letter
`j` in `x` (auxiliary for `\label{cj:equal-slices}`). -/
@[nolint defsWithUnderscore]
def aux_countVec {X : Type*} [Fintype X] {k : ℕ} (x : X → Fin k) : Fin k → ℕ :=
  fun j => (univ.filter fun i => x i = j).card

/-- The equal-slices probability $\nu_{k,n}(A)$ (part of `\label{cj:equal-slices}`):
it is obtained by first choosing uniformly a vector $(a_1,\ldots,a_k)$ of nonnegative integers
with $a_1+\cdots+a_k=n$, and then choosing uniformly a word having exactly $a_j$ occurrences of
the letter $j$ for every $j$.  Here the words are indexed by a finite coordinate set `X` with
$n=|X|$; the blueprint's $\nu_{k,n}$ is the case `X = Fin n`.  For $n=0$ it gives mass one to
the empty word. -/
def equalSlices {X : Type*} [Fintype X] [DecidableEq X] (k : ℕ) (A : Finset (X → Fin k)) : ℝ :=
  ((Finset.Nat.antidiagonalTuple k (Fintype.card X)).card : ℝ)⁻¹ *
    ∑ a ∈ Finset.Nat.antidiagonalTuple k (Fintype.card X),
      ((A.filter fun x => aux_countVec x = a).card : ℝ) /
        ((univ.filter fun x : X → Fin k => aux_countVec x = a).card : ℝ)

/-- For probabilities $P,Q$ on a finite set $X$,
$d_{\mathrm{TV}}(P,Q)=\frac12\sum_{x\in X}|P(\{x\})-Q(\{x\})|$
(part of `\label{cj:equal-slices}`). -/
def dTV {X : Type*} [Fintype X] (P Q : X → ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∑ x, |P x - Q x|

/-- `P` is a probability on the finite set `X` (nonnegative masses summing to one); auxiliary
for `\label{cj:equal-slices}` and `\label{cj:probability-facts}`. -/
@[nolint defsWithUnderscore]
def aux_IsProb {X : Type*} [Fintype X] (P : X → ℝ) : Prop :=
  (∀ x, 0 ≤ P x) ∧ ∑ x, P x = 1

/-! ### Elementary counting and total variation (`cj:probability-facts`) -/

/-- The number of count vectors: $|\{a\in\mathbb N^k:\sum a_j=n\}|=\binom{k+n-1}{n}$ (auxiliary for
`cj:probability-facts`, used in `cj_probability_facts_atom` and
`cj_probability_facts_binary_face_mass`). -/
theorem aux_card_antidiagonalTuple (k n : ℕ) :
    (Finset.Nat.antidiagonalTuple k n).card = (k + n - 1).choose n := by
  rw [← Finset.piAntidiag_univ_fin_eq_antidiagonalTuple]
  have := Finset.card_finsuppAntidiag_nat_eq_choose (s := (univ : Finset (Fin k))) n
  rw [card_univ, Fintype.card_fin, Finset.finsuppAntidiag, card_map, card_attach] at this
  exact this

/-- Count vector of a word `Fin.cons j y` (auxiliary for the slice count `aux_card_slice_fin`,
serving `cj_probability_facts_atom`). -/
theorem aux_countVec_cons {k n : ℕ} (j : Fin k) (y : Fin n → Fin k) (c : Fin k) :
    aux_countVec (Fin.cons j y : Fin (n + 1) → Fin k) c =
      aux_countVec y c + if j = c then 1 else 0 := by
  unfold aux_countVec
  rw [Fin.card_filter_univ_succ']
  simp only [Fin.cons_zero, Fin.cons_succ]
  omega

/-- Characterization of the count vector of `Fin.cons j y` (auxiliary for `aux_card_slice_fin`,
serving `cj_probability_facts_atom`). -/
theorem aux_countVec_cons_eq_iff {k n : ℕ} (j : Fin k) (y : Fin n → Fin k) (a : Fin k → ℕ) :
    aux_countVec (Fin.cons j y : Fin (n + 1) → Fin k) = a ↔
      1 ≤ a j ∧ aux_countVec y = update a j (a j - 1) := by
  constructor
  · intro h
    have hj := congrFun h j
    rw [aux_countVec_cons] at hj
    rw [if_pos rfl] at hj
    refine ⟨by omega, funext fun c => ?_⟩
    have hc := congrFun h c
    rw [aux_countVec_cons] at hc
    by_cases hjc : c = j
    · subst hjc; rw [if_pos rfl] at hc; simp; omega
    · rw [update_of_ne hjc]; rw [if_neg (Ne.symm hjc)] at hc; omega
  · rintro ⟨h1, h⟩
    funext c
    rw [aux_countVec_cons, h]
    by_cases hjc : c = j
    · subst hjc; simp; omega
    · rw [update_of_ne hjc, if_neg (Ne.symm hjc)]; simp

/-- The number of words in `[k]^n` with count vector `a` times $\prod_j a_j!$ is $n!$ if $\sum_j
a_j=n$ and $0$ otherwise (auxiliary for `cj:probability-facts`, `cj_probability_facts_atom`). -/
theorem aux_card_slice_fin {k : ℕ} (n : ℕ) (a : Fin k → ℕ) :
    (univ.filter fun x : Fin n → Fin k => aux_countVec x = a).card * ∏ j, (a j).factorial =
      if ∑ j, a j = n then n.factorial else 0 := by
  induction n generalizing a with
  | zero =>
    have hcv : ∀ x : Fin 0 → Fin k, aux_countVec x = 0 := fun x => funext fun c => by
      simp [aux_countVec]
    by_cases ha : a = 0
    · subst ha
      simp [hcv]
    · have : (univ.filter fun x : Fin 0 → Fin k => aux_countVec x = a) = ∅ := by
        ext x; simp only [mem_filter, mem_univ, true_and, Finset.notMem_empty, iff_false, hcv]
        exact fun h => ha h.symm
      rw [this, card_empty, zero_mul, if_neg]
      intro hs
      apply ha; funext c
      have := (Finset.sum_eq_zero_iff.1 hs) c (mem_univ _)
      simpa using this
  | succ n ih =>
    rw [card_filter]
    rw [← (Fin.consEquiv fun _ => Fin k).sum_comp, Fintype.sum_prod_type]
    have hc : ∀ (x : Fin k) (y : Fin n → Fin k),
        (Fin.consEquiv fun _ => Fin k) (x, y) = (Fin.cons x y : Fin (n + 1) → Fin k) :=
      fun _ _ => rfl
    simp only [hc, aux_countVec_cons_eq_iff]
    rw [sum_mul]
    have step : ∀ j : Fin k, (∑ y : Fin n → Fin k,
        if 1 ≤ a j ∧ aux_countVec y = update a j (a j - 1) then 1 else 0) *
          ∏ i, (a i).factorial
        = a j * (if ∑ i, a i = n + 1 then n.factorial else 0) := by
      intro j
      by_cases hj : 1 ≤ a j
      · simp only [hj, true_and]
        rw [← card_filter]
        have hprod : ∏ i, (a i).factorial = a j * ∏ i, (update a j (a j - 1) i).factorial := by
          simp only [apply_update (fun _ v => Nat.factorial v)]
          rw [Finset.prod_update_of_mem (mem_univ j), ← Finset.mul_prod_erase univ _ (mem_univ j)]
          rw [← mul_assoc, Nat.mul_factorial_pred (by omega), sdiff_singleton_eq_erase]
        rw [hprod, mul_left_comm, ih]
        have hsum : ∑ i, update a j (a j - 1) i = ∑ i, a i - 1 := by
          rw [Finset.sum_update_of_mem (mem_univ j), ← Finset.add_sum_erase univ _ (mem_univ j)]
          rw [sdiff_singleton_eq_erase]; omega
        rw [hsum]
        have : ∑ i, a i - 1 = n ↔ ∑ i, a i = n + 1 := by
          have : a j ≤ ∑ i, a i := Finset.single_le_sum (fun _ _ => Nat.zero_le _) (mem_univ j)
          omega
        simp only [this]
      · have : a j = 0 := by omega
        simp [this]
    rw [Finset.sum_congr rfl fun j _ => step j, ← Finset.sum_mul]
    split_ifs with h
    · rw [h, Nat.factorial_succ]
    · simp

/-- Count vectors are invariant under reindexing the coordinates (auxiliary for `aux_card_slice`,
serving `cj_probability_facts_atom`). -/
theorem aux_countVec_comp_equiv {X Y : Type*} [Fintype X] [Fintype Y] {k : ℕ} (e : X ≃ Y)
    (x : Y → Fin k) : aux_countVec (x ∘ e) = aux_countVec x := by
  funext c
  unfold aux_countVec
  rw [card_filter, card_filter]
  exact e.sum_comp (fun i => if x i = c then 1 else 0)

/-- Slice count for words indexed by an arbitrary finite set (auxiliary for `cj:probability-facts`,
`cj_probability_facts_atom`; also used for `cj_transfer_equal`). -/
theorem aux_card_slice {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ} (a : Fin k → ℕ) :
    (univ.filter fun x : X → Fin k => aux_countVec x = a).card * ∏ j, (a j).factorial =
      if ∑ j, a j = Fintype.card X then (Fintype.card X).factorial else 0 := by
  rw [← aux_card_slice_fin]
  congr 1
  let e := Fintype.equivFin X
  rw [card_filter, card_filter]
  rw [← (Equiv.arrowCongr e (Equiv.refl (Fin k))).symm.sum_comp]
  refine Finset.sum_congr rfl fun x _ => ?_
  congr 2
  simp only [Equiv.arrowCongr_symm, Equiv.refl_symm]
  exact aux_countVec_comp_equiv _ _

/-- The letter counts of a word sum to its length (auxiliary for `cj_probability_facts_atom`). -/
theorem aux_sum_countVec {X : Type*} [Fintype X] {k : ℕ} (x : X → Fin k) :
    ∑ j, aux_countVec x j = Fintype.card X := by
  unfold aux_countVec
  rw [← card_univ, Finset.card_eq_sum_card_fiberwise (f := x) (fun _ _ => mem_univ _)]

/-- The count vector of a word is one of the count vectors summed over in `equalSlices` (auxiliary
for `cj_probability_facts_atom`). -/
theorem aux_countVec_mem {X : Type*} [Fintype X] {k : ℕ} (x : X → Fin k) :
    aux_countVec x ∈ Finset.Nat.antidiagonalTuple k (Fintype.card X) :=
  Finset.Nat.mem_antidiagonalTuple.2 (aux_sum_countVec x)

/-- Every slice with an admissible count vector is nonempty (auxiliary for
`cj_probability_facts_atom` and `cj_probability_facts_binary_face_mass`). -/
theorem aux_card_slice_pos {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ} {a : Fin k → ℕ}
    (ha : a ∈ Finset.Nat.antidiagonalTuple k (Fintype.card X)) :
    0 < (univ.filter fun x : X → Fin k => aux_countVec x = a).card := by
  have h := aux_card_slice (X := X) a
  rw [if_pos (Finset.Nat.mem_antidiagonalTuple.1 ha)] at h
  rcases Nat.eq_zero_or_pos (univ.filter fun x : X → Fin k => aux_countVec x = a).card with
    h0 | h0
  · rw [h0, zero_mul] at h; exact absurd h.symm (Nat.factorial_ne_zero _)
  · exact h0

/-- Additivity: $\nu(A)=\sum_{x\in A}\nu(\{x\})$ (auxiliary for `cj:probability-facts`; used in
`cj_transfer_equal_average`). -/
theorem aux_equalSlices_eq_sum {X : Type*} [Fintype X] [DecidableEq X] (k : ℕ)
    (A : Finset (X → Fin k)) :
    equalSlices k A = ∑ x ∈ A, equalSlices k ({x} : Finset (X → Fin k)) := by
  unfold equalSlices
  rw [← mul_sum]
  congr 1
  rw [sum_comm]
  refine sum_congr rfl fun a _ => ?_
  rw [← sum_div]
  congr 1
  rw [card_filter]
  push_cast
  refine sum_congr rfl fun x _ => ?_
  rw [filter_singleton]
  split_ifs <;> simp

/-- The equal-slices atom formula `eq:cj-equal-atom` for words indexed by an arbitrary finite set
(auxiliary for `cj_probability_facts_atom`; also used for `cj_transfer_equal`). -/
theorem aux_equalSlices_atom {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ} (hk : 1 ≤ k)
    (x : X → Fin k) :
    equalSlices k ({x} : Finset (X → Fin k)) =
      ((k - 1).factorial * ∏ j, (aux_countVec x j).factorial : ℕ) /
        ((Fintype.card X + k - 1).factorial : ℝ) := by
  set n := Fintype.card X
  unfold equalSlices
  rw [sum_eq_single (aux_countVec x)]
  · rw [filter_singleton, if_pos rfl, card_singleton, aux_card_antidiagonalTuple]
    have h1 := aux_card_slice (X := X) (aux_countVec x)
    rw [if_pos (aux_sum_countVec x)] at h1
    have h2 := Nat.choose_mul_factorial_mul_factorial (n := k + n - 1) (k := n) (by omega)
    have h3 : k + n - 1 - n = k - 1 := by omega
    rw [h3] at h2
    have hS :
        (0 : ℝ) < (univ.filter fun y : X → Fin k => aux_countVec y = aux_countVec x).card := by
      exact_mod_cast aux_card_slice_pos (aux_countVec_mem x)
    have hC : (0 : ℝ) < ((k + n - 1).choose n : ℕ) := by
      exact_mod_cast Nat.choose_pos (by omega)
    have h1' : ((univ.filter fun y : X → Fin k => aux_countVec y = aux_countVec x).card : ℝ) *
        (∏ j, (aux_countVec x j).factorial : ℕ) = (n.factorial : ℝ) := by exact_mod_cast h1
    have h2' :
        (((k + n - 1).choose n : ℕ) : ℝ) * (n.factorial : ℝ) * ((k - 1).factorial : ℝ) =
          ((k + n - 1).factorial : ℝ) := by exact_mod_cast h2
    rw [show n + k - 1 = k + n - 1 by omega, ← h2', ← h1']
    have : (0 : ℝ) < (∏ j, (aux_countVec x j).factorial : ℕ) := by
      exact_mod_cast Finset.prod_pos fun j _ => Nat.factorial_pos _
    have : (0 : ℝ) < ((k - 1).factorial : ℕ) := by exact_mod_cast Nat.factorial_pos _
    push_cast
    field_simp
    exact div_self hC.ne'
  · intro a _ ha
    rw [filter_singleton, if_neg (Ne.symm ha)]; simp
  · intro h; exact absurd (aux_countVec_mem x) h

/-- The equal-slices probability has total mass one (auxiliary for `cj:transfer-equal`,
`cj_transfer_equal`). -/
theorem aux_equalSlices_univ {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ} (hk : 1 ≤ k) :
    equalSlices k (univ : Finset (X → Fin k)) = 1 := by
  unfold equalSlices
  have hT : (0 : ℝ) < (Finset.Nat.antidiagonalTuple k (Fintype.card X)).card := by
    rw [aux_card_antidiagonalTuple]; exact_mod_cast Nat.choose_pos (by omega)
  rw [sum_congr rfl fun a ha => by
    rw [div_self (by exact_mod_cast (aux_card_slice_pos ha).ne')]]
  rw [sum_const, nsmul_eq_mul, mul_one, inv_mul_cancel₀ hT.ne']

/-- The equal-slices atoms sum to one (auxiliary for `cj:transfer-equal`, `cj_transfer_equal`). -/
theorem aux_equalSlices_sum_atoms {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ} (hk : 1 ≤ k) :
    ∑ x : X → Fin k, equalSlices k ({x} : Finset (X → Fin k)) = 1 := by
  rw [← aux_equalSlices_eq_sum, aux_equalSlices_univ hk]

/-- A ternary word is binary iff it has no letter `3` (auxiliary for
`cj_probability_facts_binary_face_mass`). -/
theorem aux_mem_binaryCube_iff {n : ℕ} (x : Fin n → Fin 3) :
    x ∈ binaryCube n ↔ aux_countVec x 2 = 0 := by
  unfold aux_countVec binaryCube
  rw [card_eq_zero, filter_eq_empty_iff, mem_image]
  constructor
  · rintro ⟨y, -, rfl⟩ i _ h
    have := congrArg Fin.val h
    simp [binEmb] at this
    omega
  · intro h
    refine ⟨fun i => ⟨x i, ?_⟩, mem_univ _, ?_⟩
    · have := h (mem_univ i)
      have hi := (x i).isLt
      have : (x i : ℕ) ≠ 2 := fun h' => this (Fin.ext h')
      omega
    · funext i; rfl

/-- **Lemma `cj:probability-facts`** (part 1, equation `eq:cj-equal-atom`).
If $x\in[k]^n$ has $a_j$ occurrences of $j$, then
$$\nu_{k,n}(\{x\})=\binom{n+k-1}{k-1}^{-1}\binom{n}{a_1,\ldots,a_k}^{-1}
=\frac{(k-1)!\,a_1!\cdots a_k!}{(n+k-1)!}.$$ -/
theorem cj_probability_facts_atom {k n : ℕ} (hk : 2 ≤ k) (x : Fin n → Fin k) :
    equalSlices k ({x} : Finset (Fin n → Fin k)) =
        ((Nat.choose (n + k - 1) (k - 1) : ℕ) : ℝ)⁻¹ *
          ((Nat.multinomial univ (aux_countVec x) : ℕ) : ℝ)⁻¹ ∧
      equalSlices k ({x} : Finset (Fin n → Fin k)) =
        ((k - 1).factorial * ∏ j, (aux_countVec x j).factorial : ℕ) /
          ((n + k - 1).factorial : ℝ) := by
  have hat := aux_equalSlices_atom (by omega : 1 ≤ k) x
  rw [Fintype.card_fin] at hat
  refine ⟨?_, hat⟩
  rw [hat]
  have h1 := Nat.multinomial_spec univ (aux_countVec x)
  rw [aux_sum_countVec, Fintype.card_fin] at h1
  have h2 := Nat.choose_mul_factorial_mul_factorial (n := n + k - 1) (k := k - 1) (by omega)
  rw [show n + k - 1 - (k - 1) = n by omega] at h2
  have h1' : ((∏ j, (aux_countVec x j).factorial : ℕ) : ℝ) *
      (Nat.multinomial univ (aux_countVec x) : ℝ) = (n.factorial : ℝ) := by exact_mod_cast h1
  have h2' : ((n + k - 1).choose (k - 1) : ℝ) * ((k - 1).factorial : ℝ) * (n.factorial : ℝ) =
      ((n + k - 1).factorial : ℝ) := by exact_mod_cast h2
  rw [← h2', ← h1']
  have : (0 : ℝ) < (∏ j, (aux_countVec x j).factorial : ℕ) := by
    exact_mod_cast Finset.prod_pos fun j _ => Nat.factorial_pos _
  have : (0 : ℝ) < ((k - 1).factorial : ℕ) := by exact_mod_cast Nat.factorial_pos _
  have : (0 : ℝ) < (Nat.multinomial univ (aux_countVec x) : ℕ) := by
    exact_mod_cast Nat.multinomial_pos _ _
  have : (0 : ℝ) < ((n + k - 1).choose (k - 1) : ℕ) := by
    exact_mod_cast Nat.choose_pos (by omega)
  push_cast
  field_simp

/-- **Lemma `cj:probability-facts`** (part 2, equation `eq:cj-binary-face-mass`).
$$\nu_{3,n}([2]^n)=\frac{2}{n+2}.$$ -/
theorem cj_probability_facts_binary_face_mass (n : ℕ) :
    equalSlices 3 (binaryCube n) = 2 / ((n : ℝ) + 2) := by
  unfold equalSlices
  rw [Fintype.card_fin, aux_card_antidiagonalTuple]
  have hterm : ∀ a ∈ Finset.Nat.antidiagonalTuple 3 n,
      (((binaryCube n).filter fun x => aux_countVec x = a).card : ℝ) /
        ((univ.filter fun x : Fin n → Fin 3 => aux_countVec x = a).card : ℝ) =
      if a 2 = 0 then 1 else 0 := by
    intro a ha
    have hpos := aux_card_slice_pos (X := Fin n) (k := 3) (a := a) (by rwa [Fintype.card_fin])
    split_ifs with h2
    · rw [show ((binaryCube n).filter fun x => aux_countVec x = a) =
          (univ.filter fun x : Fin n → Fin 3 => aux_countVec x = a) by
        ext x; simp only [mem_filter, mem_univ, true_and, and_iff_right_iff_imp]
        intro hx; rw [aux_mem_binaryCube_iff, hx, h2]]
      exact div_self (by exact_mod_cast hpos.ne')
    · rw [show ((binaryCube n).filter fun x => aux_countVec x = a) = ∅ by
        ext x; simp only [mem_filter, Finset.notMem_empty, iff_false, not_and]
        intro hx hxa; rw [aux_mem_binaryCube_iff, hxa] at hx; exact h2 hx]
      simp
  rw [sum_congr rfl hterm, ← sum_filter, sum_const, nsmul_eq_mul, mul_one]
  have hcount : ((Finset.Nat.antidiagonalTuple 3 n).filter fun a => a 2 = 0).card = n + 1 := by
    rw [← Finset.Nat.card_antidiagonal n]
    refine Finset.card_bij' (fun a _ => (a 0, a 1)) (fun p _ => ![p.1, p.2, 0]) ?_ ?_ ?_ ?_
    · intro a ha
      rw [mem_filter, Finset.Nat.mem_antidiagonalTuple] at ha
      rw [Finset.HasAntidiagonal.mem_antidiagonal]
      simpa [Fin.sum_univ_three, ha.2] using ha.1
    · intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      simp [Finset.Nat.mem_antidiagonalTuple, Fin.sum_univ_three, hp]
    · intro a ha
      rw [mem_filter] at ha
      funext i; fin_cases i <;> simp [ha.2]
    · intro p _; simp
  rw [hcount]
  have h2 := Nat.choose_mul_factorial_mul_factorial (n := n + 2) (k := n) (by omega)
  rw [show n + 2 - n = 2 by omega, Nat.factorial_succ (n + 1), Nat.factorial_succ n] at h2
  rw [show 3 + n - 1 = n + 2 by omega]
  have h2' : ((n + 2).choose n : ℝ) * (n.factorial : ℝ) * 2 =
      ((n : ℝ) + 2) * ((n : ℝ) + 1) * (n.factorial : ℝ) := by
    have := congrArg (fun t : ℕ => (t : ℝ)) h2
    push_cast at this
    simp only [Nat.factorial_two, Nat.cast_ofNat] at this
    linarith
  have hf : (0 : ℝ) < n.factorial := by exact_mod_cast Nat.factorial_pos _
  have hc : ((n + 2).choose n : ℝ) * 2 = ((n : ℝ) + 2) * ((n : ℝ) + 1) := by
    have := h2'
    rw [mul_right_comm] at this
    exact mul_right_cancel₀ hf.ne' this
  have hc0 : ((n + 2).choose n : ℝ) ≠ 0 := by exact_mod_cast (Nat.choose_pos (by omega)).ne'
  push_cast
  field_simp
  linarith

/-- **Lemma `cj:probability-facts`** (part 3, equation `eq:cj-tv-function`).
For any $0\le h\le1$ on a finite set,
$$|\mathbb E_P h-\mathbb E_Qh|\le d_{\mathrm{TV}}(P,Q).$$ -/
theorem cj_probability_facts_tv_function {X : Type*} [Fintype X] {P Q : X → ℝ}
    (hP : aux_IsProb P) (hQ : aux_IsProb Q) {h : X → ℝ} (h0 : ∀ x, 0 ≤ h x)
    (h1 : ∀ x, h x ≤ 1) :
    |∑ x, P x * h x - ∑ x, Q x * h x| ≤ dTV P Q := by
  have hsum0 : ∑ x, (P x - Q x) = 0 := by rw [sum_sub_distrib, hP.2, hQ.2, sub_self]
  have hpos : ∀ d t : ℝ, 0 ≤ t → t ≤ 1 → d * t ≤ (|d| + d) / 2 := by
    intro d t ht0 ht1
    rcases le_total 0 d with hd | hd
    · rw [abs_of_nonneg hd]; nlinarith
    · rw [abs_of_nonpos hd]; nlinarith
  have hdiff : ∑ x, P x * h x - ∑ x, Q x * h x = ∑ x, (P x - Q x) * h x := by
    rw [← sum_sub_distrib]; exact sum_congr rfl fun x _ => by ring
  unfold dTV
  rw [hdiff, abs_le]
  constructor
  · have : ∑ x, (Q x - P x) * h x ≤ ∑ x, (|Q x - P x| + (Q x - P x)) / 2 :=
      sum_le_sum fun x _ => hpos _ _ (h0 x) (h1 x)
    rw [← sum_div, sum_add_distrib] at this
    have e1 : ∑ x, (Q x - P x) = 0 := by
      rw [← neg_eq_zero, ← sum_neg_distrib]; simpa using hsum0
    have e2 : ∑ x, |Q x - P x| = ∑ x, |P x - Q x| := sum_congr rfl fun x _ => abs_sub_comm _ _
    have e3 : ∑ x, (Q x - P x) * h x = -∑ x, (P x - Q x) * h x := by
      rw [← sum_neg_distrib]; exact sum_congr rfl fun x _ => by ring
    rw [e1, e2, e3] at this
    linarith
  · have : ∑ x, (P x - Q x) * h x ≤ ∑ x, (|P x - Q x| + (P x - Q x)) / 2 :=
      sum_le_sum fun x _ => hpos _ _ (h0 x) (h1 x)
    rw [← sum_div, sum_add_distrib, hsum0] at this
    linarith

/-- **Lemma `cj:probability-facts`** (part 4, mixtures).
If $P=\sum_j a_jP_j$, where $a_j\ge0$ and $\sum_j a_j=1$, then
$$d_{\mathrm{TV}}(P,Q)\le\sum_j a_jd_{\mathrm{TV}}(P_j,Q).$$ -/
theorem cj_probability_facts_mixture {X ι : Type*} [Fintype X] (s : Finset ι) (a : ι → ℝ)
    (Ps : ι → X → ℝ) (Q : X → ℝ) (ha0 : ∀ j ∈ s, 0 ≤ a j) (ha1 : ∑ j ∈ s, a j = 1) :
    dTV (fun x => ∑ j ∈ s, a j * Ps j x) Q ≤ ∑ j ∈ s, a j * dTV (Ps j) Q := by
  have key : ∀ x, |∑ j ∈ s, a j * Ps j x - Q x| ≤ ∑ j ∈ s, a j * |Ps j x - Q x| := by
    intro x
    have : ∑ j ∈ s, a j * Ps j x - Q x = ∑ j ∈ s, a j * (Ps j x - Q x) := by
      simp only [mul_sub, sum_sub_distrib, ← sum_mul, ha1, one_mul]
    rw [this]
    refine (abs_sum_le_sum_abs _ _).trans (le_of_eq (sum_congr rfl fun j hj => ?_))
    rw [abs_mul, abs_of_nonneg (ha0 j hj)]
  unfold dTV
  calc (1 / 2 : ℝ) * ∑ x, |∑ j ∈ s, a j * Ps j x - Q x|
      ≤ (1 / 2 : ℝ) * ∑ x, ∑ j ∈ s, a j * |Ps j x - Q x| := by
        gcongr with x _
        exact key x
    _ = ∑ j ∈ s, a j * ((1 / 2 : ℝ) * ∑ x, |Ps j x - Q x|) := by
        rw [sum_comm, mul_sum]
        refine sum_congr rfl fun j _ => ?_
        rw [mul_sum, mul_sum, mul_sum]
        refine sum_congr rfl fun x _ => ?_
        ring

/-! ### Random coordinate restriction (`cj:restriction`) -/

/-- The set of coordinates of `[n]` outside the image of an injection `ι : [r] → [n]`
(auxiliary for `\label{cj:restriction}`; a word `y` "on the complement of the image" is a
function `aux_Compl ι → Fin k`). -/
@[nolint defsWithUnderscore]
abbrev aux_Compl {r n : ℕ} (ι : Fin r ↪ Fin n) : Type :=
  {i : Fin n // ¬ ∃ j, ι j = i}

/-- The coordinate-restriction map $\phi_{\iota,y}:[k]^r\to[k]^n$, putting the $j$th input
letter in coordinate $\iota(j)$ and the prescribed letters $y$ in all remaining coordinates
(part of `\label{cj:restriction}`). -/
def restrictMap {k r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k)
    (w : Fin r → Fin k) : Fin n → Fin k :=
  fun i => if h : ∃ j, ι j = i then w (ι.invOfMemRange ⟨i, h⟩) else y ⟨i, h⟩

/-- The trace $A_{\iota,y}=\phi_{\iota,y}^{-1}(A)\subseteq[k]^r$ of $A\subseteq[k]^n$
(part of `\label{cj:restriction}`). -/
def restrictPre {k r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k)
    (A : Finset (Fin n → Fin k)) : Finset (Fin r → Fin k) :=
  univ.filter fun w => restrictMap ι y w ∈ A

/-- The law of $\phi_{\iota,y}(w)$ when $\iota$ is uniform among the injections $[r]\to[n]$,
$y$ (on the complement of the image of $\iota$) has law `yLaw ι`, and $w\in[k]^r$ independently
has law `wLaw` (auxiliary for `\label{cj:transfer-uniform}` and `\label{cj:transfer-equal}`). -/
@[nolint defsWithUnderscore]
def aux_restrictLaw {k r n : ℕ} (yLaw : (ι : Fin r ↪ Fin n) → (aux_Compl ι → Fin k) → ℝ)
    (wLaw : (Fin r → Fin k) → ℝ) (z : Fin n → Fin k) : ℝ :=
  ∑ ι : Fin r ↪ Fin n, ∑ y : aux_Compl ι → Fin k, ∑ w : Fin r → Fin k,
    (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y * wLaw w *
      if restrictMap ι y w = z then 1 else 0

/-! ### Inserting letters into uniform background (`cj:transfer-uniform`) -/

/-- Characterization of the fibres of the coordinate-restriction map: $\phi_{\iota,y}(w)=z$ iff
$z\circ\iota=w$ and $y$ is the restriction of $z$ (auxiliary for `cj_transfer_uniform` and
`cj_transfer_equal`). -/
theorem aux_restrictMap_eq_iff {k r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k)
    (w : Fin r → Fin k) (z : Fin n → Fin k) :
    restrictMap ι y w = z ↔ (∀ a, z (ι a) = w a) ∧ y = fun i => z i.1 := by
  have h1 : ∀ a, restrictMap ι y w (ι a) = w a := by
    intro a
    have h : ∃ j, ι j = ι a := ⟨a, rfl⟩
    simp only [restrictMap, dif_pos h]
    congr 1
    exact ι.right_inv_of_invOfMemRange a
  have h2 : ∀ i : aux_Compl ι, restrictMap ι y w i.1 = y i := by
    intro i
    simp only [restrictMap, dif_neg i.2]
  constructor
  · rintro rfl
    exact ⟨h1, funext fun i => (h2 i).symm⟩
  · rintro ⟨hz, rfl⟩
    funext i
    by_cases h : ∃ j, ι j = i
    · obtain ⟨a, rfl⟩ := h
      rw [h1, hz]
    · exact h2 ⟨i, h⟩

/-- Summing over the background word $y$ the indicator of $\phi_{\iota,y}(w)=z$ (auxiliary for
`cj_transfer_uniform` and `cj_transfer_equal`). -/
theorem aux_sum_restrictMap {k r n : ℕ} (ι : Fin r ↪ Fin n) (f : (aux_Compl ι → Fin k) → ℝ)
    (w : Fin r → Fin k) (z : Fin n → Fin k) :
    ∑ y : aux_Compl ι → Fin k, f y * (if restrictMap ι y w = z then 1 else 0) =
      if (∀ a, z (ι a) = w a) then f (fun i => z i.1) else 0 := by
  simp only [aux_restrictMap_eq_iff, mul_ite, mul_one, mul_zero]
  by_cases h : ∀ a, z (ι a) = w a
  · simp [h]
  · simp [h]

/-- The law of $\phi_{\iota,y}(w)$ is a probability (auxiliary for `cj_transfer_uniform` and
`cj_transfer_equal`). -/
theorem aux_restrictLaw_isProb {k r n : ℕ} (hrn : r ≤ n)
    (yLaw : (ι : Fin r ↪ Fin n) → (aux_Compl ι → Fin k) → ℝ) (hy : ∀ ι, aux_IsProb (yLaw ι))
    (wLaw : (Fin r → Fin k) → ℝ) (hw : aux_IsProb wLaw) :
    aux_IsProb (aux_restrictLaw yLaw wLaw) := by
  have hD : (0 : ℝ) < Fintype.card (Fin r ↪ Fin n) := by
    rw [Fintype.card_embedding_eq]; simp only [Fintype.card_fin]
    exact_mod_cast Nat.descFactorial_pos.2 hrn
  refine ⟨fun z => ?_, ?_⟩
  · unfold aux_restrictLaw
    refine sum_nonneg fun ι _ => sum_nonneg fun y _ => sum_nonneg fun w _ => ?_
    have := (hy ι).1 y; have := hw.1 w
    positivity
  · unfold aux_restrictLaw
    have : ∀ (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k) (w : Fin r → Fin k),
        ∑ z : Fin n → Fin k, (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y * wLaw w *
          (if restrictMap ι y w = z then 1 else 0) =
        (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y * wLaw w := by
      intro ι y w
      rw [← mul_sum, sum_ite_eq]; simp
    rw [sum_comm]
    have h2 : ∀ ι : Fin r ↪ Fin n, (∑ z : Fin n → Fin k, ∑ y : aux_Compl ι → Fin k,
        ∑ w : Fin r → Fin k, (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y * wLaw w *
          (if restrictMap ι y w = z then 1 else 0)) =
        ∑ y, ∑ w, (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y * wLaw w := by
      intro ι
      rw [sum_comm]
      refine sum_congr rfl fun y _ => ?_
      rw [sum_comm]
      exact sum_congr rfl fun w _ => this ι y w
    rw [sum_congr rfl fun ι _ => h2 ι]
    have h3 : ∀ ι : Fin r ↪ Fin n,
        ∑ y, ∑ w, (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y * wLaw w =
          (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ := by
      intro ι
      rw [sum_congr rfl fun y _ => (mul_sum _ _ _).symm]
      rw [← sum_mul, ← mul_sum, (hy ι).2, hw.2, mul_one, mul_one]
    rw [sum_congr rfl fun ι _ => h3 ι, sum_const, card_univ, nsmul_eq_mul]
    exact mul_inv_cancel₀ hD.ne'

/-- The complement of the image of an injection $[r]\to[n]$ has $n-r$ elements (auxiliary for
`cj_transfer_uniform` and `cj_transfer_equal`). -/
theorem aux_card_Compl {r n : ℕ} (ι : Fin r ↪ Fin n) : Fintype.card (aux_Compl ι) = n - r := by
  unfold aux_Compl
  rw [Fintype.card_subtype_compl, Fintype.card_fin]
  congr 1
  have e : {x // ∃ j, ι j = x} ≃ Fin r := (Equiv.ofInjective ι ι.injective).symm
  rw [Fintype.card_congr e, Fintype.card_fin]

/-- The law of $\phi_{\iota,y}(w)$ for a fixed inserted word $w$ (auxiliary for
`cj_transfer_uniform` and `cj_transfer_equal`). -/
theorem aux_restrictLaw_delta {k r n : ℕ}
    (yLaw : (ι : Fin r ↪ Fin n) → (aux_Compl ι → Fin k) → ℝ) (w : Fin r → Fin k)
    (z : Fin n → Fin k) :
    aux_restrictLaw yLaw (fun w' => if w' = w then 1 else 0) z =
      ∑ ι : Fin r ↪ Fin n, ∑ y : aux_Compl ι → Fin k,
        (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y *
          (if restrictMap ι y w = z then 1 else 0) := by
  unfold aux_restrictLaw
  refine sum_congr rfl fun ι _ => sum_congr rfl fun y _ => ?_
  rw [sum_eq_single w]
  · simp
  · intro b _ hb; simp [hb]
  · simp

/-- The law of $\phi_{\iota,y}(w)$ for $w\sim\lambda$ is the $\lambda$-mixture of the laws for fixed
$w$ (auxiliary for `cj_transfer_uniform`). -/
theorem aux_restrictLaw_mix {k r n : ℕ}
    (yLaw : (ι : Fin r ↪ Fin n) → (aux_Compl ι → Fin k) → ℝ) (lam : (Fin r → Fin k) → ℝ)
    (z : Fin n → Fin k) :
    aux_restrictLaw yLaw lam z =
      ∑ w, lam w * aux_restrictLaw yLaw (fun w' => if w' = w then 1 else 0) z := by
  simp only [aux_restrictLaw_delta]
  unfold aux_restrictLaw
  simp_rw [mul_sum]
  rw [sum_comm]
  refine sum_congr rfl fun ι _ => ?_
  rw [sum_comm]
  refine sum_congr rfl fun y _ => sum_congr rfl fun w _ => ?_
  ring

/-- Explicit form of the output law for a fixed inserted word in uniform background (auxiliary for
`cj_transfer_uniform`). -/
theorem aux_restrictLaw_unif_delta {k r n : ℕ} (w : Fin r → Fin k) (z : Fin n → Fin k) :
    aux_restrictLaw (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
        (fun w' => if w' = w then 1 else 0) z =
      ∑ ι : Fin r ↪ Fin n, (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * ((k : ℝ) ^ (n - r))⁻¹ *
        (if ∀ a, z (ι a) = w a then 1 else 0) := by
  rw [aux_restrictLaw_delta]
  refine sum_congr rfl fun ι _ => ?_
  rw [aux_sum_restrictMap (f := fun _ => (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ *
    ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹), aux_card_Compl]
  split_ifs <;> simp

/-- If the words of `T` are determined by their letters off `S`, then $|T|\,k^{|S|}\le k^n$
(auxiliary counting bound for `cj_transfer_uniform`). -/
theorem aux_card_mul_pow_le {n k : ℕ} (S : Finset (Fin n)) (T : Finset (Fin n → Fin k))
    (hT : ∀ z ∈ T, ∀ z' ∈ T, (∀ i, i ∉ S → z i = z' i) → z = z') :
    T.card * k ^ S.card ≤ k ^ n := by
  have h1 : T.card ≤ k ^ (n - S.card) := by
    calc T.card ≤ (univ : Finset ({i // i ∉ S} → Fin k)).card :=
          card_le_card_of_injOn (fun z i => z i.1) (fun _ _ => by simp)
            (fun z hz z' hz' h => hT z hz z' hz' fun i hi => congrFun h ⟨i, hi⟩)
      _ = k ^ (n - S.card) := by
          rw [card_univ, Fintype.card_fun, Fintype.card_fin]
          congr 1
          rw [Fintype.card_subtype_compl, Fintype.card_fin]
          simp
  have h2 : S.card ≤ n := by simpa using card_le_univ S
  calc T.card * k ^ S.card ≤ k ^ (n - S.card) * k ^ S.card := Nat.mul_le_mul_right _ h1
    _ = k ^ n := by rw [← pow_add, Nat.sub_add_cancel h2]

/-- Each value $\iota(b)=p$ is taken by exactly a $1/n$ fraction of the injections $[r]\to[n]$
(auxiliary for `cj_transfer_uniform`). -/
theorem aux_card_emb_fiber {r n : ℕ} (b : Fin r) (p : Fin n) :
    n * (univ.filter fun ι : Fin r ↪ Fin n => ι b = p).card = Fintype.card (Fin r ↪ Fin n) := by
  have heq : ∀ p' : Fin n, (univ.filter fun ι : Fin r ↪ Fin n => ι b = p').card =
      (univ.filter fun ι : Fin r ↪ Fin n => ι b = p).card := by
    intro p'
    refine card_nbij' (fun ι => ι.trans (Equiv.swap p p').toEmbedding)
      (fun ι => ι.trans (Equiv.swap p p').toEmbedding) ?_ ?_ ?_ ?_
    · intro ι hι
      simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hι ⊢
      simp [hι]
    · intro ι hι
      simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hι ⊢
      simp [hι]
    · intro ι _; ext a; simp
    · intro ι _; ext a; simp
  conv_rhs => rw [← card_univ, card_eq_sum_card_fiberwise (f := fun ι : Fin r ↪ Fin n => ι b)
    (t := univ) (fun _ _ => mem_univ _)]
  rw [sum_congr rfl fun p' _ => heq p', sum_const, card_univ, Fintype.card_fin, smul_eq_mul]

/-- The number of pairs of injections $[r]\to[n]$ with intersecting images is at most $r^2(n)_r^2/n$
(auxiliary for `cj_transfer_uniform`). -/
theorem aux_overlap_count {r n : ℕ} :
    (∑ ι : Fin r ↪ Fin n, ∑ ι' : Fin r ↪ Fin n,
      (if Disjoint (univ.map ι) (univ.map ι') then 0 else 1 : ℝ)) * n ≤
      (r : ℝ) ^ 2 * (Fintype.card (Fin r ↪ Fin n) : ℝ) ^ 2 := by
  have hpt : ∀ ι ι' : Fin r ↪ Fin n,
      (if Disjoint (univ.map ι) (univ.map ι') then 0 else 1 : ℝ) ≤
        ∑ a : Fin r, ∑ b : Fin r, (if ι' b = ι a then 1 else 0 : ℝ) := by
    intro ι ι'
    split_ifs with h
    · exact sum_nonneg fun _ _ => sum_nonneg fun _ _ => by split_ifs <;> norm_num
    · rw [Finset.not_disjoint_iff] at h
      obtain ⟨x, hx, hx'⟩ := h
      simp only [mem_map, mem_univ, true_and] at hx hx'
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, hb⟩ := hx'
      calc (1 : ℝ) = if ι' b = ι a then 1 else 0 := by rw [if_pos hb]
        _ ≤ ∑ b' : Fin r, (if ι' b' = ι a then 1 else 0 : ℝ) :=
            single_le_sum (f := fun b' => (if ι' b' = ι a then 1 else 0 : ℝ))
              (fun _ _ => by split_ifs <;> norm_num) (mem_univ b)
        _ ≤ ∑ a' : Fin r, ∑ b' : Fin r, (if ι' b' = ι a' then 1 else 0 : ℝ) :=
            single_le_sum (f := fun a' => ∑ b' : Fin r, (if ι' b' = ι a' then 1 else 0 : ℝ))
              (fun _ _ => sum_nonneg fun _ _ => by split_ifs <;> norm_num) (mem_univ a)
  have hcount : ∀ (ι : Fin r ↪ Fin n) (a b : Fin r),
      (∑ ι' : Fin r ↪ Fin n, (if ι' b = ι a then 1 else 0 : ℝ)) * n =
        (Fintype.card (Fin r ↪ Fin n) : ℝ) := by
    intro ι a b
    rw [← Finset.natCast_card_filter, mul_comm]
    exact_mod_cast aux_card_emb_fiber b (ι a)
  calc (∑ ι : Fin r ↪ Fin n, ∑ ι' : Fin r ↪ Fin n,
      (if Disjoint (univ.map ι) (univ.map ι') then 0 else 1 : ℝ)) * n
      ≤ (∑ ι : Fin r ↪ Fin n, ∑ ι' : Fin r ↪ Fin n,
          ∑ a : Fin r, ∑ b : Fin r, (if ι' b = ι a then 1 else 0 : ℝ)) * n := by
        gcongr with ι _ ι' _
        exact hpt ι ι'
    _ = ∑ ι : Fin r ↪ Fin n, ∑ a : Fin r, ∑ b : Fin r,
          (∑ ι' : Fin r ↪ Fin n, (if ι' b = ι a then 1 else 0 : ℝ)) * n := by
        rw [sum_mul]
        refine sum_congr rfl fun ι _ => ?_
        rw [sum_comm, sum_mul]
        refine sum_congr rfl fun a _ => ?_
        rw [sum_comm, sum_mul]
    _ = (r : ℝ) ^ 2 * (Fintype.card (Fin r ↪ Fin n) : ℝ) ^ 2 := by
        simp only [hcount, sum_const, card_univ, nsmul_eq_mul, Fintype.card_fin]
        ring

/-- Second-moment counting: the number of words $z$ with $z\circ\iota=z\circ\iota'=w$ is at most
$k^{n-2r}$ for disjoint images and at most $k^{n-r}$ otherwise (auxiliary for
`cj_transfer_uniform`). -/
theorem aux_pair_count {k r n : ℕ} (hk : 1 ≤ k) (w : Fin r → Fin k) (ι ι' : Fin r ↪ Fin n) :
    (∑ z : Fin n → Fin k, (if ∀ a, z (ι a) = w a then 1 else 0 : ℝ) *
        (if ∀ a, z (ι' a) = w a then 1 else 0 : ℝ)) ≤
      (k : ℝ) ^ n / ((k : ℝ) ^ r) ^ 2 +
        (if Disjoint (univ.map ι) (univ.map ι') then 0 else 1 : ℝ) * ((k : ℝ) ^ n / (k : ℝ) ^ r)
    := by
  have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
  have hK : (0 : ℝ) < (k : ℝ) ^ n := by positivity
  have hR : (0 : ℝ) < (k : ℝ) ^ r := by positivity
  set T := univ.filter fun z : Fin n → Fin k => (∀ a, z (ι a) = w a) ∧ (∀ a, z (ι' a) = w a)
  have hsum : (∑ z : Fin n → Fin k, (if ∀ a, z (ι a) = w a then 1 else 0 : ℝ) *
        (if ∀ a, z (ι' a) = w a then 1 else 0 : ℝ)) = (T.card : ℝ) := by
    rw [natCast_card_filter]
    refine sum_congr rfl fun z _ => ?_
    by_cases h1 : ∀ a, z (ι a) = w a <;> by_cases h2 : ∀ a, z (ι' a) = w a <;> simp [h1, h2]
  rw [hsum]
  have hagree : ∀ S : Finset (Fin n), (∀ i ∈ S, ∀ z ∈ T, ∀ z' ∈ T, z i = z' i) →
      (T.card : ℝ) * (k : ℝ) ^ S.card ≤ (k : ℝ) ^ n := by
    intro S hS
    have := aux_card_mul_pow_le S T fun z hz z' hz' h => funext fun i => by
      by_cases hi : i ∈ S
      · exact hS i hi z hz z' hz'
      · exact h i hi
    exact_mod_cast this
  have hT1 : (T.card : ℝ) * (k : ℝ) ^ r ≤ (k : ℝ) ^ n := by
    have := hagree (univ.map ι) (by
      intro i hi z hz z' hz'
      simp only [mem_map, mem_univ, true_and] at hi
      obtain ⟨a, rfl⟩ := hi
      simp only [T, mem_filter, mem_univ, true_and] at hz hz'
      rw [hz.1, hz'.1])
    simpa using this
  split_ifs with hdisj
  · have := hagree (univ.map ι ∪ univ.map ι') (by
      intro i hi z hz z' hz'
      simp only [mem_union, mem_map, mem_univ, true_and] at hi
      simp only [T, mem_filter, mem_univ, true_and] at hz hz'
      rcases hi with ⟨a, rfl⟩ | ⟨a, rfl⟩
      · rw [hz.1, hz'.1]
      · rw [hz.2, hz'.2])
    rw [card_union_of_disjoint hdisj] at this
    simp only [card_map, card_univ, Fintype.card_fin] at this
    rw [zero_mul, add_zero, le_div_iff₀ (by positivity)]
    have e : ((k : ℝ) ^ r) ^ 2 = (k : ℝ) ^ (r + r) := by ring
    rw [e]; exact this
  · rw [one_mul]
    have : (T.card : ℝ) ≤ (k : ℝ) ^ n / (k : ℝ) ^ r := by rw [le_div_iff₀ hR]; exact hT1
    have : 0 ≤ (k : ℝ) ^ n / ((k : ℝ) ^ r) ^ 2 := by positivity
    linarith

/-- The uniform background law is a probability (auxiliary for `cj_transfer_uniform`). -/
theorem aux_unif_yLaw_isProb {k r n : ℕ} (hk : 1 ≤ k) (ι : Fin r ↪ Fin n) :
    aux_IsProb (fun _ : aux_Compl ι → Fin k => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹) := by
  have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
  refine ⟨fun _ => by positivity, ?_⟩
  rw [sum_const, card_univ, Fintype.card_fun, Fintype.card_fin, nsmul_eq_mul]
  push_cast
  exact mul_inv_cancel₀ (by positivity)

/-- A point mass is a probability (auxiliary for `cj_transfer_uniform`). -/
theorem aux_delta_isProb {k r : ℕ} (w : Fin r → Fin k) :
    aux_IsProb (fun w' : Fin r → Fin k => if w' = w then (1 : ℝ) else 0) :=
  ⟨fun _ => by dsimp only; split_ifs <;> norm_num, by simp⟩

/-- Second-moment bound for a fixed inserted word: $d_{\mathrm{TV}}(P_w,\mu_{k,n})^2\le r^2k^r/(4n)$
(auxiliary for `cj:transfer-uniform`, `cj_transfer_uniform`; replaces the blueprint's
Chebyshev/convergence-in-probability argument). -/
theorem aux_tv_unif_delta_sq {k r n : ℕ} (hk : 1 ≤ k) (hrn : r ≤ n) (hn : 0 < n)
    (w : Fin r → Fin k) :
    (dTV (aux_restrictLaw (n := n) (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
        (fun w' => if w' = w then 1 else 0)) (fun _ => ((k : ℝ) ^ n)⁻¹)) ^ 2 ≤
      (r : ℝ) ^ 2 * (k : ℝ) ^ r / (4 * n) := by
  set P := aux_restrictLaw (n := n) (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
    (fun w' => if w' = w then 1 else 0) with hPdef
  have hP : aux_IsProb P :=
    aux_restrictLaw_isProb hrn _ (fun ι => aux_unif_yLaw_isProb hk ι) _ (aux_delta_isProb w)
  have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
  set K : ℝ := (k : ℝ) ^ n with hKdef
  set R : ℝ := (k : ℝ) ^ r with hRdef
  set D : ℝ := (Fintype.card (Fin r ↪ Fin n) : ℝ) with hDdef
  have hK : 0 < K := by positivity
  have hR : 0 < R := by positivity
  have hD : 0 < D := by
    rw [hDdef, Fintype.card_embedding_eq]; simp only [Fintype.card_fin]
    exact_mod_cast Nat.descFactorial_pos.2 hrn
  have hnr : (k : ℝ) ^ (n - r) = K / R := by
    rw [pow_sub₀ _ hkpos.ne' hrn, div_eq_mul_inv]
  set e : (Fin r ↪ Fin n) → (Fin n → Fin k) → ℝ :=
    fun ι z => if ∀ a, z (ι a) = w a then 1 else 0 with hedef
  have hPz : ∀ z, P z = ∑ ι, D⁻¹ * (R / K) * e ι z := by
    intro z
    rw [hPdef, aux_restrictLaw_unif_delta, hnr, inv_div]
  -- Step A: second moment
  set O : ℝ := ∑ ι : Fin r ↪ Fin n, ∑ ι' : Fin r ↪ Fin n,
      (if Disjoint (univ.map ι) (univ.map ι') then 0 else 1 : ℝ) with hOdef
  have hO : O * n ≤ (r : ℝ) ^ 2 * D ^ 2 := aux_overlap_count
  have hO0 : 0 ≤ O := sum_nonneg fun _ _ => sum_nonneg fun _ _ => by split_ifs <;> norm_num
  have hA : ∑ z, P z ^ 2 ≤ 1 / K + (r : ℝ) ^ 2 * R / (n * K) := by
    have hexp : ∑ z, P z ^ 2 = (D⁻¹ * (R / K)) ^ 2 *
        ∑ ι, ∑ ι', ∑ z, e ι z * e ι' z := by
      simp_rw [hPz, sq, sum_mul_sum, mul_sum]
      rw [sum_comm]
      refine sum_congr rfl fun ι _ => ?_
      rw [sum_comm]
      refine sum_congr rfl fun ι' _ => sum_congr rfl fun z _ => ?_
      ring
    have hb : ∑ ι, ∑ ι', ∑ z, e ι z * e ι' z ≤
        ∑ ι : Fin r ↪ Fin n, ∑ ι' : Fin r ↪ Fin n, (K / R ^ 2 +
          (if Disjoint (univ.map ι) (univ.map ι') then 0 else 1 : ℝ) * (K / R)) :=
      sum_le_sum fun ι _ => sum_le_sum fun ι' _ => aux_pair_count hk w ι ι'
    have hb' : ∑ ι : Fin r ↪ Fin n, ∑ ι' : Fin r ↪ Fin n, (K / R ^ 2 +
          (if Disjoint (univ.map ι) (univ.map ι') then 0 else 1 : ℝ) * (K / R)) =
        D ^ 2 * (K / R ^ 2) + O * (K / R) := by
      simp only [sum_add_distrib, ← sum_mul, sum_const, card_univ, nsmul_eq_mul, hOdef, hDdef]
      ring
    rw [hexp]
    calc (D⁻¹ * (R / K)) ^ 2 * ∑ ι, ∑ ι', ∑ z, e ι z * e ι' z
        ≤ (D⁻¹ * (R / K)) ^ 2 * (D ^ 2 * (K / R ^ 2) + O * (K / R)) := by
          rw [← hb']; gcongr
      _ = 1 / K + O * R / (D ^ 2 * K) := by field_simp
      _ ≤ 1 / K + (r : ℝ) ^ 2 * R / (n * K) := by
          gcongr ?_ + ?_
          · exact le_refl _
          rw [div_le_div_iff₀ (by positivity) (by positivity)]
          have hnpos : (0 : ℝ) < n := by exact_mod_cast hn
          calc O * R * (n * K) = (O * n) * (R * K) := by ring
            _ ≤ ((r : ℝ) ^ 2 * D ^ 2) * (R * K) := by gcongr
            _ = (r : ℝ) ^ 2 * R * (D ^ 2 * K) := by ring
  -- Step B
  have hcardW : ((univ : Finset (Fin n → Fin k)).card : ℝ) = K := by
    rw [card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin]; push_cast; rfl
  have hB : ∑ z, (P z - K⁻¹) ^ 2 = ∑ z, P z ^ 2 - 1 / K := by
    have : ∀ z, (P z - K⁻¹) ^ 2 = P z ^ 2 - 2 * K⁻¹ * P z + K⁻¹ ^ 2 := fun z => by ring
    simp_rw [this, sum_add_distrib, sum_sub_distrib, ← mul_sum, hP.2, sum_const, nsmul_eq_mul,
      hcardW]
    field_simp
    ring
  -- Step C
  have hC : (∑ z, |P z - K⁻¹|) ^ 2 ≤ K * ∑ z, (P z - K⁻¹) ^ 2 := by
    have := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (Fin n → Fin k)))
      (f := fun z => |P z - K⁻¹|)
    simpa only [sq_abs, hcardW] using this
  unfold dTV
  have hnpos : (0 : ℝ) < n := by exact_mod_cast hn
  calc ((1 / 2 : ℝ) * ∑ z, |P z - K⁻¹|) ^ 2 = (1 / 4) * (∑ z, |P z - K⁻¹|) ^ 2 := by ring
    _ ≤ (1 / 4) * (K * ((r : ℝ) ^ 2 * R / (n * K))) := by
        gcongr
        refine hC.trans ?_
        gcongr
        rw [hB]; linarith
    _ = (r : ℝ) ^ 2 * R / (4 * n) := by field_simp

/-- **Lemma `cj:transfer-uniform`** (Inserting a fixed number of letters into uniform
background).
Fix $k\in\{2,3\}$, $r\ge1$, and $\zeta>0$.  There is $N=N(k,r,\zeta)\ge r$ such that the
following holds for every $n\ge N$.  Choose $\iota$ as in Definition `cj:restriction`, give the
remaining coordinates independent uniform letters, and independently choose $w\in[k]^r$ with any
probability distribution $\lambda$.  The law of $\phi_{\iota,y}(w)$ is within $\zeta$ in total
variation of $\mu_{k,n}$.  The same $N$ works for every $\lambda$.
(In Lean the blueprint hypothesis `(hr : 1 ≤ r)` is omitted since the proof does not need it; see
`automation/ErrorReport.md`.) -/
theorem cj_transfer_uniform {k : ℕ} (hk : k = 2 ∨ k = 3) {r : ℕ} {ζ : ℝ}
    (hζ : 0 < ζ) :
    ∃ N ≥ r, ∀ n ≥ N, ∀ lam : (Fin r → Fin k) → ℝ, aux_IsProb lam →
      dTV (aux_restrictLaw (n := n)
          (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹) lam)
        (fun _ => ((k : ℝ) ^ n)⁻¹) ≤ ζ := by
  have hk1 : 1 ≤ k := by rcases hk with rfl | rfl <;> norm_num
  refine ⟨max r (⌈(r : ℝ) ^ 2 * (k : ℝ) ^ r / (4 * ζ ^ 2)⌉₊ + 1), le_max_left _ _, ?_⟩
  intro n hn lam hlam
  have hrn : r ≤ n := (le_max_left _ _).trans hn
  have hn1 : ⌈(r : ℝ) ^ 2 * (k : ℝ) ^ r / (4 * ζ ^ 2)⌉₊ + 1 ≤ n := (le_max_right _ _).trans hn
  have hnpos : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have hbig : (r : ℝ) ^ 2 * (k : ℝ) ^ r / (4 * ζ ^ 2) ≤ n := by
    refine (Nat.le_ceil _).trans ?_
    exact_mod_cast (Nat.le_succ _).trans hn1
  have hw : ∀ w : Fin r → Fin k,
      dTV (aux_restrictLaw (n := n) (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
        (fun w' => if w' = w then 1 else 0)) (fun _ => ((k : ℝ) ^ n)⁻¹) ≤ ζ := by
    intro w
    have hsq := aux_tv_unif_delta_sq hk1 hrn hnpos w
    set t := dTV (aux_restrictLaw (n := n)
      (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
        (fun w' => if w' = w then 1 else 0)) (fun _ => ((k : ℝ) ^ n)⁻¹)
    have ht0 : 0 ≤ t := by
      unfold t dTV; exact mul_nonneg (by norm_num) (sum_nonneg fun _ _ => abs_nonneg _)
    have : (r : ℝ) ^ 2 * (k : ℝ) ^ r / (4 * n) ≤ ζ ^ 2 := by
      rw [div_le_iff₀ (by positivity)]
      rw [div_le_iff₀ (by positivity)] at hbig
      nlinarith
    nlinarith
  have hmix : aux_restrictLaw (n := n) (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
      lam = fun z => ∑ w ∈ univ, lam w * aux_restrictLaw (n := n)
        (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
        (fun w' => if w' = w then 1 else 0) z :=
    funext fun z => aux_restrictLaw_mix _ _ _
  rw [hmix]
  refine (cj_probability_facts_mixture univ lam _ _ (fun w _ => hlam.1 w) hlam.2).trans ?_
  calc ∑ w ∈ univ, lam w * dTV (aux_restrictLaw (n := n)
        (fun ι _ => ((k : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
        (fun w' => if w' = w then 1 else 0)) (fun _ => ((k : ℝ) ^ n)⁻¹)
      ≤ ∑ w ∈ univ, lam w * ζ := sum_le_sum fun w _ => mul_le_mul_of_nonneg_left (hw w) (hlam.1 w)
    _ = ζ := by rw [← sum_mul, hlam.2, one_mul]

/-! ### Inserting letters into equal-slices background (`cj:transfer-equal`) -/

/-- If $z\circ\iota=w$, the letter counts of $z$ off the image of $\iota$ are $a_j-c_j$ (auxiliary
for `cj:transfer-equal`, `cj_transfer_equal`). -/
theorem aux_countVec_compl {k r m : ℕ} (ι : Fin r ↪ Fin m) (w : Fin r → Fin k)
    (z : Fin m → Fin k) (hz : ∀ a, z (ι a) = w a) (j : Fin k) :
    aux_countVec (fun i : aux_Compl ι => z i.1) j + aux_countVec w j = aux_countVec z j := by
  unfold aux_countVec
  simp only [card_filter]
  rw [← Fintype.sum_subtype_add_sum_subtype (fun i => ∃ a, ι a = i)
    (fun i => if z i = j then 1 else 0), add_comm]
  congr 1
  refine Fintype.sum_bijective (fun a : Fin r => (⟨ι a, a, rfl⟩ : {x // ∃ a, ι a = x}))
    ⟨fun a b h => ι.injective (congrArg Subtype.val h), fun ⟨_, a, h⟩ => ⟨a, Subtype.ext h⟩⟩
    _ _ fun a => ?_
  simp only [hz]

/-- There are at most $\prod_j(a_j)_{c_j}$ injections $\iota$ with $z\circ\iota=w$ (auxiliary for
`cj:transfer-equal`, `cj_transfer_equal`). -/
theorem aux_card_good_emb {k r m : ℕ} (w : Fin r → Fin k) (z : Fin m → Fin k) :
    (univ.filter fun ι : Fin r ↪ Fin m => ∀ a, z (ι a) = w a).card ≤
      ∏ j, (aux_countVec z j).descFactorial (aux_countVec w j) := by
  rw [← Fintype.card_subtype]
  have hcard : Fintype.card (∀ j : Fin k, ({a // w a = j} ↪ {i // z i = j})) =
      ∏ j, (aux_countVec z j).descFactorial (aux_countVec w j) := by
    rw [Fintype.card_pi]
    refine prod_congr rfl fun j _ => ?_
    rw [Fintype.card_embedding_eq, Fintype.card_subtype, Fintype.card_subtype]
    rfl
  rw [← hcard]
  refine Fintype.card_le_of_injective
    (fun ι j => ⟨fun a => ⟨ι.1 a.1, by rw [ι.2 a.1, a.2]⟩, fun a b h => by
      apply Subtype.ext
      exact ι.1.injective (congrArg Subtype.val h)⟩) ?_
  intro ι ι' h
  apply Subtype.ext
  ext a
  have := congrArg (fun f => ((f (w a)) ⟨a, rfl⟩).1) h
  exact congrArg Fin.val this

/-- If $P\le C\,Q$ pointwise for probabilities $P,Q$ and $C\ge1$, then
$d_{\mathrm{TV}}(P,Q)\le1-C^{-1}$ (auxiliary for `cj:transfer-equal`, `cj_transfer_equal`). -/
theorem aux_dTV_le_of_le_mul {X : Type*} [Fintype X] {P Q : X → ℝ} (hP : aux_IsProb P)
    (hQ : aux_IsProb Q) {C : ℝ} (hC : 1 ≤ C) (hPQ : ∀ x, P x ≤ C * Q x) :
    dTV P Q ≤ 1 - 1 / C := by
  have hC0 : 0 < C := by linarith
  have hsum0 : ∑ x, (P x - Q x) = 0 := by rw [sum_sub_distrib, hP.2, hQ.2, sub_self]
  have habs : ∀ d : ℝ, |d| = 2 * max d 0 - d := by
    intro d; rcases le_total 0 d with h | h
    · rw [abs_of_nonneg h, max_eq_left h]; ring
    · rw [abs_of_nonpos h, max_eq_right h]; ring
  have hpt : ∀ x, max (P x - Q x) 0 ≤ (1 - 1 / C) * P x := by
    intro x
    have hPx := hP.1 x
    have h1 : 0 ≤ 1 - 1 / C := by
      rw [sub_nonneg, div_le_one hC0]; exact hC
    apply max_le
    · have : P x / C ≤ Q x := by rw [div_le_iff₀ hC0]; linarith [hPQ x]
      have e : (1 - 1 / C) * P x = P x - P x / C := by ring
      rw [e]; linarith
    · exact mul_nonneg h1 hPx
  unfold dTV
  simp_rw [habs]
  rw [sum_sub_distrib, hsum0, sub_zero, ← mul_sum, ← mul_assoc]
  norm_num
  calc ∑ x, max (P x - Q x) 0 ≤ ∑ x, (1 - 1 / C) * P x := sum_le_sum fun x _ => hpt x
    _ = 1 - C⁻¹ := by rw [← mul_sum, hP.2, mul_one, one_div]

/-- For a fixed inserted word, the output law is at most $C_{m,r}\,\nu_{3,m}$ pointwise,
$C_{m,r}=\frac{(m+1)(m+2)}{(m-r+1)(m-r+2)}$ (auxiliary for `cj:transfer-equal`,
`cj_transfer_equal`). -/
theorem aux_transfer_equal_pointwise {m r : ℕ} (hrm : r ≤ m) (w : Fin r → Fin 3)
    (z : Fin m → Fin 3) :
    aux_restrictLaw (n := m) (fun _ y => equalSlices 3 ({y} : Finset _))
        (fun w' => if w' = w then 1 else 0) z ≤
      ((m : ℝ) + 1) * ((m : ℝ) + 2) / (((m : ℝ) - r + 1) * ((m : ℝ) - r + 2)) *
        equalSlices 3 ({z} : Finset (Fin m → Fin 3)) := by
  set D : ℝ := (Fintype.card (Fin r ↪ Fin m) : ℝ) with hDdef
  have hD : 0 < D := by
    rw [hDdef, Fintype.card_embedding_eq]; simp only [Fintype.card_fin]
    exact_mod_cast Nat.descFactorial_pos.2 hrm
  have hmr : ((m - r : ℕ) : ℝ) = (m : ℝ) - r := Nat.cast_sub hrm
  set V : ℝ := ((2 * ∏ j, (aux_countVec z j - aux_countVec w j).factorial : ℕ) : ℝ) /
    ((m - r + 2).factorial : ℝ)
    with hVdef
  have hterm : ∀ ι : Fin r ↪ Fin m, ∑ y : aux_Compl ι → Fin 3,
      D⁻¹ * equalSlices 3 ({y} : Finset _) * (if restrictMap ι y w = z then 1 else 0) =
      if ∀ a, z (ι a) = w a then D⁻¹ * V else 0 := by
    intro ι
    rw [aux_sum_restrictMap (f := fun y => D⁻¹ * equalSlices 3 ({y} : Finset _))]
    split_ifs with hg
    · congr 1
      rw [aux_equalSlices_atom (by norm_num), aux_card_Compl, hVdef]
      congr 3
      · refine prod_congr rfl fun j _ => ?_
        have := aux_countVec_compl ι w z hg j
        congr 1
        omega
    · rfl
  rw [aux_restrictLaw_delta]
  rw [sum_congr rfl fun ι _ => hterm ι]
  rw [sum_ite, sum_const_zero, add_zero, sum_const, nsmul_eq_mul]
  set G := (univ.filter fun ι : Fin r ↪ Fin m => ∀ a, z (ι a) = w a).card with hGdef
  rw [aux_equalSlices_atom (by norm_num), Fintype.card_fin]
  rcases Nat.eq_zero_or_pos G with hG | hG
  · rw [hG]; simp only [Nat.cast_zero, zero_mul]
    have : 0 ≤ (m : ℝ) - r := by linarith [(Nat.cast_le (α := ℝ)).2 hrm]
    positivity
  obtain ⟨ι0, hι0⟩ := card_pos.1 hG
  have hι0' : ∀ a, z (ι0 a) = w a := (mem_filter.1 hι0).2
  have hca : ∀ j, aux_countVec w j ≤ aux_countVec z j := fun j => by
    have := aux_countVec_compl ι0 w z hι0' j; omega
  -- G * ∏ (a-c)! ≤ ∏ a!
  have hGle : G * ∏ j, (aux_countVec z j - aux_countVec w j).factorial ≤
      ∏ j, (aux_countVec z j).factorial := by
    calc G * ∏ j, (aux_countVec z j - aux_countVec w j).factorial
        ≤ (∏ j, (aux_countVec z j).descFactorial (aux_countVec w j)) *
            ∏ j, (aux_countVec z j - aux_countVec w j).factorial :=
          Nat.mul_le_mul_right _ (aux_card_good_emb w z)
      _ = ∏ j, (aux_countVec z j).factorial := by
          rw [← prod_mul_distrib]
          refine prod_congr rfl fun j _ => ?_
          rw [mul_comm]; exact Nat.factorial_mul_descFactorial (hca j)
  have hGle' : (G : ℝ) * (∏ j, (aux_countVec z j - aux_countVec w j).factorial : ℕ) ≤
      (∏ j, (aux_countVec z j).factorial : ℕ) := by
    exact_mod_cast hGle
  -- factorial identity
  have hDf : D * ((m - r).factorial : ℝ) = (m.factorial : ℝ) := by
    rw [hDdef, Fintype.card_embedding_eq]; simp only [Fintype.card_fin]
    rw [mul_comm]; exact_mod_cast Nat.factorial_mul_descFactorial hrm
  have hf1 : ((m - r + 2).factorial : ℝ) =
      ((m : ℝ) - r + 2) * ((m : ℝ) - r + 1) * ((m - r).factorial : ℝ) := by
    rw [show m - r + 2 = (m - r + 1) + 1 by omega, Nat.factorial_succ, Nat.factorial_succ]
    push_cast; rw [hmr]; ring
  have hf2 : ((m + 3 - 1).factorial : ℝ) =
      ((m : ℝ) + 2) * ((m : ℝ) + 1) * (m.factorial : ℝ) := by
    rw [show m + 3 - 1 = (m + 1) + 1 by omega, Nat.factorial_succ, Nat.factorial_succ]
    push_cast; ring
  have hpos1 : (0 : ℝ) < (m : ℝ) - r + 1 := by linarith [(Nat.cast_le (α := ℝ)).2 hrm]
  have hmf : (0 : ℝ) < (m - r).factorial := by exact_mod_cast Nat.factorial_pos _
  have hPa : (0 : ℝ) ≤ (∏ j, (aux_countVec z j - aux_countVec w j).factorial : ℕ) :=
    Nat.cast_nonneg _
  rw [hVdef, hf1, hf2, ← hDf]
  push_cast
  simp only [Nat.factorial_two, Nat.cast_ofNat]
  set Pa := ∏ i, ((aux_countVec z i - aux_countVec w i).factorial : ℝ)
  set Pb := ∏ i, ((aux_countVec z i).factorial : ℝ)
  set F := ((m - r).factorial : ℝ)
  have hpos2 : (0 : ℝ) < (m : ℝ) - r + 2 := by linarith
  have hm1 : (0 : ℝ) < (m : ℝ) + 1 := by positivity
  have hm2 : (0 : ℝ) < (m : ℝ) + 2 := by positivity
  have hK0 : 0 ≤ 2 / (D * F * ((m : ℝ) - r + 1) * ((m : ℝ) - r + 2)) := by positivity
  calc (G : ℝ) * (D⁻¹ * (2 * Pa / (((m : ℝ) - r + 2) * ((m : ℝ) - r + 1) * F)))
      = (2 / (D * F * ((m : ℝ) - r + 1) * ((m : ℝ) - r + 2))) * ((G : ℝ) * Pa) := by
        field_simp
    _ ≤ (2 / (D * F * ((m : ℝ) - r + 1) * ((m : ℝ) - r + 2))) * Pb :=
        mul_le_mul_of_nonneg_left (by push_cast at hGle'; exact hGle') hK0
    _ = ((m : ℝ) + 1) * ((m : ℝ) + 2) / (((m : ℝ) - r + 1) * ((m : ℝ) - r + 2)) *
          (2 * Pb / (((m : ℝ) + 2) * ((m : ℝ) + 1) * (D * F))) := by
        field_simp

/-- Equal-slices atoms are nonnegative (auxiliary for `cj_transfer_equal`). -/
theorem aux_equalSlices_atom_nonneg {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ}
    (x : X → Fin k) : 0 ≤ equalSlices k ({x} : Finset (X → Fin k)) := by
  unfold equalSlices
  refine mul_nonneg (inv_nonneg.2 (Nat.cast_nonneg _)) (sum_nonneg fun _ _ => ?_)
  exact div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)

/-- The equal-slices atoms form a probability (auxiliary for `cj_transfer_equal`). -/
theorem aux_equalSlices_isProb {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ} (hk : 1 ≤ k) :
    aux_IsProb (fun x : X → Fin k => equalSlices k ({x} : Finset (X → Fin k))) :=
  ⟨aux_equalSlices_atom_nonneg, aux_equalSlices_sum_atoms hk⟩

/-- Expectation of a function under the law of $\phi_{\iota,y}(w)$ (auxiliary for
`cj:transfer-equal`, `cj_transfer_equal_average`). -/
theorem aux_restrictLaw_expect {k r n : ℕ}
    (yLaw : (ι : Fin r ↪ Fin n) → (aux_Compl ι → Fin k) → ℝ) (wLaw : (Fin r → Fin k) → ℝ)
    (h : (Fin n → Fin k) → ℝ) :
    ∑ z, aux_restrictLaw yLaw wLaw z * h z =
      ∑ ι : Fin r ↪ Fin n, ∑ y : aux_Compl ι → Fin k, ∑ w : Fin r → Fin k,
        (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y * wLaw w * h (restrictMap ι y w) := by
  unfold aux_restrictLaw
  simp_rw [sum_mul]
  rw [sum_comm]
  refine sum_congr rfl fun ι _ => ?_
  rw [sum_comm]
  refine sum_congr rfl fun y _ => ?_
  rw [sum_comm]
  refine sum_congr rfl fun w _ => ?_
  simp only [mul_ite, mul_one, mul_zero, ite_mul, zero_mul]
  rw [sum_ite_eq]
  simp

/-- **Lemma `cj:transfer-equal`** (Inserting letters into equal-slices background; equation
`eq:cj-equal-transfer`).
Let $m\ge r\ge1$.  Choose $\iota:[r]\to[m]$ uniformly, choose $y$ on the remaining $m-r$
coordinates with probability $\nu_{3,m-r}$, and independently choose $w\in[3]^r$ with any
distribution.  If $P$ is the law of $\phi_{\iota,y}(w)$, then
$$d_{\mathrm{TV}}(P,\nu_{3,m})\le 1-\frac{(m-r+1)(m-r+2)}{(m+1)(m+2)}
\le\frac{2r}{m+1}\le\frac{3r}{m}.$$ -/
theorem cj_transfer_equal {m r : ℕ} (hr : 1 ≤ r) (hrm : r ≤ m) (lam : (Fin r → Fin 3) → ℝ)
    (hlam : aux_IsProb lam) :
    dTV (aux_restrictLaw (n := m)
          (fun _ y => equalSlices 3 ({y} : Finset _)) lam)
        (fun z => equalSlices 3 ({z} : Finset (Fin m → Fin 3))) ≤
        1 - ((m : ℝ) - r + 1) * ((m : ℝ) - r + 2) / (((m : ℝ) + 1) * ((m : ℝ) + 2)) ∧
      1 - ((m : ℝ) - r + 1) * ((m : ℝ) - r + 2) / (((m : ℝ) + 1) * ((m : ℝ) + 2)) ≤
        2 * (r : ℝ) / ((m : ℝ) + 1) ∧
      2 * (r : ℝ) / ((m : ℝ) + 1) ≤ 3 * (r : ℝ) / m := by
  have hrmR : (r : ℝ) ≤ m := by exact_mod_cast hrm
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have hpos1 : (0 : ℝ) < (m : ℝ) - r + 1 := by linarith
  have hpos2 : (0 : ℝ) < (m : ℝ) - r + 2 := by linarith
  have hm1 : (0 : ℝ) < (m : ℝ) + 1 := by linarith
  have hm2 : (0 : ℝ) < (m : ℝ) + 2 := by linarith
  have hm : (0 : ℝ) < m := by linarith
  refine ⟨?_, ?_, ?_⟩
  · set C := ((m : ℝ) + 1) * ((m : ℝ) + 2) / (((m : ℝ) - r + 1) * ((m : ℝ) - r + 2)) with hCdef
    have hC : 1 ≤ C := by
      rw [hCdef, one_le_div (by positivity)]
      nlinarith
    have hP := aux_restrictLaw_isProb hrm (fun (ι : Fin r ↪ Fin m) (y : aux_Compl ι → Fin 3) =>
      equalSlices 3 ({y} : Finset _)) (fun _ => aux_equalSlices_isProb (by norm_num)) lam hlam
    have hQ := aux_equalSlices_isProb (X := Fin m) (k := 3) (by norm_num)
    have hPQ : ∀ z, aux_restrictLaw (n := m) (fun _ y => equalSlices 3 ({y} : Finset _)) lam z ≤
        C * equalSlices 3 ({z} : Finset (Fin m → Fin 3)) := by
      intro z
      rw [aux_restrictLaw_mix]
      calc ∑ w, lam w * aux_restrictLaw (n := m) (fun _ y => equalSlices 3 ({y} : Finset _))
            (fun w' => if w' = w then 1 else 0) z
          ≤ ∑ w, lam w * (C * equalSlices 3 ({z} : Finset (Fin m → Fin 3))) :=
            sum_le_sum fun w _ => mul_le_mul_of_nonneg_left
              (aux_transfer_equal_pointwise hrm w z) (hlam.1 w)
        _ = C * equalSlices 3 ({z} : Finset (Fin m → Fin 3)) := by rw [← sum_mul, hlam.2, one_mul]
    refine (aux_dTV_le_of_le_mul hP hQ hC hPQ).trans (le_of_eq ?_)
    rw [hCdef, one_div_div]
  · rw [sub_le_iff_le_add, div_add_div _ _ hm1.ne' (by positivity), le_div_iff₀ (by positivity)]
    have : (0 : ℝ) ≤ ((m : ℝ) + 1) * ((r : ℝ) * ((r : ℝ) + 1)) := by positivity
    nlinarith
  · rw [div_le_div_iff₀ hm1 hm]
    nlinarith

/-- **Lemma `cj:transfer-equal`** (equation `eq:cj-average-uniform-slice`).
In particular, if $w$ is uniform, then for every $H\subseteq[3]^m$,
$$\left|\mathbb E_{\iota,y}\mu_{3,r}(H_{\iota,y})-\nu_{3,m}(H)\right|\le\frac{3r}{m}.$$ -/
theorem cj_transfer_equal_average {m r : ℕ} (hr : 1 ≤ r) (hrm : r ≤ m)
    (H : Finset (Fin m → Fin 3)) :
    |∑ ι : Fin r ↪ Fin m, ∑ y : aux_Compl ι → Fin 3,
        (Fintype.card (Fin r ↪ Fin m) : ℝ)⁻¹ * equalSlices 3 ({y} : Finset _) *
          unifDensity (restrictPre ι y H) - equalSlices 3 H| ≤
      3 * (r : ℝ) / m := by
  set lam : (Fin r → Fin 3) → ℝ := fun _ => ((3 : ℝ) ^ r)⁻¹ with hlamdef
  have hlam : aux_IsProb lam := by
    refine ⟨fun _ => by positivity, ?_⟩
    rw [hlamdef, sum_const, card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin,
      nsmul_eq_mul]
    push_cast
    exact mul_inv_cancel₀ (by positivity)
  have hP := aux_restrictLaw_isProb hrm (fun (ι : Fin r ↪ Fin m) (y : aux_Compl ι → Fin 3) =>
    equalSlices 3 ({y} : Finset _)) (fun _ => aux_equalSlices_isProb (by norm_num)) lam hlam
  have hQ := aux_equalSlices_isProb (X := Fin m) (k := 3) (by norm_num)
  set h : (Fin m → Fin 3) → ℝ := fun z => if z ∈ H then 1 else 0 with hhdef
  have h1 : ∑ ι : Fin r ↪ Fin m, ∑ y : aux_Compl ι → Fin 3,
      (Fintype.card (Fin r ↪ Fin m) : ℝ)⁻¹ * equalSlices 3 ({y} : Finset _) *
        unifDensity (restrictPre ι y H) =
      ∑ z, aux_restrictLaw (n := m) (fun _ y => equalSlices 3 ({y} : Finset _)) lam z * h z := by
    rw [aux_restrictLaw_expect]
    refine sum_congr rfl fun ι _ => sum_congr rfl fun y _ => ?_
    simp_rw [mul_assoc]
    rw [← mul_sum, ← mul_sum]
    congr 2
    unfold unifDensity restrictPre
    rw [natCast_card_filter, sum_div]
    refine sum_congr rfl fun w _ => ?_
    simp only [hhdef, hlamdef, Nat.cast_ofNat]
    split_ifs <;> simp [div_eq_mul_inv]
  have h2 : equalSlices 3 H = ∑ z, equalSlices 3 ({z} : Finset (Fin m → Fin 3)) * h z := by
    rw [aux_equalSlices_eq_sum]
    simp only [hhdef, mul_ite, mul_one, mul_zero]
    rw [sum_ite_mem, univ_inter]
  rw [h1, h2]
  refine (cj_probability_facts_tv_function hP hQ (fun z => by simp only [hhdef]; split_ifs <;>
    norm_num) (fun z => by simp only [hhdef]; split_ifs <;> norm_num)).trans ?_
  obtain ⟨t1, t2, t3⟩ := cj_transfer_equal hr hrm lam hlam
  exact t1.trans (t2.trans t3)

/-! ### Collapsing the third letter (`cj:collapse`) -/

/-- For $i\in\{1,2\}$ and $x\in[3]^m$, the word $x^{3\to i}\in[2]^m$ obtained by replacing
every $3$ by $i$ (part of `\label{cj:collapse}`). -/
def collapse {m : ℕ} (i : Fin 2) (x : Fin m → Fin 3) : Fin m → Fin 2 :=
  fun j => if h : (x j : ℕ) < 2 then ⟨x j, h⟩ else i

/-- $C_i(B)=\{x\in[3]^m:x^{3\to i}\in B\}$ for $B\subseteq[2]^m$
(part of `\label{cj:collapse}`). -/
def collapseSet {m : ℕ} (i : Fin 2) (B : Finset (Fin m → Fin 2)) : Finset (Fin m → Fin 3) :=
  univ.filter fun x => collapse i x ∈ B

/-- $C(B)=C_1(B)\cap C_2(B)$ (part of `\label{cj:collapse}`). -/
def collapseBoth {m : ℕ} (B : Finset (Fin m → Fin 2)) : Finset (Fin m → Fin 3) :=
  collapseSet 0 B ∩ collapseSet 1 B

/-- The set $A\cap[2]^m$ of binary words of $A\subseteq[3]^m$, viewed as a subset of $[2]^m$
(notation used in `\label{cj:binary-pairs}` and `\label{cj:density-increment}`). -/
def binaryTrace {m : ℕ} (A : Finset (Fin m → Fin 3)) : Finset (Fin m → Fin 2) :=
  univ.filter fun x => binEmb x ∈ A

/-! ### A quantitative supply of binary pairs (`cj:binary-pairs`) -/

/-- **Lemma `cj:binary-pairs`** (part 1). Let $B\subseteq[2]^m$.  Each $C_i(B)$ is
$(i,3)$-insensitive. -/
theorem cj_binary_pairs_insensitive {m : ℕ} (i : Fin 2) (B : Finset (Fin m → Fin 2)) :
    IsInsensitive i (collapseSet i B) := by
  intro x y h
  have : collapse i x = collapse i y := by
    funext j
    rcases h j with h' | ⟨hx, hy⟩
    · simp [collapse, h']
    · have ex : collapse i x j = i := by
        rcases hx with hx | hx <;> simp [collapse, hx]
      have ey : collapse i y j = i := by
        rcases hy with hy | hy <;> simp [collapse, hy]
      rw [ex, ey]
  simp [collapseSet, this]

/-- Two words with the same letter-count vector differ by a permutation of the coordinates
(auxiliary for `cj:binary-pairs`, `cj_binary_pairs_bound`). -/
theorem aux_exists_perm_of_countVec_eq {m k : ℕ} (w x : Fin m → Fin k)
    (h : aux_countVec x = aux_countVec w) : ∃ τ : Equiv.Perm (Fin m), w ∘ τ = x := by
  have hc : ∀ j, Fintype.card {i // x i = j} = Fintype.card {i // w i = j} := by
    intro j; rw [Fintype.card_subtype, Fintype.card_subtype]; exact congrFun h j
  let e : ∀ j, {i // x i = j} ≃ {i // w i = j} := fun j => Fintype.equivOfCardEq (hc j)
  refine ⟨(Equiv.sigmaFiberEquiv x).symm.trans
    ((Equiv.sigmaCongrRight e).trans (Equiv.sigmaFiberEquiv w)), ?_⟩
  funext i
  simp only [comp_apply, Equiv.trans_apply,
    Equiv.sigmaCongrRight_apply, Equiv.sigmaFiberEquiv_apply]
  exact (e (x i) ⟨i, rfl⟩).2

/-- All fibres of $\sigma\mapsto w\circ\sigma$ over the slice of $w$ have the same size, the size of
the stabilizer of $w$ (auxiliary for `cj:binary-pairs`, `cj_binary_pairs_bound`). -/
theorem aux_card_perm_fiber {m k : ℕ} (w x : Fin m → Fin k)
    (h : aux_countVec x = aux_countVec w) :
    (univ.filter fun σ : Equiv.Perm (Fin m) => w ∘ σ = x).card =
      (univ.filter fun σ : Equiv.Perm (Fin m) => w ∘ σ = w).card := by
  obtain ⟨τ, rfl⟩ := aux_exists_perm_of_countVec_eq w x h
  refine card_nbij' (fun σ => σ * τ⁻¹) (fun σ => σ * τ) ?_ ?_ ?_ ?_
  · intro σ hσ
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hσ ⊢
    rw [Equiv.Perm.coe_mul, ← comp_assoc, hσ, comp_assoc, ← Equiv.Perm.coe_mul, mul_inv_cancel]
    rfl
  · intro σ hσ
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hσ ⊢
    rw [Equiv.Perm.coe_mul, ← comp_assoc, hσ]
  · intro σ _; simp
  · intro σ _; simp

/-- Permuting the coordinates preserves the letter counts (auxiliary for `cj:binary-pairs`,
`cj_binary_pairs_bound`). -/
theorem aux_countVec_perm {m k : ℕ} (w : Fin m → Fin k) (σ : Equiv.Perm (Fin m)) :
    aux_countVec (w ∘ σ) = aux_countVec w :=
  aux_countVec_comp_equiv σ w

/-- The number of permutations $\sigma$ with $w\circ\sigma\in E$ is
$|E\cap\text{slice}(w)|$ times the stabilizer size (auxiliary for `cj:binary-pairs`,
`cj_binary_pairs_bound`). -/
theorem aux_card_perm_mem {m k : ℕ} (w : Fin m → Fin k) (E : Finset (Fin m → Fin k)) :
    (univ.filter fun σ : Equiv.Perm (Fin m) => w ∘ σ ∈ E).card =
      (E.filter fun x => aux_countVec x = aux_countVec w).card *
        (univ.filter fun σ : Equiv.Perm (Fin m) => w ∘ σ = w).card := by
  rw [card_eq_sum_card_fiberwise (f := fun σ : Equiv.Perm (Fin m) => w ∘ σ) (t := E)
    (fun σ hσ => by simpa using hσ)]
  rw [card_eq_sum_ones (s := E.filter _), sum_mul, sum_filter]
  refine sum_congr rfl fun x hx => ?_
  split_ifs with hxw
  · rw [one_mul, ← aux_card_perm_fiber w x hxw]
    congr 1; ext σ; simp only [mem_filter, mem_univ, true_and]
    constructor
    · rintro ⟨-, h⟩; exact h
    · intro h; exact ⟨by rw [h]; exact hx, h⟩
  · rw [card_eq_zero, filter_eq_empty_iff]
    intro σ _ h
    exact hxw (by rw [← h, aux_countVec_perm])

/-- For a uniform random permutation $\sigma$, the word $w\circ\sigma$ is uniform on the slice of
$w$: $\sum_\sigma\mathbf 1_E(w\circ\sigma)=m!\,|E\cap\text{slice}|/|\text{slice}|$ (auxiliary for
`cj:binary-pairs`, `cj_binary_pairs_bound`). -/
theorem aux_sum_perm_indicator {m k : ℕ} (w : Fin m → Fin k) (E : Finset (Fin m → Fin k)) :
    ∑ σ : Equiv.Perm (Fin m), (if w ∘ σ ∈ E then (1 : ℝ) else 0) =
      (m.factorial : ℝ) * (((E.filter fun x => aux_countVec x = aux_countVec w).card : ℝ) /
        ((univ.filter fun x : Fin m → Fin k => aux_countVec x = aux_countVec w).card : ℝ)) := by
  rw [← sum_filter, sum_const, nsmul_eq_mul, mul_one, aux_card_perm_mem]
  have hU := aux_card_perm_mem w univ
  rw [filter_true_of_mem (fun _ _ => mem_univ _), card_univ, Fintype.card_perm,
    Fintype.card_fin] at hU
  have hpos : (0 : ℝ) < (univ.filter fun x : Fin m → Fin k =>
      aux_countVec x = aux_countVec w).card := by
    exact_mod_cast card_pos.2 ⟨w, by simp⟩
  rw [hU]
  push_cast
  field_simp


/-- The binary word with letter $1$ (`0 : Fin 2`) at the first $s$ coordinates and $2$ elsewhere;
composed with a permutation it is the word $u_s(\pi)$ of the proof of `cj:binary-pairs`
(auxiliary for `cj_binary_pairs_bound`). -/
@[nolint defsWithUnderscore]
def aux_chainBin (m s : ℕ) : Fin m → Fin 2 := fun j => if (j : ℕ) < s then 0 else 1

/-- The ternary word with letter $1$ at the first $\min(s,t)$ coordinates, letter $3$ at the next
$|s-t|$ coordinates and $2$ elsewhere: the word $z$ of the proof of `cj:binary-pairs`
(auxiliary for `cj_binary_pairs_bound`). -/
@[nolint defsWithUnderscore]
def aux_chainTer (m s t : ℕ) : Fin m → Fin 3 :=
  fun j => if (j : ℕ) < min s t then 0 else if (j : ℕ) < max s t then 2 else 1

/-- The two collapses of the ternary chain word are the binary chain words $u_{\min(s,t)}$ and
$u_{\max(s,t)}$ (auxiliary for `cj_binary_pairs_bound`). -/
theorem aux_collapse_chainTer {m : ℕ} (s t : ℕ) :
    collapse 1 (aux_chainTer m s t) = aux_chainBin m (min s t) ∧
      collapse 0 (aux_chainTer m s t) = aux_chainBin m (max s t) := by
  constructor <;> funext j <;> simp only [collapse, aux_chainTer, aux_chainBin] <;>
    by_cases h1 : (j : ℕ) < min s t <;> by_cases h2 : (j : ℕ) < max s t <;>
    simp only [h1, h2, if_true, if_false] <;> first | rfl | omega

/-- Letter counts of the binary chain word (auxiliary for `cj_binary_pairs_bound`). -/
theorem aux_countVec_chainBin {m s : ℕ} (hs : s ≤ m) :
    aux_countVec (aux_chainBin m s) 0 = s ∧ aux_countVec (aux_chainBin m s) 1 = m - s := by
  have h0 : aux_countVec (aux_chainBin m s) 0 = s := by
    unfold aux_countVec aux_chainBin
    refine Eq.trans ?_ (Fin.card_filter_val_lt (n := m) (m := s) |>.trans (min_eq_right hs))
    congr 1; ext j; simp only [mem_filter, mem_univ, true_and]; split_ifs with h <;> simp [h]
  refine ⟨h0, ?_⟩
  have := aux_sum_countVec (aux_chainBin m s)
  rw [Fin.sum_univ_two, h0, Fintype.card_fin] at this
  omega

/-- Letter counts $1$ and $2$ of the ternary chain word (auxiliary for `cj_binary_pairs_bound`). -/
theorem aux_countVec_chainTer {m s t : ℕ} (hs : s ≤ m) (ht : t ≤ m) :
    aux_countVec (aux_chainTer m s t) 0 = min s t ∧
      aux_countVec (aux_chainTer m s t) 1 = m - max s t := by
  constructor
  · unfold aux_countVec aux_chainTer
    refine Eq.trans ?_ (Fin.card_filter_val_lt (n := m) (m := min s t) |>.trans
      (min_eq_right (by omega)))
    congr 1; ext j; simp only [mem_filter, mem_univ, true_and]
    split_ifs with h h' <;> simp [h]
  · unfold aux_countVec aux_chainTer
    have hc := Fin.card_filter_val_lt (n := m) (m := max s t)
    rw [min_eq_right (by omega)] at hc
    have := card_filter_add_card_filter_not (s := (univ : Finset (Fin m)))
      (fun j : Fin m => (j : ℕ) < max s t)
    rw [hc, card_univ, Fintype.card_fin] at this
    rw [show m - max s t = (univ.filter fun j : Fin m => ¬ (j : ℕ) < max s t).card by omega]
    congr 1; ext j; simp only [mem_filter, mem_univ, true_and]
    split_ifs with h h' <;> simp <;> omega


/-- $2\binom{m+2}{m}=(m+1)(m+2)$ (auxiliary for `cj_binary_pairs_bound`). -/
theorem aux_choose_add_two (m : ℕ) : (m + 2).choose m * 2 = (m + 1) * (m + 2) := by
  induction m with
  | zero => simp
  | succ n ih =>
    rw [show n + 1 + 2 = (n + 2) + 1 by ring, Nat.choose_succ_succ, add_mul, ih,
      Nat.choose_succ_self_right]
    ring

/-- The binary word $z^{3\to i}$, viewed in $[3]^m$, replaces every letter $3$ of $z$ by $i$
(auxiliary for `cj:binary-pairs`, `cj_binary_pairs_forbidden`). -/
theorem aux_binEmb_collapse {m : ℕ} (i : Fin 2) (z : Fin m → Fin 3) (j : Fin m) :
    binEmb (collapse i z) j = if z j = 2 then i.castSucc else z j := by
  unfold binEmb collapse
  by_cases h : (z j : ℕ) < 2
  · have : z j ≠ 2 := fun h' => by rw [h'] at h; simp at h
    have h1 : (z j : ℕ) ≤ 1 := by omega
    simp [this, h1]
  · have : z j = 2 := Fin.ext (by have := (z j).isLt; simp; omega)
    simp [this]

/-- **Lemma `cj:binary-pairs`** (part 2, equation `eq:cj-pair-bound`).
Let $B\subseteq[2]^m$ and $b=\nu_{2,m}(B)$.  Then
$$\nu_{3,m}(C(B))\ge\frac{b^2}{2}.$$ -/
theorem cj_binary_pairs_bound {m : ℕ} (B : Finset (Fin m → Fin 2)) :
    (equalSlices 2 B) ^ 2 / 2 ≤ equalSlices 3 (collapseBoth B) := by
  set R := range (m + 1) with hR
  set C := collapseBoth B with hC
  set N : ℝ := (m.factorial : ℝ) with hN
  have hNpos : 0 < N := by rw [hN]; exact_mod_cast Nat.factorial_pos m
  set G : (Fin 2 → ℕ) → ℝ := fun a => ((B.filter fun x => aux_countVec x = a).card : ℝ) /
      ((univ.filter fun x : Fin m → Fin 2 => aux_countVec x = a).card : ℝ) with hG
  set F : (Fin 3 → ℕ) → ℝ := fun a => ((C.filter fun x => aux_countVec x = a).card : ℝ) /
      ((univ.filter fun x : Fin m → Fin 3 => aux_countVec x = a).card : ℝ) with hF
  set X : ℕ → Equiv.Perm (Fin m) → ℝ :=
    fun s σ => if aux_chainBin m s ∘ σ ∈ B then 1 else 0 with hX
  have hF0 : ∀ a, 0 ≤ F a := fun a => div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have h1 : ∀ s, ∑ σ, X s σ = N * G (aux_countVec (aux_chainBin m s)) :=
    fun s => aux_sum_perm_indicator _ _
  have h2 : ∀ s t, ∑ σ, X s σ * X t σ = N * F (aux_countVec (aux_chainTer m s t)) := by
    intro s t
    rw [hF, hN, ← aux_sum_perm_indicator]
    refine sum_congr rfl fun σ _ => ?_
    have hmem : aux_chainTer m s t ∘ σ ∈ C ↔
        aux_chainBin m s ∘ σ ∈ B ∧ aux_chainBin m t ∘ σ ∈ B := by
      obtain ⟨c1, c0⟩ := aux_collapse_chainTer (m := m) s t
      simp only [hC, collapseBoth, collapseSet, mem_inter, mem_filter, mem_univ, true_and]
      change collapse 0 (aux_chainTer m s t) ∘ σ ∈ B ∧ collapse 1 (aux_chainTer m s t) ∘ σ ∈ B ↔ _
      rw [c1, c0]
      rcases le_total s t with h | h
      · simp [min_eq_left h, max_eq_right h, and_comm]
      · simp [min_eq_right h, max_eq_left h]
    simp only [hX]
    by_cases hs : aux_chainBin m s ∘ σ ∈ B <;> by_cases ht : aux_chainBin m t ∘ σ ∈ B <;>
      simp [hs, ht, hmem]
  have hT2 : ((Finset.Nat.antidiagonalTuple 2 m).card : ℝ) = (m : ℝ) + 1 := by
    rw [aux_card_antidiagonalTuple, show 2 + m - 1 = m + 1 by omega, Nat.choose_succ_self_right]
    push_cast; ring
  have h3 : equalSlices 2 B = ((m : ℝ) + 1)⁻¹ * ∑ s ∈ R, G (aux_countVec (aux_chainBin m s)) := by
    unfold equalSlices
    rw [Fintype.card_fin, hT2]
    congr 1
    symm
    refine sum_nbij' (fun s => aux_countVec (aux_chainBin m s)) (fun a => a 0) ?_ ?_ ?_ ?_ ?_
    · intro s _
      have := aux_countVec_mem (aux_chainBin m s)
      rwa [Fintype.card_fin] at this
    · intro a ha
      simp only [Finset.Nat.mem_antidiagonalTuple, Fin.sum_univ_two] at ha
      simp only [hR, mem_range]; omega
    · intro s hs
      simp only [hR, mem_range] at hs
      exact (aux_countVec_chainBin (by omega)).1
    · intro a ha
      simp only [Finset.Nat.mem_antidiagonalTuple, Fin.sum_univ_two] at ha
      have hle : a 0 ≤ m := by omega
      funext j
      fin_cases j
      · exact (aux_countVec_chainBin hle).1
      · simp only [Fin.mk_one, Fin.isValue]
        rw [(aux_countVec_chainBin hle).2]; omega
    · intro s _; rfl
  set T3 := Finset.Nat.antidiagonalTuple 3 m with hT3
  have hT3c : ((T3.card : ℕ) : ℝ) = ((m : ℝ) + 1) * ((m : ℝ) + 2) / 2 := by
    rw [hT3, aux_card_antidiagonalTuple, show 3 + m - 1 = m + 2 by omega]
    have := aux_choose_add_two m
    have : (((m + 2).choose m : ℕ) : ℝ) * 2 = ((m : ℝ) + 1) * ((m : ℝ) + 2) := by
      exact_mod_cast this
    linarith
  have h4 : equalSlices 3 C = (((m : ℝ) + 1) * ((m : ℝ) + 2) / 2)⁻¹ * ∑ a ∈ T3, F a := by
    unfold equalSlices
    rw [Fintype.card_fin, ← hT3, hT3c]
  have h5 : ∑ s ∈ R, ∑ t ∈ R, F (aux_countVec (aux_chainTer m s t)) ≤ 2 * ∑ a ∈ T3, F a := by
    rw [← sum_product' (f := fun s t => F (aux_countVec (aux_chainTer m s t)))]
    have hmaps : ∀ p ∈ R ×ˢ R, aux_countVec (aux_chainTer m p.1 p.2) ∈ T3 := by
      intro p _
      have := aux_countVec_mem (aux_chainTer m p.1 p.2)
      rwa [Fintype.card_fin] at this
    rw [← sum_fiberwise_of_maps_to hmaps, mul_sum]
    refine sum_le_sum fun a _ => ?_
    rw [sum_congr rfl fun p hp => by rw [(mem_filter.1 hp).2], sum_const, nsmul_eq_mul]
    refine mul_le_mul_of_nonneg_right ?_ (hF0 a)
    have hsub : ((R ×ˢ R).filter fun p => aux_countVec (aux_chainTer m p.1 p.2) = a) ⊆
        {(a 0, m - a 1), (m - a 1, a 0)} := by
      intro p hp
      rw [mem_filter, mem_product, hR, mem_range, mem_range] at hp
      obtain ⟨⟨hp1, hp2⟩, hpa⟩ := hp
      obtain ⟨e0, e1⟩ := aux_countVec_chainTer (m := m) (s := p.1) (t := p.2) (by omega)
        (by omega)
      rw [hpa] at e0 e1
      rw [mem_insert, mem_singleton]
      rcases le_total p.1 p.2 with h | h
      · left; rw [min_eq_left h] at e0; rw [max_eq_right h] at e1
        exact Prod.ext (by simp; omega) (by simp; omega)
      · right; rw [min_eq_right h] at e0; rw [max_eq_left h] at e1
        exact Prod.ext (by simp; omega) (by simp; omega)
    have := (card_le_card hsub).trans (card_insert_le _ _)
    rw [card_singleton] at this
    exact_mod_cast this
  have h6 := sq_sum_le_card_mul_sum_sq (s := (univ : Finset (Equiv.Perm (Fin m))))
    (f := fun σ => ∑ s ∈ R, X s σ)
  rw [card_univ, Fintype.card_perm, Fintype.card_fin, ← hN] at h6
  have hL : ∑ σ, ∑ s ∈ R, X s σ = N * ((m : ℝ) + 1) * equalSlices 2 B := by
    rw [sum_comm, h3, sum_congr rfl fun s _ => h1 s, ← mul_sum]
    field_simp
  have hRhs : ∑ σ, (∑ s ∈ R, X s σ) ^ 2 =
      N * ∑ s ∈ R, ∑ t ∈ R, F (aux_countVec (aux_chainTer m s t)) := by
    simp_rw [sq, sum_mul_sum]
    rw [sum_comm]
    simp_rw [mul_sum]
    refine sum_congr rfl fun s _ => ?_
    rw [sum_comm]
    exact sum_congr rfl fun t _ => h2 s t
  rw [hL, hRhs] at h6
  have hS : ∑ a ∈ T3, F a = ((m : ℝ) + 1) * ((m : ℝ) + 2) / 2 * equalSlices 3 C := by
    rw [h4, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]
  have hν : 0 ≤ equalSlices 3 C := by
    rw [aux_equalSlices_eq_sum]; exact sum_nonneg fun x _ => aux_equalSlices_atom_nonneg x
  set b := equalSlices 2 B
  set ν := equalSlices 3 C
  have hm : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have key : (N * ((m : ℝ) + 1)) ^ 2 * b ^ 2 ≤ N ^ 2 * (((m : ℝ) + 1) * ((m : ℝ) + 2) * ν) := by
    have : (N * ((m : ℝ) + 1) * b) ^ 2 ≤ N * (N * (2 * (((m : ℝ) + 1) * ((m : ℝ) + 2) / 2 * ν))) :=
      h6.trans (by gcongr; rw [← hS]; exact h5)
    nlinarith
  have key2 : ((m : ℝ) + 1) * b ^ 2 ≤ ((m : ℝ) + 2) * ν := by
    have hpos : 0 < N ^ 2 * ((m : ℝ) + 1) := by positivity
    have : N ^ 2 * ((m : ℝ) + 1) * (((m : ℝ) + 1) * b ^ 2) ≤
        N ^ 2 * ((m : ℝ) + 1) * (((m : ℝ) + 2) * ν) := by nlinarith
    exact le_of_mul_le_mul_left this hpos
  nlinarith

/-- **Lemma `cj:binary-pairs`** (part 3, equation `eq:cj-forbidden-third`).
If $A\subseteq[3]^m$ contains no combinatorial line and $B=A\cap[2]^m$, then
$$A\cap C(B)\subseteq[2]^m.$$ -/
theorem cj_binary_pairs_forbidden {m : ℕ} (A : Finset (Fin m → Fin 3))
    (hA : ¬ ContainsLine A) : A ∩ collapseBoth (binaryTrace A) ⊆ binaryCube m := by
  intro z hz
  rw [mem_inter] at hz
  obtain ⟨hzA, hzC⟩ := hz
  simp only [collapseBoth, collapseSet, binaryTrace, mem_inter, mem_filter, mem_univ,
    true_and] at hzC
  by_contra hzB
  rw [aux_mem_binaryCube_iff] at hzB
  have : ∃ j, z j = 2 := by
    by_contra h
    push Not at h
    apply hzB
    unfold aux_countVec
    rw [card_eq_zero, filter_eq_empty_iff]
    exact fun j _ => h j
  obtain ⟨j0, hj0⟩ := this
  apply hA
  refine ⟨⟨fun j => if z j = 2 then none else some (z j), ⟨j0, by simp [hj0]⟩⟩, fun a => ?_⟩
  have e : ∀ i : Fin 2, (fun j => ((if z j = 2 then none else some (z j)) : Option (Fin 3)).getD
      i.castSucc) = binEmb (collapse i z) := by
    intro i; funext j; rw [aux_binEmb_collapse]; split_ifs <;> rfl
  fin_cases a
  · have := e 0
    convert hzC.1 using 1
    exact this
  · have := e 1
    convert hzC.2 using 1
    exact this
  · convert hzA using 1
    funext j; by_cases h : z j = 2 <;> simp [h]

/-! ### A three-letter density increment (`cj:density-increment`) -/

/-- The increment $h(\delta)=\delta^4/65536$ of `\label{cj:density-increment}`
(see `cj_density_increment`); it equals $\varepsilon/2$ for the constants
$\theta=\delta^2/64$, $t=\delta\theta/8$, $\kappa=t/8$, $\varepsilon=\delta\kappa/8$ of
equation `eq:cj-increment-constants`. -/
@[nolint defsWithUnderscore]
def C_cj_density_increment (δ : ℝ) : ℝ := δ ^ 4 / 65536

/-- The coordinate-restriction map $\phi_{\iota,y}$ as an $r$-dimensional combinatorial subspace of
$[k]^n$ (auxiliary for `cj:density-increment`, `cj_density_increment`). -/
@[nolint defsWithUnderscore]
def aux_restrictSub {k r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k) :
    Subspace (Fin r) (Fin k) (Fin n) :=
  ⟨fun i => if h : ∃ j, ι j = i then Sum.inr (ι.invOfMemRange ⟨i, h⟩) else Sum.inl (y ⟨i, h⟩),
    fun e => ⟨ι e, by
      have h : ∃ j, ι j = ι e := ⟨e, rfl⟩
      simp only [dif_pos h, Sum.inr.injEq]
      exact ι.right_inv_of_invOfMemRange e⟩⟩

/-- The coordinate map of `aux_restrictSub ι y` is $\phi_{\iota,y}$
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_restrictSub_apply {k r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k)
    (w : Fin r → Fin k) : aux_restrictSub ι y w = restrictMap ι y w := by
  funext i
  simp only [aux_restrictSub, Subspace.coe_apply, restrictMap]
  split_ifs <;> rfl

/-- The trace $A_{\iota,y}$ is the inverse image of $A$ under the subspace `aux_restrictSub ι y`
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_restrictPre_eq {k r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k)
    (A : Finset (Fin n → Fin k)) :
    restrictPre ι y A = univ.filter fun w => aux_restrictSub ι y w ∈ A := by
  simp only [restrictPre, aux_restrictSub_apply]

/-- The relative density of $A$ in a subspace $V$ is the uniform density of $V^{-1}(A)$
(auxiliary for `cj:density-increment`, `cj_density_increment` and `cj_dhj3`). -/
theorem aux_relDensity_eq {m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n))
    (A : Finset (Fin n → Fin k)) :
    relDensity V A = unifDensity (univ.filter fun x => V x ∈ A) := by
  unfold relDensity unifDensity
  rw [cj_bookkeeping_card, Nat.cast_pow]
  congr 2
  rw [← card_image_of_injective _ (aux_subspace_injective V)]
  congr 1
  ext z
  simp only [subspacePts, mem_inter, mem_image, mem_filter, mem_univ, true_and]
  constructor
  · rintro ⟨hz, x, rfl⟩; exact ⟨x, hz, rfl⟩
  · rintro ⟨x, hx, rfl⟩; exact ⟨hx, x, rfl⟩

/-- Relative density in a composed subspace $V\circ W$ is relative density of $V^{-1}(A)$ in $W$
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_relDensity_compSub {r m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n))
    (W : Subspace (Fin r) (Fin k) (Fin m)) (A : Finset (Fin n → Fin k)) :
    relDensity (aux_compSub V W) A = relDensity W (univ.filter fun x => V x ∈ A) := by
  rw [aux_relDensity_eq, aux_relDensity_eq]
  have h := (cj_bookkeeping_comp V W).choose_spec
  congr 1
  ext x
  simp only [mem_filter, mem_univ, true_and, aux_compSub, h, comp_apply]

/-- The inverse image of a line-free set under a subspace coordinate map is line-free (a line
in it maps to a line of the cube)
(auxiliary for `cj:density-increment`, `cj_density_increment` and `cj_dhj3`). -/
theorem aux_lineFree_preimage {m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n))
    {A : Finset (Fin n → Fin k)} (hA : ¬ ContainsLine A) :
    ¬ ContainsLine (univ.filter fun x => V x ∈ A) := by
  rintro ⟨l, hl⟩
  apply hA
  obtain ⟨j0, hj0⟩ := l.proper
  obtain ⟨i0, hi0⟩ := V.proper j0
  refine ⟨⟨fun i => (V.idxFun i).elim some l.idxFun, ⟨i0, by simp [hi0, hj0]⟩⟩, fun a => ?_⟩
  have := hl a
  simp only [mem_filter, mem_univ, true_and] at this
  convert this using 1
  funext i
  simp only [Line.coe_apply, Subspace.coe_apply]
  cases V.idxFun i <;> rfl

/-- If a probability-weighted average of $f$ is at least $c$, then some value of $f$ is at least
$c$ (auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_exists_ge_of_avg {α : Type*} [Fintype α] {β : α → Type*} [∀ a, Fintype (β a)]
    (π f : (a : α) → β a → ℝ) (hπ0 : ∀ a b, 0 ≤ π a b) (hπ1 : ∑ a, ∑ b, π a b = 1) {c : ℝ}
    (h : c ≤ ∑ a, ∑ b, π a b * f a b) : ∃ a b, c ≤ f a b := by
  by_contra hne
  push Not at hne
  have hpos : ∃ a b, 0 < π a b := by
    by_contra h0
    push Not at h0
    have : ∑ a, ∑ b, π a b = 0 :=
      sum_eq_zero fun a _ => sum_eq_zero fun b _ => le_antisymm (h0 a b) (hπ0 a b)
    linarith
  obtain ⟨a0, b0, hab⟩ := hpos
  have hsum : 0 < ∑ a, ∑ b, π a b * (c - f a b) := by
    have h1 : π a0 b0 * (c - f a0 b0) ≤ ∑ b, π a0 b * (c - f a0 b) :=
      single_le_sum (f := fun b => π a0 b * (c - f a0 b))
        (fun b _ => mul_nonneg (hπ0 a0 b) (by linarith [hne a0 b])) (mem_univ b0)
    have h2 : ∑ b, π a0 b * (c - f a0 b) ≤ ∑ a, ∑ b, π a b * (c - f a b) :=
      single_le_sum (f := fun a => ∑ b, π a b * (c - f a b))
        (fun a _ => sum_nonneg fun b _ => mul_nonneg (hπ0 a b) (by linarith [hne a b]))
        (mem_univ a0)
    have h3 : 0 < π a0 b0 * (c - f a0 b0) := mul_pos hab (by linarith [hne a0 b0])
    linarith
  have : ∑ a, ∑ b, π a b * (c - f a b) = c - ∑ a, ∑ b, π a b * f a b := by
    simp only [mul_sub, sum_sub_distrib, ← sum_mul, hπ1, one_mul]
  linarith

/-- Uniform densities are at most one
(auxiliary for `cj:density-increment`, `cj_density_increment` and `cj_dhj3`). -/
theorem aux_unifDensity_le_one {k n : ℕ} (A : Finset (Fin n → Fin k)) : unifDensity A ≤ 1 := by
  unfold unifDensity
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · rcases Nat.eq_zero_or_pos n with rfl | hn
    · have : A.card ≤ 1 := by
        calc A.card ≤ (univ : Finset (Fin 0 → Fin 0)).card := card_le_univ _
          _ = 1 := by simp
      simp only [pow_zero, div_one]; exact_mod_cast this
    · simp [zero_pow hn.ne']
  · rw [div_le_one (by positivity)]
    have := card_le_univ A
    simp only [Fintype.card_fun, Fintype.card_fin] at this
    exact_mod_cast this

/-- Uniform densities are nonnegative
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_unifDensity_nonneg {k n : ℕ} (A : Finset (Fin n → Fin k)) : 0 ≤ unifDensity A := by
  unfold unifDensity; positivity

/-- Monotonicity of the equal-slices probability
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_equalSlices_mono {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ}
    {A B : Finset (X → Fin k)} (h : A ⊆ B) : equalSlices k A ≤ equalSlices k B := by
  rw [aux_equalSlices_eq_sum, aux_equalSlices_eq_sum]
  exact sum_le_sum_of_subset_of_nonneg h fun x _ _ => aux_equalSlices_atom_nonneg x

/-- Equal-slices probabilities are at most one
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_equalSlices_le_one {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ} (hk : 1 ≤ k)
    (A : Finset (X → Fin k)) : equalSlices k A ≤ 1 :=
  (aux_equalSlices_mono (subset_univ A)).trans (aux_equalSlices_univ hk).le

/-- Additivity: $\nu(A)=\nu(A\cap T)+\nu(A\setminus T)$
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_equalSlices_split {X : Type*} [Fintype X] [DecidableEq X] {k : ℕ}
    (A T : Finset (X → Fin k)) :
    equalSlices k A = equalSlices k (A ∩ T) + equalSlices k (A \ T) := by
  rw [aux_equalSlices_eq_sum, aux_equalSlices_eq_sum, aux_equalSlices_eq_sum,
    sum_inter_add_sum_sdiff]


/-- Uniform letters on the complement of the image of $\iota$ form a probability
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_unif_yLaw_isProb3 {r n : ℕ} (ι : Fin r ↪ Fin n) :
    aux_IsProb (fun _ : aux_Compl ι → Fin 3 => ((3 : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹) := by
  refine ⟨fun _ => by positivity, ?_⟩
  rw [sum_const, card_univ, Fintype.card_fun, Fintype.card_fin, nsmul_eq_mul]
  push_cast
  exact mul_inv_cancel₀ (by positivity)

/-- The weights of the random restriction $(\iota,y)$ sum to one
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_sum_weights {k r n : ℕ} (hrn : r ≤ n)
    (yLaw : (ι : Fin r ↪ Fin n) → (aux_Compl ι → Fin k) → ℝ) (hy : ∀ ι, aux_IsProb (yLaw ι)) :
    ∑ ι : Fin r ↪ Fin n, ∑ y : aux_Compl ι → Fin k,
      (Fintype.card (Fin r ↪ Fin n) : ℝ)⁻¹ * yLaw ι y = 1 := by
  have hD : (0 : ℝ) < Fintype.card (Fin r ↪ Fin n) := by
    rw [Fintype.card_embedding_eq]; simp only [Fintype.card_fin]
    exact_mod_cast Nat.descFactorial_pos.2 hrn
  rw [sum_congr rfl fun ι _ => by rw [← mul_sum, (hy ι).2, mul_one]]
  rw [sum_const, card_univ, nsmul_eq_mul]
  exact mul_inv_cancel₀ hD.ne'

/-- Consequence of `cj_transfer_uniform`: averaging the $\lambda$-measure of the traces
$A_{\iota,y}$ over a random restriction with uniform background gives at least
$\mu_{3,n}(A)-\varepsilon$ (equation `eq:cj-two-averages`)
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_transfer_uniform_lower {m n : ℕ} (hmn : m ≤ n) (A : Finset (Fin n → Fin 3))
    (lam : (Fin m → Fin 3) → ℝ) (hlam : aux_IsProb lam) {ε : ℝ}
    (hTV : dTV (aux_restrictLaw (n := n)
        (fun ι _ => (((3 : ℕ) : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹) lam)
      (fun _ => (((3 : ℕ) : ℝ) ^ n)⁻¹) ≤ ε) :
    unifDensity A - ε ≤ ∑ ι : Fin m ↪ Fin n, ∑ y : aux_Compl ι → Fin 3,
      (Fintype.card (Fin m ↪ Fin n) : ℝ)⁻¹ * ((3 : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹ *
        ∑ w, lam w * (if restrictMap ι y w ∈ A then 1 else 0) := by
  have hP := aux_restrictLaw_isProb hmn
    (fun (ι : Fin m ↪ Fin n) (_ : aux_Compl ι → Fin 3) =>
      (((3 : ℕ) : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
    (fun ι => by simpa using aux_unif_yLaw_isProb3 ι) lam hlam
  have hQ : aux_IsProb (fun _ : Fin n → Fin 3 => (((3 : ℕ) : ℝ) ^ n)⁻¹) := by
    refine ⟨fun _ => by positivity, ?_⟩
    rw [sum_const, card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin, nsmul_eq_mul]
    push_cast
    exact mul_inv_cancel₀ (by positivity)
  have h := cj_probability_facts_tv_function hP hQ (h := fun z => if z ∈ A then (1 : ℝ) else 0)
    (fun z => by split_ifs <;> norm_num) (fun z => by split_ifs <;> norm_num)
  rw [aux_restrictLaw_expect] at h
  have eQ : ∑ z : Fin n → Fin 3, (((3 : ℕ) : ℝ) ^ n)⁻¹ * (if z ∈ A then (1 : ℝ) else 0) =
      unifDensity A := by
    simp only [mul_ite, mul_one, mul_zero]
    rw [sum_ite_mem, univ_inter, sum_const, nsmul_eq_mul, unifDensity]
    push_cast; ring
  rw [eQ] at h
  have eP : ∑ ι : Fin m ↪ Fin n, ∑ y : aux_Compl ι → Fin 3, ∑ w : Fin m → Fin 3,
      (Fintype.card (Fin m ↪ Fin n) : ℝ)⁻¹ * (((3 : ℕ) : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹ *
        lam w * (if restrictMap ι y w ∈ A then (1 : ℝ) else 0) =
      ∑ ι : Fin m ↪ Fin n, ∑ y : aux_Compl ι → Fin 3,
      (Fintype.card (Fin m ↪ Fin n) : ℝ)⁻¹ * ((3 : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹ *
        ∑ w, lam w * (if restrictMap ι y w ∈ A then 1 else 0) := by
    refine sum_congr rfl fun ι _ => sum_congr rfl fun y _ => ?_
    rw [mul_sum]
    refine sum_congr rfl fun w _ => ?_
    push_cast; ring
  rw [eP] at h
  have := (abs_le.1 (h.trans hTV)).1
  linarith

/-- Traces commute with intersections
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_restrictPre_inter {k r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin k)
    (P Q : Finset (Fin n → Fin k)) :
    restrictPre ι y (P ∩ Q) = restrictPre ι y P ∩ restrictPre ι y Q := by
  ext w; simp [restrictPre]

/-- Traces of $(i,3)$-insensitive sets are $(i,3)$-insensitive (via
`cj_insensitive_facts_preimage`) (auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_insensitive_restrictPre {r n : ℕ} {i : Fin 2} {P : Finset (Fin n → Fin 3)}
    (hP : IsInsensitive i P) (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin 3) :
    IsInsensitive i (restrictPre ι y P) := by
  rw [aux_restrictPre_eq]; exact cj_insensitive_facts_preimage hP _

/-- Relative density in the subspace $\phi_{\iota,y}\circ W$ is relative density of the trace
$A_{\iota,y}$ in $W$ (auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_relDensity_restrict {d r n : ℕ} (ι : Fin r ↪ Fin n) (y : aux_Compl ι → Fin 3)
    (W : Subspace (Fin d) (Fin 3) (Fin r)) (A : Finset (Fin n → Fin 3)) :
    relDensity (aux_compSub (aux_restrictSub ι y) W) A = relDensity W (restrictPre ι y A) := by
  rw [aux_relDensity_compSub, aux_restrictPre_eq]

/-- The last step of the proof of `cj:density-increment`: if disjoint $d$-dimensional subspaces
inside $D$ leave uncovered density at most $e$ and $\mu(A\cap D)-\alpha\mu(D)\ge c+e$, then some
tile has relative density at least $\alpha+c$
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_tile_pick {r d : ℕ} (A D : Finset (Fin r → Fin 3))
    (𝒱 : Finset (Subspace (Fin d) (Fin 3) (Fin r)))
    (hdisj : (𝒱 : Set (Subspace (Fin d) (Fin 3) (Fin r))).PairwiseDisjoint subspacePts)
    (hsub : ∀ V ∈ 𝒱, subspacePts V ⊆ D) {α c e : ℝ} (hα : 0 ≤ α) (hc : 0 < c)
    (hrem : unifDensity (D \ 𝒱.biUnion subspacePts) ≤ e)
    (hex : c + e ≤ unifDensity (A ∩ D) - α * unifDensity D) :
    ∃ V ∈ 𝒱, α + c ≤ relDensity V A := by
  set U := 𝒱.biUnion subspacePts with hU
  have hUD : U ⊆ D := biUnion_subset.2 hsub
  have hD := card_inter_add_card_sdiff D U
  rw [inter_eq_right.2 hUD] at hD
  have hAD := card_inter_add_card_sdiff (A ∩ D) U
  rw [show A ∩ D ∩ U = A ∩ U by
    ext x; simp only [mem_inter]; constructor
    · rintro ⟨⟨h1, -⟩, h3⟩; exact ⟨h1, h3⟩
    · rintro ⟨h1, h3⟩; exact ⟨⟨h1, hUD h3⟩, h3⟩] at hAD
  have hAU : ((A ∩ D) \ U).card ≤ (D \ U).card :=
    card_le_card fun x hx => by
      simp only [mem_sdiff, mem_inter] at hx ⊢; exact ⟨hx.1.2, hx.2⟩
  have hUc : U.card = ∑ V ∈ 𝒱, (subspacePts V).card := card_biUnion hdisj
  have hAUc : (A ∩ U).card = ∑ V ∈ 𝒱, (A ∩ subspacePts V).card := by
    rw [hU, inter_biUnion]
    refine card_biUnion fun V hV W hW hVW => ?_
    exact Disjoint.mono inter_subset_right inter_subset_right (hdisj hV hW hVW)
  have hUle : U.card ≤ 3 ^ r := by
    have := card_le_univ U
    simpa [Fintype.card_fun, Fintype.card_fin] using this
  have hQ : (0 : ℝ) < (3 : ℝ) ^ r := by positivity
  unfold unifDensity at hrem hex
  simp only [Nat.cast_ofNat] at hrem hex
  rw [div_le_iff₀ hQ] at hrem
  have hex' : (c + e) * (3 : ℝ) ^ r ≤ ((A ∩ D).card : ℝ) - α * (D.card : ℝ) := by
    have : ((A ∩ D).card : ℝ) / (3 : ℝ) ^ r - α * ((D.card : ℝ) / (3 : ℝ) ^ r) =
        (((A ∩ D).card : ℝ) - α * (D.card : ℝ)) / (3 : ℝ) ^ r := by field_simp
    rw [this, le_div_iff₀ hQ] at hex
    exact hex
  have hD' : (D.card : ℝ) = (U.card : ℝ) + ((D \ U).card : ℝ) := by exact_mod_cast hD.symm
  have hAD' : ((A ∩ D).card : ℝ) = ((A ∩ U).card : ℝ) + (((A ∩ D) \ U).card : ℝ) := by
    exact_mod_cast hAD.symm
  have hAU' : (((A ∩ D) \ U).card : ℝ) ≤ ((D \ U).card : ℝ) := by exact_mod_cast hAU
  have hmain : c * (3 : ℝ) ^ r ≤ ((A ∩ U).card : ℝ) - α * (U.card : ℝ) := by
    have : 0 ≤ α * ((D \ U).card : ℝ) := by positivity
    nlinarith
  have hcard : ∀ V ∈ 𝒱, ((subspacePts V).card : ℝ) = (3 : ℝ) ^ d := by
    intro V _; rw [cj_bookkeeping_card]; push_cast; ring
  by_contra hne
  push Not at hne
  have hlt : ∀ V ∈ 𝒱, ((A ∩ subspacePts V).card : ℝ) - α * ((subspacePts V).card : ℝ) <
      c * ((subspacePts V).card : ℝ) := by
    intro V hV
    have := hne V hV
    rw [relDensity, hcard V hV, div_lt_iff₀ (by positivity)] at this
    rw [hcard V hV]; linarith
  have hsum : ((A ∩ U).card : ℝ) - α * (U.card : ℝ) =
      ∑ V ∈ 𝒱, (((A ∩ subspacePts V).card : ℝ) - α * ((subspacePts V).card : ℝ)) := by
    rw [hAUc, hUc, sum_sub_distrib]; push_cast; rw [mul_sum]
  rcases 𝒱.eq_empty_or_nonempty with h0 | hne0
  · rw [hsum, h0, sum_empty] at hmain
    have : 0 < c * (3 : ℝ) ^ r := by positivity
    linarith
  · have h1 := sum_lt_sum_of_nonempty hne0 hlt
    rw [← mul_sum, ← Nat.cast_sum, ← hUc, ← hsum] at h1
    have : c * (U.card : ℝ) ≤ c * (3 : ℝ) ^ r := by
      gcongr; exact_mod_cast hUle
    linarith

/-- The law $\nu_{2,m}$ viewed as a probability on $[3]^m$ supported on $[2]^m$
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_binLaw_isProb (m : ℕ) :
    aux_IsProb (fun w : Fin m → Fin 3 => ∑ w' : Fin m → Fin 2,
      equalSlices 2 ({w'} : Finset _) * (if binEmb w' = w then 1 else 0)) := by
  refine ⟨fun w => sum_nonneg fun w' _ =>
    mul_nonneg (aux_equalSlices_atom_nonneg w') (by split_ifs <;> norm_num), ?_⟩
  rw [sum_comm]
  simp only [mul_ite, mul_one, mul_zero, sum_ite_eq, mem_univ, if_true]
  exact aux_equalSlices_sum_atoms (by norm_num)

/-- Expectations under $\nu_{2,m}$ viewed on $[3]^m$
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_binLaw_expect {m : ℕ} (g : (Fin m → Fin 3) → ℝ) :
    ∑ w : Fin m → Fin 3, (∑ w' : Fin m → Fin 2,
      equalSlices 2 ({w'} : Finset _) * (if binEmb w' = w then 1 else 0)) * g w =
      ∑ w' : Fin m → Fin 2, equalSlices 2 ({w'} : Finset _) * g (binEmb w') := by
  simp_rw [sum_mul]
  rw [sum_comm]
  refine sum_congr rfl fun w' _ => ?_
  simp only [mul_ite, mul_one, mul_zero, ite_mul, zero_mul, sum_ite_eq, mem_univ, if_true]

/-- The second case of the proof of `cj:density-increment`: from a line-free good face $A'$
(equation `eq:cj-good-face`) one finds a $d$-dimensional subspace of $[3]^m$ on which $A'$ has
relative density at least $\alpha+3t/8$
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_increment_face {δ θ t κ α : ℝ} {d r m : ℕ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (hd : 1 ≤ d)
    (hθ : θ = δ ^ 2 / 64) (ht : t = δ * θ / 8) (hκ : κ = t / 8)
    (hr : C_cj_tile_two d (t / 8) ≤ r) (hr1 : 1 ≤ r) (hrm : r ≤ m)
    (hdim2 : 3 * (r : ℝ) / m ≤ t / 8) (hdim3 : 2 / ((m : ℝ) + 2) ≤ δ * θ / 2)
    (hδA : δ ≤ α) (hα1 : α ≤ 1) (A' : Finset (Fin m → Fin 3)) (hA'free : ¬ ContainsLine A')
    (hga : α - κ ≤ equalSlices 3 A') (hgb : δ / 4 ≤ equalSlices 2 (binaryTrace A')) :
    ∃ W : Subspace (Fin d) (Fin 3) (Fin m), α + 3 * t / 8 ≤ relDensity W A' := by
  have hθ0 : 0 < θ := by rw [hθ]; positivity
  have ht0 : 0 < t := by rw [ht]; positivity
  have hκ0 : 0 < κ := by rw [hκ]; positivity
  have hθ1 : θ ≤ 1 / 64 := by rw [hθ]; nlinarith
  have ht1 : t ≤ δ / 512 := by rw [ht]; nlinarith
  have hκδ : κ ≤ δ / 4 := by rw [hκ]; linarith
  obtain ⟨B, hB⟩ : ∃ B, B = binaryTrace A' := ⟨_, rfl⟩
  obtain ⟨C, hCB⟩ : ∃ C, C = collapseBoth B := ⟨_, rfl⟩
  rw [← hB] at hgb
  have hνC : θ ≤ equalSlices 3 C := by
    have h1 := cj_binary_pairs_bound B
    have h2 : δ ^ 2 / 16 ≤ (equalSlices 2 B) ^ 2 := by
      calc δ ^ 2 / 16 = (δ / 4) ^ 2 := by ring
        _ ≤ _ := by gcongr
    rw [hθ, hCB]; linarith only [h1, h2, sq_nonneg δ]
  have hAC : equalSlices 3 (A' ∩ C) ≤ δ * θ / 2 := by
    rw [hCB, hB]
    exact (aux_equalSlices_mono (cj_binary_pairs_forbidden A' hA'free)).trans
      ((cj_probability_facts_binary_face_mass m).le.trans hdim3)
  -- the excess over `β = α - κ`
  obtain ⟨E, hE⟩ : ∃ E : Finset (Fin m → Fin 3) → ℝ,
      E = fun S => equalSlices 3 (A' ∩ S) - (α - κ) * equalSlices 3 S := ⟨_, rfl⟩
  have hEc : 2 * t ≤ E Cᶜ := by
    have s1 := aux_equalSlices_split A' C
    have s2 := aux_equalSlices_split (univ : Finset (Fin m → Fin 3)) C
    rw [univ_inter, ← compl_eq_univ_sdiff, aux_equalSlices_univ (by norm_num)] at s2
    rw [sdiff_eq_inter_compl] at s1
    have h1' : 3 * δ / 4 ≤ α - κ := by linarith only [hδA, hκδ]
    have h0' : 0 ≤ α - κ := by linarith only [hδA, hκδ, hδ0]
    have hprod : 3 * δ / 4 * θ ≤ (α - κ) * equalSlices 3 C := mul_le_mul h1' hνC hθ0.le h0'
    rw [hE]
    have e : (α - κ) * equalSlices 3 Cᶜ = (α - κ) - (α - κ) * equalSlices 3 C := by
      rw [show equalSlices 3 Cᶜ = 1 - equalSlices 3 C by linarith only [s2]]; ring
    simp only
    rw [e, ht]
    have hdt : δ * θ / 2 = 2 * (δ * θ / 4) := by ring
    linarith only [s1, hprod, hAC, hga, hdt, hδ0, hθ0]
  -- split `Cᶜ = D⁽¹⁾ ∪ D⁽²⁾` and pick `D` with `eq:cj-structured-excess`
  obtain ⟨C1, hC1⟩ : ∃ C1, C1 = collapseSet 0 B := ⟨_, rfl⟩
  obtain ⟨C2, hC2⟩ : ∃ C2, C2 = collapseSet 1 B := ⟨_, rfl⟩
  have hCC : C = C1 ∩ C2 := by rw [hCB, hC1, hC2]; rfl
  have hEsplit : E Cᶜ = E (C1ᶜ ∩ univ) + E (C1 ∩ C2ᶜ) := by
    have s1 := aux_equalSlices_split (A' ∩ Cᶜ) C1
    have s2 := aux_equalSlices_split Cᶜ C1
    have e1 : A' ∩ Cᶜ ∩ C1 = A' ∩ (C1 ∩ C2ᶜ) := by
      ext x; simp only [hCC, mem_inter, mem_compl]; tauto
    have e2 : (A' ∩ Cᶜ) \ C1 = A' ∩ (C1ᶜ ∩ univ) := by
      ext x; simp only [hCC, mem_inter, mem_compl, mem_sdiff, mem_univ]; tauto
    have e3 : Cᶜ ∩ C1 = C1 ∩ C2ᶜ := by
      ext x; simp only [hCC, mem_inter, mem_compl]; tauto
    have e4 : (Cᶜ : Finset (Fin m → Fin 3)) \ C1 = C1ᶜ ∩ univ := by
      ext x; simp only [hCC, mem_inter, mem_compl, mem_sdiff, mem_univ]; tauto
    rw [e1, e2] at s1
    rw [e3, e4] at s2
    rw [hE]
    simp only
    rw [s1, s2]
    ring
  obtain ⟨P, Q, hP, hQ, hEPQ⟩ : ∃ P Q : Finset (Fin m → Fin 3),
      IsInsensitive 0 P ∧ IsInsensitive 1 Q ∧ t ≤ E (P ∩ Q) := by
    have hI1 : IsInsensitive 0 C1 := by rw [hC1]; exact cj_binary_pairs_insensitive 0 B
    have hI2 : IsInsensitive 1 C2 := by rw [hC2]; exact cj_binary_pairs_insensitive 1 B
    by_cases h1 : t ≤ E (C1ᶜ ∩ univ)
    · exact ⟨C1ᶜ, univ, cj_insensitive_facts_compl hI1, fun x y _ => by simp, h1⟩
    · exact ⟨C1, C2ᶜ, hI1, cj_insensitive_facts_compl hI2, by linarith only [h1, hEsplit, hEc]⟩
  rw [hE] at hEPQ
  simp only at hEPQ
  -- a random `r`-coordinate restriction `ψ` with equal-slices background
  have hav1 := cj_transfer_equal_average hr1 hrm (A' ∩ (P ∩ Q))
  have hav2 := cj_transfer_equal_average hr1 hrm (P ∩ Q)
  have hβ0 : 0 ≤ α - κ := by linarith only [hδA, hκδ, hδ0]
  have hβ1 : α - κ ≤ 1 := by linarith only [hα1, hκ0]
  obtain ⟨ι', y', hψ⟩ := aux_exists_ge_of_avg
    (fun (ι' : Fin r ↪ Fin m) (y' : aux_Compl ι' → Fin 3) =>
      (Fintype.card (Fin r ↪ Fin m) : ℝ)⁻¹ * equalSlices 3 ({y'} : Finset _))
    (fun ι' y' => unifDensity (restrictPre ι' y' (A' ∩ (P ∩ Q))) -
      (α - κ) * unifDensity (restrictPre ι' y' (P ∩ Q)))
    (fun ι' y' => mul_nonneg (by positivity) (aux_equalSlices_atom_nonneg _))
    (aux_sum_weights hrm _ fun _ => aux_equalSlices_isProb (by norm_num))
    (c := 3 * t / 4) (by
      have e : ∑ ι' : Fin r ↪ Fin m, ∑ y' : aux_Compl ι' → Fin 3,
          (Fintype.card (Fin r ↪ Fin m) : ℝ)⁻¹ * equalSlices 3 ({y'} : Finset _) *
            (unifDensity (restrictPre ι' y' (A' ∩ (P ∩ Q))) -
              (α - κ) * unifDensity (restrictPre ι' y' (P ∩ Q))) =
          (∑ ι' : Fin r ↪ Fin m, ∑ y' : aux_Compl ι' → Fin 3,
            (Fintype.card (Fin r ↪ Fin m) : ℝ)⁻¹ * equalSlices 3 ({y'} : Finset _) *
              unifDensity (restrictPre ι' y' (A' ∩ (P ∩ Q)))) -
          (α - κ) * ∑ ι' : Fin r ↪ Fin m, ∑ y' : aux_Compl ι' → Fin 3,
            (Fintype.card (Fin r ↪ Fin m) : ℝ)⁻¹ * equalSlices 3 ({y'} : Finset _) *
              unifDensity (restrictPre ι' y' (P ∩ Q)) := by
        rw [mul_sum, ← sum_sub_distrib]
        refine sum_congr rfl fun ι' _ => ?_
        rw [mul_sum, ← sum_sub_distrib]
        refine sum_congr rfl fun y' _ => ?_
        ring
      rw [e]
      have a1 := (abs_le.1 hav1).1
      have a2 := (abs_le.1 hav2).2
      have a3 := mul_le_mul_of_nonneg_left a2 hβ0
      have a4 := mul_le_mul_of_nonneg_right hβ1 (show (0 : ℝ) ≤ 3 * r / m by positivity)
      nlinarith only [a1, a3, a4, hEPQ, hdim2, ht0])
  rw [aux_restrictPre_inter, aux_restrictPre_inter] at hψ
  -- tiling the structured set `D' = ψ⁻¹(P ∩ Q)`
  have hD1 : unifDensity (restrictPre ι' y' P ∩ restrictPre ι' y' Q) ≤ 1 :=
    aux_unifDensity_le_one _
  have hD0 : 0 ≤ unifDensity (restrictPre ι' y' P ∩ restrictPre ι' y' Q) :=
    aux_unifDensity_nonneg _
  obtain ⟨𝒱, hdisj, hsub, hrem⟩ := cj_tile_two hd (ε := t / 8) (by positivity)
    (by linarith only [ht1, hδ1]) hr _ _ (aux_insensitive_restrictPre hP ι' y')
    (aux_insensitive_restrictPre hQ ι' y')
  obtain ⟨W, -, hW⟩ := aux_tile_pick (restrictPre ι' y' A') _ 𝒱 hdisj hsub
    (α := α) (by linarith only [hδA, hδ0]) (c := 3 * t / 8) (by positivity) hrem (by
      have := mul_le_mul_of_nonneg_left hD1 hκ0.le
      have e : (α - κ) * unifDensity (restrictPre ι' y' P ∩ restrictPre ι' y' Q) =
          α * unifDensity (restrictPre ι' y' P ∩ restrictPre ι' y' Q) -
            κ * unifDensity (restrictPre ι' y' P ∩ restrictPre ι' y' Q) := by ring
      linarith only [hψ, this, hκ, e, ht0])
  refine ⟨aux_compSub (aux_restrictSub ι' y') W, ?_⟩
  rw [aux_relDensity_restrict]
  exact hW

/-- The choice of $m$ in equation `eq:cj-dimension-choices`
(auxiliary for `cj:density-increment`, `cj_density_increment`). -/
theorem aux_increment_dims {r : ℕ} {ε t c : ℝ} (hε : 0 < ε) (ht : 0 < t) (hc : 0 < c) :
    ∃ m : ℕ, 3 * r ≤ m ∧ 1 ≤ m ∧ 3 * (r : ℝ) / m ≤ ε / 2 ∧ 3 * (r : ℝ) / m ≤ t / 8 ∧
      2 / ((m : ℝ) + 2) ≤ c := by
  set K : ℝ := 6 * r / ε + 24 * r / t + 2 / c with hK
  refine ⟨max (3 * r) (⌈K⌉₊ + 1), le_max_left _ _, by omega, ?_⟩
  set m := max (3 * r) (⌈K⌉₊ + 1)
  have hmK : K ≤ m := by
    have : ⌈K⌉₊ + 1 ≤ m := le_max_right _ _
    have h2 : (⌈K⌉₊ : ℝ) + 1 ≤ m := by exact_mod_cast this
    linarith [Nat.le_ceil K]
  have hmpos : (0 : ℝ) < m := by
    have : 1 ≤ m := le_trans (by omega) (le_max_right _ _)
    exact_mod_cast this
  have hK1 : 0 ≤ 6 * (r : ℝ) / ε := by positivity
  have hK2 : 0 ≤ 24 * (r : ℝ) / t := by positivity
  have hK3 : 0 ≤ 2 / c := by positivity
  refine ⟨?_, ?_, ?_⟩
  · rw [div_le_iff₀ hmpos]
    have : 6 * (r : ℝ) / ε ≤ m := by linarith
    rw [div_le_iff₀ hε] at this
    linarith
  · rw [div_le_iff₀ hmpos]
    have : 24 * (r : ℝ) / t ≤ m := by linarith
    rw [div_le_iff₀ ht] at this
    linarith
  · rw [div_le_iff₀ (by positivity)]
    have : 2 / c ≤ m := by linarith
    rw [div_le_iff₀ hc] at this
    nlinarith

/-- **Proposition `cj:density-increment`** (A three-letter density increment).
For every $0<\delta\le1$ there is $h(\delta)>0$ with the following property.  For every integer
$d\ge1$ there is an integer $N(d,\delta)\ge d$ such that, whenever $n\ge N(d,\delta)$ and
$A\subseteq[3]^n$ has uniform density $\alpha\ge\delta$ and contains no combinatorial line,
some $d$-dimensional combinatorial subspace $V$ satisfies
$$\frac{|A\cap V|}{|V|}\ge\alpha+h(\delta).$$
One may take $h(\delta)=\delta^4/65536$. -/
theorem cj_density_increment {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) :
    0 < C_cj_density_increment δ ∧
      ∀ d ≥ 1, ∃ N ≥ d, ∀ n ≥ N, ∀ A : Finset (Fin n → Fin 3),
        δ ≤ unifDensity A → ¬ ContainsLine A →
          ∃ V : Subspace (Fin d) (Fin 3) (Fin n),
            unifDensity A + C_cj_density_increment δ ≤ relDensity V A := by
  refine ⟨by unfold C_cj_density_increment; positivity, ?_⟩
  intro d hd
  -- the constants of `eq:cj-increment-constants`
  set θ : ℝ := δ ^ 2 / 64 with hθ
  set t : ℝ := δ * θ / 8 with ht
  set κ : ℝ := t / 8 with hκ
  set ε : ℝ := δ * κ / 8 with hε
  have hθ0 : 0 < θ := by positivity
  have ht0 : 0 < t := by positivity
  have hκ0 : 0 < κ := by positivity
  have hε0 : 0 < ε := by positivity
  have hθ1 : θ ≤ 1 / 64 := by rw [hθ]; nlinarith
  have ht1 : t ≤ δ / 512 := by rw [ht]; nlinarith
  have hκδ : κ ≤ δ / 4 := by rw [hκ]; linarith
  have hεδ : ε ≤ δ / 4 := by rw [hε]; nlinarith
  have hεt : ε / 2 ≤ 3 * t / 8 := by rw [hε, hκ]; nlinarith
  have hC : C_cj_density_increment δ = ε / 2 := by
    unfold C_cj_density_increment; rw [hε, hκ, ht, hθ]; ring
  -- the choice of `r`
  set r := max (C_cj_tile_two d (t / 8)) d with hr
  have hdr : d ≤ r := le_max_right _ _
  have hrT : C_cj_tile_two d (t / 8) ≤ r := le_max_left _ _
  have hr1 : 1 ≤ r := le_trans hd hdr
  -- the choice of `m` (`eq:cj-dimension-choices`)
  obtain ⟨m, hm3r, hm1, hdim1, hdim2, hdim3⟩ :=
    aux_increment_dims (r := r) hε0 ht0 (show 0 < δ * θ / 2 by positivity)
  clear_value r ε κ t θ
  -- the choice of `N`
  obtain ⟨N, hNm, hN⟩ := cj_transfer_uniform (k := 3) (r := m) (Or.inr rfl) hε0
  refine ⟨N, by omega, ?_⟩
  intro n hn A hδA hA
  have hmn : m ≤ n := le_trans hNm hn
  set α := unifDensity A with hα
  have hα1 : α ≤ 1 := aux_unifDensity_le_one A
  have hα0 : 0 ≤ α := by linarith
  clear_value α
  -- random restrictions `φ = φ_{ι,y}` with uniform letters in the fixed coordinates
  obtain ⟨π, hπ⟩ : ∃ π : (ι : Fin m ↪ Fin n) → (aux_Compl ι → Fin 3) → ℝ, π = fun ι _ =>
    (Fintype.card (Fin m ↪ Fin n) : ℝ)⁻¹ * ((3 : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹ :=
    ⟨_, rfl⟩
  have hπ0 : ∀ ι y, 0 ≤ π ι y := fun ι y => by rw [hπ]; positivity
  have hπ1 : ∑ ι, ∑ y, π ι y = 1 := by
    rw [hπ]
    exact aux_sum_weights hmn (fun ι _ => ((3 : ℝ) ^ Fintype.card (aux_Compl ι))⁻¹)
      (fun ι => aux_unif_yLaw_isProb3 ι)
  obtain ⟨a, ha⟩ : ∃ a : (ι : Fin m ↪ Fin n) → (aux_Compl ι → Fin 3) → ℝ, a = fun ι y =>
    equalSlices 3 (restrictPre ι y A) := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : (ι : Fin m ↪ Fin n) → (aux_Compl ι → Fin 3) → ℝ, b = fun ι y =>
    equalSlices 2 (binaryTrace (restrictPre ι y A)) := ⟨_, rfl⟩
  -- `eq:cj-two-averages`
  have hEa : α - ε ≤ ∑ ι, ∑ y, π ι y * a ι y := by
    have hlam := aux_equalSlices_isProb (X := Fin m) (k := 3) (by norm_num)
    rw [hα]
    refine (aux_transfer_uniform_lower hmn A _ hlam (hN n hn _ hlam)).trans (le_of_eq ?_)
    refine sum_congr rfl fun ι _ => sum_congr rfl fun y _ => ?_
    simp only [hπ, ha]
    congr 1
    rw [aux_equalSlices_eq_sum, restrictPre, sum_filter]
    simp only [mul_ite, mul_one, mul_zero]
  have hEb : α - ε ≤ ∑ ι, ∑ y, π ι y * b ι y := by
    have hlam := aux_binLaw_isProb m
    rw [hα]
    refine (aux_transfer_uniform_lower hmn A _ hlam (hN n hn _ hlam)).trans (le_of_eq ?_)
    refine sum_congr rfl fun ι _ => sum_congr rfl fun y _ => ?_
    simp only [hπ, hb]
    congr 1
    rw [aux_binLaw_expect, aux_equalSlices_eq_sum, binaryTrace, sum_filter]
    simp only [restrictPre, mem_filter, mem_univ, true_and, mul_ite, mul_one, mul_zero]
  by_cases hcase : ∃ ι y, α + ε ≤ a ι y
  · -- some restriction has `a(φ) ≥ α + ε`
    obtain ⟨ι, y, hιy⟩ := hcase
    rw [ha] at hιy
    have havg := cj_transfer_equal_average (r := d) (m := m) hd (by omega) (restrictPre ι y A)
    have h3d : 3 * (d : ℝ) / m ≤ ε / 2 := by
      refine le_trans ?_ hdim1
      gcongr
    obtain ⟨ι', y', hge⟩ := aux_exists_ge_of_avg
      (fun (ι' : Fin d ↪ Fin m) (y' : aux_Compl ι' → Fin 3) =>
        (Fintype.card (Fin d ↪ Fin m) : ℝ)⁻¹ * equalSlices 3 ({y'} : Finset _))
      (fun ι' y' => unifDensity (restrictPre ι' y' (restrictPre ι y A)))
      (fun ι' y' => mul_nonneg (by positivity) (aux_equalSlices_atom_nonneg _))
      (aux_sum_weights (by omega) _ fun _ => aux_equalSlices_isProb (by norm_num))
      (c := α + ε / 2) (by have := (abs_le.1 havg).1; linarith)
    refine ⟨aux_compSub (aux_restrictSub ι y) (aux_restrictSub ι' y'), ?_⟩
    rw [aux_relDensity_restrict, aux_relDensity_eq, ← aux_restrictPre_eq, hC]
    exact hge
  push Not at hcase
  -- otherwise find a restriction with `eq:cj-good-face`
  have hlk : 2 / κ * κ = 2 := by field_simp
  have hle : 2 / κ * ε = δ / 4 := by rw [hε]; field_simp; ring
  have hl0 : 0 < 2 / κ := by positivity
  obtain ⟨ι, y, hf⟩ := aux_exists_ge_of_avg π (fun ι y => 2 / κ * a ι y + b ι y) hπ0 hπ1
    (c := 2 / κ * (α - ε) + (δ - ε)) (by
      have e : ∑ ι, ∑ y, π ι y * (2 / κ * a ι y + b ι y) =
          2 / κ * ∑ ι, ∑ y, π ι y * a ι y + ∑ ι, ∑ y, π ι y * b ι y := by
        rw [mul_sum, ← sum_add_distrib]
        refine sum_congr rfl fun ι _ => ?_
        rw [mul_sum, ← sum_add_distrib]
        refine sum_congr rfl fun y _ => ?_
        ring
      rw [e]
      have := mul_le_mul_of_nonneg_left hEa hl0.le
      linarith)
  have hf' : 2 / κ * (α - ε) + (δ - ε) ≤ 2 / κ * a ι y + b ι y := hf
  have hb1 : b ι y ≤ 1 := by rw [hb]; exact aux_equalSlices_le_one (by norm_num) _
  have hga : α - κ ≤ a ι y := by
    by_contra h
    push Not at h
    have h1 : 2 / κ * a ι y < 2 / κ * (α - κ) := mul_lt_mul_of_pos_left h hl0
    have h2 : 2 / κ * (α - κ) = 2 / κ * α - 2 := by rw [mul_sub, hlk]
    have h3 : 2 / κ * (α - ε) = 2 / κ * α - δ / 4 := by rw [mul_sub, hle]
    linarith only [h1, h2, h3, hf', hb1, hεδ, hδ1, hδ0]
  have hgb : δ / 4 ≤ b ι y := by
    by_contra h
    push Not at h
    have h1 : 2 / κ * a ι y < 2 / κ * (α + ε) := mul_lt_mul_of_pos_left (hcase ι y) hl0
    have h2 : 2 / κ * (α + ε) = 2 / κ * α + δ / 4 := by rw [mul_add, hle]
    have h3 : 2 / κ * (α - ε) = 2 / κ * α - δ / 4 := by rw [mul_sub, hle]
    linarith only [h1, h2, h3, hf', h, hεδ, hδ1, hδ0]
  replace hga : α - κ ≤ equalSlices 3 (restrictPre ι y A) := by rw [ha] at hga; exact hga
  replace hgb : δ / 4 ≤ equalSlices 2 (binaryTrace (restrictPre ι y A)) := by
    rw [hb] at hgb; exact hgb
  clear hf hf' hcase hb1
  -- the good face `A' = φ⁻¹(A)`
  obtain ⟨A', hA'⟩ : ∃ A', A' = restrictPre ι y A := ⟨_, rfl⟩
  rw [← hA'] at hga hgb
  have hA'free : ¬ ContainsLine A' := by
    rw [hA', aux_restrictPre_eq]; exact aux_lineFree_preimage _ hA
  obtain ⟨W, hW⟩ := aux_increment_face hδ0 hδ1 hd hθ ht hκ hrT hr1 (by omega)
    hdim2 hdim3 hδA hα1 A' hA'free hga hgb
  refine ⟨aux_compSub (aux_restrictSub ι y) W, ?_⟩
  rw [aux_relDensity_restrict, ← hA', hC]
  linarith only [hW, hεt]

/-! ### Density Hales–Jewett for three letters (`cj:dhj3`) -/

/-- **Theorem `cj:dhj3`** (Density Hales–Jewett for three letters).
For every $0<\delta\le1$ there is an integer $H_3(\delta)$ such that, for every
$n\ge H_3(\delta)$, each set $A\subseteq[3]^n$ with $|A|\ge\delta3^n$ contains a combinatorial
line. -/
theorem cj_dhj3 {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) :
    ∃ H : ℕ, ∀ n ≥ H, ∀ A : Finset (Fin n → Fin 3),
      δ * (3 : ℝ) ^ n ≤ (A.card : ℝ) → ContainsLine A := by
  obtain ⟨hh, hN⟩ := cj_density_increment hδ0 hδ1
  choose! Nf hNf hspec using hN
  -- the dimensions `n_0 = 1`, `n_{j+1} = N(n_j, δ)`
  obtain ⟨s, hs0, hsS⟩ : ∃ s : ℕ → ℕ, s 0 = 1 ∧ ∀ j, s (j + 1) = Nf (s j) :=
    ⟨fun j => Nat.rec 1 (fun _ x => Nf x) j, rfl, fun _ => rfl⟩
  have hs1 : ∀ j, 1 ≤ s j := by
    intro j
    induction j with
    | zero => rw [hs0]
    | succ j ih => rw [hsS]; exact le_trans ih (hNf _ ih)
  -- after `j` density increments the density is still at most one
  have claim : ∀ j : ℕ, ∀ n ≥ s j, ∀ A : Finset (Fin n → Fin 3), δ ≤ unifDensity A →
      ¬ ContainsLine A → unifDensity A + j * C_cj_density_increment δ ≤ 1 := by
    intro j
    induction j with
    | zero => intro n _ A _ _; simpa using aux_unifDensity_le_one A
    | succ j ih =>
      intro n hn A hA hfree
      rw [hsS] at hn
      obtain ⟨V, hV⟩ := hspec (s j) (hs1 j) n hn A hA hfree
      rw [aux_relDensity_eq] at hV
      have hV' := ih (s j) le_rfl (univ.filter fun x => V x ∈ A) (by linarith)
        (aux_lineFree_preimage V hfree)
      push_cast
      linarith
  obtain ⟨K, hK⟩ := exists_nat_gt (1 / C_cj_density_increment δ)
  refine ⟨s K, fun n hn A hA => ?_⟩
  by_contra hfree
  have hδA : δ ≤ unifDensity A := by
    unfold unifDensity
    rw [le_div_iff₀ (by positivity)]
    push_cast
    linarith
  have h1 := claim K n hn A hδA hfree
  have h2 : 1 < K * C_cj_density_increment δ := by
    rw [div_lt_iff₀ hh] at hK; linarith
  linarith

end Auto
