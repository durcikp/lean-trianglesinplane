/-- The density $\sigma*\rho$ of the convolution of $\sigma$ with an `L¹` density $\rho$:
integrability, and the identity $\int\int G(u_\theta+y)\rho(y)\,dy\,d\sigma(\theta)
=\int G(v)(\sigma*\rho)(v)\,dv$ for bounded measurable $G$ (auxiliary for `den_continuity`). -/
theorem aux_den_conv_density (G : ℝ² → ℂ) (hG : AEStronglyMeasurable G volume) (C : ℝ)
    (hGC : ∀ v, ‖G v‖ ≤ C) (ρ : ℝ² → ℂ) (hρ : Integrable ρ) :
    Integrable (FCMeasure.sigma.convFun ρ) ∧
    ∫ q, G (u q.1 + q.2) * ρ q.2 ∂(σ.prod (volume : Measure ℝ²)) =
      ∫ v, G v * FCMeasure.sigma.convFun ρ v := by
  have hu := aux_lw_u_meas
  have hΦ := aux_den_shear u hu
  have hΨ := aux_den_shear (fun θ => -u θ) hu.neg
  -- `(θ, v) ↦ ρ (v - u θ)` is integrable
  have hρ2 : Integrable (fun q : Ang × ℝ² => ρ q.2) (σ.prod volume) := by
    simpa using (integrable_const (1 : ℂ)).mul_prod hρ
  have hρs : Integrable (fun q : Ang × ℝ² => ρ (q.2 - u q.1)) (σ.prod volume) := by
    have := (hΨ.integrable_comp hρ2.1).2 hρ2
    simpa [Function.comp_def, sub_eq_add_neg] using this
  have hGs : AEStronglyMeasurable (fun q : Ang × ℝ² => G q.2) (σ.prod volume) :=
    hG.comp_quasiMeasurePreserving Measure.quasiMeasurePreserving_snd
  have hH' : Integrable (fun q : Ang × ℝ² => G q.2 * ρ (q.2 - u q.1)) (σ.prod volume) :=
    hρs.bdd_mul hGs (Eventually.of_forall fun q => hGC q.2)
  have hconv : ∀ v, FCMeasure.sigma.convFun ρ v = ∫ θ, ρ (v - u θ) ∂σ := by
    intro v
    simp only [FCMeasure.convFun, FCMeasure.integral, FCMeasure.sigma, mul_one]
    rfl
  refine ⟨?_, ?_⟩
  · have := hρs.integral_prod_right
    exact this.congr (Eventually.of_forall fun v => (hconv v).symm)
  · have key := integral_map (μ := σ.prod (volume : Measure ℝ²)) hΦ.measurable.aemeasurable
      (f := fun q : Ang × ℝ² => G q.2 * ρ (q.2 - u q.1)) (by rw [hΦ.map_eq]; exact hH'.1)
    rw [hΦ.map_eq] at key
    have e1 : ∀ q : Ang × ℝ², G (u q.1 + q.2) * ρ q.2 =
        G (q.2 + u q.1) * ρ (q.2 + u q.1 - u q.1) := fun q => by
      rw [add_sub_cancel_right, add_comm]
    simp_rw [e1]
    rw [← key, integral_prod_symm _ hH']
    congr 1; funext v
    rw [hconv, ← integral_const_mul]

/-- The form of a dilate of $\sigma*\rho$ through the density $k=\sigma*\rho$:
$\Lambda_{(\sigma*\rho)_r}(f)=\int G_f(rv)k(v)\,dv$ (auxiliary for `den_continuity`). -/
theorem aux_den_form_conv_dil (α β : ℝ) (ρ : ℝ² → ℂ) (hρ : Integrable ρ) (i : Fin 3)
    (f : Fin 3 → ℝ² → ℂ) (hf : ∀ j, AEStronglyMeasurable (f j) volume)
    (hi : eLpNorm (f i) ⊤ volume ≤ 1) (hj : ∀ j, j ≠ i → eLpNorm (f j) 2 volume ≤ 1)
    (r : ℝ) (hr : r ≠ 0) :
    form α β ((FCMeasure.sigma.conv (FCMeasure.ofDensity ρ)).dil r) (f 0) (f 1) (f 2) =
      ∫ v, aux_den_G α β f (r • v) * FCMeasure.sigma.convFun ρ v := by
  have hG : AEStronglyMeasurable (fun v => aux_den_G α β f (r • v)) volume :=
    (aux_den_G_aesm α β f hf).comp_quasiMeasurePreserving
      (Measure.quasiMeasurePreserving_smul volume hr)
  rw [← (aux_den_conv_density _ hG 1 (fun v => aux_den_G_le α β i f hf hi hj _) ρ hρ).2]
  have hw : (FCMeasure.ofDensity ρ).w = ρ := by simp [FCMeasure.ofDensity, hρ]
  unfold form
  simp only [FCMeasure.dil, FCMeasure.conv, FCMeasure.sigma, hw, one_mul]
  rfl

/-- The middle term in the proof of `den:continuity`:
$|\Lambda_{(\sigma*\rho)_r}(f)-\Lambda_{\sigma*\rho}(f)|\le\|k_r-k\|_1$ with $k=\sigma*\rho$ and
$k_r(u)=r^{-2}k(u/r)$ (auxiliary for `den_continuity`). -/
theorem aux_den_mid (α β : ℝ) (ρ : ℝ² → ℂ) (hρ : Integrable ρ) (i : Fin 3)
    (f : Fin 3 → ℝ² → ℂ) (hf : ∀ j, AEStronglyMeasurable (f j) volume)
    (hi : eLpNorm (f i) ⊤ volume ≤ 1) (hj : ∀ j, j ≠ i → eLpNorm (f j) 2 volume ≤ 1)
    (r : ℝ) (hr : 0 < r) :
    ‖form α β ((FCMeasure.sigma.conv (FCMeasure.ofDensity ρ)).dil r) (f 0) (f 1) (f 2) -
        form α β ((FCMeasure.sigma.conv (FCMeasure.ofDensity ρ)).dil 1) (f 0) (f 1) (f 2)‖ₑ ≤
      eLpNorm (fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * FCMeasure.sigma.convFun ρ (r⁻¹ • x) -
        FCMeasure.sigma.convFun ρ x) 1 volume := by
  set k := FCMeasure.sigma.convFun ρ with hk
  set G := aux_den_G α β f with hGdef
  have hki : Integrable k := (aux_den_conv_density _ (aux_den_G_aesm α β f hf) 1
    (fun v => aux_den_G_le α β i f hf hi hj _) ρ hρ).1
  have hGm := aux_den_G_aesm α β f hf
  have hGb : ∀ v, ‖G v‖ ≤ 1 := fun v => aux_den_G_le α β i f hf hi hj v
  rw [aux_den_form_conv_dil α β ρ hρ i f hf hi hj r hr.ne',
    aux_den_form_conv_dil α β ρ hρ i f hf hi hj 1 one_ne_zero]
  simp only [one_smul]
  have hcv : ∫ v, G (r • v) * k v =
      ∫ v, G v * ((((r ^ 2)⁻¹ : ℝ) : ℂ) * k (r⁻¹ • v)) := by
    have h := Measure.integral_comp_smul (μ := (volume : Measure ℝ²))
      (fun v => G v * k (r⁻¹ • v)) r
    simp only [smul_smul, inv_mul_cancel₀ hr.ne', one_smul, finrank_euclideanSpace_fin] at h
    rw [h]
    simp_rw [← mul_assoc, mul_comm (G _) _, mul_assoc]
    rw [integral_const_mul, abs_of_pos (by positivity), Complex.real_smul]
    simp_rw [mul_comm (k _) (G _)]
  have hDi : Integrable (fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * k (r⁻¹ • x)) :=
    (hki.comp_smul (inv_ne_zero hr.ne')).const_mul _
  rw [hcv, ← integral_sub (hDi.bdd_mul hGm (Eventually.of_forall hGb))
    (hki.bdd_mul hGm (Eventually.of_forall hGb)), eLpNorm_one_eq_lintegral_enorm]
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun v => ?_)
  rw [← mul_sub, enorm_mul]
  have : ‖G v‖ₑ ≤ 1 := by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_one.2 (hGb v)
  calc ‖G v‖ₑ * _ ≤ 1 * _ := by gcongr
    _ = _ := one_mul _

/-- `ν_1 = ν` (auxiliary for `den_continuity`). -/
theorem aux_den_dil_one (ν : FCMeasure) : ν.dil 1 = ν := by
  cases ν; simp [FCMeasure.dil]

/-- The three-term estimate in the proof of `den:continuity`:
$\|\Lambda_{\sigma_r-\sigma}\|_i\le2\|\Lambda_{k-\sigma}\|_i+\|k_r-k\|_1$ for $k=\sigma*\rho$
(auxiliary for `den_continuity`). -/
theorem aux_den_cont_bound (α β : ℝ) (ρ : ℝ² → ℂ) (hρ : Integrable ρ) (i : Fin 3)
    (r : ℝ) (hr : 0 < r) :
    endNorm α β ((FCMeasure.sigma.dil r).sub FCMeasure.sigma) i ≤
      2 * endNorm α β ((FCMeasure.sigma.conv (FCMeasure.ofDensity ρ)).sub FCMeasure.sigma) i +
      eLpNorm (fun x => (((r ^ 2)⁻¹ : ℝ) : ℂ) * FCMeasure.sigma.convFun ρ (r⁻¹ • x) -
        FCMeasure.sigma.convFun ρ x) 1 volume := by
  set K := FCMeasure.sigma.conv (FCMeasure.ofDensity ρ) with hK
  set σ' := FCMeasure.sigma
  refine iSup_le fun f => iSup_le fun hf => iSup_le fun hi => iSup_le fun hj => ?_
  have hm := aux_den_adm_memLp i f hf hi hj
  have hmid := aux_den_mid α β ρ hρ i f hf hi hj r hr
  rw [aux_den_dil_one] at hmid
  have hA := aux_den_form_le_endNorm α β ((K.sub σ').dil r) i f hf hi hj
  rw [lem_form_basic_scaling α β _ i r hr, aux_den_dil_sub,
    aux_appr_form_sub α β _ _ i f hm] at hA
  have hB := aux_den_form_le_endNorm α β (K.sub σ') i f hf hi hj
  rw [aux_appr_form_sub α β _ _ i f hm] at hB
  rw [aux_appr_form_sub α β _ _ i f hm]
  have e : form α β (σ'.dil r) (f 0) (f 1) (f 2) - form α β σ' (f 0) (f 1) (f 2) =
      -(form α β (K.dil r) (f 0) (f 1) (f 2) - form α β (σ'.dil r) (f 0) (f 1) (f 2)) +
      (form α β (K.dil r) (f 0) (f 1) (f 2) - form α β K (f 0) (f 1) (f 2)) +
      (form α β K (f 0) (f 1) (f 2) - form α β σ' (f 0) (f 1) (f 2)) := by ring
  rw [e]
  refine (enorm_add_le _ _).trans ?_
  refine (add_le_add (enorm_add_le _ _) hB).trans ?_
  rw [enorm_neg, two_mul]
  calc _ ≤ endNorm α β (K.sub σ') i + _ + endNorm α β (K.sub σ') i :=
        add_le_add (add_le_add hA hmid) le_rfl
    _ = _ := by ring

/-- The unit square $[0,1]^2$ (auxiliary for `den_continuity`). -/
@[nolint defsWithUnderscore]
def aux_den_unitSq : Set ℝ² := (WithLp.ofLp (p := 2) (V := Fin 2 → ℝ)) ⁻¹' (Set.Icc 0 1)

/-- A probability density on the plane: the indicator of the unit square (auxiliary for
`den_continuity`, `den_main`). -/
theorem aux_den_rho0 :
    (∀ x, 0 ≤ aux_den_unitSq.indicator (1 : ℝ² → ℝ) x) ∧
      Integrable (aux_den_unitSq.indicator (1 : ℝ² → ℝ)) ∧
      ∫ x, aux_den_unitSq.indicator (1 : ℝ² → ℝ) x = 1 := by
  have hm : MeasurableSet aux_den_unitSq :=
    (PiLp.volume_preserving_ofLp (ι := Fin 2)).measurable measurableSet_Icc
  have hv : volume aux_den_unitSq = 1 := by
    rw [aux_den_unitSq, (PiLp.volume_preserving_ofLp (ι := Fin 2)).measure_preimage
      measurableSet_Icc.nullMeasurableSet, Real.volume_Icc_pi]
    simp
  refine ⟨fun x => Set.indicator_nonneg (fun _ _ => zero_le_one) x, ?_, ?_⟩
  · exact (integrable_indicator_iff hm).2 (integrableOn_const (by rw [hv]; simp))
  · rw [integral_indicator_one hm, measureReal_def, hv]; simp

/-- **Lemma `den:continuity`**. For every endpoint placement $i$,
$\lim_{r\to1}\|\Lambda_{\sigma_r-\sigma}\|_i=0$. -/
theorem den_continuity (α β : ℝ) (hβ : β ≠ 0) (i : Fin 3) :
    Tendsto (fun r : ℝ => endNorm α β ((FCMeasure.sigma.dil r).sub FCMeasure.sigma) i)
      (𝓝 1) (𝓝 0) := by
  obtain ⟨h0, hi, h1⟩ := aux_den_rho0
  set ρ0 := aux_den_unitSq.indicator (1 : ℝ² → ℝ)
  have hT := tail_smoothing α β hβ ρ0 h0 hi h1 i
  simp only [aux_appr_endNorm_dil] at hT
  refine ENNReal.tendsto_nhds_zero.2 fun ε hε => ?_
  have hε3 : 0 < ε / 3 := ENNReal.div_pos hε.ne' (by simp)
  obtain ⟨t, ht, ht0⟩ := ((ENNReal.tendsto_nhds_zero.1 hT (ε / 3) hε3).and
    self_mem_nhdsWithin).exists
  set ρc : ℝ² → ℂ := fun x => (((t ^ 2)⁻¹ * ρ0 (t⁻¹ • x) : ℝ) : ℂ) with hρc
  have hρi : Integrable ρc := (aux_appr_rho_integral ρ0 hi t ht0).1.ofReal
  have hki := (aux_den_conv_density (fun _ => 0) aestronglyMeasurable_const 0 (by simp) ρc hρi).1
  have hD := ext_approximation_dilation hki
  filter_upwards [ENNReal.tendsto_nhds_zero.1 hD (ε / 3) hε3, Ioi_mem_nhds one_pos] with r hr hr0
  refine (aux_den_cont_bound α β ρc hρi i r hr0).trans ?_
  calc _ ≤ 2 * (ε / 3) + ε / 3 := by gcongr
    _ = ε := by
      rw [← add_one_mul, show (2 : ℝ≥0∞) + 1 = 3 by norm_num]
      exact ENNReal.mul_div_cancel (by simp) (by simp)

/-! ### Density and triangle counts (`den:definitions`) -/

/-- The triangle count (`\label{den:definitions}`)
$$D_s(f)=\Lambda_{\sigma_s}(f,f,f)=
\int_{\mathbb T}\int_{\R^2}f(x)f(x+su_\theta)f(x+sMu_\theta)\,dx\,d\sigma(\theta)$$
for a bounded, compactly supported, nonnegative function $f$. -/
def triangleCount (α β : ℝ) (s : ℝ) (f : ℝ² → ℝ) : ℝ :=
  ∫ θ, ∫ x, f x * f (x + s • u θ) * f (x + s • M α β (u θ)) ∂volume ∂σ

/-- A scale $s$ is *missed by $E$* if there are no $x\in\R^2$, $\theta\in\mathbb T$ for which all
three vertices $x$, $x+su_\theta$, $x+sMu_\theta$ belong to $E$ (`\label{den:definitions}`). -/
def IsMissed (α β : ℝ) (E : Set ℝ²) (s : ℝ) : Prop :=
  ¬ ∃ (x : ℝ²) (θ : Ang), x ∈ E ∧ x + s • u θ ∈ E ∧ x + s • M α β (u θ) ∈ E

/-! ### Large dense squares and exact copies (`den:dense-squares`) -/

/-- The square `squareAt z L` as the preimage of a box under `WithLp.ofLp` (auxiliary for
`den_dense_squares_exists` and `den_weighted_lower`). -/
theorem aux_squareAt_eq_preimage (z : ℝ²) (L : ℝ) :
    squareAt z L = (WithLp.ofLp (p := 2) (V := Fin 2 → ℝ)) ⁻¹'
      (Set.Icc (fun i => z i) (fun i => z i + L)) := by
  ext x
  simp [squareAt, Set.mem_Icc, Pi.le_def, forall_and]

/-- Squares are measurable (auxiliary for `den_weighted_lower`). -/
theorem aux_measurableSet_squareAt (z : ℝ²) (L : ℝ) : MeasurableSet (squareAt z L) := by
  rw [aux_squareAt_eq_preimage]
  exact (PiLp.volume_preserving_ofLp (ι := Fin 2)).measurable measurableSet_Icc

/-- The area of the square `z + [0,L]²` is `L²` (auxiliary for `den_dense_squares_exists` and
`den_weighted_lower`). -/
theorem aux_volume_squareAt (z : ℝ²) (L : ℝ) (hL : 0 ≤ L) :
    volume (squareAt z L) = ENNReal.ofReal (L ^ 2) := by
  rw [aux_squareAt_eq_preimage,
    (PiLp.volume_preserving_ofLp (ι := Fin 2)).measure_preimage
      measurableSet_Icc.nullMeasurableSet, Real.volume_Icc_pi]
  simp [sq, ENNReal.ofReal_mul hL]

/-- **Lemma `den:dense-squares`** (dense squares). If $0<\delta<d^*(E)$, there are squares $Q$ of
arbitrarily large side length for which $|E\cap Q|\ge\delta|Q|$.
(In Lean the blueprint hypothesis `(hδ : 0 < δ)` is omitted since the proof does not need it; see
`automation/ErrorReport.md`.) -/
theorem den_dense_squares_exists (E : Set ℝ²) (δ : ℝ)
    (hd : ENNReal.ofReal δ < upperBanachDensity E) (L₀ : ℝ) :
    ∃ (z : ℝ²) (L : ℝ), L₀ ≤ L ∧ 0 < L ∧
      ENNReal.ofReal δ * volume (squareAt z L) ≤ volume (E ∩ squareAt z L) := by
  have hfr := Filter.frequently_lt_of_lt_limsup (by isBoundedDefault) hd
  obtain ⟨L, hlt, hL⟩ := (hfr.and_eventually (eventually_ge_atTop (max L₀ 1))).exists
  obtain ⟨z, hz⟩ := lt_iSup_iff.mp hlt
  have hLpos : 0 < L := lt_of_lt_of_le one_pos (le_trans (le_max_right _ _) hL)
  refine ⟨z, L, le_trans (le_max_left _ _) hL, hLpos, ?_⟩
  rw [aux_volume_squareAt z L hLpos.le]
  have h0 : ENNReal.ofReal (L ^ 2) ≠ 0 := (ENNReal.ofReal_pos.mpr (by positivity)).ne'
  exact (ENNReal.lt_div_iff_mul_lt (Or.inl h0) (Or.inl ENNReal.ofReal_ne_top)).mp hz |>.le

/-- **Lemma `den:dense-squares`** (Borel subsets). For each such square there is a Borel set
$A\subset E\cap Q$ of the same measure. -/
theorem den_dense_squares_borel (E : Set ℝ²) (hE : NullMeasurableSet E volume) (Q : Set ℝ²)
    (hQ : MeasurableSet Q) :
    ∃ A : Set ℝ², MeasurableSet A ∧ A ⊆ E ∩ Q ∧ volume A = volume (E ∩ Q) := by
  obtain ⟨A, hAsub, hAm, hAe⟩ := (hE.inter hQ.nullMeasurableSet).exists_measurable_subset_ae_eq
  exact ⟨A, hAm, hAsub, measure_congr hAe⟩

/-- **Lemma `den:dense-squares`** (missed scales). If $s$ is missed by $E$ and $A\subset E$, then
$D_s(\mathbf 1_A)=0$. -/
theorem den_dense_squares_missed (α β : ℝ) (E A : Set ℝ²) (hA : A ⊆ E) (s : ℝ)
    (hs : IsMissed α β E s) : triangleCount α β s (A.indicator 1) = 0 := by
  have h0 : ∀ θ x, A.indicator (1 : ℝ² → ℝ) x * A.indicator 1 (x + s • u θ) *
      A.indicator 1 (x + s • M α β (u θ)) = 0 := by
    intro θ x
    by_cases h1 : x ∈ A
    · by_cases h2 : x + s • u θ ∈ A
      · by_cases h3 : x + s • M α β (u θ) ∈ A
        · exact absurd ⟨x, θ, hA h1, hA h2, hA h3⟩ hs
        · simp [h3]
      · simp [h2]
    · simp [h1]
  simp [triangleCount, h0]

/-- **Lemma `den:dense-squares`** (exact copies). If $D_s(\mathbf 1_A)>0$, then $A$, and hence
$E$, contains a translate of a rotation of $s\{0,e_1,Me_1\}$.
(In Lean the blueprint hypothesis `(hA : MeasurableSet A)` is omitted since the proof does not need
it; see `automation/ErrorReport.md`.) -/
theorem den_dense_squares_copy (α β : ℝ) (A : Set ℝ²) (s : ℝ)
    (hpos : 0 < triangleCount α β s (A.indicator 1)) :
    ∃ (x : ℝ²) (t : ℝ), ∀ p ∈ ({0, e1, M α β e1} : Set ℝ²), x + rot t (s • p) ∈ A := by
  obtain ⟨θ, hθ⟩ : ∃ θ : Ang, (∫ x, A.indicator (1 : ℝ² → ℝ) x * A.indicator 1 (x + s • u θ) *
      A.indicator 1 (x + s • M α β (u θ))) ≠ 0 := by
    by_contra h
    push Not at h
    simp [triangleCount, h] at hpos
  obtain ⟨x, hx⟩ : ∃ x, A.indicator (1 : ℝ² → ℝ) x * A.indicator 1 (x + s • u θ) *
      A.indicator 1 (x + s • M α β (u θ)) ≠ 0 := by
    by_contra h
    push Not at h
    simp [h] at hθ
  have h1 : x ∈ A := by by_contra h; simp [h] at hx
  have h2 : x + s • u θ ∈ A := by by_contra h; simp [h] at hx
  have h3 : x + s • M α β (u θ) ∈ A := by by_contra h; simp [h] at hx
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective θ
  have hu : u (t : Ang) = rot t e1 := by
    rw [aux_rot_e1]; rfl
  have hcomm : ∀ v, rot t (M α β v) = M α β (rot t v) := by
    intro v
    have h := (aux_simil_comp (Real.cos t) (Real.sin t) α β).trans
      ((congrArg₂ simil (by ring) (by ring)).trans
        (aux_simil_comp α β (Real.cos t) (Real.sin t)).symm)
    exact congrArg (fun T : ℝ² →L[ℝ] ℝ² => T v) h
  refine ⟨x, t, ?_⟩
  intro p hp
  rcases hp with rfl | rfl | rfl
  · simpa using h1
  · rw [map_smul, ← hu]; exact h2
  · rw [map_smul, hcomm, ← hu]; exact h3

/-! ### Word notation for the geometric application (`den:lines`) -/

/-- The variable set of a combinatorial line in $\mathcal W_n=\{0,1,2\}^n$ (part of
`\label{den:lines}`; words and lines are those of `\label{cj:def-words}` with the relabeling
$j\mapsto j-1$, i.e. Mathlib's `Combinatorics.Line (Fin 3) (Fin n)`). -/
def lineVarSet {n : ℕ} (l : Combinatorics.Line (Fin 3) (Fin n)) : Finset (Fin n) :=
  Finset.univ.filter fun i => l.idxFun i = none

/-- The subsum $s_J=\sum_{j\in J}\lambda_j$ (part of `\label{den:lines}`). -/
def subsum {n : ℕ} (lam : Fin n → ℝ) (J : Finset (Fin n)) : ℝ := ∑ j ∈ J, lam j

/-! ### Number of lines (`den:line-number`) -/

/-- The set of lines of `α`-words indexed by `ι` is finite (auxiliary, used to sum over all
combinatorial lines in `den_line_number` and `den_weighted_lower`). -/
instance aux_instFiniteLine {α ι : Type*} [Finite α] [Finite ι] :
    Finite (Combinatorics.Line α ι) :=
  Finite.of_injective Combinatorics.Line.idxFun fun _ _ h => Combinatorics.Line.ext h

/-- A `Fintype` structure on lines (auxiliary, for `den_line_number` and
`den_weighted_lower`). -/
@[nolint defsWithUnderscore]
noncomputable instance aux_instFintypeLine {α ι : Type*} [Finite α] [Finite ι] :
    Fintype (Combinatorics.Line α ι) := Fintype.ofFinite _

/-- Lines are words `ι → Option α` with at least one `none` coordinate (auxiliary for
`den_line_number`). -/
@[nolint defsWithUnderscore]
def aux_lineEquiv (α ι : Type*) :
    Combinatorics.Line α ι ≃ {f : ι → Option α // ∃ i, f i = none} where
  toFun l := ⟨l.idxFun, l.proper⟩
  invFun f := ⟨f.1, f.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- Lines with variable set `J` correspond to fillings of the fixed coordinates
(auxiliary for `den_line_number_fixed`). -/
@[nolint defsWithUnderscore]
def aux_lineFixedEquiv (n : ℕ) (J : Finset (Fin n)) (hJ : J.Nonempty) :
    {l : Combinatorics.Line (Fin 3) (Fin n) // lineVarSet l = J} ≃ ({i // i ∉ J} → Fin 3) where
  toFun l i := (l.1.idxFun i.1).get (by
    rw [Option.isSome_iff_ne_none]
    intro h
    have hi : i.1 ∈ lineVarSet l.1 := by simp [lineVarSet, h]
    rw [l.2] at hi
    exact i.2 hi)
  invFun g := ⟨⟨fun i => if h : i ∈ J then none else some (g ⟨i, h⟩),
    by obtain ⟨j, hj⟩ := hJ; exact ⟨j, by simp [hj]⟩⟩, by
      ext i; by_cases h : i ∈ J <;> simp [lineVarSet, h]⟩
  left_inv l := by
    obtain ⟨l, hl⟩ := l
    apply Subtype.ext
    apply Combinatorics.Line.ext
    funext i
    by_cases h : i ∈ J
    · have : l.idxFun i = none := by
        rw [← hl] at h; simpa [lineVarSet] using h
      simp [h, this]
    · simp [h]
  right_inv g := by
    funext i
    simp [i.2]

/-- **Lemma `den:line-number`** (fixed variable set). For a fixed nonempty $J\subset[n]$ there are
$3^{n-|J|}$ combinatorial lines with variable set $J$. -/
theorem den_line_number_fixed (n : ℕ) (J : Finset (Fin n)) (hJ : J.Nonempty) :
    Nat.card {l : Combinatorics.Line (Fin 3) (Fin n) // lineVarSet l = J} = 3 ^ (n - J.card) := by
  classical
  rw [Nat.card_congr (aux_lineFixedEquiv n J hJ), Nat.card_eq_fintype_card]
  simp [Fintype.card_subtype_compl]

/-- **Lemma `den:line-number`** (total). The total number of lines in $\mathcal W_n$ is
$4^n-3^n$. -/
theorem den_line_number (n : ℕ) :
    Nat.card (Combinatorics.Line (Fin 3) (Fin n)) = 4 ^ n - 3 ^ n := by
  classical
  rw [Nat.card_congr (aux_lineEquiv _ _), Nat.card_eq_fintype_card]
  have e : {f : Fin n → Option (Fin 3) // ∃ i, f i = none} ≃
      {f : Fin n → Option (Fin 3) // ¬ ∀ i, f i ≠ none} :=
    Equiv.subtypeEquivRight (fun f => by push Not; rfl)
  rw [Fintype.card_congr e, Fintype.card_subtype_compl,
    Fintype.card_congr (Equiv.subtypePiEquivPi (p := fun _ o => o ≠ none))]
  simp [Fintype.card_subtype_compl]

/-! ### A weighted lower bound from density Hales–Jewett (`den:weighted-lower`) -/

/-- The three directions $d_0=0$, $d_1=u_\theta$, $d_2=Mu_\theta$ in the proof of
`den:weighted-lower` (auxiliary for `den_weighted_lower`). -/
@[nolint defsWithUnderscore]
def aux_den_dvec (α β : ℝ) (θ : Ang) : Fin 3 → ℝ² := ![0, u θ, M α β (u θ)]

/-- The offset $a_w(\theta)=\sum_j\lambda_jd_{w_j}$ of a word in the proof of
`den:weighted-lower` (auxiliary for `den_weighted_lower`). -/
@[nolint defsWithUnderscore]
def aux_den_shift {n : ℕ} (α β : ℝ) (lam : Fin n → ℝ) (θ : Ang) (w : Fin n → Fin 3) : ℝ² :=
  ∑ j, lam j • aux_den_dvec α β θ (w j)

/-- The inner (in $x$) triangle integral of $\mathbf 1_A$ at scale $s$ and angle $\theta$, as a
lower integral (auxiliary for `den_weighted_lower`). -/
@[nolint defsWithUnderscore]
def aux_den_T (α β : ℝ) (A : Set ℝ²) (s : ℝ) (θ : Ang) : ℝ≥0∞ :=
  ∫⁻ x, A.indicator 1 x * A.indicator 1 (x + s • u θ) * A.indicator 1 (x + s • M α β (u θ))

/-- Joint measurability of the triangle integrand (auxiliary for `den_weighted_lower`). -/
theorem aux_den_integrand_measurable (α β : ℝ) (A : Set ℝ²) (hA : MeasurableSet A) (s : ℝ) :
    Measurable (fun p : Ang × ℝ² => A.indicator (1 : ℝ² → ℝ≥0∞) p.2 *
      A.indicator 1 (p.2 + s • u p.1) * A.indicator 1 (p.2 + s • M α β (u p.1))) := by
  have hf : Measurable (A.indicator (1 : ℝ² → ℝ≥0∞)) := measurable_const.indicator hA
  have hu := aux_lw_u_meas
  have hM := (M α β).continuous.measurable
  refine ((hf.comp measurable_snd).mul (hf.comp ?_)).mul (hf.comp ?_)
  · exact measurable_snd.add ((hu.comp measurable_fst).const_smul s)
  · exact measurable_snd.add ((hM.comp (hu.comp measurable_fst)).const_smul s)

/-- `θ ↦ aux_den_T` is measurable (auxiliary for `den_weighted_lower`). -/
theorem aux_den_T_measurable (α β : ℝ) (A : Set ℝ²) (hA : MeasurableSet A) (s : ℝ) :
    Measurable (aux_den_T α β A s) :=
  (aux_den_integrand_measurable α β A hA s).lintegral_prod_right'

/-- The triangle integral is at most `|A|` (auxiliary for `den_weighted_lower`). -/
theorem aux_den_T_le (α β : ℝ) (A : Set ℝ²) (hA : MeasurableSet A) (s : ℝ) (θ : Ang) :
    aux_den_T α β A s θ ≤ volume A := by
  rw [aux_den_T, ← lintegral_indicator_one hA]
  apply lintegral_mono
  intro x
  by_cases h1 : x + s • u θ ∈ A <;> by_cases h2 : x + s • M α β (u θ) ∈ A <;> simp [h1, h2]

/-- The triangle count of an indicator as a lower integral (auxiliary for
`den_weighted_lower`). -/
theorem aux_den_triangleCount_eq (α β : ℝ) (A : Set ℝ²) (hA : MeasurableSet A)
    (hAf : volume A ≠ ∞) (s : ℝ) :
    triangleCount α β s (A.indicator 1) = (∫⁻ θ, aux_den_T α β A s θ ∂σ).toReal := by
  have hind : ∀ y, A.indicator (1 : ℝ² → ℝ) y = (A.indicator (1 : ℝ² → ℝ≥0∞) y).toReal := by
    intro y; by_cases h : y ∈ A <;> simp [h]
  have hmeas := aux_den_integrand_measurable α β A hA s
  rw [triangleCount, ← integral_toReal (aux_den_T_measurable α β A hA s).aemeasurable
    (Eventually.of_forall fun θ => lt_of_le_of_lt (aux_den_T_le α β A hA s θ) hAf.lt_top)]
  congr 1
  funext θ
  rw [aux_den_T, ← integral_toReal]
  · congr 1; funext x; simp only [hind, ENNReal.toReal_mul]
  · exact (hmeas.comp measurable_prodMk_left).aemeasurable
  · exact Eventually.of_forall fun x => by
      by_cases h0 : x ∈ A <;> by_cases h1 : x + s • u θ ∈ A <;>
        by_cases h2 : x + s • M α β (u θ) ∈ A <;> simp [h0, h1, h2]

/-- The offset of the word `l c` on a line `l` splits into the fixed part plus
$s_J d_c$ (auxiliary for `den_weighted_lower`). -/
theorem aux_den_shift_line {n : ℕ} (α β : ℝ) (lam : Fin n → ℝ) (θ : Ang)
    (l : Combinatorics.Line (Fin 3) (Fin n)) (c : Fin 3) :
    aux_den_shift α β lam θ (l c) =
      (∑ j, lam j • (l.idxFun j).elim 0 (aux_den_dvec α β θ)) +
        subsum lam (lineVarSet l) • aux_den_dvec α β θ c := by
  classical
  simp only [aux_den_shift, subsum, lineVarSet, Finset.sum_filter, Finset.sum_smul,
    ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  cases h : l.idxFun j <;> simp [h]

/-- The $x$-integral of the product along a line equals the triangle integral at scale
$s_J$ (translation invariance; auxiliary for `den_weighted_lower`). -/
theorem aux_den_lintegral_line {n : ℕ} (α β : ℝ) (A : Set ℝ²) (lam : Fin n → ℝ) (θ : Ang)
    (l : Combinatorics.Line (Fin 3) (Fin n)) :
    ∫⁻ x, ∏ c, A.indicator (1 : ℝ² → ℝ≥0∞) (x + aux_den_shift α β lam θ (l c)) =
      aux_den_T α β A (subsum lam (lineVarSet l)) θ := by
  set b := ∑ j, lam j • (l.idxFun j).elim 0 (aux_den_dvec α β θ)
  set s := subsum lam (lineVarSet l)
  have h := lintegral_add_right_eq_self (μ := (volume : Measure ℝ²))
    (fun y => A.indicator (1 : ℝ² → ℝ≥0∞) y * A.indicator 1 (y + s • u θ) *
      A.indicator 1 (y + s • M α β (u θ))) b
  rw [aux_den_T, ← h]
  congr 1
  funext x
  simp only [aux_den_shift_line, Fin.prod_univ_three]
  simp [aux_den_dvec, add_assoc, b, s]

/-- For a fixed angle $\theta$, the weighted sum of inner triangle integrals is at least
$\frac\delta2|Q|$ (the core of the proof of `den:weighted-lower`; auxiliary for
`den_weighted_lower`). -/
theorem aux_den_pointwise (α β : ℝ) (δ : ℝ) (hδ0 : 0 < δ) (n : ℕ)
    (hn : ∀ A : Finset (Fin n → Fin 3), δ / 4 * (3 : ℝ) ^ n ≤ (A.card : ℝ) → ContainsLine A)
    (lam : Fin n → ℝ) (hlam : ∀ j, 0 < lam j) (z : ℝ²) (L : ℝ) (hL : 0 < L)
    (A : Set ℝ²) (hA : MeasurableSet A) (hAQ : A ⊆ squareAt z L)
    (hAδ : ENNReal.ofReal δ * volume (squareAt z L) ≤ volume A)
    (hQ' : volume (squareAt (z - (WithLp.toLp 2 fun _ => max 1 ‖M α β‖ * ∑ j, lam j : ℝ²))
        (L + 2 * (max 1 ‖M α β‖ * ∑ j, lam j))) ≤ 2 * volume (squareAt z L)) (θ : Ang) :
    ENNReal.ofReal (δ / 2) * volume (squareAt z L) ≤
      ∑ J ∈ Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty),
        (3 : ℝ≥0∞) ^ (n - J.card) * aux_den_T α β A (subsum lam J) θ := by
  classical
  set S := max 1 ‖M α β‖ * ∑ j, lam j with hS
  set Q := squareAt z L with hQdef
  set Q' := squareAt (z - (WithLp.toLp 2 fun _ => S : ℝ²)) (L + 2 * S) with hQ'def
  set f : ℝ² → ℝ≥0∞ := A.indicator 1 with hf
  have hfm : Measurable f := measurable_const.indicator hA
  set a := aux_den_shift α β lam θ with ha
  set m : ℝ² → ℝ≥0∞ := fun x => ∑ w, f (x + a w) with hmdef
  have hmm : Measurable m :=
    Finset.measurable_sum _ fun w _ => hfm.comp (measurable_id.add_const _)
  set G := {x | ENNReal.ofReal (δ / 4 * 3 ^ n) ≤ m x} with hGdef
  have hGm : MeasurableSet G := measurableSet_le measurable_const hmm
  have hQ'm : MeasurableSet Q' := aux_measurableSet_squareAt _ _
  -- norm bounds for the offsets
  have hd : ∀ c, ‖aux_den_dvec α β θ c‖ ≤ max 1 ‖M α β‖ := by
    intro c
    fin_cases c
    · simp [aux_den_dvec]
    · simp [aux_den_dvec, aux_cd_norm_u]
    · simp only [aux_den_dvec]
      simp only [Fin.reduceFinMk, Matrix.cons_val]
      exact ((M α β).le_opNorm _).trans (by rw [aux_cd_norm_u, mul_one]; exact le_max_right _ _)
  have ha_norm : ∀ w, ‖a w‖ ≤ S := by
    intro w
    calc ‖a w‖ ≤ ∑ j, ‖lam j • aux_den_dvec α β θ (w j)‖ := norm_sum_le _ _
      _ ≤ ∑ j, lam j * max 1 ‖M α β‖ := Finset.sum_le_sum fun j _ => by
          rw [norm_smul, Real.norm_of_nonneg (hlam j).le]
          exact mul_le_mul_of_nonneg_left (hd _) (hlam j).le
      _ = S := by rw [hS, ← Finset.sum_mul, mul_comm]
  have hsupp : ∀ x w, x + a w ∈ A → x ∈ Q' := by
    intro x w hxA i
    have h1 := hAQ hxA i
    have h2 : |a w i| ≤ S := (Real.norm_eq_abs _ ▸ PiLp.norm_apply_le (a w) i).trans (ha_norm w)
    simp only [PiLp.add_apply, Set.mem_Icc] at h1
    simp only [PiLp.sub_apply, Set.mem_Icc]
    rw [abs_le] at h2
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
  have hm_le : ∀ x, m x ≤ 3 ^ n := by
    intro x
    calc m x ≤ ∑ _w : Fin n → Fin 3, (1 : ℝ≥0∞) := Finset.sum_le_sum fun w _ => by
          simp only [f, Set.indicator_apply]; split_ifs <;> simp
      _ = 3 ^ n := by simp
  have hm_bd : ∀ x, m x ≤ 3 ^ n * G.indicator 1 x +
      ENNReal.ofReal (δ / 4 * 3 ^ n) * Q'.indicator 1 x := by
    intro x
    by_cases hxG : x ∈ G
    · rw [Set.indicator_of_mem hxG, Pi.one_apply, mul_one]
      exact le_add_right (hm_le x)
    · rw [Set.indicator_of_notMem hxG, mul_zero, zero_add]
      by_cases hxQ : x ∈ Q'
      · rw [Set.indicator_of_mem hxQ, Pi.one_apply, mul_one]
        exact (not_le.mp hxG).le
      · have : m x = 0 := Finset.sum_eq_zero fun w _ =>
          Set.indicator_of_notMem (fun h => hxQ (hsupp x w h)) _
        rw [this]; positivity
  have hint_m : ∫⁻ x, m x = 3 ^ n * volume A := by
    simp only [hmdef]
    rw [lintegral_finsetSum (f := fun w x => f (x + a w)) _
      (fun w _ => hfm.comp (measurable_id.add_const _))]
    have : ∀ w, ∫⁻ x, f (x + a w) = volume A := fun w => by
      rw [lintegral_add_right_eq_self f (a w)]; exact lintegral_indicator_one hA
    simp [this]
  have hvolQ : volume Q = ENNReal.ofReal (L ^ 2) := aux_volume_squareAt z L hL.le
  have hQfin : volume Q ≠ ∞ := by rw [hvolQ]; exact ENNReal.ofReal_ne_top
  have hG : ENNReal.ofReal (δ / 2) * volume Q ≤ volume G := by
    have h1 : 3 ^ n * volume A ≤ 3 ^ n * volume G + ENNReal.ofReal (δ / 4 * 3 ^ n) * volume Q' := by
      rw [← hint_m, ← lintegral_indicator_one hGm, ← lintegral_indicator_one hQ'm,
        ← lintegral_const_mul _ (measurable_one.indicator hGm),
        ← lintegral_const_mul _ (measurable_one.indicator hQ'm),
        ← lintegral_add_left ((measurable_one.indicator hGm).const_mul _)]
      exact lintegral_mono hm_bd
    have h2 : ENNReal.ofReal (δ / 4 * 3 ^ n) = 3 ^ n * ENNReal.ofReal (δ / 4) := by
      rw [ENNReal.ofReal_mul (by positivity), mul_comm]; simp
    have h22 : ENNReal.ofReal (δ / 2) = ENNReal.ofReal (δ / 4) * 2 := by
      rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by positivity)]; ring_nf
    have h3 : volume A ≤ volume G + ENNReal.ofReal (δ / 2) * volume Q := by
      have : 3 ^ n * volume A ≤ 3 ^ n * (volume G + ENNReal.ofReal (δ / 2) * volume Q) := by
        calc 3 ^ n * volume A ≤ 3 ^ n * volume G + 3 ^ n * ENNReal.ofReal (δ / 4) * volume Q' := by
              rw [h2] at h1; exact h1
          _ ≤ 3 ^ n * volume G + 3 ^ n * ENNReal.ofReal (δ / 4) * (2 * volume Q) := by
              gcongr
          _ = 3 ^ n * (volume G + ENNReal.ofReal (δ / 2) * volume Q) := by
              rw [h22]; ring
      exact (ENNReal.mul_le_mul_iff_right (pow_ne_zero _ (by norm_num))
        (ENNReal.pow_ne_top ENNReal.ofNat_ne_top)).mp this
    have h4 : ENNReal.ofReal δ = ENNReal.ofReal (δ / 2) + ENNReal.ofReal (δ / 2) := by
      rw [← ENNReal.ofReal_add (by positivity) (by positivity)]; ring_nf
    have h5 : ENNReal.ofReal (δ / 2) * volume Q + ENNReal.ofReal (δ / 2) * volume Q ≤
        volume G + ENNReal.ofReal (δ / 2) * volume Q := by
      rw [← add_mul, ← h4]; exact hAδ.trans h3
    exact (ENNReal.add_le_add_iff_right (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hQfin)).mp h5
  -- marked lines
  set P : Combinatorics.Line (Fin 3) (Fin n) → ℝ² → ℝ≥0∞ := fun l x => ∏ c, f (x + a (l c))
    with hPdef
  have hPm : ∀ l, Measurable (P l) := fun l =>
    Finset.measurable_prod _ fun c _ => hfm.comp (measurable_id.add_const _)
  have hGP : ∀ x, G.indicator 1 x ≤ ∑ l, P l x := by
    intro x
    by_cases hxG : x ∈ G
    · rw [Set.indicator_of_mem hxG, Pi.one_apply]
      set B := Finset.univ.filter (fun w => x + a w ∈ A) with hB
      have hmB : m x = B.card := by
        simp only [hmdef, f, B, Set.indicator_apply, Pi.one_apply]
        rw [Finset.sum_boole]
      have hBc : δ / 4 * 3 ^ n ≤ (B.card : ℝ) := by
        have h := hxG
        simp only [hGdef, Set.mem_ofPred_eq, hmB] at h
        rwa [← ENNReal.ofReal_natCast, ENNReal.ofReal_le_ofReal_iff (Nat.cast_nonneg _)] at h
      obtain ⟨l, hl⟩ := hn B hBc
      have hPl : P l x = 1 := Finset.prod_eq_one fun c _ => by
        have h := hl c
        simp only [B, Finset.mem_filter, Finset.mem_univ, true_and] at h
        simp [f, h]
      rw [← hPl]
      exact Finset.single_le_sum (f := fun l => P l x) (fun _ _ => by positivity)
        (Finset.mem_univ l)
    · rw [Set.indicator_of_notMem hxG]; positivity
  have hvolG : volume G ≤ ∑ l, ∫⁻ x, P l x := by
    rw [← lintegral_finsetSum _ fun l _ => hPm l, ← lintegral_indicator_one hGm]
    exact lintegral_mono hGP
  have hPT : ∀ l, ∫⁻ x, P l x = aux_den_T α β A (subsum lam (lineVarSet l)) θ :=
    fun l => aux_den_lintegral_line α β A lam θ l
  have hsum : ∑ l, ∫⁻ x, P l x = ∑ J ∈ Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty),
      (3 : ℝ≥0∞) ^ (n - J.card) * aux_den_T α β A (subsum lam J) θ := by
    simp_rw [hPT]
    rw [← Finset.sum_fiberwise_of_maps_to (g := lineVarSet)
      (t := Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty)) (fun l _ => by
        obtain ⟨i, hi⟩ := l.proper
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        exact ⟨i, by simp [lineVarSet, hi]⟩)]
    refine Finset.sum_congr rfl fun J hJ => ?_
    rw [Finset.sum_congr rfl (g := fun _ => aux_den_T α β A (subsum lam J) θ)
      (fun l hl => by rw [(Finset.mem_filter.mp hl).2])]
    rw [Finset.sum_const, nsmul_eq_mul]
    congr 1
    have h := den_line_number_fixed n J (Finset.mem_filter.mp hJ).2
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype] at h
    rw [h]; push_cast; rfl
  calc ENNReal.ofReal (δ / 2) * volume Q ≤ volume G := hG
    _ ≤ _ := hvolG
    _ = _ := hsum

/-- **Lemma `den:weighted-lower`**. Let $0<\delta\le1$ and choose $n\ge H_3(\delta/4)$ from
Theorem `cj:dhj3` (here: $n$ is such that every subset of $[3]^n$ of density at least $\delta/4$
contains a combinatorial line). Let $\lambda_1,\ldots,\lambda_n>0$ and put
$S=\max(1,\|M\|)\sum_{j=1}^n\lambda_j$. Suppose $A$ is a Borel subset of a square $Q$ with
$|A|\ge\delta|Q|$, and that $Q'=Q+[-S,S]^2$ satisfies $|Q'|\le2|Q|$. Then, for $f=\mathbf 1_A$,
$$\sum_{\varnothing\ne J\subset[n]}3^{n-|J|}D_{s_J}(f)\ge\frac{\delta}{2}|Q|.$$
(In Lean the blueprint hypothesis `(hδ1 : δ ≤ 1)` is omitted since the proof does not need it; see
`automation/ErrorReport.md`.) -/
theorem den_weighted_lower (α β : ℝ) (δ : ℝ) (hδ0 : 0 < δ) (n : ℕ)
    (hn : ∀ A : Finset (Fin n → Fin 3), δ / 4 * (3 : ℝ) ^ n ≤ (A.card : ℝ) → ContainsLine A)
    (lam : Fin n → ℝ) (hlam : ∀ j, 0 < lam j) (z : ℝ²) (L : ℝ) (hL : 0 < L)
    (A : Set ℝ²) (hA : MeasurableSet A) (hAQ : A ⊆ squareAt z L)
    (hAδ : ENNReal.ofReal δ * volume (squareAt z L) ≤ volume A)
    (hQ' : volume (squareAt (z - (WithLp.toLp 2 fun _ => max 1 ‖M α β‖ * ∑ j, lam j : ℝ²))
        (L + 2 * (max 1 ‖M α β‖ * ∑ j, lam j))) ≤ 2 * volume (squareAt z L)) :
    δ / 2 * (volume (squareAt z L)).toReal ≤
      ∑ J ∈ Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty),
        (3 : ℝ) ^ (n - J.card) * triangleCount α β (subsum lam J) (A.indicator 1) := by
  classical
  have hQfin : volume (squareAt z L) ≠ ∞ := by
    rw [aux_volume_squareAt z L hL.le]; exact ENNReal.ofReal_ne_top
  have hAfin : volume A ≠ ∞ := ne_top_of_le_ne_top hQfin (measure_mono hAQ)
  simp only [aux_den_triangleCount_eq α β A hA hAfin]
  have hT : ∀ J : Finset (Fin n), ∫⁻ θ, aux_den_T α β A (subsum lam J) θ ∂σ ≠ ∞ := by
    intro J
    refine ne_top_of_le_ne_top hAfin ?_
    calc ∫⁻ θ, aux_den_T α β A (subsum lam J) θ ∂σ ≤ ∫⁻ _θ, volume A ∂σ :=
          lintegral_mono fun θ => aux_den_T_le α β A hA _ θ
      _ = volume A := by simp
  have hrhs : ∑ J ∈ Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty),
      (3 : ℝ) ^ (n - J.card) * (∫⁻ θ, aux_den_T α β A (subsum lam J) θ ∂σ).toReal =
      (∫⁻ θ, ∑ J ∈ Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty),
        (3 : ℝ≥0∞) ^ (n - J.card) * aux_den_T α β A (subsum lam J) θ ∂σ).toReal := by
    rw [lintegral_finsetSum _ (fun J _ => (aux_den_T_measurable α β A hA _).const_mul _),
      ENNReal.toReal_sum (fun J _ => by
        rw [lintegral_const_mul _ (aux_den_T_measurable α β A hA _)]
        exact ENNReal.mul_ne_top (by simp) (hT J))]
    refine Finset.sum_congr rfl fun J _ => ?_
    rw [lintegral_const_mul _ (aux_den_T_measurable α β A hA _), ENNReal.toReal_mul]
    simp
  rw [hrhs]
  have hlhs : δ / 2 * (volume (squareAt z L)).toReal =
      (∫⁻ _θ, ENNReal.ofReal (δ / 2) * volume (squareAt z L) ∂σ).toReal := by
    simp [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ δ / 2)]
  rw [hlhs]
  refine ENNReal.toReal_mono ?_ (lintegral_mono fun θ =>
    aux_den_pointwise α β δ hδ0 n hn lam hlam z L hL A hA hAQ hAδ hQ' θ)
  rw [lintegral_finsetSum _ (fun J _ => (aux_den_T_measurable α β A hA _).const_mul _)]
  exact ENNReal.sum_ne_top.mpr fun J _ => by
    rw [lintegral_const_mul _ (aux_den_T_measurable α β A hA _)]
    exact ENNReal.mul_ne_top (by simp) (hT J)

/-! ### Selecting scales with close subsums (`den:select-scales`) -/

/-- A sequence of scales in an unbounded set `S ⊆ (0,∞)` growing so fast that
$(k+1)\lambda_k<\eta\lambda_{k+1}$ (auxiliary for `den_select_scales`). -/
theorem aux_den_fast_seq (S : Set ℝ) (hSu : ¬ BddAbove S) (η : ℝ) (hη : 0 < η) :
    ∃ μ : ℕ → ℝ, (∀ k, μ k ∈ S) ∧ StrictMono μ ∧ ∀ k : ℕ, ((k : ℝ) + 1) * μ k < η * μ (k + 1) := by
  have hnx : ∀ b : ℝ, ∃ x ∈ S, b < x := fun b => by
    by_contra h; push Not at h; exact hSu ⟨b, fun x hx => h x hx⟩
  choose nx hnxS hnxlt using hnx
  let μ : ℕ → ℝ := fun k => Nat.rec (nx 0) (fun k m => nx (max m (((k : ℝ) + 1) * m / η))) k
  have hsucc : ∀ k, μ (k + 1) = nx (max (μ k) (((k : ℝ) + 1) * μ k / η)) := fun k => rfl
  have hmem : ∀ k, μ k ∈ S := by
    intro k; cases k with
    | zero => exact hnxS 0
    | succ k => rw [hsucc]; exact hnxS _
  refine ⟨μ, hmem, strictMono_nat_of_lt_succ fun k => ?_, fun k => ?_⟩
  · rw [hsucc]; exact (le_max_left _ _).trans_lt (hnxlt _)
  · have h := (le_max_right _ _).trans_lt (hnxlt (max (μ k) (((k : ℝ) + 1) * μ k / η)))
    rw [← hsucc, div_lt_iff₀ hη] at h
    linarith

/-- **Lemma `den:select-scales`**. Let $\mathcal S\subset(0,\infty)$ be unbounded. Given $n\ge1$
and $\tau>0$, one can choose $\lambda_1<\cdots<\lambda_n$ in $\mathcal S$ such that, for every
nonempty $J\subset[n]$ and $k=\max J$, $\|\Lambda_{\sigma_{s_J}-\sigma_{\lambda_k}}\|<\tau$.
(In Lean the blueprint hypothesis `(hn : 1 ≤ n)` is omitted since the proof does not need it; see
`automation/ErrorReport.md`.) -/
theorem den_select_scales (α β : ℝ) (hβ : β ≠ 0) (S : Set ℝ) (hS : S ⊆ Ioi 0)
    (hSu : ¬ BddAbove S) (n : ℕ) (τ : ℝ) (hτ : 0 < τ) :
    ∃ lam : Fin n → ℝ, StrictMono lam ∧ (∀ k, lam k ∈ S) ∧
      ∀ (J : Finset (Fin n)) (hJ : J.Nonempty),
        formNorm α β ((FCMeasure.sigma.dil (∑ j ∈ J, lam j)).sub
          (FCMeasure.sigma.dil (lam (J.max' hJ)))) < ENNReal.ofReal τ := by
  have hc := den_continuity α β hβ 2
  have hev : ∀ᶠ r in 𝓝 (1 : ℝ),
      endNorm α β ((FCMeasure.sigma.dil r).sub FCMeasure.sigma) 2 < ENNReal.ofReal τ :=
    hc (gt_mem_nhds (by simpa using hτ))
  obtain ⟨η, hη, hηP⟩ := Metric.eventually_nhds_iff.1 hev
  obtain ⟨μ, hμS, hμm, hμg⟩ := aux_den_fast_seq S hSu η hη
  have hμ0 : ∀ k, 0 < μ k := fun k => hS (hμS k)
  refine ⟨fun k => μ k, fun a b hab => hμm hab, fun k => hμS k, fun J hJ => ?_⟩
  set k := J.max' hJ with hk
  set sJ := ∑ j ∈ J, μ j with hsJ
  have hkJ : k ∈ J := J.max'_mem hJ
  have hsplit : sJ = μ k + ∑ j ∈ J.erase k, μ j := by
    rw [hsJ, ← Finset.add_sum_erase J _ hkJ]
  have hrest0 : 0 ≤ ∑ j ∈ J.erase k, μ j :=
    Finset.sum_nonneg fun j _ => (hμ0 j).le
  have hrest : ∑ j ∈ J.erase k, μ j < η * μ k := by
    rcases Nat.eq_zero_or_pos (k : ℕ) with h0 | hpos
    · have he : J.erase k = ∅ := by
        rw [Finset.eq_empty_iff_forall_notMem]
        intro j hj
        have hjk : j < k := lt_of_le_of_ne (J.le_max' j (Finset.mem_of_mem_erase hj))
          (Finset.ne_of_mem_erase hj)
        have : (j : ℕ) < k := hjk
        omega
      rw [he, Finset.sum_empty]; exact mul_pos hη (hμ0 _)
    · obtain ⟨m, hm⟩ : ∃ m, (k : ℕ) = m + 1 := ⟨(k : ℕ) - 1, by omega⟩
      have hle : ∀ j ∈ J.erase k, μ j ≤ μ m := by
        intro j hj
        have hjk : j < k := lt_of_le_of_ne (J.le_max' j (Finset.mem_of_mem_erase hj))
          (Finset.ne_of_mem_erase hj)
        have : (j : ℕ) ≤ m := by have : (j : ℕ) < k := hjk; omega
        exact hμm.monotone this
      have hcard : (J.erase k).card ≤ m + 1 := by
        rw [← hm, ← Fin.card_Iio k]
        refine Finset.card_le_card fun j hj => ?_
        rw [Finset.mem_Iio]
        exact lt_of_le_of_ne (J.le_max' j (Finset.mem_of_mem_erase hj)) (Finset.ne_of_mem_erase hj)
      calc ∑ j ∈ J.erase k, μ j ≤ ∑ j ∈ J.erase k, μ m := Finset.sum_le_sum hle
        _ = (J.erase k).card * μ m := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ((m : ℝ) + 1) * μ m := by
            gcongr
            · exact (hμ0 m).le
            · exact_mod_cast hcard
        _ < η * μ (m + 1) := hμg m
        _ = η * μ k := by rw [hm]
  set r := sJ / μ k with hr
  have hμk := hμ0 k
  have hrsJ : μ k * r = sJ := by rw [hr]; field_simp
  have hdist : dist r 1 < η := by
    rw [Real.dist_eq, abs_lt]
    constructor
    · rw [hr, lt_sub_iff_add_lt, lt_div_iff₀ hμk]; nlinarith
    · rw [hr, sub_lt_iff_lt_add, div_lt_iff₀ hμk]; nlinarith
  have heq : (FCMeasure.sigma.dil sJ).sub (FCMeasure.sigma.dil (μ k)) =
      ((FCMeasure.sigma.dil r).sub FCMeasure.sigma).dil (μ k) := by
    rw [aux_den_dil_sub, aux_den_dil_dil, hrsJ]
  change endNorm α β ((FCMeasure.sigma.dil sJ).sub (FCMeasure.sigma.dil (μ k))) 2 < _
  rw [heq, lem_form_basic_scaling α β _ 2 _ hμk]
  exact hηP hdist

/-! ### All sufficiently large planar triangles (`den:main`) -/

/-- The triangle count of an indicator is the counting form of the dilated circle measure:
$D_s(\mathbf 1_A)=\Lambda_{\sigma_s}(\mathbf 1_A,\mathbf 1_A,\mathbf 1_A)$
(auxiliary for `den_main`). -/
theorem aux_den_tc_form (α β : ℝ) (A : Set ℝ²) (s : ℝ) :
    ((triangleCount α β s (A.indicator 1) : ℝ) : ℂ) =
      form α β (FCMeasure.sigma.dil s) (A.indicator fun _ => (1 : ℂ))
        (A.indicator fun _ => (1 : ℂ)) (A.indicator fun _ => (1 : ℂ)) := by
  have hpt : ∀ a : ℝ², ((A.indicator (1 : ℝ² → ℝ) a : ℝ) : ℂ) =
      A.indicator (fun _ => (1 : ℂ)) a := by
    intro a; by_cases h : a ∈ A <;> simp [h]
  unfold triangleCount form
  rw [← integral_complex_ofReal]
  refine integral_congr_ae (Eventually.of_forall fun θ => ?_)
  simp only [FCMeasure.dil, FCMeasure.sigma, mul_one, map_smul]
  rw [← integral_complex_ofReal]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [Complex.ofReal_mul, hpt]

/-- For an indicator of a set of finite measure,
$|\Lambda_\nu(\mathbf 1_A,\mathbf 1_A,\mathbf 1_A)|\le\|\Lambda_\nu\||A|$
(homogeneity of the endpoint norm; auxiliary for `den_main`). -/
theorem aux_den_form_ind_le (α β : ℝ) (ν : FCMeasure) (A : Set ℝ²) (hA : MeasurableSet A)
    (hAf : volume A ≠ ∞) :
    ‖form α β ν (A.indicator fun _ => (1 : ℂ)) (A.indicator fun _ => (1 : ℂ))
        (A.indicator fun _ => (1 : ℂ))‖ₑ ≤ formNorm α β ν * volume A := by
  set g : ℝ² → ℂ := A.indicator fun _ => (1 : ℂ) with hg
  have hgm : AEStronglyMeasurable g volume :=
    (aestronglyMeasurable_const.indicator hA)
  have h2 : eLpNorm g 2 volume = volume A ^ (1 / (2 : ℝ)) := by
    rw [hg, eLpNorm_indicator_const hA (by norm_num) (by norm_num)]; simp
  have hinf : eLpNorm g ⊤ volume ≤ 1 := by
    refine (eLpNorm_indicator_const_le (μ := volume) (s := A) (c := (1 : ℂ)) ⊤).trans ?_
    simp
  by_cases h0 : volume A = 0
  · have hb := lem_form_basic_bound α β ν 2 (fun _ => g) (fun _ => hgm)
    have : eLpNorm g (aux_slotExp 2 0) volume = 0 := by
      simp [aux_slotExp, h2, h0]
    rw [Fin.prod_univ_three, this, zero_mul, zero_mul, mul_zero] at hb
    exact hb.trans (by simp)
  · set a : ℝ := (volume A).toReal with ha
    have hapos : 0 < a := ENNReal.toReal_pos h0 hAf
    set c : ℂ := (((Real.sqrt a)⁻¹ : ℝ) : ℂ) with hc
    set cj : Fin 3 → ℂ := ![c, c, 1] with hcj
    have hsm := aux_fb_form_smul α β ν cj (fun _ => g)
    simp only [hcj, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, one_mul, mul_one] at hsm
    have hcn : ‖c‖ₑ = ENNReal.ofReal (Real.sqrt a)⁻¹ := by
      rw [hc, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have hcg : eLpNorm (fun x => c * g x) 2 volume = 1 := by
      rw [show (fun x => c * g x) = c • g from rfl, eLpNorm_const_smul, h2, hcn]
      rw [← ENNReal.ofReal_toReal hAf, ← ha, ENNReal.ofReal_rpow_of_nonneg hapos.le (by norm_num),
        ← ENNReal.ofReal_mul (by positivity), ← Real.sqrt_eq_rpow, inv_mul_cancel₀ (by positivity),
        ENNReal.ofReal_one]
    have hle := aux_den_form_le_endNorm α β ν 2 ![fun x => c * g x, fun x => c * g x, g]
      (fun j => by
        fin_cases j <;>
          simp only [Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero, Fin.mk_one,
            Matrix.cons_val_one, Fin.reduceFinMk, Matrix.cons_val] <;>
          first | exact hgm | exact hgm.const_mul c)
      (by simpa using hinf)
      (fun j hj => by fin_cases j <;> simp_all)
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at hle
    rw [hsm, enorm_mul] at hle
    have hcc : ‖c * c‖ₑ * volume A = 1 := by
      rw [enorm_mul, hcn, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_toReal hAf, ← ha,
        ← ENNReal.ofReal_mul (by positivity), ← mul_inv, Real.mul_self_sqrt hapos.le,
        inv_mul_cancel₀ hapos.ne', ENNReal.ofReal_one]
    calc ‖form α β ν g g g‖ₑ = ‖c * c‖ₑ * volume A * ‖form α β ν g g g‖ₑ := by
          rw [hcc, one_mul]
      _ = ‖c * c‖ₑ * ‖form α β ν g g g‖ₑ * volume A := by ring
      _ ≤ formNorm α β ν * volume A := by gcongr; exact hle

/-- A scale that is not missed by $E$ gives a translate of a rotation of $s\{0,e_1,Me_1\}$
inside $E$ (auxiliary for `den_main`). -/
theorem aux_den_copy_of_not_missed (α β : ℝ) (E : Set ℝ²) (s : ℝ) (hs : ¬ IsMissed α β E s) :
    ∃ (x : ℝ²) (t : ℝ), ∀ p ∈ ({0, e1, M α β e1} : Set ℝ²), x + rot t (s • p) ∈ E := by
  unfold IsMissed at hs
  push Not at hs
  obtain ⟨x, θ, h1, h2, h3⟩ := hs
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective θ
  have hu : u (t : Ang) = rot t e1 := by
    rw [aux_rot_e1]; rfl
  have hcomm : ∀ v, rot t (M α β v) = M α β (rot t v) := by
    intro v
    have h := (aux_simil_comp (Real.cos t) (Real.sin t) α β).trans
      ((congrArg₂ simil (by ring) (by ring)).trans
        (aux_simil_comp α β (Real.cos t) (Real.sin t)).symm)
    exact congrArg (fun T : ℝ² →L[ℝ] ℝ² => T v) h
  refine ⟨x, t, ?_⟩
  intro p hp
  rcases hp with rfl | rfl | rfl
  · simpa using h1
  · rw [map_smul, ← hu]; exact h2
  · rw [map_smul, hcomm, ← hu]; exact h3

/-- The core of the proof of `den:main`: the set of missed scales is bounded
(auxiliary for `den_main`). -/
theorem aux_den_missed_bdd (α β : ℝ) (hβ : β ≠ 0) (E : Set ℝ²) (hE : NullMeasurableSet E volume)
    (hd : 0 < upperBanachDensity E) :
    BddAbove {s : ℝ | 0 < s ∧ IsMissed α β E s} := by
  by_contra hSu
  set Sm := {s : ℝ | 0 < s ∧ IsMissed α β E s} with hSm
  -- the density parameter
  obtain ⟨r, hr0, hrpos, hrlt⟩ := ENNReal.lt_iff_exists_real_btwn.1 hd
  set δ := min r 1 with hδ
  have hδ0 : 0 < δ := lt_min (ENNReal.ofReal_pos.1 hrpos) one_pos
  have hδ1 : δ ≤ 1 := min_le_right _ _
  have hδd : ENNReal.ofReal δ < upperBanachDensity E :=
    lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (min_le_left _ _)) hrlt
  obtain ⟨H, hH⟩ := cj_dhj3 (δ := δ / 4) (by positivity) (by linarith)
  set n := max H 1 with hn
  have hnH := hH n (le_max_left _ _)
  set τ := δ / (4 * 4 ^ n) with hτ
  have hτ0 : 0 < τ := by positivity
  obtain ⟨lam, -, hlamS, hclose⟩ := den_select_scales α β hβ Sm (fun s hs => hs.1) hSu n τ hτ0
  have hlam0 : ∀ j, 0 < lam j := fun j => (hlamS j).1
  set S0 := max 1 ‖M α β‖ * ∑ j, lam j with hS0def
  have hS0 : 0 ≤ S0 := mul_nonneg (le_max_of_le_left zero_le_one)
    (Finset.sum_nonneg fun j _ => (hlam0 j).le)
  -- a dense square
  obtain ⟨z, L, hLL, hL, hdens⟩ := den_dense_squares_exists E δ hδd (5 * S0)
  set Q := squareAt z L with hQ
  have hQm : MeasurableSet Q := aux_measurableSet_squareAt z L
  have hQv : volume Q = ENNReal.ofReal (L ^ 2) := aux_volume_squareAt z L hL.le
  obtain ⟨A, hAm, hAsub, hAv⟩ := den_dense_squares_borel E hE Q hQm
  have hAQ : A ⊆ Q := hAsub.trans inter_subset_right
  have hAE : A ⊆ E := hAsub.trans inter_subset_left
  have hAδ : ENNReal.ofReal δ * volume Q ≤ volume A := hAv ▸ hdens
  have hQ' : volume (squareAt (z - (WithLp.toLp 2 fun _ => max 1 ‖M α β‖ * ∑ j, lam j : ℝ²))
      (L + 2 * (max 1 ‖M α β‖ * ∑ j, lam j))) ≤ 2 * volume (squareAt z L) := by
    rw [aux_volume_squareAt _ _ (by positivity), hQv,
      show (2 : ℝ≥0∞) * ENNReal.ofReal (L ^ 2) = ENNReal.ofReal (2 * L ^ 2) by
        rw [ENNReal.ofReal_mul (by norm_num)]; simp]
    exact ENNReal.ofReal_le_ofReal (by nlinarith)
  have hlow := den_weighted_lower α β δ hδ0 n hnH lam hlam0 z L hL A hAm hAQ hAδ hQ'
  -- the upper bound for each subsum
  have hAf : volume A ≠ ∞ := ne_top_of_le_ne_top (by rw [hQv]; exact ENNReal.ofReal_ne_top)
    (measure_mono hAQ)
  have hQr : (volume Q).toReal = L ^ 2 := by rw [hQv, ENNReal.toReal_ofReal (by positivity)]
  have hAQr : (volume A).toReal ≤ L ^ 2 := by
    rw [← hQr]; exact ENNReal.toReal_mono (by rw [hQv]; exact ENNReal.ofReal_ne_top)
      (measure_mono hAQ)
  have hup : ∀ J : Finset (Fin n), J.Nonempty →
      triangleCount α β (subsum lam J) (A.indicator 1) ≤ τ * L ^ 2 := by
    intro J hJ
    set g : ℝ² → ℂ := A.indicator fun _ => (1 : ℂ) with hg
    have hgm : ∀ j, MemLp ((fun _ : Fin 3 => g) j) (aux_slotExp 2 j) volume := by
      intro j
      exact memLp_indicator_const _ hAm (1 : ℂ) (Or.inr hAf)
    have hc := hclose J hJ
    have hmiss := den_dense_squares_missed α β E A hAE _ (hlamS (J.max' hJ)).2
    have hb := aux_den_form_ind_le α β ((FCMeasure.sigma.dil (∑ j ∈ J, lam j)).sub
      (FCMeasure.sigma.dil (lam (J.max' hJ)))) A hAm hAf
    have hsub := aux_appr_form_sub α β (FCMeasure.sigma.dil (∑ j ∈ J, lam j))
      (FCMeasure.sigma.dil (lam (J.max' hJ))) 2 (fun _ => g) hgm
    rw [hsub, ← aux_den_tc_form, ← aux_den_tc_form, hmiss, Complex.ofReal_zero, sub_zero] at hb
    have hb' := hb.trans (mul_le_mul_left hc.le _)
    have hfin : ENNReal.ofReal τ * volume A ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top hAf
    have hD := ENNReal.toReal_mono hfin hb'
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hτ0.le, ← ofReal_norm,
      ENNReal.toReal_ofReal (norm_nonneg _), Complex.norm_real, Real.norm_eq_abs] at hD
    calc triangleCount α β (subsum lam J) (A.indicator 1) ≤ |triangleCount α β
          (∑ j ∈ J, lam j) (A.indicator 1)| := le_abs_self _
      _ ≤ τ * (volume A).toReal := hD
      _ ≤ τ * L ^ 2 := mul_le_mul_of_nonneg_left hAQr hτ0.le
  have hsum : ∑ J ∈ Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty),
      (3 : ℝ) ^ (n - J.card) * triangleCount α β (subsum lam J) (A.indicator 1) ≤
      (4 : ℝ) ^ n * (τ * L ^ 2) := by
    calc _ ≤ ∑ J ∈ Finset.univ.filter (fun J : Finset (Fin n) => J.Nonempty),
          (3 : ℝ) ^ (n - J.card) * (τ * L ^ 2) :=
          Finset.sum_le_sum fun J hJ => mul_le_mul_of_nonneg_left
            (hup J (Finset.mem_filter.1 hJ).2) (by positivity)
      _ ≤ ∑ J : Finset (Fin n), (3 : ℝ) ^ (n - J.card) * (τ * L ^ 2) :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            (fun _ _ _ => by positivity)
      _ = (4 : ℝ) ^ n * (τ * L ^ 2) := by
          rw [← Finset.sum_mul]
          congr 1
          have := Fin.sum_pow_mul_eq_add_pow (n := n) (1 : ℝ) 3
          simp only [one_pow, one_mul] at this
          rw [this]; norm_num
  rw [hQr] at hlow
  have h4 : (4 : ℝ) ^ n * (τ * L ^ 2) = δ / 4 * L ^ 2 := by
    rw [hτ]; field_simp
  have hL2 : 0 < L ^ 2 := by positivity
  nlinarith [hlow.trans (hsum.trans h4.le)]

/-- **Theorem `den:main`** (normalized triangle). If $E\subset\R^2$ is Lebesgue measurable with
$d^*(E)>0$, then every sufficiently large scale of $\{0,e_1,Me_1\}$ has a translate of a rotation
contained in $E$. -/
theorem den_main (α β : ℝ) (hβ : β ≠ 0) (E : Set ℝ²) (hE : NullMeasurableSet E volume)
    (hd : 0 < upperBanachDensity E) :
    ∃ lam₀ : ℝ, 0 < lam₀ ∧ ∀ lam : ℝ, lam₀ ≤ lam →
      ∃ (x : ℝ²) (t : ℝ), ∀ p ∈ ({0, e1, M α β e1} : Set ℝ²), x + rot t (lam • p) ∈ E := by
  obtain ⟨b, hb⟩ := aux_den_missed_bdd α β hβ E hE hd
  refine ⟨max 1 (b + 1), lt_max_of_lt_left one_pos, fun lam hlam => ?_⟩
  refine aux_den_copy_of_not_missed α β E lam fun hm => ?_
  have h1 := hb ⟨lt_of_lt_of_le one_pos ((le_max_left _ _).trans hlam), hm⟩
  linarith [(le_max_right 1 (b + 1)).trans hlam]

/-- Composition of rotations, $R_aR_b=R_{a+b}$ (auxiliary for `den_main_general`). -/
theorem aux_den_rot_rot (a b : ℝ) (v : ℝ²) : rot a (rot b v) = rot (a + b) v := by
  have h := aux_simil_comp (Real.cos a) (Real.sin a) (Real.cos b) (Real.sin b)
  rw [← Real.cos_add, show Real.cos a * Real.sin b + Real.sin a * Real.cos b = Real.sin (a + b) by
    rw [Real.sin_add]; ring] at h
  exact congrArg (fun T : ℝ² →L[ℝ] ℝ² => T v) h

/-- **Theorem `den:main`** (general triangle). Consequently the same conclusion holds for any
prescribed noncollinear planar triangle. -/
theorem den_main_general (a b c : ℝ²) (hΔ : ¬ Collinear ℝ ({a, b, c} : Set ℝ²)) (E : Set ℝ²)
    (hE : NullMeasurableSet E volume) (hd : 0 < upperBanachDensity E) :
    ∃ lam₀ : ℝ, 0 < lam₀ ∧ ∀ lam : ℝ, lam₀ ≤ lam →
      ∃ (x : ℝ²) (t : ℝ), ∀ p ∈ ({a, b, c} : Set ℝ²), x + rot t (lam • p) ∈ E := by
  obtain ⟨z₀, s, t₀, α, β, hs, hβ, hset⟩ := lem_geometry_normalization a b c hΔ
  obtain ⟨lam₀, hlam₀, hmain⟩ := den_main α β hβ E hE hd
  refine ⟨lam₀ / s, div_pos hlam₀ hs, fun lam hlam => ?_⟩
  have hls : lam₀ ≤ lam * s := by rwa [div_le_iff₀ hs] at hlam
  obtain ⟨x, t, hx⟩ := hmain (lam * s) hls
  refine ⟨x - rot (t - t₀) (lam • z₀), t - t₀, fun p hp => ?_⟩
  rw [hset] at hp
  obtain ⟨q, hq, rfl⟩ := hp
  have := hx q hq
  convert this using 1
  simp only [smul_add, map_add, smul_smul, map_smul, aux_den_rot_rot, sub_add_cancel]
  abel

end Auto
