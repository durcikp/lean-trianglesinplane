/-- Cauchy–Schwarz for a nonnegative symmetric operator: `‖Bx‖² ≤ ‖B‖ ⟨Bx,x⟩`
(helper for `Auto.ext_compact_gap`). -/
theorem aux_norm_sq_le_re_inner (B : H →L[ℂ] H) (hsym : ∀ x y, ⟪B x, y⟫_ℂ = ⟪x, B y⟫_ℂ)
    (hpos : ∀ x, 0 ≤ RCLike.re ⟪B x, x⟫_ℂ) (x : H) :
    ‖B x‖ ^ 2 ≤ ‖B‖ * RCLike.re ⟪B x, x⟫_ℂ := by
  by_cases hB0 : ‖B‖ = 0
  · rw [norm_eq_zero] at hB0; simp [hB0]
  have hBpos : 0 < ‖B‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hB0)
  set t : ℝ := 1 / ‖B‖ with ht
  have h1 : ⟪B (B x), x⟫_ℂ = ((‖B x‖ ^ 2 : ℝ) : ℂ) := by
    rw [hsym, inner_self_eq_norm_sq_to_K]; push_cast; rfl
  have h2 : ⟪B x, B x⟫_ℂ = ((‖B x‖ ^ 2 : ℝ) : ℂ) := by
    rw [inner_self_eq_norm_sq_to_K]; push_cast; rfl
  have key : RCLike.re ⟪B (x - (t : ℂ) • B x), x - (t : ℂ) • B x⟫_ℂ =
      RCLike.re ⟪B x, x⟫_ℂ - 2 * t * ‖B x‖ ^ 2 + t ^ 2 * RCLike.re ⟪B (B x), B x⟫_ℂ := by
    simp only [map_sub, map_smul, inner_sub_left, inner_sub_right, inner_smul_left,
      inner_smul_right, h1, h2, Complex.conj_ofReal]
    simp only [RCLike.re_to_complex, Complex.sub_re, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero, mul_zero]
    ring
  have hc : RCLike.re ⟪B (B x), B x⟫_ℂ ≤ ‖B‖ * ‖B x‖ ^ 2 := by
    calc RCLike.re ⟪B (B x), B x⟫_ℂ ≤ ‖B (B x)‖ * ‖B x‖ :=
          (RCLike.re_le_norm _).trans (norm_inner_le_norm _ _)
      _ ≤ ‖B‖ * ‖B x‖ * ‖B x‖ := by gcongr; exact B.le_opNorm _
      _ = ‖B‖ * ‖B x‖ ^ 2 := by ring
  have h0 := hpos (x - (t : ℂ) • B x)
  rw [key] at h0
  have ht2 : t ^ 2 * ‖B‖ = t := by rw [ht]; field_simp
  have : t * ‖B x‖ ^ 2 ≤ RCLike.re ⟪B x, x⟫_ℂ := by
    have := mul_le_mul_of_nonneg_left hc (sq_nonneg t)
    nlinarith
  rw [ht] at this
  rw [div_mul_eq_mul_div, one_mul, div_le_iff₀ hBpos] at this
  linarith

/-- **Lemma `ext:compact-gap`** (coercivity off the kernel).
Let $K$ be a compact self-adjoint operator on a Hilbert space, and suppose $B=I+K$ is
nonnegative.  Then $\ker B$ is finite dimensional, and there is $\gamma>0$ such that
$$\langle Bf,f\rangle\ge\gamma\operatorname{dist}(f,\ker B)^2\qquad(f\in H).$$ -/
theorem ext_compact_gap (K : H →L[ℂ] H) (hK : IsCompactOperator K) (hsa : IsSelfAdjoint K)
    (hB : ∀ f : H, 0 ≤ RCLike.re ⟪(1 + K) f, f⟫_ℂ) :
    ∃ γ > (0 : ℝ), ∀ f : H,
      γ * Metric.infDist f (LinearMap.ker ((1 + K : H →L[ℂ] H) : H →ₗ[ℂ] H) : Set H) ^ 2 ≤
        RCLike.re ⟪(1 + K) f, f⟫_ℂ := by
  have hfd := ext_compact_gap_ker K hK
  set B : H →L[ℂ] H := 1 + K with hBdef
  set V := LinearMap.ker (B : H →ₗ[ℂ] H)
  have hBsa : IsSelfAdjoint B := (IsSelfAdjoint.one _).add hsa
  have hsym : ∀ x y, ⟪B x, y⟫_ℂ = ⟪x, B y⟫_ℂ := fun x y => hBsa.isSymmetric x y
  have hBK : ∀ x, B x = x + K x := fun x => by simp [hBdef]
  -- coercivity on the orthogonal complement
  have hγ : ∃ γ > (0 : ℝ), ∀ w ∈ Vᗮ, γ * ‖w‖ ^ 2 ≤ RCLike.re ⟪B w, w⟫_ℂ := by
    by_contra hcon
    push Not at hcon
    have hw : ∀ n : ℕ, ∃ w ∈ Vᗮ, RCLike.re ⟪B w, w⟫_ℂ < (1 / ((n : ℝ) + 1)) * ‖w‖ ^ 2 :=
      fun n => hcon _ (by positivity)
    choose w hwV hwlt using hw
    have hw0 : ∀ n, w n ≠ 0 := by
      intro n h
      have := hwlt n
      simp [h] at this
    set u : ℕ → H := fun n => ((‖w n‖⁻¹ : ℝ) : ℂ) • w n with hu
    have hunorm : ∀ n, ‖u n‖ = 1 := by
      intro n
      simp only [hu, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_inv, abs_norm]
      exact inv_mul_cancel₀ (norm_ne_zero_iff.2 (hw0 n))
    have huV : ∀ n, u n ∈ Vᗮ := fun n => Submodule.smul_mem _ _ (hwV n)
    have hure : ∀ n, RCLike.re ⟪B (u n), u n⟫_ℂ < 1 / ((n : ℝ) + 1) := by
      intro n
      have hpos : 0 < ‖w n‖ := norm_pos_iff.2 (hw0 n)
      have : RCLike.re ⟪B (u n), u n⟫_ℂ = ‖w n‖⁻¹ ^ 2 * RCLike.re ⟪B (w n), w n⟫_ℂ := by
        simp only [hu, map_smul, inner_smul_left, inner_smul_right, Complex.conj_ofReal]
        simp only [RCLike.re_to_complex, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
          zero_mul, sub_zero]
        ring
      rw [this]
      calc ‖w n‖⁻¹ ^ 2 * RCLike.re ⟪B (w n), w n⟫_ℂ
          < ‖w n‖⁻¹ ^ 2 * ((1 / ((n : ℝ) + 1)) * ‖w n‖ ^ 2) := by
            gcongr; exact hwlt n
        _ = 1 / ((n : ℝ) + 1) := by field_simp
    -- `B u n → 0`
    have hBu : Tendsto (fun n => B (u n)) atTop (𝓝 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      have hsq : Tendsto (fun n => ‖B (u n)‖ ^ 2) atTop (𝓝 0) := by
        have hlim : Tendsto (fun n : ℕ => ‖B‖ * (1 / ((n : ℝ) + 1))) atTop (𝓝 0) := by
          simpa using tendsto_one_div_add_atTop_nhds_zero_nat.const_mul ‖B‖
        refine squeeze_zero (fun n => sq_nonneg _) (fun n => ?_) hlim
        exact (aux_norm_sq_le_re_inner B hsym hB (u n)).trans
          (mul_le_mul_of_nonneg_left (hure n).le (norm_nonneg _))
      have := (Real.continuous_sqrt.tendsto 0).comp hsq
      simpa [Function.comp_def, Real.sqrt_sq (norm_nonneg _)] using this
    -- compactness
    have hmem : ∀ n, K (u n) ∈ closure (K '' Metric.closedBall 0 1) := fun n =>
      subset_closure ⟨u n, by simp [hunorm n], rfl⟩
    obtain ⟨z, -, φ, hφ, hz⟩ := (hK.isCompact_closure_image_closedBall 1).tendsto_subseq hmem
    have hulim : Tendsto (u ∘ φ) atTop (𝓝 (-z)) := by
      have : u ∘ φ = fun n => B (u (φ n)) - K (u (φ n)) := by
        funext n; simp [hBK]
      rw [this]
      simpa using (hBu.comp hφ.tendsto_atTop).sub hz
    have hn1 : ‖-z‖ = 1 := by
      have := (continuous_norm.tendsto _).comp hulim
      simp only [Function.comp_def, hunorm] at this
      exact tendsto_nhds_unique this tendsto_const_nhds
    have hzW : -z ∈ Vᗮ :=
      (Submodule.isClosed_orthogonal V).mem_of_tendsto hulim (Eventually.of_forall fun n => huV _)
    have hzV : -z ∈ V := by
      have h1 := (B.continuous.tendsto _).comp hulim
      have h2 := hBu.comp hφ.tendsto_atTop
      have : B (-z) = 0 := tendsto_nhds_unique h1 h2
      exact this
    have := Submodule.inner_right_of_mem_orthogonal hzV hzW
    rw [inner_self_eq_zero] at this
    rw [this, norm_zero] at hn1
    exact zero_ne_one hn1
  obtain ⟨γ, hγpos, hγ⟩ := hγ
  refine ⟨γ, hγpos, fun f => ?_⟩
  set P := V.starProjection f
  have hPV : P ∈ V := V.starProjection_apply_mem f
  have hwW : f - P ∈ Vᗮ := V.sub_starProjection_mem_orthogonal f
  have hBP : B P = 0 := hPV
  have hre : RCLike.re ⟪B f, f⟫_ℂ = RCLike.re ⟪B (f - P), f - P⟫_ℂ := by
    have hBf : B f = B (f - P) := by rw [map_sub, hBP, sub_zero]
    have e : ⟪B (f - P), f⟫_ℂ = ⟪B (f - P), f - P⟫_ℂ := by
      calc ⟪B (f - P), f⟫_ℂ = ⟪B (f - P), P + (f - P)⟫_ℂ := by rw [add_sub_cancel]
        _ = _ := by rw [inner_add_right, hsym (f - P) P, hBP, inner_zero_right, zero_add]
    rw [hBf, e]
  have hdist : Metric.infDist f (V : Set H) ≤ ‖f - P‖ := by
    rw [← dist_eq_norm]; exact Metric.infDist_le_dist_of_mem hPV
  rw [hre]
  calc γ * Metric.infDist f (V : Set H) ^ 2 ≤ γ * ‖f - P‖ ^ 2 := by
        gcongr; exact Metric.infDist_nonneg
    _ ≤ _ := hγ _ hwW

/-! ### Sequential weak-* extraction (`ext:weakstar`)

Weak-* convergence `f_n ⇀ g` in `L^∞(m)` is written out against all `L¹(m)` test functions:
`∫ f_n φ dm → ∫ g φ dm` for every integrable `φ`. -/

/-! ### Auxiliary material: `L¹`–`L^∞` duality and diagonal weak-* extraction -/

section WeakStar

/-- Diagonal sequential Banach–Alaoglu for countably many bounded sequences in the dual of a
separable space (helper for `Auto.ext_weakstar_plane_countable`). -/
theorem aux_weakDual_diag {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [TopologicalSpace.SeparableSpace E] (Λ : ℕ → ℕ → StrongDual ℂ E) (R : ℕ → ℝ)
    (hΛ : ∀ i n, ‖Λ i n‖ ≤ R i) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ L : ℕ → StrongDual ℂ E, (∀ i, ‖L i‖ ≤ R i) ∧
      ∀ i ψ, Tendsto (fun n => Λ i (φ n) ψ) atTop (𝓝 (L i ψ)) := by
  let S : ℕ → Set (WeakDual ℂ E) := fun i =>
    WeakDual.toStrongDual ⁻¹' Metric.closedBall 0 (R i)
  have hc : ∀ i, IsCompact (S i) := fun i =>
    WeakDual.isCompact_closedBall (0 : StrongDual ℂ E) (R i)
  have : ∀ i, CompactSpace (S i) := fun i => isCompact_iff_compactSpace.1 (hc i)
  have : ∀ i, TopologicalSpace.MetrizableSpace (S i) := fun i =>
    WeakDual.metrizable_of_isCompact ℂ E (S i) (hc i)
  let x : ℕ → (∀ i, S i) := fun n i =>
    ⟨StrongDual.toWeakDual (Λ i n), by simpa [S] using hΛ i n⟩
  obtain ⟨a, φ, hφ, hlim⟩ := SeqCompactSpace.tendsto_subseq x
  refine ⟨φ, hφ, fun i => WeakDual.toStrongDual (a i : WeakDual ℂ E),
    fun i => by
      have := (a i).2
      simp only [S, mem_preimage, mem_closedBall_zero_iff] at this
      exact this, fun i ψ => ?_⟩
  have h1 := ((continuous_apply i).tendsto a).comp hlim
  have h2 := (continuous_subtype_val.tendsto _).comp h1
  have h3 := ((WeakDual.eval_continuous ψ).tendsto _).comp h2
  exact h3

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

/-- A.e. bound by the `L^∞` norm (helper for `Auto.ext_weakstar_plane_countable`). -/
theorem aux_ae_norm_le_top {g : α → ℂ} (hg : MemLp g ⊤ μ) :
    ∀ᵐ x ∂μ, ‖g x‖ ≤ (eLpNorm g ⊤ μ).toReal := by
  filter_upwards [enorm_ae_le_eLpNormEssSup g μ] with x hx
  rw [eLpNorm_exponent_top]
  rw [← toReal_enorm]
  exact ENNReal.toReal_mono (by simpa [eLpNorm_exponent_top] using hg.2.ne) hx

/-- Integrability of `g ψ` for `g ∈ L^∞`, `ψ ∈ L¹` (helper for
`Auto.ext_weakstar_plane_countable`). -/
theorem aux_integrable_mul_top {g ψ : α → ℂ} (hg : MemLp g ⊤ μ) (hψ : MemLp ψ 1 μ) :
    Integrable (fun x => g x * ψ x) μ :=
  memLp_one_iff_integrable.1 (hψ.mul' hg)

/-- The pairing `ψ ↦ ∫ g ψ` of `g ∈ L^∞` with `L¹`, as a bounded functional (helper for
`Auto.ext_weakstar_plane_countable`). -/
@[nolint defsWithUnderscore]
def aux_pair (g : α → ℂ) (hg : MemLp g ⊤ μ) : Lp ℂ 1 μ →L[ℂ] ℂ :=
  LinearMap.mkContinuous
    { toFun := fun ψ => ∫ x, g x * ψ x ∂μ
      map_add' := fun ψ ψ' => by
        rw [← integral_add (aux_integrable_mul_top hg (Lp.memLp ψ))
          (aux_integrable_mul_top hg (Lp.memLp ψ'))]
        refine integral_congr_ae ?_
        filter_upwards [Lp.coeFn_add ψ ψ'] with x hx
        rw [hx, Pi.add_apply, mul_add]
      map_smul' := fun c ψ => by
        simp only [RingHom.id_apply, smul_eq_mul]
        rw [← integral_const_mul]
        refine integral_congr_ae ?_
        filter_upwards [Lp.coeFn_smul c ψ] with x hx
        simp only [hx, Pi.smul_apply, smul_eq_mul]
        ring }
    (eLpNorm g ⊤ μ).toReal (fun ψ => by
      simp only [LinearMap.coe_mk, AddHom.coe_mk]
      rw [L1.norm_eq_integral_norm, ← integral_const_mul]
      refine (norm_integral_le_integral_norm _).trans (integral_mono_ae
        (aux_integrable_mul_top hg (Lp.memLp ψ)).norm
        ((L1.integrable_coeFn ψ).norm.const_mul _) ?_)
      filter_upwards [aux_ae_norm_le_top hg] with x hx
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right hx (norm_nonneg _))

/-- Norm bound `‖aux_pair g‖ ≤ ‖g‖_∞` (helper for `Auto.ext_weakstar_plane_countable`). -/
theorem aux_pair_norm (g : α → ℂ) (hg : MemLp g ⊤ μ) :
    ‖aux_pair g hg‖ ≤ (eLpNorm g ⊤ μ).toReal :=
  LinearMap.mkContinuous_norm_le _ ENNReal.toReal_nonneg _

/-- A strictly positive weight `s` with `s ∈ L²(μ)` on a σ-finite measure space (helper for
`Auto.ext_weakstar_plane_countable`). -/
theorem aux_exists_pos_L2 [SigmaFinite μ] :
    ∃ s : α → ℝ, Measurable s ∧ (∀ x, 0 < s x) ∧ MemLp (fun x => (s x : ℂ)) 2 μ := by
  obtain ⟨w, hwpos, hwm, hwi⟩ := exists_pos_lintegral_lt_of_sigmaFinite μ one_ne_zero
  refine ⟨fun x => Real.sqrt (w x), (NNReal.continuous_coe.measurable.comp hwm).sqrt,
    fun x => Real.sqrt_pos.2 (by exact_mod_cast hwpos x), ?_⟩
  refine (memLp_two_iff_integrable_sq_norm ?_).2 ?_
  · exact (Complex.measurable_ofReal.comp
      (NNReal.continuous_coe.measurable.comp hwm).sqrt).aestronglyMeasurable
  · have : (fun x => ‖((Real.sqrt (w x) : ℝ) : ℂ)‖ ^ 2) = fun x => ((w x : ℝ)) := by
      funext x
      rw [Complex.norm_real, Real.norm_eq_abs, sq_abs, Real.sq_sqrt (NNReal.coe_nonneg _)]
    rw [this]
    refine ⟨(NNReal.continuous_coe.measurable.comp hwm).aestronglyMeasurable, ?_⟩
    rw [HasFiniteIntegral]
    simpa [Real.enorm_eq_ofReal (NNReal.coe_nonneg _)] using hwi.trans ENNReal.one_lt_top

/-- Hölder: the product of two `L²` functions is in `L¹` (helper for
`Auto.ext_weakstar_plane_countable`). -/
theorem aux_memLp_mul_two {s h : α → ℂ} (hs : MemLp s 2 μ) (hh : MemLp h 2 μ) :
    MemLp (fun x => s x * h x) 1 μ :=
  hh.mul' (p := 2) (q := 2) (r := 1) hs

/-- Hölder bound `‖s h‖₁ ≤ ‖s‖₂ ‖h‖₂` (helper for `Auto.ext_weakstar_plane_countable`). -/
theorem aux_eLpNorm_mul_two {s h : α → ℂ} (hs : AEStronglyMeasurable s μ)
    (hh : AEStronglyMeasurable h μ) :
    eLpNorm (fun x => s x * h x) 1 μ ≤ eLpNorm s 2 μ * eLpNorm h 2 μ := by
  have := eLpNorm_smul_le_mul_eLpNorm (p := 2) (q := 2) (r := 1) hh hs
  exact this

/-- Multiplication by a fixed `L²` function, as a bounded map `L² → L¹` (helper for
`Auto.ext_weakstar_plane_countable`). -/
@[nolint defsWithUnderscore]
def aux_mulOp (s : α → ℂ) (hs : MemLp s 2 μ) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 1 μ :=
  LinearMap.mkContinuous
    { toFun := fun h => (aux_memLp_mul_two hs (Lp.memLp h)).toLp _
      map_add' := fun h h' => by
        apply Lp.ext
        filter_upwards [MemLp.coeFn_toLp (aux_memLp_mul_two hs (Lp.memLp (h + h'))),
          MemLp.coeFn_toLp (aux_memLp_mul_two hs (Lp.memLp h)),
          MemLp.coeFn_toLp (aux_memLp_mul_two hs (Lp.memLp h')),
          Lp.coeFn_add ((aux_memLp_mul_two hs (Lp.memLp h)).toLp _)
            ((aux_memLp_mul_two hs (Lp.memLp h')).toLp _),
          Lp.coeFn_add h h'] with x h1 h2 h3 h4 h5
        rw [h1, h4, Pi.add_apply, h2, h3, h5, Pi.add_apply, mul_add]
      map_smul' := fun c h => by
        apply Lp.ext
        filter_upwards [MemLp.coeFn_toLp (aux_memLp_mul_two hs (Lp.memLp (c • h))),
          MemLp.coeFn_toLp (aux_memLp_mul_two hs (Lp.memLp h)),
          Lp.coeFn_smul c ((aux_memLp_mul_two hs (Lp.memLp h)).toLp _), Lp.coeFn_smul c h]
          with x h1 h2 h3 h4
        rw [h1, RingHom.id_apply, h3, Pi.smul_apply, h2, h4, Pi.smul_apply, smul_eq_mul,
          smul_eq_mul]
        ring }
    (eLpNorm s 2 μ).toReal (fun h => by
      simp only [LinearMap.coe_mk, AddHom.coe_mk, Lp.norm_def]
      rw [← ENNReal.toReal_mul]
      exact ENNReal.toReal_mono (ENNReal.mul_ne_top hs.2.ne (Lp.eLpNorm_ne_top h))
        ((eLpNorm_congr_ae (MemLp.coeFn_toLp _)).trans_le
          (aux_eLpNorm_mul_two hs.1 (Lp.memLp h).1)))

/-- `aux_mulOp s h` is represented by `s h` (helper for `Auto.ext_weakstar_plane_countable`). -/
theorem aux_mulOp_ae (s : α → ℂ) (hs : MemLp s 2 μ) (h : Lp ℂ 2 μ) :
    (aux_mulOp s hs h : α → ℂ) =ᵐ[μ] fun x => s x * h x :=
  MemLp.coeFn_toLp (aux_memLp_mul_two hs (Lp.memLp h))

/-- If `|∫ conj(G) h| ≤ R ∫ s |h|` for all `h ∈ L²`, then `|G| ≤ R s` a.e. (helper for
`Auto.ext_weakstar_plane_countable`). -/
theorem aux_ae_norm_le_of_dual [SigmaFinite μ] (G : Lp ℂ 2 μ) (s : α → ℝ)
    (hs2 : MemLp (fun x => (s x : ℂ)) 2 μ) (hs0 : ∀ x, 0 ≤ s x) (R : ℝ) (hR : 0 ≤ R)
    (hG : ∀ h : α → ℂ, MemLp h 2 μ →
      ‖∫ x, conj (G x) * h x ∂μ‖ ≤ R * ∫ x, s x * ‖h x‖ ∂μ) :
    ∀ᵐ x ∂μ, ‖G x‖ ≤ R * s x := by
  have hsint : ∀ S, MeasurableSet S → μ S < ∞ → IntegrableOn s S μ := by
    intro S hS hμS
    have : IsFiniteMeasure (μ.restrict S) := isFiniteMeasure_restrict.2 hμS.ne
    have := ((hs2.restrict S).integrable one_le_two).re
    simpa [IntegrableOn] using this
  have hGint : ∀ S, MeasurableSet S → μ S < ∞ → IntegrableOn (fun x => ‖G x‖) S μ := by
    intro S hS hμS
    have : IsFiniteMeasure (μ.restrict S) := isFiniteMeasure_restrict.2 hμS.ne
    exact (((Lp.memLp G).restrict S).integrable one_le_two).norm
  have hpos := ae_nonneg_of_forall_setIntegral_nonneg_of_sigmaFinite
    (f := fun x => R * s x - ‖G x‖)
    (fun S hS hμS => ((hsint S hS hμS).const_mul R).sub (hGint S hS hμS)) ?_
  · filter_upwards [hpos] with x hx
    simp only [Pi.zero_apply] at hx
    linarith
  intro S hS hμS
  have : IsFiniteMeasure (μ.restrict S) := isFiniteMeasure_restrict.2 hμS.ne
  rw [integral_sub ((hsint S hS hμS).const_mul R) (hGint S hS hμS), integral_const_mul,
    sub_nonneg]
  set u : α → ℂ := fun x => G x / ((‖G x‖ : ℝ) : ℂ) with hu
  have hGm : Measurable (G : α → ℂ) := (Lp.stronglyMeasurable G).measurable
  have hum : AEStronglyMeasurable u μ :=
    (hGm.div (Complex.measurable_ofReal.comp hGm.norm)).aestronglyMeasurable
  have hu1 : ∀ x, ‖u x‖ ≤ 1 := by
    intro x
    simp only [hu, norm_div, Complex.norm_real, Real.norm_eq_abs, abs_norm]
    rcases eq_or_ne ‖G x‖ 0 with h0 | h0
    · simp [h0]
    · rw [div_self h0]
  set h : α → ℂ := S.indicator u with hh
  have hhm : MemLp h 2 μ := by
    rw [hh, memLp_indicator_iff_restrict hS]
    exact MemLp.of_bound hum.restrict 1 (Eventually.of_forall hu1)
  have hconj : ∀ x, conj (G x) * u x = ((‖G x‖ : ℝ) : ℂ) := by
    intro x
    by_cases h0 : G x = 0
    · simp [hu, h0]
    · have hn : ((‖G x‖ : ℝ) : ℂ) ≠ 0 := by exact_mod_cast norm_ne_zero_iff.2 h0
      rw [hu, mul_div_assoc', Complex.conj_mul', div_eq_iff hn]
      ring
  have hlhs : ∫ x, conj (G x) * h x ∂μ = ((∫ x in S, ‖G x‖ ∂μ : ℝ) : ℂ) := by
    have : (fun x => conj (G x) * h x) = S.indicator (fun x => ((‖G x‖ : ℝ) : ℂ)) := by
      funext x
      by_cases hx : x ∈ S
      · simp [hh, hx, hconj]
      · simp [hh, hx]
    rw [this, integral_indicator hS, integral_complex_ofReal]
  have hrhs : ∫ x, s x * ‖h x‖ ∂μ ≤ ∫ x in S, s x ∂μ := by
    have : (fun x => s x * ‖h x‖) = S.indicator (fun x => s x * ‖u x‖) := by
      funext x
      by_cases hx : x ∈ S
      · simp [hh, hx]
      · simp [hh, hx]
    rw [this, integral_indicator hS]
    refine setIntegral_mono_on ?_ (hsint S hS hμS) hS fun x _ => ?_
    · refine (hsint S hS hμS).mono' ((hsint S hS hμS).1.mul hum.norm.restrict) ?_
      filter_upwards with x
      rw [norm_mul, Real.norm_eq_abs, abs_of_nonneg (hs0 x), Real.norm_eq_abs,
        abs_of_nonneg (norm_nonneg _)]
      exact mul_le_of_le_one_right (hs0 x) (hu1 x)
    · exact mul_le_of_le_one_right (hs0 x) (hu1 x)
  have key := hG h hhm
  rw [hlhs, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (integral_nonneg fun x => norm_nonneg _)] at key
  exact key.trans (mul_le_mul_of_nonneg_left hrhs hR)

/-- Eventually `a ≤ N b` for `b > 0` (helper for `Auto.ext_weakstar_plane_countable`). -/
theorem aux_eventually_le_nat_mul (a b : ℝ) (hb : 0 < b) :
    ∀ᶠ N : ℕ in atTop, a ≤ (N : ℝ) * b := by
  obtain ⟨N0, hN0⟩ := exists_nat_ge (a / b)
  refine eventually_atTop.2 ⟨N0, fun N hN => ?_⟩
  have h1 : (N0 : ℝ) ≤ N := by exact_mod_cast hN
  calc a = a / b * b := by field_simp
    _ ≤ N0 * b := by gcongr
    _ ≤ N * b := by gcongr

/-- Representation of a bounded functional on `L¹` of a σ-finite measure by an `L^∞`
function (helper for `Auto.ext_weakstar_plane_countable`). -/
theorem aux_L1_dual_repr [SigmaFinite μ] (L : Lp ℂ 1 μ →L[ℂ] ℂ) (R : ℝ) (hL : ‖L‖ ≤ R) :
    ∃ g : α → ℂ, MemLp g ⊤ μ ∧ ∀ ψ : Lp ℂ 1 μ, L ψ = ∫ x, g x * ψ x ∂μ := by
  have hR : 0 ≤ R := (norm_nonneg _).trans hL
  obtain ⟨s, hsm, hspos, hs2⟩ := aux_exists_pos_L2 (μ := μ)
  set sC : α → ℂ := fun x => (s x : ℂ) with hsC
  have hsC0 : ∀ x, sC x ≠ 0 := fun x => by simp [hsC, (hspos x).ne']
  set M := aux_mulOp sC hs2 with hM
  set G : Lp ℂ 2 μ := (InnerProductSpace.toDual ℂ (Lp ℂ 2 μ)).symm (L.comp M) with hGdef
  have hGrep : ∀ h : Lp ℂ 2 μ, L (M h) = ∫ x, conj (G x) * h x ∂μ := by
    intro h
    have := InnerProductSpace.toDual_symm_apply (𝕜 := ℂ) (E := Lp ℂ 2 μ) (x := h)
      (y := L.comp M)
    rw [← hGdef, L2.inner_def] at this
    rw [← ContinuousLinearMap.comp_apply, ← this]
    simp [RCLike.inner_apply, mul_comm]
  have hMnorm : ∀ (h : α → ℂ) (hh : MemLp h 2 μ),
      ‖M (hh.toLp h)‖ = ∫ x, s x * ‖h x‖ ∂μ := by
    intro h hh
    rw [L1.norm_eq_integral_norm]
    refine integral_congr_ae ?_
    filter_upwards [aux_mulOp_ae sC hs2 (hh.toLp h), hh.coeFn_toLp] with x h1 h2
    rw [h1, h2, norm_mul, hsC, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hspos x)]
  have hbound : ∀ᵐ x ∂μ, ‖G x‖ ≤ R * s x := by
    refine aux_ae_norm_le_of_dual G s hs2 (fun x => (hspos x).le) R hR fun h hh => ?_
    have e : ∫ x, conj (G x) * h x ∂μ = L (M (hh.toLp h)) := by
      rw [hGrep]
      refine integral_congr_ae ?_
      filter_upwards [hh.coeFn_toLp] with x hx
      rw [hx]
    rw [e, ← hMnorm h hh]
    exact (L.le_opNorm _).trans (mul_le_mul_of_nonneg_right hL (norm_nonneg _))
  set g : α → ℂ := fun x => conj (G x) / sC x with hg
  have hGm : Measurable (G : α → ℂ) := (Lp.stronglyMeasurable G).measurable
  have hsCm : Measurable sC := Complex.measurable_ofReal.comp hsm
  have hgm : Measurable g := (Complex.continuous_conj.measurable.comp hGm).div hsCm
  have hgb : ∀ᵐ x ∂μ, ‖g x‖ ≤ R := by
    filter_upwards [hbound] with x hx
    rw [hg, norm_div, Complex.norm_conj, hsC, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (hspos x), div_le_iff₀ (hspos x)]
    exact hx
  have hgL : MemLp g ⊤ μ := memLp_top_of_bound hgm.aestronglyMeasurable R hgb
  refine ⟨g, hgL, fun ψ => ?_⟩
  set ψf : α → ℂ := (ψ : α → ℂ) with hψf
  have hψm : Measurable ψf := (Lp.stronglyMeasurable ψ).measurable
  have hψi : Integrable ψf μ := L1.integrable_coeFn ψ
  set T : ℕ → Set α := fun N => {x | ‖ψf x‖ ≤ (N : ℝ) * s x ^ 2} with hT
  have hTm : ∀ N, MeasurableSet (T N) := fun N =>
    measurableSet_le hψm.norm (measurable_const.mul (hsm.pow_const 2))
  set ψN : ℕ → α → ℂ := fun N => (T N).indicator ψf with hψN
  have hψNm : ∀ N, Measurable (ψN N) := fun N => hψm.indicator (hTm N)
  have hψN1 : ∀ N, MemLp (ψN N) 1 μ := fun N =>
    memLp_one_iff_integrable.2 (hψi.indicator (hTm N))
  have hψNle : ∀ N x, ‖ψN N x‖ ≤ ‖ψf x‖ := fun N x => by
    simp only [hψN]; exact norm_indicator_le_norm_self _ _
  have hev : ∀ x, ∀ᶠ N in atTop, ψN N x = ψf x := by
    intro x
    filter_upwards [aux_eventually_le_nat_mul ‖ψf x‖ (s x ^ 2) (pow_pos (hspos x) 2)]
      with N hN
    simp only [hψN, indicator, hT, mem_ofPred_eq, hN, if_true]
  -- the truncations divided by the weight are in `L²`
  have hh2 : ∀ N, MemLp (fun x => ψN N x / sC x) 2 μ := by
    intro N
    refine (memLp_two_iff_integrable_sq_norm
      ((hψNm N).div hsCm).aestronglyMeasurable).2 ?_
    refine (hψi.norm.const_mul (N : ℝ)).mono'
      (((hψNm N).div hsCm).norm.pow_const 2).aestronglyMeasurable ?_
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), Pi.div_apply, norm_div, hsC,
      Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (hspos x), div_pow]
    by_cases hx : x ∈ T N
    · have hxT : ‖ψf x‖ ≤ (N : ℝ) * s x ^ 2 := hx
      have hψx : ψN N x = ψf x := by simp [hψN, hx]
      rw [hψx, div_le_iff₀ (pow_pos (hspos x) 2)]
      calc ‖ψf x‖ ^ 2 = ‖ψf x‖ * ‖ψf x‖ := sq _
        _ ≤ ‖ψf x‖ * ((N : ℝ) * s x ^ 2) := by gcongr
        _ = (N : ℝ) * ‖ψf x‖ * s x ^ 2 := by ring
    · have hψx : ψN N x = 0 := by simp [hψN, hx]
      rw [hψx]; simp only [norm_zero]
      rw [zero_pow two_ne_zero, zero_div]; positivity
  have hval : ∀ N, L ((hψN1 N).toLp (ψN N)) = ∫ x, g x * ψN N x ∂μ := by
    intro N
    have hMeq : M ((hh2 N).toLp _) = (hψN1 N).toLp (ψN N) := by
      apply Lp.ext
      filter_upwards [aux_mulOp_ae sC hs2 ((hh2 N).toLp _), (hh2 N).coeFn_toLp,
        (hψN1 N).coeFn_toLp] with x h1 h2 h3
      rw [h1, h2, h3, mul_div_cancel₀ _ (hsC0 x)]
    rw [← hMeq, hGrep]
    refine integral_congr_ae ?_
    filter_upwards [(hh2 N).coeFn_toLp] with x hx
    rw [hx, hg]
    ring
  have lim1 : Tendsto (fun N => (hψN1 N).toLp (ψN N)) atTop (𝓝 ψ) := by
    have hψeq : (Lp.memLp ψ).toLp ψf = ψ := Lp.toLp_coeFn ψ (Lp.memLp ψ)
    rw [← hψeq, Lp.tendsto_Lp_iff_tendsto_eLpNorm'' _ hψN1 _ (Lp.memLp ψ)]
    simp_rw [eLpNorm_one_eq_lintegral_enorm]
    have := tendsto_lintegral_of_dominated_convergence (fun x => ‖ψf x‖ₑ)
      (F := fun N x => ‖(ψN N - ψf) x‖ₑ) (f := fun _ => 0)
      (fun N => ((hψNm N).sub hψm).enorm) (fun N => Eventually.of_forall fun x => ?_)
      hψi.2.ne (Eventually.of_forall fun x => ?_)
    · simpa using this
    · simp only [Pi.sub_apply]
      by_cases hx : x ∈ T N
      · simp [hψN, hx]
      · simp [hψN, hx]
    · refine tendsto_const_nhds.congr' ?_
      filter_upwards [hev x] with N hN
      simp [hN]
  have lim2 : Tendsto (fun N => ∫ x, g x * ψN N x ∂μ) atTop (𝓝 (∫ x, g x * ψf x ∂μ)) := by
    refine tendsto_integral_of_dominated_convergence (fun x => R * ‖ψf x‖)
      (fun N => (hgm.mul (hψNm N)).aestronglyMeasurable) (hψi.norm.const_mul R)
      (fun N => ?_) (Eventually.of_forall fun x => ?_)
    · filter_upwards [hgb] with x hx
      rw [norm_mul]
      exact mul_le_mul hx (hψNle N x) (norm_nonneg _) hR
    · refine tendsto_const_nhds.congr' ?_
      filter_upwards [hev x] with N hN
      rw [hN]
  have lim3 := ((L.continuous.tendsto ψ).comp lim1)
  simp only [Function.comp_def, hval] at lim3
  exact tendsto_nhds_unique lim3 lim2

/-- Sequential weak-* extraction in `L^∞` of a σ-finite, countably generated measure space, for a
countable family with a common subsequence (helper for `Auto.ext_weakstar_plane_countable` and
the other parts of `ext:weakstar`). -/
theorem aux_weakstar_countable [MeasurableSpace.CountablyGenerated α] [SigmaFinite μ]
    (f : ℕ → ℕ → α → ℂ) (hf : ∀ i n, MemLp (f i n) ⊤ μ)
    (hb : ∀ i, ∃ A : ℝ≥0∞, A ≠ ⊤ ∧ ∀ n, eLpNorm (f i n) ⊤ μ ≤ A) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ g : ℕ → α → ℂ, ∀ i, MemLp (g i) ⊤ μ ∧
      ∀ ψ : α → ℂ, Integrable ψ μ →
        Tendsto (fun n => ∫ x, f i (φ n) x * ψ x ∂μ) atTop (𝓝 (∫ x, g i x * ψ x ∂μ)) := by
  have : Fact ((1 : ℝ≥0∞) ≠ ∞) := ⟨ENNReal.one_ne_top⟩
  choose A hA hAb using hb
  obtain ⟨φ, hφ, L, hLn, hL⟩ := aux_weakDual_diag (fun i n => aux_pair (f i n) (hf i n))
    (fun i => (A i).toReal)
    (fun i n => (aux_pair_norm _ _).trans (ENNReal.toReal_mono (hA i) (hAb i n)))
  choose g hg hrep using fun i => aux_L1_dual_repr (L i) _ (hLn i)
  refine ⟨φ, hφ, g, fun i => ⟨hg i, fun ψ hψ => ?_⟩⟩
  have hψ1 : MemLp ψ 1 μ := memLp_one_iff_integrable.2 hψ
  have := hL i (hψ1.toLp ψ)
  rw [hrep] at this
  simp only [aux_pair, LinearMap.mkContinuous_apply, LinearMap.coe_mk, AddHom.coe_mk] at this
  have e1 : ∀ n, ∫ x, f i (φ n) x * (hψ1.toLp ψ) x ∂μ = ∫ x, f i (φ n) x * ψ x ∂μ := by
    intro n
    refine integral_congr_ae ?_
    filter_upwards [hψ1.coeFn_toLp] with x hx
    rw [hx]
  have e2 : ∫ x, g i x * (hψ1.toLp ψ) x ∂μ = ∫ x, g i x * ψ x ∂μ := by
    refine integral_congr_ae ?_
    filter_upwards [hψ1.coeFn_toLp] with x hx
    rw [hx]
  simp only [e1, e2] at this
  exact this

end WeakStar

/-- **Lemma `ext:weakstar`** (single sequence on `ℝ²`).
On $\mathbb R^2$, and on $\mathbb R^2\times[0,2\pi)$ with measure $dx\,d\theta/(2\pi)$, every
sequence bounded in $L^\infty$ has a weak-* convergent subsequence.  A common subsequence can be
chosen for any countable family of such bounded sequences. -/
theorem ext_weakstar_plane (f : ℕ → ℝ² → ℂ) (hf : ∀ n, MemLp (f n) ⊤ volume)
    (hb : ∃ A : ℝ≥0∞, A ≠ ⊤ ∧ ∀ n, eLpNorm (f n) ⊤ volume ≤ A) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ g : ℝ² → ℂ, MemLp g ⊤ volume ∧
      ∀ ψ : ℝ² → ℂ, Integrable ψ volume →
        Tendsto (fun n => ∫ x, f (φ n) x * ψ x) atTop (𝓝 (∫ x, g x * ψ x)) := by
  obtain ⟨φ, hφ, g, hg⟩ := aux_weakstar_countable (fun _ => f) (fun _ => hf) (fun _ => hb)
  exact ⟨φ, hφ, g 0, (hg 0).1, (hg 0).2⟩

/-- **Lemma `ext:weakstar`** (countable family on `ℝ²`, common subsequence).
On $\mathbb R^2$, and on $\mathbb R^2\times[0,2\pi)$ with measure $dx\,d\theta/(2\pi)$, every
sequence bounded in $L^\infty$ has a weak-* convergent subsequence.  A common subsequence can be
chosen for any countable family of such bounded sequences. -/
theorem ext_weakstar_plane_countable (f : ℕ → ℕ → ℝ² → ℂ)
    (hf : ∀ i n, MemLp (f i n) ⊤ volume)
    (hb : ∀ i, ∃ A : ℝ≥0∞, A ≠ ⊤ ∧ ∀ n, eLpNorm (f i n) ⊤ volume ≤ A) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ g : ℕ → ℝ² → ℂ, ∀ i, MemLp (g i) ⊤ volume ∧
      ∀ ψ : ℝ² → ℂ, Integrable ψ volume →
        Tendsto (fun n => ∫ x, f i (φ n) x * ψ x) atTop (𝓝 (∫ x, g i x * ψ x)) := by
  exact aux_weakstar_countable f hf hb

/-- **Lemma `ext:weakstar`** (single sequence on `ℝ² × [0,2π)`; the angle is
`θ ∈ AddCircle (2π)` with the probability Haar measure `dθ/(2π)`).
On $\mathbb R^2$, and on $\mathbb R^2\times[0,2\pi)$ with measure $dx\,d\theta/(2\pi)$, every
sequence bounded in $L^\infty$ has a weak-* convergent subsequence.  A common subsequence can be
chosen for any countable family of such bounded sequences. -/
theorem ext_weakstar_config (f : ℕ → ℝ² × AddCircle (2 * π) → ℂ)
    (hf : ∀ n, MemLp (f n) ⊤ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle))
    (hb : ∃ A : ℝ≥0∞, A ≠ ⊤ ∧
      ∀ n, eLpNorm (f n) ⊤ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle) ≤ A) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ g : ℝ² × AddCircle (2 * π) → ℂ,
      MemLp g ⊤ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle) ∧
      ∀ ψ : ℝ² × AddCircle (2 * π) → ℂ,
        Integrable ψ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle) →
        Tendsto (fun n => ∫ q, f (φ n) q * ψ q
            ∂((volume : Measure ℝ²).prod AddCircle.haarAddCircle)) atTop
          (𝓝 (∫ q, g q * ψ q ∂((volume : Measure ℝ²).prod AddCircle.haarAddCircle))) := by
  obtain ⟨φ, hφ, g, hg⟩ := aux_weakstar_countable (fun _ => f) (fun _ => hf) (fun _ => hb)
  exact ⟨φ, hφ, g 0, (hg 0).1, (hg 0).2⟩

/-- **Lemma `ext:weakstar`** (countable family on `ℝ² × [0,2π)`, common subsequence).
On $\mathbb R^2$, and on $\mathbb R^2\times[0,2\pi)$ with measure $dx\,d\theta/(2\pi)$, every
sequence bounded in $L^\infty$ has a weak-* convergent subsequence.  A common subsequence can be
chosen for any countable family of such bounded sequences. -/
theorem ext_weakstar_config_countable (f : ℕ → ℕ → ℝ² × AddCircle (2 * π) → ℂ)
    (hf : ∀ i n, MemLp (f i n) ⊤ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle))
    (hb : ∀ i, ∃ A : ℝ≥0∞, A ≠ ⊤ ∧
      ∀ n, eLpNorm (f i n) ⊤ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle) ≤ A) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ g : ℕ → ℝ² × AddCircle (2 * π) → ℂ, ∀ i,
      MemLp (g i) ⊤ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle) ∧
      ∀ ψ : ℝ² × AddCircle (2 * π) → ℂ,
        Integrable ψ ((volume : Measure ℝ²).prod AddCircle.haarAddCircle) →
        Tendsto (fun n => ∫ q, f i (φ n) q * ψ q
            ∂((volume : Measure ℝ²).prod AddCircle.haarAddCircle)) atTop
          (𝓝 (∫ q, g i q * ψ q ∂((volume : Measure ℝ²).prod AddCircle.haarAddCircle))) := by
  exact aux_weakstar_countable f hf hb

end Auto
