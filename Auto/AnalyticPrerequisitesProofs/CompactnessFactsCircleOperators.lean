/-- Indicator kernels of measurable sets give compact operators (Dynkin argument from
rectangles; helper for `Auto.ext_compact_facts_integral`). -/
theorem aux_kerOp_ind_compact :
    ∀ (S : Set (α × β)) (hS : MeasurableSet S),
      IsCompactOperator (aux_kerOp (aux_ind (μ.prod ν) hS)) := by
  refine MeasurableSpace.induction_on_inter generateFrom_prod.symm isPiSystem_prod ?_ ?_ ?_ ?_
  · have : aux_ind (μ.prod ν) MeasurableSet.empty = 0 := indicatorConstLp_empty
    rw [this, ← aux_kerOpL_apply, map_zero]
    exact isCompactOperator_zero
  · rintro t ⟨A, hA, B, hB, rfl⟩
    exact aux_kerOp_rect hA hB
  · intro t ht hc
    have huniv := aux_kerOp_rect (μ := μ) (ν := ν) MeasurableSet.univ MeasurableSet.univ
    have heq : aux_ind (μ.prod ν) ht.compl =
        aux_ind (μ.prod ν) (MeasurableSet.univ.prod MeasurableSet.univ) -
          aux_ind (μ.prod ν) ht := by
      apply Lp.ext
      filter_upwards [indicatorConstLp_coeFn (p := 2) (hs := ht.compl)
          (hμs := measure_ne_top (μ.prod ν) _) (c := (1 : ℂ)),
        indicatorConstLp_coeFn (p := 2) (hs := MeasurableSet.univ.prod MeasurableSet.univ)
          (hμs := measure_ne_top (μ.prod ν) _) (c := (1 : ℂ)),
        indicatorConstLp_coeFn (p := 2) (hs := ht) (hμs := measure_ne_top (μ.prod ν) _)
          (c := (1 : ℂ)),
        Lp.coeFn_sub (aux_ind (μ.prod ν) (MeasurableSet.univ.prod MeasurableSet.univ))
          (aux_ind (μ.prod ν) ht)] with x h1 h2 h3 h4
      rw [h1, h4, Pi.sub_apply, h2, h3]
      by_cases hx : x ∈ t <;> simp [indicator, hx]
    rw [heq, ← aux_kerOpL_apply, map_sub]
    exact huniv.sub hc
  · intro f hdisj hfm hc
    -- partial unions
    let P : ℕ → Set (α × β) := fun N => ⋃ i ∈ Finset.range N, f i
    have hPm : ∀ N, MeasurableSet (P N) := fun N => Finset.measurableSet_biUnion _ fun i _ => hfm i
    have hPc : ∀ N, IsCompactOperator (aux_kerOp (aux_ind (μ.prod ν) (hPm N))) := by
      intro N
      induction N with
      | zero =>
        have : aux_ind (μ.prod ν) (hPm 0) = 0 := by
          simp only [P, Finset.range_zero, Finset.notMem_empty, iUnion_of_empty, iUnion_empty]
          exact indicatorConstLp_empty
        rw [this, ← aux_kerOpL_apply, map_zero]
        exact isCompactOperator_zero
      | succ N ih =>
        have hPeq : P (N + 1) = P N ∪ f N := by
          simp only [P, Finset.range_add_one, Finset.set_biUnion_insert]; exact union_comm _ _
        have hd : Disjoint (P N) (f N) := by
          simp only [P, Set.disjoint_iUnion_left]
          intro i hi
          exact hdisj (Finset.mem_range.1 hi).ne
        have : aux_ind (μ.prod ν) (hPm (N + 1)) =
            aux_ind (μ.prod ν) (hPm N) + aux_ind (μ.prod ν) (hfm N) := by
          rw [← indicatorConstLp_disjoint_union (hPm N) (hfm N) _ _ hd]
          congr 1
        rw [this, ← aux_kerOpL_apply, map_add]
        exact ih.add (hc N)
    have hU : ⋃ i, f i = ⋃ N, P N := by
      ext x; simp only [mem_iUnion, P, Finset.mem_range]
      constructor
      · rintro ⟨i, hi⟩; exact ⟨i + 1, i, Nat.lt_succ_self i, hi⟩
      · rintro ⟨N, i, -, hi⟩; exact ⟨i, hi⟩
    have hlim : Tendsto (fun N => aux_ind (μ.prod ν) (hPm N)) atTop
        (𝓝 (aux_ind (μ.prod ν) (MeasurableSet.iUnion hfm))) := by
      apply tendsto_indicatorConstLp_set (by norm_num)
      have hmono : Monotone P := by
        intro a b hab
        exact biUnion_subset_biUnion_left (by simpa using Finset.range_subset_range.2 hab)
      have h1 : Tendsto (fun N => (μ.prod ν) ((⋃ i, f i) \ P N)) atTop (𝓝 0) := by
        have := tendsto_measure_iInter_atTop (μ := μ.prod ν)
          (s := fun N => (⋃ i, f i) \ P N)
          (fun N => ((MeasurableSet.iUnion hfm).diff (hPm N)).nullMeasurableSet)
          (fun a b hab => sdiff_subset_sdiff_right (hmono hab)) ⟨0, measure_ne_top _ _⟩
        have he : (⋂ N, (⋃ i, f i) \ P N) = ∅ := by
          rw [hU, ← sdiff_iUnion, sdiff_self]
        rwa [he, measure_empty] at this
      refine h1.congr fun N => ?_
      have hsub : P N ⊆ ⋃ i, f i := by rw [hU]; exact subset_iUnion P N
      rw [symmDiff_of_le hsub]
    exact isCompactOperator_of_tendsto ((aux_kerOpL.continuous.tendsto _).comp hlim)
      (Eventually.of_forall fun N => hPc N)

