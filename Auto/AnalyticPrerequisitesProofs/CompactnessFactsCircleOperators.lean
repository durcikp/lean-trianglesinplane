/-- **Lemma `ext:compact-facts`** (1, finite rank).
For a bounded operator between Hilbert spaces, $\|T\|=\|T^*\|$ and $\|TT^*\|=\|T\|^2$.
The following compactness facts also hold.
1. Finite-rank operators are compact, and an operator-norm limit of compact operators is compact.
2. An integral operator with kernel in $L^2(X\times Y)$, where $X,Y$ are bounded measurable
   subsets of Euclidean space, is compact from $L^2(Y)$ to $L^2(X)$.
3. If $T$ is compact and a bounded sequence $f_n$ converges weakly to $f$, then $Tf_n\to Tf$
   in norm. -/
theorem ext_compact_facts_finite_rank (T : H →L[ℂ] H')
    (hT : FiniteDimensional ℂ (LinearMap.range (T : H →ₗ[ℂ] H'))) :
    IsCompactOperator T := by
  let T' : H →L[ℂ] LinearMap.range (T : H →ₗ[ℂ] H') :=
    T.codRestrict (LinearMap.range (T : H →ₗ[ℂ] H')) (fun x => LinearMap.mem_range_self _ x)
  have h1 : IsCompactOperator T' := isCompactOperator_of_locallyCompactSpace_dom T'
  have h2 := h1.continuous_comp (g := ((↑) : LinearMap.range (T : H →ₗ[ℂ] H') → H'))
    continuous_subtype_val
  exact h2

