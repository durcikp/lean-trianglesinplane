/-! ### Elementary compactness principles (`ext:compact-facts`) -/

/-- **Lemma `ext:compact-facts`** (`‖T‖ = ‖T*‖`).
For a bounded operator between Hilbert spaces, $\|T\|=\|T^*\|$ and $\|TT^*\|=\|T\|^2$.
The following compactness facts also hold.
1. Finite-rank operators are compact, and an operator-norm limit of compact operators is compact.
2. An integral operator with kernel in $L^2(X\times Y)$, where $X,Y$ are bounded measurable
   subsets of Euclidean space, is compact from $L^2(Y)$ to $L^2(X)$.
3. If $T$ is compact and a bounded sequence $f_n$ converges weakly to $f$, then $Tf_n\to Tf$
   in norm. -/
theorem ext_compact_facts_norm_adjoint (T : H →L[ℂ] H') :
    ‖ContinuousLinearMap.adjoint T‖ = ‖T‖ :=
  LinearIsometryEquiv.norm_map _ T

/-- **Lemma `ext:compact-facts`** (`‖TT*‖ = ‖T‖²`).
For a bounded operator between Hilbert spaces, $\|T\|=\|T^*\|$ and $\|TT^*\|=\|T\|^2$.
The following compactness facts also hold.
1. Finite-rank operators are compact, and an operator-norm limit of compact operators is compact.
2. An integral operator with kernel in $L^2(X\times Y)$, where $X,Y$ are bounded measurable
   subsets of Euclidean space, is compact from $L^2(Y)$ to $L^2(X)$.
3. If $T$ is compact and a bounded sequence $f_n$ converges weakly to $f$, then $Tf_n\to Tf$
   in norm. -/
theorem ext_compact_facts_norm_comp_adjoint (T : H →L[ℂ] H') :
    ‖T ∘L ContinuousLinearMap.adjoint T‖ = ‖T‖ ^ 2 := by
  have h := ContinuousLinearMap.norm_adjoint_comp_self (ContinuousLinearMap.adjoint T)
  rw [ContinuousLinearMap.adjoint_adjoint, LinearIsometryEquiv.norm_map] at h
  rw [h, sq]

