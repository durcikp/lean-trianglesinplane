abbrev aux_ind {γ : Type*} [MeasurableSpace γ] (ρ : Measure γ) [IsFiniteMeasure ρ] {S : Set γ}
    (hS : MeasurableSet S) : Lp ℂ 2 ρ :=
  indicatorConstLp 2 hS (measure_ne_top ρ S) (1 : ℂ)

