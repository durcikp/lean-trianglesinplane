/-- Every `L²` kernel gives a compact operator (density of simple kernels and closedness of
compact operators; helper for `Auto.ext_compact_facts_integral`). -/
theorem aux_kerOp_compact (k : Lp ℂ 2 (μ.prod ν)) : IsCompactOperator (aux_kerOp k) := by
  refine Lp.induction (p := 2) (by norm_num) (fun k => IsCompactOperator (aux_kerOp k))
    ?_ ?_ ?_ k
  · intro c S hS hμS
    rw [Lp.simpleFunc.coe_indicatorConst]
    have : indicatorConstLp 2 hS hμS.ne c = c • aux_ind (μ.prod ν) hS := by
      apply Lp.ext
      filter_upwards [indicatorConstLp_coeFn (p := 2) (hs := hS) (hμs := hμS.ne) (c := c),
        indicatorConstLp_coeFn (p := 2) (hs := hS) (hμs := measure_ne_top (μ.prod ν) S)
          (c := (1 : ℂ)),
        Lp.coeFn_smul c (aux_ind (μ.prod ν) hS)] with x h1 h2 h3
      rw [h1, h3, Pi.smul_apply, h2]
      by_cases hx : x ∈ S <;> simp [indicator, hx]
    rw [this, ← aux_kerOpL_apply, map_smul]
    exact (aux_kerOp_ind_compact S hS).smul c
  · intro f g hf hg _ h1 h2
    rw [← aux_kerOpL_apply, map_add]
    exact h1.add h2
  · exact isClosed_setOfPred_isCompactOperator.preimage aux_kerOpL.continuous

end Compact
end KernelOp

/-- **Lemma `ext:compact-facts`** (2, Hilbert–Schmidt integral operators).  The integral operator
`f ↦ ∫_Y k(·, y) f(y) dy` with `k ∈ L²(X × Y)` is (represented by) a compact operator
`L²(Y) → L²(X)`.
For a bounded operator between Hilbert spaces, $\|T\|=\|T^*\|$ and $\|TT^*\|=\|T\|^2$.
The following compactness facts also hold.
1. Finite-rank operators are compact, and an operator-norm limit of compact operators is compact.
2. An integral operator with kernel in $L^2(X\times Y)$, where $X,Y$ are bounded measurable
   subsets of Euclidean space, is compact from $L^2(Y)$ to $L^2(X)$.
3. If $T$ is compact and a bounded sequence $f_n$ converges weakly to $f$, then $Tf_n\to Tf$
   in norm.
(In Lean the blueprint hypotheses `(hX : MeasurableSet X)`, `(hY : MeasurableSet Y)` are omitted
since the proof does not need them; see `automation/ErrorReport.md`.) -/
theorem ext_compact_facts_integral {n m : ℕ} {X : Set (EuclideanSpace ℝ (Fin n))}
    {Y : Set (EuclideanSpace ℝ (Fin m))} (hXb : Bornology.IsBounded X)
(hYb : Bornology.IsBounded Y)
    (k : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin m) → ℂ)
    (hk : MemLp k 2 ((volume.restrict X).prod (volume.restrict Y))) :
    ∃ T : Lp ℂ 2 (volume.restrict Y) →L[ℂ] Lp ℂ 2 (volume.restrict X),
      IsCompactOperator T ∧
      ∀ f : Lp ℂ 2 (volume.restrict Y),
        (T f : EuclideanSpace ℝ (Fin n) → ℂ) =ᵐ[volume.restrict X]
          fun x => ∫ y, k (x, y) * f y ∂(volume.restrict Y) := by
  have : IsFiniteMeasure (volume.restrict X) :=
    isFiniteMeasure_restrict.2 hXb.measure_lt_top.ne
  have : IsFiniteMeasure (volume.restrict Y) :=
    isFiniteMeasure_restrict.2 hYb.measure_lt_top.ne
  refine ⟨aux_kerOp (hk.toLp k), aux_kerOp_compact _, fun f => ?_⟩
  exact (aux_kerOp_ae _ f).trans
    (aux_kerFun_congr hk.coeFn_toLp (EventuallyEq.refl _ (f : _ → ℂ)))

/-- **Lemma `ext:compact-facts`** (3, compact operators map weakly convergent bounded sequences
to norm convergent ones).
For a bounded operator between Hilbert spaces, $\|T\|=\|T^*\|$ and $\|TT^*\|=\|T\|^2$.
The following compactness facts also hold.
1. Finite-rank operators are compact, and an operator-norm limit of compact operators is compact.
2. An integral operator with kernel in $L^2(X\times Y)$, where $X,Y$ are bounded measurable
   subsets of Euclidean space, is compact from $L^2(Y)$ to $L^2(X)$.
3. If $T$ is compact and a bounded sequence $f_n$ converges weakly to $f$, then $Tf_n\to Tf$
   in norm. -/
theorem ext_compact_facts_weak (T : H →L[ℂ] H') (hT : IsCompactOperator T) (f : ℕ → H) (f₀ : H)
    (hb : ∃ C, ∀ n, ‖f n‖ ≤ C)
    (hw : ∀ h : H, Tendsto (fun n => ⟪h, f n⟫_ℂ) atTop (𝓝 ⟪h, f₀⟫_ℂ)) :
    Tendsto (fun n => T (f n)) atTop (𝓝 (T f₀)) := by
  obtain ⟨C, hC⟩ := hb
  obtain ⟨K, hK, hKsub⟩ := hT.image_closedBall_subset_compact C
  have hmem : ∀ n, T (f n) ∈ K := fun n => hKsub ⟨f n, by simpa using hC n, rfl⟩
  -- weak convergence of `T f n`
  have hTw : ∀ h : H', Tendsto (fun n => ⟪h, T (f n)⟫_ℂ) atTop (𝓝 ⟪h, T f₀⟫_ℂ) := by
    intro h
    simpa [← ContinuousLinearMap.adjoint_inner_left] using hw (ContinuousLinearMap.adjoint T h)
  refine hK.tendsto_nhds_of_unique_mapClusterPt (Eventually.of_forall hmem) ?_
  intro y _ hy
  refine ext_inner_left ℂ fun h => ?_
  have hc : MapClusterPt ⟪h, y⟫_ℂ atTop (fun n => ⟪h, T (f n)⟫_ℂ) :=
    hy.tendsto_comp ((continuous_const.inner continuous_id).tendsto y)
  have h2 : ClusterPt ⟪h, y⟫_ℂ (𝓝 ⟪h, T f₀⟫_ℂ) := ClusterPt.mono hc (hTw h)
  exact eq_of_nhds_neBot h2

/-! ### Compactness from the product with the adjoint (`ext:ttstar`) -/

/-- If `A* A` is compact then `A` is compact (helper for `Auto.ext_ttstar`). -/
theorem aux_compact_of_adjoint_comp_self (A : H →L[ℂ] H')
    (h : IsCompactOperator (ContinuousLinearMap.adjoint A ∘L A)) : IsCompactOperator A := by
  set K := ContinuousLinearMap.adjoint A ∘L A
  refine (isCompactOperator_iff_isCompact_closure_image_ball (A : H →ₗ[ℂ] H') one_pos).2 ?_
  change IsCompact (closure (A '' Metric.ball 0 1))
  have hKtb : TotallyBounded (K '' Metric.ball 0 1) :=
    (h.isCompact_closure_image_ball 1).totallyBounded.subset subset_closure
  refine (TotallyBounded.closure ?_).isCompact_of_isClosed isClosed_closure
  rw [Metric.totallyBounded_iff]
  intro ε hε
  obtain ⟨t, ht, htf, hcov⟩ := Metric.finite_approx_of_totallyBounded hKtb (ε ^ 2 / 2)
    (by positivity)
  obtain ⟨u, hu, huf, hcov'⟩ := (exists_subset_image_finite_and (f := K)
    (p := fun t => K '' Metric.ball 0 1 ⊆ ⋃ y ∈ t, Metric.ball y (ε ^ 2 / 2))).1
    ⟨t, ht, htf, hcov⟩
  refine ⟨A '' u, huf.image _, ?_⟩
  rintro _ ⟨x, hx, rfl⟩
  have hKx : K x ∈ ⋃ y ∈ K '' u, Metric.ball y (ε ^ 2 / 2) := hcov' ⟨x, hx, rfl⟩
  simp only [mem_iUnion, exists_prop, mem_image, exists_exists_and_eq_and] at hKx
  obtain ⟨x', hx'u, hd⟩ := hKx
  simp only [mem_iUnion, exists_prop, mem_image, exists_exists_and_eq_and]
  refine ⟨x', hx'u, ?_⟩
  have hx' := hu hx'u
  rw [Metric.mem_ball, dist_eq_norm] at hd ⊢
  rw [mem_ball_zero_iff] at hx hx'
  have hsq : ‖A x - A x'‖ ^ 2 < ε ^ 2 := by
    rw [← map_sub, ContinuousLinearMap.apply_norm_sq_eq_inner_adjoint_left]
    calc RCLike.re ⟪K (x - x'), x - x'⟫_ℂ ≤ ‖K (x - x')‖ * ‖x - x'‖ :=
          (RCLike.re_le_norm _).trans (norm_inner_le_norm _ _)
      _ ≤ ‖K x - K x'‖ * 2 := by
          rw [map_sub]
          gcongr
          calc ‖x - x'‖ ≤ ‖x‖ + ‖x'‖ := norm_sub_le _ _
            _ ≤ 2 := by linarith
      _ < ε ^ 2 / 2 * 2 := by gcongr
      _ = ε ^ 2 := by ring
  exact lt_of_pow_lt_pow_left₀ 2 hε.le hsq

/-- **Lemma `ext:ttstar`**.
If $T:H\to H'$ is bounded and $TT^*:H'\to H'$ is compact, then $T$ is compact. -/
theorem ext_ttstar (T : H →L[ℂ] H')
    (h : IsCompactOperator (T ∘L ContinuousLinearMap.adjoint T)) : IsCompactOperator T := by
  have h1 : IsCompactOperator (ContinuousLinearMap.adjoint T) := by
    apply aux_compact_of_adjoint_comp_self
    rwa [ContinuousLinearMap.adjoint_adjoint]
  apply aux_compact_of_adjoint_comp_self
  rw [ContinuousLinearMap.coe_comp]
  exact h1.comp_clm T

