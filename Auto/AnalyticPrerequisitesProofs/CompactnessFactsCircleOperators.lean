/-- A rectangle kernel `1_{A×B}` gives a rank-one, hence compact, operator (helper for
`Auto.ext_compact_facts_integral`). -/
theorem aux_kerOp_rect {A : Set α} {B : Set β} (hA : MeasurableSet A) (hB : MeasurableSet B) :
    IsCompactOperator (aux_kerOp (aux_ind (μ.prod ν) (hA.prod hB))) := by
  set ℓ : Lp ℂ 2 ν →L[ℂ] ℂ := innerSL ℂ (aux_ind ν hB)
  have heq : aux_kerOp (aux_ind (μ.prod ν) (hA.prod hB)) =
      ((ContinuousLinearMap.id ℂ ℂ).smulRight (aux_ind μ hA)).comp ℓ := by
    ext1 f
    apply Lp.ext
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.id_apply, ℓ, innerSL_apply_apply, L2.inner_indicatorConstLp_one]
    filter_upwards [aux_kerOp_ae (aux_ind (μ.prod ν) (hA.prod hB)) f,
      Lp.coeFn_smul (∫ x in B, f x ∂ν) (aux_ind μ hA),
      indicatorConstLp_coeFn (p := 2) (hs := hA) (hμs := measure_ne_top μ A) (c := (1 : ℂ)),
      aux_kerFun_congr (μ := μ) (ν := ν)
        (indicatorConstLp_coeFn (p := 2) (hs := hA.prod hB) (hμs := measure_ne_top _ _)
          (c := (1 : ℂ))) (EventuallyEq.refl _ (f : β → ℂ))] with x h1 h2 h3 h4
    rw [h1, h4, h2, Pi.smul_apply, h3]
    simp only [aux_kerFun, smul_eq_mul]
    by_cases hx : x ∈ A
    · simp only [indicator, mem_prod, hx, true_and, if_true, mul_one]
      rw [← integral_indicator hB]
      congr 1; funext y; by_cases hy : y ∈ B <;> simp [indicator, hy, hx]
    · simp [indicator, mem_prod, hx]
  rw [heq, ContinuousLinearMap.coe_comp]
  exact (isCompactOperator_of_locallyCompactSpace_rng
    ((ContinuousLinearMap.id ℂ ℂ).smulRight (aux_ind μ hA))).comp_clm ℓ

