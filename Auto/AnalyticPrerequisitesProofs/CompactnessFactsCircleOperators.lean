/-- **Lemma `ext:compact-gap`** (finite-dimensional kernel).
Let $K$ be a compact self-adjoint operator on a Hilbert space, and suppose $B=I+K$ is
nonnegative.  Then $\ker B$ is finite dimensional, and there is $\gamma>0$ such that
$$\langle Bf,f\rangle\ge\gamma\operatorname{dist}(f,\ker B)^2\qquad(f\in H).$$
(In Lean the blueprint hypotheses `(hsa : IsSelfAdjoint K)`, `(hB : ∀ f : H, 0 ≤ RCLike.re ⟪(1 + K)
f, f⟫_ℂ)` are omitted since the proof does not need them; see `automation/ErrorReport.md`.) -/
theorem ext_compact_gap_ker (K : H →L[ℂ] H) (hK : IsCompactOperator K) :
    FiniteDimensional ℂ (LinearMap.ker ((1 + K : H →L[ℂ] H) : H →ₗ[ℂ] H)) := by
  set V := LinearMap.ker ((1 + K : H →L[ℂ] H) : H →ₗ[ℂ] H)
  have hV : ∀ x ∈ V, K x = -x := by
    intro x hx
    have : (1 + K : H →L[ℂ] H) x = 0 := hx
    simp only [_root_.add_apply, one_apply_eq_self] at this
    exact eq_neg_of_add_eq_zero_right this
  have hVc : IsClosed (V : Set H) := ContinuousLinearMap.isClosed_ker (1 + K)
  refine FiniteDimensional.of_isCompact_closedBall₀ ℂ one_pos ?_
  rw [Topology.IsInducing.subtypeVal.isCompact_iff]
  have hsub : ((↑) : V → H) '' Metric.closedBall 0 1 ⊆ closure (K '' Metric.closedBall 0 1) := by
    rintro _ ⟨x, hx, rfl⟩
    refine subset_closure ⟨-(x : H), ?_, ?_⟩
    · simpa [mem_closedBall_zero_iff] using hx
    · rw [map_neg, hV x x.2, neg_neg]
  refine (hK.isCompact_closure_image_closedBall 1).of_isClosed_subset ?_ hsub
  convert hVc.inter (Metric.isClosed_closedBall (x := (0 : H)) (ε := 1)) using 1
  · ext y; constructor
    · rintro ⟨x, hx, rfl⟩; exact ⟨x.2, by simpa [mem_closedBall_zero_iff] using hx⟩
    · rintro ⟨hy, hy'⟩; exact ⟨⟨y, hy⟩, by simpa [mem_closedBall_zero_iff] using hy', rfl⟩

