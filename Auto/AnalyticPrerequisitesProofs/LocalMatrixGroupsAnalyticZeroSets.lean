/-! ### A continuous local matrix group is exponential (`ext:matrix-group`) -/

/-- Auxiliary to `ext:matrix-group` (used in `Auto.ext_matrix_group`): a continuous local
one-parameter group `c` in a real Banach algebra (defined and multiplicative on `(-ε, ε)`, with
`c 0 = 1`) is of the form `c t = exp (t • T)` near `0`.  The proof follows the manuscript:
`A = ∫₀ᵃ c` is invertible for small `a`, `c h A = ∫ₕ^{h+a} c` shows `c' = c T` with
`T = (c a - 1) A⁻¹`, and `c h exp(-hT)` has zero derivative. -/
theorem aux_oneParam_exp {𝔸 : Type*} [NormedRing 𝔸] [NormedAlgebra ℝ 𝔸] [CompleteSpace 𝔸]
    (c : ℝ → 𝔸) {ε : ℝ} (hε : 0 < ε) (hc : ContinuousOn c (Metric.ball 0 ε)) (hc0 : c 0 = 1)
    (hmul : ∀ s t, s ∈ Metric.ball (0 : ℝ) ε → t ∈ Metric.ball (0 : ℝ) ε →
      s + t ∈ Metric.ball (0 : ℝ) ε → c (s + t) = c s * c t) :
    ∃ T : 𝔸, ∃ δ > 0, ∀ t ∈ Metric.ball (0 : ℝ) δ, c t = NormedSpace.exp (t • T) := by
  set B := Metric.ball (0 : ℝ) ε with hB
  have hBo : IsOpen B := Metric.isOpen_ball
  have hint : ∀ x y, x ∈ B → y ∈ B → IntervalIntegrable c volume x y := fun x y hx hy =>
    (hc.mono ((convex_ball (0 : ℝ) ε).ordConnected.uIcc_subset hx hy)).intervalIntegrable
  have hcA : ∀ x ∈ B, ContinuousAt c x := fun x hx => hc.continuousAt (hBo.mem_nhds hx)
  have hderI : ∀ x ∈ B, HasDerivAt (fun u => ∫ t in (0 : ℝ)..u, c t) (c x) x := fun x hx =>
    intervalIntegral.integral_hasDerivAt_right (hint 0 x (Metric.mem_ball_self hε) hx)
      (hc.stronglyMeasurableAtFilter hBo x hx) (hcA x hx)
  -- Step 1: choose `a` with `∫₀ᵃ c` invertible.
  obtain ⟨a, ⟨ha0, haε⟩, hAu⟩ : ∃ a : ℝ, (0 < a ∧ a < ε / 2) ∧
      IsUnit (∫ t in (0 : ℝ)..a, c t) := by
    have hsl := (hderI 0 (Metric.mem_ball_self hε)).tendsto_slope_zero_right
    simp only [zero_add, intervalIntegral.integral_same, sub_zero, hc0] at hsl
    have h1 : ∀ᶠ u in 𝓝[>] (0 : ℝ), IsUnit (u⁻¹ • ∫ t in (0 : ℝ)..u, c t) :=
      hsl (Units.isOpen.mem_nhds isUnit_one)
    have h2 : ∀ᶠ u in 𝓝[>] (0 : ℝ), u < ε / 2 :=
      nhdsWithin_le_nhds (gt_mem_nhds (by linarith))
    obtain ⟨u, hu1, hu2, hu3⟩ := (h1.and (h2.and self_mem_nhdsWithin)).exists
    refine ⟨u, ⟨hu3, hu2⟩, ?_⟩
    have hu : (∫ t in (0 : ℝ)..u, c t) = algebraMap ℝ 𝔸 u * (u⁻¹ • ∫ t in (0 : ℝ)..u, c t) := by
      rw [← Algebra.smul_def, smul_smul, mul_inv_cancel₀ (ne_of_gt hu3), one_smul]
    rw [hu]
    exact ((isUnit_iff_ne_zero.mpr (ne_of_gt hu3)).map (algebraMap ℝ 𝔸)).mul hu1
  obtain ⟨Au, hAu⟩ := hAu
  set A := ∫ t in (0 : ℝ)..a, c t
  set Ai : 𝔸 := ↑Au⁻¹
  have haB : a ∈ B := by
    rw [hB, Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt]; constructor <;> linarith
  -- Step 2: `c h = (∫_h^{h+a} c) A⁻¹` near zero.
  set B' := Metric.ball (0 : ℝ) (ε / 2)
  have hB'B : ∀ h ∈ B', h ∈ B := fun h hh => Metric.ball_subset_ball (by linarith) hh
  have hB'a : ∀ h ∈ B', h + a ∈ B := by
    intro h hh
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt] at hh ⊢; constructor <;> linarith
  have hrep : ∀ h ∈ B', c h = ((∫ t in (0 : ℝ)..(h + a), c t) - ∫ t in (0 : ℝ)..h, c t) * Ai := by
    intro h hh
    have e1 : c h * A = ∫ t in (0 : ℝ)..a, c (h + t) := by
      change (ContinuousLinearMap.mul ℝ 𝔸 (c h)) A = _
      rw [← ((ContinuousLinearMap.mul ℝ 𝔸) (c h)).intervalIntegral_comp_comm
        (hint 0 a (Metric.mem_ball_self hε) haB)]
      refine intervalIntegral.integral_congr fun t ht => ?_
      rw [uIcc_of_le ha0.le] at ht
      have htB : t ∈ B := by
        rw [hB, Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt]
        constructor <;> linarith [ht.1, ht.2]
      have hhtB : h + t ∈ B := by
        have := hh; rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt] at this
        rw [hB, Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt]
        constructor <;> linarith [ht.1, ht.2]
      simp [hmul h t (hB'B h hh) htB hhtB]
    rw [intervalIntegral.integral_comp_add_left (fun t => c t) h, add_zero] at e1
    rw [intervalIntegral.integral_interval_sub_left (hint 0 _ (Metric.mem_ball_self hε) (hB'a h hh))
      (hint 0 _ (Metric.mem_ball_self hε) (hB'B h hh)), ← e1, mul_assoc, ← hAu, Units.mul_inv,
      mul_one]
  set T : 𝔸 := (c a - 1) * Ai
  have hder : ∀ h ∈ B', HasDerivAt c (c h * T) h := by
    intro h hh
    have d1 := ((hderI (h + a) (hB'a h hh)).comp_add_const h a)
    have d2 := (d1.sub (hderI h (hB'B h hh))).mul_const Ai
    have hev : (fun h => ((∫ t in (0 : ℝ)..(h + a), c t) - ∫ t in (0 : ℝ)..h, c t) * Ai)
        =ᶠ[𝓝 h] c :=
      Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hh) fun x hx => (hrep x hx).symm
    refine (d2.congr_of_eventuallyEq hev.symm).congr_deriv ?_
    rw [hmul h a (hB'B h hh) haB (hB'a h hh)]
    simp only [T]; noncomm_ring
  -- Step 3: `c h * exp(-hT)` is constant.
  refine ⟨T, ε / 2, by linarith, fun h hh => ?_⟩
  set g : ℝ → 𝔸 := fun h => c h * NormedSpace.exp (h • (-T))
  have hgder : ∀ h ∈ B', HasDerivAt g 0 h := by
    intro h hh
    refine ((hder h hh).mul (hasDerivAt_exp_smul_const' (-T) h)).congr_deriv ?_
    noncomm_ring
  have hconst : g h = g 0 :=
    Metric.isOpen_ball.is_const_of_deriv_eq_zero (convex_ball _ _).isPreconnected
      (fun x hx => (hgder x hx).differentiableAt.differentiableWithinAt)
      (fun x hx => (hgder x hx).deriv) hh (Metric.mem_ball_self (by linarith))
  have hg0 : g 0 = 1 := by simp [g, hc0]
  have hEE : NormedSpace.exp (h • (-T)) * NormedSpace.exp (h • T) = 1 := by
    rw [← NormedSpace.exp_add_of_commute_of_mem_ball (𝕂 := ℝ)
      (((Commute.refl T).neg_left.smul_left h).smul_right h)
      ((NormedSpace.expSeries_radius_eq_top ℝ 𝔸).symm ▸ edist_lt_top _ _)
      ((NormedSpace.expSeries_radius_eq_top ℝ 𝔸).symm ▸ edist_lt_top _ _),
      smul_neg, neg_add_cancel, NormedSpace.exp_zero]
  calc c h = c h * (NormedSpace.exp (h • (-T)) * NormedSpace.exp (h • T)) := by rw [hEE, mul_one]
    _ = g h * NormedSpace.exp (h • T) := by simp only [g, mul_assoc]
    _ = NormedSpace.exp (h • T) := by rw [hconst, hg0, one_mul]

/-- **Lemma `ext:matrix-group`** (exponential form near zero).
Let $U$ be a neighborhood of zero in $\mathbb R^2$.  Suppose $C:U\to\mathrm{GL}_d(\mathbb R)$ is
continuous, $C(0)=I$, and $C(h+k)=C(h)C(k)$ whenever $h,k,h+k\in U$.
There are commuting real matrices $T_1,T_2$ such that, on a possibly smaller neighborhood of
zero, $$C(h)=\exp(h_1T_1+h_2T_2).$$
The expression on the right is real analytic for all $h\in\mathbb R^2$. -/
theorem ext_matrix_group {d : ℕ} {U : Set ℝ²} (hU : U ∈ 𝓝 (0 : ℝ²))
    (C : ℝ² → Matrix (Fin d) (Fin d) ℝ) (hC : ContinuousOn C U) (hGL : ∀ h ∈ U, IsUnit (C h))
    (hC0 : C 0 = 1) (hmul : ∀ h k, h ∈ U → k ∈ U → h + k ∈ U → C (h + k) = C h * C k) :
    ∃ T₁ T₂ : Matrix (Fin d) (Fin d) ℝ, Commute T₁ T₂ ∧
      ∀ᶠ h in 𝓝 (0 : ℝ²), C h = NormedSpace.exp (h 0 • T₁ + h 1 • T₂) := by
  have _ := hGL -- invertibility is automatic near zero and not needed below
  open scoped Matrix.Norms.Operator in
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hU
  set e : Fin 2 → ℝ² := fun i => EuclideanSpace.single i (1 : ℝ) with he
  have hne : ∀ i (t : ℝ), ‖t • e i‖ = |t| := by
    intro i t; simp [he, norm_smul]
  have hmemU : ∀ i (t : ℝ), t ∈ Metric.ball (0 : ℝ) ε → t • e i ∈ U := by
    intro i t ht; apply hball
    simpa [Metric.mem_ball, hne, Real.dist_eq] using ht
  have hone : ∀ i, ∃ T : Matrix (Fin d) (Fin d) ℝ, ∃ δ > 0,
      ∀ t ∈ Metric.ball (0 : ℝ) δ, C (t • e i) = NormedSpace.exp (t • T) := by
    intro i
    refine aux_oneParam_exp (fun t => C (t • e i)) hε ?_ (by simp [hC0]) ?_
    · exact hC.comp (by fun_prop : Continuous fun t : ℝ => t • e i).continuousOn
        (fun t ht => hmemU i t ht)
    · intro s t hs ht hst
      simp only [add_smul]
      exact hmul _ _ (hmemU i s hs) (hmemU i t ht) (by rw [← add_smul]; exact hmemU i _ hst)
  obtain ⟨T₁, δ₁, hδ₁, h₁⟩ := hone 0
  obtain ⟨T₂, δ₂, hδ₂, h₂⟩ := hone 1
  set δ := min (min δ₁ δ₂) (ε / 2) with hδ
  have hδ0 : 0 < δ := lt_min (lt_min hδ₁ hδ₂) (by linarith)
  have hδ1 : δ ≤ δ₁ := (min_le_left _ _).trans (min_le_left _ _)
  have hδ2 : δ ≤ δ₂ := (min_le_left _ _).trans (min_le_right _ _)
  have hδε : δ ≤ ε / 2 := min_le_right _ _
  have hsmall : ∀ i j, ∀ s t : ℝ, |s| < δ → |t| < δ →
      C (s • e i + t • e j) = C (s • e i) * C (t • e j) := by
    intro i j s t hs ht
    have hsU := hmemU i s (by rw [Metric.mem_ball, Real.dist_eq, sub_zero]; linarith)
    have htU := hmemU j t (by rw [Metric.mem_ball, Real.dist_eq, sub_zero]; linarith)
    refine hmul _ _ hsU htU (hball ?_)
    rw [Metric.mem_ball, dist_zero_right]
    calc ‖s • e i + t • e j‖ ≤ ‖s • e i‖ + ‖t • e j‖ := norm_add_le _ _
      _ = |s| + |t| := by rw [hne, hne]
      _ < ε := by linarith
  -- the one-parameter groups commute for small parameters
  have hcomm0 : ∀ s t : ℝ, |s| < δ → |t| < δ →
      NormedSpace.exp (s • T₁) * NormedSpace.exp (t • T₂) =
        NormedSpace.exp (t • T₂) * NormedSpace.exp (s • T₁) := by
    intro s t hs ht
    have hsb : s ∈ Metric.ball (0 : ℝ) δ₁ := by
      rw [Metric.mem_ball, Real.dist_eq, sub_zero]; linarith
    have htb : t ∈ Metric.ball (0 : ℝ) δ₂ := by
      rw [Metric.mem_ball, Real.dist_eq, sub_zero]; linarith
    rw [← h₁ s hsb, ← h₂ t htb, ← hsmall 0 1 s t hs ht, ← hsmall 1 0 t s ht hs, add_comm]
  have hcT : ∀ t : ℝ, |t| < δ →
      T₁ * NormedSpace.exp (t • T₂) = NormedSpace.exp (t • T₂) * T₁ := by
    intro t ht
    set X := NormedSpace.exp (t • T₂)
    have d1 := (hasDerivAt_exp_smul_const (𝕂 := ℝ) T₁ 0).mul_const X
    have d2 := (hasDerivAt_exp_smul_const (𝕂 := ℝ) T₁ 0).const_mul X
    have hev : (fun s : ℝ => NormedSpace.exp (s • T₁) * X) =ᶠ[𝓝 0]
        (fun s : ℝ => X * NormedSpace.exp (s • T₁)) := by
      filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hδ0] with s hs
      rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hs
      exact hcomm0 s t hs ht
    have := d1.unique (d2.congr_of_eventuallyEq hev)
    simpa [zero_smul, NormedSpace.exp_zero] using this
  have hcomm : Commute T₁ T₂ := by
    have d1 := (hasDerivAt_exp_smul_const (𝕂 := ℝ) T₂ 0).const_mul T₁
    have d2 := (hasDerivAt_exp_smul_const (𝕂 := ℝ) T₂ 0).mul_const T₁
    have hev : (fun t : ℝ => T₁ * NormedSpace.exp (t • T₂)) =ᶠ[𝓝 0]
        (fun t : ℝ => NormedSpace.exp (t • T₂) * T₁) := by
      filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hδ0] with t ht
      rw [Metric.mem_ball, Real.dist_eq, sub_zero] at ht
      exact hcT t ht
    have := d1.unique (d2.congr_of_eventuallyEq hev)
    change T₁ * T₂ = T₂ * T₁
    simpa [zero_smul, NormedSpace.exp_zero] using this
  refine ⟨T₁, T₂, hcomm, ?_⟩
  filter_upwards [Metric.ball_mem_nhds (0 : ℝ²) hδ0] with h hh
  rw [Metric.mem_ball, dist_zero_right] at hh
  have hi : ∀ i, |h i| < δ := fun i =>
    lt_of_le_of_lt (by simpa using PiLp.norm_apply_le h i) hh
  have hdec : h = h 0 • e 0 + h 1 • e 1 := by
    ext i; fin_cases i <;> simp [he]
  have hb : ∀ i, h i ∈ Metric.ball (0 : ℝ) δ := fun i => by
    rw [Metric.mem_ball, Real.dist_eq, sub_zero]; exact hi i
  conv_lhs => rw [hdec]
  rw [hsmall 0 1 _ _ (hi 0) (hi 1), h₁ _ (Metric.ball_subset_ball hδ1 (hb 0)),
    h₂ _ (Metric.ball_subset_ball hδ2 (hb 1)),
    Matrix.exp_add_of_commute _ _ ((hcomm.smul_left _).smul_right _)]

/-- **Lemma `ext:matrix-group`** (real analyticity of `h ↦ exp(h₁T₁ + h₂T₂)`, entrywise).
Let $U$ be a neighborhood of zero in $\mathbb R^2$.  Suppose $C:U\to\mathrm{GL}_d(\mathbb R)$ is
continuous, $C(0)=I$, and $C(h+k)=C(h)C(k)$ whenever $h,k,h+k\in U$.
There are commuting real matrices $T_1,T_2$ such that, on a possibly smaller neighborhood of
zero, $$C(h)=\exp(h_1T_1+h_2T_2).$$
The expression on the right is real analytic for all $h\in\mathbb R^2$. -/
theorem ext_matrix_group_analytic {d : ℕ} (T₁ T₂ : Matrix (Fin d) (Fin d) ℝ) (i j : Fin d) :
    AnalyticOnNhd ℝ (fun h : ℝ² => NormedSpace.exp (h 0 • T₁ + h 1 • T₂) i j) univ := by
  open scoped Matrix.Norms.Operator in
  intro h _
  let L : ℝ² →ₗ[ℝ] Matrix (Fin d) (Fin d) ℝ :=
    { toFun := fun h => h 0 • T₁ + h 1 • T₂
      map_add' := fun x y => by simp [add_smul]; abel
      map_smul' := fun c x => by simp [smul_add, smul_smul] }
  let P : Matrix (Fin d) (Fin d) ℝ →ₗ[ℝ] ℝ := Matrix.entryLinearMap ℝ ℝ i j
  exact (LinearMap.toContinuousLinearMap P).analyticAt _ |>.comp
    ((NormedSpace.exp_analytic (𝕂 := ℝ) _).comp ((LinearMap.toContinuousLinearMap L).analyticAt h))

/-! ### Zero sets of real analytic functions (`ext:analytic-zero`) -/

/-- Auxiliary to `ext:analytic-zero` (used for `Auto.ext_analytic_zero` and
`Auto.ext_analytic_zero_config`): the property of a real normed space `E` with a measure that every
real analytic function on a preconnected open set `U ⊆ E` vanishing on a subset of `U` of positive
measure vanishes on all of `U`. -/
def aux_AnalyticZeroProp (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasureSpace E] :
    Prop :=
  ∀ U : Set E, IsOpen U → IsPreconnected U → ∀ F : E → ℝ, AnalyticOnNhd ℝ F U →
    0 < volume {x ∈ U | F x = 0} → ∀ x ∈ U, F x = 0

/-- Auxiliary to `ext:analytic-zero` (used in `Auto.ext_analytic_zero`): the zero set of a function
continuous on an open set `U`, taken inside `U`, is measurable. -/
theorem aux_measurableSet_zeroSet {E : Type*} [TopologicalSpace E] [MeasurableSpace E]
    [OpensMeasurableSpace E] {U : Set E} (hU : IsOpen U) {F : E → ℝ} (hF : ContinuousOn F U) :
    MeasurableSet {x ∈ U | F x = 0} := by
  have : {x ∈ U | F x = 0} = U \ (U ∩ F ⁻¹' {0}ᶜ) := by
    ext x; simp only [mem_ofPred_eq, Set.mem_sdiff, mem_inter_iff, mem_preimage, mem_compl_iff,
      mem_singleton_iff]; tauto
  rw [this]
  exact hU.measurableSet.diff (hF.isOpen_inter_preimage hU isOpen_compl_singleton).measurableSet

/-- Auxiliary to `ext:analytic-zero` (used in `Auto.ext_analytic_zero`): the one-dimensional case.
A set of positive measure in `ℝ` is uncountable, so it contains a point accumulated by the set from
the right; the isolated-zeros principle then forces the analytic function to vanish. -/
theorem aux_analyticZero_real : aux_AnalyticZeroProp ℝ := by
  intro U hU hUc F hF hpos x hx
  set Z := {x ∈ U | F x = 0}
  by_cases hacc : ∃ z ∈ Z, ∃ᶠ y in 𝓝[≠] z, F y = 0
  · obtain ⟨z, hz, hfr⟩ := hacc
    exact hF.eqOn_zero_of_preconnected_of_frequently_eq_zero hUc hz.1 hfr hx
  · exfalso
    push Not at hacc
    have hsub : Z ⊆ {x ∈ Z | 𝓝[Z ∩ Ioi x] x = ⊥} := by
      intro z hz
      refine ⟨hz, ?_⟩
      rw [← Filter.eventually_false_iff_eq_bot]
      have h1 : ∀ᶠ y in 𝓝[Z ∩ Ioi z] z, F y ≠ 0 :=
        nhdsWithin_mono _ (fun y hy => ne_of_gt hy.2) (hacc z hz)
      have h2 : ∀ᶠ y in 𝓝[Z ∩ Ioi z] z, y ∈ Z :=
        eventually_mem_nhdsWithin.mono fun y hy => hy.1
      exact (h1.and h2).mono fun y hy => hy.1 hy.2.2
    have := (countable_setOfPred_isolated_right_within (s := Z)).mono hsub |>.measure_zero volume
    exact (ne_of_gt hpos) this

/-- Auxiliary to `ext:analytic-zero` (used in `Auto.ext_analytic_zero` and
`Auto.ext_analytic_zero_config`): the property `aux_AnalyticZeroProp` passes to products.  If `F`
is not identically zero, it vanishes on no open set; on a product ball `B₁ × B₂` Fubini, applied
to the slices of the zero set, shows that the zero set is null. -/
theorem aux_analyticZero_prod {E₁ E₂ : Type*} [NormedAddCommGroup E₁] [NormedSpace ℝ E₁]
    [MeasureSpace E₁] [BorelSpace E₁] [SecondCountableTopology E₁]
    [SigmaFinite (volume : Measure E₁)]
    [NormedAddCommGroup E₂] [NormedSpace ℝ E₂] [MeasureSpace E₂] [BorelSpace E₂]
    [SecondCountableTopology E₂] [SigmaFinite (volume : Measure E₂)]
    (h₁ : aux_AnalyticZeroProp E₁) (h₂ : aux_AnalyticZeroProp E₂) :
    aux_AnalyticZeroProp (E₁ × E₂) := by
  intro U hU hUc F hF hpos x₀ hx₀
  by_contra hne
  have hnev : ∀ x ∈ U, ¬ (F =ᶠ[𝓝 x] 0) := fun x hx hev =>
    hne (hF.eqOn_zero_of_preconnected_of_eventuallyEq_zero hUc hx hev hx₀)
  set Z := {x ∈ U | F x = 0} with hZ
  have hZm : MeasurableSet Z := aux_measurableSet_zeroSet hU hF.continuousOn
  have hnull : volume Z = 0 := by
    refine measure_null_of_locally_null Z fun x hx => ?_
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU x hx.1
    rw [← ball_prod_same] at hball
    set B₁ := Metric.ball x.1 ε
    set B₂ := Metric.ball x.2 ε
    have hBn : B₁ ×ˢ B₂ ∈ 𝓝 x := prod_mem_nhds (Metric.ball_mem_nhds _ hε)
      (Metric.ball_mem_nhds _ hε)
    refine ⟨Z ∩ B₁ ×ˢ B₂, inter_mem_nhdsWithin _ hBn, ?_⟩
    have hmeas : MeasurableSet (Z ∩ B₁ ×ˢ B₂) :=
      hZm.inter (Metric.isOpen_ball.prod Metric.isOpen_ball).measurableSet
    have han₁ : ∀ w ∈ B₂, AnalyticOnNhd ℝ (fun t => F (t, w)) B₁ := fun w hw t ht =>
      AnalyticAt.comp (g := F) (f := fun s : E₁ => (s, w)) (hF (t, w) (hball ⟨ht, hw⟩))
        (analyticAt_id.prod analyticAt_const)
    have han₂ : ∀ t ∈ B₁, AnalyticOnNhd ℝ (fun w => F (t, w)) B₂ := fun t ht w hw =>
      AnalyticAt.comp (g := F) (f := fun v : E₂ => (t, v)) (hF (t, w) (hball ⟨ht, hw⟩))
        (analyticAt_const.prod analyticAt_id)
    set T := {t ∈ B₁ | ∀ w ∈ B₂, F (t, w) = 0}
    have hT : volume T = 0 := by
      by_contra hT'
      apply hnev x hx.1
      have hzero : ∀ w ∈ B₂, ∀ t ∈ B₁, F (t, w) = 0 := fun w hw =>
        h₁ B₁ Metric.isOpen_ball (convex_ball _ _).isPreconnected _ (han₁ w hw)
          (lt_of_lt_of_le (pos_iff_ne_zero.mpr hT') (measure_mono fun t ht => ⟨ht.1, ht.2 w hw⟩))
      filter_upwards [hBn] with p hp
      exact hzero p.2 hp.2 p.1 hp.1
    rw [Measure.volume_eq_prod, Measure.measure_prod_null hmeas]
    filter_upwards [measure_eq_zero_iff_ae_notMem.mp hT] with t ht
    simp only [Pi.zero_apply]
    by_cases htB : t ∈ B₁
    · by_contra hpos'
      refine ht ⟨htB, h₂ B₂ Metric.isOpen_ball (convex_ball _ _).isPreconnected _ (han₂ t htB)
        (lt_of_lt_of_le (pos_iff_ne_zero.mpr hpos') (measure_mono fun w hw => ?_))⟩
      exact ⟨hw.2.2, hw.1.2⟩
    · convert measure_empty (μ := (volume : Measure E₂))
      ext w; simp [htB]
  exact (ne_of_gt hpos) hnull

/-- Auxiliary to `ext:analytic-zero` (used in `Auto.ext_analytic_zero`): `aux_AnalyticZeroProp`
transfers along a measure-preserving homeomorphism which is real analytic. -/
theorem aux_analyticZero_transfer {E E' : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [MeasureSpace E] [NormedAddCommGroup E'] [NormedSpace ℝ E'] [MeasureSpace E']
    (e : E ≃ᵐ E') (he : Continuous e) (he' : Continuous e.symm) (hea : ∀ x, AnalyticAt ℝ e x)
    (hmp : MeasurePreserving e volume volume) (hP : aux_AnalyticZeroProp E) :
    aux_AnalyticZeroProp E' := by
  intro U hU hUc F hF hpos y hy
  have hUc' : IsPreconnected (e ⁻¹' U) := by
    have : e ⁻¹' U = e.symm '' U := by
      ext x; simp [MeasurableEquiv.image_symm]
    rw [this]; exact hUc.image _ he'.continuousOn
  have hF' : AnalyticOnNhd ℝ (F ∘ e) (e ⁻¹' U) := fun x hx => (hF (e x) hx).comp (hea x)
  have hZ : {x ∈ e ⁻¹' U | (F ∘ e) x = 0} = e ⁻¹' {y ∈ U | F y = 0} := rfl
  have := hP _ (hU.preimage he) hUc' _ hF' (by rw [hZ, hmp.measure_preimage_equiv]; exact hpos)
    (e.symm y) (by simpa using hy)
  simpa using this

/-- Auxiliary to `ext:analytic-zero` (used in `Auto.ext_analytic_zero`): `aux_AnalyticZeroProp`
holds for `Fin n → ℝ`, by induction on `n` via `ℝ × (Fin n → ℝ)`. -/
theorem aux_analyticZero_pi (n : ℕ) : aux_AnalyticZeroProp (Fin n → ℝ) := by
  induction n with
  | zero =>
    intro U _ _ F _ hpos x _
    obtain ⟨z, hz⟩ := nonempty_of_measure_ne_zero hpos.ne'
    rw [Subsingleton.elim x z]; exact hz.2
  | succ n ih =>
    have hprod := aux_analyticZero_prod aux_analyticZero_real ih
    set e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm
    refine aux_analyticZero_transfer e ?_ ?_ ?_
      (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) 0).symm hprod
    · refine continuous_pi fun i => ?_
      refine Fin.cases ?_ (fun j => ?_) i <;>
        simp only [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_zero,
          Fin.consEquiv_apply, Fin.cons_zero, Fin.cons_succ, e] <;> fun_prop
    · simp only [e, MeasurableEquiv.symm_symm]
      exact (continuous_apply 0).prodMk (continuous_pi fun j => continuous_apply _)
    · intro x
      refine AnalyticAt.pi fun i => ?_
      refine Fin.cases ?_ (fun j => ?_) i <;>
        simp only [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_zero,
          Fin.consEquiv_apply, Fin.cons_zero, Fin.cons_succ, e]
      · exact analyticAt_fst
      · exact ((ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin n => ℝ) j).analyticAt
          _).comp analyticAt_snd

/-- Auxiliary to `ext:analytic-zero` (used in `Auto.ext_analytic_zero` and
`Auto.ext_analytic_zero_config`): `aux_AnalyticZeroProp` holds for `EuclideanSpace ℝ (Fin d)`. -/
theorem aux_analyticZero_euclidean (d : ℕ) : aux_AnalyticZeroProp (EuclideanSpace ℝ (Fin d)) := by
  refine aux_analyticZero_transfer (MeasurableEquiv.toLp 2 (Fin d → ℝ)) ?_ ?_ ?_
    (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin d)).symm
    (aux_analyticZero_pi d)
  · exact PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ)
  · exact PiLp.continuous_ofLp 2 (fun _ : Fin d => ℝ)
  · intro x
    exact (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin d => ℝ)).symm.analyticAt x

/-- **Lemma `ext:analytic-zero`** (connected open subsets of `ℝ^d`, `d ≤ 3`).
Let $F:U\to\mathbb R$ be real analytic on a connected open set $U\subset\mathbb R^d$, where
$d=1,2,$ or $3$.  If $F$ vanishes on a set of positive Lebesgue measure, it vanishes
identically.  In particular, a real analytic function on
$\mathbb R^2\times(\mathbb R/(2\pi\mathbb Z))$ which vanishes on a set of positive product
measure is identically zero. -/
theorem ext_analytic_zero {d : ℕ} (hd : d = 1 ∨ d = 2 ∨ d = 3)
    {U : Set (EuclideanSpace ℝ (Fin d))}
    (hUo : IsOpen U) (hUc : IsConnected U) {F : EuclideanSpace ℝ (Fin d) → ℝ}
    (hF : AnalyticOnNhd ℝ F U) (hpos : 0 < volume {x ∈ U | F x = 0}) :
    ∀ x ∈ U, F x = 0 := by
  have _ := hd -- the argument works in every dimension
  exact aux_analyticZero_euclidean d U hUo hUc.isPreconnected F hF hpos

/-- **Lemma `ext:analytic-zero`** (functions on `ℝ² × ℝ/(2πℤ)`).
Let $F:U\to\mathbb R$ be real analytic on a connected open set $U\subset\mathbb R^d$, where
$d=1,2,$ or $3$.  If $F$ vanishes on a set of positive Lebesgue measure, it vanishes
identically.  In particular, a real analytic function on
$\mathbb R^2\times(\mathbb R/(2\pi\mathbb Z))$ which vanishes on a set of positive product
measure is identically zero. -/
theorem ext_analytic_zero_config {G : ℝ² × AddCircle (2 * π) → ℝ}
    (hG : AnalyticOnNhd ℝ (fun p : ℝ² × ℝ => G (p.1, (p.2 : AddCircle (2 * π)))) univ)
    (hpos : 0 < ((volume : Measure ℝ²).prod AddCircle.haarAddCircle) {p | G p = 0}) :
    ∀ p, G p = 0 := by
  set H : ℝ² × ℝ → ℝ := fun p => G (p.1, (p.2 : AddCircle (2 * π))) with hHdef
  set Φ : ℝ² × ℝ → ℝ² × AddCircle (2 * π) := Prod.map id (fun t : ℝ => (t : AddCircle (2 * π)))
  have hHΦ : H = G ∘ Φ := rfl
  have hΦq : IsOpenQuotientMap Φ :=
    IsOpenQuotientMap.id.prodMap QuotientAddGroup.isOpenQuotientMap_mk
  have hGc : Continuous G := by
    rw [← hΦq.continuous_comp_iff, ← hHΦ]
    exact continuous_iff_continuousAt.mpr fun p => (hG p trivial).continuousAt
  have hSm : MeasurableSet {p | G p = 0} :=
    (isClosed_eq hGc continuous_const).measurableSet
  have hP := aux_analyticZero_prod (aux_analyticZero_euclidean 2) aux_analyticZero_real
  have hH : ∀ p, H p = 0 := by
    refine fun p => hP univ isOpen_univ isPreconnected_univ H hG ?_ p trivial
    by_contra h0
    rw [not_lt, nonpos_iff_eq_zero] at h0
    have hmp : MeasurePreserving Φ
        ((volume : Measure ℝ²).prod (volume.restrict (Ioc 0 (0 + 2 * π))))
        ((volume : Measure ℝ²).prod (volume : Measure (AddCircle (2 * π)))) :=
      (MeasurePreserving.id volume).prod (AddCircle.measurePreserving_mk (2 * π) 0)
    have h1 : ((volume : Measure ℝ²).prod (volume : Measure (AddCircle (2 * π))))
        {p | G p = 0} = 0 := by
      rw [← hmp.measure_preimage hSm.nullMeasurableSet]
      refine le_antisymm ?_ (zero_le)
      calc _ = ((volume : Measure ℝ²).prod volume).restrict (univ ×ˢ Ioc 0 (0 + 2 * π))
              (Φ ⁻¹' {p | G p = 0}) := by
            rw [← Measure.prod_restrict, Measure.restrict_univ]
        _ ≤ ((volume : Measure ℝ²).prod volume) (Φ ⁻¹' {p | G p = 0}) :=
            Measure.restrict_le_self _
        _ = 0 := by
            rw [← h0, Measure.volume_eq_prod]; congr 1; ext p; simp [hHΦ]
    rw [AddCircle.volume_eq_smul_haarAddCircle, Measure.prod_smul_right, Measure.smul_apply,
      smul_eq_mul, mul_eq_zero] at h1
    rcases h1 with h1 | h1
    · simp at h1; linarith [Real.pi_pos]
    · exact (ne_of_gt hpos) h1
  rintro ⟨x, θ⟩
  induction θ using QuotientAddGroup.induction_on with
  | H t => exact hH (x, t)

end Auto
