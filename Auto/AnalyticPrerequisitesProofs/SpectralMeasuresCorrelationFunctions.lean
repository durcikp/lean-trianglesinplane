If $z\mapsto\eta_z$ is another measurable finite positive kernel, then
$z\mapsto\nu_z\otimes\eta_z$ is a measurable kernel.
These identities also hold for integrable complex functions. -/
theorem ext_kernel_integration_measure {X : Type*} [MeasurableSpace X] (lam : Measure X)
    [SigmaFinite lam] {q : ℕ} {ν : X → Measure (EuclideanSpace ℝ (Fin q))}
    (hν : IsMeasurableKernel ν) :
    ∃ 𝔪 : Measure (X × EuclideanSpace ℝ (Fin q)), SigmaFinite 𝔪 ∧
      (∀ F : X × EuclideanSpace ℝ (Fin q) → ℝ≥0∞, Measurable F →
        ∫⁻ p, F p ∂𝔪 = ∫⁻ z, ∫⁻ ξ, F (z, ξ) ∂(ν z) ∂lam) ∧
      (∀ F : X × EuclideanSpace ℝ (Fin q) → ℂ, Integrable F 𝔪 →
        (∀ᵐ z ∂lam, Integrable (fun ξ => F (z, ξ)) (ν z)) ∧
        Integrable (fun z => ∫ ξ, F (z, ξ) ∂(ν z)) lam ∧
        ∫ p, F p ∂𝔪 = ∫ z, ∫ ξ, F (z, ξ) ∂(ν z) ∂lam) := by
  have := aux_toKernel_isSFiniteKernel hν
  refine ⟨lam ⊗ₘ aux_toKernel hν, aux_compProd_sigmaFinite lam hν, fun F hF => ?_,
    fun F hF => ⟨?_, ?_, ?_⟩⟩
  · exact Measure.lintegral_compProd hF
  · exact ((Measure.integrable_compProd_iff hF.aestronglyMeasurable).1 hF).1
  · exact Integrable.integral_compProd (κ := Kernel.const Unit lam)
      (η := Kernel.prodMkLeft Unit (aux_toKernel hν)) (a := ()) hF
  · exact Measure.integral_compProd hF

/-- **Lemma `ext:kernel-integration`** (products of measurable kernels).
Let $(X,\mathcal A,\lambda)$ be a sigma-finite measure space and let $z\mapsto\nu_z$ be a
measurable kernel on $\mathbb R^q$.  For every nonnegative
$\mathcal A\otimes\mathcal B(\mathbb R^q)$-measurable function $F$, the function
$z\mapsto\int F(z,\xi)\,d\nu_z(\xi)$ is measurable.  There is a sigma-finite measure
$\mathfrak m$ on the product space satisfying
$$\int F\,d\mathfrak m=\int_X\int_{\mathbb R^q}F(z,\xi)\,d\nu_z(\xi)\,d\lambda(z).$$
If $z\mapsto\eta_z$ is another measurable finite positive kernel, then
$z\mapsto\nu_z\otimes\eta_z$ is a measurable kernel.
These identities also hold for integrable complex functions. -/
theorem ext_kernel_integration_prod {X : Type*} [MeasurableSpace X] {q r : ℕ}
    {ν : X → Measure (EuclideanSpace ℝ (Fin q))} {η : X → Measure (EuclideanSpace ℝ (Fin r))}
    (hν : IsMeasurableKernel ν) (hη : IsMeasurableKernel η) :
    IsMeasurableKernel fun z => (ν z).prod (η z) := by
  have := aux_toKernel_isSFiniteKernel hν
  have := aux_toKernel_isSFiniteKernel hη
  refine ⟨fun z => ?_, fun B hB => ?_⟩
  · have := hν.1 z; have := hη.1 z; infer_instance
  · have := Kernel.measurable_coe (aux_toKernel hν ×ₖ aux_toKernel hη) hB
    simp only [Kernel.prod_apply] at this
