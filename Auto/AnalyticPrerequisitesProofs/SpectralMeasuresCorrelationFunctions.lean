/-- Auxiliary (for `ext:pd-integrable`): multiplying a positive-definite function by the character
`exp(-2πi h·ξ)` preserves positive definiteness. -/
theorem aux_pd_modulate {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) (ξ : ℝ²) :
    IsPositiveDefinite fun h => c h * Complex.exp (-(2 * π * ⟪h, ξ⟫_ℝ : ℝ) * Complex.I) := by
  intro N s z
  have h := hc N s fun a => z a * Complex.exp (-(2 * π * ⟪s a, ξ⟫_ℝ : ℝ) * Complex.I)
  convert h using 3 with a _ b _
  have e1 : conj (Complex.exp (-(2 * π * ⟪s b, ξ⟫_ℝ : ℝ) * Complex.I)) =
      Complex.exp ((2 * π * ⟪s b, ξ⟫_ℝ : ℝ) * Complex.I) := by
    rw [← Complex.exp_conj, map_mul, map_neg, Complex.conj_ofReal, Complex.conj_I]
    congr 1; ring
  dsimp only
  rw [map_mul, e1, inner_sub_left]
  have e2 : Complex.exp (-(2 * π * (⟪s a, ξ⟫_ℝ - ⟪s b, ξ⟫_ℝ) : ℝ) * Complex.I) =
      Complex.exp (-(2 * π * ⟪s a, ξ⟫_ℝ : ℝ) * Complex.I) *
        Complex.exp ((2 * π * ⟪s b, ξ⟫_ℝ : ℝ) * Complex.I) := by
    rw [← Complex.exp_add]; congr 1; push_cast; ring
  rw [e2]; ring

/-- Auxiliary (for `ext:pd-integrable`): for continuous positive-definite `d` and `C > 0`, `∫
exp(-|v|²/C) d(v) dv ≥ 0`. -/
theorem aux_pd_gauss_nonneg {d : ℝ² → ℂ} (hd : IsPositiveDefinite d) (hcont : Continuous d)
    {C : ℝ} (hC : 0 < C) : 0 ≤ ∫ v, Complex.exp (-(C⁻¹ : ℝ) * ‖v‖ ^ 2) • d v := by
  have h := aux_pd_gaussKernel_integral_nonneg hd hcont (t := π * C / 2) (by positivity)
  have e : ∀ v : ℝ², Complex.exp (-(C⁻¹ : ℝ) * ‖v‖ ^ 2) • d v =
      ((2 * (π * C / 2) : ℝ) : ℂ) * (d v * gaussKernel (2 * (π * C / 2)) v) := by
    intro v
    unfold gaussKernel
    rw [smul_eq_mul]
    have hpC : (2 * (π * C / 2)) ≠ 0 := by positivity
    push_cast
    have hK : ((2 : ℂ) * (π * C / 2)) ≠ 0 := by exact_mod_cast hpC
    have hCc : (C : ℂ) ≠ 0 := by exact_mod_cast hC.ne'
    have hπ : (π : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
    have hex : (-π * ‖v‖ ^ 2 / (2 * (π * C / 2)) : ℂ) = -(C : ℂ)⁻¹ * ‖v‖ ^ 2 := by
      field_simp
    rw [hex]
    field_simp
  simp_rw [e]
  rw [integral_const_mul]
  exact mul_nonneg (by norm_cast; positivity) h


