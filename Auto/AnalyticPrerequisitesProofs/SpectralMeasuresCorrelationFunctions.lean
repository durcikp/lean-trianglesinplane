/-! ### Positive-definite functions (`ext:pd-definition`) -/

/-- Positive-definite functions on `ℝ²` (`\label{ext:pd-definition}`).
A function $c:\mathbb R^2\to\mathbb C$ is positive definite if
$$\sum_{a,b=1}^N z_a\overline{z_b}\,c(s_a-s_b)\ge0$$
for every finite family $s_a\in\mathbb R^2$, $z_a\in\mathbb C$; the displayed quantity is
required to be real.  (Here `0 ≤ ·` is the order on `ℂ`, which includes being real.) -/
def IsPositiveDefinite (c : ℝ² → ℂ) : Prop :=
  ∀ (N : ℕ) (s : Fin N → ℝ²) (z : Fin N → ℂ), 0 ≤ ∑ a, ∑ b, z a * conj (z b) * c (s a - s b)

/-! ### Integrable positive-definite functions (`ext:pd-integrable`) -/

/-- Auxiliary (for `ext:pd-integrable`, see `ext_pd_integrable_elementary`): the defining
inequality of positive definiteness for the two points `s, 0` with coefficients `z₀, z₁`. -/
theorem aux_pd_two {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) (s : ℝ²) (z₀ z₁ : ℂ) :
    0 ≤ z₀ * conj z₀ * c 0 + z₀ * conj z₁ * c s + z₁ * conj z₀ * c (-s)
      + z₁ * conj z₁ * c 0 := by
  have h := hc 2 ![s, 0] ![z₀, z₁]
  simp only [Fin.sum_univ_two] at h
  simpa [add_assoc] using h

/-- **Lemma `ext:pd-integrable`** (elementary part: `c(0) ≥ 0`, `c(-s) = \overline{c(s)}`,
`|c(s)| ≤ c(0)`).
If $c$ is positive definite, then $c(0)\ge0$, $c(-s)=\overline{c(s)}$, and $|c(s)|\le c(0)$.
If, in addition, $c$ is continuous and integrable, then $\widehat c$ is a nonnegative
integrable function,
$$\int\widehat c(\xi)\,d\xi=c(0),\qquad c(s)=\int\exp(2\pi i s\cdot\xi)\widehat c(\xi)\,d\xi.$$ -/
theorem ext_pd_integrable_elementary {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) :
    0 ≤ c 0 ∧ (∀ s, c (-s) = conj (c s)) ∧ ∀ s, ‖c s‖ ≤ (c 0).re := by
  have h0 : 0 ≤ c 0 := by
    have h := hc 1 ![0] ![1]
    simpa using h
  have h0' := Complex.nonneg_iff.1 h0
  have hsym : ∀ s, c (-s) = conj (c s) := by
    intro s
    have h1 := Complex.nonneg_iff.1 (aux_pd_two hc s 1 1)
    have h2 := Complex.nonneg_iff.1 (aux_pd_two hc s 1 Complex.I)
    apply Complex.ext
    · simp at h1 h2 ⊢; linarith
    · simp at h1 h2 ⊢; linarith
  refine ⟨h0, hsym, fun s => ?_⟩
  by_cases hb : c s = 0
  · simp [hb, h0'.1]
  have h := Complex.nonneg_iff.1 (aux_pd_two hc s (‖c s‖ : ℂ) (-c s))
  rw [hsym s] at h
  have hn : 0 < ‖c s‖ := norm_pos_iff.2 hb
  have key : 0 ≤ ‖c s‖ ^ 2 * (2 * (c 0).re - 2 * ‖c s‖) := by
    have e := h.1
    have hcs : (c s).re ^ 2 + (c s).im ^ 2 = ‖c s‖ ^ 2 := by
      rw [← Complex.normSq_add_mul_I, Complex.normSq_eq_norm_sq] ; simp
    simp [Complex.mul_re, Complex.mul_im, ← h0'.2] at e
    nlinarith [hcs]
  have : 0 ≤ 2 * (c 0).re - 2 * ‖c s‖ := by
    by_contra hneg; rw [not_le] at hneg
    have := mul_neg_of_pos_of_neg (pow_pos hn 2) hneg; linarith
  linarith

/-- Auxiliary (for `ext:pd-integrable`, see `ext_pd_integrable_fourier`): for two distinct
coordinates `a ≠ b` of the product probability space `μ^N`, the integral of `d(x_a - x_b)` is the
double integral `∫∫ d(x - y) dμ dμ` (independence of coordinates). -/
theorem aux_pd_pair_integral {d : ℝ² → ℂ} (hcont : Continuous d) (μ : Measure ℝ²)
    [IsProbabilityMeasure μ] {M : ℝ} (hbd : ∀ s, ‖d s‖ ≤ M) {N : ℕ} {a b : Fin N} (hab : a ≠ b) :
    ∫ x, d (x a - x b) ∂(Measure.pi fun _ : Fin N => μ) = ∫ x, ∫ y, d (x - y) ∂μ ∂μ := by
  set P := Measure.pi fun _ : Fin N => μ
  have hind := (ProbabilityTheory.iIndepFun_pi (μ := fun _ : Fin N => μ)
    (X := fun _ => (id : ℝ² → ℝ²)) (fun _ => measurable_id.aemeasurable)).indepFun hab
  have hmap := (ProbabilityTheory.indepFun_iff_map_prod_eq_prod_map_map
    (measurable_pi_apply a).aemeasurable (measurable_pi_apply b).aemeasurable).1 hind
  have ha : P.map (fun x => x a) = μ := (measurePreserving_eval _ a).map_eq
  have hb : P.map (fun x => x b) = μ := (measurePreserving_eval _ b).map_eq
  rw [ha, hb] at hmap
  have hm : Measurable fun x : Fin N → ℝ² => (x a, x b) :=
    (measurable_pi_apply a).prodMk (measurable_pi_apply b)
  have h1 : ∫ x, d (x a - x b) ∂P = ∫ p, d (p.1 - p.2) ∂(P.map fun x => (x a, x b)) := by
    rw [integral_map hm.aemeasurable]
    exact (hcont.comp continuous_sub).aestronglyMeasurable
  rw [h1, hmap]
  refine integral_prod (fun p : ℝ² × ℝ² => d (p.1 - p.2)) ?_
  exact Integrable.of_bound (hcont.comp continuous_sub).aestronglyMeasurable M
    (ae_of_all _ fun p => hbd _)

/-- Auxiliary (for `ext:pd-integrable`, see `ext_pd_integrable_fourier`): a continuous
positive-definite `d` satisfies `∫∫ d(x - y) dμ(x) dμ(y) ≥ 0` for every probability measure `μ`
(integral form of positive definiteness, obtained by averaging the defining inequality over `N`
independent samples of `μ` and letting `N → ∞`). -/
theorem aux_pd_double_integral_nonneg {d : ℝ² → ℂ} (hd : IsPositiveDefinite d)
    (hcont : Continuous d) (μ : Measure ℝ²) [IsProbabilityMeasure μ] :
    0 ≤ ∫ x, ∫ y, d (x - y) ∂μ ∂μ := by
  obtain ⟨-, -, hbd⟩ := ext_pd_integrable_elementary hd
  set I := ∫ x, ∫ y, d (x - y) ∂μ ∂μ
  have key : ∀ N : ℕ, 0 ≤ (N : ℂ) * d 0 + ((N : ℂ) * N - N) * I := by
    intro N
    set P := Measure.pi fun _ : Fin N => μ
    have hF : ∀ x : Fin N → ℝ², 0 ≤ ∑ a, ∑ b, d (x a - x b) := by
      intro x; simpa using hd N x 1
    have hint : ∀ a b : Fin N, Integrable (fun x : Fin N → ℝ² => d (x a - x b)) P :=
      fun a b => Integrable.of_bound
        (hcont.comp ((continuous_apply a).sub (continuous_apply b))).aestronglyMeasurable _
        (ae_of_all _ fun x => hbd _)
    have h0 : 0 ≤ ∫ x, ∑ a, ∑ b, d (x a - x b) ∂P := by
      have hI : Integrable (fun x : Fin N → ℝ² => ∑ a, ∑ b, d (x a - x b)) P :=
        integrable_finsetSum _ fun a _ => integrable_finsetSum _ fun b _ => hint a b
      have hre := integral_re hI
      have him := integral_im hI
      simp only [RCLike.re_to_complex, RCLike.im_to_complex] at hre him
      rw [Complex.nonneg_iff, ← hre, ← him]
      refine ⟨integral_nonneg fun x => (Complex.nonneg_iff.1 (hF x)).1, ?_⟩
      simp_rw [← (Complex.nonneg_iff.1 (hF _)).2]; simp
    have hsum : ∫ x, ∑ a, ∑ b, d (x a - x b) ∂P = ∑ a : Fin N, ∑ b : Fin N,
        (I + if a = b then d 0 - I else 0) := by
      rw [integral_finsetSum _ fun a _ => integrable_finsetSum _ fun b _ => hint a b]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [integral_finsetSum _ fun b _ => hint a b]
      refine Finset.sum_congr rfl fun b _ => ?_
      by_cases hab : a = b
      · subst hab; simp
      · simp only [hab, if_false, add_zero]; exact aux_pd_pair_integral hcont μ hbd hab
    rw [hsum] at h0
    simp only [Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mem_univ, if_true,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h0
    convert h0 using 1; ring
  have hd0 := (Complex.nonneg_iff.1 (ext_pd_integrable_elementary hd).1)
  have him : I.im = 0 := by
    have := (Complex.nonneg_iff.1 (key 2)).2
    simp [← hd0.2] at this; norm_num at this; linarith
  rw [Complex.nonneg_iff]
  refine ⟨?_, him.symm⟩
  by_contra hneg; rw [not_le] at hneg
  obtain ⟨N, hN⟩ := exists_nat_gt ((d 0).re / (-I.re) + 1)
  have := (Complex.nonneg_iff.1 (key N)).1
  simp only [Complex.add_re, Complex.mul_re, Complex.natCast_re, Complex.natCast_im, zero_mul,
    sub_zero, Complex.sub_re, mul_zero, Complex.sub_im, Complex.mul_im, add_zero, sub_self] at this
  have hN1 : (1 : ℝ) < N := by
    have : 0 ≤ (d 0).re / (-I.re) := div_nonneg hd0.1 (by linarith)
    linarith
  have h2 : (d 0).re / (-I.re) < (N : ℝ) - 1 := by linarith
  rw [div_lt_iff₀ (by linarith)] at h2
  have h3 : 0 ≤ (N : ℝ) * ((d 0).re + ((N : ℝ) - 1) * I.re) := by linarith
  have h4 : (d 0).re + ((N : ℝ) - 1) * I.re < 0 := by linarith
  nlinarith

/-- Auxiliary (for `ext:pd-integrable`): the Gaussian autocorrelation identity `∫ γ_t(x) γ_t(x - h)
dx = γ_{2t}(h)`. -/
theorem aux_gaussKernel_autocorr {t : ℝ} (ht : 0 < t) (h : ℝ²) :
    ∫ x, gaussKernel t x * gaussKernel t (x - h) = gaussKernel (2 * t) h := by
  have e : ∀ x : ℝ², gaussKernel t x * gaussKernel t (x - h) =
      gaussKernel (2 * t) h * gaussKernel (t / 2) (x - (1 / 2 : ℝ) • h) := by
    intro x
    unfold gaussKernel
    have n1 : ‖x - h‖ ^ 2 = ‖x‖ ^ 2 - 2 * ⟪x, h⟫_ℝ + ‖h‖ ^ 2 := norm_sub_sq_real x h
    have n2 : ‖x - (1 / 2 : ℝ) • h‖ ^ 2 = ‖x‖ ^ 2 - ⟪x, h⟫_ℝ + ‖h‖ ^ 2 / 4 := by
      rw [norm_sub_sq_real, inner_smul_right, norm_smul]; norm_num; ring
    rw [n1, n2]
    have : (t / 2)⁻¹ * (2 * t)⁻¹ = t⁻¹ * t⁻¹ := by field_simp
    calc t⁻¹ * rexp (-π * ‖x‖ ^ 2 / t) * (t⁻¹ * rexp (-π * (‖x‖ ^ 2 - 2 * ⟪x, h⟫_ℝ + ‖h‖ ^ 2) / t))
        = (t⁻¹ * t⁻¹) * rexp (-π * ‖x‖ ^ 2 / t + -π * (‖x‖ ^ 2 - 2 * ⟪x, h⟫_ℝ + ‖h‖ ^ 2) / t) := by
          rw [Real.exp_add]; ring
      _ = ((t / 2)⁻¹ * (2 * t)⁻¹) * rexp (-π * ‖h‖ ^ 2 / (2 * t) +
            -π * (‖x‖ ^ 2 - ⟪x, h⟫_ℝ + ‖h‖ ^ 2 / 4) / (t / 2)) := by
          rw [this]; congr 2; field_simp; ring
      _ = _ := by rw [Real.exp_add]; ring
  simp_rw [e]
  rw [integral_const_mul, integral_sub_right_eq_self (fun x => gaussKernel (t / 2) x),
    ext_gaussian_integral (by linarith), mul_one]


