/-- Auxiliary (for `ext:pd-integrable`, see `ext_pd_integrable_fourier`): for continuous
positive-definite `d`, `∫ d(h) γ_{2t}(h) dh ≥ 0` (the integral inequality of the blueprint applied
to a Gaussian). -/
theorem aux_pd_gaussKernel_integral_nonneg {d : ℝ² → ℂ} (hd : IsPositiveDefinite d)
    (hcont : Continuous d) {t : ℝ} (ht : 0 < t) :
    0 ≤ ∫ h, d h * gaussKernel (2 * t) h := by
  obtain ⟨-, -, hbd⟩ := ext_pd_integrable_elementary hd
  set γ := fun x => gaussKernel t x with hγdef
  have hγi : Integrable γ volume := aux_gaussKernel_integrable ht
  have hγc : Continuous γ := aux_gaussKernel_continuous t
  have hγ0 : ∀ x, 0 ≤ γ x := aux_gaussKernel_nonneg t ht
  set P := volume.withDensity (fun x => ENNReal.ofReal (γ x))
  have : IsProbabilityMeasure P := by
    constructor
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
      ← ofReal_integral_eq_lintegral_ofReal hγi (ae_of_all _ hγ0)]
    simp [γ, ext_gaussian_integral ht]
  have hP : ∀ g : ℝ² → ℂ, ∫ x, g x ∂P = ∫ x, (γ x : ℂ) * g x := by
    intro g
    rw [integral_withDensity_eq_integral_toReal_smul (by fun_prop) (ae_of_all _ fun _ =>
      ENNReal.ofReal_lt_top)]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
