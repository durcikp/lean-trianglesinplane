  have hnn := aux_fourier_pd_nonneg hc hcont hint
  set r : ℝ² → ℝ := fun ξ => (𝓕 c ξ).re with hr_def
  have hr : ∀ ξ, 𝓕 c ξ = (r ξ : ℂ) := fun ξ => by
    apply Complex.ext
    · simp [r]
    · simp [r, ← (Complex.nonneg_iff.1 (hnn ξ)).2]
  have hr0 : ∀ ξ, 0 ≤ r ξ := fun ξ => (Complex.nonneg_iff.1 (hnn ξ)).1
  have hFc := aux_fourier_continuous hint
  have hrc : Continuous r := Complex.continuous_re.comp hFc
  set B := ∫ x, ‖c x‖
  have hrB : ∀ ξ, r ξ ≤ B := fun ξ => by
    have := aux_norm_fourier_le (f := c) ξ
    rw [hr, Complex.norm_real, Real.norm_eq_abs] at this
    exact (le_abs_self _).trans this
  have hγr : ∀ t, 0 < t → Integrable (fun w => gaussKernel t w * r w) volume := fun t ht =>
    ((aux_gaussKernel_integrable ht).mul_const B).mono'
      ((aux_gaussKernel_continuous t).mul hrc).aestronglyMeasurable
      (ae_of_all _ fun w => by
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (aux_gaussKernel_nonneg t ht w) (hr0 w))]
        exact mul_le_mul_of_nonneg_left (hrB w) (aux_gaussKernel_nonneg t ht w))
  have key : ∀ t : ℝ, 0 < t → t * ∫ w, gaussKernel t w * r w ≤ (c 0).re := by
    intro t ht
    have hg : Integrable (fun w => (gaussKernel t w : ℂ)) volume :=
      (aux_gaussKernel_integrable ht).ofReal
    have hsw := aux_fourier_swap (g := fun w => (gaussKernel t w : ℂ)) hint hg
    rw [show 𝓕 (fun w => (gaussKernel t w : ℂ)) = fun ξ => Complex.exp (-(π * t * ‖ξ‖ ^ 2 : ℝ))
      from funext (ext_gaussian_fourier ht)] at hsw
    simp_rw [hr] at hsw
    have e : ∫ w, (gaussKernel t w : ℂ) * (r w : ℂ) = ((∫ w, gaussKernel t w * r w : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]; push_cast; rfl
    rw [e] at hsw
    have hti : Integrable (fun w => t⁻¹ * gaussKernel t⁻¹ w * (c 0).re) volume :=
      ((aux_gaussKernel_integrable (inv_pos.2 ht)).const_mul _).mul_const _
    have hb : ‖∫ w, Complex.exp (-(π * t * ‖w‖ ^ 2 : ℝ)) * c w‖ ≤ t⁻¹ * (c 0).re := by
      calc _ ≤ ∫ w, ‖Complex.exp (-(π * t * ‖w‖ ^ 2 : ℝ)) * c w‖ := norm_integral_le_integral_norm _
        _ ≤ ∫ w, t⁻¹ * gaussKernel t⁻¹ w * (c 0).re := by
          refine integral_mono_of_nonneg (ae_of_all _ fun w => norm_nonneg _) hti
            (ae_of_all _ fun w => ?_)
          dsimp only
          rw [norm_mul, ← Complex.ofReal_neg, ← Complex.ofReal_exp, Complex.norm_real,
            Real.norm_eq_abs,
            abs_of_nonneg (Real.exp_pos _).le]
          have : Real.exp (-(π * t * ‖w‖ ^ 2)) = t⁻¹ * gaussKernel t⁻¹ w := by
            unfold gaussKernel; rw [inv_inv, ← mul_assoc, inv_mul_cancel₀ ht.ne', one_mul]
            congr 1; field_simp
          rw [this]
          exact mul_le_mul_of_nonneg_left (hbd w) (by
            have := aux_gaussKernel_nonneg t⁻¹ (inv_pos.2 ht) w; positivity)
        _ = t⁻¹ * (c 0).re := by
          rw [integral_mul_const, integral_const_mul, ext_gaussian_integral (inv_pos.2 ht),
            mul_one]
    rw [hsw, Complex.norm_real, Real.norm_eq_abs] at hb
    have := (le_abs_self _).trans hb
    calc t * ∫ w, gaussKernel t w * r w ≤ t * (t⁻¹ * (c 0).re) :=
          mul_le_mul_of_nonneg_left this ht.le
      _ = (c 0).re := by field_simp
  -- Fatou
  set f : ℕ → ℝ² → ℝ≥0∞ := fun n w =>
    ENNReal.ofReal (((n : ℝ) + 1) * (gaussKernel ((n : ℝ) + 1) w * r w)) with hf_def
  have hfm : ∀ n, Measurable (f n) := fun n => by
    refine ENNReal.measurable_ofReal.comp ?_
    exact (continuous_const.mul ((aux_gaussKernel_continuous _).mul hrc)).measurable
  have hfl : ∀ w, Tendsto (fun n => f n w) atTop (𝓝 (ENNReal.ofReal (r w))) := by
    intro w
    refine ENNReal.tendsto_ofReal ?_
    have e : ∀ n : ℕ, ((n : ℝ) + 1) * (gaussKernel ((n : ℝ) + 1) w * r w) =
        Real.exp (-π * ‖w‖ ^ 2 * ((n : ℝ) + 1)⁻¹) * r w := by
      intro n; unfold gaussKernel
      have : ((n : ℝ) + 1) ≠ 0 := by positivity
      field_simp
    simp_rw [e]
    conv => rhs; rw [← one_mul (r w)]
    refine Tendsto.mul_const _ ?_
    rw [show (1 : ℝ) = Real.exp (-π * ‖w‖ ^ 2 * 0) by simp]
    refine (Real.continuous_exp.tendsto _).comp (Tendsto.const_mul _ ?_)
    exact tendsto_inv_atTop_zero.comp (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds)
  have hfi : ∀ n, ∫⁻ w, f n w ≤ ENNReal.ofReal (c 0).re := by
    intro n
    have ht : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    rw [hf_def]
    simp only
    rw [← ofReal_integral_eq_lintegral_ofReal ((hγr _ ht).const_mul _)
      (ae_of_all _ fun w => mul_nonneg ht.le (mul_nonneg (aux_gaussKernel_nonneg _ ht w) (hr0 w))),
      integral_const_mul]
    exact ENNReal.ofReal_le_ofReal (key _ ht)
  have hfat := lintegral_liminf_le (μ := (volume : Measure ℝ²)) (u := atTop) hfm
  have hlim : ∫⁻ w, ENNReal.ofReal (r w) ≤ ENNReal.ofReal (c 0).re := by
    calc ∫⁻ w, ENNReal.ofReal (r w) = ∫⁻ w, liminf (fun n => f n w) atTop := by
          congr 1; funext w; exact (hfl w).liminf_eq.symm
      _ ≤ _ := hfat
      _ ≤ _ := liminf_le_of_frequently_le' (Frequently.of_forall hfi)
  refine ⟨hFc.aestronglyMeasurable, ?_⟩
  rw [HasFiniteIntegral]
  calc ∫⁻ w, ‖𝓕 c w‖ₑ = ∫⁻ w, ENNReal.ofReal (r w) := by
        congr 1; funext w
        rw [hr, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hr0 w)]
    _ ≤ _ := hlim
    _ < ⊤ := ENNReal.ofReal_lt_top

/-- **Lemma `ext:pd-integrable`** (Fourier part, for continuous integrable `c`).
If $c$ is positive definite, then $c(0)\ge0$, $c(-s)=\overline{c(s)}$, and $|c(s)|\le c(0)$.
If, in addition, $c$ is continuous and integrable, then $\widehat c$ is a nonnegative
integrable function,
$$\int\widehat c(\xi)\,d\xi=c(0),\qquad c(s)=\int\exp(2\pi i s\cdot\xi)\widehat c(\xi)\,d\xi.$$ -/
theorem ext_pd_integrable_fourier {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) (hcont : Continuous c)
    (hint : Integrable c volume) :
    (∀ ξ, 0 ≤ 𝓕 c ξ) ∧ Integrable (𝓕 c) volume ∧ ∫ ξ, 𝓕 c ξ = c 0 ∧
      ∀ s, c s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) * 𝓕 c ξ := by
  have hF := aux_fourier_pd_integrable hc hcont hint
  have hinv : ∀ s, c s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) * 𝓕 c ξ := by
    intro s
    rw [← hint.fourierInv_fourier_eq hF hcont.continuousAt, aux_fourierInv_convention]
    simp_rw [mul_comm]
  refine ⟨aux_fourier_pd_nonneg hc hcont hint, hF, ?_, hinv⟩
  rw [hinv 0]; simp

/-! ### Uniformly tight measures (`ext:tight-measures`) -/

/-- **Lemma `ext:tight-measures`**.
Let $\nu_n$ be positive Borel measures on $\mathbb R^2$ with the same finite mass $m$, and
suppose $$\lim_{A\to\infty}\sup_n\nu_n(\{x:|x|>A\})=0.$$
There are a subsequence and a positive Borel measure $\nu$ of mass $m$ such that
$$\int g\,d\nu_n\longrightarrow\int g\,d\nu$$
for every bounded continuous function $g$ on $\mathbb R^2$. -/
theorem ext_tight_measures (ν : ℕ → Measure ℝ²) (m : ℝ≥0∞) (hm : m ≠ ⊤)
    (hν : ∀ n, ν n univ = m)
    (htight : Tendsto (fun A : ℝ => ⨆ n, ν n {x | A < ‖x‖}) atTop (𝓝 0)) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ ν₀ : Measure ℝ², ν₀ univ = m ∧
      ∀ g : ℝ² →ᵇ ℂ, Tendsto (fun n => ∫ x, g x ∂(ν (φ n))) atTop (𝓝 (∫ x, g x ∂ν₀)) := by
  by_cases hm0 : m = 0
  · refine ⟨id, strictMono_id, 0, by simp [hm0], fun g => ?_⟩
    have : ∀ n, ν n = 0 := fun n => Measure.measure_univ_eq_zero.1 (by rw [hν n, hm0])
    simp [this]
  have hfin : ∀ n, IsFiniteMeasure (ν n) := fun n => ⟨by rw [hν n]; exact hm.lt_top⟩
  have hprob : ∀ n, IsProbabilityMeasure (m⁻¹ • ν n) := fun n => ⟨by
    rw [Measure.smul_apply, hν n, smul_eq_mul, ENNReal.inv_mul_cancel hm0 hm]⟩
  let μ : ℕ → ProbabilityMeasure ℝ² := fun n => ⟨m⁻¹ • ν n, hprob n⟩
  have hνμ : ∀ n, ν n = m • (μ n : Measure ℝ²) := fun n => by
    simp only [μ, ProbabilityMeasure.coe_mk, smul_smul, ENNReal.mul_inv_cancel hm0 hm, one_smul]
  have htS : IsTightMeasureSet {x | ∃ μ' ∈ range μ, (μ' : Measure ℝ²) = x} := by
    apply isTightMeasureSet_of_tendsto_measure_norm_gt
    have : (fun r : ℝ => ⨆ μ' ∈ {x | ∃ μ' ∈ range μ, (μ' : Measure ℝ²) = x}, μ' {x | r < ‖x‖})
        = fun r => m⁻¹ * ⨆ n, ν n {x | r < ‖x‖} := by
      funext r
      rw [ENNReal.mul_iSup]
      apply le_antisymm
      · refine iSup₂_le fun μ' hμ' => ?_
        obtain ⟨_, ⟨n, rfl⟩, rfl⟩ := hμ'
        exact le_iSup_of_le n (le_of_eq rfl)
      · refine iSup_le fun n => ?_
        exact le_iSup₂_of_le (μ n : Measure ℝ²) ⟨μ n, ⟨n, rfl⟩, rfl⟩ (le_of_eq rfl)
    rw [this]
    have := ENNReal.Tendsto.const_mul htight (Or.inr (ENNReal.inv_ne_top.2 hm0))
    simpa using this
  have hcomp := isCompact_closure_of_isTightMeasureSet (S := range μ) htS
  obtain ⟨P, -, φ, hφ, hlim⟩ := hcomp.tendsto_subseq (fun n => subset_closure ⟨n, rfl⟩)
  refine ⟨φ, hφ, m • (P : Measure ℝ²), ?_, fun g => ?_⟩
  · simp [Measure.smul_apply]
  have h := (ProbabilityMeasure.tendsto_iff_forall_integral_rclike_tendsto ℂ).1 hlim g
  rw [integral_smul_measure]
  simp_rw [hνμ, integral_smul_measure]
  exact h.const_smul _

/-! ### Spectral representation (`ext:bochner`) -/

/-- Auxiliary: the integral of a function with values in the nonnegative reals `0 ≤ z` of `ℂ`
(complex order) is nonnegative. -/
theorem aux_integral_cnonneg {α : Type*} [MeasurableSpace α] {μ : Measure α} {f : α → ℂ}
    (h : ∀ x, 0 ≤ f x) : 0 ≤ ∫ x, f x ∂μ := by
  by_cases hf : Integrable f μ
  · have hre := integral_re hf
    have him := integral_im hf
    simp only [RCLike.re_to_complex, RCLike.im_to_complex] at hre him
    rw [Complex.nonneg_iff, ← hre, ← him]
    refine ⟨integral_nonneg fun x => (Complex.nonneg_iff.1 (h x)).1, ?_⟩
    simp_rw [← (Complex.nonneg_iff.1 (h _)).2]; simp
  · rw [integral_undef hf]

/-- Auxiliary (uniqueness part of `ext:bochner`, see `ext_bochner`): two finite measures on `ℝ²`
with the same integrals against all characters `exp(2πi s·ξ)` coincide (Mathlib's
`Measure.ext_of_charFun`). -/
theorem aux_measure_ext_of_fourier {ν₁ ν₂ : Measure ℝ²} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : ∀ s, ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂ν₁ =
      ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂ν₂) : ν₁ = ν₂ := by
  apply Measure.ext_of_charFun
  funext t
  have e : ∀ x : ℝ², (⟪x, t⟫_ℝ : ℂ) = ((2 * π * ⟪(2 * π)⁻¹ • t, x⟫_ℝ : ℝ) : ℂ) := by
    intro x
    rw [real_inner_smul_left, real_inner_comm, ← mul_assoc, mul_inv_cancel₀ (by positivity),
      one_mul]
  simp only [charFun_apply, e]
  exact h _

/-- Auxiliary (for `ext:bochner`, see `ext_bochner`): `c(s) exp(-π t |s|²)` is positive definite
when `c` is (the Gaussian is an average of characters against the positive density `γ_t`). -/
theorem aux_pd_mul_gauss {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) {t : ℝ} (ht : 0 < t) :
    IsPositiveDefinite fun s => c s * Complex.exp (-(π * t * ‖s‖ ^ 2 : ℝ)) := by
  intro N s z
  set Q : ℝ² → ℂ := fun x => ∑ a, ∑ b, z a * conj (z b) *
    (c (s a - s b) * Complex.exp (-(2 * π * ⟪s a - s b, x⟫_ℝ : ℝ) * Complex.I))
  have hE : ∀ a b, Integrable (fun x : ℝ² => (gaussKernel t x : ℂ) * (z a * conj (z b) *
      (c (s a - s b) * Complex.exp (-(2 * π * ⟪s a - s b, x⟫_ℝ : ℝ) * Complex.I)))) volume :=
    fun a b => by
      refine ((aux_gaussKernel_integrable ht).mul_const ‖z a * conj (z b) * c (s a - s b)‖).mono'
        ?_ (ae_of_all _ fun x => ?_)
      · exact ((Complex.continuous_ofReal.comp (aux_gaussKernel_continuous t)).mul
          (continuous_const.mul (continuous_const.mul (by fun_prop)))).aestronglyMeasurable
      · simp only [norm_mul, ← Complex.ofReal_neg, Complex.norm_exp_ofReal_mul_I, mul_one,
          Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (aux_gaussKernel_nonneg t ht x)]
        exact le_refl _
  have key : ∀ a b, z a * conj (z b) * (c (s a - s b) *
      Complex.exp (-(π * t * ‖s a - s b‖ ^ 2 : ℝ))) = ∫ x, (gaussKernel t x : ℂ) * (z a *
      conj (z b) * (c (s a - s b) * Complex.exp (-(2 * π * ⟪s a - s b, x⟫_ℝ : ℝ) *
        Complex.I))) := by
    intro a b
    have hg := ext_gaussian_fourier ht (s a - s b)
    rw [aux_fourier_convention] at hg
    rw [← hg, ← integral_const_mul, ← integral_const_mul]
    congr 1; funext x
    rw [real_inner_comm x]
    ring
  have hsum : ∑ a, ∑ b, z a * conj (z b) * (c (s a - s b) *
      Complex.exp (-(π * t * ‖s a - s b‖ ^ 2 : ℝ))) = ∫ x, (gaussKernel t x : ℂ) * Q x := by
    simp_rw [key, Q, Finset.mul_sum]
    rw [integral_finsetSum _ fun a _ => integrable_finsetSum _ fun b _ => hE a b]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [integral_finsetSum _ fun b _ => hE a b]
  simp only
  rw [hsum]
  refine aux_integral_cnonneg fun x => mul_nonneg ?_ (aux_pd_modulate hc x N s z)
  exact_mod_cast aux_gaussKernel_nonneg t ht x


/-- Auxiliary (tightness in `ext:bochner`, see `ext_bochner`): for a bounded continuous real `h`, `∫
γ_t h → h(0)` as `t ↓ 0` (proved directly by scaling and dominated convergence). -/
theorem aux_gauss_average_tendsto {h : ℝ² → ℝ} (hc : Continuous h) {B : ℝ}
    (hb : ∀ w, |h w| ≤ B) :
    Tendsto (fun t => ∫ w, gaussKernel t w * h w) (𝓝[>] 0) (𝓝 (h 0)) := by
  have e : ∀ t, 0 < t → ∫ w, gaussKernel t w * h w =
      ∫ u, gaussKernel 1 u * h (Real.sqrt t • u) := by
    intro t ht
    have := Measure.integral_comp_smul (μ := volume) (fun w : ℝ² => gaussKernel t w * h w)
      (Real.sqrt t)
    simp only [finrank_euclideanSpace_fin] at this
    have hs : Real.sqrt t ^ 2 = t := Real.sq_sqrt ht.le
    rw [hs, abs_of_pos (inv_pos.2 ht), smul_eq_mul] at this
    have e2 : ∀ u : ℝ², gaussKernel t (Real.sqrt t • u) = t⁻¹ * gaussKernel 1 u := by
      intro u; unfold gaussKernel
      rw [norm_smul, mul_pow, Real.norm_eq_abs, sq_abs, hs]
      congr 2
      field_simp
    simp_rw [e2, mul_assoc, integral_const_mul] at this
    exact (mul_left_cancel₀ (inv_ne_zero ht.ne') this).symm
  have hlim : Tendsto (fun t => ∫ u, gaussKernel 1 u * h (Real.sqrt t • u)) (𝓝[>] 0)
      (𝓝 (∫ u, gaussKernel 1 u * h 0)) := by
    refine tendsto_integral_filter_of_dominated_convergence (fun u => gaussKernel 1 u * B)
      (Eventually.of_forall fun t => ?_) (Eventually.of_forall fun t => ?_)
      ((aux_gaussKernel_integrable one_pos).mul_const B) (ae_of_all _ fun u => ?_)
    · have : Continuous fun u : ℝ² => gaussKernel 1 u * h (Real.sqrt t • u) :=
        (aux_gaussKernel_continuous 1).mul (hc.comp (continuous_const_smul _))
      exact this.aestronglyMeasurable
    · refine ae_of_all _ fun u => ?_
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (aux_gaussKernel_nonneg 1 one_pos u)]
      exact mul_le_mul_of_nonneg_left (hb _) (aux_gaussKernel_nonneg 1 one_pos u)
    · refine tendsto_const_nhds.mul ((hc.tendsto 0).comp ?_)
      have h1 : Tendsto (fun t : ℝ => Real.sqrt t) (𝓝[>] 0) (𝓝 0) := by
        have := (Real.continuous_sqrt.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi 0))
        simpa using this
      simpa using h1.smul_const u
  rw [integral_mul_const, ext_gaussian_integral one_pos, one_mul] at hlim
  exact hlim.congr' (eventually_nhdsWithin_of_forall fun t ht => (e t ht).symm)


/-- Auxiliary (for `ext:bochner`): `𝓕(𝓕 f)(w) = f(-w)` for continuous integrable positive-definite
`f` (via `ext_pd_integrable_fourier` and Fourier inversion). -/
theorem aux_fourier_fourier_pd {f : ℝ² → ℂ} (hc : IsPositiveDefinite f) (hcont : Continuous f)
    (hint : Integrable f volume) (w : ℝ²) : 𝓕 (𝓕 f) w = f (-w) := by
  have hF := (ext_pd_integrable_fourier hc hcont hint).2.1
  rw [← hint.fourierInv_fourier_eq hF hcont.continuousAt, Real.fourierInv_eq_fourier_neg, neg_neg]

/-- Auxiliary (tightness in `ext:bochner`, see `ext_bochner`): the Gaussian identity `∫ (1 - exp(-π
τ|ξ|²)) f̂(ξ) dξ = ∫ γ_τ(w) (f(0) - Re f(-w)) dw` for continuous integrable positive-definite `f`.
-/
theorem aux_tail_identity {f : ℝ² → ℂ} (hc : IsPositiveDefinite f) (hcont : Continuous f)
    (hint : Integrable f volume) {τ : ℝ} (hτ : 0 < τ) :
    ∫ ξ, (1 - Real.exp (-(π * τ * ‖ξ‖ ^ 2))) * (𝓕 f ξ).re =
      ∫ w, gaussKernel τ w * ((f 0).re - (f (-w)).re) := by
  obtain ⟨hnn, hF, hmass, -⟩ := ext_pd_integrable_fourier hc hcont hint
  obtain ⟨-, -, hbd⟩ := ext_pd_integrable_elementary hc
  have hFc := aux_fourier_continuous hint
  have hγ : Integrable (fun w => (gaussKernel τ w : ℂ)) volume :=
    (aux_gaussKernel_integrable hτ).ofReal
  have hsw := aux_fourier_swap (g := fun w => (gaussKernel τ w : ℂ)) hF hγ
  rw [show 𝓕 (fun w => (gaussKernel τ w : ℂ)) = fun ξ => Complex.exp (-(π * τ * ‖ξ‖ ^ 2 : ℝ))
    from funext (ext_gaussian_fourier hτ)] at hsw
  simp_rw [aux_fourier_fourier_pd hc hcont hint] at hsw
  simp_rw [← Complex.ofReal_neg, ← Complex.ofReal_exp] at hsw
  have hre := congrArg Complex.re hsw
  have hi1 : Integrable (fun ξ => (Real.exp (-(π * τ * ‖ξ‖ ^ 2)) : ℂ) * 𝓕 f ξ) volume :=
    hF.norm.mono' (by fun_prop) (ae_of_all _ fun ξ => by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Real.exp_pos _).le]
      exact mul_le_of_le_one_left (norm_nonneg _) (Real.exp_le_one_iff.2 (by
        have : 0 ≤ π * τ * ‖ξ‖ ^ 2 := by positivity
        linarith)))
  have hi2 : Integrable (fun w => (gaussKernel τ w : ℂ) * f (-w)) volume :=
    ((aux_gaussKernel_integrable hτ).mul_const (f 0).re).mono'
      ((Complex.continuous_ofReal.comp (aux_gaussKernel_continuous τ)).mul
        (hcont.comp continuous_neg)).aestronglyMeasurable
      (ae_of_all _ fun w => by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (aux_gaussKernel_nonneg τ hτ w)]
        exact mul_le_mul_of_nonneg_left (hbd _) (aux_gaussKernel_nonneg τ hτ w))
  have h1 := integral_re hi1
  have h2 := integral_re hi2
  simp only [RCLike.re_to_complex, Complex.re_ofReal_mul] at h1 h2
  rw [← h1, ← h2] at hre
  have hr1 : Integrable (fun ξ => (𝓕 f ξ).re) volume := hF.re
  have hr2 : Integrable (fun ξ => Real.exp (-(π * τ * ‖ξ‖ ^ 2)) * (𝓕 f ξ).re) volume := by
    have := hi1.re
    simp only [RCLike.re_to_complex, Complex.re_ofReal_mul] at this
    exact this
  have hg2 : Integrable (fun w => gaussKernel τ w * (f (-w)).re) volume := by
    have := hi2.re; simpa [Complex.re_ofReal_mul] using this
  simp_rw [sub_mul, one_mul, mul_sub]
  rw [integral_sub hr1 hr2, integral_sub ((aux_gaussKernel_integrable hτ).mul_const _) hg2,
    integral_mul_const, ext_gaussian_integral hτ, one_mul, hre]
  congr 1
  rw [← hmass]
  exact integral_re hF


/-- Auxiliary: `exp(-π t |s|²) = t⁻¹ γ_{1/t}(s)`. -/
theorem aux_exp_eq_gaussKernel {t : ℝ} (ht : 0 < t) (s : ℝ²) :
    Real.exp (-(π * t * ‖s‖ ^ 2)) = t⁻¹ * gaussKernel t⁻¹ s := by
  unfold gaussKernel; rw [inv_inv, ← mul_assoc, inv_mul_cancel₀ ht.ne', one_mul]
  congr 1; field_simp

/-- Auxiliary (tightness in `ext:bochner`, see `ext_bochner`): the pointwise bound `c(0) - Re
c_t(-w) ≤ min(2c(0), L|w| + c(0)π|w|²)` for the Gaussian regularization `c_t` (`0 < t ≤ 1`) of a
Lipschitz positive-definite `c`. -/
theorem aux_bochner_pointwise {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) {L : ℝ≥0}
    (hL : LipschitzWith L c) {t : ℝ} (ht0 : 0 < t) (ht1 : t ≤ 1) (w : ℝ²) :
    (c 0).re - (c (-w) * Complex.exp (-(π * t * ‖-w‖ ^ 2 : ℝ))).re ≤
      min (2 * (c 0).re) (L * ‖w‖ + (c 0).re * π * ‖w‖ ^ 2) := by
  obtain ⟨-, -, hbd⟩ := ext_pd_integrable_elementary hc
  set E := Real.exp (-(π * t * ‖w‖ ^ 2))
  have hE0 : 0 < E := Real.exp_pos _
  have hE1 : E ≤ 1 := Real.exp_le_one_iff.2 (by
    have : 0 ≤ π * t * ‖w‖ ^ 2 := by positivity
    linarith)
  have hEx : 1 - E ≤ π * ‖w‖ ^ 2 := by
    have := Real.add_one_le_exp (-(π * t * ‖w‖ ^ 2))
    have h2 : π * t * ‖w‖ ^ 2 ≤ π * ‖w‖ ^ 2 := by
      have := mul_le_mul_of_nonneg_left ht1 (by positivity : (0 : ℝ) ≤ π * ‖w‖ ^ 2)
      nlinarith
    simp only [E]; linarith
  have hexp : Complex.exp (-(π * t * ‖-w‖ ^ 2 : ℝ)) = (E : ℂ) := by
    rw [norm_neg, ← Complex.ofReal_neg, ← Complex.ofReal_exp]
  rw [hexp, Complex.re_mul_ofReal]
  have hcw := hbd (-w)
  have hre_le : |(c (-w)).re| ≤ ‖c (-w)‖ := Complex.abs_re_le_norm _
  refine le_min ?_ ?_
  · have : -( (c (-w)).re * E) ≤ (c 0).re := by
      have : |(c (-w)).re * E| ≤ (c 0).re := by
        rw [abs_mul, abs_of_pos hE0]
        calc |(c (-w)).re| * E ≤ |(c (-w)).re| * 1 := by gcongr
          _ ≤ (c 0).re := by linarith
      linarith [neg_abs_le ((c (-w)).re * E)]
    linarith
  · have hlip : ‖c 0 - c (-w)‖ ≤ L * ‖w‖ := by
      have := hL.dist_le_mul 0 (-w)
      rwa [dist_eq_norm, dist_eq_norm, zero_sub, neg_neg] at this
    have h1 : (c 0).re - (c (-w)).re ≤ L * ‖w‖ := by
      have := Complex.re_le_norm (c 0 - c (-w))
      rw [Complex.sub_re] at this; linarith
    have h2 : (c (-w)).re - (c (-w)).re * E ≤ (c 0).re * π * ‖w‖ ^ 2 := by
      have : (c (-w)).re - (c (-w)).re * E = (c (-w)).re * (1 - E) := by ring
      rw [this]
      calc (c (-w)).re * (1 - E) ≤ |(c (-w)).re| * (1 - E) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith)
        _ ≤ (c 0).re * (π * ‖w‖ ^ 2) := by
            apply mul_le_mul (by linarith) hEx (by linarith) (by linarith [abs_nonneg (c (-w)).re])
        _ = _ := by ring
    linarith


/-- Auxiliary (for `ext:bochner`, see `ext_bochner`): the regularized spectral measure `ν_t = (c_t)^
dξ` of `c_t(s) = c(s) exp(-π t|s|²)` (`0 < t ≤ 1`): it has mass `c(0)`, characteristic function
`c_t`, and a tail bound uniform in `t`. -/
theorem aux_bochner_reg {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) {L : ℝ≥0}
    (hL : LipschitzWith L c) {t : ℝ} (ht0 : 0 < t) (ht1 : t ≤ 1) :
    ∃ ν : Measure ℝ², IsFiniteMeasure ν ∧ ν univ = ENNReal.ofReal (c 0).re ∧
      (∀ s, ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂ν =
        c s * Complex.exp (-(π * t * ‖s‖ ^ 2 : ℝ))) ∧
      ∀ τ : ℝ, 0 < τ → ∀ A : ℝ, 0 ≤ A → 1 ≤ τ * A ^ 2 →
        ν {ξ | A < ‖ξ‖} ≤ ENNReal.ofReal ((1 - Real.exp (-π))⁻¹ *
          ∫ w, gaussKernel τ w * min (2 * (c 0).re) (L * ‖w‖ + (c 0).re * π * ‖w‖ ^ 2)) := by
  obtain ⟨h0, -, hbd⟩ := ext_pd_integrable_elementary hc
  have hm0 : 0 ≤ (c 0).re := (Complex.nonneg_iff.1 h0).1
  set ct : ℝ² → ℂ := fun s => c s * Complex.exp (-(π * t * ‖s‖ ^ 2 : ℝ)) with hct
  have hcc : Continuous c := hL.continuous
  have hctc : Continuous ct := hcc.mul (by fun_prop)
  have hctpd : IsPositiveDefinite ct := aux_pd_mul_gauss hc ht0
  have hcti : Integrable ct volume := by
    have : Integrable (fun s : ℝ² => t⁻¹ * gaussKernel t⁻¹ s * (c 0).re) volume :=
      ((aux_gaussKernel_integrable (inv_pos.2 ht0)).const_mul _).mul_const _
    refine this.mono' hctc.aestronglyMeasurable (ae_of_all _ fun s => ?_)
    simp only [ct]
    rw [norm_mul, ← Complex.ofReal_neg, ← Complex.ofReal_exp, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), aux_exp_eq_gaussKernel ht0, mul_comm]
    exact mul_le_mul_of_nonneg_left (hbd s)
      (mul_nonneg (inv_pos.2 ht0).le (aux_gaussKernel_nonneg _ (inv_pos.2 ht0) s))
  obtain ⟨hnn, hF, hmass, hinv⟩ := ext_pd_integrable_fourier hctpd hctc hcti
  set r : ℝ² → ℝ := fun ξ => (𝓕 ct ξ).re with hr_def
  have hr : ∀ ξ, 𝓕 ct ξ = (r ξ : ℂ) := fun ξ => by
    apply Complex.ext
    · simp [r]
    · simp [r, ← (Complex.nonneg_iff.1 (hnn ξ)).2]
  have hr0 : ∀ ξ, 0 ≤ r ξ := fun ξ => (Complex.nonneg_iff.1 (hnn ξ)).1
  have hri : Integrable r volume := hF.re
  have hrc : Continuous r := Complex.continuous_re.comp (aux_fourier_continuous hcti)
  have hct0 : ct 0 = c 0 := by simp [ct]
  set ν := volume.withDensity (fun ξ => ENNReal.ofReal (r ξ)) with hν_def
  have hνuniv : ν univ = ENNReal.ofReal (c 0).re := by
    rw [hν_def, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
      ← ofReal_integral_eq_lintegral_ofReal hri (ae_of_all _ hr0)]
    congr 1
    have := integral_re hF
    simp only [RCLike.re_to_complex] at this
    rw [hr_def, this, hmass, hct0]
  have hfin : IsFiniteMeasure ν := ⟨by rw [hνuniv]; exact ENNReal.ofReal_lt_top⟩
  have hint_ν : ∀ g : ℝ² → ℂ, ∫ ξ, g ξ ∂ν = ∫ ξ, 𝓕 ct ξ * g ξ := by
    intro g
    rw [hν_def, integral_withDensity_eq_integral_toReal_smul
      hrc.measurable.ennreal_ofReal
      (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
    refine integral_congr_ae (ae_of_all _ fun ξ => ?_)
    simp only [ENNReal.toReal_ofReal (hr0 ξ), Complex.real_smul, hr]
  refine ⟨ν, hfin, hνuniv, fun s => ?_, fun τ hτ A hA0 hA => ?_⟩
  · rw [hint_ν, show c s * Complex.exp (-(π * t * ‖s‖ ^ 2 : ℝ)) = ct s from rfl, hinv s]
    simp_rw [mul_comm]
  have hK : 0 < 1 - Real.exp (-π) := by
    have := Real.exp_lt_exp.2 (neg_neg_of_pos pi_pos)
    rw [Real.exp_zero] at this; linarith
  set K := (1 - Real.exp (-π))⁻¹ with hK_def
  have hK0 : 0 < K := inv_pos.2 hK
  set H : ℝ² → ℝ := fun w => min (2 * (c 0).re) (L * ‖w‖ + (c 0).re * π * ‖w‖ ^ 2) with hH
  have hS : MeasurableSet {ξ : ℝ² | A < ‖ξ‖} := measurableSet_lt measurable_const measurable_norm
  have he : ∀ ξ : ℝ², 0 ≤ 1 - Real.exp (-(π * τ * ‖ξ‖ ^ 2)) ∧
      1 - Real.exp (-(π * τ * ‖ξ‖ ^ 2)) ≤ 1 := fun ξ => by
    constructor
    · have : Real.exp (-(π * τ * ‖ξ‖ ^ 2)) ≤ 1 := Real.exp_le_one_iff.2 (by
        have : 0 ≤ π * τ * ‖ξ‖ ^ 2 := by positivity
        linarith)
      linarith
    · linarith [Real.exp_pos (-(π * τ * ‖ξ‖ ^ 2))]
  have hi : Integrable (fun ξ => K * ((1 - Real.exp (-(π * τ * ‖ξ‖ ^ 2))) * r ξ)) volume := by
    refine (hri.mono' (by fun_prop) (ae_of_all _ fun ξ => ?_)).const_mul K
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (he ξ).1, abs_of_nonneg (hr0 ξ)]
    exact mul_le_of_le_one_left (hr0 ξ) (he ξ).2
  have step1 : ν {ξ | A < ‖ξ‖} ≤
      ∫⁻ ξ, ENNReal.ofReal (K * ((1 - Real.exp (-(π * τ * ‖ξ‖ ^ 2))) * r ξ)) := by
    rw [hν_def, withDensity_apply _ hS, ← lintegral_indicator hS]
    refine lintegral_mono fun ξ => ?_
    by_cases hξ : A < ‖ξ‖
    · rw [indicator_of_mem (show ξ ∈ {ξ : ℝ² | A < ‖ξ‖} from hξ)]
      apply ENNReal.ofReal_le_ofReal
      have hle : 1 - Real.exp (-π) ≤ 1 - Real.exp (-(π * τ * ‖ξ‖ ^ 2)) := by
        have h1 : π ≤ π * τ * ‖ξ‖ ^ 2 := by
          have : A ^ 2 ≤ ‖ξ‖ ^ 2 := by gcongr
          have : 1 ≤ τ * ‖ξ‖ ^ 2 := by nlinarith
          nlinarith [pi_pos]
        have := Real.exp_le_exp.2 (neg_le_neg h1)
        linarith
      calc r ξ = K * ((1 - Real.exp (-π)) * r ξ) := by
            rw [hK_def, ← mul_assoc, inv_mul_cancel₀ hK.ne', one_mul]
        _ ≤ K * ((1 - Real.exp (-(π * τ * ‖ξ‖ ^ 2))) * r ξ) := by gcongr; exact hr0 ξ
    · rw [indicator_of_notMem (show ξ ∉ {ξ : ℝ² | A < ‖ξ‖} from hξ)]
      exact zero_le
  rw [← ofReal_integral_eq_lintegral_ofReal hi (ae_of_all _ fun ξ =>
    mul_nonneg hK0.le (mul_nonneg (he ξ).1 (hr0 ξ)))] at step1
  refine step1.trans (ENNReal.ofReal_le_ofReal ?_)
  rw [integral_const_mul]
  refine mul_le_mul_of_nonneg_left ?_ hK0.le
  have htail := aux_tail_identity hctpd hctc hcti hτ
  simp only [r]
  rw [htail, hct0]
  have hγi := aux_gaussKernel_integrable hτ
  have hγ0 := aux_gaussKernel_nonneg τ hτ
  refine integral_mono ?_ ?_ fun w => mul_le_mul_of_nonneg_left
    (aux_bochner_pointwise hc hL ht0 ht1 w) (hγ0 w)
  · refine (hγi.mul_const (2 * (c 0).re)).mono' (by fun_prop) (ae_of_all _ fun w => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hγ0 w)]
    refine mul_le_mul_of_nonneg_left ?_ (hγ0 w)
    have h1 := hbd (-w)
    have h2 : ‖ct (-w)‖ ≤ (c 0).re := by
      simp only [ct]
      rw [norm_mul, ← Complex.ofReal_neg, ← Complex.ofReal_exp, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact (mul_le_of_le_one_right (norm_nonneg _) (Real.exp_le_one_iff.2 (by
        have : 0 ≤ π * t * ‖-w‖ ^ 2 := by positivity
        linarith))).trans h1
    have h3 := Complex.abs_re_le_norm (ct (-w))
    rw [abs_le]; constructor
    · have := abs_le.1 h3; nlinarith [abs_nonneg (ct (-w)).re]
    · have := abs_le.1 h3; linarith
  · refine (hγi.mul_const (2 * (c 0).re)).mono' (by fun_prop) (ae_of_all _ fun w => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hγ0 w)]
    refine mul_le_mul_of_nonneg_left ?_ (hγ0 w)
    rw [abs_of_nonneg (le_min (by linarith) (by positivity))]
    exact min_le_left _ _

/-- **Theorem `ext:bochner`** (existence, uniqueness and mass of the spectral measure).
Let $c:\mathbb R^2\to\mathbb C$ be a Lipschitz positive-definite function.
There is a unique finite positive Borel measure $\nu$ such that
$$c(s)=\int\exp(2\pi i s\cdot\xi)\,d\nu(\xi)\qquad(s\in\mathbb R^2),\qquad \nu(\mathbb R^2)=c(0).$$
In particular, $c(0)\le1$ implies that the representing measure has mass at most one. -/
theorem ext_bochner {c : ℝ² → ℂ} (hc : IsPositiveDefinite c) (hL : ∃ L, LipschitzWith L c) :
    ∃! ν : Measure ℝ², IsFiniteMeasure ν ∧
      (∀ s, c s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂ν) ∧
      ν univ = ENNReal.ofReal (c 0).re := by
  obtain ⟨L, hL⟩ := hL
  obtain ⟨h0, -, hbd⟩ := ext_pd_integrable_elementary hc
  have hm0 : 0 ≤ (c 0).re := (Complex.nonneg_iff.1 h0).1
  have hreg := fun n : ℕ => aux_bochner_reg hc hL (t := 1 / ((n : ℝ) + 1)) (by positivity)
    (by rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)])
  choose ν hfin hmass hchar htail using hreg
  set H : ℝ² → ℝ := fun w => min (2 * (c 0).re) (L * ‖w‖ + (c 0).re * π * ‖w‖ ^ 2) with hH
  have hHc : Continuous H := by fun_prop
  have hHb : ∀ w, |H w| ≤ 2 * (c 0).re := fun w => by
    rw [abs_of_nonneg (le_min (by linarith) (by positivity))]
    exact min_le_left _ _
  have hH0 : H 0 = 0 := by simp [H, hm0]
  have hav := aux_gauss_average_tendsto hHc hHb
  rw [hH0] at hav
  set K := (1 - Real.exp (-π))⁻¹
  have htight : Tendsto (fun A : ℝ => ⨆ n, ν n {x | A < ‖x‖}) atTop (𝓝 0) := by
    have hτ : Tendsto (fun A : ℝ => (A ^ 2)⁻¹) atTop (𝓝[>] 0) :=
      tendsto_inv_atTop_nhdsGT_zero.comp (tendsto_pow_atTop two_ne_zero)
    have hg : Tendsto (fun A : ℝ => ENNReal.ofReal (K * ∫ w, gaussKernel (A ^ 2)⁻¹ w * H w))
        atTop (𝓝 0) := by
      have := (hav.comp hτ).const_mul K
      rw [mul_zero] at this
      simpa using ENNReal.tendsto_ofReal this
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hg
      (Eventually.of_forall fun _ => zero_le) ?_
    filter_upwards [eventually_gt_atTop 0] with A hA
    refine iSup_le fun n => htail n _ (by positivity) A hA.le ?_
    rw [inv_mul_cancel₀ (by positivity)]
  obtain ⟨φ, hφ, ν₀, hν₀, hconv⟩ :=
    ext_tight_measures ν (ENNReal.ofReal (c 0).re) ENNReal.ofReal_ne_top hmass htight
  have hfin0 : IsFiniteMeasure ν₀ := ⟨by rw [hν₀]; exact ENNReal.ofReal_lt_top⟩
  have hrep : ∀ s, c s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂ν₀ := by
    intro s
    let g : ℝ² →ᵇ ℂ := BoundedContinuousFunction.ofNormedAddCommGroup
      (fun ξ => Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I)) (by fun_prop) 1
      (fun ξ => by rw [Complex.norm_exp_ofReal_mul_I])
    have h1 := hconv g
    have h2 : Tendsto (fun n => ∫ ξ, g ξ ∂(ν (φ n))) atTop (𝓝 (c s)) := by
      have e : ∀ n, ∫ ξ, g ξ ∂(ν (φ n)) =
          c s * Complex.exp (-(π * (1 / ((φ n : ℝ) + 1)) * ‖s‖ ^ 2 : ℝ)) := fun n => hchar _ s
      simp_rw [e]
      conv => rhs; rw [← mul_one (c s)]
      refine tendsto_const_nhds.mul ?_
      have : Tendsto (fun n : ℕ => (1 / ((φ n : ℝ) + 1))) atTop (𝓝 0) := by
        have := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).comp hφ.tendsto_atTop
        exact this
      have h3 : Tendsto (fun n : ℕ => (-(π * (1 / ((φ n : ℝ) + 1)) * ‖s‖ ^ 2 : ℝ))) atTop
          (𝓝 (-(π * 0 * ‖s‖ ^ 2))) :=
        ((this.const_mul π).mul_const _).neg
      rw [show (1 : ℂ) = Complex.exp ((-(π * 0 * ‖s‖ ^ 2) : ℝ)) by simp]
      have h4 : Tendsto (fun n : ℕ => (((-(π * (1 / ((φ n : ℝ) + 1)) * ‖s‖ ^ 2)) : ℝ) : ℂ)) atTop
          (𝓝 (((-(π * 0 * ‖s‖ ^ 2)) : ℝ) : ℂ)) := (Complex.continuous_ofReal.tendsto _).comp h3
      refine (Complex.continuous_exp.tendsto _).comp ?_
      simp only [Complex.ofReal_neg] at h4 ⊢
      exact h4
    exact tendsto_nhds_unique h2 h1
  refine ⟨ν₀, ⟨hfin0, hrep, hν₀⟩, fun ν' hν' => ?_⟩
  obtain ⟨hf', hrep', -⟩ := hν'
  exact aux_measure_ext_of_fourier fun s => by rw [← hrep', ← hrep]

/-- **Theorem `ext:bochner`** (mass at most one when `c(0) ≤ 1`).
Let $c:\mathbb R^2\to\mathbb C$ be a Lipschitz positive-definite function.
There is a unique finite positive Borel measure $\nu$ such that
$$c(s)=\int\exp(2\pi i s\cdot\xi)\,d\nu(\xi)\qquad(s\in\mathbb R^2),\qquad \nu(\mathbb R^2)=c(0).$$
In particular, $c(0)\le1$ implies that the representing measure has mass at most one. -/
theorem ext_bochner_mass_le_one {c : ℝ² → ℂ} (_hc : IsPositiveDefinite c)
    (_hL : ∃ L, LipschitzWith L c) (hc0 : c 0 ≤ 1) (ν : Measure ℝ²) [IsFiniteMeasure ν]
    (hν : ∀ s, c s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂ν) :
    ν univ ≤ 1 := by
  have h0 : c 0 = (ν.real univ : ℂ) := by simpa using hν 0
  rw [h0] at hc0
  have : ν.real univ ≤ 1 := by exact_mod_cast hc0
  rw [← ofReal_measureReal (measure_ne_top ν univ)]
  exact ENNReal.ofReal_le_one.mpr this

/-! ### Measurable dependence of spectral measures (`ext:measurable-spectral`) -/

/-- Auxiliary (for `ext:measurable-spectral`, see `ext_measurable_spectral`): Fourier inversion for
the Gaussian, `γ_t(x) = ∫ exp(-π t|s|²) exp(2πi x·s) ds`. -/
theorem aux_gaussKernel_inv {t : ℝ} (ht : 0 < t) (x : ℝ²) :
    (gaussKernel t x : ℂ) = ∫ s, (Real.exp (-(π * t * ‖s‖ ^ 2)) : ℂ) *
      Complex.exp ((2 * π * ⟪x, s⟫_ℝ : ℝ) * Complex.I) := by
  have hint : Integrable (fun x => (gaussKernel t x : ℂ)) volume :=
    (aux_gaussKernel_integrable ht).ofReal
  have hF : 𝓕 (fun x => (gaussKernel t x : ℂ)) = fun s => (Real.exp (-(π * t * ‖s‖ ^ 2)) : ℂ) := by
    funext s; rw [ext_gaussian_fourier ht, Complex.ofReal_exp, Complex.ofReal_neg]
  have hFi : Integrable (𝓕 (fun x => (gaussKernel t x : ℂ))) volume := by
    rw [hF]
    have hi : Integrable (fun s : ℝ² => ((t⁻¹ * gaussKernel t⁻¹ s : ℝ) : ℂ)) volume :=
      ((aux_gaussKernel_integrable (inv_pos.2 ht)).const_mul _).ofReal
    refine hi.congr (ae_of_all _ fun s => ?_)
    simp only [aux_exp_eq_gaussKernel ht]
  have := hint.fourierInv_fourier_eq hFi (v := x)
    (Complex.continuous_ofReal.comp (aux_gaussKernel_continuous t)).continuousAt
  rw [aux_fourierInv_convention, hF] at this
  exact this.symm


/-- Auxiliary: `s ↦ exp(-π t|s|²)` is integrable for `t > 0`. -/
theorem aux_gauss_exp_integrable {t : ℝ} (ht : 0 < t) :
    Integrable (fun s : ℝ² => Real.exp (-(π * t * ‖s‖ ^ 2))) volume := by
  have e : (fun s : ℝ² => Real.exp (-(π * t * ‖s‖ ^ 2))) =
      fun s => t⁻¹ * gaussKernel t⁻¹ s := funext (aux_exp_eq_gaussKernel ht)
  rw [e]
  exact (aux_gaussKernel_integrable (inv_pos.2 ht)).const_mul _

/-- Auxiliary (for `ext:measurable-spectral`, see `ext_measurable_spectral`): if `c(s) = ∫ exp(2πi
s·ξ) dν(ξ)`, then `∫ γ_t(ξ - y) dν(ξ) = ∫ exp(-π t|s|²) exp(-2πi y·s) c(s) ds` (Fubini). -/
theorem aux_spectral_gauss (ν : Measure ℝ²) [IsFiniteMeasure ν] (c : ℝ² → ℂ)
    (hν : ∀ s, c s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂ν)
    {t : ℝ} (ht : 0 < t) (y : ℝ²) :
    ∫ ξ, (gaussKernel t (ξ - y) : ℂ) ∂ν = ∫ s, (Real.exp (-(π * t * ‖s‖ ^ 2)) : ℂ) *
      (Complex.exp (-(2 * π * ⟪y, s⟫_ℝ : ℝ) * Complex.I) * c s) := by
  simp_rw [aux_gaussKernel_inv ht]
  have hG := aux_gauss_exp_integrable ht
  have hint : Integrable (Function.uncurry fun (ξ s : ℝ²) =>
      (Real.exp (-(π * t * ‖s‖ ^ 2)) : ℂ) *
        Complex.exp ((2 * π * ⟪ξ - y, s⟫_ℝ : ℝ) * Complex.I)) (ν.prod volume) := by
    refine ((integrable_const (1 : ℝ)).mul_prod hG).mono' ?_ (ae_of_all _ fun p => ?_)
    · exact (Continuous.aestronglyMeasurable (by fun_prop))
    · simp only [Function.uncurry, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (Real.exp_pos _), Complex.norm_exp_ofReal_mul_I, mul_one, one_mul, le_refl]
  rw [integral_integral_swap hint]
  refine integral_congr_ae (ae_of_all _ fun s => ?_)
  have e : ∀ ξ : ℝ², (Real.exp (-(π * t * ‖s‖ ^ 2)) : ℂ) *
      Complex.exp ((2 * π * ⟪ξ - y, s⟫_ℝ : ℝ) * Complex.I) =
      (Real.exp (-(π * t * ‖s‖ ^ 2)) : ℂ) * (Complex.exp (-(2 * π * ⟪y, s⟫_ℝ : ℝ) * Complex.I) *
        Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I)) := by
    intro ξ
    rw [← Complex.exp_add, inner_sub_left, real_inner_comm ξ s]
    congr 2; push_cast; ring
  simp only
  simp_rw [e]
  rw [integral_const_mul, integral_const_mul, ← hν s]


/-- Auxiliary (for `ext:measurable-spectral`): `γ_t * f → f` pointwise along `t = 1/(n+1)` for
bounded continuous real `f`. -/
theorem aux_gauss_conv_tendsto {f : ℝ² → ℝ} (hf : Continuous f) {B : ℝ} (hfb : ∀ x, |f x| ≤ B)
    (ξ : ℝ²) : Tendsto (fun n : ℕ => ∫ y, gaussKernel (1 / ((n : ℝ) + 1)) (ξ - y) * f y)
      atTop (𝓝 (f ξ)) := by
  have h1 := aux_gauss_average_tendsto (h := fun w => f (ξ - w)) (hf.comp (continuous_const.sub
    continuous_id)) (B := B) (fun w => hfb _)
  simp only [sub_zero] at h1
  have h2 : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨tendsto_one_div_add_atTop_nhds_zero_nat,
      Eventually.of_forall fun n => by simp only [mem_Ioi]; positivity⟩
  refine (h1.comp h2).congr fun n => ?_
  simp only [Function.comp]
  have := integral_sub_left_eq_self (μ := (volume : Measure ℝ²))
    (fun y => gaussKernel (1 / ((n : ℝ) + 1)) (ξ - y) * f y) ξ
  simpa using this

/-- Auxiliary (for `ext:measurable-spectral`): `|γ_t * f| ≤ B` when `|f| ≤ B`. -/
theorem aux_gauss_conv_abs_le {f : ℝ² → ℝ} {B : ℝ} (hfb : ∀ x, |f x| ≤ B) {t : ℝ} (ht : 0 < t)
    (ξ : ℝ²) : ‖∫ y, gaussKernel t (ξ - y) * f y‖ ≤ B := by
  calc ‖∫ y, gaussKernel t (ξ - y) * f y‖ ≤ ∫ y, gaussKernel t (ξ - y) * B := by
        refine norm_integral_le_of_norm_le
          (((aux_gaussKernel_integrable ht).comp_sub_left ξ).mul_const B)
          (ae_of_all _ fun y => ?_)
        rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (aux_gaussKernel_nonneg t ht _)]
        exact mul_le_mul_of_nonneg_left (hfb y) (aux_gaussKernel_nonneg t ht _)
    _ = B := by
        rw [integral_mul_const, integral_sub_left_eq_self (fun y => gaussKernel t y)
          (μ := volume) ξ, ext_gaussian_integral ht, one_mul]

/-- Auxiliary (for `ext:measurable-spectral`, see `ext_measurable_spectral`): `z ↦ ∫ (γ_t * f) dν_z`
is measurable, being expressed through the jointly measurable `(z, s) ↦ c_z(s)`. -/
theorem aux_spectral_conv_measurable {Z : Type*} [MeasurableSpace Z] (c : Z → ℝ² → ℂ)
    (hC : Measurable fun p : Z × ℝ² => c p.1 p.2) (ν : Z → Measure ℝ²)
    [∀ z, IsFiniteMeasure (ν z)]
    (hν : ∀ z s, c z s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂(ν z))
    {f : ℝ² → ℝ} (hf : Continuous f) {B : ℝ} (hfb : ∀ x, |f x| ≤ B) {t : ℝ} (ht : 0 < t) :
    Measurable fun z => ∫ ξ, (∫ y, gaussKernel t (ξ - y) * f y) ∂(ν z) := by
  set K : (Z × ℝ²) × ℝ² → ℂ := fun p => (Real.exp (-(π * t * ‖p.2‖ ^ 2)) : ℂ) *
    (Complex.exp (-(2 * π * ⟪p.1.2, p.2⟫_ℝ : ℝ) * Complex.I) * c p.1.1 p.2)
  have hK : StronglyMeasurable K := by
    have h1 : Measurable fun p : (Z × ℝ²) × ℝ² => c p.1.1 p.2 :=
      hC.comp (by fun_prop : Measurable fun p : (Z × ℝ²) × ℝ² => (p.1.1, p.2))
    have h2' : Continuous fun q : ℝ² × ℝ² => (Real.exp (-(π * t * ‖q.2‖ ^ 2)) : ℂ) *
        Complex.exp (-(2 * π * ⟪q.1, q.2⟫_ℝ : ℝ) * Complex.I) := by fun_prop
    have h2 : Measurable fun p : (Z × ℝ²) × ℝ² => (Real.exp (-(π * t * ‖p.2‖ ^ 2)) : ℂ) *
        Complex.exp (-(2 * π * ⟪p.1.2, p.2⟫_ℝ : ℝ) * Complex.I) :=
      by fun_prop
    have : K = fun p => ((Real.exp (-(π * t * ‖p.2‖ ^ 2)) : ℂ) *
        Complex.exp (-(2 * π * ⟪p.1.2, p.2⟫_ℝ : ℝ) * Complex.I)) * c p.1.1 p.2 := by
      funext p; simp only [K]; ring
    rw [this]
    exact (h2.mul h1).stronglyMeasurable
  have hK1 : StronglyMeasurable fun q : Z × ℝ² => (∫ s, K (q, s)) * (f q.2 : ℂ) :=
    hK.integral_prod_right'.mul
      (Complex.measurable_ofReal.comp (hf.measurable.comp measurable_snd)).stronglyMeasurable
  have hK2 : StronglyMeasurable fun z : Z => ∫ y, (∫ s, K ((z, y), s)) * (f y : ℂ) :=
    hK1.integral_prod_right'
  have key : ∀ z, ((∫ ξ, (∫ y, gaussKernel t (ξ - y) * f y) ∂(ν z) : ℝ) : ℂ) =
      ∫ y, (∫ s, K ((z, y), s)) * (f y : ℂ) := by
    intro z
    rw [← integral_complex_ofReal]
    simp_rw [← integral_complex_ofReal]
    push_cast
    -- Fubini on ν z × volume
    have hγi := aux_gaussKernel_integrable ht
    have hP : Integrable (fun p : ℝ² × ℝ² => gaussKernel t (p.1 - p.2) * B)
        ((ν z).prod volume) := by
      have hcP : Continuous fun p : ℝ² × ℝ² => gaussKernel t (p.1 - p.2) * B :=
        ((aux_gaussKernel_continuous t).comp continuous_sub).mul continuous_const
      rw [integrable_prod_iff hcP.aestronglyMeasurable]
      refine ⟨ae_of_all _ fun ξ => (hγi.comp_sub_left ξ).mul_const B, ?_⟩
      refine (integrable_const (|B|)).congr (ae_of_all _ fun ξ => ?_)
      simp only [Real.norm_eq_abs, abs_mul, abs_of_nonneg (aux_gaussKernel_nonneg t ht _)]
      rw [integral_mul_const, integral_sub_left_eq_self (fun y => gaussKernel t y)
        (μ := volume) ξ, ext_gaussian_integral ht, one_mul]
    have hP' : Integrable (Function.uncurry fun (ξ y : ℝ²) =>
        (gaussKernel t (ξ - y) : ℂ) * (f y : ℂ)) ((ν z).prod volume) := by
      refine hP.mono' ?_ (ae_of_all _ fun p => ?_)
      · exact (Continuous.aestronglyMeasurable (by
          exact (Complex.continuous_ofReal.comp ((aux_gaussKernel_continuous t).comp
            continuous_sub)).mul (Complex.continuous_ofReal.comp (hf.comp continuous_snd))))
      · simp only [Function.uncurry, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (aux_gaussKernel_nonneg t ht _)]
        exact mul_le_mul_of_nonneg_left (hfb _) (aux_gaussKernel_nonneg t ht _)
    rw [integral_integral_swap hP']
    refine integral_congr_ae (ae_of_all _ fun y => ?_)
    simp only
    rw [integral_mul_const, aux_spectral_gauss (ν z) (c z) (hν z) ht y]
  have : (fun z => ∫ ξ, (∫ y, gaussKernel t (ξ - y) * f y) ∂(ν z)) =
      fun z => (∫ y, (∫ s, K ((z, y), s)) * (f y : ℂ)).re := by
    funext z; rw [← key z, Complex.ofReal_re]
  rw [this]
  exact Complex.measurable_re.comp hK2.measurable

/-- Auxiliary (for `ext:measurable-spectral`, see `ext_measurable_spectral`): `z ↦ ∫ f dν_z` is
measurable for every bounded continuous real `f` (limit of the Gaussian regularizations
`aux_spectral_conv_measurable`). -/
theorem aux_spectral_measurable_integral {Z : Type*} [MeasurableSpace Z] (c : Z → ℝ² → ℂ)
    (hC : Measurable fun p : Z × ℝ² => c p.1 p.2) (ν : Z → Measure ℝ²)
    [∀ z, IsFiniteMeasure (ν z)]
    (hν : ∀ z s, c z s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂(ν z))
    {f : ℝ² → ℝ} (hf : Continuous f) {B : ℝ} (hfb : ∀ x, |f x| ≤ B) :
    Measurable fun z => ∫ ξ, f ξ ∂(ν z) := by
  set conv : ℝ → ℝ² → ℝ := fun t ξ => ∫ y, gaussKernel t (ξ - y) * f y with hconv
  have hconv_sm : ∀ t, StronglyMeasurable (conv t) := fun t => by
    have : StronglyMeasurable fun p : ℝ² × ℝ² => gaussKernel t (p.1 - p.2) * f p.2 :=
      (((aux_gaussKernel_continuous t).comp continuous_sub).mul
        (hf.comp continuous_snd)).stronglyMeasurable
    exact this.integral_prod_right'
  -- (a) convergence for each z
  have hlim : ∀ z, Tendsto (fun n : ℕ => ∫ ξ, conv (1 / ((n : ℝ) + 1)) ξ ∂(ν z)) atTop
      (𝓝 (∫ ξ, f ξ ∂(ν z))) := by
    intro z
    refine tendsto_integral_of_dominated_convergence (fun _ => B)
      (fun n => (hconv_sm _).aestronglyMeasurable) (integrable_const B)
      (fun n => ae_of_all _ fun ξ => aux_gauss_conv_abs_le hfb (by positivity) ξ)
      (ae_of_all _ fun ξ => aux_gauss_conv_tendsto hf hfb ξ)
  -- (b) measurability for each t
  have hmeas : ∀ t, 0 < t → Measurable fun z => ∫ ξ, conv t ξ ∂(ν z) := fun t ht =>
    aux_spectral_conv_measurable c hC ν hν hf hfb ht
  exact measurable_of_tendsto_metrizable (fun n => hmeas _ (by positivity))
    (tendsto_pi_nhds.2 hlim)

-- The hypotheses hpd, h1 belong to the manuscript statement but are not needed by the proof.
set_option linter.unusedVariables false in
/-- **Lemma `ext:measurable-spectral`**.  (The measures `ν_z` supplied by `ext_bochner` are
characterized, by its uniqueness part, as the finite measures representing `c_z`.)
Suppose $z\mapsto c_z(s)$ is measurable for each $s\in\mathbb R^2$, and every $c_z$ is
Lipschitz and positive definite with $c_z(0)\le1$.  Let $\nu_z$ be the measures supplied by
Theorem `ext:bochner`.  Then $z\mapsto\nu_z(B)$ is measurable for every Borel set
$B\subset\mathbb R^2$. -/
theorem ext_measurable_spectral {Z : Type*} [MeasurableSpace Z] (c : Z → ℝ² → ℂ)
    (hmeas : ∀ s, Measurable fun z => c z s) (hL : ∀ z, ∃ L, LipschitzWith L (c z))
    (hpd : ∀ z, IsPositiveDefinite (c z)) (h1 : ∀ z, c z 0 ≤ 1)
    (ν : Z → Measure ℝ²) [∀ z, IsFiniteMeasure (ν z)]
    (hν : ∀ z s, c z s = ∫ ξ, Complex.exp ((2 * π * ⟪s, ξ⟫_ℝ : ℝ) * Complex.I) ∂(ν z))
    {B : Set ℝ²} (hB : MeasurableSet B) :
    Measurable fun z => ν z B := by
  have hC' : Measurable (Function.uncurry fun (s : ℝ²) (z : Z) => c z s) :=
    measurable_uncurry_of_continuous_of_measurable
      (fun z => (hL z).choose_spec.continuous) hmeas
  have hC : Measurable fun p : Z × ℝ² => c p.1 p.2 := hC'.comp measurable_swap
  have hclosed : ∀ F : Set ℝ², IsClosed F → Measurable fun z => ν z F := by
    intro F hF
    have hδ : ∀ n : ℕ, (0 : ℝ) < 1 / ((n : ℝ) + 1) := fun n => by positivity
    have hlim := fun z => tendsto_lintegral_thickenedIndicator_of_isClosed (ν z) hF hδ
      tendsto_one_div_add_atTop_nhds_zero_nat
    refine measurable_of_tendsto_metrizable (fun n => ?_) (tendsto_pi_nhds.2 hlim)
    have hcont : Continuous fun x => ((thickenedIndicator (hδ n) F x : ℝ≥0) : ℝ) :=
      NNReal.continuous_coe.comp (thickenedIndicator (hδ n) F).continuous
    have hb : ∀ x, |((thickenedIndicator (hδ n) F x : ℝ≥0) : ℝ)| ≤ 1 := fun x => by
      rw [abs_of_nonneg (NNReal.coe_nonneg _)]
      exact_mod_cast thickenedIndicator_le_one (hδ n) F x
    have hm := aux_spectral_measurable_integral c hC ν hν hcont hb
    have e : (fun z => ∫⁻ x, (thickenedIndicator (hδ n) F x : ℝ≥0∞) ∂(ν z)) =
        fun z => ENNReal.ofReal (∫ x, ((thickenedIndicator (hδ n) F x : ℝ≥0) : ℝ) ∂(ν z)) := by
      funext z
      rw [ofReal_integral_eq_lintegral_ofReal]
      · simp
      · exact (integrable_const (1 : ℝ)).mono' hcont.aestronglyMeasurable
          (ae_of_all _ fun x => by rw [Real.norm_eq_abs]; exact hb x)
      · exact ae_of_all _ fun x => NNReal.coe_nonneg _
    rw [e]
    exact ENNReal.measurable_ofReal.comp hm
  have hmeasν : Measurable ν := by
    refine Measurable.measure_of_isPiSystem (S := {s | IsClosed s}) ?_ isPiSystem_isClosed
      (fun F hF => hclosed F hF) (hclosed univ isClosed_univ)
    rw [BorelSpace.measurable_eq (α := ℝ²), borel_eq_generateFrom_isClosed]
  exact (Measure.measurable_coe hB).comp hmeasν

/-! ### Measurable measure kernels (`ext:kernel-definition`, `ext:kernel-integration`) -/

/-- Measurable kernels of finite measures (`\label{ext:kernel-definition}`).
Let $(X,\mathcal A)$ be a measurable space.  A family $z\mapsto\nu_z$ of finite positive Borel
measures on $\mathbb R^q$ is a *measurable kernel* if $z\mapsto\nu_z(B)$ is
$\mathcal A$-measurable for every Borel set $B\subset\mathbb R^q$.

The target is allowed to be any measurable space `E` (the blueprint uses `E = ℝ^q`, and
products `ℝ^q × ℝ^r` in `ext_kernel_integration_prod`).  Such a family is the same as a
Mathlib `ProbabilityTheory.Kernel X E` all of whose measures are finite (by
`Measure.measurable_of_measurable_coe`); no uniform bound on the masses is required. -/
def IsMeasurableKernel {X E : Type*} [MeasurableSpace X] [MeasurableSpace E]
    (ν : X → Measure E) : Prop :=
  (∀ z, IsFiniteMeasure (ν z)) ∧ ∀ B : Set E, MeasurableSet B → Measurable fun z => ν z B

/-- Auxiliary (for `ext:kernel-integration`): the Mathlib kernel `ProbabilityTheory.Kernel X E`
underlying a measurable kernel family `ν` (`IsMeasurableKernel ν`). -/
def aux_toKernel {X E : Type*} [MeasurableSpace X] [MeasurableSpace E] {ν : X → Measure E}
    (hν : IsMeasurableKernel ν) : Kernel X E :=
  ⟨ν, Measure.measurable_of_measurable_coe _ hν.2⟩

/-- Auxiliary (for `ext:kernel-integration`): a measurable kernel all of whose measures are finite
is an s-finite Mathlib kernel (sum of the finite kernels obtained by restricting to `{z : n ≤ ν_z(E)
< n + 1}`). -/
theorem aux_toKernel_isSFiniteKernel {X E : Type*} [MeasurableSpace X] [MeasurableSpace E]
    {ν : X → Measure E} (hν : IsMeasurableKernel ν) : IsSFiniteKernel (aux_toKernel hν) := by
  set κ := aux_toKernel hν
  have hfin := hν.1
  set A : ℕ → Set X := fun n => {z | κ z univ ∈ Ico (n : ℝ≥0∞) (n + 1)} with hA
  have hAm : ∀ n, MeasurableSet (A n) := fun n =>
    (Kernel.measurable_coe κ MeasurableSet.univ) measurableSet_Ico
  let κs : ℕ → Kernel X E := fun n => Kernel.piecewise (hAm n) κ 0
  have hκs : ∀ n, IsFiniteKernel (κs n) := fun n => by
    refine ⟨⟨n + 1, by simp [ENNReal.add_lt_top], fun z => ?_⟩⟩
    simp only [κs, Kernel.piecewise_apply]
    split_ifs with h
    · exact h.2.le
    · simp
  have hunique : ∀ z, ∃! n, z ∈ A n := by
    intro z
    have hlt : κ z univ < ⊤ := by
      have := hfin z; exact measure_lt_top (ν z) univ
    set r := (κ z univ).toReal
    refine ⟨⌊r⌋₊, ?_, fun m hm => ?_⟩
    · have e : κ z univ = ENNReal.ofReal r := (ENNReal.ofReal_toReal hlt.ne).symm
      simp only [A, mem_ofPred_eq, mem_Ico, e]
      have hr : 0 ≤ r := ENNReal.toReal_nonneg
      constructor
      · rw [← ENNReal.ofReal_natCast]; exact ENNReal.ofReal_le_ofReal (Nat.floor_le hr)
      · rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_one, ← ENNReal.ofReal_add (by positivity)
          zero_le_one]
        exact (ENNReal.ofReal_lt_ofReal_iff (by positivity)).2 (Nat.lt_floor_add_one r)
    · simp only [A, mem_ofPred_eq, mem_Ico] at hm
      have e : κ z univ = ENNReal.ofReal r := (ENNReal.ofReal_toReal hlt.ne).symm
      rw [e, ← ENNReal.ofReal_natCast] at hm
      have h1 : (m : ℝ) ≤ r := (ENNReal.ofReal_le_ofReal_iff ENNReal.toReal_nonneg).1 hm.1
      have h2 : r < m + 1 := by
        have := hm.2
        rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_add (by positivity) zero_le_one] at this
        exact (ENNReal.ofReal_lt_ofReal_iff (by positivity)).1 this
      exact (Nat.floor_eq_iff ENNReal.toReal_nonneg).2 ⟨h1, h2⟩ |>.symm
  have hsum : Kernel.sum κs = κ := by
    ext z s hs
    rw [Kernel.sum_apply' _ _ hs]
    obtain ⟨n, hn, hn'⟩ := hunique z
    rw [tsum_eq_single n]
    · simp [κs, Kernel.piecewise_apply, hn]
    · intro m hm
      have : z ∉ A m := fun h => hm (hn' m h)
      simp [κs, Kernel.piecewise_apply, this]
  rw [← hsum]
  infer_instance


/-- Auxiliary (for `ext:kernel-integration`, see `ext_kernel_integration_measure`): the measure `𝔪 =
λ ⊗ ν` on the product is sigma-finite (exhaustion by `(X_n ∩ {ν_z(E) ≤ n}) × E`). -/
theorem aux_compProd_sigmaFinite {X E : Type*} [MeasurableSpace X] [MeasurableSpace E]
    (lam : Measure X) [SigmaFinite lam] {ν : X → Measure E} (hν : IsMeasurableKernel ν) :
    SigmaFinite (lam ⊗ₘ aux_toKernel hν) := by
  have := aux_toKernel_isSFiniteKernel hν
  set κ := aux_toKernel hν
  set S : ℕ → Set (X × E) := fun n =>
    (spanningSets lam n ∩ {z | κ z univ ≤ n}) ×ˢ univ with hS
  have hSm : ∀ n, MeasurableSet (spanningSets lam n ∩ {z | κ z univ ≤ n}) := fun n =>
    (measurableSet_spanningSets lam n).inter
      (Kernel.measurable_coe κ MeasurableSet.univ measurableSet_Iic)
  refine ⟨⟨⟨S, fun _ => trivial, fun n => ?_, ?_⟩⟩⟩
  · rw [Measure.compProd_apply_prod (hSm n) MeasurableSet.univ]
    calc ∫⁻ a in spanningSets lam n ∩ {z | κ z univ ≤ n}, κ a univ ∂lam
        ≤ ∫⁻ a in spanningSets lam n ∩ {z | κ z univ ≤ n}, (n : ℝ≥0∞) ∂lam :=
          setLIntegral_mono measurable_const fun a ha => ha.2
      _ ≤ n * lam (spanningSets lam n) := by
          rw [setLIntegral_const]
          gcongr
          exact inter_subset_left
      _ < ⊤ := ENNReal.mul_lt_top (by simp) (measure_spanningSets_lt_top lam n)
  · refine iUnion_eq_univ_iff.2 fun p => ?_
    obtain ⟨m, hm⟩ := iUnion_eq_univ_iff.1 (iUnion_spanningSets lam) p.1
    have hfin : κ p.1 univ < ⊤ := by
      have := hν.1 p.1; exact measure_lt_top (ν p.1) univ
    obtain ⟨k, hk⟩ := ENNReal.exists_nat_gt hfin.ne
    refine ⟨max m k, ⟨⟨monotone_spanningSets lam (le_max_left _ _) hm, ?_⟩, trivial⟩⟩
    exact hk.le.trans (by exact_mod_cast le_max_right m k)

/-- **Lemma `ext:kernel-integration`** (measurability of section integrals, nonnegative case).
Let $(X,\mathcal A,\lambda)$ be a sigma-finite measure space and let $z\mapsto\nu_z$ be a
measurable kernel on $\mathbb R^q$.  For every nonnegative
$\mathcal A\otimes\mathcal B(\mathbb R^q)$-measurable function $F$, the function
$z\mapsto\int F(z,\xi)\,d\nu_z(\xi)$ is measurable.  There is a sigma-finite measure
$\mathfrak m$ on the product space satisfying
$$\int F\,d\mathfrak m=\int_X\int_{\mathbb R^q}F(z,\xi)\,d\nu_z(\xi)\,d\lambda(z).$$
If $z\mapsto\eta_z$ is another measurable finite positive kernel, then
$z\mapsto\nu_z\otimes\eta_z$ is a measurable kernel.
These identities also hold for integrable complex functions. -/
theorem ext_kernel_integration_measurable {X : Type*} [MeasurableSpace X] {q : ℕ}
    {ν : X → Measure (EuclideanSpace ℝ (Fin q))} (hν : IsMeasurableKernel ν)
    {F : X × EuclideanSpace ℝ (Fin q) → ℝ≥0∞} (hF : Measurable F) :
    Measurable fun z => ∫⁻ ξ, F (z, ξ) ∂(ν z) := by
  have := aux_toKernel_isSFiniteKernel hν
  exact hF.lintegral_kernel_prod_right' (κ := aux_toKernel hν)

/-- **Lemma `ext:kernel-integration`** (measurability of section integrals, complex case).
Let $(X,\mathcal A,\lambda)$ be a sigma-finite measure space and let $z\mapsto\nu_z$ be a
