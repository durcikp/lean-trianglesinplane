/-- **Theorem A `intro:density`** (Geometric conclusion). Let $\Delta\subset\R^2$ consist of three
noncollinear points. If $E\subset\R^2$ is measurable and $d^*(E)>0$, there is $\lambda_0>0$ such
that, for every $\lambda\ge\lambda_0$, the set $E$ contains a translate of a rotation of
$\lambda\Delta$. -/
theorem intro_density (a b c : ℝ²) (hΔ : ¬ Collinear ℝ ({a, b, c} : Set ℝ²)) (E : Set ℝ²)
    (hE : NullMeasurableSet E volume) (hd : 0 < upperBanachDensity E) :
    ∃ lam₀ : ℝ, 0 < lam₀ ∧ ∀ lam : ℝ, lam₀ ≤ lam →
      ∃ (x : ℝ²) (t : ℝ), ∀ p ∈ ({a, b, c} : Set ℝ²), x + rot t (lam • p) ∈ E :=
  den_main_general a b c hΔ E hE hd

/-- **Theorem B `intro:smoothing`** (Uniform smoothing). Let $M=\alpha I+\beta J$ with $\beta\ne0$.
For every nonnegative $\rho\in L^1(\R^2)$ with $\int\rho=1$, put
$\rho_\varepsilon(u)=\varepsilon^{-2}\rho(u/\varepsilon)$. Then
$$\lim_{\varepsilon\downarrow0}\sup_{s>0}
\big\|\Lambda_{(\sigma*\rho_\varepsilon-\sigma)_s}\big\|=0.$$
The same statement holds with the $L^\infty$ slot at any of the three vertices (here `i`). -/
theorem intro_smoothing (α β : ℝ) (hβ : β ≠ 0) (ρ : ℝ² → ℝ) (hρ0 : ∀ x, 0 ≤ ρ x)
    (hρ : Integrable ρ) (hρ1 : ∫ x, ρ x = 1) (i : Fin 3) :
    Tendsto (fun ε : ℝ => ⨆ (s : ℝ) (_ : 0 < s),
      endNorm α β (((FCMeasure.sigma.conv
        (FCMeasure.ofDensity (fun x => (((ε ^ 2)⁻¹ * ρ (ε⁻¹ • x) : ℝ) : ℂ)))).sub
          FCMeasure.sigma).dil s) i)
      (𝓝[>] 0) (𝓝 0) :=
  tail_smoothing α β hβ ρ hρ0 hρ hρ1 i

