/-! ### A common core for nearby translates (`rig:common-core`) -/

/-- Auxiliary: the properties of the core $(F_h;Y_{0,h},Y_{1,h},Y_{2,h})$ for a single
translation $h$ in `\label{rig:common-core}` (see `Auto.rig_common_core`): it is a core of degree
$c/4$ with $F_h\subset E\cap E_h$, $Y_{j,h}\subset X_j\cap(X_j-h)$, and
$\mu(E\setminus F_h)=\mu(E_h\setminus F_h)\le4\eta(h)$, where $\eta(h)=\mu(E\setminus E_h)$.
Also used in `Auto.rig_translation_matrices`. -/
def aux_IsCommonCore (α β c : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (h : ℝ²)
    (F : Set (ℝ² × Ang)) (Y : Fin 3 → Set ℝ²) : Prop :=
  IsCore α β F Y (c / 4) ∧ F ⊆ E ∩ baseShift h E ∧
    (∀ j, Y j ⊆ X j ∩ aux_vertexShift h X j) ∧
    μinc (E \ F) = μinc (baseShift h E \ F) ∧ μinc (E \ F) ≤ 4 * μinc (E \ baseShift h E)

/-- **Lemma `rig:common-core`**.  Let $E$ be a core of degree $c$, and define
$$E_h=\{(x,\theta):(x+h,\theta)\in E\},\qquad \eta(h)=\mu(E\setminus E_h).$$
For all sufficiently small $h\in\mathbb R^2$, there is a core
$(F_h;Y_{0,h},Y_{1,h},Y_{2,h})$ of degree $c/4$, with
$$F_h\subset E\cap E_h,\qquad Y_{j,h}\subset X_j\cap(X_j-h),$$
such that
$$\mu(E\setminus F_h)=\mu(E_h\setminus F_h)\le4\eta(h),\qquad
|X_j\setminus Y_{j,h}|\longrightarrow0\quad(h\to0).$$ -/
theorem rig_common_core (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (c : ℝ)
    (hE : IsCore α β E X c) :
    ∃ (F : ℝ² → Set (ℝ² × Ang)) (Y : ℝ² → Fin 3 → Set ℝ²),
      (∀ᶠ h in 𝓝 (0 : ℝ²), aux_IsCommonCore α β c E X h (F h) (Y h)) ∧
      ∀ j, Tendsto (fun h => volume (X j \ Y h j)) (𝓝 0) (𝓝 0) := by
  sorry

/-! ### Translation matrices (`rig:translation-matrices`) -/

/-- The row $\Phi_j(z)=(\phi_j^1(z),\ldots,\phi_j^d(z))$ of an orthonormal basis
$\phi^1,\ldots,\phi^d$ of $K_E$, with the components extended by zero
(`\label{rig:translation-matrices}`). -/
def basisRow {α β : ℝ} {E : Set (ℝ² × Ang)} {X : Fin 3 → Set ℝ²} {d : ℕ}
    (b : OrthonormalBasis (Fin d) ℝ (kernelSpace α β E X)) (j : Fin 3) (z : ℝ²) : Fin d → ℝ :=
  fun i => (X j).indicator (((b i : HE X) j : Lp ℝ 2 (volume.restrict (X j))) : ℝ² → ℝ) z

/-- **Lemma `rig:translation-matrices`**.  Let $\phi^1,\ldots,\phi^d$ be an orthonormal basis of
$K_E$, and write
$$\Phi_j(z)=(\phi_j^1(z),\ldots,\phi_j^d(z)),$$
with the components extended by zero.  For sufficiently small $h$ there are sets $Y_{j,h}$ as in
Lemma `rig:common-core` and matrices $C(h)\in\operatorname{GL}_d(\mathbb R)$ such that
$$\Phi_j(z+h)=\Phi_j(z)C(h)\quad\text{for almost every }z\in Y_{j,h}.$$
On a sufficiently small neighborhood of zero these matrices form a continuous local
homomorphism:
$$C(0)=I,\qquad C(h+k)=C(h)C(k)$$
whenever $h,k,h+k$ lie in that neighborhood. -/
theorem rig_translation_matrices (α β : ℝ) (hβ : β ≠ 0) (E : Set (ℝ² × Ang))
    (X : Fin 3 → Set ℝ²) (c : ℝ) (hE : IsCore α β E X c) {d : ℕ}
    (b : OrthonormalBasis (Fin d) ℝ (kernelSpace α β E X)) :
    ∃ (F : ℝ² → Set (ℝ² × Ang)) (Y : ℝ² → Fin 3 → Set ℝ²) (C : ℝ² → Matrix (Fin d) (Fin d) ℝ),
      (∀ᶠ h in 𝓝 (0 : ℝ²), aux_IsCommonCore α β c E X h (F h) (Y h) ∧ IsUnit (C h) ∧
        ∀ j, ∀ᵐ z ∂(volume.restrict (Y h j)),
          basisRow b j (z + h) = Matrix.vecMul (basisRow b j z) (C h)) ∧
      (∀ j, Tendsto (fun h => volume (X j \ Y h j)) (𝓝 0) (𝓝 0)) ∧
      ∃ U ∈ 𝓝 (0 : ℝ²), ContinuousOn C U ∧ C 0 = 1 ∧
        ∀ h k, h ∈ U → k ∈ U → h + k ∈ U → C (h + k) = C h * C k := by
  sorry

/-! ### Analytic pieces for a scalar kernel (`rig:pieces`) -/

/-- **Proposition `rig:pieces`**.  Every positive-measure core $E$ has a measurable subset
$E'\subset E$ of positive measure such that each component of an orthonormal basis of $K_E$,
evaluated at its vertex, agrees on $E'$ with a real analytic function defined on all of
$\mathbb R^2$.

(Agreement on $E'$ is stated almost everywhere, sets being defined up to null sets.) -/
theorem rig_pieces (α β : ℝ) (hβ : β ≠ 0) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (c : ℝ)
    (hE : IsCore α β E X c) {d : ℕ} (b : OrthonormalBasis (Fin d) ℝ (kernelSpace α β E X)) :
    ∃ E' : Set (ℝ² × Ang), E' ⊆ E ∧ MeasurableSet E' ∧ 0 < μinc E' ∧
      ∃ g : Fin d → Fin 3 → ℝ² → ℝ, (∀ i j, AnalyticOnNhd ℝ (g i j) univ) ∧
        ∀ᵐ p ∂(μinc.restrict E'), ∀ i j, basisRow b j (proj α β j p) i = g i j (proj α β j p) := by
  sorry

/-! ### Rigidity for analytic fields (`rig:analytic-rigidity`) -/

/-- **Lemma `rig:analytic-rigidity`**.  Let $a_j:\mathbb R^2\to\mathbb R^2$ be real analytic and
suppose that, for every $(x,\theta)\in\mathbb R^2\times\mathbb T$,
$$\sum_{j=0}^2a_j(x+L_ju_\theta)=0,\qquad
v_\theta\cdot\bigl(a_1(x+u_\theta)+M^{\mathsf T}a_2(x+Mu_\theta)\bigr)=0.$$
Then
$$a_1(x+u_\theta)+M^{\mathsf T}a_2(x+Mu_\theta)=0\qquad\text{for every }(x,\theta).$$ -/
theorem rig_analytic_rigidity (α β : ℝ) (hβ : β ≠ 0) (a : Fin 3 → ℝ² → ℝ²)
    (ha : ∀ j, AnalyticOnNhd ℝ (a j) univ)
    (h₁ : ∀ (x : ℝ²) (θ : Ang), ∑ j, a j (x + Lv α β j (u θ)) = 0)
    (h₂ : ∀ (x : ℝ²) (θ : Ang),
      ⟪v θ, a 1 (x + u θ) + ContinuousLinearMap.adjoint (M α β) (a 2 (x + M α β (u θ)))⟫_ℝ = 0) :
    ∀ (x : ℝ²) (θ : Ang),
      a 1 (x + u θ) + ContinuousLinearMap.adjoint (M α β) (a 2 (x + M α β (u θ))) = 0 := by
  sorry

/-! ### Measurable stationarity forces zero displacement frequency (`rig:exact`) -/

/-- **Theorem `rig:exact`**.  Let $(E;X_0,X_1,X_2)$ be a core of positive degree, and let
$a_j\in L^2(X_j;\mathbb R^2)$ satisfy, for almost every $p=(x,\theta)\in E$,
$$\sum_{j=0}^2a_j(\pi_jp)=0,\qquad
v_\theta\cdot\bigl(a_1(\pi_1p)+M^{\mathsf T}a_2(\pi_2p)\bigr)=0.$$
Then
$$a_1(\pi_1p)+M^{\mathsf T}a_2(\pi_2p)=0\qquad\text{for almost every }p\in E.$$ -/
theorem rig_exact (α β : ℝ) (hβ : β ≠ 0) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (c : ℝ)
    (hE : IsCore α β E X c) (a : Fin 3 → ℝ² → ℝ²)
    (ha : ∀ j, MemLp (a j) 2 (volume.restrict (X j)))
    (h₁ : ∀ᵐ p ∂(μinc.restrict E), ∑ j, a j (proj α β j p) = 0)
    (h₂ : ∀ᵐ p ∂(μinc.restrict E),
      ⟪v p.2, a 1 (proj α β 1 p) + ContinuousLinearMap.adjoint (M α β) (a 2 (proj α β 2 p))⟫_ℝ
        = 0) :
    ∀ᵐ p ∂(μinc.restrict E),
      a 1 (proj α β 1 p) + ContinuousLinearMap.adjoint (M α β) (a 2 (proj α β 2 p)) = 0 := by
  sorry

