import Mathlib

/-!
# Finite words, binary density, and tilings

Formalization of the part of Section `sec:comb-prelim` ("Finite words, binary density, and
tilings") of the blueprint that precedes its subsection: the definitions `cj:def-words`,
`cj:insensitive` and the lemmas `cj:bookkeeping` through `cj:tile-two`.

## Conventions of the formalization

* The alphabet `[k] = {1, …, k}` is `Fin k`, via the relabeling `j ↦ j - 1`.  In particular,
  for `[3]` the letters `1, 2, 3` of the blueprint are `0, 1, 2 : Fin 3`; the letter `3` is
  `(2 : Fin 3)`, and the letters `i ∈ {1, 2}` are encoded by `i : Fin 2` (as `i.castSucc : Fin 3`).
* Words of length `n` over `[k]` are functions `Fin n → Fin k`; subsets of `[k]^n` are
  `Finset (Fin n → Fin k)`.
* An `m`-dimensional combinatorial subspace of `[k]^n`, together with its coordinate map
  `φ : [k]^m → [k]^n`, is Mathlib's `Combinatorics.Subspace (Fin m) (Fin k) (Fin n)`: its field
  `idxFun : Fin n → Fin k ⊕ Fin m` records, for every coordinate, either its fixed letter or the
  index `j` of the variable set `I_j` containing it, and `proper` says that every variable set is
  nonempty.  Its coercion to a function is the coordinate map `φ`.  (The labelling of the
  variable sets is part of the data; the blueprint fixes it by ordering by least coordinates.)
* A combinatorial line of `[k]^n` is Mathlib's `Combinatorics.Line (Fin k) (Fin n)` (a word over
  `[k] ∪ {variable}` using the variable at least once).
* Densities are real numbers.
-/

open Finset Function Combinatorics

noncomputable section

namespace Auto

/-! ### Words, subspaces, and uniform density (`cj:def-words`) -/

/-- The uniform density $\mu_{k,n}(A)=|A|/k^n$ of $A\subseteq[k]^n$
(part of `\label{cj:def-words}`). -/
def unifDensity {k n : ℕ} (A : Finset (Fin n → Fin k)) : ℝ :=
  (A.card : ℝ) / (k : ℝ) ^ n

/-- The point set $V=\phi([k]^m)$ of the combinatorial subspace with coordinate map
$\phi$ (part of `\label{cj:def-words}`). -/
def subspacePts {m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n)) : Finset (Fin n → Fin k) :=
  univ.image V

/-- The relative density $\mu_V(A)=|A\cap V|/|V|$ (part of `\label{cj:def-words}`). -/
def relDensity {m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n))
    (A : Finset (Fin n → Fin k)) : ℝ :=
  ((A ∩ subspacePts V).card : ℝ) / ((subspacePts V).card : ℝ)

/-- The inclusion $[2]^n\subseteq[3]^n$ of binary words into ternary words
(part of `\label{cj:def-words}`). -/
def binEmb {n : ℕ} (x : Fin n → Fin 2) : Fin n → Fin 3 :=
  fun j => (x j).castSucc

/-- The binary cube $[2]^n$, viewed as a subset of $[3]^n$ (part of `\label{cj:def-words}`). -/
def binaryCube (n : ℕ) : Finset (Fin n → Fin 3) :=
  univ.image (binEmb (n := n))

/-- The binary face $V^{(2)}=\phi([2]^m)$ of a subspace $V\subseteq[3]^n$; fixed letters of $V$
may still equal $3$ (part of `\label{cj:def-words}`). -/
def binaryFace {m n : ℕ} (V : Subspace (Fin m) (Fin 3) (Fin n)) : Finset (Fin n → Fin 3) :=
  univ.image fun x : Fin m → Fin 2 => V (binEmb x)

/-- The concatenation $x\frown y$ of words $x\in[k]^\ell$ and $y\in[k]^{n-\ell}$, a word of
length $n$ (for $\ell\le n$) (part of `\label{cj:def-words}`). -/
def concatW {k ℓ n : ℕ} (x : Fin ℓ → Fin k) (y : Fin (n - ℓ) → Fin k) : Fin n → Fin k :=
  fun i => if h : (i : ℕ) < ℓ then x ⟨i, h⟩ else y ⟨(i : ℕ) - ℓ, by omega⟩

/-- The suffix fiber $A_x=\{y\in[k]^{n-\ell}:x\frown y\in A\}$ of $A\subseteq[k]^n$ at
$x\in[k]^\ell$ (part of `\label{cj:def-words}`). -/
def suffixFiber {k ℓ n : ℕ} (A : Finset (Fin n → Fin k)) (x : Fin ℓ → Fin k) :
    Finset (Fin (n - ℓ) → Fin k) :=
  univ.filter fun y => concatW x y ∈ A

/-- $A$ contains an $m$-dimensional combinatorial subspace (part of `\label{cj:def-words}`). -/
def ContainsSubspace {k n : ℕ} (m : ℕ) (A : Finset (Fin n → Fin k)) : Prop :=
  ∃ V : Subspace (Fin m) (Fin k) (Fin n), ∀ x, V x ∈ A

/-- $A$ contains a combinatorial line (a one-dimensional subspace)
(part of `\label{cj:def-words}`). -/
def ContainsLine {k n : ℕ} (A : Finset (Fin n → Fin k)) : Prop :=
  ∃ l : Line (Fin k) (Fin n), ∀ a, l a ∈ A

/-! ### Subspace bookkeeping (`cj:bookkeeping`) -/

/-- The coordinate map of a subspace is injective (auxiliary for `cj_bookkeeping_card`). -/
theorem aux_subspace_injective {m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n)) :
    Injective V := by
  intro x y hxy
  funext e
  obtain ⟨i, hi⟩ := V.proper e
  have := congrFun hxy i
  rwa [Subspace.apply_inr hi, Subspace.apply_inr hi] at this

/-- **Lemma `cj:bookkeeping`** (part 1). An $m$-dimensional subspace has $k^m$ points. -/
theorem cj_bookkeeping_card {m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n)) :
    (subspacePts V).card = k ^ m := by
  rw [subspacePts, card_image_of_injective _ (aux_subspace_injective V)]
  simp

/-- **Lemma `cj:bookkeeping`** (part 2). The image of an $r$-dimensional subspace under the
coordinate map of an $m$-dimensional subspace is an $r$-dimensional subspace (with coordinate
map the composition). -/
theorem cj_bookkeeping_comp {r m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n))
    (W : Subspace (Fin r) (Fin k) (Fin m)) :
    ∃ U : Subspace (Fin r) (Fin k) (Fin n), ⇑U = ⇑V ∘ ⇑W := by
  refine ⟨⟨fun i => (V.idxFun i).elim Sum.inl W.idxFun, fun e => ?_⟩, ?_⟩
  · obtain ⟨j, hj⟩ := W.proper e
    obtain ⟨i, hi⟩ := V.proper j
    exact ⟨i, by simp [hi, hj]⟩
  · funext x i
    simp only [comp_apply, Subspace.coe_apply]
    cases h : V.idxFun i <;> simp [Subspace.coe_apply]

/-- **Lemma `cj:bookkeeping`** (part 3). Concatenating subspaces of dimensions $r$ and $s$ gives
a subspace of dimension $r+s$ (whose coordinate map is the concatenation of the coordinate
maps). -/
theorem cj_bookkeeping_concat {r s k a b : ℕ} (V : Subspace (Fin r) (Fin k) (Fin a))
    (W : Subspace (Fin s) (Fin k) (Fin b)) :
    ∃ U : Subspace (Fin (r + s)) (Fin k) (Fin (a + b)),
      ∀ x y, U (Fin.append x y) = Fin.append (V x) (W y) := by
  refine ⟨⟨Fin.append (fun i => (V.idxFun i).map id (Fin.castAdd s))
      (fun i => (W.idxFun i).map id (Fin.natAdd r)), fun e => ?_⟩, ?_⟩
  · refine Fin.addCases (fun e => ?_) (fun e => ?_) e
    · obtain ⟨i, hi⟩ := V.proper e
      exact ⟨Fin.castAdd b i, by simp [hi]⟩
    · obtain ⟨i, hi⟩ := W.proper e
      exact ⟨Fin.natAdd a i, by simp [hi]⟩
  · intro x y
    funext i
    refine Fin.addCases (fun i => ?_) (fun i => ?_) i
    · simp only [Subspace.coe_apply, Fin.append_left]
      cases V.idxFun i <;> simp
    · simp only [Subspace.coe_apply, Fin.append_right]
      cases W.idxFun i <;> simp

/-- **Lemma `cj:bookkeeping`** (part 4). There are at most $(k+m)^n$ $m$-dimensional subspaces
of $[k]^n$. -/
theorem cj_bookkeeping_count_subspaces (m k n : ℕ) :
    Nat.card (Subspace (Fin m) (Fin k) (Fin n)) ≤ (k + m) ^ n := by
  have hinj : Injective (fun V : Subspace (Fin m) (Fin k) (Fin n) => V.idxFun) := by
    rintro ⟨f, hf⟩ ⟨g, hg⟩ h
    simp only at h
    subst h
    rfl
  calc Nat.card (Subspace (Fin m) (Fin k) (Fin n))
      ≤ Nat.card (Fin n → Fin k ⊕ Fin m) := Nat.card_le_card_of_injective _ hinj
    _ = (k + m) ^ n := by simp

/-- **Lemma `cj:bookkeeping`** (part 5). There are at most $(k+1)^n$ combinatorial lines in
$[k]^n$. -/
theorem cj_bookkeeping_count_lines (k n : ℕ) :
    Nat.card (Line (Fin k) (Fin n)) ≤ (k + 1) ^ n := by
  have hinj : Injective (fun l : Line (Fin k) (Fin n) => l.idxFun) := by
    rintro ⟨f, hf⟩ ⟨g, hg⟩ h
    simp only at h
    subst h
    rfl
  calc Nat.card (Line (Fin k) (Fin n))
      ≤ Nat.card (Fin n → Option (Fin k)) := Nat.card_le_card_of_injective _ hinj
    _ = (k + 1) ^ n := by simp

/-! ### Binary density theorem (`cj:binary`) -/

/-- The constant $H_2(\alpha)=2\lceil\alpha^{-2}\rceil$ of `\label{cj:binary}`
(see `cj_binary`). -/
def C_cj_binary (α : ℝ) : ℕ := 2 * ⌈(α ^ 2)⁻¹⌉₊

/-- The bound $(r+1)\binom{2r}{r}^2\le 16^r$, i.e. $\binom{2r}{r}/4^r\le(r+1)^{-1/2}$
(auxiliary for `cj_binary`). -/
theorem aux_centralBinom_sq_le (r : ℕ) : (r + 1) * r.centralBinom ^ 2 ≤ 16 ^ r := by
  induction r with
  | zero => simp
  | succ r ih =>
    have h := Nat.succ_mul_centralBinom_succ r
    have key : (r + 1) ^ 3 * ((r + 1 + 1) * (r + 1).centralBinom ^ 2) ≤
        (r + 1) ^ 3 * 16 ^ (r + 1) := by
      calc (r + 1) ^ 3 * ((r + 1 + 1) * (r + 1).centralBinom ^ 2)
          = (r + 1) * (r + 2) * ((r + 1) * (r + 1).centralBinom) ^ 2 := by ring
        _ = 4 * (2 * r + 1) ^ 2 * (r + 2) * ((r + 1) * r.centralBinom ^ 2) := by
            rw [h]; ring
        _ ≤ 4 * (2 * r + 1) ^ 2 * (r + 2) * 16 ^ r := Nat.mul_le_mul_left _ ih
        _ ≤ (r + 1) ^ 3 * 16 ^ (r + 1) := by
            rw [pow_succ]
            have : 4 * (2 * r + 1) ^ 2 * (r + 2) ≤ (r + 1) ^ 3 * 16 := by ring_nf; omega
            calc 4 * (2 * r + 1) ^ 2 * (r + 2) * 16 ^ r ≤ (r + 1) ^ 3 * 16 * 16 ^ r :=
                  Nat.mul_le_mul_right _ this
              _ = _ := by ring
    exact Nat.le_of_mul_le_mul_left key (by positivity)

/-- The bound $(\lfloor n/2\rfloor+1)\binom{n}{\lfloor n/2\rfloor}^2\le 4^n$
(auxiliary for `cj_binary`). -/
theorem aux_choose_half_sq_le (n : ℕ) : (n / 2 + 1) * (n.choose (n / 2)) ^ 2 ≤ 4 ^ n := by
  obtain ⟨r, rfl | rfl⟩ := Nat.even_or_odd' n
  · have : 2 * r / 2 = r := by omega
    rw [this, ← Nat.centralBinom_eq_two_mul_choose, pow_mul]
    simpa using aux_centralBinom_sq_le r
  · have : (2 * r + 1) / 2 = r := by omega
    rw [this]
    have h2 : (2 * r + 1).choose r ≤ 2 * r.centralBinom := by
      rcases r with _ | r
      · simp
      · rw [Nat.choose_succ_succ']
        have h3 := Nat.choose_le_centralBinom r (r + 1)
        have h4 := Nat.choose_le_centralBinom (r + 1) (r + 1)
        omega
    calc (r + 1) * (2 * r + 1).choose r ^ 2 ≤ (r + 1) * (2 * r.centralBinom) ^ 2 := by gcongr
      _ = 4 * ((r + 1) * r.centralBinom ^ 2) := by ring
      _ ≤ 4 * 16 ^ r := Nat.mul_le_mul_left _ (aux_centralBinom_sq_le r)
      _ = 4 ^ (2 * r + 1) := by rw [pow_succ, pow_mul]; ring

/-- Case split on a binary letter (auxiliary for `cj_binary`). -/
theorem aux_fin_two (a : Fin 2) : a = 0 ∨ a = 1 := by
  rcases a with ⟨_ | _ | _, h⟩ <;> simp_all; omega

/-- The set $S(x)$ of coordinates of a binary word carrying the letter $2$
(encoded as `1 : Fin 2`) (auxiliary for `cj_binary`). -/
def aux_twoSet {n : ℕ} (x : Fin n → Fin 2) : Finset (Fin n) :=
  univ.filter fun j => x j = 1

/-- The map $x\mapsto S(x)$ is injective (auxiliary for `cj_binary`). -/
theorem aux_twoSet_injective (n : ℕ) : Injective (aux_twoSet (n := n)) := by
  intro x y h
  funext j
  have := congrArg (j ∈ ·) h
  simp only [aux_twoSet, mem_filter, mem_univ, true_and, eq_iff_iff] at this
  rcases aux_fin_two (x j) with hx | hx <;>
    rcases aux_fin_two (y j) with hy | hy <;> simp_all

/-- If $S(x)\subsetneq S(y)$, then $x,y$ span a combinatorial line, with $x$ at letter $1$ and
$y$ at letter $2$ (auxiliary for `cj_binary`). -/
theorem aux_line_of_ssubset {n : ℕ} {x y : Fin n → Fin 2}
    (h : aux_twoSet x ⊂ aux_twoSet y) : ∃ l : Line (Fin 2) (Fin n), l 0 = x ∧ l 1 = y := by
  obtain ⟨j, hjy, hjx⟩ := Finset.exists_of_ssubset h
  have hsub : ∀ i, x i = 1 → y i = 1 := fun i hx => by
    have := h.1 (by simp [aux_twoSet, hx] : i ∈ aux_twoSet x)
    simpa [aux_twoSet] using this
  refine ⟨⟨fun i => if x i = y i then some (x i) else none, ⟨j, ?_⟩⟩, ?_, ?_⟩
  · simp only [aux_twoSet, mem_filter, mem_univ, true_and] at hjy hjx
    simp [hjy, hjx]
  · funext i
    simp only [Line.coe_apply]
    split_ifs with hi
    · rfl
    · rcases aux_fin_two (x i) with hx | hx
      · exact hx.symm
      · exact absurd (hx.trans (hsub i hx).symm) hi
  · funext i
    simp only [Line.coe_apply]
    split_ifs with hi
    · exact hi
    · rcases aux_fin_two (y i) with hy | hy
      · rcases aux_fin_two (x i) with hx | hx
        · exact absurd (hx.trans hy.symm) hi
        · exact absurd ((hsub i hx).symm.trans hy) (by decide)
      · exact hy.symm

/-- A line-free set of binary words has at most $\binom{n}{\lfloor n/2\rfloor}$ elements
(Sperner's theorem; auxiliary for `cj_binary`). -/
theorem aux_card_le_of_lineFree {n : ℕ} (A : Finset (Fin n → Fin 2)) (hA : ¬ ContainsLine A) :
    A.card ≤ n.choose (n / 2) := by
  have hanti : IsAntichain (· ⊆ ·) (SetLike.coe (A.image aux_twoSet)) := by
    intro s hs t ht hst hsub
    simp only [coe_image, Set.mem_image, mem_coe] at hs ht
    obtain ⟨x, hx, rfl⟩ := hs
    obtain ⟨y, hy, rfl⟩ := ht
    obtain ⟨l, hl0, hl1⟩ := aux_line_of_ssubset (Finset.ssubset_iff_subset_ne.2 ⟨hsub, hst⟩)
    refine hA ⟨l, fun a => ?_⟩
    fin_cases a
    · simpa [hl0] using hx
    · simpa [hl1] using hy
  have := hanti.sperner
  rwa [card_image_of_injective _ (aux_twoSet_injective n), Fintype.card_fin] at this

/-- **Lemma `cj:binary`** (Binary density theorem).
For $0<\alpha\le1$, set $H_2(\alpha)=2\lceil\alpha^{-2}\rceil$.
If $n\ge H_2(\alpha)$ and $A\subseteq[2]^n$ has $\mu_{2,n}(A)\ge\alpha$, then $A$ contains a
combinatorial line. -/
theorem cj_binary {α : ℝ} (hα0 : 0 < α) (hα1 : α ≤ 1) {n : ℕ} (hn : C_cj_binary α ≤ n)
    (A : Finset (Fin n → Fin 2)) (hA : α ≤ unifDensity A) : ContainsLine A := by
  by_contra hfree
  have hcard := aux_card_le_of_lineFree A hfree
  have hsq := aux_choose_half_sq_le n
  have hr : ⌈(α ^ 2)⁻¹⌉₊ ≤ n / 2 := by
    rw [C_cj_binary] at hn; omega
  have hr' : (α ^ 2)⁻¹ < (n / 2 : ℕ) + 1 := by
    have := Nat.le_ceil (α ^ 2)⁻¹
    have : (⌈(α ^ 2)⁻¹⌉₊ : ℝ) ≤ (n / 2 : ℕ) := by exact_mod_cast hr
    linarith
  have h1 : 1 < α ^ 2 * ((n / 2 : ℕ) + 1) := by
    rw [inv_lt_iff_one_lt_mul₀ (by positivity)] at hr'
    linarith
  -- density bound
  have hpos : (0 : ℝ) < 2 ^ n := by positivity
  have hA' : α * 2 ^ n ≤ A.card := by
    rw [unifDensity, le_div_iff₀ (by norm_num [hpos])] at hA
    simpa using hA
  have hc : (A.card : ℝ) ≤ n.choose (n / 2) := by exact_mod_cast hcard
  have hsq' : ((n / 2 : ℕ) + 1 : ℝ) * (n.choose (n / 2) : ℝ) ^ 2 ≤ (2 ^ n) ^ 2 := by
    have : ((n / 2 + 1) * (n.choose (n / 2)) ^ 2 : ℕ) ≤ (4 ^ n : ℕ) := hsq
    have h4 : ((4 : ℝ) ^ n) = (2 ^ n) ^ 2 := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
    rw [← h4]; exact_mod_cast this
  have hαc : α * 2 ^ n ≤ n.choose (n / 2) := hA'.trans hc
  have : (α * 2 ^ n) ^ 2 * ((n / 2 : ℕ) + 1) ≤ (2 ^ n) ^ 2 := by
    calc (α * 2 ^ n) ^ 2 * ((n / 2 : ℕ) + 1) ≤ (n.choose (n / 2) : ℝ) ^ 2 * ((n / 2 : ℕ) + 1) := by
          gcongr
      _ ≤ _ := by linarith
  have : α ^ 2 * ((n / 2 : ℕ) + 1) * (2 ^ n) ^ 2 ≤ 1 * (2 ^ n) ^ 2 := by nlinarith
  have := le_of_mul_le_mul_right this (by positivity)
  linarith

/-! ### Multidimensional binary density theorem (`cj:binary-multi`) -/

/-- The recursive constant $B(m,\alpha)$ of `\label{cj:binary-multi}` (see `cj_binary_multi`):
$B(1,\alpha)=H_2(\alpha)$ and, with $M=H_2(\alpha/2)$,
$B(m+1,\alpha)=M+B(m,\alpha/(2\,3^M))$.  The value at $m=0$ is irrelevant. -/
def C_cj_binary_multi : ℕ → ℝ → ℕ
  | 0, _ => 0
  | 1, α => C_cj_binary α
  | m + 2, α =>
      C_cj_binary (α / 2) + C_cj_binary_multi (m + 1) (α / (2 * 3 ^ C_cj_binary (α / 2)))

/-- Summing the sizes of the suffix fibers $\{y : x\frown y\in A\}$ over all prefixes $x$ counts
$A$ (auxiliary averaging identity for `cj_binary_multi` and the later lemmas of
`sec:comb-prelim`). -/
theorem aux_sum_card_append_fiber {k a b : ℕ} (A : Finset (Fin (a + b) → Fin k)) :
    ∑ x : Fin a → Fin k, (univ.filter fun y : Fin b → Fin k => Fin.append x y ∈ A).card =
      A.card := by
  classical
  rw [card_eq_sum_card_fiberwise (f := fun z : Fin (a + b) → Fin k => fun i => z (Fin.castAdd b i))
    (t := univ) (fun _ _ => mem_univ _)]
  refine sum_congr rfl fun x _ => ?_
  refine card_nbij' (Fin.append x) (fun z i => z (Fin.natAdd a i)) ?_ ?_ ?_ ?_
  · intro y hy
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hy ⊢
    refine ⟨hy, ?_⟩
    funext i; simp
  · intro z hz
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hz ⊢
    obtain ⟨hz, rfl⟩ := hz
    simpa only [Fin.append_castAdd_natAdd] using hz
  · intro y _
    funext i; simp
  · intro z hz
    simp only [coe_filter, Set.mem_ofPred_eq] at hz
    obtain ⟨-, rfl⟩ := hz
    exact Fin.append_castAdd_natAdd

/-- A combinatorial line viewed as a one-dimensional subspace with parameter set `Fin 1`
(auxiliary for `cj_binary_multi`). -/
def aux_lineToSubspace {k n : ℕ} (l : Line (Fin k) (Fin n)) : Subspace (Fin 1) (Fin k) (Fin n) :=
  ⟨fun i => (l.idxFun i).elim (Sum.inr 0) Sum.inl, fun e => by
    obtain ⟨i, hi⟩ := l.proper
    exact ⟨i, by rw [hi, Fin.fin_one_eq_zero e]; rfl⟩⟩

/-- The coordinate map of `aux_lineToSubspace l` is `y ↦ l (y 0)`
(auxiliary for `cj_binary_multi`). -/
theorem aux_lineToSubspace_apply {k n : ℕ} (l : Line (Fin k) (Fin n)) (y : Fin 1 → Fin k) :
    aux_lineToSubspace l y = l (y 0) := by
  funext i
  simp only [aux_lineToSubspace, Subspace.coe_apply, Line.coe_apply]
  cases l.idxFun i <;> rfl

/-- The induction step of `cj_binary_multi`: if every subset of $[2]^a$ of density at least
$\alpha/(2\,3^M)$ contains an $m$-dimensional subspace and $M\ge H_2(\alpha/2)$, then every
subset of $[2]^{a+M}$ of density at least $\alpha$ contains an $(m+1)$-dimensional subspace. -/
theorem aux_binary_multi_step {m a M : ℕ} {α : ℝ} (hα0 : 0 < α) (hα1 : α ≤ 1)
    (hM : C_cj_binary (α / 2) ≤ M) (A : Finset (Fin (a + M) → Fin 2)) (hA : α ≤ unifDensity A)
    (hC : ∀ C : Finset (Fin a → Fin 2), α / (2 * 3 ^ M) ≤ unifDensity C → ContainsSubspace m C) :
    ContainsSubspace (m + 1) A := by
  classical
  set F : (Fin a → Fin 2) → Finset (Fin M → Fin 2) :=
    fun x => univ.filter fun y => Fin.append x y ∈ A with hF
  have hsum : ∑ x, (F x).card = A.card := aux_sum_card_append_fiber A
  set G : Finset (Fin a → Fin 2) := univ.filter fun x => α / 2 ≤ unifDensity (F x) with hGdef
  have h2a : (0 : ℝ) < 2 ^ a := by positivity
  have h2M : (0 : ℝ) < 2 ^ M := by positivity
  -- the good prefixes have density at least `α / 2`
  have hG : α / 2 * 2 ^ a ≤ (G.card : ℝ) := by
    have hA' : α * (2 ^ a * 2 ^ M) ≤ (A.card : ℝ) := by
      rw [unifDensity, le_div_iff₀ (by positivity)] at hA
      simpa [pow_add] using hA
    have hsplit := sum_filter_add_sum_filter_not univ (fun x => α / 2 ≤ unifDensity (F x))
      (fun x => ((F x).card : ℝ))
    have h1 : ∑ x ∈ G, ((F x).card : ℝ) ≤ G.card * 2 ^ M := by
      have : ∀ x ∈ G, ((F x).card : ℝ) ≤ 2 ^ M := by
        intro x _
        have := card_le_univ (F x)
        simp only [Fintype.card_fun, Fintype.card_fin] at this
        exact_mod_cast this
      simpa using sum_le_sum this
    have h2 : ∑ x ∈ univ.filter (fun x => ¬ α / 2 ≤ unifDensity (F x)), ((F x).card : ℝ) ≤
        2 ^ a * (α / 2 * 2 ^ M) := by
      calc _ ≤ ∑ x ∈ univ.filter (fun x => ¬ α / 2 ≤ unifDensity (F x)), α / 2 * 2 ^ M := by
            refine sum_le_sum fun x hx => ?_
            simp only [mem_filter, mem_univ, true_and, not_le, unifDensity,
              div_lt_iff₀ (by norm_num [h2M] : (0 : ℝ) < (2 : ℕ) ^ M)] at hx
            push_cast at hx
            exact hx.le
        _ ≤ ∑ x : Fin a → Fin 2, α / 2 * 2 ^ M :=
            sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun _ _ _ => by positivity
        _ = _ := by simp
    have h3 : (A.card : ℝ) = ∑ x, ((F x).card : ℝ) := by exact_mod_cast hsum.symm
    have : α * (2 ^ a * 2 ^ M) ≤ G.card * 2 ^ M + 2 ^ a * (α / 2 * 2 ^ M) := by
      rw [← hGdef] at hsplit; linarith
    have : α / 2 * 2 ^ a * 2 ^ M ≤ G.card * 2 ^ M := by nlinarith
    exact le_of_mul_le_mul_right this h2M
  -- every good fiber contains a line
  have hL : ∀ x ∈ G, ∃ l : Line (Fin 2) (Fin M), ∀ c, l c ∈ F x := by
    intro x hx
    simp only [hGdef, mem_filter, mem_univ, true_and] at hx
    exact cj_binary (by positivity) (by linarith) hM (F x) hx
  have hMpos : 0 < M := by
    have : 0 < ⌈((α / 2) ^ 2)⁻¹⌉₊ := Nat.ceil_pos.2 (by positivity)
    rw [C_cj_binary] at hM; omega
  have : Nonempty (Fin M) := ⟨⟨0, hMpos⟩⟩
  choose! L hL using hL
  -- pigeonhole over the at most `3 ^ M` lines
  set t := G.image L
  have ht : (t.card : ℝ) ≤ 3 ^ M := by
    have : t.card ≤ 3 ^ M := by
      calc t.card = (t.image Line.idxFun).card :=
            (card_image_of_injective _ (fun l l' h => Line.ext h)).symm
        _ ≤ (univ : Finset (Fin M → Option (Fin 2))).card := card_le_univ _
        _ = 3 ^ M := by simp
    exact_mod_cast this
  have hGne : G.Nonempty := by
    rw [← card_pos]
    have : (0 : ℝ) < G.card := lt_of_lt_of_le (by positivity) hG
    exact_mod_cast this
  have hb : t.card • (α / (2 * 3 ^ M) * 2 ^ a) ≤ (G.card : ℝ) := by
    rw [nsmul_eq_mul]
    calc (t.card : ℝ) * (α / (2 * 3 ^ M) * 2 ^ a) ≤ 3 ^ M * (α / (2 * 3 ^ M) * 2 ^ a) := by
          gcongr
      _ = α / 2 * 2 ^ a := by field_simp
      _ ≤ _ := hG
  obtain ⟨L0, -, hL0⟩ := exists_le_card_fiber_of_nsmul_le_card_of_maps_to
    (fun x hx => mem_image_of_mem L hx) (hGne.image L) hb
  set C := G.filter fun x => L x = L0
  have hCd : α / (2 * 3 ^ M) ≤ unifDensity C := by
    rw [unifDensity, le_div_iff₀ (by norm_num [h2a])]
    simpa using hL0
  obtain ⟨U, hU⟩ := hC C hCd
  obtain ⟨U', hU'⟩ := cj_bookkeeping_concat U (aux_lineToSubspace L0)
  refine ⟨U', fun z => ?_⟩
  rw [← Fin.append_castAdd_natAdd (f := z), hU', aux_lineToSubspace_apply]
  have hx := hU fun i => z (Fin.castAdd 1 i)
  simp only [C, mem_filter] at hx
  have := hL _ hx.1 (z (Fin.natAdd m 0))
  rw [hx.2] at this
  simpa [hF] using this

/-- **Lemma `cj:binary-multi`** (Multidimensional binary density theorem).
For every integer $m\ge1$ and $0<\alpha\le1$, there is an integer $B(m,\alpha)$ such that every
$A\subseteq[2]^n$ with $n\ge B(m,\alpha)$ and $\mu_{2,n}(A)\ge\alpha$ contains an
$m$-dimensional subspace.  One possible recursive choice is
$$B(1,\alpha)=H_2(\alpha),$$
$$M=H_2(\alpha/2),\qquad B(m+1,\alpha)=M+B\left(m,\frac{\alpha}{2\,3^M}\right).$$ -/
theorem cj_binary_multi {m : ℕ} (hm : 1 ≤ m) {α : ℝ} (hα0 : 0 < α) (hα1 : α ≤ 1) {n : ℕ}
    (hn : C_cj_binary_multi m α ≤ n) (A : Finset (Fin n → Fin 2))
    (hA : α ≤ unifDensity A) : ContainsSubspace m A := by
  obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  clear hm
  induction m generalizing α n A with
  | zero =>
    obtain ⟨l, hl⟩ := cj_binary hα0 hα1 hn A hA
    exact ⟨aux_lineToSubspace l, fun y => by rw [aux_lineToSubspace_apply]; exact hl _⟩
  | succ m ih =>
    set M := C_cj_binary (α / 2)
    have hn' : M + C_cj_binary_multi (m + 1) (α / (2 * 3 ^ M)) ≤ n := hn
    obtain ⟨a, rfl⟩ : ∃ a, n = a + M := ⟨n - M, by omega⟩
    refine aux_binary_multi_step hα0 hα1 le_rfl A hA fun C hC => ?_
    have h3 : (1 : ℝ) ≤ 3 ^ M := one_le_pow₀ (by norm_num)
    have h1 : α / (2 * 3 ^ M) ≤ 1 := by
      rw [div_le_one (by positivity)]; linarith
    exact ih (by positivity) h1 C hC (by omega)

/-! ### Uniform lower bounds for prefix fibers (`cj:fiber`) -/

/-- The constant $P(k,m,\varepsilon)=m\left(\left\lceil\frac{k^m-1}{\varepsilon}\right\rceil+2\right)$
of `\label{cj:fiber}` (see `cj_fiber`). -/
def C_cj_fiber (k m : ℕ) (ε : ℝ) : ℕ := m * (⌈((k : ℝ) ^ m - 1) / ε⌉₊ + 2)

/-- The prefix of length $\ell\le n$ of a word $w\in[k]^n$ (auxiliary for `cj_fiber` and
`cj_binary_face`). -/
def aux_pref {k n : ℕ} (ℓ : ℕ) (h : ℓ ≤ n) (w : Fin n → Fin k) : Fin ℓ → Fin k :=
  fun i => w (Fin.castLE h i)

/-- The prefix of $x\frown y$ of length $\ell$ is $x$ (auxiliary for `cj_fiber`). -/
theorem aux_pref_concatW {k ℓ n : ℕ} (h : ℓ ≤ n) (x : Fin ℓ → Fin k)
    (y : Fin (n - ℓ) → Fin k) : aux_pref ℓ h (concatW x y) = x := by
  funext i
  simp [aux_pref, concatW]

/-- A word is the concatenation of its prefix of length $\ell$ and the remaining suffix
(auxiliary for `cj_fiber`). -/
theorem aux_concatW_pref {k ℓ n : ℕ} (h : ℓ ≤ n) (w : Fin n → Fin k) :
    concatW (aux_pref ℓ h w) (fun j : Fin (n - ℓ) => w ⟨ℓ + j, by omega⟩) = w := by
  funext i
  simp only [concatW, aux_pref]
  split_ifs with hi
  · rfl
  · congr 1; ext; simp; omega

/-- The suffix fiber $A_x$ is in bijection with the words of $A$ with prefix $x$
(auxiliary for `cj_fiber`). -/
theorem aux_card_suffixFiber {k ℓ n : ℕ} (h : ℓ ≤ n) (A : Finset (Fin n → Fin k))
    (x : Fin ℓ → Fin k) :
    (suffixFiber A x).card = (A.filter fun w => aux_pref ℓ h w = x).card := by
  refine card_nbij' (concatW x) (fun w j => w ⟨ℓ + j, by omega⟩) ?_ ?_ ?_ ?_
  · intro y hy
    simp only [suffixFiber, coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hy ⊢
    exact ⟨hy, aux_pref_concatW h x y⟩
  · intro w hw
    simp only [suffixFiber, coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hw ⊢
    obtain ⟨hw, rfl⟩ := hw
    rwa [aux_concatW_pref]
  · intro y _
    funext j
    simp only [concatW]
    rw [dif_neg (by simp)]
    congr 1; ext; simp
  · intro w hw
    simp only [coe_filter, Set.mem_ofPred_eq] at hw
    obtain ⟨-, rfl⟩ := hw
    exact aux_concatW_pref h w

/-- Splitting the words with prefix $x\in[k]^\ell$ according to their prefix of length
$\ell+m$ (auxiliary for `cj_fiber`). -/
theorem aux_card_pref_split {k ℓ m n : ℕ} (h : ℓ + m ≤ n) (A : Finset (Fin n → Fin k))
    (x : Fin ℓ → Fin k) :
    (A.filter fun w => aux_pref ℓ (by omega) w = x).card =
      ∑ x' ∈ univ.filter (fun x' : Fin (ℓ + m) → Fin k => aux_pref ℓ (by omega) x' = x),
        (A.filter fun w => aux_pref (ℓ + m) h w = x').card := by
  rw [card_eq_sum_card_fiberwise (f := aux_pref (ℓ + m) h)]
  · refine sum_congr rfl fun x' hx' => ?_
    simp only [mem_filter, mem_univ, true_and] at hx'
    congr 1
    ext w
    simp only [mem_filter]
    constructor
    · rintro ⟨⟨hw, -⟩, h2⟩; exact ⟨hw, h2⟩
    · rintro ⟨hw, h2⟩
      refine ⟨⟨hw, ?_⟩, h2⟩
      rw [← hx', ← h2]; rfl
  · intro w hw
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hw ⊢
    rw [← hw.2]; rfl

/-- The number of extensions of $x\in[k]^\ell$ to a word of length $\ell+m$ is $k^m$
(auxiliary for `cj_fiber`). -/
theorem aux_card_extensions {k ℓ m : ℕ} (x : Fin ℓ → Fin k) :
    (univ.filter fun x' : Fin (ℓ + m) → Fin k => aux_pref ℓ (by omega) x' = x).card = k ^ m := by
  rw [← aux_card_suffixFiber, suffixFiber, filter_true_of_mem (fun y _ => mem_univ _)]
  simp

/-- The prefix subspace $\{x\frown z: z\in[k]^m\}\subseteq[k]^{\ell+m}$ (auxiliary for
`cj_fiber`). -/
def aux_prefSubspace {k ℓ : ℕ} (m : ℕ) (x : Fin ℓ → Fin k) :
    Subspace (Fin m) (Fin k) (Fin (ℓ + m)) :=
  ⟨fun i => if h : (i : ℕ) < ℓ then Sum.inl (x ⟨i, h⟩) else Sum.inr ⟨i - ℓ, by omega⟩,
    fun e => ⟨⟨ℓ + e, by omega⟩, by simp⟩⟩

/-- Every point of the prefix subspace has prefix $x$ (auxiliary for `cj_fiber`). -/
theorem aux_pref_prefSubspace {k ℓ m : ℕ} (x : Fin ℓ → Fin k) (z : Fin m → Fin k) :
    aux_pref ℓ (by omega) (aux_prefSubspace m x z) = x := by
  funext i
  simp [aux_pref, aux_prefSubspace, Subspace.coe_apply]

/-- One stage of the construction in the proof of `cj_fiber`: if $\mu(A_x)\ge\alpha$, then
either all extensions $x\frown z$ ($z\in[k]^m$) have fiber density at least $\alpha-\varepsilon$,
or some extension has fiber density greater than $\mu(A_x)+\rho$, where
$\rho=\varepsilon/(k^m-1)$. -/
theorem aux_fiber_step {k m ℓ n : ℕ} (hk : 2 ≤ k) (hm : 1 ≤ m) (h : ℓ + m ≤ n)
    (A : Finset (Fin n → Fin k)) {α ε : ℝ} (hε : 0 < ε) (x : Fin ℓ → Fin k)
    (hx : α ≤ unifDensity (suffixFiber A x)) :
    (∀ u ∈ subspacePts (aux_prefSubspace m x), α - ε ≤ unifDensity (suffixFiber A u)) ∨
      ∃ x' : Fin (ℓ + m) → Fin k,
        unifDensity (suffixFiber A x) + ε / ((k : ℝ) ^ m - 1) < unifDensity (suffixFiber A x') := by
  classical
  set Ch := univ.filter fun x' : Fin (ℓ + m) → Fin k => aux_pref ℓ (by omega) x' = x with hCh
  have hk2 : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have hk0 : (0 : ℝ) < k := by linarith
  have hKm : (2 : ℝ) ≤ (k : ℝ) ^ m := by
    calc (2 : ℝ) ≤ k := hk2
      _ = (k : ℝ) ^ 1 := (pow_one _).symm
      _ ≤ (k : ℝ) ^ m := pow_le_pow_right₀ (by linarith) hm
  -- averaging identity
  have hsum : ∑ x' ∈ Ch, unifDensity (suffixFiber A x') =
      (k : ℝ) ^ m * unifDensity (suffixFiber A x) := by
    have e1 : (suffixFiber A x).card = ∑ x' ∈ Ch, (suffixFiber A x').card := by
      rw [aux_card_suffixFiber (by omega), aux_card_pref_split h]
      refine sum_congr rfl fun x' _ => ?_
      rw [aux_card_suffixFiber h]
    have e2 : (k : ℝ) ^ (n - ℓ) = (k : ℝ) ^ (n - (ℓ + m)) * (k : ℝ) ^ m := by
      rw [← pow_add]; congr 1; omega
    simp only [unifDensity]
    rw [← sum_div, e1, e2]
    push_cast
    have hpos : (k : ℝ) ^ m ≠ 0 := by positivity
    rw [← div_div, mul_div_cancel₀ _ hpos]
  by_cases hall : ∀ x' ∈ Ch, α - ε ≤ unifDensity (suffixFiber A x')
  · left
    intro u hu
    obtain ⟨z, -, rfl⟩ := mem_image.1 hu
    exact hall _ (by simp [hCh, aux_pref_prefSubspace])
  · right
    push Not at hall
    obtain ⟨x0, hx0, hlow⟩ := hall
    by_contra hno
    push Not at hno
    have hcard : (Ch.card : ℝ) = (k : ℝ) ^ m := by
      rw [hCh, aux_card_extensions]; push_cast; rfl
    have hrest : ∑ x' ∈ Ch.erase x0, unifDensity (suffixFiber A x') ≤
        ((k : ℝ) ^ m - 1) * (unifDensity (suffixFiber A x) + ε / ((k : ℝ) ^ m - 1)) := by
      calc _ ≤ ∑ x' ∈ Ch.erase x0, (unifDensity (suffixFiber A x) + ε / ((k : ℝ) ^ m - 1)) :=
            sum_le_sum fun x' _ => hno x'
        _ = _ := by
            rw [sum_const, card_erase_of_mem hx0, nsmul_eq_mul, Nat.cast_sub
              (card_pos.2 ⟨x0, hx0⟩), hcard]
            simp
    rw [← add_sum_erase _ _ hx0] at hsum
    have : ((k : ℝ) ^ m - 1) * (ε / ((k : ℝ) ^ m - 1)) = ε := by
      have hK1 : (k : ℝ) ^ m - 1 ≠ 0 := by linarith
      field_simp
    nlinarith

/-- **Lemma `cj:fiber`** (Uniform lower bounds for prefix fibers).
For $k\ge2$, $m\ge1$, and $0<\varepsilon<1$, define
$$P(k,m,\varepsilon)=m\left(\left\lceil\frac{k^m-1}{\varepsilon}\right\rceil+2\right).$$
If $n\ge P(k,m,\varepsilon)$ and $A\subseteq[k]^n$, there are $\ell<n$ and an $m$-dimensional
subspace $U\subseteq[k]^\ell$ such that
$$\mu_{k,n-\ell}(A_u)\ge\mu_{k,n}(A)-\varepsilon\qquad(u\in U).$$ -/
theorem cj_fiber {k m : ℕ} (hk : 2 ≤ k) (hm : 1 ≤ m) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε < 1)
    {n : ℕ} (hn : C_cj_fiber k m ε ≤ n) (A : Finset (Fin n → Fin k)) :
    ∃ ℓ < n, ∃ U : Subspace (Fin m) (Fin k) (Fin ℓ),
      ∀ u ∈ subspacePts U, unifDensity A - ε ≤ unifDensity (suffixFiber A u) := by
  classical
  set α := unifDensity A
  set J := ⌈((k : ℝ) ^ m - 1) / ε⌉₊ with hJ
  set ρ := ε / ((k : ℝ) ^ m - 1) with hρ
  have hk2 : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have hk0 : (0 : ℝ) < k := by linarith
  have hKm : (2 : ℝ) ≤ (k : ℝ) ^ m := by
    calc (2 : ℝ) ≤ k := hk2
      _ = (k : ℝ) ^ 1 := (pow_one _).symm
      _ ≤ (k : ℝ) ^ m := pow_le_pow_right₀ (by linarith) hm
  have hρ0 : 0 < ρ := div_pos hε0 (by linarith)
  have hJρ : 1 ≤ J * ρ := by
    have : ((k : ℝ) ^ m - 1) / ε ≤ J := Nat.le_ceil _
    rw [hρ]
    have hK1 : (k : ℝ) ^ m - 1 ≠ 0 := by linarith
    calc (1 : ℝ) = ((k : ℝ) ^ m - 1) / ε * (ε / ((k : ℝ) ^ m - 1)) := by
          field_simp
      _ ≤ J * (ε / ((k : ℝ) ^ m - 1)) := by gcongr
  have hnJ : (J + 1) * m < n := by
    have : C_cj_fiber k m ε = m * (J + 2) := rfl
    nlinarith
  have hα0 : 0 ≤ α := by unfold α unifDensity; positivity
  -- densities are at most one
  have hle1 : ∀ {ℓ} (x : Fin ℓ → Fin k), unifDensity (suffixFiber A x) ≤ 1 := by
    intro ℓ x
    rw [unifDensity, div_le_one (by positivity)]
    have := card_le_univ (suffixFiber A x)
    simp only [Fintype.card_fun, Fintype.card_fin] at this
    exact_mod_cast this
  -- the iteration
  have claim : ∀ j, j ≤ J + 1 →
      (∃ ℓ < n, ∃ U : Subspace (Fin m) (Fin k) (Fin ℓ),
        ∀ u ∈ subspacePts U, α - ε ≤ unifDensity (suffixFiber A u)) ∨
      ∃ ℓ, ℓ = j * m ∧ ∃ x : Fin ℓ → Fin k, α + j * ρ ≤ unifDensity (suffixFiber A x) := by
    intro j
    induction j with
    | zero =>
      intro _
      right
      refine ⟨0, by simp, Fin.elim0, ?_⟩
      have h1 : (suffixFiber A (Fin.elim0 : Fin 0 → Fin k)).card = A.card := by
        rw [aux_card_suffixFiber (Nat.zero_le n)]
        congr 1
        exact filter_true_of_mem fun w _ => funext fun i => i.elim0
      simp [unifDensity, h1, α]
    | succ j ih =>
      intro hj
      rcases ih (by omega) with hc | ⟨ℓ, hℓ, x, hx⟩
      · exact Or.inl hc
      · have hlen : ℓ + m ≤ n := by subst hℓ; nlinarith
        have hjρ : (0 : ℝ) ≤ j * ρ := by positivity
        rcases aux_fiber_step hk hm hlen A (α := α) hε0 x
          (le_trans (by linarith) hx) with h1 | ⟨x', hx'⟩
        · left
          refine ⟨ℓ + m, ?_, _, h1⟩
          subst hℓ; nlinarith
        · right
          refine ⟨ℓ + m, by rw [hℓ]; ring, x', ?_⟩
          push_cast
          linarith
  rcases claim (J + 1) le_rfl with hc | ⟨ℓ, -, x, hx⟩
  · exact hc
  · exfalso
    have := hle1 x
    push_cast at hx
    nlinarith

/-! ### A binary face in a dense ternary cube (`cj:binary-face`) -/

/-- The constant $F_2(d,\alpha)=P(3,M,\alpha/2)$, $M=B(d,\alpha/2)$, of
`\label{cj:binary-face}` (see `cj_binary_face`). -/
def C_cj_binary_face (d : ℕ) (α : ℝ) : ℕ :=
  C_cj_fiber 3 (C_cj_binary_multi d (α / 2)) (α / 2)

/-- The constant $B(m,\beta)$ is positive for $m\ge1$, $\beta>0$ (auxiliary for
`cj_binary_face`). -/
theorem aux_C_cj_binary_multi_pos {m : ℕ} (hm : 1 ≤ m) {β : ℝ} (hβ : 0 < β) :
    1 ≤ C_cj_binary_multi m β := by
  have hb : ∀ γ : ℝ, 0 < γ → 1 ≤ C_cj_binary γ := by
    intro γ hγ
    have : 0 < ⌈(γ ^ 2)⁻¹⌉₊ := Nat.ceil_pos.2 (by positivity)
    rw [C_cj_binary]; omega
  match m, hm with
  | 1, _ => exact hb β hβ
  | m + 2, _ =>
    have := hb (β / 2) (by positivity)
    simp only [C_cj_binary_multi]
    omega

/-- A binary subspace of $[2]^M$ viewed as a ternary subspace of $[3]^M$ with the same fixed
letters and variable sets (auxiliary for `cj_binary_face`). -/
def aux_binToTern {d M : ℕ} (W : Subspace (Fin d) (Fin 2) (Fin M)) :
    Subspace (Fin d) (Fin 3) (Fin M) :=
  ⟨fun i => (W.idxFun i).map Fin.castSucc id, fun e => by
    obtain ⟨i, hi⟩ := W.proper e
    exact ⟨i, by simp [hi]⟩⟩

/-- On binary parameter words, `aux_binToTern W` agrees with `W` (auxiliary for
`cj_binary_face`). -/
theorem aux_binToTern_binEmb {d M : ℕ} (W : Subspace (Fin d) (Fin 2) (Fin M))
    (z : Fin d → Fin 2) : aux_binToTern W (binEmb z) = binEmb (W z) := by
  funext i
  simp only [aux_binToTern, Subspace.coe_apply, binEmb]
  cases W.idxFun i <;> rfl

/-- Appending a fixed suffix $y$ to a subspace of $[k]^\ell$ gives a subspace of $[k]^n$
(auxiliary for `cj_binary_face`; an instance of `cj_bookkeeping_concat` with a
zero-dimensional factor). -/
def aux_appendSuffix {d k ℓ n : ℕ} (U : Subspace (Fin d) (Fin k) (Fin ℓ)) (hℓ : ℓ ≤ n)
    (y : Fin (n - ℓ) → Fin k) : Subspace (Fin d) (Fin k) (Fin n) :=
  ⟨fun i => if h : (i : ℕ) < ℓ then U.idxFun ⟨i, h⟩ else Sum.inl (y ⟨i - ℓ, by omega⟩),
    fun e => by
      obtain ⟨i, hi⟩ := U.proper e
      exact ⟨Fin.castLE hℓ i, by simp [hi]⟩⟩

/-- The coordinate map of `aux_appendSuffix U hℓ y` is $x\mapsto U(x)\frown y$ (auxiliary for
`cj_binary_face`). -/
theorem aux_appendSuffix_apply {d k ℓ n : ℕ} (U : Subspace (Fin d) (Fin k) (Fin ℓ))
    (hℓ : ℓ ≤ n) (y : Fin (n - ℓ) → Fin k) (x : Fin d → Fin k) :
    aux_appendSuffix U hℓ y x = concatW (U x) y := by
  funext i
  simp only [aux_appendSuffix, Subspace.coe_apply, concatW]
  split_ifs <;> rfl

/-- **Lemma `cj:binary-face`** (A binary face in a dense ternary cube).
For $d\ge1$ and $0<\alpha\le1$, put $M=B(d,\alpha/2)$, $F_2(d,\alpha)=P(3,M,\alpha/2)$.
If $n\ge F_2(d,\alpha)$ and $A\subseteq[3]^n$ has $\mu_{3,n}(A)\ge\alpha$, there is a
$d$-dimensional ternary subspace $V$ such that $V^{(2)}\subseteq A$. -/
theorem cj_binary_face {d : ℕ} (hd : 1 ≤ d) {α : ℝ} (hα0 : 0 < α) (hα1 : α ≤ 1) {n : ℕ}
    (hn : C_cj_binary_face d α ≤ n) (A : Finset (Fin n → Fin 3)) (hA : α ≤ unifDensity A) :
    ∃ V : Subspace (Fin d) (Fin 3) (Fin n), binaryFace V ⊆ A := by
  classical
  set M := C_cj_binary_multi d (α / 2) with hMdef
  have hM : 1 ≤ M := aux_C_cj_binary_multi_pos hd (by positivity)
  obtain ⟨ℓ, hℓn, U, hU⟩ := cj_fiber (k := 3) (m := M) (by norm_num) hM (ε := α / 2) (by positivity)
    (by linarith) hn A
  have hℓ : ℓ ≤ n := hℓn.le
  -- every fiber above the binary face of `U` has density at least `α / 2`
  have h3 : (0 : ℝ) < 3 ^ (n - ℓ) := by positivity
  have hfib : ∀ x : Fin M → Fin 2,
      α / 2 * 3 ^ (n - ℓ) ≤ ((suffixFiber A (U (binEmb x))).card : ℝ) := by
    intro x
    have := hU _ (mem_image_of_mem _ (mem_univ (binEmb x)))
    rw [← le_div_iff₀ h3]
    have h2 : unifDensity (suffixFiber A (U (binEmb x))) =
        ((suffixFiber A (U (binEmb x))).card : ℝ) / 3 ^ (n - ℓ) := by
      simp [unifDensity]
    linarith
  -- double counting
  have hdc : ∑ x : Fin M → Fin 2, (suffixFiber A (U (binEmb x))).card =
      ∑ y : Fin (n - ℓ) → Fin 3,
        (univ.filter fun x : Fin M → Fin 2 => concatW (U (binEmb x)) y ∈ A).card := by
    simp only [suffixFiber, card_filter]
    exact sum_comm
  have hsum : ∑ _y : Fin (n - ℓ) → Fin 3, α / 2 * 2 ^ M ≤
      ∑ y : Fin (n - ℓ) → Fin 3,
        ((univ.filter fun x : Fin M → Fin 2 => concatW (U (binEmb x)) y ∈ A).card : ℝ) := by
    have := congrArg (fun t : ℕ => (t : ℝ)) hdc
    simp only [Nat.cast_sum] at this
    rw [← this, sum_const, card_univ]
    calc _ = ∑ _x : Fin M → Fin 2, α / 2 * 3 ^ (n - ℓ) := by
          rw [sum_const, card_univ]; simp; ring
      _ ≤ _ := sum_le_sum fun x _ => hfib x
  obtain ⟨y, -, hy⟩ := exists_le_of_sum_le univ_nonempty hsum
  set B := univ.filter fun x : Fin M → Fin 2 => concatW (U (binEmb x)) y ∈ A
  have hB : α / 2 ≤ unifDensity B := by
    rw [unifDensity, le_div_iff₀ (by positivity)]
    push_cast; exact hy
  obtain ⟨W, hW⟩ := cj_binary_multi hd (by positivity) (by linarith) le_rfl B hB
  obtain ⟨U2, hU2⟩ := cj_bookkeeping_comp U (aux_binToTern W)
  refine ⟨aux_appendSuffix U2 hℓ y, ?_⟩
  intro w hw
  obtain ⟨z, -, rfl⟩ := mem_image.1 hw
  rw [aux_appendSuffix_apply, hU2, comp_apply, aux_binToTern_binEmb]
  have := hW z
  simpa [B] using this

/-! ### Insensitive sets (`cj:insensitive`) -/

/-- Two words in $[3]^n$ are $(i,3)$-equivalent if, at each coordinate, either their letters are
equal or both letters belong to $\{i,3\}$ (part of `\label{cj:insensitive}`).  Here
$i\in\{1,2\}$ is encoded by `i : Fin 2` and the letter $3$ is `(2 : Fin 3)`. -/
def InsEquiv {n : ℕ} (i : Fin 2) (x y : Fin n → Fin 3) : Prop :=
  ∀ j, x j = y j ∨ ((x j = i.castSucc ∨ x j = 2) ∧ (y j = i.castSucc ∨ y j = 2))

/-- A set $D\subseteq[3]^n$ is $(i,3)$-insensitive if it is a union of $(i,3)$-equivalence
classes, i.e. membership in $D$ is constant on these classes (part of `\label{cj:insensitive}`). -/
def IsInsensitive {n : ℕ} (i : Fin 2) (D : Finset (Fin n → Fin 3)) : Prop :=
  ∀ x y, InsEquiv i x y → (x ∈ D ↔ y ∈ D)

/-- A subset $D$ of a subspace $V$ is $(i,3)$-insensitive in $V$ when its inverse image under
the coordinate map is $(i,3)$-insensitive (part of `\label{cj:insensitive}`). -/
def IsInsensitiveIn {m n : ℕ} (i : Fin 2) (V : Subspace (Fin m) (Fin 3) (Fin n))
    (D : Finset (Fin n → Fin 3)) : Prop :=
  IsInsensitive i (univ.filter fun x => V x ∈ D)

/-! ### Elementary properties of insensitivity (`cj:insensitive-facts`) -/

/-- **Lemma `cj:insensitive-facts`** (part 1: unions). Unions of $(i,3)$-insensitive sets are
$(i,3)$-insensitive. -/
theorem cj_insensitive_facts_union {n : ℕ} {i : Fin 2} {D E : Finset (Fin n → Fin 3)}
    (hD : IsInsensitive i D) (hE : IsInsensitive i E) : IsInsensitive i (D ∪ E) := by
  intro x y h
  simp only [mem_union, hD x y h, hE x y h]

/-- **Lemma `cj:insensitive-facts`** (part 1: intersections). Intersections of
$(i,3)$-insensitive sets are $(i,3)$-insensitive. -/
theorem cj_insensitive_facts_inter {n : ℕ} {i : Fin 2} {D E : Finset (Fin n → Fin 3)}
    (hD : IsInsensitive i D) (hE : IsInsensitive i E) : IsInsensitive i (D ∩ E) := by
  intro x y h
  simp only [mem_inter, hD x y h, hE x y h]

/-- **Lemma `cj:insensitive-facts`** (part 1: complements). Complements of $(i,3)$-insensitive
sets are $(i,3)$-insensitive. -/
theorem cj_insensitive_facts_compl {n : ℕ} {i : Fin 2} {D : Finset (Fin n → Fin 3)}
    (hD : IsInsensitive i D) : IsInsensitive i Dᶜ := by
  intro x y h
  simp only [mem_compl, hD x y h]

/-- **Lemma `cj:insensitive-facts`** (part 2). Fixing any collection of coordinates preserves
insensitivity on the remaining coordinates.  Here the coordinates `Fin n` are split by a
bijection `e : Fin r ⊕ Fin s ≃ Fin n` into the `r` remaining coordinates and the `s` fixed
coordinates, which carry the fixed letters `y`. -/
theorem cj_insensitive_facts_fix {n r s : ℕ} {i : Fin 2} {D : Finset (Fin n → Fin 3)}
    (hD : IsInsensitive i D) (e : Fin r ⊕ Fin s ≃ Fin n) (y : Fin s → Fin 3) :
    IsInsensitive i
      (univ.filter fun x : Fin r → Fin 3 => (fun j => Sum.elim x y (e.symm j)) ∈ D) := by
  intro x x' h
  simp only [mem_filter, mem_univ, true_and]
  apply hD
  intro j
  dsimp only
  rcases e.symm j with a | b
  · simpa using h a
  · simp

/-- **Lemma `cj:insensitive-facts`** (part 3). The inverse image of an $(i,3)$-insensitive set
under any subspace coordinate map is $(i,3)$-insensitive. -/
theorem cj_insensitive_facts_preimage {m n : ℕ} {i : Fin 2} {D : Finset (Fin n → Fin 3)}
    (hD : IsInsensitive i D) (V : Subspace (Fin m) (Fin 3) (Fin n)) :
    IsInsensitive i (univ.filter fun x => V x ∈ D) := by
  intro x x' h
  simp only [mem_filter, mem_univ, true_and]
  apply hD
  intro j
  simp only [Subspace.coe_apply]
  cases V.idxFun j with
  | inl a => simp
  | inr b => simpa using h b

/-- **Lemma `cj:insensitive-facts`** (part 4). If $D$ is $(i,3)$-insensitive and
$V^{(2)}\subseteq D$, then $V\subseteq D$. -/
theorem cj_insensitive_facts_face {m n : ℕ} {i : Fin 2} {D : Finset (Fin n → Fin 3)}
    (hD : IsInsensitive i D) (V : Subspace (Fin m) (Fin 3) (Fin n))
    (hV : binaryFace V ⊆ D) : subspacePts V ⊆ D := by
  intro z hz
  obtain ⟨x, -, rfl⟩ := mem_image.1 hz
  -- replace every parameter equal to `3` by `i`
  set x' : Fin m → Fin 2 := fun j => if h : (x j : ℕ) < 2 then ⟨x j, h⟩ else i with hx'
  have hmem : V (binEmb x') ∈ D := hV (mem_image.2 ⟨x', mem_univ _, rfl⟩)
  refine (hD _ _ ?_).1 hmem
  have key : ∀ j, binEmb x' j = x j ∨
      ((binEmb x' j = i.castSucc ∨ binEmb x' j = 2) ∧ (x j = i.castSucc ∨ x j = 2)) := by
    intro j
    by_cases h : (x j : ℕ) < 2
    · left
      have h1 : (x j : ℕ) ≤ 1 := by omega
      simp [binEmb, hx', h1]
    · right
      have : x j = 2 := by
        apply Fin.ext; simp only [Fin.isValue, Fin.val_two]; omega
      simp [binEmb, hx', this]
  intro j
  simp only [Subspace.coe_apply]
  cases V.idxFun j with
  | inl a => simp
  | inr b => simpa using key b

/-! ### Tiling one insensitive set (`cj:tile-one`) -/

/-- The constant $T_1(d,\varepsilon)=LM$ of `\label{cj:tile-one}` (see `cj_tile_one`), where
$\beta=\varepsilon/2$, $M=F_2(d,\beta)$, $Q=(3+d)^M$, $\vartheta=\frac{\beta}{Q}\,3^{d-M}$ and
$L=\lceil\vartheta^{-1}\rceil+1$. -/
def C_cj_tile_one (d : ℕ) (ε : ℝ) : ℕ :=
  let β : ℝ := ε / 2
  let M : ℕ := C_cj_binary_face d β
  let Q : ℕ := (3 + d) ^ M
  let ϑ : ℝ := β / Q * (3 : ℝ) ^ ((d : ℤ) - M)
  let L : ℕ := ⌈ϑ⁻¹⌉₊ + 1
  L * M

/-- The word obtained from $w\in[3]^n$ by writing $z\in[3]^M$ on the block of coordinates
$[a,a+M)$; in the proof of `cj:tile-one` the word $x\frown z\frown y$ is `aux_put a M h w z`
when $w=x\frown z'\frown y$ (auxiliary for `cj_tile_one`). -/
def aux_put {n : ℕ} (a M : ℕ) (_h : a + M ≤ n) (w : Fin n → Fin 3) (z : Fin M → Fin 3) :
    Fin n → Fin 3 :=
  fun j => if h' : a ≤ (j : ℕ) ∧ (j : ℕ) < a + M then z ⟨j - a, by omega⟩ else w j

/-- The middle block $z$ of $w=x\frown z\frown y$, i.e. the letters on the coordinates
$[a,a+M)$ (auxiliary for `cj_tile_one`). -/
def aux_block {n : ℕ} (a M : ℕ) (h : a + M ≤ n) (w : Fin n → Fin 3) : Fin M → Fin 3 :=
  fun i => w ⟨a + i, by omega⟩

/-- The context (the pair $(x,y)$) of $w=x\frown z\frown y$, encoded as the word with the
middle block cleared to the letter `0` (auxiliary for `cj_tile_one`). -/
def aux_clear {n : ℕ} (a M : ℕ) (h : a + M ≤ n) (w : Fin n → Fin 3) : Fin n → Fin 3 :=
  aux_put a M h w 0

/-- The set of contexts $(x,y)$, encoded by `aux_clear` (auxiliary for `cj_tile_one`). -/
def aux_ctx {n : ℕ} (a M : ℕ) (h : a + M ≤ n) : Finset (Fin n → Fin 3) :=
  univ.image (aux_clear a M h)

section TileAux

variable {n a M : ℕ} (h : a + M ≤ n)

/-- Reading the block of a word with block $z$ gives $z$ (auxiliary for `cj_tile_one`). -/
theorem aux_block_put (w : Fin n → Fin 3) (z : Fin M → Fin 3) :
    aux_block a M h (aux_put a M h w z) = z := by
  funext i
  simp only [aux_block, aux_put]
  rw [dif_pos (by simp)]
  congr 1; ext; simp

/-- Overwriting the block twice keeps only the second block (auxiliary for `cj_tile_one`). -/
theorem aux_put_put (w : Fin n → Fin 3) (z z' : Fin M → Fin 3) :
    aux_put a M h (aux_put a M h w z) z' = aux_put a M h w z' := by
  funext j
  simp only [aux_put]
  split_ifs <;> rfl

/-- Writing the block of $w$ into $w$ gives $w$ (auxiliary for `cj_tile_one`). -/
theorem aux_put_block (w : Fin n → Fin 3) : aux_put a M h w (aux_block a M h w) = w := by
  funext j
  simp only [aux_put, aux_block]
  split_ifs with h'
  · congr 1; ext; simp; omega
  · rfl

/-- Coordinates to the right of the block are not changed by `aux_put` (auxiliary for
`cj_tile_one`). -/
theorem aux_put_apply_of_le (w : Fin n → Fin 3) (z : Fin M → Fin 3) (j : Fin n)
    (hj : a + M ≤ (j : ℕ)) : aux_put a M h w z j = w j := by
  simp only [aux_put]
  rw [dif_neg (by omega)]

/-- Writing equivalent blocks into equivalent words gives equivalent words (auxiliary for
`cj_tile_one`). -/
theorem aux_insEquiv_put {i : Fin 2} {w w' : Fin n → Fin 3} {z z' : Fin M → Fin 3}
    (hw : InsEquiv i w w') (hz : InsEquiv i z z') :
    InsEquiv i (aux_put a M h w z) (aux_put a M h w' z') := by
  intro j
  simp only [aux_put]
  split_ifs
  · exact hz _
  · exact hw j

/-- A context is its own cleared word (auxiliary for `cj_tile_one`). -/
theorem aux_clear_of_mem_ctx {c : Fin n → Fin 3} (hc : c ∈ aux_ctx a M h) :
    aux_clear a M h c = c := by
  obtain ⟨w, -, rfl⟩ := mem_image.1 hc
  simp only [aux_clear, aux_put_put]

/-- The context of $x\frown z\frown y$ is $(x,y)$ (auxiliary for `cj_tile_one`). -/
theorem aux_clear_put {c : Fin n → Fin 3} (hc : c ∈ aux_ctx a M h) (z : Fin M → Fin 3) :
    aux_clear a M h (aux_put a M h c z) = c := by
  rw [aux_clear, aux_put_put]
  exact aux_clear_of_mem_ctx h hc

/-- Every cleared word is a context (auxiliary for `cj_tile_one`). -/
theorem aux_clear_mem_ctx (w : Fin n → Fin 3) : aux_clear a M h w ∈ aux_ctx a M h :=
  mem_image_of_mem _ (mem_univ w)

/-- Averaging over contexts: $\sum_{(x,y)}|\{z:x\frown z\frown y\in R\}|=|R|$ (auxiliary for
`cj_tile_one`). -/
theorem aux_sum_card_ctx (R : Finset (Fin n → Fin 3)) :
    ∑ c ∈ aux_ctx a M h, (univ.filter fun z => aux_put a M h c z ∈ R).card = R.card := by
  classical
  rw [card_eq_sum_card_fiberwise (f := aux_clear a M h) (t := aux_ctx a M h)
    (fun w _ => aux_clear_mem_ctx h w)]
  refine sum_congr rfl fun c hc => ?_
  refine card_nbij' (aux_put a M h c) (aux_block a M h) ?_ ?_ ?_ ?_
  · intro z hz
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hz ⊢
    exact ⟨hz, aux_clear_put h hc z⟩
  · intro w hw
    simp only [coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hw ⊢
    obtain ⟨hw, rfl⟩ := hw
    rwa [aux_clear, aux_put_put, aux_put_block]
  · intro z _
    exact aux_block_put h c z
  · intro w hw
    simp only [coe_filter, Set.mem_ofPred_eq] at hw
    obtain ⟨-, rfl⟩ := hw
    rw [aux_clear, aux_put_put, aux_put_block]

/-- The number of contexts is $3^{n-M}$, in the form $|\mathrm{ctx}|\cdot3^M=3^n$ (auxiliary for
`cj_tile_one`). -/
theorem aux_card_ctx : (aux_ctx a M h).card * 3 ^ M = 3 ^ n := by
  have := aux_sum_card_ctx h univ
  simpa using this

/-- The $d$-dimensional subspace $x\frown W\frown y$ of $[3]^n$, for a context $c=(x,y)$ and a
subspace $W\subseteq[3]^M$ (auxiliary for `cj_tile_one`). -/
def aux_embSub {d : ℕ} (c : Fin n → Fin 3) (W : Subspace (Fin d) (Fin 3) (Fin M)) :
    Subspace (Fin d) (Fin 3) (Fin n) :=
  ⟨fun j => if h' : a ≤ (j : ℕ) ∧ (j : ℕ) < a + M then W.idxFun ⟨j - a, by omega⟩
      else Sum.inl (c j), fun e => by
    obtain ⟨i, hi⟩ := W.proper e
    refine ⟨⟨a + i, by omega⟩, ?_⟩
    simp only
    rw [dif_pos (by simp)]
    convert hi using 2
    ext; simp⟩

/-- The coordinate map of `aux_embSub h c W` is $p\mapsto x\frown W(p)\frown y$ (auxiliary for
`cj_tile_one`). -/
theorem aux_embSub_apply {d : ℕ} (c : Fin n → Fin 3) (W : Subspace (Fin d) (Fin 3) (Fin M))
    (p : Fin d → Fin 3) : aux_embSub h c W p = aux_put a M h c (W p) := by
  funext j
  simp only [aux_embSub, aux_put, Subspace.coe_apply]
  split_ifs <;> rfl

/-- The points of `aux_embSub h c W` (auxiliary for `cj_tile_one`). -/
theorem aux_embSub_pts {d : ℕ} (c : Fin n → Fin 3) (W : Subspace (Fin d) (Fin 3) (Fin M)) :
    subspacePts (aux_embSub h c W) = (subspacePts W).image (aux_put a M h c) := by
  classical
  ext w
  simp [subspacePts, aux_embSub_apply]

end TileAux

/-- The invariant of the proof of `cj:tile-one`: membership in $R$ is constant on
$(i,3)$-equivalence classes of words agreeing on all coordinates $\ge b$, i.e. all prefix
sections $\{x : x\frown y\in R\}$ with $y$ of length $n-b$ are $(i,3)$-insensitive (auxiliary for
`cj_tile_one`). -/
def aux_InsAbove {n : ℕ} (i : Fin 2) (b : ℕ) (R : Finset (Fin n → Fin 3)) : Prop :=
  ∀ w w', InsEquiv i w w' → (∀ j : Fin n, b ≤ (j : ℕ) → w j = w' j) → (w ∈ R ↔ w' ∈ R)

/-- One removal stage in the proof of `cj_tile_one`, using the block of coordinates $[a,a+M)$:
if the unremoved set $R=D\setminus\bigcup\mathcal V$ has density greater than $\varepsilon$ and
satisfies the invariant above $a+M$, then pairwise disjoint subspaces $x\frown W\frown y$ inside
$R$ of total density at least $\vartheta$ can be removed, and the new unremoved set satisfies the
invariant above $a$. -/
theorem aux_tile_one_stage {d : ℕ} (hd : 1 ≤ d) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    {n a M : ℕ} (hM : M = C_cj_binary_face d (ε / 2)) (h : a + M ≤ n) (i : Fin 2)
    (D : Finset (Fin n → Fin 3)) (𝒱 : Finset (Subspace (Fin d) (Fin 3) (Fin n)))
    (h𝒱1 : (𝒱 : Set (Subspace (Fin d) (Fin 3) (Fin n))).PairwiseDisjoint subspacePts)
    (h𝒱2 : ∀ V ∈ 𝒱, subspacePts V ⊆ D)
    (hins : aux_InsAbove i (a + M) (D \ 𝒱.biUnion subspacePts))
    (hbig : ε < unifDensity (D \ 𝒱.biUnion subspacePts)) :
    ∃ 𝒱' : Finset (Subspace (Fin d) (Fin 3) (Fin n)),
      (𝒱' : Set (Subspace (Fin d) (Fin 3) (Fin n))).PairwiseDisjoint subspacePts ∧
      (∀ V ∈ 𝒱', subspacePts V ⊆ D) ∧
      aux_InsAbove i a (D \ 𝒱'.biUnion subspacePts) ∧
      ((D \ 𝒱'.biUnion subspacePts).card : ℝ) +
          ε / 2 / (((3 + d) ^ M : ℕ) : ℝ) * (3 : ℝ) ^ ((d : ℤ) - M) * 3 ^ n ≤
        (D \ 𝒱.biUnion subspacePts).card := by
  classical
  set β : ℝ := ε / 2 with hβ
  set R := D \ 𝒱.biUnion subspacePts with hR
  set ctx := aux_ctx a M h with hctxdef
  set E : (Fin n → Fin 3) → Finset (Fin M → Fin 3) :=
    fun c => univ.filter fun z => aux_put a M h c z ∈ R with hE
  have hsumE : ∑ c ∈ ctx, ((E c).card : ℝ) = R.card := by
    exact_mod_cast aux_sum_card_ctx h R
  have hctx : (ctx.card : ℝ) * 3 ^ M = 3 ^ n := by exact_mod_cast aux_card_ctx h
  have h3M : (0 : ℝ) < 3 ^ M := by positivity
  have h3n : (0 : ℝ) < 3 ^ n := by positivity
  have hβ0 : 0 < β := by positivity
  have hRbig : 2 * β * 3 ^ n < R.card := by
    rw [unifDensity, lt_div_iff₀ (by norm_num [h3n])] at hbig
    push_cast at hbig
    have : 2 * β * 3 ^ n = ε * 3 ^ n := by rw [hβ]; ring
    linarith
  -- the contexts with dense middle sections
  set Good := ctx.filter fun c => β ≤ unifDensity (E c) with hGood
  have hGoodc : β * 3 ^ n ≤ Good.card * 3 ^ M := by
    have hsplit := sum_filter_add_sum_filter_not ctx (fun c => β ≤ unifDensity (E c))
      (fun c => ((E c).card : ℝ))
    have h1 : ∑ c ∈ Good, ((E c).card : ℝ) ≤ Good.card * 3 ^ M := by
      have : ∀ c ∈ Good, ((E c).card : ℝ) ≤ 3 ^ M := by
        intro c _
        have := card_le_univ (E c)
        simp only [Fintype.card_fun, Fintype.card_fin] at this
        exact_mod_cast this
      simpa using sum_le_sum this
    have h2 : ∑ c ∈ ctx.filter (fun c => ¬ β ≤ unifDensity (E c)), ((E c).card : ℝ) ≤
        β * 3 ^ n := by
      calc _ ≤ ∑ c ∈ ctx.filter (fun c => ¬ β ≤ unifDensity (E c)), β * 3 ^ M := by
            refine sum_le_sum fun c hc => ?_
            simp only [mem_filter, not_le, unifDensity] at hc
            rw [div_lt_iff₀ (by norm_num [h3M])] at hc
            push_cast at hc
            exact hc.2.le
        _ ≤ ∑ c ∈ ctx, β * 3 ^ M :=
            sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun _ _ _ => by positivity
        _ = β * 3 ^ n := by rw [sum_const, nsmul_eq_mul, ← hctx]; ring
    rw [← hGood] at hsplit
    linarith
  -- insensitivity of the middle sections
  have hEins : ∀ c, IsInsensitive i (E c) := by
    intro c z z' hz
    simp only [hE, mem_filter, mem_univ, true_and]
    apply hins
    · exact aux_insEquiv_put h (fun j => Or.inl rfl) hz
    · intro j hj
      rw [aux_put_apply_of_le h _ _ j hj, aux_put_apply_of_le h _ _ j hj]
  have hW : ∀ c ∈ Good, ∃ W : Subspace (Fin d) (Fin 3) (Fin M), subspacePts W ⊆ E c := by
    intro c hc
    simp only [hGood, mem_filter] at hc
    obtain ⟨V, hV⟩ := cj_binary_face hd (α := β) hβ0 (by linarith) (n := M) hM.ge (E c) hc.2
    exact ⟨V, cj_insensitive_facts_face (hEins c) V hV⟩
  have hGne : Good.Nonempty := by
    rw [← card_pos]
    have : (0 : ℝ) < Good.card * 3 ^ M := lt_of_lt_of_le (by positivity) hGoodc
    have : (0 : ℝ) < Good.card := pos_of_mul_pos_left this h3M.le
    exact_mod_cast this
  obtain ⟨c0, hc0⟩ := hGne
  have : Nonempty (Subspace (Fin d) (Fin 3) (Fin M)) := ⟨(hW c0 hc0).choose⟩
  choose! Wf hWf using hW
  -- pigeonhole over the at most `Q` subspaces of `[3]^M`
  set Q : ℕ := (3 + d) ^ M with hQ
  have hQ0 : (0 : ℝ) < Q := by positivity
  set T := Good.image Wf
  have hT : (T.card : ℝ) ≤ Q := by
    have : T.card ≤ Q := by
      calc T.card = (T.image Subspace.idxFun).card :=
            (card_image_of_injective _ (fun V V' hVV => by
              cases V; cases V'; simp only at hVV; subst hVV; rfl)).symm
        _ ≤ (univ : Finset (Fin M → Fin 3 ⊕ Fin d)).card := card_le_univ _
        _ = Q := by simp [hQ]
    exact_mod_cast this
  set b : ℝ := β * 3 ^ n / (Q * 3 ^ M) with hbdef
  have hb : T.card • b ≤ (Good.card : ℝ) := by
    rw [nsmul_eq_mul]
    calc (T.card : ℝ) * b ≤ Q * b := by gcongr
      _ = β * 3 ^ n / 3 ^ M := by rw [hbdef]; field_simp
      _ ≤ Good.card := by rw [div_le_iff₀ h3M]; exact hGoodc
  obtain ⟨W, -, hWcard⟩ := exists_le_card_fiber_of_nsmul_le_card_of_maps_to
    (fun c hc => mem_image_of_mem Wf hc) (Finset.Nonempty.image ⟨c0, hc0⟩ Wf) hb
  set S := ctx.filter fun c => ∀ z ∈ subspacePts W, aux_put a M h c z ∈ R with hSdef
  have hSb : b ≤ S.card := by
    have hsub : Good.filter (fun c => Wf c = W) ⊆ S := by
      intro c hc
      simp only [mem_filter, hGood] at hc
      simp only [hSdef, mem_filter]
      refine ⟨hc.1.1, fun z hz => ?_⟩
      have := hWf c (by simp [hGood, hc.1.1, hc.1.2]) (hc.2 ▸ hz)
      simpa [hE] using this
    exact hWcard.trans (by exact_mod_cast card_le_card hsub)
  -- the new subspaces
  set F : (Fin n → Fin 3) → Subspace (Fin d) (Fin 3) (Fin n) := fun c => aux_embSub h c W
    with hFdef
  have hFsub : ∀ c ∈ S, subspacePts (F c) ⊆ R := by
    intro c hc w hw
    rw [hFdef, aux_embSub_pts] at hw
    obtain ⟨z, hz, rfl⟩ := mem_image.1 hw
    simp only [hSdef, mem_filter] at hc
    exact hc.2 z hz
  have hdisjF : ∀ c ∈ ctx, ∀ c' ∈ ctx, c ≠ c' →
      Disjoint (subspacePts (F c)) (subspacePts (F c')) := by
    intro c hc c' hc' hne
    rw [Finset.disjoint_left]
    intro w hw hw'
    rw [hFdef, aux_embSub_pts] at hw hw'
    obtain ⟨z, -, rfl⟩ := mem_image.1 hw
    obtain ⟨z', -, hzz⟩ := mem_image.1 hw'
    apply hne
    have := congrArg (aux_clear a M h) hzz
    rw [aux_clear_put h hc, aux_clear_put h hc'] at this
    exact this.symm
  set New := S.image F with hNew
  set N := New.biUnion subspacePts with hNdef
  have hN : ∀ w, w ∈ N ↔ aux_clear a M h w ∈ S ∧ aux_block a M h w ∈ subspacePts W := by
    intro w
    simp only [hNdef, hNew, mem_biUnion, mem_image, exists_exists_and_eq_and]
    constructor
    · rintro ⟨c, hc, hw⟩
      rw [hFdef, aux_embSub_pts] at hw
      obtain ⟨z, hz, rfl⟩ := mem_image.1 hw
      have hcc : c ∈ ctx := (mem_filter.1 hc).1
      rw [aux_clear_put h hcc, aux_block_put]
      exact ⟨hc, hz⟩
    · rintro ⟨hc, hz⟩
      refine ⟨_, hc, ?_⟩
      rw [hFdef, aux_embSub_pts]
      refine mem_image.2 ⟨_, hz, ?_⟩
      rw [aux_clear, aux_put_put, aux_put_block]
  have hNR : N ⊆ R := by
    intro w hw
    simp only [hNdef, hNew, mem_biUnion, mem_image, exists_exists_and_eq_and] at hw
    obtain ⟨c, hc, hw⟩ := hw
    exact hFsub c hc hw
  have hNcard : (N.card : ℝ) = S.card * 3 ^ d := by
    have : N = S.biUnion fun c => subspacePts (F c) := by
      rw [hNdef, hNew, image_biUnion]
    rw [this, card_biUnion]
    · rw [sum_congr rfl fun c _ => cj_bookkeeping_card (F c)]
      simp
    · intro c hc c' hc' hne
      exact hdisjF c (mem_filter.1 hc).1 c' (mem_filter.1 hc').1 hne
  have hR' : D \ (𝒱 ∪ New).biUnion subspacePts = R \ N := by
    rw [union_biUnion, hR, hNdef]
    ext w
    simp only [mem_sdiff, mem_union]
    tauto
  refine ⟨𝒱 ∪ New, ?_, ?_, ?_, ?_⟩
  · -- pairwise disjointness
    have hold : ∀ V ∈ 𝒱, ∀ c ∈ S, Disjoint (subspacePts V) (subspacePts (F c)) := by
      intro V hV c hc
      rw [Finset.disjoint_left]
      intro w hwV hwF
      have := hFsub c hc hwF
      simp only [hR, mem_sdiff, mem_biUnion, not_exists, not_and] at this
      exact this.2 V hV hwV
    intro V hV V' hV' hne
    simp only [coe_union, Set.mem_union, mem_coe, hNew, mem_image] at hV hV'
    rcases hV with hV | ⟨c, hc, rfl⟩ <;> rcases hV' with hV' | ⟨c', hc', rfl⟩
    · exact h𝒱1 hV hV' hne
    · exact hold V hV c' hc'
    · exact (hold V' hV' c hc).symm
    · refine hdisjF c (mem_filter.1 hc).1 c' (mem_filter.1 hc').1 ?_
      rintro rfl; exact hne rfl
  · intro V hV
    rcases mem_union.1 hV with hV | hV
    · exact h𝒱2 V hV
    · obtain ⟨c, hc, rfl⟩ := mem_image.1 hV
      exact (hFsub c hc).trans sdiff_subset
  · -- the invariant above `a`
    rw [hR']
    intro w w' hww' hagree
    have hRiff : w ∈ R ↔ w' ∈ R :=
      hins w w' hww' fun j hj => hagree j (by omega)
    have hblock : aux_block a M h w = aux_block a M h w' := by
      funext k; exact hagree _ (by simp)
    have hS : aux_clear a M h w ∈ S ↔ aux_clear a M h w' ∈ S := by
      simp only [hSdef, mem_filter]
      simp only [aux_clear, aux_put_put]
      refine and_congr (iff_of_true (aux_clear_mem_ctx h w) (aux_clear_mem_ctx h w')) ?_
      refine forall₂_congr fun z _ => hins _ _ (aux_insEquiv_put h hww' fun _ => Or.inl rfl) ?_
      intro j hj
      rw [aux_put_apply_of_le h _ _ j hj, aux_put_apply_of_le h _ _ j hj]
      exact hagree j (by omega)
    simp only [mem_sdiff, hN, hRiff, hS, hblock]
  · -- the density count
    rw [hR', card_sdiff_of_subset hNR, Nat.cast_sub (card_le_card hNR), hNcard]
    have hzpow : (3 : ℝ) ^ ((d : ℤ) - M) = 3 ^ d / 3 ^ M := by
      rw [zpow_sub₀ (by norm_num), zpow_natCast, zpow_natCast]
    have : β / Q * (3 : ℝ) ^ ((d : ℤ) - M) * 3 ^ n = b * 3 ^ d := by
      rw [hzpow, hbdef]; field_simp
    have h3d : (0 : ℝ) ≤ 3 ^ d := by positivity
    rw [this]
    nlinarith

/-- **Lemma `cj:tile-one`** (Tiling one insensitive set).
For every $d\ge1$ and $0<\varepsilon\le1$ there is an integer $T_1(d,\varepsilon)$ with the
following property.  If $n\ge T_1(d,\varepsilon)$, $i\in\{1,2\}$, and $D\subseteq[3]^n$ is
$(i,3)$-insensitive, there is a finite family $\mathcal V$ of pairwise disjoint $d$-dimensional
subspaces, all contained in $D$, such that
$$\mu_{3,n}\left(D\setminus\bigcup_{V\in\mathcal V}V\right)\le\varepsilon.$$
A valid choice is obtained from
$$\beta=\varepsilon/2,\quad M=F_2(d,\beta),\quad Q=(3+d)^M,\quad
\vartheta=\frac{\beta}{Q}\,3^{d-M}$$
by setting
$$L=\lceil\vartheta^{-1}\rceil+1,\qquad T_1(d,\varepsilon)=LM.$$ -/
theorem cj_tile_one {d : ℕ} (hd : 1 ≤ d) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1) {n : ℕ}
    (hn : C_cj_tile_one d ε ≤ n) (i : Fin 2) (D : Finset (Fin n → Fin 3))
    (hD : IsInsensitive i D) :
    ∃ 𝒱 : Finset (Subspace (Fin d) (Fin 3) (Fin n)),
      (𝒱 : Set (Subspace (Fin d) (Fin 3) (Fin n))).PairwiseDisjoint subspacePts ∧
      (∀ V ∈ 𝒱, subspacePts V ⊆ D) ∧
      unifDensity (D \ 𝒱.biUnion subspacePts) ≤ ε := by
  classical
  set M := C_cj_binary_face d (ε / 2) with hM
  set ϑ : ℝ := ε / 2 / (((3 + d) ^ M : ℕ) : ℝ) * (3 : ℝ) ^ ((d : ℤ) - M) with hϑ
  set L := ⌈ϑ⁻¹⌉₊ + 1 with hL
  have hLM : L * M ≤ n := hn
  have hϑ0 : 0 < ϑ := by positivity
  have hLϑ : 1 < L * ϑ := by
    have h1 : ϑ⁻¹ ≤ ⌈ϑ⁻¹⌉₊ := Nat.le_ceil _
    have h2 : (L : ℝ) = ⌈ϑ⁻¹⌉₊ + 1 := by rw [hL]; push_cast; ring
    have h3 : ϑ⁻¹ * ϑ = 1 := inv_mul_cancel₀ hϑ0.ne'
    nlinarith
  have h3n : (0 : ℝ) < 3 ^ n := by positivity
  have claim : ∀ t, t ≤ L →
      (∃ 𝒱 : Finset (Subspace (Fin d) (Fin 3) (Fin n)),
        (𝒱 : Set (Subspace (Fin d) (Fin 3) (Fin n))).PairwiseDisjoint subspacePts ∧
        (∀ V ∈ 𝒱, subspacePts V ⊆ D) ∧
        unifDensity (D \ 𝒱.biUnion subspacePts) ≤ ε) ∨
      ∃ 𝒱 : Finset (Subspace (Fin d) (Fin 3) (Fin n)),
        (𝒱 : Set (Subspace (Fin d) (Fin 3) (Fin n))).PairwiseDisjoint subspacePts ∧
        (∀ V ∈ 𝒱, subspacePts V ⊆ D) ∧
        aux_InsAbove i (n - t * M) (D \ 𝒱.biUnion subspacePts) ∧
        ((D \ 𝒱.biUnion subspacePts).card : ℝ) + t * ϑ * 3 ^ n ≤ D.card := by
    intro t
    induction t with
    | zero =>
      intro _
      right
      refine ⟨∅, by simp, by simp, ?_, by simp⟩
      intro w w' hww' _
      simpa using hD w w' hww'
    | succ t ih =>
      intro ht
      rcases ih (by omega) with hg | ⟨𝒱, h1, h2, h3, h4⟩
      · exact Or.inl hg
      by_cases hsmall : unifDensity (D \ 𝒱.biUnion subspacePts) ≤ ε
      · exact Or.inl ⟨𝒱, h1, h2, hsmall⟩
      right
      have hle : (t + 1) * M ≤ n := (Nat.mul_le_mul_right M ht).trans hLM
      have hsm : (t + 1) * M = t * M + M := by ring
      have hlen : n - (t + 1) * M + M = n - t * M := by omega
      obtain ⟨𝒱', g1, g2, g3, g4⟩ := aux_tile_one_stage hd hε0 hε1 hM
        (a := n - (t + 1) * M) (by omega) i D 𝒱 h1 h2 (by rwa [hlen]) (not_le.1 hsmall)
      refine ⟨𝒱', g1, g2, g3, ?_⟩
      push_cast
      linarith
  rcases claim L le_rfl with hg | ⟨𝒱, -, -, -, h4⟩
  · exact hg
  · exfalso
    have hD3 : (D.card : ℝ) ≤ 3 ^ n := by
      have := card_le_univ D
      simp only [Fintype.card_fun, Fintype.card_fin] at this
      exact_mod_cast this
    have h0 : (0 : ℝ) ≤ (D \ 𝒱.biUnion subspacePts).card := by positivity
    nlinarith

/-! ### Tiling an intersection of two insensitive sets (`cj:tile-two`) -/

/-- The constant $T_2(d,\varepsilon)=T_1(M,\varepsilon/2)$, $M=T_1(d,\varepsilon/2)$, of
`\label{cj:tile-two}` (see `cj_tile_two`). -/
def C_cj_tile_two (d : ℕ) (ε : ℝ) : ℕ :=
  C_cj_tile_one (C_cj_tile_one d (ε / 2)) (ε / 2)

/-- The constant $T_1(d,\varepsilon)$ is positive for $d\ge1$ and $\varepsilon>0$ (auxiliary for
`cj_tile_two`). -/
theorem aux_C_cj_tile_one_pos {d : ℕ} (hd : 1 ≤ d) {ε : ℝ} (hε : 0 < ε) :
    1 ≤ C_cj_tile_one d ε := by
  have hB : 1 ≤ C_cj_binary_multi d (ε / 2 / 2) := aux_C_cj_binary_multi_pos hd (by positivity)
  have hF : 1 ≤ C_cj_binary_face d (ε / 2) := by
    simp only [C_cj_binary_face, C_cj_fiber]
    nlinarith
  simp only [C_cj_tile_one]
  nlinarith

/-- The composed subspace $V\circ W$ supplied by `cj_bookkeeping_comp` (auxiliary for
`cj_tile_two`). -/
def aux_compSub {r m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n))
    (W : Subspace (Fin r) (Fin k) (Fin m)) : Subspace (Fin r) (Fin k) (Fin n) :=
  (cj_bookkeeping_comp V W).choose

/-- The points of `aux_compSub V W` are the image under $V$ of the points of $W$ (auxiliary for
`cj_tile_two`). -/
theorem aux_compSub_pts {r m k n : ℕ} (V : Subspace (Fin m) (Fin k) (Fin n))
    (W : Subspace (Fin r) (Fin k) (Fin m)) :
    subspacePts (aux_compSub V W) = (subspacePts W).image V := by
  classical
  have h := (cj_bookkeeping_comp V W).choose_spec
  ext w
  simp only [subspacePts, aux_compSub, h, mem_image, mem_univ, true_and, comp_apply]
  constructor
  · rintro ⟨x, rfl⟩; exact ⟨_, ⟨x, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨x, rfl⟩, rfl⟩; exact ⟨x, rfl⟩

/-- **Lemma `cj:tile-two`** (Tiling an intersection of two insensitive sets).
For $d\ge1$ and $0<\varepsilon\le1$, put
$$M=T_1(d,\varepsilon/2),\qquad T_2(d,\varepsilon)=T_1(M,\varepsilon/2).$$
If $n\ge T_2(d,\varepsilon)$, $D_1\subseteq[3]^n$ is $(1,3)$-insensitive, and
$D_2\subseteq[3]^n$ is $(2,3)$-insensitive, then $D=D_1\cap D_2$ contains a finite family
$\mathcal V$ of pairwise disjoint $d$-dimensional subspaces such that
$$\mu_{3,n}\left(D\setminus\bigcup_{V\in\mathcal V}V\right)\le\varepsilon.$$ -/
theorem cj_tile_two {d : ℕ} (hd : 1 ≤ d) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1) {n : ℕ}
    (hn : C_cj_tile_two d ε ≤ n) (D₁ D₂ : Finset (Fin n → Fin 3))
    (hD₁ : IsInsensitive 0 D₁) (hD₂ : IsInsensitive 1 D₂) :
    ∃ 𝒱 : Finset (Subspace (Fin d) (Fin 3) (Fin n)),
      (𝒱 : Set (Subspace (Fin d) (Fin 3) (Fin n))).PairwiseDisjoint subspacePts ∧
      (∀ V ∈ 𝒱, subspacePts V ⊆ D₁ ∩ D₂) ∧
      unifDensity ((D₁ ∩ D₂) \ 𝒱.biUnion subspacePts) ≤ ε := by
  classical
  set M := C_cj_tile_one d (ε / 2) with hM
  have hM1 : 1 ≤ M := aux_C_cj_tile_one_pos hd (by positivity)
  obtain ⟨𝒲, h𝒲1, h𝒲2, h𝒲3⟩ := cj_tile_one hM1 (ε := ε / 2) (by positivity) (by linarith)
    hn 0 D₁ hD₁
  -- the pulled-back sets inside each outer subspace
  set P : Subspace (Fin M) (Fin 3) (Fin n) → Finset (Fin M → Fin 3) :=
    fun W => univ.filter fun x => W x ∈ D₂ with hP
  have hinner : ∀ W : Subspace (Fin M) (Fin 3) (Fin n),
      ∃ 𝒰 : Finset (Subspace (Fin d) (Fin 3) (Fin M)),
        (𝒰 : Set (Subspace (Fin d) (Fin 3) (Fin M))).PairwiseDisjoint subspacePts ∧
        (∀ U ∈ 𝒰, subspacePts U ⊆ P W) ∧
        unifDensity (P W \ 𝒰.biUnion subspacePts) ≤ ε / 2 := fun W =>
    cj_tile_one hd (by positivity) (by linarith) le_rfl 1 (P W)
      (cj_insensitive_facts_preimage hD₂ W)
  choose 𝒰 h𝒰1 h𝒰2 h𝒰3 using hinner
  set 𝒱 := 𝒲.biUnion fun W => (𝒰 W).image (aux_compSub W) with h𝒱
  have hmem𝒱 : ∀ V ∈ 𝒱, ∃ W ∈ 𝒲, ∃ U ∈ 𝒰 W, V = aux_compSub W U := by
    intro V hV
    simp only [h𝒱, mem_biUnion, mem_image] at hV
    obtain ⟨W, hW, U, hU, rfl⟩ := hV
    exact ⟨W, hW, U, hU, rfl⟩
  have hsubW : ∀ (W : Subspace (Fin M) (Fin 3) (Fin n)) (U : Subspace (Fin d) (Fin 3) (Fin M)),
      subspacePts (aux_compSub W U) ⊆ subspacePts W := by
    intro W U w hw
    rw [aux_compSub_pts] at hw
    obtain ⟨x, -, rfl⟩ := mem_image.1 hw
    exact mem_image_of_mem _ (mem_univ x)
  refine ⟨𝒱, ?_, ?_, ?_⟩
  · -- pairwise disjointness
    intro V hV V' hV' hne
    obtain ⟨W, hW, U, hU, rfl⟩ := hmem𝒱 V hV
    obtain ⟨W', hW', U', hU', rfl⟩ := hmem𝒱 V' hV'
    by_cases hWW : W = W'
    · subst hWW
      have hUU : U ≠ U' := by rintro rfl; exact hne rfl
      rw [Function.onFun, aux_compSub_pts, aux_compSub_pts,
        disjoint_image (aux_subspace_injective W)]
      exact h𝒰1 W hU hU' hUU
    · exact (h𝒲1 hW hW' hWW).mono (hsubW W U) (hsubW W' U')
  · intro V hV
    obtain ⟨W, hW, U, hU, rfl⟩ := hmem𝒱 V hV
    intro w hw
    refine mem_inter.2 ⟨h𝒲2 W hW (hsubW W U hw), ?_⟩
    rw [aux_compSub_pts] at hw
    obtain ⟨x, hx, rfl⟩ := mem_image.1 hw
    have := h𝒰2 W U hU hx
    simpa [hP] using this
  · -- the residual estimate
    set X := D₁ \ 𝒲.biUnion subspacePts with hX
    set Y : Subspace (Fin M) (Fin 3) (Fin n) → Finset (Fin n → Fin 3) :=
      fun W => (P W \ (𝒰 W).biUnion subspacePts).image W with hY
    have hcover : (D₁ ∩ D₂) \ 𝒱.biUnion subspacePts ⊆ X ∪ 𝒲.biUnion Y := by
      intro w hw
      simp only [mem_sdiff, mem_inter] at hw
      obtain ⟨⟨hw1, hw2⟩, hwV⟩ := hw
      by_cases hwW : w ∈ 𝒲.biUnion subspacePts
      · refine mem_union_right _ ?_
        obtain ⟨W, hW, hwW⟩ := mem_biUnion.1 hwW
        obtain ⟨x, -, rfl⟩ := mem_image.1 hwW
        refine mem_biUnion.2 ⟨W, hW, mem_image.2 ⟨x, ?_, rfl⟩⟩
        refine mem_sdiff.2 ⟨by simpa [hP] using hw2, fun hx => hwV ?_⟩
        obtain ⟨U, hU, hxU⟩ := mem_biUnion.1 hx
        refine mem_biUnion.2 ⟨aux_compSub W U, ?_, ?_⟩
        · simp only [h𝒱, mem_biUnion, mem_image]
          exact ⟨W, hW, U, hU, rfl⟩
        · rw [aux_compSub_pts]; exact mem_image_of_mem _ hxU
      · exact mem_union_left _ (mem_sdiff.2 ⟨hw1, hwW⟩)
    have h3n : (0 : ℝ) < 3 ^ n := by positivity
    have h3M : (0 : ℝ) < 3 ^ M := by positivity
    have hXc : (X.card : ℝ) ≤ ε / 2 * 3 ^ n := by
      have := h𝒲3
      rw [unifDensity, div_le_iff₀ (by norm_num [h3n])] at this
      push_cast at this
      exact this
    have hYc : ∀ W, ((Y W).card : ℝ) ≤ ε / 2 * 3 ^ M := by
      intro W
      have := h𝒰3 W
      rw [unifDensity, div_le_iff₀ (by norm_num [h3M])] at this
      push_cast at this
      exact le_trans (by exact_mod_cast card_image_le) this
    have h𝒲c : (𝒲.card : ℝ) * 3 ^ M ≤ 3 ^ n := by
      have h1 : (𝒲.biUnion subspacePts).card = 𝒲.card * 3 ^ M := by
        rw [card_biUnion h𝒲1, sum_congr rfl fun W _ => cj_bookkeeping_card W]
        simp
      have h2 := card_le_univ (𝒲.biUnion subspacePts)
      simp only [Fintype.card_fun, Fintype.card_fin, h1] at h2
      exact_mod_cast h2
    have htot : (((D₁ ∩ D₂) \ 𝒱.biUnion subspacePts).card : ℝ) ≤ ε * 3 ^ n := by
      calc (((D₁ ∩ D₂) \ 𝒱.biUnion subspacePts).card : ℝ)
          ≤ (X ∪ 𝒲.biUnion Y).card := by exact_mod_cast card_le_card hcover
        _ ≤ X.card + ∑ W ∈ 𝒲, (Y W).card := by
            have := (card_union_le X (𝒲.biUnion Y)).trans
              (Nat.add_le_add_left card_biUnion_le _)
            exact_mod_cast this
        _ ≤ ε / 2 * 3 ^ n + ∑ W ∈ 𝒲, ε / 2 * 3 ^ M := by
            push_cast
            exact add_le_add hXc (sum_le_sum fun W _ => hYc W)
        _ = ε / 2 * 3 ^ n + ε / 2 * (𝒲.card * 3 ^ M) := by
            rw [sum_const, nsmul_eq_mul]; ring
        _ ≤ ε / 2 * 3 ^ n + ε / 2 * 3 ^ n := by gcongr
        _ = ε * 3 ^ n := by ring
    rw [unifDensity, div_le_iff₀ (by norm_num [h3n])]
    push_cast
    exact htot

end Auto
