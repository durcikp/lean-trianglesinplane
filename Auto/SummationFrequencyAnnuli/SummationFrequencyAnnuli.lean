    rw [← SchwartzMap.fourier_coe]; exact (𝓕 gS).integrable)

/-- Auxiliary for `tail:annular-definition`: `𝓕⁻ g` is integrable for smooth compactly supported
`g`. -/
theorem aux_tail_fourierInv_integrable (g : ℝ² → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
