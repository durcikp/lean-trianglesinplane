  simp only [finrank_euclideanSpace_fin] at this
  have e1 : ∀ v : ℝ², e ⟪(2 : ℝ)⁻¹ • v, (2 : ℝ) • y⟫_ℝ = e ⟪v, y⟫_ℝ := by
    intro v
    rw [inner_smul_left, inner_smul_right]
    congr 1; simp
  simp only [e1] at this
  rw [this]
