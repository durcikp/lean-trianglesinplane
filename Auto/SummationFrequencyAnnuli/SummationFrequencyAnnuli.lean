/-- Auxiliary for `tail:annular-definition`: `∫ |h_R| = ∫ |h|` for `R > 0`. -/
theorem aux_tail_integral_norm_scaleR (h : ℝ² → ℂ) (R : ℝ) (hR : 0 < R) :
