    rw [SchwartzMap.fourierInv_coe]; rfl
  rw [hinv]; exact (𝓕⁻ gS).integrable

/-- Auxiliary for `tail:annular-definition`: `∫ h_R = ∫ h` for `R > 0`. -/
theorem aux_tail_integral_scaleR (h : ℝ² → ℂ) (R : ℝ) (hR : 0 < R) :
