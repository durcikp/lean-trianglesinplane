/-- Auxiliary for `tail:annular-definition`: the scaling identity
`𝓕⁻[χ(·/2)](y) = 4 𝓕⁻χ(2y)`. -/
theorem aux_tail_fourierInv_half (g : ℝ² → ℂ) (y : ℝ²) :
    𝓕⁻ (fun b => g ((2 : ℝ)⁻¹ • b)) y = 4 * 𝓕⁻ g ((2 : ℝ) • y) := by
  rw [aux_s2a_fourierInv_e, aux_s2a_fourierInv_e]
