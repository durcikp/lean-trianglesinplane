/-! ### Annular kernels (`tail:annular-definition`) -/

/-- Auxiliary: the hypotheses on the fixed cutoff `χ` of `\label{tail:annular-definition}`:
a real radial function $\chi\in C_c^\infty(\mathbb R^2)$ which equals one on $B(0,1)$ and
vanishes outside $B(0,2)$. -/
def aux_IsTailCutoff (χ : ℝ² → ℝ) : Prop :=
  ContDiff ℝ (⊤ : ℕ∞) χ ∧ (∀ x y : ℝ², ‖x‖ = ‖y‖ → χ x = χ y) ∧
    (∀ b : ℝ², ‖b‖ < 1 → χ b = 1) ∧ (∀ b : ℝ², 2 ≤ ‖b‖ → χ b = 0)

/-- The annular function $\psi(b)=\chi(b/2)-\chi(b)$ (`\label{tail:annular-definition}`),
as a complex-valued function. -/
def tailPsi (χ : ℝ² → ℝ) (b : ℝ²) : ℂ := ((χ ((2 : ℝ)⁻¹ • b) - χ b : ℝ) : ℂ)

/-- The low-frequency kernel $q_R(u)=R^2\check\chi(Ru)$ (`\label{tail:annular-definition}`). -/
def tailQ (χ : ℝ² → ℝ) (R : ℝ) : ℝ² → ℂ := scaleR R (𝓕⁻ (fun b => (χ b : ℂ)))

/-- The annular kernel $k_r(u)=r^2\check\psi(ru)$ (`\label{tail:annular-definition}`). -/
def tailK (χ : ℝ² → ℝ) (r : ℝ) : ℝ² → ℂ := scaleR r (𝓕⁻ (tailPsi χ))

/-- The annular form $\Lambda_r=\Lambda_{\sigma*k_r}$ (`\label{tail:annular-definition}`). -/
def tailForm (α β : ℝ) (χ : ℝ² → ℝ) (r : ℝ) (f₀ f₁ f₂ : ℝ² → ℂ) : ℂ :=
  form α β (FCMeasure.sigma.conv (FCMeasure.ofDensity (tailK χ r))) f₀ f₁ f₂

/-- Auxiliary: the assertions contained in `\label{tail:annular-definition}`: $\psi$ is supported
in $\{1\le|b|\le4\}$, $\int q_R=\chi(0)=1$, and for every $r>0$, $k_r=q_{2r}-q_r$ and
$\|k_r\|_1=\|\check\psi\|_1$. -/
theorem aux_tail_annular_definition (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ) :
    tsupport (tailPsi χ) ⊆ {b | 1 ≤ ‖b‖ ∧ ‖b‖ ≤ 4} ∧
    (∀ R : ℝ, 0 < R → ∫ u, tailQ χ R u = 1) ∧
    (∀ r : ℝ, 0 < r → tailK χ r = fun u => tailQ χ (2 * r) u - tailQ χ r u) ∧
    (∀ r : ℝ, 0 < r → ∫ u, ‖tailK χ r u‖ = ∫ u, ‖𝓕⁻ (tailPsi χ) u‖) := by
  sorry

/-! ### Frequency representation with compact spectral supports (`tail:fourier`) -/

/-- Auxiliary: the `L²` Fourier transform $\widehat f$ of an input `f` (Mathlib's `𝓕` on
`Lp ℂ 2`), as a function; it is `0` if `f ∉ L²` (never used in that case).  Used in
`Auto.tail_fourier` and `Auto.tailMu`. -/
def aux_l2Fourier (f : ℝ² → ℂ) : ℝ² → ℂ := by
  classical
  exact if hf : MemLp f 2 volume then ⇑(𝓕 (hf.toLp f) : Lp ℂ 2 (volume : Measure ℝ²)) else 0

/-- **Lemma `tail:fourier`** (Frequency representation with compact spectral supports).
Suppose that $f_0,f_1,f_2\in L^2(\mathbb R^2)$ have compact Fourier supports.  Then
$$\Lambda_r(f_0,f_1,f_2)=\iint\widehat f_0(-\xi_1-\xi_2)\widehat f_1(\xi_1)\widehat f_2(\xi_2)
\cdot\widehat\sigma(\xi_1+M^T\xi_2)\psi\big((\xi_1+M^T\xi_2)/r\big)\,d\xi_1\,d\xi_2.$$
The double integral is absolutely convergent. -/
theorem tail_fourier (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ) (r : ℝ)
    (hr : 0 < r) (f : Fin 3 → ℝ² → ℂ) (hf : ∀ j, MemLp (f j) 2 volume)
    (hK : ∀ j, ∃ K : Set ℝ², IsCompact K ∧ HasL2FourierSupportIn K ((hf j).toLp (f j))) :
    Integrable (fun ξ : ℝ² × ℝ² => aux_l2Fourier (f 0) (-ξ.1 - ξ.2) *
        aux_l2Fourier (f 1) ξ.1 * aux_l2Fourier (f 2) ξ.2 *
        (FCMeasure.sigma.fourier (ξ.1 + ContinuousLinearMap.adjoint (M α β) ξ.2) *
          tailPsi χ (r⁻¹ • (ξ.1 + ContinuousLinearMap.adjoint (M α β) ξ.2)))) volume ∧
    tailForm α β χ r (f 0) (f 1) (f 2) =
      ∫ ξ : ℝ² × ℝ², aux_l2Fourier (f 0) (-ξ.1 - ξ.2) *
        aux_l2Fourier (f 1) ξ.1 * aux_l2Fourier (f 2) ξ.2 *
        (FCMeasure.sigma.fourier (ξ.1 + ContinuousLinearMap.adjoint (M α β) ξ.2) *
          tailPsi χ (r⁻¹ • (ξ.1 + ContinuousLinearMap.adjoint (M α β) ξ.2))) := by
  sorry

/-! ### Common frequency coordinates (`tail:coordinates`) -/

/-- The matrix $A=M^T$ (`\label{tail:coordinates}`). -/
def tailA (α β : ℝ) : ℝ² →L[ℝ] ℝ² := ContinuousLinearMap.adjoint (M α β)

/-- The invertible linear maps (`\label{tail:coordinates}`)
$$T_0=(A-I)^{-1},\qquad T_1=-A^{-1},\qquad T_2=I;$$
for a frequency triple with $\xi_0+\xi_1+\xi_2=0$ one writes $z_j=T_j\xi_j$ and
$b=\xi_1+A\xi_2$. -/
def tailT (α β : ℝ) : Fin 3 → (ℝ² →L[ℝ] ℝ²) :=
  ![Ring.inverse (tailA α β - 1), -Ring.inverse (tailA α β), 1]

/-! ### Frequency separation and modulation invariance (`tail:separation`) -/

/-- The modulation frequencies $v_0=(A-I)w$, $v_1=-Aw$, $v_2=w$ (`\label{tail:separation}`). -/
def tailV (α β : ℝ) (w : ℝ²) : Fin 3 → ℝ² :=
  ![(tailA α β - 1) w, -(tailA α β w), w]

/-- **Lemma `tail:separation`** (the three identities).
For the coordinates of Definition `tail:coordinates`,
$$z_0-z_2=-(A-I)^{-1}b,\quad z_1-z_2=-A^{-1}b,\quad z_1-z_0=A^{-1}(A-I)^{-1}b.$$
In particular, whenever $\psi(b/r)\ne0$, every pairwise distance $|z_i-z_j|$ is bounded above
and below by positive multiples of $r$.  For $w\in\mathbb R^2$ set
$v_0=(A-I)w$, $v_1=-Aw$, $v_2=w$.  Replacing each $f_j(x)$ by $\mathrm e(-v_j\cdot x)f_j(x)$
leaves $\Lambda_\nu(f_0,f_1,f_2)$ unchanged for every finite measure $\nu$.  This replacement
translates all three $z$-frequency supports by $-w$. -/
theorem tail_separation_identities (α β : ℝ) (hβ : β ≠ 0) (ξ : Fin 3 → ℝ²)
    (hξ : ∑ j, ξ j = 0) :
    tailT α β 0 (ξ 0) - tailT α β 2 (ξ 2) =
        -(Ring.inverse (tailA α β - 1) (ξ 1 + tailA α β (ξ 2))) ∧
    tailT α β 1 (ξ 1) - tailT α β 2 (ξ 2) = -(Ring.inverse (tailA α β) (ξ 1 + tailA α β (ξ 2))) ∧
    tailT α β 1 (ξ 1) - tailT α β 0 (ξ 0) =
        Ring.inverse (tailA α β) (Ring.inverse (tailA α β - 1) (ξ 1 + tailA α β (ξ 2))) := by
  sorry

/-- **Lemma `tail:separation`** (pairwise distances comparable to `r`).
For the coordinates of Definition `tail:coordinates`,
$$z_0-z_2=-(A-I)^{-1}b,\quad z_1-z_2=-A^{-1}b,\quad z_1-z_0=A^{-1}(A-I)^{-1}b.$$
In particular, whenever $\psi(b/r)\ne0$, every pairwise distance $|z_i-z_j|$ is bounded above
and below by positive multiples of $r$. -/
theorem tail_separation_comparable (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ)
    (hχ : aux_IsTailCutoff χ) :
    ∃ c C : ℝ, 0 < c ∧ c ≤ C ∧ ∀ r : ℝ, 0 < r → ∀ ξ : Fin 3 → ℝ², ∑ j, ξ j = 0 →
      tailPsi χ (r⁻¹ • (ξ 1 + tailA α β (ξ 2))) ≠ 0 → ∀ i j : Fin 3, i ≠ j →
        c * r ≤ ‖tailT α β i (ξ i) - tailT α β j (ξ j)‖ ∧
          ‖tailT α β i (ξ i) - tailT α β j (ξ j)‖ ≤ C * r := by
  sorry

/-- **Lemma `tail:separation`** (modulation invariance).
For $w\in\mathbb R^2$ set $v_0=(A-I)w$, $v_1=-Aw$, $v_2=w$.  Replacing each $f_j(x)$ by
$\mathrm e(-v_j\cdot x)f_j(x)$ leaves $\Lambda_\nu(f_0,f_1,f_2)$ unchanged for every finite
measure $\nu$. -/
theorem tail_separation_modulation (α β : ℝ) (ν : FCMeasure) (w : ℝ²) (f : Fin 3 → ℝ² → ℂ) :
    form α β ν (fun x => e (-⟪tailV α β w 0, x⟫_ℝ) * f 0 x)
        (fun x => e (-⟪tailV α β w 1, x⟫_ℝ) * f 1 x)
        (fun x => e (-⟪tailV α β w 2, x⟫_ℝ) * f 2 x) =
      form α β ν (f 0) (f 1) (f 2) := by
  sorry

/-- **Lemma `tail:separation`** (translation of the `z`-frequency supports).
The replacement $f_j(x)\mapsto\mathrm e(-v_j\cdot x)f_j(x)$ translates all three $z$-frequency
supports by $-w$: indeed $T_jv_j=w$ for every $j$ (and the modulation by $\mathrm e(-v_j\cdot x)$
translates the $\xi$-frequency support by $-v_j$). -/
theorem tail_separation_translate (α β : ℝ) (hβ : β ≠ 0) (w : ℝ²) (j : Fin 3) :
    tailT α β j (tailV α β w j) = w := by
  sorry

/-! ### Smooth frequency partitions and spectral mass (`tail:partition-definition`) -/

/-- The lattice point `q ∈ ℤ²` as a point of `ℝ²` (`\label{tail:partition-definition}`). -/
def latticePt (q : Fin 2 → ℤ) : ℝ² := (EuclideanSpace.equiv (Fin 2) ℝ).symm (fun i => (q i : ℝ))

/-- Auxiliary: the hypotheses on the fixed data of `\label{tail:partition-definition}`:
a nonnegative $\varphi\in C_c^\infty(\mathbb R^2)$ with $\sum_{q\in\mathbb Z^2}\varphi(z-q)=1$,
and a closed square $Q_*$ containing its support. -/
def aux_IsPartitionData (φ : ℝ² → ℝ) (Qstar : Set ℝ²) : Prop :=
  (∀ z, 0 ≤ φ z) ∧ ContDiff ℝ (⊤ : ℕ∞) φ ∧ HasCompactSupport φ ∧
    (∀ z, ∑' q : Fin 2 → ℤ, φ (z - latticePt q) = 1) ∧
    (∃ (c : ℝ²) (l : ℝ), 0 < l ∧ Qstar = {x | ∀ i, x i ∈ Icc (c i) (c i + l)}) ∧
    tsupport φ ⊆ Qstar

/-- The frequency projection $P_{j,q,r}$ (`\label{tail:partition-definition}`), defined by
$$\widehat{P_{j,q,r}f}(\xi)=\varphi\big(T_j\xi/(hr)-q\big)\widehat f(\xi),$$
i.e. as convolution of `f` with the inverse Fourier transform of this multiplier (which also
defines it on bounded inputs). -/
def tailP (α β : ℝ) (φ : ℝ² → ℝ) (h : ℝ) (j : Fin 3) (q : Fin 2 → ℤ) (r : ℝ) (f : ℝ² → ℂ)
    (x : ℝ²) : ℂ :=
  ∫ y, 𝓕⁻ (fun ξ => (φ ((h * r)⁻¹ • tailT α β j ξ - latticePt q) : ℂ)) y * f (x - y)

/-- The square $Q_{q,r}=hr(q+Q_*)$ (`\label{tail:partition-definition}`). -/
def tailSquare (Qstar : Set ℝ²) (h r : ℝ) (q : Fin 2 → ℤ) : Set ℝ² :=
  (fun z => (h * r) • (latticePt q + z)) '' Qstar

/-- The spectral mass (`\label{tail:partition-definition}`) of a triple of $L^2$ inputs,
$$\mu=\sum_{j=0}^2(T_j)_*\big(|\widehat f_j(\xi)|^2\,d\xi\big).$$ -/
def tailMu (α β : ℝ) (f : Fin 3 → ℝ² → ℂ) : Measure ℝ² :=
  ∑ j : Fin 3, ((volume : Measure ℝ²).withDensity
    (fun ξ => ‖aux_l2Fourier (f j) ξ‖ₑ ^ 2)).map (tailT α β j)

/-- Contributing triples (`\label{tail:partition-definition}`): $(q_0,q_1,q_2)$ is contributing
at scale $r$ if there are frequencies $\xi_j$ with $\sum_j\xi_j=0$, with
$T_j\xi_j\in Q_{q_j,r}$ for all $j$, and with $\psi((\xi_1+A\xi_2)/r)\ne0$. -/
def tailContributing (α β : ℝ) (χ : ℝ² → ℝ) (Qstar : Set ℝ²) (h r : ℝ)
    (q : Fin 3 → Fin 2 → ℤ) : Prop :=
  ∃ ξ : Fin 3 → ℝ², ∑ j, ξ j = 0 ∧ (∀ j, tailT α β j (ξ j) ∈ tailSquare Qstar h r (q j)) ∧
    tailPsi χ (r⁻¹ • (ξ 1 + tailA α β (ξ 2))) ≠ 0

/-! ### Properties of the smooth partition (`tail:partition`) -/

/-- Auxiliary: the properties of the partition scale `h` asserted in `\label{tail:partition}`
(see `Auto.tail_partition`), uniformly in `r > 0`: (1) bounded overlap, separation and bounded
diameter of contributing triples, bounded partner count; (2) the `L²`, `L^∞` and
sum-of-squares bounds for `P_{j,q,r}`; (3) the absolutely convergent expansion over
contributing triples.  Used as hypothesis in the later lemmas of the section. -/
structure aux_TailPartitionScale (α β : ℝ) (χ : ℝ² → ℝ) (φ : ℝ² → ℝ) (Qstar : Set ℝ²)
    (h : ℝ) : Prop where
  pos : 0 < h
  overlap : ∃ N : ℕ, ∀ r : ℝ, 0 < r → ∀ x : ℝ²,
    {q : Fin 2 → ℤ | x ∈ tailSquare Qstar h r q}.encard ≤ N
  separation : ∃ d D : ℝ, 0 < d ∧ 0 < D ∧ ∀ r : ℝ, 0 < r → ∀ q : Fin 3 → Fin 2 → ℤ,
    tailContributing α β χ Qstar h r q → ∀ i j : Fin 3,
      ∀ x ∈ tailSquare Qstar h r (q i), ∀ y ∈ tailSquare Qstar h r (q j),
        (i ≠ j → d * r ≤ ‖x - y‖) ∧ ‖x - y‖ ≤ D * r
  partners : ∃ K : ℕ, ∀ r : ℝ, 0 < r → ∀ (j : Fin 3) (q₀ : Fin 2 → ℤ),
    {q : Fin 3 → Fin 2 → ℤ | tailContributing α β χ Qstar h r q ∧ q j = q₀}.encard ≤ K
  bounds : ∃ C : ℝ, ∀ r : ℝ, 0 < r → ∀ (j : Fin 3) (q : Fin 2 → ℤ),
    (∀ f : Fin 3 → ℝ² → ℂ, (∀ i, MemLp (f i) 2 volume) →
      eLpNorm (tailP α β φ h j q r (f j)) 2 volume ^ 2 ≤
        ENNReal.ofReal C * tailMu α β f (tailSquare Qstar h r q)) ∧
    (∀ g : ℝ² → ℂ, AEStronglyMeasurable g volume →
      eLpNorm (tailP α β φ h j q r g) ⊤ volume ≤ ENNReal.ofReal C * eLpNorm g ⊤ volume) ∧
    (∀ g : ℝ² → ℂ, MemLp g 2 volume →
      ∑' q' : Fin 2 → ℤ, eLpNorm (tailP α β φ h j q' r g) 2 volume ^ 2 ≤
        ENNReal.ofReal C * eLpNorm g 2 volume ^ 2)
  expansion : ∀ r : ℝ, 0 < r → ∀ f : Fin 3 → ℝ² → ℂ, (∀ j, MemLp (f j) 2 volume) →
    Summable (fun q : {q : Fin 3 → Fin 2 → ℤ // tailContributing α β χ Qstar h r q} =>
      ‖tailForm α β χ r (tailP α β φ h 0 (q.1 0) r (f 0)) (tailP α β φ h 1 (q.1 1) r (f 1))
        (tailP α β φ h 2 (q.1 2) r (f 2))‖) ∧
    HasSum (fun q : {q : Fin 3 → Fin 2 → ℤ // tailContributing α β χ Qstar h r q} =>
      tailForm α β χ r (tailP α β φ h 0 (q.1 0) r (f 0)) (tailP α β φ h 1 (q.1 1) r (f 1))
        (tailP α β φ h 2 (q.1 2) r (f 2))) (tailForm α β χ r (f 0) (f 1) (f 2))

/-- **Lemma `tail:partition`** (Properties of the smooth partition).
The parameter $h$ can be chosen depending only on $M$ and $\varphi$ so that the following
statements hold uniformly in $r>0$.
1. The square family $\{Q_{q,r}\}$ has bounded overlap.  The three squares in every contributing
   triple have mutual distance at least $dr$ and their union has diameter at most $Dr$, for fixed
   $d,D>0$.  Every square in a specified slot occurs in at most $K$ contributing triples.
2. There is a constant $C$ such that
   $$\|P_{j,q,r}f_j\|_2^2\le C\mu(Q_{q,r}),\qquad \|P_{j,q,r}f_j\|_\infty\le C\|f_j\|_\infty,
   \qquad\sum_q\|P_{j,q,r}f_j\|_2^2\le C\|f_j\|_2^2.$$
3. For $L^2$ inputs the following expansion is absolutely convergent:
   $$\Lambda_r(f_0,f_1,f_2)=\sum_{(q_0,q_1,q_2)\,\mathrm{contributing}}
   \Lambda_r(P_{0,q_0,r}f_0,P_{1,q_1,r}f_1,P_{2,q_2,r}f_2).$$ -/
theorem tail_partition (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ)
    (φ : ℝ² → ℝ) (Qstar : Set ℝ²) (hφ : aux_IsPartitionData φ Qstar) :
    ∃ h : ℝ, aux_TailPartitionScale α β χ φ Qstar h := by
  sorry

/-! ### One frequency triple (`tail:one-triple`) -/

/-- Auxiliary: inputs with $\|f_j\|_2,\|f_j\|_\infty\le B$ for all `j` (used in
`\label{tail:one-triple}`, `\label{tail:bound}` and Section `tail:approximation-section`). -/
def aux_IsBothBounded (B : ℝ) (f : Fin 3 → ℝ² → ℂ) : Prop :=
  ∀ j, AEStronglyMeasurable (f j) volume ∧ eLpNorm (f j) 2 volume ≤ ENNReal.ofReal B ∧
    eLpNorm (f j) ⊤ volume ≤ ENNReal.ofReal B

/-- The masses $\mu(Q_{q_j,r})$ of the three squares of a triple (`\label{tail:one-triple}`). -/
def tailMasses (α β : ℝ) (f : Fin 3 → ℝ² → ℂ) (Qstar : Set ℝ²) (h r : ℝ)
    (q : Fin 3 → Fin 2 → ℤ) (j : Fin 3) : ℝ≥0∞ :=
  tailMu α β f (tailSquare Qstar h r (q j))

/-- Auxiliary: the middle value `n` of three numbers `m ≤ n ≤ p` (used in
`\label{tail:one-triple}` and `\label{tail:increment}`). -/
def aux_med3 (x : Fin 3 → ℝ≥0∞) : ℝ≥0∞ := max (min (x 0) (x 1)) (min (max (x 0) (x 1)) (x 2))

/-- Auxiliary: the largest value `p` of three numbers `m ≤ n ≤ p` (used in
`\label{tail:one-triple}` and `\label{tail:increment}`). -/
def aux_max3 (x : Fin 3 → ℝ≥0∞) : ℝ≥0∞ := max (max (x 0) (x 1)) (x 2)

/-- **Lemma `tail:one-triple`** (One frequency triple).
Suppose that $\|f_j\|_2,\|f_j\|_\infty\le B$.  For a contributing triple let $m\le n\le p$ be
the three numbers $\mu(Q_{q_j,r})$, in increasing order.  For a sufficiently large fixed
frequency-ball constant in Corollary `ann:global`, its modulus $a(r)$ satisfies
$$|\Lambda_r(P_{0,q_0,r}f_0,P_{1,q_1,r}f_1,P_{2,q_2,r}f_2)|\le C_Ba(r)^{1/2}np^{1/4}.$$ -/
theorem tail_one_triple (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ)
    (φ : ℝ² → ℝ) (Qstar : Set ℝ²) (hφ : aux_IsPartitionData φ Qstar) (h : ℝ)
    (hh : aux_TailPartitionScale α β χ φ Qstar h) :
    ∃ C₀₀ : ℝ, 0 < C₀₀ ∧ ∀ C₀ : ℝ, C₀₀ ≤ C₀ → ∀ B : ℝ, ∃ CB : ℝ, ∀ a : ℝ → ℝ,
      aux_IsAnnularModulus α β (tailPsi χ) C₀ a → ∀ r : ℝ, 0 < r →
      ∀ f : Fin 3 → ℝ² → ℂ, aux_IsBothBounded B f → ∀ q : Fin 3 → Fin 2 → ℤ,
        tailContributing α β χ Qstar h r q →
        ‖tailForm α β χ r (tailP α β φ h 0 (q 0) r (f 0)) (tailP α β φ h 1 (q 1) r (f 1))
            (tailP α β φ h 2 (q 2) r (f 2))‖ₑ ≤
          ENNReal.ofReal (CB * Real.sqrt (a r)) * aux_med3 (tailMasses α β f Qstar h r q) *
            aux_max3 (tailMasses α β f Qstar h r q) ^ (1 / 4 : ℝ) := by
  sorry

/-! ### An increasing mass functional (`tail:mass-definition`) -/

/-- The mass functional (`\label{tail:mass-definition}`): for a finite positive Borel measure
$\mu$ on $\mathbb R^2$ and $t>0$,
$$H(t)=\int_{\mathbb R^2}\mu(B(z,t))^{1/4}\,d\mu(z).$$
It is nondecreasing and satisfies $0\le H(t)\le\mu(\mathbb R^2)^{5/4}$ (`Auto.aux_tailH_mono`,
`Auto.aux_tailH_le`). -/
def tailH (μ : Measure ℝ²) (t : ℝ) : ℝ≥0∞ := ∫⁻ z, μ (Metric.ball z t) ^ (1 / 4 : ℝ) ∂μ

/-- Auxiliary: $H$ of `\label{tail:mass-definition}` (`Auto.tailH`) is nondecreasing. -/
theorem aux_tailH_mono (μ : Measure ℝ²) : Monotone (tailH μ) := by
  intro s t hst
  exact lintegral_mono fun z =>
    ENNReal.rpow_le_rpow (measure_mono (Metric.ball_subset_ball hst)) (by norm_num)

/-- Auxiliary: $H\le\mu(\mathbb R^2)^{5/4}$ for $H$ of `\label{tail:mass-definition}`
(`Auto.tailH`). -/
theorem aux_tailH_le (μ : Measure ℝ²) (t : ℝ) : tailH μ t ≤ μ univ ^ (5 / 4 : ℝ) := by
  calc tailH μ t ≤ ∫⁻ _z, μ univ ^ (1 / 4 : ℝ) ∂μ :=
        lintegral_mono fun z => ENNReal.rpow_le_rpow (measure_mono (subset_univ _)) (by norm_num)
    _ = μ univ ^ (1 / 4 : ℝ) * μ univ := lintegral_const _
    _ = μ univ ^ (5 / 4 : ℝ) := by
        rw [show (5 / 4 : ℝ) = 1 / 4 + 1 by norm_num,
          ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num), ENNReal.rpow_one]

/-! ### Geometric mass increment (`tail:increment`) -/

/-- **Lemma `tail:increment`** (Geometric mass increment).
For the square families and contributing triples of Lemma `tail:partition`, there are fixed
constants $0<c<C$ such that
$$\sum_{\mathrm{contributing}}np^{1/4}\le C_M\big(H(Cr)-H(cr)\big),$$
where $m\le n\le p$ are the masses of the three squares in each triple. -/
theorem tail_increment (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ)
    (φ : ℝ² → ℝ) (Qstar : Set ℝ²) (hφ : aux_IsPartitionData φ Qstar) (h : ℝ)
    (hh : aux_TailPartitionScale α β χ φ Qstar h) :
    ∃ c C CM : ℝ, 0 < c ∧ c < C ∧ ∀ r : ℝ, 0 < r → ∀ f : Fin 3 → ℝ² → ℂ,
      (∀ j, MemLp (f j) 2 volume) →
      ∑' q : {q : Fin 3 → Fin 2 → ℤ // tailContributing α β χ Qstar h r q},
          aux_med3 (tailMasses α β f Qstar h r q.1) *
            aux_max3 (tailMasses α β f Qstar h r q.1) ^ (1 / 4 : ℝ) ≤
        ENNReal.ofReal CM * (tailH (tailMu α β f) (C * r) - tailH (tailMu α β f) (c * r)) := by
  sorry

/-! ### Dyadic telescoping (`tail:telescoping`) -/

/-- **Lemma `tail:telescoping`** (Dyadic telescoping of the mass increments; stated for
$[0,\infty]$-valued $H$, which makes the boundedness hypothesis unnecessary).
For $0<c<C$, every nondecreasing bounded function $H$ satisfies
$$\sum_{k=0}^{\infty}\big(H(C2^kR)-H(c2^kR)\big)\le D\sup_{t>0}H(t),$$
provided $H\ge0$ and $D$ is any positive integer with $2^Dc\ge C$. -/
theorem tail_telescoping (c C : ℝ) (hc : 0 < c) (hcC : c < C) (H : ℝ → ℝ≥0∞)
    (hH : MonotoneOn H (Ioi 0)) (D : ℕ) (hD : 0 < D) (hDc : C ≤ 2 ^ D * c) (R : ℝ)
    (hR : 0 < R) :
    ∑' k : ℕ, (H (C * 2 ^ k * R) - H (c * 2 ^ k * R)) ≤ D * ⨆ (t : ℝ) (_ : 0 < t), H t := by
  sorry

/-! ### Uniform annular tails (`tail:bound`) -/

/-- **Proposition `tail:bound`** (Uniform annular tails; the modulus `a` is that of
Corollary `ann:global` with a sufficiently large fixed frequency-ball constant `C₀`).
Let $R\ge1$ be dyadic.  If $\|f_j\|_2,\|f_j\|_\infty\le B$, then
$$\sum_{r=2^k\ge R}|\Lambda_r(f_0,f_1,f_2)|\le C_{M,B}\left(\sup_{r\ge R}a(r)\right)^{1/2}.$$
In particular this tail tends to zero as $R\to\infty$, uniformly over these inputs. -/
theorem tail_bound (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ) :
    ∃ C₀₀ : ℝ, 0 < C₀₀ ∧ ∀ C₀ : ℝ, C₀₀ ≤ C₀ → ∀ B : ℝ, ∃ CMB : ℝ, ∀ a : ℝ → ℝ,
      aux_IsAnnularModulus α β (tailPsi χ) C₀ a → ∀ (K : ℕ) (f : Fin 3 → ℝ² → ℂ),
        aux_IsBothBounded B f →
        ∑' k : ℕ, ‖tailForm α β χ (2 ^ (K + k)) (f 0) (f 1) (f 2)‖ₑ ≤
          ENNReal.ofReal CMB *
            (⨆ (r : ℝ) (_ : (2 : ℝ) ^ K ≤ r), ENNReal.ofReal (a r)) ^ (1 / 2 : ℝ) := by
  sorry

/-- **Proposition `tail:bound`** (uniform convergence of the tails).
Let $R\ge1$ be dyadic.  If $\|f_j\|_2,\|f_j\|_\infty\le B$, then
$$\sum_{r=2^k\ge R}|\Lambda_r(f_0,f_1,f_2)|\le C_{M,B}\left(\sup_{r\ge R}a(r)\right)^{1/2}.$$
In particular this tail tends to zero as $R\to\infty$, uniformly over these inputs. -/
theorem tail_bound_tendsto (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ)
    (B : ℝ) :
    Tendsto (fun K : ℕ => ⨆ (f : Fin 3 → ℝ² → ℂ) (_ : aux_IsBothBounded B f),
      ∑' k : ℕ, ‖tailForm α β χ (2 ^ (K + k)) (f 0) (f 1) (f 2)‖ₑ) atTop (𝓝 0) := by
  sorry

end Auto
