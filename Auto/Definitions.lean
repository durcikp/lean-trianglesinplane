/-! ### The plane and finite complex measures (`ext:fourier-convention`, `def:form`) -/

/-- The Euclidean plane `ℝ²`. -/
scoped notation "ℝ²" => EuclideanSpace ℝ (Fin 2)

/-- A finite complex Borel measure on `ℝ²` (part of `\label{ext:fourier-convention}`; used
throughout, e.g. in `\label{def:form}`).

It is presented as the image `ν = φ_*(w · m)` of a complex density `w ∈ L¹(m)` on an auxiliary
s-finite measure space `(Z, m)` under a measurable map `φ : Z → ℝ²`; integration is
`∫ g dν = ∫ g(φ z) w(z) dm(z)`.  Every finite complex Borel measure `ν` has such a
presentation (take `Z = ℝ²`, `m = |ν|`, `φ = id`, `w = dν/d|ν|`), and this one realizes
`∫ |w| dm = ‖ν‖_TV`.  Convolutions, differences, scalar multiples and pushforwards of
presented measures are again presented in the obvious way. -/
structure FCMeasure where
  /-- The auxiliary parameter space. -/
  Z : Type
  /-- Its σ-algebra. -/
  [msZ : MeasurableSpace Z]
  /-- The auxiliary positive measure. -/
  m : Measure Z
  [sfin : SFinite m]
  /-- The complex density. -/
  w : Z → ℂ
  /-- The map to the plane. -/
  φ : Z → ℝ²
  measurable_φ : Measurable φ
  integrable_w : Integrable w m

attribute [instance] FCMeasure.msZ FCMeasure.sfin

namespace FCMeasure

/-- The measure `k(u) du` with an `L¹` density `k`; an `L¹` function is identified with this
measure (part of `\label{def:form}`).  (If `k` is not integrable we use the zero density.) -/
def ofDensity (k : ℝ² → ℂ) : FCMeasure where
  Z := ℝ²
  m := volume
  w := by classical exact if Integrable k then k else 0
  φ := id
  measurable_φ := measurable_id
  integrable_w := by
    classical
    split_ifs with h
    · exact h
    · exact integrable_zero _ _ _

/-- The pushforward `ν_s` of `ν` under `u ↦ s u` (part of `\label{def:form}`). -/
def dil (s : ℝ) (ν : FCMeasure) : FCMeasure where
  Z := ν.Z
  m := ν.m
  w := ν.w
  φ := fun z => s • ν.φ z
  measurable_φ := ν.measurable_φ.const_smul s
  integrable_w := ν.integrable_w

/-- A complex multiple `c ν` (part of `\label{def:form}`). -/
def smul (c : ℂ) (ν : FCMeasure) : FCMeasure where
  Z := ν.Z
  m := ν.m
  w := fun z => c * ν.w z
  φ := ν.φ
  measurable_φ := ν.measurable_φ
  integrable_w := ν.integrable_w.const_mul c

/-- The sum `ν + κ` of two finite complex measures (part of `\label{def:form}`). -/
def add (ν κ : FCMeasure) : FCMeasure where
  Z := ν.Z ⊕ κ.Z
  m := ν.m.map Sum.inl + κ.m.map Sum.inr
  w := Sum.elim ν.w κ.w
  φ := Sum.elim ν.φ κ.φ
  measurable_φ := ν.measurable_φ.sumElim κ.measurable_φ
  integrable_w := by
    refine Integrable.add_measure ?_ ?_
    · exact (MeasurableEmbedding.integrable_map_iff
        ⟨Sum.inl_injective, measurable_inl, fun _ hs => hs.inl_image⟩).2
        (by simpa using ν.integrable_w)
    · exact (MeasurableEmbedding.integrable_map_iff
        ⟨Sum.inr_injective, measurable_inr, fun _ hs => hs.inr_image⟩).2
        (by simpa using κ.integrable_w)

/-- The difference `ν - κ` (part of `\label{def:form}`). -/
def sub (ν κ : FCMeasure) : FCMeasure := add ν (smul (-1) κ)

/-- The convolution `ν * κ`, the pushforward of `ν ⊗ κ` under `(u, v) ↦ u + v`
(part of `\label{def:form}`). -/
def conv (ν κ : FCMeasure) : FCMeasure where
  Z := ν.Z × κ.Z
  m := ν.m.prod κ.m
  w := fun p => ν.w p.1 * κ.w p.2
  φ := fun p => ν.φ p.1 + κ.φ p.2
  measurable_φ := (ν.measurable_φ.comp measurable_fst).add (κ.measurable_φ.comp measurable_snd)
  integrable_w := ν.integrable_w.mul_prod κ.integrable_w

end FCMeasure

/-! ### Triangle parameters (`def:geometry`) -/

instance instFactTwoPiPos : Fact (0 < 2 * π) := ⟨Real.two_pi_pos⟩

/-- The circle of angles `ℝ/(2πℤ)`. -/
abbrev Ang := AddCircle (2 * π)

/-- The rotation `J(x₁, x₂) = (-x₂, x₁)` (part of `\label{def:geometry}`). -/
def J : ℝ² →L[ℝ] ℝ² :=
  LinearMap.toContinuousLinearMap
    { toFun := fun x => !₂[-x 1, x 0]
      map_add' := fun x y => by
        ext i; fin_cases i <;> simp [add_comm]
      map_smul' := fun c x => by
        ext i; fin_cases i <;> simp }

/-- The matrix `aI + bJ`, an orientation-preserving similarity when `(a, b) ≠ 0`
(part of `\label{def:geometry}`). -/
def simil (a b : ℝ) : ℝ² →L[ℝ] ℝ² := a • ContinuousLinearMap.id ℝ ℝ² + b • J

/-- The triangle matrix `M = αI + βJ` (part of `\label{def:geometry}`). -/
abbrev M (α β : ℝ) : ℝ² →L[ℝ] ℝ² := simil α β

/-- The rotation `R_t = (cos t) I + (sin t) J` (part of `\label{def:geometry}`). -/
abbrev rot (t : ℝ) : ℝ² →L[ℝ] ℝ² := simil (Real.cos t) (Real.sin t)

/-- The unit vector `u_θ = (cos θ, sin θ)` for a real angle `θ`. -/
@[nolint defsWithUnderscore]
def aux_uR (θ : ℝ) : ℝ² := !₂[Real.cos θ, Real.sin θ]

lemma aux_uR_periodic : Function.Periodic aux_uR (2 * π) := by
  intro θ; ext i; fin_cases i <;> simp [aux_uR]

/-- The unit vector `u_θ = (cos θ, sin θ)` for `θ ∈ ℝ/(2πℤ)` (part of `\label{def:geometry}`). -/
def u (θ : Ang) : ℝ² := aux_uR_periodic.lift θ

/-- Probability arclength `dσ(θ) = dθ/(2π)` on `ℝ/(2πℤ)` (part of `\label{def:geometry}`). -/
def σ : Measure Ang := AddCircle.haarAddCircle

instance : IsProbabilityMeasure σ := by unfold σ; infer_instance

/-- First standard basis vector (auxiliary for `lem:triple-l2`). -/
@[nolint defsWithUnderscore]
def aux_lw_e0 : ℝ² := EuclideanSpace.single 0 1

/-- Second standard basis vector (auxiliary for `lem:triple-l2`). -/
@[nolint defsWithUnderscore]
def aux_lw_e1 : ℝ² := EuclideanSpace.single 1 1

/-- `u_t = cos t e₀ + sin t e₁` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_uR_eq : aux_uR = fun t => Real.cos t • aux_lw_e0 + Real.sin t • aux_lw_e1 := by
  funext t; ext i; fin_cases i <;> simp [aux_uR, aux_lw_e0, aux_lw_e1]

/-- `u` is smooth (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_uR_contDiff {n : WithTop ℕ∞} : ContDiff ℝ n aux_uR := by
  rw [aux_lw_uR_eq]
  exact (Real.contDiff_cos.smul contDiff_const).add (Real.contDiff_sin.smul contDiff_const)

/-- `θ ↦ u_θ` is continuous on `ℝ/(2πℤ)` (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_u_continuous : Continuous u :=
  continuous_coinduced_dom.mpr (aux_lw_uR_contDiff (n := 0)).continuous

/-- `θ ↦ u_θ` is measurable (auxiliary for `lem:triple-l2`). -/
lemma aux_lw_u_meas : Measurable u := aux_lw_u_continuous.measurable

namespace FCMeasure

/-- The uniform probability measure `σ` on the unit circle, as the pushforward of `dθ/(2π)`
under `θ ↦ u_θ` (part of `\label{def:geometry}`). -/
def sigma : FCMeasure where
  Z := Ang
  m := σ
  w := fun _ => 1
  φ := u
  measurable_φ := aux_lw_u_meas
  integrable_w := integrable_const 1

end FCMeasure

/-! ### Forms (`def:form`) -/

/-- The counting form (`\label{def:form}`)
$$\Lambda_\nu(f_0,f_1,f_2)=\int_{\R^2}\int_{\R^2}\prod_{j=0}^2 f_j(x+L_ju)\,dx\,d\nu(u),$$
with $L_0=0$, $L_1=I$, $L_2=M$.  (Lean's integral returns a junk value when the integral is
not absolutely convergent.) -/
def form (α β : ℝ) (ν : FCMeasure) (f₀ f₁ f₂ : ℝ² → ℂ) : ℂ :=
  ∫ z, (∫ x, f₀ x * f₁ (x + ν.φ z) * f₂ (x + M α β (ν.φ z))) * ν.w z ∂ν.m

/-- The endpoint norm (`\label{def:form}`)
$\|\Lambda_\nu\|_i=\sup\{|\Lambda_\nu(f_0,f_1,f_2)| : \|f_i\|_\infty\le1,\ \|f_j\|_2\le1\ (j\ne
i)\}$,
valued in `ℝ≥0∞`. -/
def endNorm (α β : ℝ) (ν : FCMeasure) (i : Fin 3) : ℝ≥0∞ :=
  ⨆ (f : Fin 3 → ℝ² → ℂ) (_ : ∀ j, AEStronglyMeasurable (f j) volume)
    (_ : eLpNorm (f i) ⊤ volume ≤ 1) (_ : ∀ j, j ≠ i → eLpNorm (f j) 2 volume ≤ 1),
    ‖form α β ν (f 0) (f 1) (f 2)‖ₑ

/-! ### Density (`den:definitions`) -/

/-- The closed square `z + [0,L]²` (part of `\label{den:definitions}`). -/
def squareAt (z : ℝ²) (L : ℝ) : Set ℝ² := {x | ∀ i, x i ∈ Icc (z i) (z i + L)}

/-- The upper Banach density (`\label{den:definitions}`)
$$d^*(E)=\limsup_{L\to\infty}\sup_{z\in\R^2}\frac{|E\cap(z+[0,L]^2)|}{L^2}.$$ -/
def upperBanachDensity (E : Set ℝ²) : ℝ≥0∞ :=
  limsup (fun L : ℝ => ⨆ z : ℝ², volume (E ∩ squareAt z L) / ENNReal.ofReal (L ^ 2)) atTop

