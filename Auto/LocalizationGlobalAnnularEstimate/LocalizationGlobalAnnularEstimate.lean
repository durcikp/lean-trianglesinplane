/-! ### From bounded local inputs to endpoint operator norms (`ann:localize`) -/

/-- **Lemma `ann:localize`** (From bounded local inputs to endpoint operator norms).
Let $\mu_n=\sigma*\kappa_n$, where $\sup_n\|\kappa_n\|_{\mathrm{TV}}<\infty$, and suppose that for
some fixed $U<\infty$, $$|\mu_n|(\{u:|u|>U\})\longrightarrow0.$$
Let $P_n$ be convolution by measures supported in the closed unit ball, with uniformly bounded
total variation.  Suppose that for every fixed triple $\chi_0,\chi_1,\chi_2\in C_c^\infty(\mathbb
R^2)$,
$$\sup_{\|f_j\|_\infty\le1}|\Lambda_{\mu_n}(\chi_0P_nf_0,\chi_1P_nf_1,\chi_2P_nf_2)|
\longrightarrow0.\qquad(\text{ann:bounded-local-hyp})$$
Then the form $\Lambda_{\mu_n}(P_nf_0,P_nf_1,P_nf_2)$ has operator norm tending to zero on every
permutation of $L^2\times L^2\times L^\infty$.

(Here the bounded slot is `i`.) -/
theorem ann_localize (α β : ℝ) (hβ : β ≠ 0) (κ : ℕ → FCMeasure) (hκ : ⨆ n, (κ n).tv < ⊤)
    (U : ℝ) (hU : Tendsto (fun n => (FCMeasure.sigma.conv (κ n)).varOn {u | U < ‖u‖}) atTop
      (𝓝 0))
    (P : ℕ → FCMeasure) (hPsupp : ∀ n, (P n).varOn {u | 1 < ‖u‖} = 0)
    (hPtv : ⨆ n, (P n).tv < ⊤)
    (hloc : ∀ χ : Fin 3 → ℝ² → ℝ, (∀ j, ContDiff ℝ (⊤ : ℕ∞) (χ j) ∧ HasCompactSupport (χ j)) →
      Tendsto (fun n => ⨆ (f : Fin 3 → ℝ² → ℂ) (_ : ∀ j, AEStronglyMeasurable (f j) volume)
          (_ : ∀ j, eLpNorm (f j) ⊤ volume ≤ 1),
          ‖form α β (FCMeasure.sigma.conv (κ n))
            (fun x => (χ 0 x : ℂ) * (P n).convFun (f 0) x)
            (fun x => (χ 1 x : ℂ) * (P n).convFun (f 1) x)
            (fun x => (χ 2 x : ℂ) * (P n).convFun (f 2) x)‖ₑ) atTop (𝓝 0))
    (i : Fin 3) :
    Tendsto (fun n => ⨆ (f : Fin 3 → ℝ² → ℂ) (_ : ∀ j, AEStronglyMeasurable (f j) volume)
        (_ : eLpNorm (f i) ⊤ volume ≤ 1) (_ : ∀ j, j ≠ i → eLpNorm (f j) 2 volume ≤ 1),
        ‖form α β (FCMeasure.sigma.conv (κ n))
          ((P n).convFun (f 0)) ((P n).convFun (f 1)) ((P n).convFun (f 2))‖ₑ) atTop (𝓝 0) := by
  sorry

/-! ### Global cancellation on one annulus (`ann:global`) -/

/-- Auxiliary: `a` is an admissible annular modulus for `ψ` and the frequency-ball constant
`C₀`, i.e. it satisfies the conclusion of `\label{ann:global}` (see `Auto.ann_global`):
$a(R)\to0$, $0\le a(R)\le\|\check\psi\|_1$, and for every $R>0$, every bounded slot $i$ and all
inputs $f_i\in L^\infty$, $f_j\in L^2$ ($j\ne i$) with Fourier supports in
$\overline{B(0,C_0R)}$,
$|\Lambda_{K_R}(f_0,f_1,f_2)|\le a(R)\|f_i\|_\infty\prod_{j\ne i}\|f_j\|_2$, where
$K_R=\sigma*(R^2\check\psi(R\,\cdot))$.  Used for "its modulus $a(r)$" in Sections 9 and 10. -/
def aux_IsAnnularModulus (α β : ℝ) (ψ : ℝ² → ℂ) (C₀ : ℝ) (a : ℝ → ℝ) : Prop :=
  Tendsto a atTop (𝓝 0) ∧ (∀ R, 0 ≤ a R ∧ a R ≤ ∫ x, ‖𝓕⁻ ψ x‖) ∧
  ∀ R : ℝ, 0 < R → ∀ (i : Fin 3) (f : Fin 3 → ℝ² → ℂ),
    MemLp (f i) ⊤ volume → HasFourierSupportIn (Metric.closedBall 0 (C₀ * R)) (f i) →
    (∀ j, j ≠ i → ∃ hf : MemLp (f j) 2 volume,
      HasL2FourierSupportIn (Metric.closedBall 0 (C₀ * R)) (hf.toLp (f j))) →
    ‖form α β (FCMeasure.sigma.conv (FCMeasure.ofDensity (scaleR R (𝓕⁻ ψ))))
        (f 0) (f 1) (f 2)‖ₑ ≤
      ENNReal.ofReal (a R) * ∏ j : Fin 3, eLpNorm (f j) (aux_slotExp i j) volume

/-- **Corollary `ann:global`** (Global cancellation on one annulus).
Let $\psi\in C_c^\infty(\mathbb R^2)$ be supported in a compact annulus disjoint from the origin.
Put $$K_R=\sigma*\bigl(R^2\check\psi(R\,\cdot)\bigr).$$
For every fixed $0<C_0<\infty$ there is a function $a(R)\to0$, with
$0\le a(R)\le\|\check\psi\|_1$, such that whenever $f_i\in L^\infty$ and $f_j\in L^2$ for
$j\ne i$, and all three inputs have Fourier supports in $\overline{B(0,C_0R)}$,
$$|\Lambda_{K_R}(f_0,f_1,f_2)|\le a(R)\|f_i\|_\infty\prod_{j\ne i}\|f_j\|_2,\qquad i=0,1,2.$$
For the bounded input, Fourier support is understood through the test-function condition in
Definition `ext:bounded-support`.

(The conclusion is `Auto.aux_IsAnnularModulus`.) -/
theorem ann_global (α β : ℝ) (hβ : β ≠ 0) (ψ : ℝ² → ℂ) (hψ : ContDiff ℝ (⊤ : ℕ∞) ψ)
    (hann : ∃ r₁ r₂ : ℝ, 0 < r₁ ∧ tsupport ψ ⊆ {b | r₁ ≤ ‖b‖ ∧ ‖b‖ ≤ r₂})
    (C₀ : ℝ) (hC₀ : 0 < C₀) :
    ∃ a : ℝ → ℝ, aux_IsAnnularModulus α β ψ C₀ a := by
  sorry

