/-! ### Admissible sequences and translates (`ann:sequence`) -/

/-- **Definition `ann:sequence`** (admissible sequences).
Fix a bounded box $Q\subset\mathbb R^2$ and a constant $C<\infty$.  An admissible sequence
consists of $R_n\to\infty$ and complex-valued functions $f_{j,n}$, $j\in\{0,1,2\}$, such that
$$|f_{j,n}|\le\mathbf 1_Q,\qquad \operatorname{Lip}(f_{j,n})\le CR_n.$$ -/
structure IsAdmissibleSeq (Q : Set ℝ²) (C : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) :
    Prop where
  tendsto_R : Tendsto R atTop atTop
  bound : ∀ j n x, ‖f j n x‖ ≤ Q.indicator (fun _ => (1 : ℝ)) x
  lip : ∀ j n x y, ‖f j n x - f j n y‖ ≤ C * R n * ‖x - y‖

/-- The translates $T^s_{j,n}(z)=f_{j,n}(z+s/R_n)$ (`\label{ann:sequence}`). -/
def annT (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (j : Fin 3) (n : ℕ) (s z : ℝ²) : ℂ :=
  f j n (z + (R n)⁻¹ • s)

/-- Weak-* convergence (`\label{ann:sequence}`): weak-* convergence on a vertex space or on
configuration space means convergence against every $L^1$ test function on that space. -/
def annWeakStar {X : Type*} [MeasurableSpace X] (μ : Measure X) (F : ℕ → X → ℂ) (G : X → ℂ) :
    Prop :=
  ∀ ψ : X → ℂ, Integrable ψ μ →
    Tendsto (fun n => ∫ x, F n x * ψ x ∂μ) atTop (𝓝 (∫ x, G x * ψ x ∂μ))

/-! ### Simultaneous correlation limits (`ann:extract`) -/

/-- Auxiliary: the properties of the two-point limits `k j z s t = k_j(z;s,t)` and the
three-point limits `h3 p s = h(p;s_0,s_1,s_2)` of the correlations of an admissible sequence
`(R, f)` (already passed to the subsequence) asserted in `\label{ann:extract}`; `L` is the bound
for the Lipschitz constants in the shifts.  See `Auto.ann_extract`; used as the hypothesis
"a subsequence as in Lemma `ann:extract`" in the later lemmas. -/
structure aux_IsCorrelationLimits (α β L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ) : Prop where
  /-- Two-point limits: $T^s_{j,n}\overline{T^t_{j,n}}\rightharpoonup^* k_j(\cdot;s,t)$. -/
  two_point : ∀ j s t, annWeakStar volume
    (fun n z => annT R f j n s z * conj (annT R f j n t z)) (fun z => k j z s t)
  /-- Three-point limits: $\prod_j T^{s_j}_{j,n}(\pi_jp)\rightharpoonup^* h(p;s_0,s_1,s_2)$. -/
  three_point : ∀ s : Fin 3 → ℝ², annWeakStar μinc
    (fun n p => ∏ j, annT R f j n (s j) (proj α β j p)) (fun p => h3 p s)
  meas_two : ∀ j s t, AEStronglyMeasurable (fun z => k j z s t) volume
  meas_three : ∀ s, AEStronglyMeasurable (fun p => h3 p s) μinc
  /-- Continuity in the shifts off a fixed null set. -/
  cont_two : ∀ᵐ z ∂(volume : Measure ℝ²), ∀ j, Continuous fun st : ℝ² × ℝ² => k j z st.1 st.2
  cont_three : ∀ᵐ p ∂μinc, Continuous fun s => h3 p s
  /-- Bounded by one. -/
  bound_two : ∀ j z s t, ‖k j z s t‖ ≤ 1
  bound_three : ∀ p s, ‖h3 p s‖ ≤ 1
  /-- Lipschitz bounds in the shifts. -/
  lip_two : ∀ᵐ z ∂(volume : Measure ℝ²), ∀ j s t s' t',
    ‖k j z s t - k j z s' t'‖ ≤ L * (‖s - s'‖ + ‖t - t'‖)
  lip_three : ∀ᵐ p ∂μinc, ∀ s s' : Fin 3 → ℝ², ‖h3 p s - h3 p s'‖ ≤ L * ∑ j, ‖s j - s' j‖
  /-- Three-point convergence with bounded measurable shifts. -/
  variable_shifts : ∀ S : Fin 3 → ℝ² × Ang → ℝ², (∀ j, Measurable (S j)) →
    (∃ B : ℝ, ∀ j p, ‖S j p‖ ≤ B) →
    annWeakStar μinc (fun n p => ∏ j, annT R f j n (S j p) (proj α β j p))
      (fun p => h3 p (fun j => S j p))

/-- **Lemma `ann:extract`** (Simultaneous correlation limits).
Every admissible sequence has a subsequence with the following properties.  For all real shifts
$s,t,s_0,s_1,s_2\in\mathbb R^2$, the limits
$$T^s_{j,n}\overline{T^t_{j,n}}\stackrel{*}{\rightharpoonup}k_j(z;s,t),\qquad
\prod_{j=0}^2T^{s_j}_{j,n}(\pi_jp)\stackrel{*}{\rightharpoonup}h(p;s_0,s_1,s_2)$$
exist.  The limits have representatives that are continuous in all shift variables off a fixed
null set in the respective underlying space.  They are bounded by one, and their Lipschitz
constants in the shifts are bounded in terms of $C$.  The three-point convergence also holds
when the shifts $s_j$ are replaced by bounded measurable functions of $p$.

(The Lipschitz bound `L` depends only on `C`.) -/
theorem ann_extract (C : ℝ) :
    ∃ L : ℝ, ∀ (α β : ℝ) (Q : Set ℝ²), Bornology.IsBounded Q →
      ∀ (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ), IsAdmissibleSeq Q C R f →
      ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ)
        (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ),
        aux_IsCorrelationLimits α β L (R ∘ φ) (fun j n => f j (φ n)) k h3 := by
  sorry

/-! ### Measurable spectral measures (`ann:spectral`) -/

/-- Auxiliary: the conclusion of `\label{ann:spectral}` (see `Auto.ann_spectral`): measurable
kernels `z ↦ ν j z` of finite positive measures of mass at most one with
$k_j(z;s,t)=\int\mathrm e((s-t)\cdot\xi)\,d\nu_{j,z}(\xi)$ for a.e. `z` and all `s,t`. -/
def aux_IsSpectralKernels (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (ν : Fin 3 → ℝ² → Measure ℝ²) :
    Prop :=
  (∀ j, IsMeasurableKernel (ν j)) ∧ (∀ j z, ν j z univ ≤ 1) ∧
    ∀ᵐ z ∂(volume : Measure ℝ²), ∀ j s t, k j z s t = ∫ ξ, e ⟪s - t, ξ⟫_ℝ ∂(ν j z)

/-- **Lemma `ann:spectral`** (Measurable spectral measures).
For a subsequence as in Lemma `ann:extract`, there are measurable kernels of finite positive
Borel measures $z\mapsto\nu_{j,z}$ on $\mathbb R^2$, of mass at most one, such that
$$k_j(z;s,t)=\int_{\mathbb R^2}\mathrm e((s-t)\cdot\xi)\,d\nu_{j,z}(\xi)$$
for almost every $z$ and all $s,t\in\mathbb R^2$. -/
theorem ann_spectral (α β : ℝ) (Q : Set ℝ²) (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ)
    (hadm : IsAdmissibleSeq Q C R f) (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ)
    (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ) (hlim : aux_IsCorrelationLimits α β L R f k h3) :
    ∃ ν : Fin 3 → ℝ² → Measure ℝ², aux_IsSpectralKernels k ν := by
  sorry

/-! ### Polynomial translates (`ann:polynomials`) -/

/-- The character $e_s(\xi)=\mathrm e(s\cdot\xi)$ (`\label{ann:polynomials}`). -/
def charE (s ξ : ℝ²) : ℂ := e ⟪s, ξ⟫_ℝ

/-- The trigonometric polynomial $a=\sum_s c_se_s$ with coefficients `c`
(`\label{ann:polynomials}`). -/
def trigPoly (c : ℝ² →₀ ℂ) (ξ : ℝ²) : ℂ := c.sum fun s a => a * charE s ξ

/-- The finite tensor sum $G=\sum_{s,t}c_{s,t}\,e_s\otimes e_t$ with coefficients `c`
(`\label{ann:polynomials}`); every finite sum $\sum_d b_d\otimes c_d$ of elementary tensors of
trigonometric polynomials has this form. -/
def tensorPoly (c : ℝ² × ℝ² →₀ ℂ) (ξ : ℝ² × ℝ²) : ℂ :=
  c.sum fun st a => a * charE st.1 ξ.1 * charE st.2 ξ.2

/-- The polynomial translate $F_{j,n}[a](z)=\sum_s c_sT^s_{j,n}(z)$ for $a=\sum_s c_se_s$
(`\label{ann:polynomials}`). -/
def polyTranslate (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (j : Fin 3) (n : ℕ) (c : ℝ² →₀ ℂ)
    (z : ℝ²) : ℂ :=
  c.sum fun s a => a * annT R f j n s z

/-- The tensor translate (`\label{ann:polynomials}`)
$$G_n(p)=\sum_{d=1}^D F_{1,n}[b_d](\pi_1p)F_{2,n}[c_d](\pi_2p)
=\sum_{s,t}c_{s,t}T^s_{1,n}(\pi_1p)T^t_{2,n}(\pi_2p)$$
for $G=\sum_{s,t}c_{s,t}e_s\otimes e_t$. -/
def tensorTranslate (α β : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (n : ℕ)
    (c : ℝ² × ℝ² →₀ ℂ) (p : ℝ² × Ang) : ℂ :=
  c.sum fun st a => a * annT R f 1 n st.1 (proj α β 1 p) * annT R f 2 n st.2 (proj α β 2 p)

/-! ### Factorization of two-vertex quadratic correlations (`ann:factor`) -/

/-- **Lemma `ann:factor`** (first assertion).  For the notation of Definition `ann:polynomials`,
$$|F_{0,n}[a](\pi_0p)|^2\stackrel{*}{\rightharpoonup}\int|a|^2\,d\nu_0,\qquad
|G_n(p)|^2\stackrel{*}{\rightharpoonup}\int|G|^2\,d(\nu_1\otimes\nu_2).$$ -/
theorem ann_factor_one (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (a : ℝ² →₀ ℂ) :
    annWeakStar μinc (fun n p => ((‖polyTranslate R f 0 n a (proj α β 0 p)‖ ^ 2 : ℝ) : ℂ))
      (fun p => ((∫ ξ, ‖trigPoly a ξ‖ ^ 2 ∂(ν 0 (proj α β 0 p)) : ℝ) : ℂ)) := by
  sorry

/-- **Lemma `ann:factor`** (second assertion).  For the notation of Definition
`ann:polynomials`,
$$|F_{0,n}[a](\pi_0p)|^2\stackrel{*}{\rightharpoonup}\int|a|^2\,d\nu_0,\qquad
|G_n(p)|^2\stackrel{*}{\rightharpoonup}\int|G|^2\,d(\nu_1\otimes\nu_2).$$ -/
theorem ann_factor_two (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (G : ℝ² × ℝ² →₀ ℂ) :
    annWeakStar μinc (fun n p => ((‖tensorTranslate α β R f n G p‖ ^ 2 : ℝ) : ℂ))
      (fun p => ((∫ ξ, ‖tensorPoly G ξ‖ ^ 2 ∂((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p)))
        : ℝ) : ℂ)) := by
  sorry

/-! ### The limiting bilinear correlation form (`ann:form`) -/

/-- Auxiliary: `ℓ` is a complex bilinear form on $L^2(\mu_0)\times L^2(\mu_{12})$ satisfying
the Cauchy–Schwarz bound `(ann:cs)` $|\ell(a,G)|\le\|a\|_{L^2(\mu_0)}\|G\|_{L^2(\mu_{12})}$
(used in `\label{ann:form}`, see `Auto.ann_form`).  The bound and bilinearity make `ℓ` depend
only on the almost-everywhere classes of square-integrable arguments. -/
def aux_IsBoundedBilinear (μ₀ : Measure ℝ²) (μ₁₂ : Measure (ℝ² × ℝ²))
    (ℓ : (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ) : Prop :=
  (∀ a a' G, MemLp a 2 μ₀ → MemLp a' 2 μ₀ → MemLp G 2 μ₁₂ → ℓ (a + a') G = ℓ a G + ℓ a' G) ∧
  (∀ (c : ℂ) a G, MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → ℓ (c • a) G = c * ℓ a G) ∧
  (∀ a G G', MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → MemLp G' 2 μ₁₂ → ℓ a (G + G') = ℓ a G + ℓ a G') ∧
  (∀ (c : ℂ) a G, MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → ℓ a (c • G) = c * ℓ a G) ∧
  (∀ a G, MemLp a 2 μ₀ → MemLp G 2 μ₁₂ → ‖ℓ a G‖ₑ ≤ eLpNorm a 2 μ₀ * eLpNorm G 2 μ₁₂)

/-- Auxiliary: the conclusion of `\label{ann:form}` (see `Auto.ann_form`) for a family of forms
`ℓ p`: for a.e. configuration `p` it is a bounded bilinear form on
$L^2(\nu_0)\times L^2(\nu_1\otimes\nu_2)$ (with $\nu_j=\nu_{j,\pi_jp}$); on polynomial
arguments it is the weak-* limit of $F_{0,n}[a](\pi_0p)G_n(p)$; on characters it equals the
three-point limit `h3`. -/
def aux_IsLimitForm (α β : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ)
    (ν : Fin 3 → ℝ² → Measure ℝ²) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ) : Prop :=
  (∀ᵐ p ∂μinc, aux_IsBoundedBilinear (ν 0 (proj α β 0 p))
      ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) (ℓ p)) ∧
  (∀ (a : ℝ² →₀ ℂ) (G : ℝ² × ℝ² →₀ ℂ), annWeakStar μinc
      (fun n p => polyTranslate R f 0 n a (proj α β 0 p) * tensorTranslate α β R f n G p)
      (fun p => ℓ p (trigPoly a) (tensorPoly G))) ∧
  ∀ᵐ p ∂μinc, ∀ s : Fin 3 → ℝ²,
    ℓ p (charE (s 0)) (fun ξ => charE (s 1) ξ.1 * charE (s 2) ξ.2) = h3 p s

/-- **Lemma `ann:form`** (The limiting bilinear correlation form).
For almost every configuration $p$, there is a complex bilinear form
$$\ell_p:L^2(\nu_0)\times L^2(\nu_1\otimes\nu_2)\longrightarrow\mathbb C$$
such that
$$|\ell_p(a,G)|\le\|a\|_{L^2(\nu_0)}\|G\|_{L^2(\nu_1\otimes\nu_2)}.\qquad(\text{ann:cs})$$
For trigonometric polynomials and their finite tensor sums, $\ell_p(a,G)$ is the weak-* limit of
$F_{0,n}[a](\pi_0p)G_n(p)$.  In particular,
$$\ell_p(e_{s_0},e_{s_1}\otimes e_{s_2})=h(p;s_0,s_1,s_2).$$ -/
theorem ann_form (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) :
    ∃ ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ, aux_IsLimitForm α β R f ν h3 ℓ := by
  sorry

/-! ### Infinitesimal translation and rotation invariance (`ann:invariance`) -/

/-- **Lemma `ann:invariance`** (Infinitesimal translation and rotation invariance).
Outside a fixed null set of configurations, for every $s\in\mathbb R^2$, $h\in\mathbb R$,
$a\in L^2(\nu_0)$, and $G\in L^2(\nu_1\otimes\nu_2)$,
$$\ell_p(a,G)=\ell_p\bigl(e_sa,(e_{s+hv_\theta}\otimes e_{s+hMv_\theta})G\bigr).\qquad
(\text{ann:inv})$$ -/
theorem ann_invariance (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ)
    (hℓ : aux_IsLimitForm α β R f ν h3 ℓ) :
    ∀ᵐ p ∂μinc, ∀ (s : ℝ²) (h : ℝ) (a : ℝ² → ℂ) (G : ℝ² × ℝ² → ℂ),
      MemLp a 2 (ν 0 (proj α β 0 p)) →
      MemLp G 2 ((ν 1 (proj α β 1 p)).prod (ν 2 (proj α β 2 p))) →
      ℓ p a G = ℓ p (fun ξ => charE s ξ * a ξ)
        (fun ξ => charE (s + h • v p.2) ξ.1 * charE (s + h • M α β (v p.2)) ξ.2 * G ξ) := by
  sorry

/-! ### Atoms of one-dimensional projections (`ann:fibers`) -/

/-- The hyperplane (`ann:hyperplane`, in `\label{ann:fibers}`)
$$H_p=\{(\xi_1,\xi_2):v_\theta\cdot\xi_1+Mv_\theta\cdot\xi_2=0\}.$$ -/
def annH (α β : ℝ) (θ : Ang) : Set (ℝ² × ℝ²) :=
  {ξ | ⟪v θ, ξ.1⟫_ℝ + ⟪M α β (v θ), ξ.2⟫_ℝ = 0}

/-- **Lemma `ann:fibers`** (first assertion).
Let $z\mapsto\nu_z$ be a measurable kernel of finite positive measures on $\mathbb R^2$, of mass
at most one, and let $N$ be invertible.  For almost every $(z,\theta)$, every positive-mass fiber
of $$\xi\longmapsto (Nv_\theta)\cdot\xi$$ is concentrated at a single point atom of $\nu_z$.
Consequently, for almost every configuration $p$, the restriction of $\nu_1\otimes\nu_2$ to
$$H_p=\{(\xi_1,\xi_2):v_\theta\cdot\xi_1+Mv_\theta\cdot\xi_2=0\}$$
is concentrated on countably many pairs of point atoms. -/
theorem ann_fibers (ν : ℝ² → Measure ℝ²) (hν : IsMeasurableKernel ν) (hν1 : ∀ z, ν z univ ≤ 1)
    (N : ℝ² →L[ℝ] ℝ²) (hN : IsUnit N) :
    ∀ᵐ q ∂μinc, ∀ t : ℝ, 0 < ν q.1 {ξ | ⟪N (v q.2), ξ⟫_ℝ = t} →
      ∃ ξ₀ : ℝ², ν q.1 ({ξ | ⟪N (v q.2), ξ⟫_ℝ = t} \ {ξ₀}) = 0 := by
  sorry

/-- **Lemma `ann:fibers`** (consequence for the hyperplane $H_p$; stated for two measurable
kernels $\nu_1,\nu_2$ of mass at most one, with $\nu_j=\nu_{j,\pi_jp}$).
Let $z\mapsto\nu_z$ be a measurable kernel of finite positive measures on $\mathbb R^2$, of mass
at most one, and let $N$ be invertible.  For almost every $(z,\theta)$, every positive-mass fiber
of $$\xi\longmapsto (Nv_\theta)\cdot\xi$$ is concentrated at a single point atom of $\nu_z$.
Consequently, for almost every configuration $p$, the restriction of $\nu_1\otimes\nu_2$ to
$$H_p=\{(\xi_1,\xi_2):v_\theta\cdot\xi_1+Mv_\theta\cdot\xi_2=0\}$$
is concentrated on countably many pairs of point atoms. -/
theorem ann_fibers_hyperplane (α β : ℝ) (hβ : β ≠ 0) (ν₁ ν₂ : ℝ² → Measure ℝ²)
    (hν₁ : IsMeasurableKernel ν₁) (hν₂ : IsMeasurableKernel ν₂) (hν₁1 : ∀ z, ν₁ z univ ≤ 1)
    (hν₂1 : ∀ z, ν₂ z univ ≤ 1) :
    ∀ᵐ p ∂μinc, ∃ S : Set (ℝ² × ℝ²), S.Countable ∧ S ⊆ annH α β p.2 ∧
      (∀ ξ ∈ S, 0 < ν₁ (proj α β 1 p) {ξ.1} ∧ 0 < ν₂ (proj α β 2 p) {ξ.2}) ∧
      ((ν₁ (proj α β 1 p)).prod (ν₂ (proj α β 2 p))) (annH α β p.2 \ S) = 0 := by
  sorry

/-! ### Countably many measurable selectors (`ann:selectors`) -/

/-- **Lemma `ann:selectors`** (Countably many measurable selectors cover all atoms).
For a measurable kernel $z\mapsto\nu_z$ of finite positive Borel measures on $\mathbb R^2$, there
is a countable family of measurable maps $a_m:\mathbb R^2\to\mathbb R^2$ such that every point
atom of every nonzero $\nu_z$ occurs among the values $a_m(z)$. -/
theorem ann_selectors (ν : ℝ² → Measure ℝ²) (hν : IsMeasurableKernel ν) :
    ∃ a : ℕ → ℝ² → ℝ², (∀ m, Measurable (a m)) ∧
      ∀ z, ν z ≠ 0 → ∀ ξ : ℝ², 0 < ν z {ξ} → ∃ m, a m z = ξ := by
  sorry

/-! ### Rigidity for all contributing atomic triples (`ann:atomic-rigidity`) -/

/-- **Lemma `ann:atomic-rigidity`** (Rigidity for all contributing atomic triples; stated for
arbitrary measurable kernels $\nu_{j,\cdot}$ of mass at most one, in particular for the spectral
kernels of `ann:spectral`).
For almost every configuration $p$, every triple of point atoms $\xi_j$ of $\nu_{j,\pi_jp}$
satisfying
$$\xi_0+\xi_1+\xi_2=0,\qquad v_\theta\cdot(\xi_1+M^T\xi_2)=0\qquad(\text{ann:stationarity})$$
also satisfies $\xi_1+M^T\xi_2=0$. -/
theorem ann_atomic_rigidity (α β : ℝ) (hβ : β ≠ 0) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : ∀ j, IsMeasurableKernel (ν j)) (hν1 : ∀ j z, ν j z univ ≤ 1) :
    ∀ᵐ p ∂μinc, ∀ ξ : Fin 3 → ℝ², (∀ j, 0 < ν j (proj α β j p) {ξ j}) →
      ∑ j, ξ j = 0 →
      ⟪v p.2, ξ 1 + ContinuousLinearMap.adjoint (M α β) (ξ 2)⟫_ℝ = 0 →
      ξ 1 + ContinuousLinearMap.adjoint (M α β) (ξ 2) = 0 := by
  sorry

/-! ### Invariance under displacement smoothing (`ann:displacement`) -/

/-- **Lemma `ann:displacement`** (Invariance under displacement smoothing).
For almost every configuration $p$ and every $y\in\mathbb R^2$,
$$\ell_p(1,e_y\otimes e_{My})=\ell_p(1,1).$$ -/
theorem ann_displacement (α β : ℝ) (hβ : β ≠ 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q)
    (C L : ℝ) (R : ℕ → ℝ) (f : Fin 3 → ℕ → ℝ² → ℂ) (hadm : IsAdmissibleSeq Q C R f)
    (k : Fin 3 → ℝ² → ℝ² → ℝ² → ℂ) (h3 : ℝ² × Ang → (Fin 3 → ℝ²) → ℂ)
    (hlim : aux_IsCorrelationLimits α β L R f k h3) (ν : Fin 3 → ℝ² → Measure ℝ²)
    (hν : aux_IsSpectralKernels k ν) (ℓ : ℝ² × Ang → (ℝ² → ℂ) → (ℝ² × ℝ² → ℂ) → ℂ)
    (hℓ : aux_IsLimitForm α β R f ν h3 ℓ) :
    ∀ᵐ p ∂μinc, ∀ y : ℝ²,
      ℓ p (fun _ => 1) (fun ξ => charE y ξ.1 * charE (M α β y) ξ.2) =
        ℓ p (fun _ => 1) (fun _ => 1) := by
  sorry

/-! ### Cancellation for bounded Lipschitz inputs (`ann:local`) -/

/-- **Proposition `ann:local`** (Cancellation for bounded Lipschitz inputs; the box `Q` is
allowed to be any bounded set).
Let $\Psi\in L^1(\mathbb R^2)$ satisfy $\int\Psi=0$, and put $\Psi_R(u)=R^2\Psi(Ru)$.  For every
bounded box $Q$ and every $C<\infty$,
$$\sup_{\substack{|f_j|\le\mathbf 1_Q\\ \operatorname{Lip}(f_j)\le CR}}
|\Lambda_{\sigma*\Psi_R}(f_0,f_1,f_2)|\longrightarrow0\qquad (R\to\infty).$$ -/
theorem ann_local (α β : ℝ) (hβ : β ≠ 0) (Ψ : ℝ² → ℂ) (hΨ : Integrable Ψ)
    (hΨ0 : ∫ x, Ψ x = 0) (Q : Set ℝ²) (hQ : Bornology.IsBounded Q) (C : ℝ) :
    Tendsto (fun R : ℝ => ⨆ (f : Fin 3 → ℝ² → ℂ)
        (_ : ∀ j x, ‖f j x‖ ≤ Q.indicator (fun _ => (1 : ℝ)) x)
        (_ : ∀ j x y, ‖f j x - f j y‖ ≤ C * R * ‖x - y‖),
        ‖form α β (FCMeasure.sigma.conv (FCMeasure.ofDensity (scaleR R Ψ)))
          (f 0) (f 1) (f 2)‖ₑ) atTop (𝓝 0) := by
  sorry

end Auto
