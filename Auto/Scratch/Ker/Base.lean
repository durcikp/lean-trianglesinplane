            ENNReal.ofReal c * ∑ j, volume ((aux_pruneSeq α β c X E N).1 j \
              (aux_pruneSeq α β c X E (N + 1)).1 j) :=
          add_le_add ih (aux_pruneSeq_step_loss α β c X E hX hE hproj N)
