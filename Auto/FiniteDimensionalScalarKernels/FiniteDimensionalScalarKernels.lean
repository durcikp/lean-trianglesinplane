/-! ### Degrees and cores (`rig:def-core`) -/

/-- The degree of `z ∈ ℝ²` at vertex `j` (`\label{rig:def-core}`):
$$d_{j,E}(z)=\int_{\mathbb T}\mathbf 1_E(z-L_ju_\theta,\theta)\,d\sigma(\theta).$$ -/
def degree (α β : ℝ) (j : Fin 3) (E : Set (ℝ² × Ang)) (z : ℝ²) : ℝ :=
  ∫ θ, E.indicator (fun _ => (1 : ℝ)) (z - Lv α β j (u θ), θ) ∂σ

/-- The standing hypotheses of `\label{rig:def-core}`: $X_0,X_1,X_2\subset\mathbb R^2$ are bounded
measurable sets, $E\subset\mathbb R^2\times\mathbb T$ is measurable, and $\pi_j(p)\in X_j$ for
almost every $p\in E$ and every $j$. -/
structure IsCoreData (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) : Prop where
  measurableSet_X : ∀ j, MeasurableSet (X j)
  isBounded_X : ∀ j, Bornology.IsBounded (X j)
  measurableSet_E : MeasurableSet E
  ae_proj_mem : ∀ j, ∀ᵐ p ∂(μinc.restrict E), proj α β j p ∈ X j

/-- **Definition `rig:def-core`** (cores).  The data $(E;X_0,X_1,X_2)$ form a *core of degree
$c$* if $\mu(E)>0$ and $d_{j,E}\ge c>0$ almost everywhere on $X_j$, for every $j$.
Sets and their defining relations may throughout be modified on null sets. -/
structure IsCore (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (c : ℝ) : Prop
    extends IsCoreData α β E X where
  measure_pos : 0 < μinc E
  degree_pos : 0 < c
  ae_degree_ge : ∀ j, ∀ᵐ z ∂(volume.restrict (X j)), c ≤ degree α β j E z

/-! ### Integration along a vertex (`rig:degree-integration`) -/

/-- **Lemma `rig:degree-integration`** (integration formula).  For every nonnegative measurable
function $g$ on $\mathbb R^2$,
$$\int_E g(\pi_jp)\,d\mu(p)=\int_{\mathbb R^2}g(z)\,d_{j,E}(z)\,dz.$$ -/
theorem rig_degree_integration (α β : ℝ) (j : Fin 3) (E : Set (ℝ² × Ang)) (hE : MeasurableSet E)
    (g : ℝ² → ℝ≥0∞) (hg : Measurable g) :
    ∫⁻ p in E, g (proj α β j p) ∂μinc = ∫⁻ z, g z * ENNReal.ofReal (degree α β j E z) := by
  sorry

/-- **Lemma `rig:degree-integration`** (bounds).  $0\le d_{j,E}\le 1$. -/
theorem rig_degree_integration_bounds (α β : ℝ) (j : Fin 3) (E : Set (ℝ² × Ang))
    (hE : MeasurableSet E) (z : ℝ²) :
    0 ≤ degree α β j E z ∧ degree α β j E z ≤ 1 := by
  sorry

/-- **Lemma `rig:degree-integration`** (total degree).  $\int d_{j,E}=\mu(E)$. -/
theorem rig_degree_integration_total (α β : ℝ) (j : Fin 3) (E : Set (ℝ² × Ang))
    (hE : MeasurableSet E) :
    ∫⁻ z, ENNReal.ofReal (degree α β j E z) = μinc E := by
  sorry

/-- **Lemma `rig:degree-integration`** (null sets).  Pullback by $\pi_j$ sends planar null sets
to $\mu$-null sets (of $E$). -/
theorem rig_degree_integration_null (α β : ℝ) (j : Fin 3) (E : Set (ℝ² × Ang))
    (hE : MeasurableSet E) (N : Set ℝ²) (hN : volume N = 0) :
    μinc (E ∩ proj α β j ⁻¹' N) = 0 := by
  sorry

/-! ### Extraction of a positive-degree core (`rig:prune`) -/

/-- **Lemma `rig:prune`**.  If $\mu(E)>0$, then for every
$$0<c<\frac{\mu(E)}{\sum_{j=0}^2|X_j|}$$
there are measurable $Y_j\subset X_j$ and $F\subset E$ such that $(F;Y_0,Y_1,Y_2)$ is a core of
degree $c$.  Moreover,
$$\mu(E\setminus F)\le c\sum_{j=0}^2|X_j|.$$ -/
theorem rig_prune (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (hEX : IsCoreData α β E X)
    (hE : 0 < μinc E) (c : ℝ) (hc : 0 < c)
    (hcE : ENNReal.ofReal c < μinc E / ∑ j, volume (X j)) :
    ∃ (F : Set (ℝ² × Ang)) (Y : Fin 3 → Set ℝ²), (∀ j, MeasurableSet (Y j) ∧ Y j ⊆ X j) ∧
      MeasurableSet F ∧ F ⊆ E ∧ IsCore α β F Y c ∧
      μinc (E \ F) ≤ ENNReal.ofReal c * ∑ j, volume (X j) := by
  sorry

/-! ### The scalar incidence operator (`rig:def-kernel`) -/

/-- The Hilbert space $\mathcal H_E=\bigoplus_{j=0}^2L^2(X_j;\mathbb R)$ of
`\label{rig:def-kernel}`, with norm the square root of the sum of the three squared $L^2$ norms. -/
abbrev HE (X : Fin 3 → Set ℝ²) : Type :=
  PiLp 2 (fun j : Fin 3 => Lp ℝ 2 (volume.restrict (X j)))

/-- The function $D_Ef=\sum_{j=0}^2f_j\circ\pi_j$ on $\mathbb R^2\times\mathbb T$
(`\label{rig:def-kernel}`), each component $f_j$ being extended by zero outside $X_j$. -/
def incidenceFun (α β : ℝ) (X : Fin 3 → Set ℝ²) (f : HE X) (p : ℝ² × Ang) : ℝ :=
  ∑ j, (X j).indicator (f j : ℝ² → ℝ) (proj α β j p)

/-- Auxiliary: the map `f ↦ incidenceFun α β X f` induces a continuous linear map
`HE X →L[ℝ] Lp ℝ 2 (μinc.restrict E)`.  Used to define `Auto.incidenceOp`
(`\label{rig:def-kernel}`). -/
theorem aux_incidenceOp_exists (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) :
    ∃ D : HE X →L[ℝ] Lp ℝ 2 (μinc.restrict E),
      ∀ f, (D f : ℝ² × Ang → ℝ) =ᵐ[μinc.restrict E] incidenceFun α β X f := by
  sorry

/-- The scalar incidence operator $D_E:\mathcal H_E\to L^2(E,\mu)$, $D_Ef=\sum_j f_j\circ\pi_j$
(`\label{rig:def-kernel}`); see `Auto.incidenceOp_ae`. -/
def incidenceOp (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) :
    HE X →L[ℝ] Lp ℝ 2 (μinc.restrict E) :=
  (aux_incidenceOp_exists α β E X).choose

/-- The defining property of $D_E$ (`\label{rig:def-kernel}`):
$D_Ef=\sum_{j=0}^2f_j\circ\pi_j$ almost everywhere on $E$. -/
theorem incidenceOp_ae (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (f : HE X) :
    (incidenceOp α β E X f : ℝ² × Ang → ℝ) =ᵐ[μinc.restrict E] incidenceFun α β X f :=
  (aux_incidenceOp_exists α β E X).choose_spec f

/-- **Definition `rig:def-kernel`**.  On a core $(E;X_0,X_1,X_2)$ let
$$\mathcal H_E=\bigoplus_{j=0}^2L^2(X_j;\mathbb R),\qquad D_E:\mathcal H_E\to L^2(E,\mu),\qquad
D_Ef=\sum_{j=0}^2f_j\circ\pi_j,\qquad K_E=\ker D_E.$$
The norm on $\mathcal H_E$ is the square root of the sum of the three squared $L^2$ norms.
Each component is extended by zero when regarded as a function on all of $\mathbb R^2$.
(See `Auto.HE`, `Auto.incidenceOp`.) -/
def kernelSpace (α β : ℝ) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) : Submodule ℝ (HE X) :=
  LinearMap.ker (incidenceOp α β E X : HE X →ₗ[ℝ] Lp ℝ 2 (μinc.restrict E))

/-- Base translation `E_h = {(x,θ) : (x+h,θ) ∈ E}` of a configuration set (used for the
translation statements of `\label{rig:kernel-gap}`, `\label{rig:kernel-stability}` and in
`\label{rig:common-core}`). -/
def baseShift (h : ℝ²) (E : Set (ℝ² × Ang)) : Set (ℝ² × Ang) :=
  {p | (p.1 + h, p.2) ∈ E}

/-- Auxiliary: the vertex sets `X_j - h` of the base translate `E_h` (`Auto.baseShift`). -/
def aux_vertexShift (h : ℝ²) (X : Fin 3 → Set ℝ²) : Fin 3 → Set ℝ² :=
  fun j => (fun z => z + h) ⁻¹' X j

/-! ### Finite-dimensionality and a distance estimate (`rig:kernel-gap`) -/

/-- **Lemma `rig:kernel-gap`** (finite dimensionality).  For every core $E$, the space $K_E$ is
finite dimensional. -/
theorem rig_kernel_gap_finiteDimensional (α β : ℝ) (hβ : β ≠ 0) (E : Set (ℝ² × Ang))
    (X : Fin 3 → Set ℝ²) (c : ℝ) (hE : IsCore α β E X c) :
    FiniteDimensional ℝ (kernelSpace α β E X) := by
  sorry

/-- **Lemma `rig:kernel-gap`** (distance estimate).  There is $C_E<\infty$ such that
$$\operatorname{dist}_{\mathcal H_E}(f,K_E)\le C_E\|D_Ef\|_{L^2(E,\mu)}\qquad(f\in\mathcal H_E).$$
The same constant is valid for every translate of $E$ in the base variable.
(The translate by $-h$ is $E_h$ with vertex sets $X_j-h$; $h=0$ is $E$ itself.) -/
theorem rig_kernel_gap (α β : ℝ) (hβ : β ≠ 0) (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (c : ℝ)
    (hE : IsCore α β E X c) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (h : ℝ²) (f : HE (aux_vertexShift h X)),
      Metric.infDist f (kernelSpace α β (baseShift h E) (aux_vertexShift h X)) ≤
        C * ‖incidenceOp α β (baseShift h E) (aux_vertexShift h X) f‖ := by
  sorry

/-! ### Uniform integrability of kernel elements (`rig:kernel-ui`) -/

/-- **Lemma `rig:kernel-ui`**.  There is a nondecreasing function
$\omega:[0,\infty)\to[0,\infty)$, depending only on $M$, with $\omega(s)\to0$ as $s\downarrow0$,
such that the following holds.  On any core $G$ of degree $t>0$, if $f\in K_G$, $0\le e\le1$,
and $e\in L^1(\mathbb R^2)$, then
$$\|\sqrt e\,f_j\|_2\le C_Mt^{-1}\omega(\|e\|_1)\|f\|_{\mathcal H_G}\qquad(j=0,1,2).$$
The modulus is independent of the core and of its vertex sets. -/
theorem rig_kernel_ui (α β : ℝ) (hβ : β ≠ 0) :
    ∃ (C : ℝ) (ω : ℝ → ℝ), 0 ≤ C ∧ MonotoneOn ω (Ici 0) ∧ (∀ s, 0 ≤ s → 0 ≤ ω s) ∧
      Tendsto ω (𝓝[>] 0) (𝓝 0) ∧
      ∀ (G : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²) (t : ℝ), IsCore α β G X t →
      ∀ f ∈ kernelSpace α β G X, ∀ e : ℝ² → ℝ, (∀ z, e z ∈ Icc 0 1) → Integrable e →
      ∀ j, eLpNorm (fun z => Real.sqrt (e z) * (X j).indicator (f j : ℝ² → ℝ) z) 2 volume ≤
        ENNReal.ofReal (C * t⁻¹ * ω (∫ z, e z) * ‖f‖) := by
  sorry

/-! ### Stability under removal of a small set (`rig:kernel-stability`) -/

/-- **Lemma `rig:kernel-stability`**.  Fix a core $(E;X_0,X_1,X_2)$ of degree $c$ and a number
$t>0$.  There is $\eta_0>0$ such that, whenever $(F;Y_0,Y_1,Y_2)$ is a core of degree $t$, with
$F\subset E$, $Y_j\subset X_j$, and $\mu(E\setminus F)<\eta_0$, the restriction map
$$R:K_E\longrightarrow K_F,\qquad Rf=(f_j|_{Y_j})_{j=0}^2,$$
is an isomorphism.  The threshold may be chosen using only $c,t,C_E$, and the fixed modulus in
Lemma `rig:kernel-ui`; in particular, the same threshold works after a base translation.

(Formalization: for given $c,t$ and a constant $C$ (playing the role of $C_E$) the threshold
$\eta_0$ works for every core $E$ of degree $c$ satisfying the distance estimate of
`rig:kernel-gap` with constant $C$; the isomorphism is a linear equivalence $R$ whose components
agree a.e. on $Y_j$ with those of $f$.) -/
theorem rig_kernel_stability (α β : ℝ) (hβ : β ≠ 0) (c t C : ℝ) (hc : 0 < c) (ht : 0 < t)
    (hC : 0 ≤ C) :
    ∃ η₀ : ℝ, 0 < η₀ ∧
      ∀ (E : Set (ℝ² × Ang)) (X : Fin 3 → Set ℝ²), IsCore α β E X c →
      (∀ f : HE X, Metric.infDist f (kernelSpace α β E X) ≤ C * ‖incidenceOp α β E X f‖) →
      ∀ (F : Set (ℝ² × Ang)) (Y : Fin 3 → Set ℝ²), IsCore α β F Y t → F ⊆ E →
      (∀ j, Y j ⊆ X j) → μinc (E \ F) < ENNReal.ofReal η₀ →
      ∃ R : kernelSpace α β E X ≃ₗ[ℝ] kernelSpace α β F Y,
        ∀ (f : kernelSpace α β E X) (j : Fin 3),
          ((R f : HE Y) j : ℝ² → ℝ) =ᵐ[volume.restrict (Y j)] ((f : HE X) j : ℝ² → ℝ) := by
  sorry

