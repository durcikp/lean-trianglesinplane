  have key : ∀ z₂ : κ.Z, (∫ z₁, (∫ x, f 0 x * f 1 (x + (ν.φ z₁ + κ.φ z₂)) *
      f 2 (x + M α β (ν.φ z₁ + κ.φ z₂))) * (ν.w z₁ * κ.w z₂) ∂ν.m) =
      form α β ν (f 0) (fun x => f 1 (x + κ.φ z₂)) (fun x => f 2 (x + M α β (κ.φ z₂))) *
        κ.w z₂ := by
