  conv_lhs => unfold form
  unfold FCMeasure.integral
  change ∫ z : ν.Z × κ.Z,
      (∫ x, f 0 x * f 1 (x + (ν.φ z.1 + κ.φ z.2)) * f 2 (x + M α β (ν.φ z.1 + κ.φ z.2))) *
        (ν.w z.1 * κ.w z.2) ∂(ν.m.prod κ.m) = _
