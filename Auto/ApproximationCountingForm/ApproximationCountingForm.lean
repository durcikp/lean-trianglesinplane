/-! ### Smoothing for inputs bounded in both norms (`tail:bounded-smoothing`) -/

/-- **Proposition `tail:bounded-smoothing`** (Smoothing for inputs bounded in both norms).
Let $\rho\in L^1(\mathbb R^2)$ be nonnegative with $\int\rho=1$, and set
$\rho_\varepsilon(u)=\varepsilon^{-2}\rho(u/\varepsilon)$.  For each fixed $B<\infty$,
$$\sup_{\|f_j\|_2,\|f_j\|_\infty\le B}|\Lambda_{\sigma*\rho_\varepsilon-\sigma}(f_0,f_1,f_2)|
\longrightarrow0\qquad(\varepsilon\downarrow0).$$ -/
theorem tail_bounded_smoothing (α β : ℝ) (hβ : β ≠ 0) (ρ : ℝ² → ℝ) (hρ0 : ∀ x, 0 ≤ ρ x)
    (hρ : Integrable ρ) (hρ1 : ∫ x, ρ x = 1) (B : ℝ) :
    Tendsto (fun ε : ℝ => ⨆ (f : Fin 3 → ℝ² → ℂ) (_ : aux_IsBothBounded B f),
      ‖form α β ((FCMeasure.sigma.conv
        (FCMeasure.ofDensity (fun x => (((ε ^ 2)⁻¹ * ρ (ε⁻¹ • x) : ℝ) : ℂ)))).sub
          FCMeasure.sigma) (f 0) (f 1) (f 2)‖ₑ)
      (𝓝[>] 0) (𝓝 0) := by
  sorry

