    Tendsto (fun S : ℝ => form α β ((FCMeasure.sigma.conv κ).conv
        (FCMeasure.ofDensity (tailQ χ S))) (f 0) (f 1) (f 2)) atTop
      (𝓝 (form α β (FCMeasure.sigma.conv κ) (f 0) (f 1) (f 2))) := by
  sorry

/-! ### Tails after convolution (`tail:convolved-tail`) -/

/-- **Lemma `tail:convolved-tail`** (Tails after convolution; the bound).
For every finite measure $\kappa$, dyadic $R\ge1$, and inputs with
$\|f_j\|_2,\|f_j\|_\infty\le B$,
$$\sum_{r=2^k\ge R}|\Lambda_{\sigma*\kappa*k_r}(f_0,f_1,f_2)|\le C_{M,B}\|\kappa\|_{\mathrm{TV}}
\left(\sup_{r\ge R}a(r)\right)^{1/2}.$$
Moreover the sum without absolute values equals
$\Lambda_{\sigma*\kappa}(f_0,f_1,f_2)-\Lambda_{\sigma*\kappa*q_R}(f_0,f_1,f_2)$. -/
theorem tail_convolved_tail (α β : ℝ) (hβ : β ≠ 0) (χ : ℝ² → ℝ) (hχ : aux_IsTailCutoff χ) :
    ∃ C₀₀ : ℝ, 0 < C₀₀ ∧ ∀ C₀ : ℝ, C₀₀ ≤ C₀ → ∀ B : ℝ, ∃ CMB : ℝ, ∀ a : ℝ → ℝ,
      aux_IsAnnularModulus α β (tailPsi χ) C₀ a → ∀ (κ : FCMeasure) (K : ℕ)
        (f : Fin 3 → ℝ² → ℂ), aux_IsBothBounded B f →
        ∑' k : ℕ, ‖form α β ((FCMeasure.sigma.conv κ).conv
            (FCMeasure.ofDensity (tailK χ (2 ^ (K + k))))) (f 0) (f 1) (f 2)‖ₑ ≤
          ENNReal.ofReal CMB * κ.tv *
            (⨆ (r : ℝ) (_ : (2 : ℝ) ^ K ≤ r), ENNReal.ofReal (a r)) ^ (1 / 2 : ℝ) := by
  sorry

